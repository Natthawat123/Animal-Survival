function Items.Get(id)
	return Items.Data[id]
end

function Items.DisplayName(id)
	if Items.AnyThai[id] then
		return Items.AnyThai[id]
	end
	local d = Items.Data[id]
	return d and (d.Thai or d.Name) or id
end

return Items
