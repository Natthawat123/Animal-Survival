	-- สิ่งก่อสร้าง (เก็บเป็นชุด แล้วกด B เพื่อวาง)
	LogWall = { Name = "Log Wall", Thai = "Wood Wall", Category = "Structure" },
	StoneWall = { Name = "Stone Wall", Thai = "Stone Wall", Category = "Structure" },
