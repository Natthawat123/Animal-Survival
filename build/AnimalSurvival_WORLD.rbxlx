	-- Stamina = เติมสตามิน่าเต็มหลอด · Full = { Mult, Time } หิวช้าลงชั่วคราว
	BerryJuice = { Name = "Berry Juice", Thai = "Berry Juice", Category = "Food", Food = 20, Stamina = true, Color = Color3.fromRGB(150, 40, 110) },
