<Item class="ServerScriptService" referent="RBX000000B8"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000007C"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000005B"><Properties><string name="Name">Analytics</string><ProtectedString name="Source"><![CDATA[--[[
	Analytics — ส่งสถิติเข้า Roblox AnalyticsService (Creator Dashboard → Analytics)
	  ทุกคำสั่งห่อด้วย pcall: ใน Studio / API ปิด / ผู้เล่นออกไปแล้ว = เงียบ ไม่พังเกม
	  Analytics.Custom(player, "BossDefeated", 25, { "Terragon" })        -- ค่าตัวเลข + ช่องข้อความ (สูงสุด 3 ช่อง)
	  Analytics.NightReached(player, night)                               -- ความคืบหน้า (Progression) ตามคืนสำคัญ
	  Analytics.NightFailed(player, night)
]]

local Players = game:GetService("Players")

local Analytics = {}

local service
do
	local ok, s = pcall(function()
		return game:GetService("AnalyticsService")
	end)
	service = ok and s or nil
end

local FIELD_KEYS = { "CustomField01", "CustomField02", "CustomField03" }

local function fields(list)
	if not list then
		return nil
	end
	local out = {}
	local any = false
	for i, v in ipairs(list) do
		local keyName = FIELD_KEYS[i]
		if keyName and v ~= nil then
			local ok, key = pcall(function()
				return Enum.AnalyticsCustomFieldKeys[keyName].Name
			end)
			out[ok and key or keyName] = tostring(v)
			any = true
		end
	end
	return any and out or nil
end

local function valid(player)
	return service ~= nil and typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players and player.UserId > 0
end

-- เหตุการณ์ทั่วไป (ค่า = ตัวเลข, extra = รายการข้อความ 1-3 ช่อง)
function Analytics.Custom(player, eventName, value, extra)
	if not valid(player) then
		return
	end
	pcall(function()
		service:LogCustomEvent(player, eventName, value or 1, fields(extra))
	end)
end

-- คืนสำคัญ (บันทึกเป็น Progression: เห็นกราฟคนหลุดกลางทางใน Funnel)
Analytics.Milestones = { [1] = true, [2] = true, [3] = true, [5] = true, [7] = true }
function Analytics.IsMilestone(night)
	return Analytics.Milestones[night] == true or night % 5 == 0
end

function Analytics.NightReached(player, night)
	if not valid(player) or not Analytics.IsMilestone(night) then
		return
	end
	pcall(function()
		service:LogProgressionCompleteEvent(player, "Nights", night, "Night " .. night)
	end)
end

function Analytics.NightFailed(player, night)
	if not valid(player) then
		return
	end
	pcall(function()
		service:LogProgressionFailEvent(player, "Nights", math.max(1, night), "Night " .. night)
	end)
end

return Analytics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005C"><Properties><string name="Name">AnimalService</string><ProtectedString name="Source"><![CDATA[--[[
	AnimalService — เกิด/AI/ดาเมจ/ตาย ของสัตว์ทุกตัว
	Kind: "Wild" (สัตว์ป่ากลางวัน) | "Raid" (ฝูงบุกกลางคืน) | "Boss" | "Guardian" (เฝ้าศาลเจ้า/รังบอส)
	      | "Stalker" (จิ้งจอกจันทรา · ตัวไล่) | "Spirit" (ลูกสัตว์ธาตุ)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Animals = require(ReplicatedStorage.Shared.Animals)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Items = require(ReplicatedStorage.Shared.Items)
local AnimalModels = require(ReplicatedStorage.Shared.AnimalModels)
local Classes = require(ReplicatedStorage.Shared.Classes)
local Analytics = require(script.Parent.Analytics)
local BossAbilities = require(script.Parent.BossAbilities)

local AnimalService = {}
local active = {} -- [model] = data
local list = {} -- array สำหรับวนลูป
local CHARGE_WINDUP = 1.0 -- สายชน: ตั้งท่า + แถบเตือนบนพื้นก่อนพุ่ง (วินาที)
local LEAP_WINDUP = 0.55 -- สายตะครุบ: ย่อตัวเล็ง + แถบเตือนก่อนกระโจน

function AnimalService:Init(ctx)
	self.ctx = ctx
	self.folder = Instance.new("Folder")
	self.folder.Name = "Animals"
	self.folder.Parent = Workspace
	self.rng = Random.new(ctx.Seed + 555)
	self.wildCount = 0
	self.raidCount = 0
end

---------------------------------------------------------------- ค้นหา
function AnimalService:Get(model)
	return active[model]
end

function AnimalService:All()
	return list
end

local function hostile(a)
	return a.Kind ~= "Spirit" and a.Kind ~= "Stalker" and a.Info.Behaviour ~= "Passive"
end

function AnimalService:InRadius(pos, radius, hostileOnly)
	local out = {}
	for _, a in ipairs(list) do
		if not a.Dead and (not hostileOnly or hostile(a)) then
			if (a.Root.Position - pos).Magnitude <= radius + a.Radius then
				table.insert(out, a)
			end
		end
	end
	return out
end

function AnimalService:Nearest(pos, radius, hostileOnly)
	local best, bestD
	for _, a in ipairs(list) do
		if not a.Dead and (not hostileOnly or hostile(a)) then
			local d = (a.Root.Position - pos).Magnitude
			if d <= radius and (not bestD or d < bestD) then
				best, bestD = a, d
			end
		end
	end
	return best, bestD
end

function AnimalService:CountKind(kind)
	local n = 0
	for _, a in ipairs(list) do
		if a.Kind == kind and not a.Dead then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------- เกิด
function AnimalService:Spawn(id, position, opts)
	opts = opts or {}
	local info = Animals.Data[id]
	if not info or not Config.AnimalsEnabled then
		return nil
	end
	local model = AnimalModels.Build(id, { SizeMult = opts.SizeMult })
	if not model then
		return nil -- ยังไม่มีโมเดลของสัตว์ตัวนี้ (assets/rbxm/Animals/<Id>.rbxmx)
	end
	local root = model.PrimaryPart
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not opts.NoSnap then -- NoSnap: วางตรงจุดที่ให้มา (เช่นลูกสัตว์ในกรงบนลานศาลเจ้า)
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { workspace.Terrain }
		local hit = workspace:Raycast(position + Vector3.new(0, 120, 0), Vector3.new(0, -260, 0), rp)
		if hit and hit.Material ~= Enum.Material.Water then
			position = Vector3.new(position.X, hit.Position.Y + 0.2, position.Z)
		end
	end
	AnimalModels.PlaceAt(model, position, opts.Yaw or self.rng:NextNumber(0, math.pi * 2))
	-- (Monster Balance: PartyScale = x1 ตลอด · คนเยอะ = มอนมาเยอะขึ้นแทน) ตี้ยิ่งเยอะ มอนยิ่งโหด (Nights.PartyScale) · บอสคิดเลือดตามคนไว้แล้วใน DirectorService (BossHealthMult)
	local surv = self.ctx.Services.SurvivalService
	local partyScale = Nights.PartyScale(surv and surv:RunPlayerCount(true) or 1)
	local isBoss = opts.Kind == "Boss" or (opts.Kind == "Guardian" and info.Behaviour == "Boss")
	local healthMult = (opts.HealthMult or 1) * (isBoss and 1 or partyScale.Health)
	local maxHp = (info.Health == math.huge) and 1e9 or info.Health * healthMult
	hum.MaxHealth = maxHp
	hum.Health = maxHp
	local speedMult = opts.SpeedMult or 1
	hum.WalkSpeed = (info.Speed or 16) * speedMult
	local kind = opts.Kind or "Wild"
	model:SetAttribute("Kind", kind)
	model:SetAttribute("MaxHealth", maxHp)
	model:SetAttribute("Health", maxHp)
	if kind == "Boss" or kind == "Guardian" and info.Behaviour == "Boss" then
		model:SetAttribute("IsBoss", true)
	end
	model.Parent = self.folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local _, size = model:GetBoundingBox()
	local a = {
		Model = model, Id = id, Info = info, Hum = hum, Root = root, Kind = kind,
		Home = opts.Home or position, State = "Idle", Radius = math.max(size.X, size.Z) * 0.45,
		HealthMult = healthMult, SpeedMult = speedMult,
		-- ปรับความยากทั้งเกม (Config): มอนทั่วไป/บอส ตีเบาลง — ทุกท่า/สกิลบอสคูณ DamageMult ตัวนี้
		DamageMult = (opts.DamageMult or 1) * partyScale.Damage * (model:GetAttribute("IsBoss") and Config.BossDamageScale or Config.MonsterDamageScale),
		NextAttack = 0, NextThink = 0, NextAbility = os.clock() + Config.BossFirstSkill, LastPos = position, StuckSince = nil,
		Leash = opts.Leash or (kind == "Wild" and Config.WildLeash or nil), Night = opts.Night or 0,
	}
	if info.Aquatic then
		-- ลอยที่ผิวน้ำ (ครีบหลังโผล่) : ดันเฉพาะแกนตั้ง ไม่ให้ Humanoid ดำดิ่งลงก้นทะเล
		local att = Instance.new("Attachment")
		att.Name = "FloatAtt"
		att.Parent = root
		local float = Instance.new("AlignPosition")
		float.Name = "Float"
		float.Mode = Enum.PositionAlignmentMode.OneAttachment
		float.Attachment0 = att
		float.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		float.MaxAxesForce = Vector3.new(0, 1e6, 0)
		float.Responsiveness = 12
		float.Position = Vector3.new(0, self.ctx.Layout.WaterLevel + size.Y * 0.4, 0) -- ตัวจริงลอยปริ่มผิวน้ำ · ภาพจมลงครึ่งตัว (AnimalAnimator)
		float.Parent = root
	end
	if info.Behaviour == "Flyer" or info.Flying then
		self:SetupFlying(a)
	elseif info.Behaviour == "Boss" then
		-- บอสเดินพื้น: หมุนตัวเองหาผู้เล่นแบบนุ่มๆ (ไม่ใช่หันตามทางเดิน)
		hum.AutoRotate = false
		local att = Instance.new("Attachment")
		att.Name = "FaceAttachment"
		att.Parent = root
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = 1e9
		ao.Responsiveness = 7
		ao.CFrame = root.CFrame.Rotation
		ao.Parent = root
		a.FaceAlign = ao
	end
	active[model] = a
	table.insert(list, a)
	if kind == "Wild" then
		self.wildCount += 1
	elseif kind == "Raid" then
		self.raidCount += 1
	end
	hum.Died:Connect(function()
		if not a.Dead then
			self:Kill(a, a.LastAttacker)
		end
	end)
	return a
end

function AnimalService:SetupFlying(a)
	local hum, root = a.Hum, a.Root
	hum.PlatformStand = true
	local att = Instance.new("Attachment")
	att.Name = "FlyAttachment"
	att.Parent = root
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 1e7
	ap.MaxVelocity = (a.Info.Speed or 40) * a.SpeedMult
	ap.Responsiveness = 18
	ap.Position = root.Position + Vector3.new(0, 30, 0)
	ap.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	-- บอสบินตัวใหญ่มาก (มวลสูง): แรงหมุนต้องสูงพอ ไม่งั้นหันช้า/ไม่ทันหน้าตอนพ่นไฟ (วัดได้คลาด 80-137°)
	-- (บอสรังเกิดเป็น Kind "Guardian" -> ดูจากพฤติกรรม Boss ไม่ใช่ Kind — เคยพลาดจนมังกรในรังไม่หันหน้า)
	local isBoss = a.Info.Behaviour == "Boss"
	ao.MaxTorque = isBoss and 1e10 or 1e7
	ao.Responsiveness = isBoss and 9 or 12
	ao.CFrame = root.CFrame
	ao.Parent = root
	a.Align, a.Orient = ap, ao
	a.Flying = true
	a.OrbitAngle = self.rng:NextNumber(0, math.pi * 2)
	a.Model:SetAttribute("Flying", true)
end

function AnimalService:Remove(a)
	if a.Removed then
		return
	end
	a.Removed = true
	active[a.Model] = nil
	local idx = table.find(list, a)
	if idx then
		table.remove(list, idx)
	end
	if a.Kind == "Wild" then
		self.wildCount -= 1
	elseif a.Kind == "Raid" then
		self.raidCount -= 1
	end
	if a.Model.Parent then
		a.Model:Destroy()
	end
end

-- หายตัว (จางหาย) เช่น ตอนเช้า
function AnimalService:Vanish(a)
	if a.Dead or a.Removed then
		return
	end
	a.Dead = true
	a.Model:SetAttribute("Vanish", true)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Vanish", { Position = a.Root.Position })
	task.delay(1.2, function()
		self:Remove(a)
	end)
end

---------------------------------------------------------------- ดาเมจ / ตาย
function AnimalService:TakeDamage(a, amount, attacker, opts)
	if a.Dead or a.Kind == "Spirit" then
		return
	end
	opts = opts or {}
	if a.Kind == "Stalker" then
		if not opts.Silent then
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Immune", { Position = a.Root.Position + Vector3.new(0, 4, 0) })
		end
		return
	end
	amount *= (1 - (a.Info.Armor or 0))
	local hum = a.Hum
	local hp = math.max(0, hum.Health - amount)
	if attacker then
		a.LastAttacker = attacker
		a.Provoked = attacker
		a.ProvokedUntil = os.clock() + 12
		if a.OnHurt then
			a.OnHurt(attacker)
		end
	end
	if opts.Burn and opts.Burn > 0 then
		a.Burn = opts.Burn
		a.BurnUntil = os.clock() + 4
		-- ไฟลุกบนตัวมอน (สีตามออร่าอาวุธ) · ส่งไม่เกินวิละครั้งต่อตัว (เครื่องลูกค้าต่อเวลาเอง)
		if not a.BurnFxAt or os.clock() - a.BurnFxAt > 1 then
			a.BurnFxAt = os.clock()
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Burning", { Model = a.Model, Color = opts.BurnColor, Time = 4 })
		end
	end
	if opts.Slow then
		a.SlowUntil = os.clock() + 3
	end
	if a.Info.Behaviour == "Passive" then
		a.FleeUntil = os.clock() + 6
		a.FleeFrom = attacker and attacker.Character and attacker.Character:GetPivot().Position or a.Root.Position
	end
	-- กระเด็นเล็กน้อย (ตัวเล็ก)
	if opts.Knock and a.Radius < 3 and not a.Flying then
		a.Root.AssemblyLinearVelocity += opts.Knock * Vector3.new(1, 0, 1) * 22 + Vector3.new(0, 10, 0)
	end
	hum.Health = hp
	a.Model:SetAttribute("Health", hp)
	if not opts.Silent then
		self.ctx.Remotes.Get("HitFx"):FireAllClients("Hit", {
			Model = a.Model, Position = a.Root.Position, Amount = math.floor(amount + 0.5), Crit = opts.Crit, Mult = opts.Mult,
		})
	end
	if a.Kind == "Boss" or a.Model:GetAttribute("IsBoss") then
		self.ctx.State:SetAttribute("BossHP", hp)
	end
	if hp <= 0 then
		self:Kill(a, attacker)
	end
end

-- เตือนก่อนพุ่ง/ตะครุบ (ม่อนทั่วไป): client วาดแถบแนบพื้นจากตัวไปทิศ dir (BossFX "MobLine")
function AnimalService:DashTelegraph(a, dir, length, width, time)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("BossTelegraph", {
		Shape = "MobLine", Pos = a.Root.Position, Dir = dir, Length = length, Width = width, Time = time, Element = a.Info.Element,
	})
end

function AnimalService:GiveDrops(a, player)
	-- ฝูงบุกแคมป์ตอนกลางคืน = ไม่ดรอปของ (กันของเฟ้อจากการตั้งรับ) · ไม่มีคนได้ของ = ไม่ดรอป
	if not player or a.Kind == "Raid" then
		return
	end
	local extra = self.ctx.Services.SurvivalService:Perk(player, "ExtraDrops", 0)
	-- ลดของเฟ้อ: สัตว์/มอนทั่วไปดรอปแค่ Config.AnimalDropMult ของตาราง (ปัดเศษแบบสุ่ม) · บอสได้ครบ (หัวใจธาตุห้ามหาย)
	local mult = a.Info.Behaviour == "Boss" and 1 or Config.AnimalDropMult
	local got = {}
	for _, d in ipairs(a.Info.Drops or {}) do
		local n = 0
		if d.Chance then
			-- Exact = โอกาส/จำนวนตามตารางเป๊ะ (ไม่คูณ AnimalDropMult และ LootMult) · Min/Max = จำนวนเมื่อดรอป (ไม่ใส่ = 1)
			if self.rng:NextNumber() < d.Chance * (d.Exact and 1 or mult) then
				n = d.Min and self.rng:NextInteger(d.Min, d.Max or d.Min) or 1
			end
		else
			local raw = self.rng:NextInteger(d.Min or 1, d.Max or 1) * mult
			n = math.floor(raw + self.rng:NextNumber())
		end
		if n > 0 and (d.Item == "Pelt" or d.Item == "RawMeat" or d.Item == "Bone" or d.Item == "Fiber") then
			n += extra
		end
		if n > 0 then
			if d.Exact then
				self.ctx.Services.DropService:Spawn(d.Item, n, a.Root.Position)
			else
				n = self.ctx.Services.DropService:SpawnLoot(d.Item, n, a.Root.Position)
			end
			if n > 0 then
				got[d.Item] = (got[d.Item] or 0) + n -- ช้างมีใย 2 แถว (ปกติ + โบนัส) -> รวมกัน
			end
		end
	end
	self.ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = a.Root.Position })
end

function AnimalService:Kill(a, attacker)
	if a.Dead then
		return
	end
	a.Dead = true
	local model = a.Model
	model:SetAttribute("Dead", true)
	model:SetAttribute("Health", 0)
	a.Hum.Health = 0
	if a.Align then
		a.Align.Enabled = false
		a.Orient.Enabled = false
	end
	local pos = a.Root.Position
	-- ผู้ได้ของ: คนตีล่าสุด หรือคนใกล้สุด
	local receiver = attacker
	if not (receiver and receiver.Parent) then
		receiver = a.LastAttacker -- ตายจากไฟ/ป้อม/กับดักหลังโดนคนตี = นับให้คนตีล่าสุด
	end
	if not (receiver and receiver.Parent) then
		local best
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			if c then
				local d = (c:GetPivot().Position - pos).Magnitude
				if d < 140 and (not best or d < best) then
					receiver, best = p, d
				end
			end
		end
	end
	local isBoss = model:GetAttribute("IsBoss")
	if isBoss then
		-- บอส: ของดรอปชุดเดียว (ตกที่ตัวบอส ใครเก็บก็ได้) · Ruby ให้ทุกคนในระยะ
		self:GiveDrops(a, receiver)
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			if c and (c:GetPivot().Position - pos).Magnitude < 260 then
				self.ctx.Services.DataService:AddDiamonds(p, Classes.BossReward[a.Info.Element] or 5, "Defeated " .. a.Info.Thai)
				local pd = self.ctx.Services.DataService:Get(p)
				if pd then
					pd.BossKills = (pd.BossKills or 0) + 1
					self.ctx.Services.DataService:CheckBadges(p)
				end
				Analytics.Custom(p, "BossDefeated", self.ctx.State:GetAttribute("Night") or 1, { a.Id, a.Kind, p:GetAttribute("Class") or "Survivor" })
				if self.ctx.Services.QuestService then
					self.ctx.Services.QuestService:Progress(p, "Boss", 1)
				end
			end
		end
		self.ctx.State:SetAttribute("BossId", "")
		self.ctx.FireRun("Cinematic", "BossFelled", { Name = a.Info.Name, Thai = a.Info.Thai, Element = a.Info.Element })
		self.ctx.Services.SpiritService:OnBossKilled(a)
	else
		self:GiveDrops(a, receiver)
	end
	if receiver then
		receiver:SetAttribute("Kills", (receiver:GetAttribute("Kills") or 0) + 1)
		local ds = self.ctx.Services.DataService
		local pd = ds:Get(receiver)
		if pd then
			pd.Kills = (pd.Kills or 0) + 1
		end
		ds:AddClassStat(receiver, "Kills", 1)
		-- แวมไพร์ (Blood Bite): ฆ่ามอนได้เลือดคืนตามสัดส่วนเลือดสูงสุด
		local surv = self.ctx.Services.SurvivalService
		local pct = surv:Perk(receiver, "KillHealPct", 0)
		local hum = pct > 0 and receiver.Character and receiver.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			surv:Heal(receiver, hum.MaxHealth * pct)
		end
		if self.ctx.Services.QuestService then
			self.ctx.Services.QuestService:Progress(receiver, "Kill", 1)
		end
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Death", { Model = model, Position = pos, Element = a.Info.Element, Boss = isBoss })
	task.delay(isBoss and 6 or 3, function()
		self:Remove(a)
	end)
	if a.OnDeath then
		task.spawn(a.OnDeath, a)
	end
end

---------------------------------------------------------------- เป้าหมาย
local function charRoot(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

function AnimalService:CampDistance(pos)
	local camp = self.ctx.CampPosition
	return ((pos - camp) * Vector3.new(1, 0, 1)).Magnitude
end

function AnimalService:PickTarget(a)
	local info = a.Info
	local surv = self.ctx.Services.SurvivalService
	local night = self.ctx.State:GetAttribute("Phase") == "Night"
	local aggro = (info.Aggro or 60) * ((night and a.Kind ~= "Wild") and 1.3 or 1) -- สัตว์ป่าไม่ตาไวขึ้นตอนกลางคืน
	if a.Kind == "Boss" or a.Kind == "Guardian" then
		aggro = math.max(aggro, 120)
	end
	local safe = self.ctx.Services.CampService:SafeRadius()
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and surv:IsAlive(p) and not p:GetAttribute("Invisible") then -- ล่องหน (สกิลพ่อมดมืด) = มอนมองไม่เห็น
			local d = (r.Position - a.Root.Position).Magnitude
			local ok = d <= aggro or (a.Provoked == p and os.clock() < (a.ProvokedUntil or 0) and d < aggro * 2.5)
			if ok and a.Kind == "Wild" then
				-- สัตว์ป่าไม่เข้าเขตกองไฟ / คลาสผู้คุมอสูรไม่โดนโจมตีก่อน
				if self:CampDistance(r.Position) < safe + 20 then
					ok = false
				elseif surv:Perk(p, "WildPeace", false) and a.Provoked ~= p then
					ok = false
				elseif a.Ignore and a.Ignore[p] and os.clock() < a.Ignore[p] then
					ok = false -- เพิ่งเลิกไล่คนนี้
				end
			end
			if ok and a.Leash and (r.Position - a.Home).Magnitude > a.Leash + 40 then
				ok = false
			end
			if ok and (not bestD or d < bestD) then
				best, bestD = p, d
			end
		end
	end
	return best, bestD
end

---------------------------------------------------------------- การเคลื่อนที่
-- สัตว์น้ำ (Aquatic): จุดหมายบนบก -> ไล่จากจุดหมายกลับมาหาตัว หาจุดแรกที่ยังเป็นน้ำลึก (ว่ายวนชายฝั่ง ไม่ขึ้นบก)
function AnimalService:WaterPoint(a, pos)
	local layout = self.ctx.Layout
	local wl = layout.WaterLevel
	if layout:HeightAt(pos.X, pos.Z) < wl - 2 then
		return Vector3.new(pos.X, wl, pos.Z)
	end
	local from = a.Root.Position
	local d = (from - pos) * Vector3.new(1, 0, 1)
	local len = d.Magnitude
	if len > 1 then
		for t = 4, len, 4 do
			local q = pos + d.Unit * t
			if layout:HeightAt(q.X, q.Z) < wl - 2 then
				return Vector3.new(q.X, wl, q.Z)
			end
		end
	end
	return Vector3.new(from.X, wl, from.Z)
end

function AnimalService:MoveTo(a, pos, speedFactor)
	if a.Info.Aquatic then
		pos = self:WaterPoint(a, pos)
	end
	local hum = a.Hum
	local slow = (a.SlowUntil or 0) > os.clock() and 0.5 or 1
	hum.WalkSpeed = (a.Info.Speed or 16) * a.SpeedMult * (speedFactor or 1) * slow
	-- เดิน = ให้ Humanoid หันตามทางเดินเอง (นุ่ม) · ปิดตัวหมุนตอนยืน
	if a.Turn and a.Turn.Enabled then
		a.Turn.Enabled = false
		hum.AutoRotate = true
	end
	hum:MoveTo(pos)
	a.Moving = true
end

function AnimalService:Stop(a)
	a.Hum:MoveTo(a.Root.Position)
	a.Moving = false
end

function AnimalService:Face(a, pos)
	if a.Flying then
		return
	end
	local root = a.Root
	local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
	if flat.Magnitude < 0.5 then
		return
	end
	if a.FaceAlign then
		a.FaceAlign.CFrame = CFrame.lookAt(Vector3.zero, flat)
		return
	end
	-- หันหาเป้าแบบค่อยๆ หมุน (เดิมตั้ง CFrame ทันทีทุกรอบคิด = ตัวกระตุก/วาปหันขวับ)
	if not a.Turn then
		local att = Instance.new("Attachment")
		att.Name = "TurnAttachment"
		att.Parent = root
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = 1e8
		ao.Responsiveness = 9
		ao.Enabled = false
		ao.Parent = root
		a.Turn = ao
	end
	a.Hum.AutoRotate = false
	a.Turn.CFrame = CFrame.lookAt(Vector3.zero, flat)
	a.Turn.Enabled = true
end

function AnimalService:Wander(a, now, radius, minRadius)
	if not a.WanderAt or now > a.WanderAt then
		a.WanderAt = now + self.rng:NextNumber(5, 11)
		if self.rng:NextNumber() < 0.35 then
			self:Stop(a)
			a.State = "Graze"
		else
			local ang = self.rng:NextNumber(0, math.pi * 2)
			local r = self.rng:NextNumber(minRadius or 10, math.max(radius or 50, (minRadius or 10) + 1))
			local p = a.Home + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
			local h, _, lava = self.ctx.Layout:HeightAt(p.X, p.Z)
			local wet = h < self.ctx.Layout.WaterLevel - 3
			if (a.Info.Aquatic and wet) or (not a.Info.Aquatic and (h > self.ctx.Layout.WaterLevel - 2 or a.Id == "Leviathan")) then
				if not lava or a.Info.Element == "Fire" then
					self:MoveTo(a, Vector3.new(p.X, h + 2, p.Z), 0.45)
					a.State = "Wander"
				end
			end
		end
	end
	a.Model:SetAttribute("State", a.State)
end

-- ติดอยู่กับที่ -> หาสิ่งก่อสร้างใกล้ๆ มาทุบ
function AnimalService:CheckStuck(a, now)
	local moved = (a.Root.Position - a.LastPos).Magnitude
	if moved > 2 then
		a.LastPos = a.Root.Position
		a.StuckSince = nil
		return nil
	end
	if not a.StuckSince then
		a.StuckSince = now
	end
	if now - a.StuckSince > 1.6 then
		a.Hum.Jump = true
		local best, bestD
		for _, s in ipairs(self.ctx.Services.BuildingService:All()) do
			local spec = Items.Structures[s:GetAttribute("Kind")]
			if spec and spec.Breakable and (s:GetAttribute("Health") or 0) > 0 then -- ตีเฉพาะกำแพง (ของอื่นพังไม่ได้ -> กระโดดข้ามแทน)
				local d = (s:GetPivot().Position - a.Root.Position).Magnitude
				if d < 18 + a.Radius and (not bestD or d < bestD) then
					best, bestD = s, d
				end
			end
		end
		return best
	end
	return nil
end

---------------------------------------------------------------- โจมตี
function AnimalService:MarkAttack(a, kind)
	a.Model:SetAttribute("AttackAt", Workspace:GetServerTimeNow())
	a.Model:SetAttribute("AttackKind", kind or "Bite")
end

-- กัด/ตะปบแบบหลบได้ (สไตล์ 99 Nights): หยุดยืน + ล็อกทิศ + แถบเตือนบนพื้น -> ง้าง BITE_WINDUP วิ -> ค่อยตัดสินโดน
--   โดนเฉพาะคนที่ยังอยู่ในระยะ (AttackRange + ตัว + BITE_SLACK) และอยู่ด้านหน้า (มุม ~70° จากทิศที่ล็อกไว้)
--   ถอยหลัง/หลบข้างตอนเห็นแถบเตือน = รอด · เดิม: ตัดสินหลัง 0.3 วิ ระยะ +3 ไม่ดูทิศ = แทบหลบไม่ได้
local BITE_SLACK = 1
local BITE_CONE = 0.35 -- dot ขั้นต่ำ (หน้า = 1)
function AnimalService:BiteWindup(a)
	if a.Info.BiteWindup then
		return a.Info.BiteWindup
	end
	if a.Kind == "Stalker" then
		return 0.45
	end
	return math.clamp(0.45 + a.Radius * 0.03, 0.45, 0.8) -- ตัวใหญ่ง้างนานกว่า
end

function AnimalService:Biting(a, now)
	return a.BiteUntil and now < a.BiteUntil
end

function AnimalService:AttackPlayer(a, player, now, trigger)
	if now < a.NextAttack or self:Biting(a, now) then
		return
	end
	local info = a.Info
	local r0 = charRoot(player)
	if not r0 then
		return
	end
	local windup = self:BiteWindup(a)
	a.NextAttack = now + windup + (info.AttackCooldown or 1.5)
	a.BiteUntil = now + windup + 0.15
	local d0 = (r0.Position - a.Root.Position) * Vector3.new(1, 0, 1)
	local dir = d0.Magnitude > 0.1 and d0.Unit or a.Root.CFrame.LookVector * Vector3.new(1, 0, 1)
	-- ระยะโดน >= ระยะที่เริ่มง้าง + เผื่อ (กันง้างแล้ววืดทั้งที่คนยืนเฉย · ตัววิ่งเร็วไถเลยไปนิดหน่อยตอนหยุด)
	local reach = math.max((info.AttackRange or 6) + a.Radius, trigger or 0) + BITE_SLACK + 0.5
	self:Stop(a)
	self:Face(a, a.Root.Position + dir * 10)
	self:DashTelegraph(a, dir, reach, math.max(5, a.Radius * 1.6 + 3), windup)
	-- ท่ากัดฝั่งไคลเอนต์ใช้ ~0.3 วิถึงจังหวะงับ -> ส่ง AttackAt ให้ตรงจังหวะตัดสิน
	task.delay(math.max(windup - 0.3, 0), function()
		if not a.Dead then
			self:MarkAttack(a, "Bite")
		end
	end)
	task.delay(windup, function()
		if a.Dead or not a.Root.Parent then
			return
		end
		local origin = a.Root.Position
		local mult = a.Kind == "Stalker" and 1 or a.DamageMult -- จิ้งจอกจันทรา: ตีละ 15 เท่ากันทุกคืน
		for _, p in ipairs(Players:GetPlayers()) do
			local r = charRoot(p)
			if r then
				local to = (r.Position - origin) * Vector3.new(1, 0, 1)
				local dist = to.Magnitude
				local ahead = dist < 2 or to.Unit:Dot(dir) >= BITE_CONE
				if dist <= reach and ahead and math.abs(r.Position.Y - origin.Y) < 10 + a.Radius then
					local kb = info.Knockback and (dir * info.Knockback + Vector3.new(0, info.Knockback * 0.4, 0)) or nil
					self.ctx.Services.SurvivalService:Damage(p, (info.Damage or 5) * mult, a.Id, { Burn = info.Burn, Knockback = kb })
				end
			end
		end
	end)
end

function AnimalService:AttackStructure(a, s, now)
	if now < a.NextAttack then
		return
	end
	a.NextAttack = now + (a.Info.AttackCooldown or 1.5)
	self:Face(a, s:GetPivot().Position)
	self:MarkAttack(a, "Bite")
	task.delay(0.3, function()
		if not a.Dead and s.Parent then
			self.ctx.Services.BuildingService:Damage(s, (a.Info.Damage or 5) * (a.Info.StructureDamage or 1) * a.DamageMult)
		end
	end)
end

function AnimalService:AttackFire(a, now)
	if now < a.NextAttack then
		return
	end
	a.NextAttack = now + (a.Info.AttackCooldown or 1.5)
	self:Face(a, self.ctx.CampPosition)
	self:MarkAttack(a, "Bite")
	self.ctx.Services.CampService:DamageFire((a.Info.Damage or 5) * (a.Info.StructureDamage or 1) * 0.6 * a.DamageMult)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("FireHit", { Position = self.ctx.CampPosition })
end

function AnimalService:Spit(a, target, now)
	if now < a.NextAttack then
		return
	end
	a.NextAttack = now + (a.Info.AttackCooldown or 2.4)
	local r = charRoot(target)
	if not r then
		return
	end
	self:Face(a, r.Position)
	self:MarkAttack(a, "Spit")
	local head = a.Model:FindFirstChild("Head") or a.Root
	local from = head.Position + Vector3.new(0, 1, 0)
	local t = math.clamp((r.Position - from).Magnitude / 60, 0.5, 1.6)
	local g = 60
	local lead = r.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * t * 0.6
	local delta = (r.Position + lead) - from
	local vel = delta / t + Vector3.new(0, 0.5 * g * t, 0)
	local color = a.Info.Element == "Water" and Color3.fromRGB(80, 200, 255) or Color3.fromRGB(255, 120, 30)
	self.ctx.Services.CombatService:Projectile({
		From = from, Velocity = vel, Gravity = g, Radius = 3.5, Blast = 7, Damage = (a.Info.Damage or 10) * a.DamageMult,
		Owner = "Animal", Color = color, Size = 1.6, Burn = a.Info.Burn, Fire = a.Info.Element == "Fire", Source = a.Id,
	})
end

---------------------------------------------------------------- AI แต่ละแบบ
function AnimalService:ThinkPassive(a, now)
	if a.FleeUntil and now < a.FleeUntil then
		local away = (a.Root.Position - (a.FleeFrom or a.Root.Position)) * Vector3.new(1, 0, 1)
		if away.Magnitude < 0.1 then
			away = Vector3.new(self.rng:NextNumber(-1, 1), 0, self.rng:NextNumber(-1, 1))
		end
		self:MoveTo(a, a.Root.Position + away.Unit * 40, 1.1)
		a.State = "Flee"
		a.Model:SetAttribute("State", "Flee")
		return
	end
	-- ตกใจเมื่อคนเข้าใกล้
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and (r.Position - a.Root.Position).Magnitude < (a.Info.Aggro or 30) * 0.45 then
			a.FleeUntil = now + 4
			a.FleeFrom = r.Position
			return
		end
	end
	self:Wander(a, now, 60)
end

function AnimalService:ThinkFlyer(a, now, target, dist)
	local layout = self.ctx.Layout
	local ap, ao = a.Align, a.Orient
	local pos = a.Root.Position
	local goal
	if a.DiveUntil and now < a.DiveUntil then
		goal = a.DivePos
		ap.MaxVelocity = (a.Info.Speed or 40) * a.SpeedMult * 1.6
		if target then
			local r = charRoot(target)
			if r and (r.Position - pos).Magnitude < (a.Info.AttackRange or 7) + a.Radius and not a.DiveHit then
				a.DiveHit = true
				self.ctx.Services.SurvivalService:Damage(target, (a.Info.Damage or 8) * a.DamageMult, a.Id)
			end
		end
	else
		ap.MaxVelocity = (a.Info.Speed or 40) * a.SpeedMult
		local center, radius, alt
		if target then
			local r = charRoot(target)
			center = r and r.Position or pos
			radius = a.Kind == "Boss" and 60 or 22
			alt = a.Kind == "Boss" and 55 or 26
			if now >= a.NextAttack and dist and dist < 120 then
				a.NextAttack = now + (a.Info.AttackCooldown or 2)
				a.DivePos = center
				a.DiveUntil = now + 1.1
				a.DiveHit = false
				self:MarkAttack(a, "Dive")
			end
		elseif a.Kind == "Raid" then
			center = self.ctx.CampPosition
			radius = 50
			alt = 30
			if self:CampDistance(pos) < 70 and now >= a.NextAttack then
				a.NextAttack = now + 3
				self.ctx.Services.CampService:DamageFire((a.Info.Damage or 8) * 0.5 * a.DamageMult)
				a.DivePos = self.ctx.CampPosition + Vector3.new(0, 4, 0)
				a.DiveUntil = now + 1
				a.DiveHit = true
				self:MarkAttack(a, "Dive")
			end
		else
			center = a.Home
			radius = 45
			alt = 40
		end
		a.OrbitAngle = (a.OrbitAngle or 0) + Config.AnimalThinkRate * (a.Info.Speed or 40) / math.max(radius, 10) * 0.6
		local ox, oz = math.cos(a.OrbitAngle) * radius, math.sin(a.OrbitAngle) * radius
		local ground = math.max(layout:HeightAt(center.X + ox, center.Z + oz), layout.WaterLevel)
		goal = Vector3.new(center.X + ox, math.max(center.Y, ground) + alt, center.Z + oz)
	end
	ap.Position = goal
	local dir = goal - pos
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude > 1 then
		-- หันตามทิศบิน แต่ไม่เชิด/ก้มเกิน ~20° (ตัวใหญ่ตั้งดิ่งแล้วดูแปลก)
		local pitch = math.clamp(math.atan2(dir.Y, flat.Magnitude), -0.35, 0.35)
		ao.CFrame = CFrame.lookAt(pos, pos + flat) * CFrame.Angles(pitch, 0, 0)
	end
end

-- บอส: ไม่เข้าตีประชิด — คุมระยะ หันหน้าหาผู้เล่นตลอด แล้วใช้สกิล (มีวงเตือนให้หลบ) วนไปทีละท่า
function AnimalService:FaceBoss(a, pos)
	local root = a.Root
	if a.CastFace then
		pos = root.Position + a.CastFace * 50 -- กำลังร่ายสกิลแนวตรง: หน้าล็อกตามทิศสกิล
	end
	local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
	if flat.Magnitude < 1 then
		return
	end
	local look = CFrame.lookAt(Vector3.zero, flat)
	if a.FaceAlign then
		a.FaceAlign.CFrame = look
	elseif a.Orient then
		a.Orient.CFrame = look
	end
end

function AnimalService:ThinkBoss(a, now)
	local info = a.Info
	local target, dist = self:PickTarget(a)
	if not target then
		-- บอสไม่สนเขตปลอดภัยของกองไฟ: เล็งผู้เล่นที่ใกล้สุดในระยะ 200
		local surv = self.ctx.Services.SurvivalService
		for _, p in ipairs(Players:GetPlayers()) do
			local pr = charRoot(p)
			if pr and surv:IsAlive(p) then
				local d = (pr.Position - a.Root.Position).Magnitude
				if d < 200 and (not dist or d < dist) then
					target, dist = p, d
				end
			end
		end
	end
	local r = target and charRoot(target)
	local center = r and r.Position
	if not center then
		-- ไม่มีผู้เล่นในระยะ: เดินไปทางแคมป์แล้วยืนคุมเชิง (เฝ้าถิ่นถ้าเป็นบอสถ้ำ)
		if a.Leash then
			center = a.Home
		else
			center = self.ctx.CampPosition
		end
		dist = ((center - a.Root.Position) * Vector3.new(1, 0, 1)).Magnitude
	end
	local keep = 45 + a.Radius * 0.5
	if a.Flying then
		-- มังกร: บินวน (ต่ำ) <-> ร่อนลงสู้บนพื้น สลับกัน — ตอนลงพื้นเดินเข้าไปตีได้
		if not a.PhaseUntil then
			a.PhaseUntil = now + 11
			a.RootHeight = a.Root.Size.Y / 2 + a.Hum.HipHeight
		end
		if now >= a.PhaseUntil and not a.Casting then
			a.Grounded = not a.Grounded
			a.PhaseUntil = now + (a.Grounded and 14 or 11)
			a.Model:SetAttribute("Grounded", a.Grounded)
		end
		local ap = a.Align
		a.OrbitAngle = (a.OrbitAngle or 0) + Config.AnimalThinkRate * (a.Grounded and 0.06 or 0.22)
		local rad = a.Grounded and keep * 0.75 or keep + 10
		local gx, gz = center.X + math.cos(a.OrbitAngle) * rad, center.Z + math.sin(a.OrbitAngle) * rad
		local layout = self.ctx.Layout
		local floor = math.max(layout:HeightAt(gx, gz), layout.WaterLevel)
		local gy = a.Grounded and (floor + a.RootHeight) or (math.max(floor, center.Y) + 26)
		if ap and not a.Casting then
			ap.Position = Vector3.new(gx, gy, gz)
		end
		self:FaceBoss(a, center)
	else
		-- บอสเดินพื้น: ยืนคุมพื้นที่ หันหาผู้เล่น (ไม่ถอยหนี จะได้เข้าไปตีได้) เดินเข้าหาเมื่ออยู่ไกล
		self:FaceBoss(a, center)
		if a.Casting then
			self:Stop(a)
			a.State = "Cast"
		elseif dist > keep + 35 then
			self:MoveTo(a, center, 1)
			a.State = "Chase"
		else
			self:Stop(a)
			a.State = "Idle"
		end
	end
	-- สกิล (วนตามลำดับ · แต่ละท่าคูลดาวน์ของตัวเอง ยังไม่พร้อม = รอ)
	if r and not a.Casting and now >= a.NextAbility and dist < 170 then
		local ab = BossAbilities.Pick(a, info.Abilities or {})
		if ab then
			self:Stop(a)
			BossAbilities.Run(self.ctx, a, ab, target)
		end
	end
	a.Model:SetAttribute("State", a.State)
end

function AnimalService:ThinkHostile(a, now)
	local info = a.Info
	local b = info.Behaviour
	if b == "Boss" then
		return self:ThinkBoss(a, now)
	end
	local target, dist = self:PickTarget(a)
	local campMode = (a.Kind == "Raid") or (a.Kind == "Boss" and not a.Leash)
	-- สัตว์ป่า: ไล่ไม่ถึงตัวนานเกิน WildChaseTime = เลิกไล่คนนั้นสักพัก แล้วกลับถิ่น (ไม่ตามยาวจนถึงแคมป์)
	if target and a.Kind == "Wild" then
		local close = dist and dist <= (info.AttackRange or 6) + a.Radius + 3
		if a.ChaseTarget ~= target or close then
			a.ChaseTarget, a.ChaseSince = target, now
		elseif now - a.ChaseSince > Config.WildChaseTime then
			a.Ignore = a.Ignore or {}
			a.Ignore[target] = os.clock() + Config.WildGiveUpTime
			a.ChaseTarget = nil
			target, dist = nil, nil
		end
	end

	if a.Flying then
		return self:ThinkFlyer(a, now, target, dist)
	end

	-- กำลังง้างกัด: ยืนนิ่ง ทิศล็อก (ให้คนเห็นแถบเตือนแล้วหลบ)
	if self:Biting(a, now) then
		self:Stop(a)
		a.State = "Attack"
		a.Model:SetAttribute("State", "Attack")
		return
	end

	-- ตะครุบ: เล็งครบแล้วกระโจนไปทิศที่ล็อกไว้
	if a.LeapAt then
		if now < a.LeapAt then
			return
		end
		a.LeapAt = nil
		a.Root.AssemblyLinearVelocity = a.LeapDir * 42 + Vector3.new(0, 24, 0)
		self:MarkAttack(a, "Leap")
	end

	-- สายชน: ตั้งท่า -> พุ่ง -> พัก
	if a.State == "Windup" then
		if now >= a.StateUntil then
			a.State = "Charge"
			a.StateUntil = now + 1.3
			a.Model:SetAttribute("State", "Charge")
			local dir = a.ChargeDir
			a.ChargeStart = now
			self:MoveTo(a, a.Root.Position + dir * 50, 1.3)
		end
		return
	elseif a.State == "Charge" then
		do
			local ahead = a.Root.Position + a.ChargeDir * (a.Radius + 6)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Include
			rp.FilterDescendantsInstances = { workspace.Terrain }
			local hit = workspace:Raycast(ahead + Vector3.new(0, 6, 0), Vector3.new(0, -18, 0), rp)
			if not hit or hit.Material == Enum.Material.Water then
				a.StateUntil = now -- จบพุ่งทันที
			end
		end
		local ramp = math.clamp((now - (a.ChargeStart or now)) / 0.5, 0, 1)
		a.Hum.WalkSpeed = (info.Speed or 16) * a.SpeedMult * (1.3 + 1.3 * ramp)
		for _, p in ipairs(Players:GetPlayers()) do
			local r = charRoot(p)
			if r and (r.Position - a.Root.Position).Magnitude < a.Radius + 4 and not a.ChargeHit[p] then
				a.ChargeHit[p] = true
				local kb = a.ChargeDir * (info.Knockback or 80) + Vector3.new(0, 40, 0)
				self.ctx.Services.SurvivalService:Damage(p, (info.Damage or 10) * a.DamageMult * 1.3, a.Id, { Knockback = kb })
			end
		end
		for _, s in ipairs(self.ctx.Services.BuildingService:All()) do
			if not a.ChargeHit[s] and (s:GetPivot().Position - a.Root.Position).Magnitude < a.Radius + 7 then
				a.ChargeHit[s] = true
				self.ctx.Services.BuildingService:Damage(s, (info.Damage or 10) * (info.StructureDamage or 1) * a.DamageMult * 1.5)
			end
		end
		if now >= a.StateUntil then
			a.State = "Recover"
			a.StateUntil = now + 1.2
			a.Model:SetAttribute("State", "Recover")
			self:Stop(a)
		end
		return
	elseif a.State == "Recover" then
		if now < a.StateUntil then
			return
		end
		a.State = "Chase"
	end

	-- บอส: ท่าพิเศษ
	if (b == "Boss") and target and not a.Casting and now >= a.NextAbility and dist and dist < 110 then
		local ab = BossAbilities.Pick(a, info.Abilities or {})
		if ab then
			BossAbilities.Run(self.ctx, a, ab, target)
			return
		end
	end

	if target then
		local r = charRoot(target)
		local reach = (info.AttackRange or 6) + a.Radius
		if b == "Spitter" then
			if dist < 22 then
				local away = (a.Root.Position - r.Position) * Vector3.new(1, 0, 1)
				self:MoveTo(a, a.Root.Position + away.Unit * 20, 1)
			elseif dist > (info.AttackRange or 60) * 0.8 then
				self:MoveTo(a, r.Position, 1)
			else
				self:Stop(a)
				self:Spit(a, target, now)
			end
			a.State = "Chase"
		elseif dist <= reach then
			self:Stop(a)
			self:Face(a, r.Position)
			self:AttackPlayer(a, target, now, reach)
			a.State = "Attack"
		elseif b == "Charger" and dist > 14 and dist < 30 and now >= a.NextAttack and now >= (a.NextCharge or 0) then
			a.NextCharge = now + (info.ChargeCooldown or 7)
			a.State = "Windup"
			a.StateUntil = now + CHARGE_WINDUP
			a.ChargeHit = {}
			local d = (r.Position - a.Root.Position) * Vector3.new(1, 0, 1)
			a.ChargeDir = d.Magnitude > 0.1 and d.Unit or a.Root.CFrame.LookVector
			a.NextAttack = now + (info.AttackCooldown or 2.4) + 1.3
			self:Stop(a)
			self:Face(a, r.Position)
			a.Model:SetAttribute("State", "Windup")
			self:MarkAttack(a, "Roar")
			-- แถบเตือนบนพื้น: ทางที่จะพุ่งผ่าน (ยาวตามความเร็วพุ่ง ไม่เกินระยะสั่งเดิน 50)
			self:DashTelegraph(a, a.ChargeDir, math.min(50, (info.Speed or 16) * a.SpeedMult * 3), a.Radius * 2 + 4, CHARGE_WINDUP)
			return
		else
			-- กระโดดตะครุบ
			if info.Leap and dist < 28 and dist > 10 and now >= (a.NextLeap or 0) then
				-- ย่อตัวเล็งก่อน LEAP_WINDUP วิ + แถบเตือน แล้วค่อยกระโจน (ทิศล็อกตอนเล็ง หลบได้)
				a.NextLeap = now + 4
				local d = (r.Position - a.Root.Position) * Vector3.new(1, 0, 1)
				a.LeapDir = d.Magnitude > 0.1 and d.Unit or a.Root.CFrame.LookVector
				a.LeapAt = now + LEAP_WINDUP
				self:Stop(a)
				self:Face(a, r.Position)
				self:DashTelegraph(a, a.LeapDir, math.clamp(d.Magnitude + 4, 10, 26), a.Radius * 2 + 3, LEAP_WINDUP)
				return
			end
			self:MoveTo(a, r.Position, 1)
			a.State = "Chase"
			local blocking = self:CheckStuck(a, now)
			if blocking then
				self:AttackStructure(a, blocking, now)
			end
		end
	elseif campMode then
		local dCamp = self:CampDistance(a.Root.Position)
		if dCamp < 13 + a.Radius then
			self:Stop(a)
			self:AttackFire(a, now)
			a.State = "Attack"
		else
			self:MoveTo(a, self.ctx.CampPosition, 1)
			a.State = "Raid"
			local blocking = self:CheckStuck(a, now)
			if blocking then
				self:AttackStructure(a, blocking, now)
			end
		end
	else
		-- เฝ้าถิ่น / เดินเล่น
		if a.Leash and (a.Root.Position - a.Home).Magnitude > a.Leash then
			self:MoveTo(a, a.Home, 1)
			a.State = "Return"
			a.Hum.Health = math.min(a.Hum.MaxHealth, a.Hum.Health + a.Hum.MaxHealth * 0.05)
			a.Model:SetAttribute("Health", a.Hum.Health)
		else
			self:Wander(a, now, a.Leash or 70)
		end
	end
	a.Model:SetAttribute("State", a.State)
end

-- ปีศาจจิ้งจอกจันทรา (ตัวไล่กลางคืน · ฆ่าไม่ตาย) — สไตล์กวางของ 99 Nights
--   ซ่อนตัว (หายไป) -> วาปโผล่ข้างหลังเหยื่อ (คนนอกแคมป์ ไกลกองไฟที่สุด) -> วิ่งไล่ + เสียงขู่คำราม -> กัด (ตีละ 15 · ง้างก่อน หลบได้)
--   เหยื่อถือไฟ / เข้าแคมป์ / ล่องหน / อยู่ใต้แสงตะเกียง = ไม่มีเหยื่อแล้ว -> เดินหนีออกไปแล้วหายตัว (ไม่ยืนเฝ้า)
--   หายแล้วพักสักครู่ -> คนออกมานอกแสงอีก = วาปไปหาแล้วไล่ใหม่ · เหยื่อไกลเกิน = หายแล้ววาปไปใหม่
local STALK_EDGE = 4 -- จิ้งจอกอยู่ห่างวงแคมป์อย่างน้อยเท่านี้
local STALK_SWITCH = 30 -- คนใหม่ต้องไกลกองไฟกว่าเป้าเดิมเท่านี้ ถึงจะเปลี่ยนเป้า
local STALK_WARP = { 34, 46 } -- ระยะโผล่จากเหยื่อ (ข้างหลังเหยื่อ ± มุมสุ่ม)
local STALK_REAPPEAR = 5 -- หายตัวแล้วอย่างน้อยกี่วิ ถึงจะวาปกลับมาได้
local STALK_RETREAT = 2.5 -- เดินหนีกี่วิก่อนหายตัว
local STALK_FAR = 150 -- เหยื่อไกลกว่านี้ = หายแล้ววาปไปหา
local STALK_FADE = 0.45 -- เวลาจางหาย (ฝั่งเครื่องผู้เล่น)
local STALK_VAULT = 800 -- ซ่อนไว้บนฟ้าสูงเท่านี้ (ใส + ยึดอยู่กับที่ · ไม่ใต้ดิน กันโดนลบตอนตกแมพ)
local CHASE_SOUND = "rbxassetid://9120788426" -- Wolf Growl 6 (ProSoundEffects) วนตอนไล่

function AnimalService:StalkerSound(a, on)
	local s = a.ChaseSound
	if not s or not s.Parent then
		s = Instance.new("Sound")
		s.Name = "ChaseGrowl"
		s.SoundId = CHASE_SOUND
		s.Looped = true
		s.Volume = 1.6
		s.PlaybackSpeed = 0.85
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 14
		s.RollOffMaxDistance = 160
		s.Parent = a.Root
		a.ChaseSound = s
	end
	if s.Playing ~= on then
		s.Playing = on
	end
end

function AnimalService:StalkerHide(a, now, wait)
	if a.Hidden then
		return
	end
	a.Hidden = true
	a.Retreating = nil
	a.ReappearAt = now + (wait or STALK_REAPPEAR)
	self:StalkerSound(a, false)
	self:Stop(a)
	a.Model:SetAttribute("Hidden", true)
	a.Model:SetAttribute("State", "Hidden")
	a.State = "Hidden"
	self.ctx.Remotes.Get("HitFx"):FireAllClients("StalkerFade", { Position = a.Root.Position })
	task.delay(STALK_FADE + 0.05, function()
		if a.Hidden and not a.Dead and a.Root.Parent then
			local p = a.Root.Position
			a.Root.AssemblyLinearVelocity = Vector3.zero
			a.Root.Anchored = true
			a.Model:PivotTo(CFrame.new(p.X, STALK_VAULT, p.Z) * a.Root.CFrame.Rotation)
		end
	end)
end

-- หาจุดโผล่: ข้างหลังเหยื่อ (ไม่เห็นตอนโผล่) บนพื้นดิน · ไม่ในน้ำ ไม่ในวงแคมป์ ไม่ใต้แสง
function AnimalService:StalkerWarpSpot(a, r, keepOut, lit)
	local look = r.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, 1)
	local base = math.atan2(-look.Z, -look.X) -- ข้างหลัง
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { workspace.Terrain }
	local camp = self.ctx.CampPosition
	for i = 1, 14 do
		local spread = i <= 6 and 1.1 or 2.6 -- ลองข้างหลังก่อน ไม่ได้ค่อยกว้างขึ้น
		local ang = base + self.rng:NextNumber(-spread, spread)
		local dist = self.rng:NextNumber(STALK_WARP[1], STALK_WARP[2])
		local x, z = r.Position.X + math.cos(ang) * dist, r.Position.Z + math.sin(ang) * dist
		local hit = workspace:Raycast(Vector3.new(x, r.Position.Y + 220, z), Vector3.new(0, -480, 0), rp)
		if hit and hit.Material ~= Enum.Material.Water then
			local pos = hit.Position
			local flat = ((pos - camp) * Vector3.new(1, 0, 1)).Magnitude
			if (keepOut <= 0 or flat > keepOut + 2) and not lit(pos) and math.abs(pos.Y - r.Position.Y) < 40 then
				return pos
			end
		end
	end
	return nil
end

function AnimalService:StalkerWarp(a, ground, prey, now)
	local r = charRoot(prey)
	local h = a.Root.Size.Y / 2 + a.Hum.HipHeight + 0.5
	local pos = ground + Vector3.new(0, h, 0)
	local face = r and Vector3.new(r.Position.X, pos.Y, r.Position.Z) or pos + Vector3.new(0, 0, 1)
	a.Model:PivotTo(CFrame.lookAt(pos, face))
	a.Root.AssemblyLinearVelocity = Vector3.zero
	a.Root.Anchored = false
	pcall(function()
		a.Root:SetNetworkOwner(nil)
	end)
	a.Hidden = nil
	a.Prey = prey
	a.LastPos, a.StuckSince, a.DetourUntil = pos, nil, nil
	a.NextAttack = math.max(a.NextAttack, now + 1) -- โผล่แล้วไม่กัดทันที
	a.Model:SetAttribute("Hidden", false)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("StalkerWarp", { Position = ground, Prey = prey })
end

function AnimalService:ThinkStalker(a, now)
	local camp = self.ctx.CampPosition
	local cs = self.ctx.Services.CampService
	local zone = cs:SafeRadius() > 0 and cs:CampRadius() or 0 -- ไฟดับ = ไม่มีที่ปลอดภัย
	local lights = self.ctx.Services.BuildingService:LightSources()
	local surv = self.ctx.Services.SurvivalService
	local keepOut = zone > 0 and zone + STALK_EDGE or 0
	local function lit(pos)
		if zone > 0 and self:CampDistance(pos) < zone then
			return true
		end
		for _, l in ipairs(lights) do
			if (l[1] - pos).Magnitude < l[2] then
				return true
			end
		end
		return false
	end
	local function outside(pos)
		local flat = (pos - camp) * Vector3.new(1, 0, 1)
		if flat.Magnitude < keepOut then
			flat = flat.Magnitude > 0.5 and flat.Unit or Vector3.new(1, 0, 0)
			return Vector3.new(camp.X, pos.Y, camp.Z) + flat * keepOut
		end
		return pos
	end
	local function setState(st)
		if a.State ~= st then
			a.State = st
			a.Model:SetAttribute("State", st)
		end
	end
	-- เหยื่อที่ไล่ได้: ในรอบ · ยังรอด · ไม่ล่องหน · ไม่อยู่ใต้แสง/ในแคมป์ · ไม่ถือไฟ
	local function huntable(p)
		local r = charRoot(p)
		if not (r and p:GetAttribute("InRun") and surv:IsAlive(p) and not p:GetAttribute("Invisible") and not lit(r.Position)) then
			return nil
		end
		local _, tool = self.ctx.Services.CombatService.EquippedTool(p)
		if tool and tool.Light then
			return nil
		end
		return r
	end
	local function pickPrey()
		local best, bestD, preyD
		for _, p in ipairs(Players:GetPlayers()) do
			local r = huntable(p)
			if r then
				local d = self:CampDistance(r.Position)
				if p == a.Prey then
					preyD = d
				end
				if not bestD or d > bestD then
					best, bestD = p, d
				end
			end
		end
		if preyD and best ~= a.Prey and bestD - preyD < STALK_SWITCH then
			best = a.Prey -- ติดเป้าเดิมไว้ (กันสลับไปมา)
		end
		return best
	end

	-- 1) ซ่อนตัวอยู่: ครบเวลาพัก + มีเหยื่อนอกแสง = วาปไปข้างหลังเหยื่อ
	if a.Hidden then
		if now < (a.ReappearAt or 0) then
			return
		end
		local prey = pickPrey()
		local r = prey and charRoot(prey)
		if r then
			local spot = self:StalkerWarpSpot(a, r, keepOut, lit)
			if spot then
				self:StalkerWarp(a, spot, prey, now)
				setState("Hunt")
			end
		end
		return
	end
	if self:Biting(a, now) then
		self:Stop(a)
		return
	end
	-- 2) กำลังเดินหนี: ครบเวลา = หายตัว
	if a.Retreating then
		if now >= a.RetreatUntil then
			self:StalkerHide(a, now)
			return
		end
		local away = (a.Root.Position - a.RetreatFrom) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.5 and away.Unit or a.Root.CFrame.LookVector * -1
		self:MoveTo(a, a.Root.Position + away * 30, 0.8)
		setState("Retreat")
		return
	end
	local function retreat(from)
		a.Retreating = true
		a.RetreatFrom = from
		a.RetreatUntil = now + STALK_RETREAT
		self:StalkerSound(a, false)
		setState("Retreat")
	end
	-- หลุดเข้าไปในวงแคมป์ (เช่น ไฟเพิ่งติดกลับ) = เดินออกแล้วหาย
	if zone > 0 and self:CampDistance(a.Root.Position) < zone then
		retreat(camp)
		return
	end

	-- 3) ไล่
	local prey = pickPrey()
	if not prey then
		-- เหยื่อเข้าแคมป์ / ถือไฟ / ทุกคนอยู่ในแสง: ไม่ยืนเฝ้า เดินหนีออกจากคนล่าสุดแล้วหายตัว
		local last = a.Prey and charRoot(a.Prey)
		retreat(last and last.Position or camp)
		return
	end
	if prey ~= a.Prey then
		a.Prey = prey
		a.StuckSince, a.DetourUntil = nil, nil
	end
	local r = charRoot(prey)
	local d = (r.Position - a.Root.Position).Magnitude
	if d > STALK_FAR then
		self:StalkerHide(a, now, 1.2) -- ไกลเกิน: หายแล้ววาปไปหาเลย
		return
	end
	setState("Hunt")
	self:StalkerSound(a, true)
	-- เลี่ยงสิ่งกีดขวางอยู่: วิ่งไปจุดข้าง ๆ ให้พ้นก่อน
	if a.DetourUntil and now < a.DetourUntil and d > 14 then
		self:MoveTo(a, a.DetourPos, 1.2)
		return
	end
	a.DetourUntil = nil
	-- ถึงระยะ + คูลดาวน์ครบ = ตี · คูลดาวน์อยู่ = วิ่งตามติดตัวต่อ
	local reach = (a.Info.AttackRange or 7) + a.Radius + 2
	if d < reach and now >= a.NextAttack then
		self:Stop(a)
		self:Face(a, r.Position)
		self:AttackPlayer(a, prey, now, reach)
		a.StuckSince = nil
		return
	end
	-- วิ่งนำหน้าเป้านิดหน่อย (ดักทางคนที่กำลังวิ่งหนี) · ไกล = เร่งตามทัน
	local lead = r.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * math.clamp(d / 60, 0, 0.6)
	self:MoveTo(a, outside(r.Position + lead), d > 50 and 1.3 or 1.1)
	-- ติด: ไม่ขยับเลยทั้งที่ยังไกลเป้า -> กระโดด · ติดนาน -> เลี่ยงไปข้าง ๆ 1.2 วิ
	if (a.Root.Position - (a.LastPos or a.Root.Position)).Magnitude > 2 then
		a.LastPos = a.Root.Position
		a.StuckSince = nil
	elseif d > reach * 1.8 then
		a.StuckSince = a.StuckSince or now
		if now - a.StuckSince > 0.8 then
			a.Hum.Jump = true
		end
		if now - a.StuckSince > 1.6 then
			local to = (r.Position - a.Root.Position) * Vector3.new(1, 0, 1)
			to = to.Magnitude > 0.1 and to.Unit or a.Root.CFrame.LookVector
			local side = Vector3.new(-to.Z, 0, to.X) * (self.rng:NextNumber() < 0.5 and -1 or 1)
			a.DetourPos = outside(a.Root.Position + side * 14 - to * 4)
			a.DetourUntil = now + 1.2
			a.StuckSince = nil
		end
	end
end

-- ลูกสัตว์ที่ช่วยแล้ว: เดินเล่นในเขตแคมป์เอง (ไม่ตามใคร) · หลุดไปไกล (ลงจากหลังนอกแคมป์) = เดินกลับบ้าน
function AnimalService:ThinkPet(a, now)
	if a.Rider then
		return
	end
	-- ลงจากหลังที่ไหน = รอตรงนั้น (เดินเล่นวงแคบรอบจุดเดิม ไม่กลับบ้านเอง)
	if a.StayAt then
		a.Home = a.StayAt
		if ((a.Root.Position - a.StayAt) * Vector3.new(1, 0, 1)).Magnitude > 14 then
			self:MoveTo(a, a.StayAt, 0.6)
			a.State = "Return"
		else
			self:Wander(a, now, 6, 2)
		end
		a.Model:SetAttribute("State", a.State)
		return
	end
	local camp = self.ctx.CampPosition
	local radius = math.max(self.ctx.Services.CampService:CampRadius() - 12, 24)
	local d = ((a.Root.Position - camp) * Vector3.new(1, 0, 1)).Magnitude
	if d > 400 then
		a.Model:PivotTo(CFrame.new(camp + Vector3.new(radius * 0.5, self.ctx.Layout:HeightAt(camp.X + radius * 0.5, camp.Z) - camp.Y + 4, 0)))
		return
	elseif d > radius + 6 then
		self:MoveTo(a, Vector3.new(camp.X, a.Root.Position.Y, camp.Z), 0.7)
		a.State = "Return"
		a.WanderAt = now + 3
	else
		a.Home = camp
		self:Wander(a, now, radius, 18) -- ไม่เข้าใกล้กองไฟเกิน 18 stud
	end
	a.Model:SetAttribute("State", a.State)
end

-- ฉากเปิดตัวบอส: ตรึงไว้ที่จุดเกิด ~7 วิ (เครื่องผู้เล่นขยับตัวบอสเล่นฉากเอง) แล้วปล่อยสู้
--   โมเดลส่งถึงทุกเครื่องเสมอ (Persistent) -> ฉากไม่หลุดเพราะบอสยังโหลดมาไม่ถึง
AnimalService.IntroTime = 7.2
function AnimalService:BeginIntro(a)
	pcall(function()
		a.Model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	a.IntroUntil = os.clock() + AnimalService.IntroTime
	a.Root.Anchored = true
	a.Root.AssemblyLinearVelocity = Vector3.zero
	a.Model:SetAttribute("Intro", true)
	task.delay(AnimalService.IntroTime, function()
		if a.Root.Parent and not a.Dead then
			a.Root.Anchored = false
			a.Model:SetAttribute("Intro", false)
		end
	end)
end

function AnimalService:Think(a, now)
	if a.Dead or a.Removed or not a.Model.Parent then
		return
	end
	if a.IntroUntil and os.clock() < a.IntroUntil then
		return -- ฉากเปิดตัวบอส / ผู้เฝ้าศาลเจ้าเดินตามบท: ไม่คิดเอง
	end
	if a.Rider then
		return -- มีคนขี่อยู่ (ตัวติดกับผู้ขี่ ห้ามย้าย/ดึงลงพื้นเอง)
	end
	if a.Hidden then
		return self:ThinkStalker(a, now) -- จิ้งจอกซ่อนตัวบนฟ้า: ข้ามเช็กพื้น/ตกแมพ
	end
	-- ไฟไหม้
	if a.BurnUntil and now < a.BurnUntil then
		self:TakeDamage(a, (a.Burn or 3) * Config.AnimalThinkRate, nil, { Silent = true, Source = "Burn" })
		if a.Dead then
			return
		end
	end
	-- พิษ (สกิลพงไพร): เสียเลือดเป็นสัดส่วนของเลือดสูงสุด
	if a.PoisonUntil and now < a.PoisonUntil then
		self:TakeDamage(a, a.Hum.MaxHealth * (a.PoisonPct or 0.01) * Config.AnimalThinkRate, a.PoisonBy, { Silent = true, Source = "Poison" })
		if a.Dead then
			return
		end
	end
	-- สตั้น (สกิลพงไพร): ยืนนิ่ง ไม่โจมตี
	if a.StunUntil and now < a.StunUntil then
		self:Stop(a)
		return
	end
	-- ตกน้ำลึก/หลุดแมพ
	if a.Root.Position.Y < -120 then
		self:Remove(a)
		return
	end
	-- (บอสในรังเกิดเป็น Guardian: ห้ามดึงขึ้นผิวดิน — เคยดึงเยติจากพื้นวังน้ำแข็งขึ้นไปค้างบนหลังคา/ตกฐาน)
	if not a.Flying and a.Info.Behaviour ~= "Boss" and now >= (a.NextGroundCheck or 0) then
		a.NextGroundCheck = now + 1
		local p = a.Root.Position
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { workspace.Terrain }
		local below = workspace:Raycast(p, Vector3.new(0, -40, 0), rp)
		local surface = not below and workspace:Raycast(p + Vector3.new(0, 150, 0), Vector3.new(0, -150, 0), rp)
		if surface and surface.Material ~= Enum.Material.Water and surface.Position.Y > p.Y + 1 then
			a.Root.AssemblyLinearVelocity = Vector3.zero
			a.Model:PivotTo(CFrame.new(p.X, surface.Position.Y + a.Root.Size.Y / 2 + a.Hum.HipHeight + 0.5, p.Z) * a.Root.CFrame.Rotation)
		end
	end
	if a.Kind == "Spirit" then
		if a.Pet then
			self:ThinkPet(a, now)
		end
		return
	elseif a.Kind == "Stalker" then
		return self:ThinkStalker(a, now)
	elseif a.Info.Behaviour == "Passive" then
		return self:ThinkPassive(a, now)
	end
	self:ThinkHostile(a, now)
end

---------------------------------------------------------------- สัตว์ป่า (กลางวัน)
function AnimalService:SpawnWildNear(player)
	local r = charRoot(player)
	if not r then
		return
	end
	local layout = self.ctx.Layout
	for _ = 1, 6 do
		local ang = self.rng:NextNumber(0, math.pi * 2)
		local d = self.rng:NextNumber(Config.WildSpawnRadius.Min, Config.WildSpawnRadius.Max)
		local x, z = r.Position.X + math.cos(ang) * d, r.Position.Z + math.sin(ang) * d
		if math.abs(x) < layout.Half - layout.EdgeOcean and math.abs(z) < layout.Half - layout.EdgeOcean then
			local h, biome, lava = layout:HeightAt(x, z)
			local campD = math.sqrt(x * x + z * z)
			if h > layout.WaterLevel + 1 and not lava and campD > 150 then
				local weights = Biomes.Data[biome].Wild
				if weights then
					local total = 0
					for _, w in pairs(weights) do
						total += w
					end
					local pick = self.rng:NextNumber() * total
					for id, w in pairs(weights) do
						pick -= w
						if pick <= 0 then
							local info = Animals.Data[id]
							if info.Aquatic then
								-- สัตว์น้ำ: หาน้ำลึกใกล้จุดนี้ (ชายฝั่ง) แล้วเกิดที่ผิวน้ำ
								for _ = 1, 14 do
									local a2 = self.rng:NextNumber(0, math.pi * 2)
									local d2 = self.rng:NextNumber(20, 110)
									local wx, wz = x + math.cos(a2) * d2, z + math.sin(a2) * d2
									if layout:HeightAt(wx, wz) < layout.WaterLevel - 5 then
										self:Spawn(id, Vector3.new(wx, layout.WaterLevel + 1, wz), { Kind = "Wild" })
										break
									end
								end
								return
							end
							local count = info.Pack and self.rng:NextInteger(info.Pack[1], info.Pack[2]) or 1
							for i = 1, count do
								local off = Vector3.new(self.rng:NextNumber(-6, 6), 0, self.rng:NextNumber(-6, 6))
								local pos = Vector3.new(x, h, z) + off
								local hh = layout:HeightAt(pos.X, pos.Z)
								self:Spawn(id, Vector3.new(pos.X, hh + 1, pos.Z), { Kind = "Wild" })
							end
							return
						end
					end
				end
			end
		end
	end
end

function AnimalService:WildTick()
	local players = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") then
			table.insert(players, p)
		end
	end
	if #players == 0 then
		return
	end
	-- ลบสัตว์ป่าที่ไกลจากทุกคน
	for i = #list, 1, -1 do
		local a = list[i]
		if a and a.Kind == "Wild" and not a.Dead then
			local near = false
			for _, p in ipairs(players) do
				local r = charRoot(p)
				if r and (r.Position - a.Root.Position).Magnitude < Config.WildDespawnRadius then
					near = true
					break
				end
			end
			if not near then
				self:Remove(a)
			end
		end
	end
	local phase = self.ctx.State:GetAttribute("Phase")
	-- เพดานสัตว์ป่าเพิ่มเล็กน้อยตามจำนวนคนในรอบ (1 คน = x1.0 · +10% ต่อคน สูงสุด x1.6)
	local cap = Config.MaxWildAnimals * (phase == "Night" and 0.4 or 1) * math.min(1 + 0.1 * (#players - 1), 1.6)
	if self.wildCount < cap then
		local p = players[self.rng:NextInteger(1, #players)]
		local r = charRoot(p)
		if r and self:CampDistance(r.Position) > 60 then
			self:SpawnWildNear(p)
		elseif r and self.wildCount < cap * 0.3 then
			self:SpawnWildNear(p)
		end
	end
end

---------------------------------------------------------------- ลูป
function AnimalService:ClearKind(kind, vanish)
	for i = #list, 1, -1 do
		local a = list[i]
		if a and (not kind or a.Kind == kind) then
			if vanish then
				self:Vanish(a)
			else
				self:Remove(a)
			end
		end
	end
end

function AnimalService:Start(ctx)
	local rate = Config.AnimalThinkRate
	local idx = 1
	-- กระจายการคิดให้แต่ละเฟรมทำบางตัว
	RunService.Heartbeat:Connect(function(dt)
		local n = #list
		if n == 0 then
			return
		end
		local perFrame = math.max(1, math.ceil(n * dt / rate))
		local now = os.clock()
		for _ = 1, perFrame do
			if idx > #list then
				idx = 1
			end
			local a = list[idx]
			idx += 1
			if a then
				local ok, err = pcall(self.Think, self, a, now)
				if not ok then
					warn("[AS] AI error", a.Id, err)
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(2.5)
			local ok, err = pcall(self.WildTick, self)
			if not ok then
				warn("[AS] wild tick", err)
			end
		end
	end)
end

return AnimalService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005D"><Properties><string name="Name">BossAbilities</string><ProtectedString name="Source"><![CDATA[--[[
	BossAbilities — สกิลบอส (บอสไม่ตีประชิด ใช้สกิลอย่างเดียว)
	ทุกท่า: บอสเล่นท่าร่าย (attribute Cast/CastAt/CastTime -> BossAnimator) + วงเตือนบนพื้น (BossFX) -> หลบให้พ้น!
	เอฟเฟกต์ทั้งหมดวาดฝั่ง client ผ่าน HitFx (BossTelegraph / BossImpact / BossSpikes / BossWave / BossBreath / BossBlizzard)
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local BossAbilities = {}

-- ตัวคูณเวลาร่าย (ง้าง/วงเตือน) ของบอสตัวนี้
local function slow(a)
	return a.Info.CastMult or Config.BossCastMult
end

-- ดาเมจสกิลบอส = ตัวเลขตามระดับ (Animals.SkillDamage: Light/Medium/Heavy) x a.DamageMult (= Nights.BossDamageMult ตามจำนวนคน)
--   ระดับตั้งต้นของแต่ละท่า (บอสเปลี่ยนเองได้ด้วย Animals.SkillTier)
local TIER = {
	Quake = "Heavy", Fissure = "Medium", BoulderRain = "Light",
	TidalWave = "Medium", WaterSpout = "Light",
	Blizzard = "Heavy", IceSpikes = "Medium",
	FlameNova = "Heavy", FireBreath = "Medium", MeteorRoar = "Light",
}
local function skillDamage(a, name, tier)
	local info = a.Info
	tier = tier or (info.SkillTier and info.SkillTier[name]) or TIER[name] or "Medium"
	local t = info.SkillDamage
	return (t and t[tier] or info.Damage) * (a.DamageMult or 1)
end

local ELEMENT_COLOR = {
	Earth = Color3.fromRGB(150, 240, 90),
	Water = Color3.fromRGB(70, 200, 255),
	Air = Color3.fromRGB(170, 225, 255),
	Fire = Color3.fromRGB(255, 100, 30),
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { Workspace.Terrain }

local function ground(pos)
	local res = Workspace:Raycast(pos + Vector3.new(0, 80, 0), Vector3.new(0, -300, 0), rayParams)
	return res and res.Position or pos
end

local function charRoot(p)
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function fx(ctx, kind, data)
	ctx.Remotes.Get("HitFx"):FireAllClients(kind, data)
end

-- ท่าร่าย: บอสง้าง (windup วินาที) ก่อนสกิลออก + ป้ายชื่อสกิล
local function cast(ctx, a, anim, windup, text)
	local m = a.Model
	m:SetAttribute("Cast", anim)
	m:SetAttribute("CastTime", windup)
	m:SetAttribute("CastAt", Workspace:GetServerTimeNow())
	fx(ctx, "BossCast", { Model = m, Text = text })
end

-- วงเตือนกลม (client วาด) -> คืนตำแหน่งพื้น
local function tele(ctx, a, pos, radius, time)
	local g = ground(pos)
	fx(ctx, "BossTelegraph", { Pos = g, Radius = radius, Time = time, Element = a.Info.Element })
	return g
end

local function impact(ctx, a, pos, radius, style)
	fx(ctx, "BossImpact", { Pos = pos, Radius = radius, Element = a.Info.Element, Style = style })
end

local function hitPlayers(ctx, center, radius, damage, source, opts)
	local surv = ctx.Services.SurvivalService
	local hit = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r then
			local d = ((r.Position - center) * Vector3.new(1, 0, 1)).Magnitude
			if d <= radius and math.abs(r.Position.Y - center.Y) < 18 then
				surv:Damage(p, damage, source, opts and opts(p, r))
				table.insert(hit, p)
			end
		end
	end
	local building = ctx.Services.BuildingService
	for _, s in ipairs(building:All()) do
		if ((s:GetPivot().Position - center) * Vector3.new(1, 0, 1)).Magnitude <= radius then
			building:Damage(s, damage * 0.8)
		end
	end
	return hit
end

-- ผู้เล่นที่อยู่ในแถบเส้นตรง (from -> dir ยาว length กว้าง width)
local function inLine(r, from, dir, length, width)
	local rel = (r.Position - from) * Vector3.new(1, 0, 1)
	local along = rel:Dot(dir)
	local side = (rel - dir * along).Magnitude
	return along > -4 and along < length and side < width / 2, along
end

local function flatDir(a, target)
	local r = target and charRoot(target)
	local d = r and ((r.Position - a.Root.Position) * Vector3.new(1, 0, 1)) or Vector3.zero
	return d.Magnitude > 0.1 and d.Unit or a.Root.CFrame.LookVector
end

-- สกิลแนวตรง: หันเข้าหาเป้าก่อน (รอสูงสุด maxWait วินาทีจนหน้าตรง) แล้วล็อกทิศไว้จนจบสกิล
--   (เดิมทิศสกิลล็อกตั้งแต่เริ่ม แต่ตัวบอสหมุนตามผู้เล่นต่อ -> ปากพ่นไฟ/คลื่นไม่ตรงแนวที่เตือน)
local function aim(a, target, maxWait)
	local dir = flatDir(a, target)
	a.CastFace = dir
	local t0 = os.clock()
	while os.clock() - t0 < (maxWait or 0.6) and not a.Dead do
		local fw = a.Root.CFrame.LookVector * Vector3.new(1, 0, 1)
		if fw.Magnitude > 0.1 and fw.Unit:Dot(dir) > 0.966 then -- ~15°
			break
		end
		task.wait(0.05)
	end
	return dir
end

local function playersNear(a, range)
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and (r.Position - a.Root.Position).Magnitude < range then
			table.insert(out, r)
		end
	end
	return out
end

local Abilities = {}

-- ทุบพื้น (ทุกธาตุ): ยกแขน/ตัวขึ้น -> กระแทก -> คลื่นกระแทก + หนาม/เสารอบตัว
Abilities.Quake = function(ctx, a)
	local radius = 34 + a.Radius * 0.5
	local windup = 1.5 * slow(a)
	cast(ctx, a, "Slam", windup, ({ Earth = "Earth Smash!", Air = "Glacier Smash!", Water = "Wave Slam!", Fire = "Lava Smash!" })[a.Info.Element] or "Ground Smash!")
	local center = tele(ctx, a, a.Root.Position, radius, windup)
	task.wait(windup)
	if a.Dead then
		return
	end
	impact(ctx, a, center, radius, "Slam")
	fx(ctx, "BossSpikes", { Pos = center, Radius = radius * 0.85, Count = 14, Element = a.Info.Element, Ring = true })
	hitPlayers(ctx, center, radius, skillDamage(a, "Quake"), a.Id, function(_, r)
		local away = (r.Position - center) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
		return { Knockback = away * 75 + Vector3.new(0, 55, 0) }
	end)
end

-- โกเลม: รอยแยกพื้นพุ่งเป็นแนวตรง หนามหินผุดตามแนว
Abilities.Fissure = function(ctx, a, target)
	local dir = aim(a, target, 0.7)
	local from = ground(a.Root.Position + dir * (a.Radius * 0.6))
	local length, width, windup = 130, 16, 1.2 * slow(a)
	cast(ctx, a, "Slam", windup, "Earth Rift!")
	fx(ctx, "BossTelegraph", { Pos = from, Dir = dir, Length = length, Width = width, Time = windup, Element = a.Info.Element, Shape = "Line" })
	task.wait(windup)
	if a.Dead then
		return
	end
	impact(ctx, a, from, 18, "Slam")
	local hitSet = {}
	for i = 0, 12 do
		local p = ground(from + dir * (i * length / 12))
		fx(ctx, "BossSpikes", { Pos = p, Radius = width * 0.45, Count = 4, Element = a.Info.Element })
		for _, pl in ipairs(Players:GetPlayers()) do
			local r = charRoot(pl)
			if r and not hitSet[pl] and ((r.Position - p) * Vector3.new(1, 0, 1)).Magnitude < width * 0.6 then
				hitSet[pl] = true
				ctx.Services.SurvivalService:Damage(pl, skillDamage(a, "Fissure"), a.Id, { Knockback = Vector3.new(0, 85, 0) + dir * 20 })
			end
		end
		task.wait(0.06)
	end
end

-- ฝนหิน/อุกกาบาต: ของหล่นจากฟ้าใส่ผู้เล่น (วงเตือนก่อนตก)
local function rain(ctx, a, count, radius, damage, color, fire, size)
	local combat = ctx.Services.CombatService
	local targets = playersNear(a, 170)
	if #targets == 0 then
		return
	end
	local rng = Random.new()
	for i = 1, count do
		local base = targets[(i - 1) % #targets + 1].Position
		local pos = base + Vector3.new(rng:NextNumber(-26, 26), 0, rng:NextNumber(-26, 26))
		if i <= #targets then
			pos = base
		end
		local delay = 1.5 * slow(a) + i * 0.14
		local g = tele(ctx, a, pos, radius, delay)
		local from = g + Vector3.new(rng:NextNumber(-40, 40), 170, rng:NextNumber(-40, 40))
		local grav = 80
		local vel = (g - from) / delay + Vector3.new(0, 0.5 * grav * delay, 0)
		combat:Projectile({
			From = from, Velocity = vel, Gravity = grav, Radius = 0.1, Blast = radius, Damage = damage,
			Owner = "Animal", Color = color, Size = size or 6, Fire = fire, Source = a.Id, Life = delay + 1,
			Model = (not fire) and "Rock" or nil, VFX = fire and "Meteor" or "Boulder", -- อุกกาบาตไฟ = ลูกไฟ (ไม่ใช่ก้อนหิน)
		})
		task.delay(delay, function()
			impact(ctx, a, g, radius, "Small")
		end)
	end
end

Abilities.BoulderRain = function(ctx, a)
	cast(ctx, a, "Summon", 1.6 * slow(a), "Rockslide!")
	task.wait(0.4 * slow(a))
	rain(ctx, a, 9, 11, skillDamage(a, "BoulderRain"), Color3.fromRGB(112, 98, 82), false, 9)
end

Abilities.MeteorRoar = function(ctx, a)
	cast(ctx, a, "Roar", 1.5 * slow(a), "Fire Meteor!")
	ctx.FireRun("Cinematic", "Shake", { Power = 0.7, Time = 1.6 * slow(a) })
	task.wait(0.4 * slow(a))
	rain(ctx, a, 11, 12, skillDamage(a, "MeteorRoar"), Color3.fromRGB(255, 120, 40), true, 7)
end

-- โมซาซอรัส: คลื่นยักษ์เป็นกำแพงน้ำวิ่งเข้าหาผู้เล่น
Abilities.TidalWave = function(ctx, a, target)
	local dir = aim(a, target, 0.7)
	local from = ground(a.Root.Position + dir * (a.Radius * 0.5))
	local length, width, windup, travel = 140, 34, 1.3 * slow(a), 1.5
	cast(ctx, a, "Rear", windup, "Tidal Wave!")
	fx(ctx, "BossTelegraph", { Pos = from, Dir = dir, Length = length, Width = width, Time = windup, Element = a.Info.Element, Shape = "Line" })
	task.wait(windup)
	if a.Dead then
		return
	end
	impact(ctx, a, from, 20, "Slam")
	fx(ctx, "BossWave", { Pos = from, Dir = dir, Length = length, Width = width, Time = travel, Element = a.Info.Element })
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r then
			local inside, along = inLine(r, from, dir, length, width)
			if inside then
				task.delay(math.max(0, along / length * travel), function()
					local r2 = charRoot(p)
					if r2 and inLine(r2, from, dir, length, width) and not a.Dead then
						ctx.Services.SurvivalService:Damage(p, skillDamage(a, "TidalWave"), a.Id, { Knockback = dir * 95 + Vector3.new(0, 40, 0) })
					end
				end)
			end
		end
	end
end

-- โมซาซอรัส: พวยน้ำพุ่งใต้เท้าผู้เล่น
Abilities.WaterSpout = function(ctx, a)
	local t = 1.5 * slow(a)
	cast(ctx, a, "Roar", 1.4 * slow(a), "Waterspout!")
	for _, r in ipairs(playersNear(a, 160)) do
		local spots = { r.Position }
		for k = 1, 2 do
			table.insert(spots, r.Position + Vector3.new(math.cos(k * 2.4) * 18, 0, math.sin(k * 2.4) * 18))
		end
		for _, pos in ipairs(spots) do
			local g = tele(ctx, a, pos, 10, t)
			task.delay(t, function()
				if a.Dead then
					return
				end
				impact(ctx, a, g, 10, "Geyser")
				local hit = hitPlayers(ctx, g, 10, skillDamage(a, "WaterSpout"), a.Id)
				for _, hp in ipairs(hit) do
					ctx.Remotes.Get("HitFx"):FireClient(hp, "Launch", { Velocity = Vector3.new(0, 120, 0) })
				end
			end)
		end
	end
end

-- เยติ: พายุหิมะหมุนรอบตัว ดูดเข้า แล้วระเบิดน้ำแข็ง
Abilities.Blizzard = function(ctx, a)
	local windup = 2.2 * slow(a)
	cast(ctx, a, "Roar", windup, "Blizzard!")
	local center = ground(a.Root.Position)
	fx(ctx, "BossBlizzard", { Pos = center, Radius = 55, Time = windup + 0.6, Element = a.Info.Element })
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and (r.Position - center).Magnitude < 95 then
			ctx.Remotes.Get("HitFx"):FireClient(p, "Pull", { Center = center, Time = windup, Stop = a.Radius + 10 })
		end
	end
	local radius = 26 + a.Radius * 0.4
	local g = tele(ctx, a, center, radius, windup)
	task.wait(windup)
	if a.Dead then
		return
	end
	impact(ctx, a, g, radius, "Slam")
	fx(ctx, "BossSpikes", { Pos = g, Radius = radius * 0.8, Count = 16, Element = a.Info.Element, Ring = true })
	hitPlayers(ctx, g, radius, skillDamage(a, "Blizzard"), a.Id, function()
		return { Knockback = Vector3.new(0, 90, 0) }
	end)
end

-- เยติ: หนามน้ำแข็งผุดใต้เท้าผู้เล่น
Abilities.IceSpikes = function(ctx, a)
	cast(ctx, a, "Slam", 1.2 * slow(a), "Ice Spikes!")
	for _, r in ipairs(playersNear(a, 160)) do
		local spots = { r.Position }
		for k = 1, 3 do
			table.insert(spots, r.Position + Vector3.new(math.cos(k * 2.1) * 16, 0, math.sin(k * 2.1) * 16))
		end
		for i, pos in ipairs(spots) do
			local delay = 1.2 * slow(a) + i * 0.12
			local g = tele(ctx, a, pos, 9, delay)
			task.delay(delay, function()
				if a.Dead then
					return
				end
				fx(ctx, "BossSpikes", { Pos = g, Radius = 6, Count = 7, Element = a.Info.Element })
				impact(ctx, a, g, 9, "Small")
				hitPlayers(ctx, g, 9, skillDamage(a, "IceSpikes"), a.Id, function()
					return { Knockback = Vector3.new(0, 100, 0) }
				end)
			end)
		end
	end
end

-- มังกร: พ่นไฟเป็นแนวยาว (โดนต่อเนื่อง + ติดไฟ)
Abilities.FireBreath = function(ctx, a, target)
	local dir = aim(a, target, 0.7)
	local from = ground(a.Root.Position)
	local length, width, windup, dur = 110, 22, 1.1 * slow(a), 1.8
	cast(ctx, a, "Breath", windup, "Fire Breath!")
	fx(ctx, "BossTelegraph", { Pos = from, Dir = dir, Length = length, Width = width, Time = windup, Element = a.Info.Element, Shape = "Line" })
	task.wait(windup)
	if a.Dead then
		return
	end
	fx(ctx, "BossBreath", { Model = a.Model, To = ground(from + dir * length * 0.8), Pos = from, Dir = dir, Length = length, Time = dur })
	for _ = 1, 5 do
		for _, p in ipairs(Players:GetPlayers()) do
			local r = charRoot(p)
			if r and inLine(r, from, dir, length, width) then
				ctx.Services.SurvivalService:Damage(p, skillDamage(a, "FireBreath") / 5, a.Id, { Burn = 6 })
			end
		end
		task.wait(dur / 5)
	end
end

-- มังกร: วงแหวนเพลิง 2 ชั้น + เสาไฟ
Abilities.FlameNova = function(ctx, a)
	local w1, w2 = 1.4 * slow(a), 1.1 * slow(a)
	cast(ctx, a, "Nova", w1, "Ring of Fire!")
	local base = ground(a.Root.Position)
	local center = tele(ctx, a, base, 24, w1)
	task.wait(w1)
	if a.Dead then
		return
	end
	impact(ctx, a, center, 24, "Slam")
	fx(ctx, "BossSpikes", { Pos = center, Radius = 20, Count = 12, Element = "Fire", Ring = true })
	hitPlayers(ctx, center, 24, skillDamage(a, "FlameNova"), a.Id, function()
		return { Burn = 8 }
	end)
	local g2 = tele(ctx, a, center, 48, w2)
	task.wait(w2)
	if a.Dead then
		return
	end
	impact(ctx, a, g2, 48, "Slam")
	fx(ctx, "BossSpikes", { Pos = g2, Radius = 42, Count = 20, Element = "Fire", Ring = true })
	hitPlayers(ctx, g2, 48, skillDamage(a, "FlameNova", "Light"), a.Id, function()
		return { Burn = 6 }
	end)
end

-- ท่าถัดไปที่คูลดาวน์ครบแล้ว (วนตามลำดับ) · ไม่มีท่าพร้อม -> nil (รอ)
function BossAbilities.Pick(a, abilities)
	local now = os.clock()
	for k = 1, #abilities do
		local i = ((a.AbilityIndex or 0) + k - 1) % #abilities + 1
		if now >= ((a.SkillReady or {})[abilities[i]] or 0) then
			a.AbilityIndex = i
			return abilities[i]
		end
	end
	return nil
end

function BossAbilities.Run(ctx, a, name, target)
	local fn = Abilities[name]
	if not fn then
		return
	end
	a.Casting = true
	task.spawn(function()
		local ok, err = pcall(fn, ctx, a, target)
		if not ok then
			warn("[AS] boss ability", name, err)
		end
		task.wait(0.6)
		-- นับหลังร่ายจบ: ท่านี้ติดคูลดาวน์ของตัวเอง + เว้นก่อนร่ายท่าถัดไป
		local now = os.clock()
		a.SkillReady = a.SkillReady or {}
		a.SkillReady[name] = now + Config.BossSkillCooldown
		a.NextAbility = math.max(a.NextAbility or 0, now + Config.BossSkillGap)
		a.Casting = false
		a.CastFace = nil
		if a.Model and a.Model.Parent then
			a.Model:SetAttribute("Cast", nil)
		end
	end)
end

BossAbilities.ElementColor = ELEMENT_COLOR
return BossAbilities
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005E"><Properties><string name="Name">BuildingService</string><ProtectedString name="Source"><![CDATA[--[[
	BuildingService — วางสิ่งก่อสร้าง + ความสามารถของแต่ละชนิด
	  กำแพง (ขวางทางฝูง) / กับดักหนาม / หน้าไม้ยักษ์ยิงเอง / ตะเกียง (ไล่กวางกลวง) / เตียง (จุดเกิด)
	  แปลงเบอร์รี่ / หม้อตุ๋น / เสาธาตุ 4 แบบ / ประภาคารสุริยะ
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local Recipes = require(ReplicatedStorage.Shared.Recipes)
local StructureModels = require(ReplicatedStorage.Shared.StructureModels)

local BuildingService = {}

function BuildingService:Init(ctx)
	self.ctx = ctx
	self.folder = Instance.new("Folder")
	self.folder.Name = "Structures"
	self.folder.Parent = Workspace
	self.rayParams = RaycastParams.new()
	self.rayParams.FilterType = Enum.RaycastFilterType.Include
	self.rayParams.FilterDescendantsInstances = { Workspace.Terrain }
end

function BuildingService:All()
	return self.folder:GetChildren()
end

-- แหล่งแสงที่ปีศาจกวางกลัว: { {Position, Radius} }
function BuildingService:LightSources()
	local out = {}
	for _, s in ipairs(self.folder:GetChildren()) do
		local kind = s:GetAttribute("Kind")
		local spec = Items.Structures[kind]
		if spec and spec.Light then
			table.insert(out, { s:GetPivot().Position, spec.Light * 0.6 })
		end
	end
	return out
end

function BuildingService:Damage(structure, amount)
	if not structure.Parent or structure:GetAttribute("Broken") then
		return
	end
	-- พังได้เฉพาะกำแพง (Items.Structures[kind].Breakable) · เตียง/หน้าไม้/กับดัก/เสาธาตุ ฯลฯ ไม่มีวันพัง
	local spec = Items.Structures[structure:GetAttribute("Kind")]
	if not (spec and spec.Breakable) then
		return
	end
	local hp = (structure:GetAttribute("Health") or 0) - amount
	structure:SetAttribute("Health", hp)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("StructureHit", { Structure = structure, Amount = amount })
	if hp <= 0 then
		structure:SetAttribute("Broken", true)
		-- ท่าพังตามวัสดุเล่นฝั่งเครื่องผู้เล่น (BreakFX) · เซิร์ฟเวอร์ซ่อนของจริงแล้วลบ
		self.ctx.Remotes.Get("HitFx"):FireAllClients("StructureBreak", { Structure = structure, Kind = structure:GetAttribute("Kind"), Position = structure:GetPivot().Position })
		CollectionService:RemoveTag(structure, "Structure")
		self.ctx.Services.InventoryService:MarkDirty() -- พังแล้วคืนโควต้า (Limits) -> อัปเดตตัวเลขบนหน้าคราฟต์
		task.delay(0.25, function()
			for _, d in ipairs(structure:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Transparency = 1
					d.CanCollide = false
					d.CanQuery = false
				elseif d:IsA("Light") or d:IsA("Fire") or d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
		end)
		task.delay(0.6, function()
			structure:Destroy()
		end)
	end
end

-- ตรวจจุดวาง (ใช้ทั้งวางใหม่และย้ายด้วยค้อนช่าง) -> CFrame ที่ติดพื้นแล้ว หรือ nil (แจ้งผู้เล่นเอง)
-- ignore = สิ่งก่อสร้างที่กำลังย้าย (ไม่นับว่าทับตัวเอง)
function BuildingService:CheckSpot(player, kind, cf, ignore)
	local spec = Items.Structures[kind]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - cf.Position).Magnitude > Config.BuildRange then
		self.ctx.Notify(player, "Too far away", "Error")
		return nil
	end
	-- หาพื้น
	local hit = Workspace:Raycast(cf.Position + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), self.rayParams)
	if not hit then
		self.ctx.Notify(player, "Must be placed on the ground", "Error")
		return nil
	end
	if hit.Material == Enum.Material.Water or hit.Material == Enum.Material.CrackedLava then
		self.ctx.Notify(player, "Can't place on water/lava", "Error")
		return nil
	end
	local pos = hit.Position
	if (pos - self.ctx.CampPosition).Magnitude < 9 then
		self.ctx.Notify(player, "Too close to the campfire", "Error")
		return nil
	end
	-- วางได้เฉพาะในเขตแคมป์ (รัศมีตามเลเวลกองไฟ — อัปเกรดกองไฟ = เขตกว้างขึ้น)
	local campR = self.ctx.Services.CampService:CampRadius()
	if ((pos - self.ctx.CampPosition) * Vector3.new(1, 0, 1)).Magnitude > campR then
		self.ctx.Notify(player, "Can only be placed inside the camp (upgrade the campfire to expand it)", "Error")
		return nil
	end
	local _, yaw = cf:ToOrientation()
	local final = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	-- กันซ้อนทับ
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.folder }
	for _, p in ipairs(Workspace:GetPartBoundsInBox(final * CFrame.new(0, spec.Size.Y / 2 + 0.5, 0), spec.Size * 0.85, params)) do
		if not (ignore and p:IsDescendantOf(ignore)) then
			self.ctx.Notify(player, "Overlaps another building", "Error")
			return nil
		end
	end
	return final, pos
end

function BuildingService:Place(player, kind, cf)
	local spec = Items.Structures[kind]
	if not spec or typeof(cf) ~= "CFrame" then
		return false
	end
	local inv = self.ctx.Services.InventoryService
	if inv:Count(player, kind) <= 0 then
		self.ctx.Notify(player, "You have no " .. Items.DisplayName(kind) .. " in your bag (craft it at the bench first)", "Error")
		return false
	end
	-- เตียง: วางแล้วตัวคูณวัน +1 (ทั้งเซิร์ฟได้ 2 ครั้งต่อเกม)
	if (kind == "Bed" or kind == "Bed2") and not self.ctx.Services.DirectorService:CanSkipDay() then
		self.ctx.Notify(player, "Can't use a bed to skip a day right now", "Error")
		return false
	end
	local final, pos = self:CheckSpot(player, kind, cf)
	if not final then
		return false
	end
	inv:Remove(player, kind, 1)
	-- ช่างสร้าง: กำแพงและสิ่งก่อสร้างทุกชนิดถึกขึ้นตามทักษะ
	local hp = spec.Health * self.ctx.Services.SurvivalService:Perk(player, "WallHealthMult", 1)
	local model = self:Spawn(kind, final, hp, hp, player.UserId)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Build", { Position = pos, Kind = kind, Structure = model })
	self.ctx.Services.TraderService:MakeRoom(pos, spec.Size) -- พ่อค้ายืนตรงนั้น = เดินหลบให้
	if kind == "Bed" or kind == "Bed2" then
		-- เตียง 1 / เตียง 2 = ตัวคูณวัน +1 (โควต้านับแยกชนิด)
		local st, used = self.ctx.State, kind == "Bed" and "BedsUsed" or "Bed2Used"
		st:SetAttribute(used, (st:GetAttribute(used) or 0) + 1)
		self.ctx.Services.DirectorService:AddBedMultiplier(player) -- เตียง = ตัวคูณวัน +1
		self.ctx.Services.InventoryService:MarkDirty()
	end
	return true
end

---------------------------------------------------------------- ค้อนช่าง: ย้าย / รื้อ
-- ชื่อไม่เอาวงเล็บท้าย ("Bed (+1 Day)" -> "Bed")
local function shortName(kind)
	return (Items.DisplayName(kind):gsub("%s*%b()$", ""))
end

-- ต้องถือค้อนช่างอยู่ + สิ่งก่อสร้างยังอยู่ในแคมป์นี้ + อยู่ในระยะ
function BuildingService:HammerTarget(player, structure)
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	local spec = tool and Items.Tools[tool:GetAttribute("ItemId")]
	if not (spec and spec.Builder) then
		self.ctx.Notify(player, "Hold the Builder's Hammer first", "Error")
		return nil
	end
	if typeof(structure) ~= "Instance" or structure.Parent ~= self.folder or structure:GetAttribute("Broken") then
		return nil
	end
	local kind = structure:GetAttribute("Kind")
	if not Items.Structures[kind] then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - structure:GetPivot().Position).Magnitude > Config.BuildRange then
		self.ctx.Notify(player, "Too far away", "Error")
		return nil
	end
	return kind
end

-- ย้าย: ของเดิมทั้งชิ้น (เลือดเท่าเดิม) ไปจุดใหม่ · เตียงย้ายแล้วไม่ข้ามวันซ้ำ
function BuildingService:Move(player, structure, cf)
	local kind = self:HammerTarget(player, structure)
	if not kind or typeof(cf) ~= "CFrame" then
		return false
	end
	local final, pos = self:CheckSpot(player, kind, cf, structure)
	if not final then
		return false
	end
	structure:PivotTo(final)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Build", { Position = pos, Kind = kind, Structure = structure })
	self.ctx.Services.TraderService:MakeRoom(pos, Items.Structures[kind].Size)
	self.ctx.Notify(player, string.format("Moved %s", shortName(kind)), "Good")
	return true
end

-- รื้อ: พังทิ้ง (เล่นท่าพังเหมือนโดนตีแตก) + คืนวัตถุดิบครึ่งหนึ่ง (ปัดลง) วางเป็นของบนพื้นตรงนั้น
function BuildingService:Demolish(player, structure)
	local kind = self:HammerTarget(player, structure)
	if not kind then
		return false
	end
	local pos = structure:GetPivot().Position + Vector3.new(0, 1.5, 0)
	local recipe = Recipes.ById[kind]
	local drops = self.ctx.Services.DropService
	for id, n in pairs(recipe and recipe.Cost or {}) do
		local back = math.floor(n / 2)
		if back > 0 and Items.Data[id] then -- AnyEssence/AnyHeart ไม่คืน (ไม่รู้ว่าใช้ธาตุไหน)
			drops:Spawn(id, back, pos)
		end
	end
	self:Damage(structure, math.huge)
	self.ctx.Notify(player, string.format("Removed %s — half the materials dropped on the ground", shortName(kind)), "Good")
	return true
end

function BuildingService:Spawn(kind, cf, hp, maxHp, owner)
	local model = StructureModels.Build(kind)
	model:PivotTo(cf)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Health", hp)
	model:SetAttribute("MaxHealth", maxHp)
	model:SetAttribute("Owner", owner)
	CollectionService:AddTag(model, "Structure")
	model.Parent = self.folder
	self:Setup(model, kind)
	return model
end

-- เก็บ/คืนสิ่งก่อสร้างทั้งหมด (RejoinService) : { Kind, x, y, z, yaw, Health, MaxHealth, Owner }
function BuildingService:Serialize()
	local out = {}
	for _, m in ipairs(self.folder:GetChildren()) do
		local kind = m:GetAttribute("Kind")
		if kind and Items.Structures[kind] and (m:GetAttribute("Health") or 0) > 0 and #out < 300 then
			local cf = m:GetPivot()
			local _, yaw = cf:ToOrientation()
			table.insert(out, { kind, math.floor(cf.X * 10) / 10, math.floor(cf.Y * 10) / 10, math.floor(cf.Z * 10) / 10, math.floor(yaw * 1000) / 1000,
				math.floor(m:GetAttribute("Health")), math.floor(m:GetAttribute("MaxHealth") or 0), m:GetAttribute("Owner") or 0 })
		end
	end
	return out
end

function BuildingService:Restore(list)
	local beds, beds2 = 0, 0
	for _, r in ipairs(list or {}) do
		if r[1] == "Bed" then
			beds += 1
		elseif r[1] == "Bed2" then
			beds2 += 1
		end
		local kind = r[1]
		if Items.Structures[kind] then
			local ok, err = pcall(self.Spawn, self, kind, CFrame.new(r[2], r[3], r[4]) * CFrame.Angles(0, r[5], 0), r[6], math.max(r[7], r[6]), r[8])
			if not ok then
				warn("[AS] restore structure", kind, err)
			end
		end
	end
	-- เตียงที่วางไว้ = ใช้โควต้าข้ามวันไปแล้ว (คืนรอบไม่ได้วันเพิ่มซ้ำ)
	self.ctx.State:SetAttribute("BedsUsed", math.max(self.ctx.State:GetAttribute("BedsUsed") or 0, beds))
	self.ctx.State:SetAttribute("Bed2Used", math.max(self.ctx.State:GetAttribute("Bed2Used") or 0, beds2))
end

-- แปลงเบอร์รี่: ปลูกแล้วต้นค่อย ๆ โต (ต้นกล้า -> ต้นเล็ก -> ต้นใหญ่) -> โตเต็มที่ลูกออก (Yield ลูกทั้งแปลง)
--   ผู้เล่นชี้ลูกบนต้นแล้วคลิก/แตะเก็บทีละลูก (ResourceService:OnPickRequest -> PickCrop) · เก็บหมดแปลง = ต้นหดเป็นต้นกล้า ปลูกรอบใหม่
local FARM_STAGES = { 0.3, 0.55, 0.8 } -- ขนาดต้นช่วงโต (สัดส่วนของต้นโตเต็มที่)

-- ลูกที่ใช้ในแปลง: ต้นละ per ลูกแรก (ลูกส่วนเกินในโมเดลซ่อนถาวร)
local function cropBerries(model)
	local crops = model:FindFirstChild("Crops")
	local out = {}
	if not crops then
		return out
	end
	local bushes = crops:GetChildren()
	local per = math.max(1, math.ceil(Items.Structures.FarmPlot.Yield / math.max(1, #bushes)))
	for _, bush in ipairs(bushes) do
		local n = 0
		for _, p in ipairs(bush:GetDescendants()) do
			if p:IsA("BasePart") and p.Name == "Berry" then
				n += 1
				if n <= per then
					table.insert(out, p)
				else
					p.Transparency = 1
					p.Name = "BerryUnused"
				end
			end
		end
	end
	return out
end

local function showCrops(model, ready)
	local n = 0
	for _, p in ipairs(cropBerries(model)) do
		if p:GetAttribute("OrigT") == nil then
			p:SetAttribute("OrigT", p.Transparency)
		end
		p.Transparency = ready and p:GetAttribute("OrigT") or 1
		p:SetAttribute("Picked", not ready)
		if ready then
			n += 1
		end
	end
	model:SetAttribute("Berries", n)
	model:SetAttribute("MaxBerries", #cropBerries(model))
end

-- ย่อ/ขยายต้นในแปลงตามช่วงโต (ย่อรอบโคนต้น ต้นไม่ลอย/จม)
local function sizeCrops(model, f)
	if model:GetAttribute("CropScale") == f then
		return
	end
	model:SetAttribute("CropScale", f)
	local crops = model:FindFirstChild("Crops")
	for _, bush in ipairs(crops and crops:GetChildren() or {}) do
		if bush:IsA("Model") then
			local full = bush:GetAttribute("FullScale")
			if not full then
				full = bush:GetScale()
				bush:SetAttribute("FullScale", full)
			end
			local cf, sz = bush:GetBoundingBox()
			bush.WorldPivot = CFrame.new(cf.Position - Vector3.new(0, sz.Y / 2, 0))
			pcall(function()
				bush:ScaleTo(full * f)
			end)
		end
	end
end

local function growStage(model, now)
	local grow = Items.Structures.FarmPlot.GrowTime
	local left = (model:GetAttribute("GrowAt") or now) - now
	if left <= 0 then
		return 1
	end
	local p = 1 - left / grow
	return FARM_STAGES[math.clamp(math.floor(p * #FARM_STAGES) + 1, 1, #FARM_STAGES)]
end

function BuildingService:UpdateFarm(model, now)
	local f = growStage(model, now)
	sizeCrops(model, f)
	local ready = f >= 1
	if ready and not model:GetAttribute("Ripe") then
		model:SetAttribute("Ripe", true)
		showCrops(model, true)
	end
end

-- เก็บลูก 1 ลูกจากแปลง (ลูกที่ชี้) · หมดแปลง = เริ่มปลูกรอบใหม่
function BuildingService:PickCrop(player, model, part, how)
	if not model:GetAttribute("Ripe") or part.Name ~= "Berry" or part:GetAttribute("Picked") or not part:IsDescendantOf(model) then
		return false
	end
	local from = part.Position
	part.Transparency = 1
	part:SetAttribute("Picked", true)
	local left = math.max(0, (model:GetAttribute("Berries") or 1) - 1)
	model:SetAttribute("Berries", left)
	self.ctx.Services.ResourceService:GiveBerry(player, from, how)
	if left <= 0 then
		model:SetAttribute("Ripe", false)
		model:SetAttribute("GrowAt", os.clock() + Items.Structures.FarmPlot.GrowTime)
		showCrops(model, false)
		sizeCrops(model, FARM_STAGES[1])
	end
	return true
end

-- หม้อตุ๋น: Stew = เนื้อ 2 + เบอร์รี่ 2 (ใช้เนื้อย่างก่อน) · BerryPie = เบอร์รี่ 5 + ไม้ 1
function BuildingService:Cook(player, dish)
	local inv = self.ctx.Services.InventoryService
	local cost, need
	if dish == "Stew" then
		local meat = inv:Count(player, "CookedMeat") >= 2 and "CookedMeat" or "RawMeat"
		cost, need = { [meat] = 2, Berries = 2 }, "Needs 2 meat and 2 berries"
	elseif dish == "BerryPie" then
		cost, need = { Berries = 5, Wood = 1 }, "Needs 5 berries and 1 wood"
	else
		return false
	end
	if not inv:Spend(player, cost) then
		self.ctx.Notify(player, need, "Error")
		return false
	end
	inv:Add(player, dish, 1)
	return true
end

-- ปุ่มกดของแปลงผัก/หม้อ
function BuildingService:Setup(model, kind)
	if kind == "FarmPlot" then
		-- ปลูกใหม่: ต้นกล้าเล็ก ๆ ค่อยโตจนลูกออก · ชี้ลูกบนต้นแล้วเก็บ (แท็ก BerrySource)
		model:SetAttribute("GrowAt", os.clock() + Items.Structures.FarmPlot.GrowTime)
		model:SetAttribute("Ripe", false)
		showCrops(model, false)
		self:UpdateFarm(model, os.clock())
		CollectionService:AddTag(model, "BerrySource")
	elseif kind == "CookPot" then
		local p = Instance.new("ProximityPrompt")
		p.ActionText = "Make Stew (2 meat + 2 berries)"
		p.ObjectText = "Stew Pot"
		p.HoldDuration = 1.2
		p.MaxActivationDistance = 12
		p.Parent = model:FindFirstChild("Pot")
		p.Triggered:Connect(function(player)
			self:Cook(player, "Stew")
		end)
		p.UIOffset = Vector2.new(0, -40)
		local pie = Instance.new("ProximityPrompt")
		pie.Name = "PiePrompt"
		pie.ActionText = "Bake Berry Pie (5 berries + 1 wood)"
		pie.ObjectText = "Stew Pot"
		pie.KeyboardKeyCode = Enum.KeyCode.F
		pie.HoldDuration = 1.2
		pie.MaxActivationDistance = 12
		pie.UIOffset = Vector2.new(0, 40)
		pie.Parent = p.Parent
		pie.Triggered:Connect(function(player)
			self:Cook(player, "BerryPie")
		end)
	end
end

-- ความสามารถทำงานทุก 0.5 วิ
function BuildingService:Tick(dt)
	local animals = self.ctx.Services.AnimalService
	local combat = self.ctx.Services.CombatService
	local now = os.clock()
	local earthBuff = self.ctx.State:GetAttribute("SpiritEarth")
	for _, s in ipairs(self.folder:GetChildren()) do
		local kind = s:GetAttribute("Kind")
		local spec = Items.Structures[kind]
		if spec and (s:GetAttribute("Health") or 0) > 0 then
			local pos = s:GetPivot().Position
			if earthBuff then
				s:SetAttribute("Health", math.min(s:GetAttribute("MaxHealth"), s:GetAttribute("Health") + s:GetAttribute("MaxHealth") * 0.01 * dt))
			end
			if kind == "SpikeTrap" then
				if now >= (s:GetAttribute("NextTick") or 0) then
					s:SetAttribute("NextTick", now + spec.Tick)
					for _, a in ipairs(animals:InRadius(pos, 5.5, true)) do
						combat:DamageAnimal(a, spec.Damage, nil, { Source = "Trap" })
					end
				end
			elseif kind == "Ballista" then
				if now >= (s:GetAttribute("NextShot") or 0) then
					local target = animals:Nearest(pos, spec.Range, true)
					if target then
						s:SetAttribute("NextShot", now + spec.Cooldown)
						local turret = s:FindFirstChild("Turret")
						local tpos = target.Root.Position
						if turret then
							turret:PivotTo(CFrame.lookAt(turret:GetPivot().Position, Vector3.new(tpos.X, turret:GetPivot().Position.Y, tpos.Z)))
						end
						local from = pos + Vector3.new(0, 5, 0)
						self.ctx.Remotes.Get("HitFx"):FireAllClients("Bolt", { From = from, To = tpos })
						task.delay((tpos - from).Magnitude / 260, function()
							if target.Model.Parent then
								combat:DamageAnimal(target, spec.Damage, nil, { Source = "Ballista" })
							end
						end)
					end
				end
			elseif kind == "TerraTotem" then
				for _, other in ipairs(self.folder:GetChildren()) do
					if other ~= s and (other:GetPivot().Position - pos).Magnitude < spec.Radius then
						local mh = other:GetAttribute("MaxHealth") or 0
						other:SetAttribute("Health", math.min(mh, (other:GetAttribute("Health") or 0) + mh * 0.02 * dt))
					end
				end
			elseif kind == "TideTotem" then
				for _, a in ipairs(animals:InRadius(pos, spec.Radius, true)) do
					a.SlowUntil = now + 1
				end
			elseif kind == "GaleTotem" then
				if now >= (s:GetAttribute("NextGust") or 0) then
					s:SetAttribute("NextGust", now + 4)
					local hitAny = false
					for _, a in ipairs(animals:InRadius(pos, spec.Radius, true)) do
						if a.Info.Behaviour ~= "Boss" then
							local dir = (a.Root.Position - pos) * Vector3.new(1, 0, 1)
							if dir.Magnitude > 0.1 then
								a.Root.AssemblyLinearVelocity = dir.Unit * 90 + Vector3.new(0, 45, 0)
								hitAny = true
							end
						end
					end
					if hitAny then
						self.ctx.Remotes.Get("HitFx"):FireAllClients("Gust", { Position = pos, Radius = spec.Radius })
					end
				end
			elseif kind == "EmberTotem" then
				for _, a in ipairs(animals:InRadius(pos, spec.Radius, true)) do
					combat:DamageAnimal(a, spec.Damage * dt, nil, { Source = "Totem", Silent = true })
				end
			elseif kind == "FarmPlot" then
				self:UpdateFarm(s, now)
			end
		end
	end
end

function BuildingService:Clear()
	self.folder:ClearAllChildren()
end

function BuildingService:Start(ctx)
	ctx.Remotes.Get("PlaceStructure").OnServerEvent:Connect(function(player, kind, cf)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		if type(kind) == "string" then
			self:Place(player, kind, cf)
		end
	end)
	ctx.Remotes.Get("MoveStructure").OnServerEvent:Connect(function(player, structure, cf)
		if not ctx.Services.SurvivalService:IsIncapacitated(player) then
			self:Move(player, structure, cf)
		end
	end)
	ctx.Remotes.Get("Demolish").OnServerEvent:Connect(function(player, structure)
		if not ctx.Services.SurvivalService:IsIncapacitated(player) then
			self:Demolish(player, structure)
		end
	end)
	task.spawn(function()
		while true do
			local dt = task.wait(0.5)
			local ok, err = pcall(self.Tick, self, dt)
			if not ok then
				warn("[AS] Building tick:", err)
			end
		end
	end)
end

return BuildingService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005F"><Properties><string name="Name">CampService</string><ProtectedString name="Source"><![CDATA[--[[
	CampService — กองไฟกลางแคมป์ + โต๊ะคราฟต์ + การคราฟต์
	  - กองไฟกินเชื้อเพลิงตลอด (กลางคืนเร็วขึ้น) ไฟดับ = เขตปลอดภัยหาย ปีศาจกวางเข้าได้
	  - สัตว์บุกที่ถึงกองไฟจะกัดกินเชื้อเพลิง (DamageFire)
	  - อัปเกรดกองไฟ = เขตปลอดภัยกว้างขึ้น + หมอกเปิดกว้างขึ้น
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local Recipes = require(ReplicatedStorage.Shared.Recipes)

local CampService = {}

local FUEL_ORDER = { "Wood", "Coal", "EmberShard", "TerraCore" }

function CampService:Init(ctx)
	self.lastThrow = {}
	self.ctx = ctx
	self.level = 1
	self.bench = 1
	self.fuel = Recipes.Campfire[1].MaxFuel * 0.75
end

function CampService:Info()
	return Recipes.Campfire[self.level]
end

-- รัศมีกำแพงหมอก (สตัด จากกลางแมพ = แคมป์)
function CampService:RevealRadius()
	return math.floor(self:Info().Reveal * Config.MapSize / 2)
end

function CampService:SafeRadius()
	if self.fuel <= 0 then
		return 0
	end
	return self:Info().SafeRadius
end

function CampService:IsLit()
	return self.fuel > 0
end

-- รัศมี "ในแคมป์" (คราฟต์/ใช้คลังแคมป์ได้) = เขตกองไฟตามเลเวล (ไม่ขึ้นกับไฟติด/ดับ) อย่างน้อย 60
CampService.CraftCap = 20 -- คราฟต์ทีเดียวได้สูงสุดกี่ชิ้น
function CampService:CampRadius()
	return math.max(self:Info().SafeRadius, 60)
end

function CampService:InCamp(player)
	local char = player and player.Character
	if not char or not player:GetAttribute("InRun") then
		return false
	end
	local pos = char:GetPivot().Position
	local campPos = self.ctx.CampPosition
	if campPos and ((pos - campPos) * Vector3.new(1, 0, 1)).Magnitude <= self:CampRadius() then
		return true
	end
	return self.benchPos ~= nil and (pos - self.benchPos).Magnitude <= 40
end

function CampService:Publish()
	local s = self.ctx.State
	local info = self:Info()
	s:SetAttribute("CampLevel", self.level)
	s:SetAttribute("CampFuel", math.floor(self.fuel))
	s:SetAttribute("CampMaxFuel", info.MaxFuel)
	s:SetAttribute("CampSafeRadius", self:SafeRadius())
	s:SetAttribute("CampReveal", self:RevealRadius())
	s:SetAttribute("BenchLevel", self.bench)
	s:SetAttribute("CampRadius", self:CampRadius())
end

-- หน้าตาไฟตามเชื้อเพลิง/เลเวล
function CampService:UpdateVisual()
	local core = self.fireCore
	if not core then
		return
	end
	local info = self:Info()
	local f = core:FindFirstChildOfClass("Fire")
	local l = core:FindFirstChildOfClass("PointLight")
	local frac = math.clamp(self.fuel / info.MaxFuel, 0, 1)
	local lit = self.fuel > 0
	if f then
		f.Enabled = lit
		f.Size = 2 + (2 + self.level) * frac
		f.Heat = 8 + self.level * 2
	end
	if l then
		l.Enabled = lit
		l.Range = math.max(12, info.Light * (0.4 + 0.6 * frac))
		l.Brightness = 1.5 + frac * 2
	end
	for _, e in ipairs(core:GetChildren()) do
		if e:IsA("ParticleEmitter") and e:GetAttribute("RealFire") then
			e.Enabled = lit
			e.TimeScale = 0.7 + 0.3 * frac
		end
	end
	-- เปลวไฟโตตามเชื้อเพลิง/เลเวล แต่ไม่ใหญ่เกินกองฟืน (0.55x - 1.35x)
	local mul = 0.55 + 0.45 * frac + 0.08 * self.level
	for _, name in ipairs({ "FlameCore", "Flames" }) do
		local e = core:FindFirstChild(name)
		local base = e and e:GetAttribute("BaseSize")
		if e then
			e.Enabled = lit
			e.Rate = (name == "Flames" and 14 or 18) + 16 * frac + self.level * 3
			if typeof(base) == "NumberSequence" then
				local ks = {}
				for _, k in ipairs(base.Keypoints) do
					table.insert(ks, NumberSequenceKeypoint.new(k.Time, k.Value * mul))
				end
				e.Size = NumberSequence.new(ks)
			end
		end
	end
	local sparks = core:FindFirstChild("Sparks")
	if sparks then
		sparks.Enabled = lit
		sparks.Rate = 4 + self.level * 3
	end
	local embers = self.campfire and self.campfire:FindFirstChild("Embers")
	if embers then
		embers.Color = lit and Color3.fromRGB(255, 120, 30) or Color3.fromRGB(60, 50, 46)
	end
end

function CampService:AddFuel(amount)
	local max = self:Info().MaxFuel
	local wasOut = self.fuel <= 0
	self.fuel = math.clamp(self.fuel + amount, 0, max)
	if wasOut and self.fuel > 0 then
		self.ctx.Broadcast("The campfire is burning again", "Good")
	end
	self:UpdateVisual()
	self:Publish()
end

-- สัตว์ที่บุกถึงกองไฟ
function CampService:DamageFire(amount)
	local before = self.fuel
	self.fuel = math.max(0, self.fuel - amount)
	if before > 0 and self.fuel <= 0 then
		self.ctx.FireRun("Cinematic", "FireOut", {})
	end
	self:UpdateVisual()
	self:Publish()
end

-- ผู้เล่นโยนเชื้อเพลิง: ใส่ทีละไอเทมจนเต็ม
function CampService:Refuel(player)
	local inv = self.ctx.Services.InventoryService
	local max = self:Info().MaxFuel
	local used = {}
	local before = self.fuel
	for _, id in ipairs(FUEL_ORDER) do
		local fuel = Items.Data[id].Fuel
		while self.fuel < max - fuel * 0.5 and inv:Available(player, id) > 0 do
			inv:Spend(player, { [id] = 1 })
			self.fuel = math.min(max, self.fuel + fuel)
			used[id] = (used[id] or 0) + 1
		end
	end
	if next(used) == nil then
		if self.fuel >= max - 6 then
			self.ctx.Notify(player, "The campfire is full", "Info")
		else
			self.ctx.Notify(player, "No fuel (wood / coal / ember shards)", "Error")
		end
		return
	end
	local parts = {}
	for id, n in pairs(used) do
		table.insert(parts, Items.DisplayName(id) .. " x" .. n)
	end
	self.ctx.Notify(player, "🔥 Fuel added: " .. table.concat(parts, ", "), "Good")
	if self.ctx.Services.QuestService then
		self.ctx.Services.QuestService:Progress(player, "Fuel", math.floor(self.fuel - before))
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Refuel", { Position = self.ctx.CampPosition })
	self:UpdateVisual()
	self:Publish()
end

function CampService:UpgradeFire(player)
	local nextInfo = Recipes.Campfire[self.level + 1]
	if not nextInfo then
		self.ctx.Notify(player, "The campfire is already max level", "Info")
		return
	end
	local inv = self.ctx.Services.InventoryService
	if not inv:Spend(player, nextInfo.Cost) then
		self.ctx.Notify(player, "Not enough materials to upgrade the campfire", "Error")
		return
	end
	self.level += 1
	self.fuel = math.max(self.fuel, nextInfo.MaxFuel * 0.6)
	self.ctx.FireRun("Cinematic", "CampUpgrade", { Level = self.level })
	self:UpdateVisual()
	self:Publish()
	self:RefreshPrompts()
end

function CampService:UpgradeBench(player)
	local cost = Recipes.BenchUpgrade[self.bench + 1]
	if not cost then
		self.ctx.Notify(player, "The crafting bench is already max level", "Info")
		return
	end
	if not self.ctx.Services.InventoryService:Spend(player, cost) then
		self.ctx.Notify(player, "Not enough materials to upgrade the bench", "Error")
		return
	end
	self.bench += 1
	self.ctx.Broadcast(string.format("Crafting Bench Lv.%d · New recipes", self.bench), "Reward")
	self:Publish()
	self:RefreshPrompts()
end

-- คราฟต์ count ชิ้น (1..CraftCap) · ใช้ของในกระสอบก่อน แล้วค่อยคลังแคมป์ (ต้องอยู่ในแคมป์)
function CampService:Craft(player, recipeId, count)
	local r = Recipes.ById[recipeId]
	if not r then
		return
	end
	if not self:InCamp(player) then
		self.ctx.Notify(player, "You must be in the camp (near the campfire/crafting bench) to craft", "Error")
		return
	end
	if r.Bench > self.bench then
		self.ctx.Notify(player, string.format("Upgrade the bench to level %d first", r.Bench), "Error")
		return
	end
	local inv = self.ctx.Services.InventoryService
	local item = Items.Data[r.Id]
	if not item then
		return
	end
	-- เกราะ: คราฟต์แล้วสวมทันที (ไม่เข้ากระสอบ) · มีเกราะระดับเท่ากัน/สูงกว่าอยู่แล้ว = ไม่ต้องทำ
	if item.Category == "Armor" then
		local wornId = player:GetAttribute("Armor")
		local cur = Items.Data[wornId or ""]
		if cur and (cur.Tier or 0) >= (item.Tier or 0) then
			self.ctx.Notify(player, "Already wearing " .. Items.DisplayName(wornId) .. " (same or better)", "Info")
			return
		end
		if not inv:Spend(player, r.Cost) then
			self.ctx.Notify(player, "Not enough materials", "Error")
			return
		end
		self.ctx.Services.SurvivalService:EquipArmor(player, r.Id)
		if self.ctx.Services.QuestService then
			self.ctx.Services.QuestService:Progress(player, "Craft", 1)
		end
		self.ctx.Notify(player, string.format("🛡 Equipped %s! Max HP +%d", Items.DisplayName(r.Id), item.ArmorHP or 0), "Good")
		self.ctx.Remotes.Get("HitFx"):FireAllClients("Craft", { Position = self.benchPos })
		return
	end
	if item.Category == "Tool" and inv:Count(player, r.Id) > 0 then
		self.ctx.Notify(player, "You already have " .. Items.DisplayName(r.Id) .. "", "Info")
		return
	end
	local sack = Items.Sacks[r.Id] and inv:BestSack(player)
	if sack and Items.Sacks[sack] >= Items.Sacks[r.Id] then
		self.ctx.Notify(player, "You already have " .. Items.DisplayName(sack) .. " or a bigger one", "Info")
		return
	end
	local mult = 1
	if item.Category == "Structure" then
		mult = 1 - self.ctx.Services.SurvivalService:Perk(player, "BuildDiscount", 0)
	end
	-- จำนวนที่ขอ (ไม่เชื่อ client): จำนวนเต็ม 1..CraftCap · เครื่องมือได้ทีละ 1
	local want = tonumber(count) or 1
	if want ~= want then
		want = 1
	end
	want = math.clamp(math.floor(want), 1, CampService.CraftCap)
	if item.Category == "Tool" then
		want = 1
	end
	local amount = r.Amount or 1
	-- จำนวนสูงสุดของสิ่งก่อสร้าง (Limits): ครบแล้วคราฟต์ไม่ได้ ไม่เสียวัตถุดิบ
	local room = inv:Room(player, r.Id)
	if room < amount then
		self.ctx.Notify(player, inv:LimitText(r.Id) .. " — maxed out", "Error")
		return
	end
	want = math.min(want, math.floor(room / amount))
	-- ของกินที่ในกระสอบ (ยา ฯลฯ): หลายชิ้นได้ไม่เกินที่ว่างในกระสอบ (ชิ้นเดียวทำได้เสมอเหมือนเดิม)
	if want > 1 and Items.Bulk(r.Id) then
		want = math.max(1, math.min(want, math.floor(inv:Space(player) / amount)))
	end
	-- ทำได้กี่ชิ้นจากของที่มี
	local inCamp = true
	local per = {}
	local can = want
	for id, n in pairs(r.Cost) do
		local need = math.max(1, math.ceil(n * mult))
		per[id] = need
		can = math.min(can, math.floor(inv:Available(player, id, inCamp) / need))
	end
	if can <= 0 then
		self.ctx.Notify(player, "Not enough materials", "Error")
		return
	end
	local total = {}
	for id, need in pairs(per) do
		total[id] = need * can
	end
	if not inv:Spend(player, total) then
		self.ctx.Notify(player, "Not enough materials", "Error")
		return
	end
	-- ของที่คราฟต์เสร็จเข้าแถบไอเทมล่างจอ (เครื่องมือ/สิ่งก่อสร้าง/ยา) — ช่องเต็มก็อยู่ในกระเป๋า
	inv:Add(player, r.Id, amount * can)
	if self.ctx.Services.QuestService then
		self.ctx.Services.QuestService:Progress(player, "Craft", can)
	end
	local suffix = can > 1 and (" x" .. can) or ""
	self.ctx.Notify(player, "🔨 Crafted: " .. Items.DisplayName(r.Id) .. suffix .. (item.Category == "Structure" and "  (in the hotbar at the bottom, tap to place)" or ""), "Good")
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Craft", { Position = self.benchPos })
end

-- ย่างเนื้อที่กองไฟ
function CampService:FirePosition()
	return self.fireCore and self.fireCore.Position
end

-- ระยะที่ต้องเดินเข้าไปถึงจะโยนของเข้ากองไฟได้ (ไม่ดูดของจากไกล ๆ)
CampService.ThrowRange = 12

-- โยนของจากกระสอบเข้ากองไฟ 1 ชิ้น · what = "Fuel" (ไม้/ถ่าน) / "Meat" (เนื้อดิบไปย่าง) / nil (เชื้อเพลิงก่อน ไม่มีค่อยเนื้อ)
function CampService:ThrowFrom(player, what)
	local inv = self.ctx.Services.InventoryService
	local char = player.Character
	local fire = self:FirePosition()
	if not (char and fire) or ((char:GetPivot().Position - fire) * Vector3.new(1, 0, 1)).Magnitude > self.ThrowRange then
		if char and fire then
			self.ctx.Notify(player, "Walk closer to the campfire first, then throw", "Info")
		end
		return
	end
	local now = os.clock()
	if (self.lastThrow[player] or 0) > now - 0.35 then
		return
	end
	self.lastThrow[player] = now
	local pick
	if what ~= "Meat" then
		for _, id in ipairs(FUEL_ORDER) do
			if inv:Count(player, id) > 0 then
				pick = id
				break
			end
		end
	end
	if not pick and what ~= "Fuel" and inv:Count(player, "RawMeat") > 0 then
		pick = "RawMeat"
	end
	if not pick then
		self.ctx.Notify(player, what == "Meat" and "No raw meat in your sack (go hunting first)"
			or what == "Fuel" and "No wood/coal in your sack" or "No wood/coal/raw meat in your sack to throw into the fire", "Info")
		return
	end
	inv:Remove(player, pick, 1)
	self.ctx.Services.DropService:Throw(player, pick, 1, fire + Vector3.new(0, 1, 0))
end

-- เครื่องย่อย: ของที่บดได้ (วัตถุดิบ/แก่นธาตุ/ของหายาก)
local GRINDABLE = { Resource = true, Essence = true, Relic = true }
local GRIND_RANGE = 16 -- รัศมีรอบเครื่องบดที่ของบนพื้นถูกดูดเข้าไปบด

function CampService:FeedGrinder(player, all)
	local hopper = self.hopper
	if not hopper then
		local n, got = self.ctx.Services.InventoryService:Deposit(player)
		if n > 0 then
			self.ctx.Notify(player, string.format("🔥 Stored %d items in the camp storage", n), "Good")
			self.ctx.Remotes.Get("HitFx"):FireClient(player, "Stored", { Items = got }) -- ฟีดขวาจอ: รูปไอเทมจริงที่เทลงคลัง
		end
		return
	end
	local char = player.Character
	if not char or (char:GetPivot().Position - hopper.Position).Magnitude > 34 then
		return
	end
	local now = os.clock()
	if (self.lastThrow[player] or 0) > now - 0.15 then
		return
	end
	self.lastThrow[player] = now
	local inv = self.ctx.Services.InventoryService
	local list = {}
	for id, n in pairs(inv:Get(player)) do
		local d = Items.Data[id]
		if d and GRINDABLE[d.Category] and n > 0 then
			table.insert(list, { id, n })
		end
	end
	if #list == 0 then
		self.ctx.Notify(player, "No materials in your sack to grind (wood, stone, ore, pelt, bone ...)", "Info")
		return
	end
	local target = hopper.Position + Vector3.new(0, hopper.Size.Y * 0.2, 0)
	if not all then
		local id = list[1][1]
		inv:Remove(player, id, 1)
		self.ctx.Services.DropService:Throw(player, id, 1, target)
		return
	end
	-- โยนทั้งกระสอบทีละกอง (เห็นของลอยเข้าเครื่อง)
	task.spawn(function()
		for _, e in ipairs(list) do
			local left = e[2]
			while left > 0 do
				local k = math.min(left, 5)
				if inv:Remove(player, e[1], k) then
					self.ctx.Services.DropService:Throw(player, e[1], k, target)
				end
				left -= k
				task.wait(0.18)
			end
		end
	end)
end

-- ป้ายบนเครื่องบด: จำนวนไม้/เหล็กในคลังแคมป์
function CampService:UpdateStockSign()
	local bench = self.campModel and self.campModel:FindFirstChild("Workbench")
	if not bench then
		return
	end
	local camp = self.ctx.Services.InventoryService.Camp
	-- จำนวนในคลังแคมป์ -> HUD มุมขวาบน (ใต้การ์ดกองไฟ)
	for _, id in ipairs({ "Wood", "Stone", "Iron" }) do
		self.ctx.State:SetAttribute("Stock" .. id, camp[id] or 0)
	end
	for name, id in pairs({ StockWood = "Wood", StockIron = "Iron" }) do
		local part = bench:FindFirstChild(name)
		local gui = part and part:FindFirstChildOfClass("SurfaceGui")
		if gui then
			gui.Label.Text = tostring(camp[id] or 0)
		end
	end
end

function CampService:GrindDrops()
	local hopper = self.hopper
	if not hopper then
		return
	end
	local drops = self.ctx.Services.DropService
	local got = {}
	-- ดูดของที่ตกรอบเครื่องบดทั้งวง (ราว 16 studs จากกลางเครื่อง) ไม่ใช่แค่ในช่องกรวย
	local range = math.max(GRIND_RANGE, math.max(hopper.Size.X, hopper.Size.Z) * 0.6)
	for _, d in ipairs(drops:Near(hopper.Position, range, hopper.Size.Y + 14)) do
		local item = Items.Data[d.Id]
		if item and GRINDABLE[item.Category] then
			drops:Remove(d.Model)
			local camp = self.ctx.Services.InventoryService.Camp
			camp[d.Id] = (camp[d.Id] or 0) + d.Count
			got[d.Id] = (got[d.Id] or 0) + d.Count
		end
	end
	if next(got) then
		self:UpdateStockSign()
		self.ctx.Services.InventoryService:MarkAll()
		self.ctx.Remotes.Get("HitFx"):FireAllClients("Grind", { Bench = self.campModel:FindFirstChild("Workbench"), Items = got })
	end
end

local COOK = { RawMeat = "CookedMeat" }
function CampService:BurnDrops()
	local fire = self:FirePosition()
	if not fire then
		return
	end
	local drops = self.ctx.Services.DropService
	for _, d in ipairs(drops:Near(fire - Vector3.new(0, 1.5, 0), 5.5, 6)) do
		local item = Items.Data[d.Id]
		if COOK[d.Id] then
			if self:IsLit() and not d.Model:GetAttribute("Cooking") then
				-- ย่างอยู่ในไฟ 2.5 วิ (เห็นชิ้นเนื้อในกองไฟ) แล้วสุกเด้งออกไปทางคนโยน
				d.Model:SetAttribute("Cooking", true)
				self.ctx.Remotes.Get("HitFx"):FireAllClients("Refuel", { Position = fire })
				local by = d.By
				task.delay(2.5, function()
					if not d.Model.Parent then
						return
					end
					local count = d.Model:GetAttribute("Count") or d.Count
					drops:Remove(d.Model)
					local root = by and by.Character and by.Character:FindFirstChild("HumanoidRootPart")
					local dir = root and (root.Position - fire) * Vector3.new(1, 0, 1)
					dir = dir and dir.Magnitude > 0.5 and dir.Unit or Vector3.new(1, 0, 0)
					drops:Spawn(COOK[d.Id], count, fire + dir * 5 + Vector3.new(0, 1, 0), { Spread = 1.5 })
					self.ctx.Remotes.Get("HitFx"):FireAllClients("Refuel", { Position = fire })
					if by and by.Parent then
						self.ctx.Notify(by, "🍖 Meat is cooked! Put it in your sack or press R to eat", "Good")
					end
				end)
			end
		elseif item and item.Fuel then
			drops:Remove(d.Model)
			local before = self.fuel
			self:AddFuel(item.Fuel * d.Count)
			if d.By and self.ctx.Services.QuestService then
				self.ctx.Services.QuestService:Progress(d.By, "Fuel", math.floor(self.fuel - before))
			end
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Refuel", { Position = fire })
		end
	end
end

function CampService:Cook(player)
	if not self:IsLit() then
		self.ctx.Notify(player, "The fire is out, can't cook", "Error")
		return
	end
	local inv = self.ctx.Services.InventoryService
	local n = inv:Count(player, "RawMeat")
	if n <= 0 then
		self.ctx.Notify(player, "No raw meat", "Error")
		return
	end
	inv:Remove(player, "RawMeat", n)
	inv:Add(player, "CookedMeat", n)
	self.ctx.Notify(player, "🍖 Cooking meat x" .. n, "Good")
end

local function costText(cost)
	local parts = {}
	for id, n in pairs(cost) do
		table.insert(parts, Items.DisplayName(id) .. " " .. n)
	end
	table.sort(parts)
	return table.concat(parts, ", ")
end

function CampService:RefreshPrompts()
	if self.upgradePrompt then
		local nextInfo = Recipes.Campfire[self.level + 1]
		self.upgradePrompt.ObjectText = "Campfire Lv." .. self.level
		self.upgradePrompt.ActionText = nextInfo and ("Upgrade: " .. costText(nextInfo.Cost)) or "Max Level"
	end
	if self.benchUpgradePrompt then
		local cost = Recipes.BenchUpgrade[self.bench + 1]
		self.benchUpgradePrompt.ObjectText = "Crafting Bench Lv." .. self.bench
		self.benchUpgradePrompt.ActionText = cost and ("Upgrade: " .. costText(cost)) or "Max Level"
	end
end

local function prompt(parent, name, action, object, key, hold, dist)
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = key
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = dist or 14
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

-- กำแพงหมอก: ฝั่งผู้เล่นกันไว้นุ่มๆ อยู่แล้ว (FogWall.lua) · เซิร์ฟเวอร์กันซ้ำถ้าหลุดไปไกล (แลค/โกง)
function CampService:StartFogWall(ctx)
	local RS = game:GetService("ReplicatedStorage")
	if RS:FindFirstChild("ASAutoTest") and not RS:FindFirstChild("ASFogProbe") then
		return
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { workspace.Terrain }
	local warned = {}
	task.spawn(function()
		while true do
			task.wait(0.5)
			local reveal = self:RevealRadius()
			for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
				local char = p.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root and p:GetAttribute("InRun") and not p:GetAttribute("FogPass") then
					local flat = root.Position * Vector3.new(1, 0, 1)
					if flat.Magnitude > reveal + 25 then
						local to = flat.Unit * (reveal - 8)
						local hit = workspace:Raycast(Vector3.new(to.X, 1500, to.Z), Vector3.new(0, -3000, 0), rp)
						local y = math.max(hit and hit.Position.Y or root.Position.Y, Config.WaterLevel) + 4
						char:PivotTo(CFrame.new(Vector3.new(to.X, y, to.Z), Vector3.new(0, y, 0)))
						root.AssemblyLinearVelocity = Vector3.zero
						if not warned[p] or os.clock() - warned[p] > 5 then
							warned[p] = os.clock()
							ctx.Notify(p, "🌫 The fog is too thick — upgrade the campfire to explore further", "Error")
						end
					end
				end
			end
		end
	end)
end

function CampService:Start(ctx)
	local camp = workspace.World.Sites:WaitForChild("Camp")
	self.campModel = camp
	self.campfire = camp:WaitForChild("Campfire")
	self.fireCore = self.campfire:WaitForChild("FireCore")
	local bench = camp:WaitForChild("Workbench")
	self.benchPos = bench:GetPivot().Position

	local benchTop = bench.PrimaryPart
	local craft = prompt(benchTop, "Craft", "Open Crafting Menu", "Crafting Bench", Enum.KeyCode.E, 0, 14)
	craft.Triggered:Connect(function(p)
		ctx.Remotes.Get("Cinematic"):FireClient(p, "OpenCraft", {})
	end)
	-- เครื่องย่อย (ซ้าย): โยนวัตถุดิบลงช่อง -> บด -> เข้าคลังแคมป์ (ทุกคนใช้ร่วมกัน)
	self.hopper = bench:FindFirstChild("Hopper")
	local depositHost = self.hopper or benchTop
	local deposit = prompt(depositHost, "Deposit", "Throw materials into the grinder (one at a time)", "Grinder", Enum.KeyCode.G, 0, 20)
	if not self.hopper then
		deposit.UIOffset = Vector2.new(0, 70)
	end
	deposit.Triggered:Connect(function(p)
		self:FeedGrinder(p, false) -- กด 1 ครั้ง = โยน 1 ชิ้น
	end)
	-- กองไฟ: เดินเข้าไปใกล้แล้วกดโยนเอง (ไม่ดูดของจากไกล ๆ) · [E] โยนไม้/ถ่าน · [R] โยนเนื้อดิบไปย่าง
	local fuelPrompt = prompt(self.fireCore, "FireFuel", "Throw wood into the fire", "Campfire", Enum.KeyCode.E, 0, self.ThrowRange - 2)
	local cookPrompt = prompt(self.fireCore, "FireCook", "Cook Meat", "Campfire", Enum.KeyCode.R, 0, self.ThrowRange - 2)
	cookPrompt.UIOffset = Vector2.new(0, 70)
	for _, pp in ipairs({ { fuelPrompt, "Fuel" }, { cookPrompt, "Meat" } }) do
		pp[1].Triggered:Connect(function(p)
			if not ctx.Services.SurvivalService:IsIncapacitated(p) and p:GetAttribute("InRun") then
				self:ThrowFrom(p, pp[2])
			end
		end)
	end
	self:RefreshPrompts()
	self:StartFogWall(ctx)

	ctx.Remotes.Get("Craft").OnServerEvent:Connect(function(player, recipeId, count)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		if recipeId == "UpgradeFire" or recipeId == "UpgradeBench" then
			-- อัปเกรดจากเมนูคราฟต์ (ต้องอยู่ในแคมป์)
			if not self:InCamp(player) then
				self.ctx.Notify(player, "Must be in the camp", "Error")
			elseif recipeId == "UpgradeFire" then
				self:UpgradeFire(player)
			else
				self:UpgradeBench(player)
			end
		elseif type(recipeId) == "string" then
			self:Craft(player, recipeId, count)
		end
	end)
	-- ถือกระสอบแล้วคลิกกองไฟ = โยนเชื้อเพลิงจากกระสอบเข้าไป (ไม่มีก็โยนเนื้อดิบไปย่าง)
	ctx.Remotes.Get("ThrowFuel").OnServerEvent:Connect(function(player)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		self:ThrowFrom(player)
	end)
	task.spawn(function()
		while true do
			self:UpdateStockSign()
			task.wait(1)
		end
	end)
	ctx.Remotes.Get("ThrowGrind").OnServerEvent:Connect(function(player)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		self:FeedGrinder(player, false)
	end)
	-- ของที่ตกลงในกองไฟ: เชื้อเพลิงไหม้ / เนื้อดิบสุกเด้งออกมา · ของที่ตกลงช่องเครื่องย่อย: บดเข้าคลัง
	task.spawn(function()
		while true do
			task.wait(0.25)
			self:BurnDrops()
			self:GrindDrops()
		end
	end)

	self:UpdateVisual()
	self:Publish()
	-- เชื้อเพลิงลดลงตามเวลา
	task.spawn(function()
		local dt = 1
		while true do
			task.wait(dt)
			if ctx.Services.DirectorService:IsRunning() and ctx.State:GetAttribute("Phase") ~= "Ended" then
				local night = ctx.State:GetAttribute("Phase") == "Night"
				local drain = (night and Recipes.CampfireDrainNight or Recipes.CampfireDrainDay) * (1 + (self.level - 1) * 0.15)
				-- ผู้พิทักษ์เปลวไฟ / วิญญาณน้ำ ลดการกินเชื้อเพลิง
				for _, p in ipairs(Players:GetPlayers()) do
					local m = ctx.Services.SurvivalService:Perk(p, "FuelDrainMult", 1)
					if m < 1 then
						drain *= m
						break
					end
				end
				if ctx.State:GetAttribute("SpiritWater") then
					drain *= 0.75
				end
				-- อัตรากินเชื้อเพลิงต่อวินาที (HUD ใช้ประมาณเวลาที่เหลือ) · ส่งเฉพาะตอนเปลี่ยน
				local rounded = math.floor(drain * 1000 + 0.5) / 1000
				if ctx.State:GetAttribute("CampDrain") ~= rounded then
					ctx.State:SetAttribute("CampDrain", rounded)
				end
				local before = self.fuel
				self.fuel = math.max(0, self.fuel - drain * dt)
				if before > 0 and self.fuel <= 0 then
					ctx.FireRun("Cinematic", "FireOut", {})
				end
				-- เชื้อเพลิงต่ำกว่า 20%: HUD ของผู้เล่นในรอบเตือนเอง (กะพริบ + เสียง + ข้อความพร้อมเวลาที่เหลือ)
				self:UpdateVisual()
				self:Publish()
			end
		end
	end)
end

function CampService:Restore(level, bench, fuel)
	self.level = math.clamp(math.floor(tonumber(level) or 1), 1, #Recipes.Campfire)
	self.bench = math.max(1, math.floor(tonumber(bench) or 1))
	self.fuel = math.clamp(tonumber(fuel) or 0, 0, self:Info().MaxFuel)
	self:UpdateVisual()
	self:Publish()
	self:RefreshPrompts()
	self:UpdateStockSign()
end

function CampService:Reset()
	self.level = 1
	self.bench = 1
	self.fuel = Recipes.Campfire[1].MaxFuel * 0.75
	self:UpdateVisual()
	self:Publish()
	self:RefreshPrompts()
end

return CampService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000060"><Properties><string name="Name">Codes</string><ProtectedString name="Source"><![CDATA[--[[
	Codes — โค้ดแลกรางวัล (อยู่ฝั่ง server เท่านั้น ผู้เล่นเปิดดูไฟล์นี้ไม่ได้)
	  คีย์ = ตัวโค้ด (ตัวพิมพ์ใหญ่ ไม่มีเว้นวรรค) · ผู้เล่นพิมพ์เล็ก/ใหญ่ก็ได้
	  Ruby = จำนวน Ruby · Title / Color = ฉายา/สีฉายา (id จาก Shared/Quests.lua)
	  Expires = os.time() ที่หมดอายุ (ไม่ใส่ = ไม่หมดอายุ) · Starts = เริ่มใช้ได้เมื่อ (ไม่ใส่ = ใช้ได้เลย)
	  ใช้ได้คนละครั้งต่อโค้ด (เก็บในเซฟ CodesUsed)
]]

return {
	BETAANIMALSURVIVAL = { Ruby = 200 }, -- แจกผู้เข้าร่วมทดสอบ (คนละครั้ง)
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000061"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--[[
	CombatService — การโจมตีของผู้เล่น + ดาเมจใส่สัตว์ + กระสุน (ลูกไฟ/ลูกธนู/หินถล่ม)
	ธาตุแพ้ทาง: น้ำ > ไฟ > ลม > ดิน > น้ำ  (ชนะทาง x1.5 / แพ้ทาง x0.75)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Items = require(ReplicatedStorage.Shared.Items)

local CombatService = {}

local BEATS = { Water = "Fire", Fire = "Air", Air = "Earth", Earth = "Water" }
local projectiles = {}
-- สีไฟเผาตามออร่าอาวุธ (ToolFactory)
local function burnColor(toolId, tool)
	local ok, TF = pcall(require, script.Parent.ToolFactory)
	if ok and TF and TF.BurnColor then
		return TF.BurnColor(toolId, tool)
	end
	return nil
end

function CombatService:Init(ctx)
	self.ctx = ctx
	self.lastAttack = {}
	self.rayParams = RaycastParams.new()
	self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
end

function CombatService.ElementMult(weaponElement, targetElement)
	if not weaponElement or not targetElement or targetElement == "None" then
		return 1
	end
	if weaponElement == "All" then
		return 1.25
	end
	if BEATS[weaponElement] == targetElement then
		return 1.5
	elseif BEATS[targetElement] == weaponElement then
		return 0.75
	end
	return 1
end

local function equippedTool(player)
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then
		local id = tool:GetAttribute("ItemId")
		return id, Items.Tools[id], tool
	end
	return nil
end
CombatService.EquippedTool = equippedTool

-- ดาเมจใส่สัตว์ (a = ข้อมูลสัตว์จาก AnimalService)
function CombatService:DamageAnimal(a, amount, attacker, opts)
	opts = opts or {}
	self.ctx.Services.AnimalService:TakeDamage(a, amount, attacker, opts)
end

function CombatService:PlayerDamage(player, toolId, tool, target)
	local surv = self.ctx.Services.SurvivalService
	local dmg = tool.Damage * surv:Perk(player, "DamageMult", 1)
	local mult = CombatService.ElementMult(tool.Element, target.Info.Element)
	if tool.Element then
		dmg *= surv:Perk(player, "ElementDamageMult", 1)
	end
	-- แวมไพร์: แรงขึ้นตอนกลางคืน
	if self.ctx.State:GetAttribute("Phase") == "Night" then
		dmg *= surv:Perk(player, "NightDamageMult", 1)
	end
	local crit = math.random() < 0.1
	if crit then
		dmg *= 1.6
	end
	local final = dmg * mult
	-- พ่อมดมืด: ทำดาเมจ = หลุดล่องหน
	if player:GetAttribute("Invisible") and self.ctx.Services.SkillService then
		self.ctx.Services.SkillService:BreakVeil(player)
	end
	-- ดูดเลือด: ได้เลือดคืนตามสัดส่วนดาเมจที่ตี (ต่อเป้า 1 ตัว ไม่เกิน 25 ต่อครั้ง)
	local steal = surv:Perk(player, "LifeSteal", 0)
	if steal > 0 and target and not target.Dead then
		surv:Heal(player, math.min(final * steal, 25))
	end
	return final, crit, mult
end

function CombatService:Melee(player, toolId, tool, root, aim)
	local animals = self.ctx.Services.AnimalService
	-- ทิศฟัน = ทิศที่ผู้เล่นเล็ง (กล้อง/เมาส์) ถ้าส่งมาถูกต้อง ไม่งั้นใช้ทิศที่ตัวหัน
	local look = root.CFrame.LookVector
	if typeof(aim) == "Vector3" and aim.Magnitude > 0.5 then
		local flat = Vector3.new(aim.X, 0, aim.Z)
		if flat.Magnitude > 0.2 then
			look = flat.Unit
		end
	end
	local origin = root.Position
	local best, bestScore
	local hits = {}
	local threat = false -- มอนอยู่ตรงหน้าแต่ยังเอื้อมไม่ถึง: ห้ามไปตีต้นไม้/หินแทน (ฟันลม)
	for _, a in ipairs(animals:InRadius(origin, tool.Range + 10, false)) do
		if a.Kind ~= "Spirit" and not a.Dead then
			local offset = a.Root.Position - origin
			local reach = tool.Range + a.Radius
			local flat = offset * Vector3.new(1, 0.4, 1)
			local d = flat.Magnitude
			if d <= reach + 6 and a.Info.Behaviour ~= "Passive" and (d < 0.1 or look:Dot(flat.Unit) > 0.15) then
				threat = true
			end
			if d <= reach then
				local dot = d > 0.1 and look:Dot(flat.Unit) or 1
				if dot > 0.15 or d < a.Radius + 3 then
					local score = d - dot * 4
					if not bestScore or score < bestScore then
						best, bestScore = a, score
					end
					table.insert(hits, a)
				end
			end
		end
	end
	if best then
		local targets = tool.Aoe and hits or { best }
		for _, a in ipairs(targets) do
			local dmg, crit, mult = self:PlayerDamage(player, toolId, tool, a)
			self:DamageAnimal(a, dmg, player, { Burn = tool.Burn, BurnColor = tool.Burn and burnColor(toolId, tool), Slow = tool.Slow, Crit = crit, Mult = mult, Knock = look })
			if tool.Fx then
				self.ctx.Remotes.Get("HitFx"):FireAllClients("ClassHit", { Fx = tool.Fx, Position = a.Root.Position, Dir = look, Crit = crit })
			end
		end
		if tool.Aoe then
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Slam", { Position = best.Root.Position, Radius = tool.Aoe, Element = tool.Element })
		end
		return true
	end
	-- ไม่โดนสัตว์ -> ตัดไม้/ทุบหิน (ยกเว้นมีมอนอยู่ตรงหน้า = ตั้งใจตีมอน)
	if threat then
		return false
	end
	local node = self.ctx.Services.ResourceService:FindNode(origin + look * 3.5, math.max(tool.Range * 0.75, 7))
	if node then
		return self.ctx.Services.ResourceService:Hit(player, node, tool)
	end
	return false
end

function CombatService:Shoot(player, toolId, tool, aim, char)
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local origin = head.Position + aim * 2
	local exclude = { char }
	local pierce = tool.Pierce or 1
	local hitPos = origin + aim * tool.Range
	local hitCount = 0
	local from = origin
	for _ = 1, pierce + 2 do
		self.rayParams.FilterDescendantsInstances = exclude
		local res = Workspace:Raycast(from, aim * tool.Range, self.rayParams)
		if not res then
			break
		end
		hitPos = res.Position
		local model = res.Instance:FindFirstAncestorWhichIsA("Model")
		local a = model and self.ctx.Services.AnimalService:Get(model)
		if a and a.Kind ~= "Spirit" then
			local dmg, crit, mult = self:PlayerDamage(player, toolId, tool, a)
			self:DamageAnimal(a, dmg, player, { Crit = crit, Mult = mult, Knock = aim })
			hitCount += 1
			table.insert(exclude, model)
			from = res.Position
			if hitCount >= pierce then
				break
			end
		else
			break
		end
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Arrow", { From = origin, To = hitPos, Element = tool.Element, Player = player })
end

-- สีเอฟเฟกต์อาวุธประจำคลาส (Items.Tools[].Fx) -> ClassFX ฝั่ง client
local FX_COLOR = {
	Arcane = Color3.fromRGB(170, 70, 255),
	Verdant = Color3.fromRGB(110, 235, 90),
	Blood = Color3.fromRGB(230, 30, 50),
}

-- คทา: ปล่อยลูกไฟไปทางที่เล็งเสมอ (ไม่ฟาดต้นไม้/หิน — เคยไปตีต้นไม้แทนมอนที่อยู่ไกลเกิน 17 studs)
function CombatService:Staff(player, toolId, tool, aim, char, root)
	if typeof(aim) ~= "Vector3" or aim.Magnitude < 0.5 then
		aim = root.CFrame.LookVector
	end
	aim = aim.Unit
	local head = char:FindFirstChild("Head")
	local b = tool.Bolt
	local from = (head and head.Position or root.Position) + aim * 3
	self:Projectile({
		From = from, Velocity = aim * b.Speed, Gravity = 0, Radius = 1.5, Blast = b.Blast, Size = b.Size,
		Owner = "Player", Player = player, ToolId = toolId, Tool = tool, Fire = true, Burn = tool.Burn, BurnColor = tool.Burn and burnColor(toolId, tool),
		Color = FX_COLOR[tool.Fx] or Color3.fromRGB(255, 120, 40), VFX = "StaffBolt", FxScale = b.FxScale, Life = b.Range / b.Speed,
		ImpactFx = "StaffExplosion", ImpactScale = b.ImpactScale, Tint = FX_COLOR[tool.Fx], FxKind = tool.Fx,
	})
end

function CombatService:OnAttack(player, aim)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local surv = self.ctx.Services.SurvivalService
	if not root or not surv:IsAlive(player) then
		return
	end
	local toolId, tool = equippedTool(player)
	if not tool then
		return
	end
	local now = os.clock()
	if now - (self.lastAttack[player] or 0) < tool.Cooldown * 0.85 then
		return
	end
	self.lastAttack[player] = now
	-- ท่าตีให้คนอื่นเห็น (คนตีเล่นเองไปแล้วในเครื่องตัวเอง)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			self.ctx.Remotes.Get("HitFx"):FireClient(p, "Swing", { Player = player, Id = toolId })
		end
	end
	if tool.Fx then
		local look = root.CFrame.LookVector
		if typeof(aim) == "Vector3" and Vector3.new(aim.X, 0, aim.Z).Magnitude > 0.2 then
			look = Vector3.new(aim.X, 0, aim.Z).Unit
		end
		self.ctx.Remotes.Get("HitFx"):FireAllClients("ClassSwing", { Fx = tool.Fx, Player = player, Position = root.Position, Dir = look, Kind = tool.Kind })
	end
	if tool.Kind == "Bow" then
		if typeof(aim) ~= "Vector3" or aim.Magnitude < 0.5 then
			return
		end
		self:Shoot(player, toolId, tool, aim.Unit, char)
	elseif tool.Kind == "Staff" then
		self:Staff(player, toolId, tool, aim, char, root)
	else
		self:Melee(player, toolId, tool, root, aim)
	end
end

---------------------------------------------------------------- กระสุนฝั่ง server
--[[
	Projectile({
		From, Velocity (Vector3), Gravity (number), Radius (ชน), Damage, Owner ("Animal"/"Player"),
		Color, Size, Burn, OnImpact(position), Life
	})
]]
-- ก้อนหินจริง (โมเดล RockLP) สำหรับหินถล่ม/อุกกาบาต
local function rockPart(size)
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
	local pack = assets and assets:FindFirstChild("Props") and assets.Props:FindFirstChild("RockLP")
	local list = {}
	for _, d in ipairs(pack and pack:GetDescendants() or {}) do
		if d:IsA("MeshPart") then
			table.insert(list, d)
		end
	end
	if #list == 0 then
		return nil
	end
	local r = list[math.random(1, #list)]:Clone()
	r:ClearAllChildren()
	local k = size / math.max(r.Size.X, r.Size.Y, r.Size.Z)
	r.Size *= k
	return r
end

-- หันหน้า (-Z) ไปตามทิศพุ่ง: เอฟเฟกต์ลูกไฟ (VFXPack Ball-01) ออกแบบให้พุ่งไปทาง LookVector
--   (เคยใช้ CFrame ไม่หมุน -> ลูกไฟตอนตกดิ่งเยื้องข้าง หางไฟพ่นออกด้านข้าง ดูเอียง)
local function faceAlong(pos, vel)
	if vel and vel.Magnitude > 0.05 then
		local up = math.abs(vel.Unit.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
		return CFrame.lookAt(pos, pos + vel, up)
	end
	return CFrame.new(pos)
end

function CombatService:Projectile(spec)
	local p = spec.Model == "Rock" and rockPart(spec.Size or 2)
	if p then
		p.Color = spec.Color or Color3.fromRGB(110, 100, 90)
		p.Material = spec.Fire and Enum.Material.Basalt or Enum.Material.Slate
		if spec.VFX then
			p:SetAttribute("VFX", spec.VFX)
		end
	else
		p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(spec.Size or 2, spec.Size or 2, spec.Size or 2)
		p.Material = spec.Fire and Enum.Material.CrackedLava or Enum.Material.Neon
		if spec.VFX then
			p:SetAttribute("VFX", spec.VFX) -- อุกกาบาตไฟ: client ใส่ลูกไฟ/ควันตาม
			p:SetAttribute("FxScale", spec.FxScale)
			if spec.Tint then
				p:SetAttribute("FxTint", spec.Tint) -- อาวุธประจำคลาส: ย้อมสีลูกพลัง
				p:SetAttribute("FxKind", spec.FxKind)
			end
		end
	end
	p.Color = spec.Model == "Rock" and p.Color or (spec.Color or Color3.fromRGB(255, 120, 30))
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CFrame = faceAlong(spec.From, spec.Velocity)
	local l = Instance.new("PointLight")
	l.Color = p.Color
	l.Range = 14
	l.Brightness = 2
	l.Parent = p
	if spec.VFX == "StaffBolt" then
		p.Transparency = 1 -- ตัวลูกจริงซ่อน ให้เห็นแต่เอฟเฟกต์ไฟ
	end
	if spec.Fire and spec.Model ~= "Rock" and spec.VFX ~= "StaffBolt" then
		local f = Instance.new("Fire")
		f.Size = (spec.Size or 2) * 1.5
		f.Heat = 4
		f.Parent = p
	end
	local trail = Instance.new("ParticleEmitter")
	trail.Enabled = spec.Model ~= "Rock" and spec.VFX ~= "StaffBolt" -- ก้อนหิน/ลูกไฟคทาใช้เอฟเฟกต์ฝั่ง client แทน
	trail.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	trail.Rate = 40
	trail.Lifetime = NumberRange.new(0.4, 0.7)
	trail.Speed = NumberRange.new(0, 1)
	trail.LightEmission = 1
	trail.Size = NumberSequence.new((spec.Size or 2) * 0.6, 0)
	trail.Color = ColorSequence.new(p.Color)
	trail.Parent = p
	p.Parent = Workspace:FindFirstChild("FX") or Workspace
	table.insert(projectiles, {
		Part = p, Pos = spec.From, Vel = spec.Velocity, Gravity = spec.Gravity or 0, Spec = spec,
		Die = os.clock() + (spec.Life or 5),
	})
end

function CombatService:StepProjectiles(dt)
	local surv = self.ctx.Services.SurvivalService
	local animals = self.ctx.Services.AnimalService
	-- ลูกไฟผู้เล่นทะลุกำแพงฝั่งตัวเอง (ยิงข้ามกำแพงแคมป์ได้) ชนแค่พื้น
	local playerShotParams = RaycastParams.new()
	playerShotParams.FilterType = Enum.RaycastFilterType.Include
	playerShotParams.FilterDescendantsInstances = { Workspace.Terrain }
	local terrainParams = RaycastParams.new()
	terrainParams.FilterType = Enum.RaycastFilterType.Include
	terrainParams.FilterDescendantsInstances = { Workspace.Terrain, self.ctx.Services.BuildingService.folder }
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local spec = pr.Spec
		pr.Vel += Vector3.new(0, -pr.Gravity * dt, 0)
		local step = pr.Vel * dt
		local res = Workspace:Raycast(pr.Pos, step, spec.Owner == "Player" and playerShotParams or terrainParams)
		local newPos = res and res.Position or pr.Pos + step
		local impact = res ~= nil or os.clock() > pr.Die
		-- ลูกไฟของผู้เล่น (คทา): ชนสัตว์
		if not impact and spec.Owner == "Player" then
			for _, a in ipairs(animals:InRadius(newPos, (spec.Radius or 1.5) + 12, false)) do
				if a.Kind ~= "Spirit" and not a.Dead and (a.Root.Position - newPos).Magnitude < (spec.Radius or 1.5) + a.Radius then
					impact = true
					break
				end
			end
		end
		-- ชนผู้เล่น
		if not impact and spec.Owner == "Animal" then
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root and (root.Position - newPos).Magnitude < (spec.Radius or 3) then
					impact = true
					break
				end
			end
		end
		pr.Pos = newPos
		pr.Part.CFrame = faceAlong(newPos, pr.Vel)
		if impact then
			table.remove(projectiles, i)
			pr.Part:Destroy()
			local blast = spec.Blast or 6
			if spec.Owner == "Player" and spec.Player and spec.Player.Parent then
				for _, a in ipairs(animals:InRadius(newPos, blast + 12, false)) do
					if a.Kind ~= "Spirit" and not a.Dead and (a.Root.Position - newPos).Magnitude < blast + a.Radius then
						local dmg, crit, mult = self:PlayerDamage(spec.Player, spec.ToolId, spec.Tool, a)
						self:DamageAnimal(a, dmg, spec.Player, { Burn = spec.Burn, BurnColor = spec.BurnColor, Crit = crit, Mult = mult, Knock = pr.Vel.Unit })
					end
				end
			end
			if spec.Owner == "Animal" then
				for _, player in ipairs(Players:GetPlayers()) do
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - newPos).Magnitude < blast then
						surv:Damage(player, spec.Damage, spec.Source or "Projectile", { Burn = spec.Burn })
					end
				end
				local building = self.ctx.Services.BuildingService
				for _, s in ipairs(building:All()) do
					if (s:GetPivot().Position - newPos).Magnitude < blast + 3 then
						building:Damage(s, spec.Damage * 0.5)
					end
				end
			end
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Explosion", { Position = newPos, Radius = blast, Color = pr.Part.Color, Fx = spec.ImpactFx, FxScale = spec.ImpactScale, Tint = spec.Tint, FxKind = spec.FxKind })
			if spec.OnImpact then
				task.spawn(spec.OnImpact, newPos)
			end
		end
	end
end

function CombatService:Start(ctx)
	local fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = Workspace
	ctx.Remotes.Get("Attack").OnServerEvent:Connect(function(player, aim)
		self:OnAttack(player, aim)
	end)
	RunService.Heartbeat:Connect(function(dt)
		if #projectiles > 0 then
			self:StepProjectiles(dt)
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		self.lastAttack[p] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000062"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService — เซฟถาวร: Ruby ♦️, คลาสที่ซื้อแล้ว, สถิติ, การตั้งค่า, ป้าย
	ใน Studio ถ้ายังไม่เปิด API Services จะใช้ข้อมูลชั่วคราว (ไม่เซฟ)
	กระดานอันดับทั้งเกม: OrderedDataStore (Config.LeaderboardStore) เก็บ "คืนที่รอดนานสุด" ของทุกคน
]]

local BadgeService = game:GetService("BadgeService")
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Classes = require(ReplicatedStorage.Shared.Classes)
local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}
local profiles = {}
local store
local storeOk = false
local board -- OrderedDataStore กระดานอันดับ

local function default()
	return {
		Diamonds = 0, Owned = { Survivor = true }, Class = "Survivor", BestNight = 0, Runs = 0, Wins = 0, Kills = 0, PendingKits = {},
		ClassLevel = {}, ClassStats = {}, StockDay = 0, StockRoll = 0, LastDaily = -1, NightsTotal = 0,
		TutorialSeen = false, Settings = {}, TrueEndings = 0, BossKills = 0, Joined = 1, BadgesAwarded = {}, Receipts = {},
		-- ภารกิจ / ล็อกอิน 7 วัน / Season Pass / โค้ด / ความสำเร็จ (QuestService, SeasonService)
		Quests = {}, LoginStreak = 0, BestStreak = 0, AchClaimed = {}, CodesUsed = {}, WeekBest = {},
		Season = {}, Titles = {}, NameColors = {}, EquipTitle = "", EquipColor = "",
		Worlds = {}, WorldCredits = 0, -- โลกที่สร้าง (WorldService)
		Revives = 0, ReviveTokens = 0, FuelAdded = 0, Crafts = 0, Gathered = 0, SpiritsSaved = 0, QuestsDone = 0,
	}
end

function DataService:Init(ctx)
	self.ctx = ctx
	local ok = pcall(function()
		store = DataStoreService:GetDataStore("AnimalSurvival_v1")
		board = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore)
	end)
	storeOk = ok and store ~= nil
end

function DataService:StoreReady()
	return storeOk
end

local function key(player)
	return "u_" .. player.UserId
end

-- ล็อกเซฟต่อเซิร์ฟ (session lock): เซฟหลักเก็บ _Lock = { Job = JobId ของเซิร์ฟที่ถือข้อมูลอยู่, T = เวลาเซฟล่าสุด }
--   ย้ายเซิร์ฟ: เซิร์ฟใหม่รอให้เซิร์ฟเก่าเซฟรอบสุดท้าย (ปลดล็อก) ก่อนค่อยโหลด -> ไม่ได้ข้อมูลเก่ามาเล่นต่อ
--   เซิร์ฟเก่าที่ล็อกโดนแย่งไปแล้ว -> เซฟไม่ทับ (กันข้อมูลย้อน/ของซ้ำ)
local LOCK_STALE = 330 -- วินาที: ล็อกที่ไม่ได้ต่ออายุนานเกินนี้ = เซิร์ฟนั้นดับไปแล้ว (เซฟอัตโนมัติทุก 120 วิ)
local LOCK_WAIT = 8 -- รอเซิร์ฟเก่าปลดล็อกสูงสุดกี่รอบ (รอบละ 3 วิ) แล้วค่อยยึดล็อก
local function jobId()
	return game.JobId ~= "" and game.JobId or "studio"
end

-- โหลด + ล็อกเซฟ · คืน data(หรือ nil = ผู้เล่นใหม่), สำเร็จไหม
local function loadLocked(player)
	local tries, lastErr = 0, nil
	while tries < LOCK_WAIT + 4 do
		tries += 1
		local busy = false
		local loaded
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old)
				local lock = type(old) == "table" and old._Lock
				if lock and lock.Job ~= jobId() and os.time() - (tonumber(lock.T) or 0) < LOCK_STALE and tries <= LOCK_WAIT then
					busy = true
					return nil -- เซิร์ฟอื่นยังถือข้อมูลอยู่: ยังไม่เขียน รอรอบหน้า
				end
				busy = false
				loaded = type(old) == "table" and old or nil
				local out = loaded or default()
				out._Lock = { Job = jobId(), T = os.time() }
				return out
			end)
		end)
		if ok and not busy then
			return loaded, true
		end
		lastErr = err
		if not player.Parent or (not ok and RunService:IsStudio()) then
			break -- Studio ที่ไม่ได้เปิด API Services: พังทันที ไม่ต้องรอ (เทสต์ไม่ค้าง)
		end
		task.wait(ok and 3 or math.min(2 ^ tries, 8))
	end
	warn("[AS] Couldn't load save:", lastErr)
	return nil, false
end

function DataService:Load(player)
	local data
	local noSave = false
	if storeOk and player.UserId > 0 then
		local loaded, ok = loadLocked(player)
		if ok then
			data = loaded
		else
			-- โหลดไม่ได้ (DataStore ล่ม/ยังไม่เปิด API) -> ห้ามเซฟทับของจริงด้วยข้อมูลเปล่า
			noSave = true
			if not RunService:IsStudio() and player.Parent then
				player:Kick("Couldn't load your save data right now — please rejoin in a moment. Your progress is safe.")
				return nil
			end
		end
	end
	data = data or default()
	data._NoSave = noSave or nil
	for k, v in pairs(default()) do
		if data[k] == nil then
			data[k] = v
		end
	end
	if ReplicatedStorage:FindFirstChild("ASSandbox") then
		data.Diamonds = 99999
	end
	profiles[player] = data
	self:EnsureStock(data)
	player:SetAttribute("Diamonds", data.Diamonds)
	player:SetAttribute("BestNight", data.BestNight or 0)
	player:SetAttribute("ReviveTokens", data.ReviveTokens or 0)
	data.Joined = 1
	if self.ctx.Services.QuestService then
		self.ctx.Services.QuestService:OnLoad(player, data)
	end
	self:PushWorlds(player) -- รายชื่อโลกที่สร้างไว้ -> เมนู Worlds
	task.spawn(function()
		self:ClaimGifts(player)
		self:CheckBadges(player)
		-- ใส่ชื่อลงกระดานอันดับ (เผื่อเคยเล่นก่อนมีระบบนี้)
		if (data.BestNight or 0) > 0 then
			self:PushBoard(player)
		end
	end)
	-- คลาสซีซั่น (พงไพร): เดิมซื้อพาสแล้วได้ทันที -> ตอนนี้ต้องกดรับขั้น 30 ของสายพรีเมียมเอง
	--   ที่ได้มาแบบเก่า (ไม่ได้มาจากการกดรับ) = ถอดออก ให้ไปกดรับตามขั้น
	for id, c in pairs(Classes.Data) do
		if c.SeasonReward and data.Owned[id] and not (type(data.SeasonClasses) == "table" and data.SeasonClasses[id]) then
			data.Owned[id] = nil
		end
	end
	local cls = (data.Owned[data.Class] and Classes.Data[data.Class]) and data.Class or "Survivor" -- คลาสที่ถูกลบออกจากเกม -> Survivor
	player:SetAttribute("Class", cls)
	player:SetAttribute("ClassLevel", data.ClassLevel[cls] or 1)
	return data
end

-- สต็อกร้านคลาส: วันใหม่ = รีเซ็ตรอบรีโรล
function DataService:EnsureStock(data)
	local today = Classes.Day()
	if data.StockDay ~= today then
		data.StockDay = today
		data.StockRoll = 0
	end
end

function DataService:Push(player)
	local data = profiles[player]
	if data then
		player:SetAttribute("Diamonds", data.Diamonds)
		self.ctx.Remotes.Get("Profile"):FireClient(player, data)
	end
end

-- สถิติของคลาสที่สวมอยู่ (ใช้ขึ้นเลเวลคลาส)
function DataService:AddClassStat(player, stat, n)
	local data = profiles[player]
	if not data then
		return
	end
	local cls = player:GetAttribute("Class") or "Survivor"
	local stats = data.ClassStats[cls] or {}
	data.ClassStats[cls] = stats
	stats[stat] = (stats[stat] or 0) + (n or 1)
	local level = data.ClassLevel[cls] or 1
	local req = Classes.Requirement(cls, level + 1)
	if req then
		local ok = true
		for k, need in pairs(req) do
			if (stats[k] or 0) < need then
				ok = false
			end
		end
		if ok then
			self:SetClassLevel(player, cls, level + 1)
			self.ctx.Notify(player, string.format("⭐ Class %s reached level %d! New skill unlocked", Classes.Data[cls].Thai, level + 1), "Reward")
		end
	end
end

-- หม้อรางวัลประจำวันในล็อบบี้ (วันละครั้ง ตามวัน UTC)
function DataService:ClaimDaily(player)
	local data = profiles[player]
	if not data then
		return
	end
	-- หม้อรางวัล = รางวัลล็อกอิน 7 วันติด (QuestService) — รับได้วันละครั้งไม่ว่าจะกดจากหม้อหรือเมนูภารกิจ
	if self.ctx.Services.QuestService then
		return self.ctx.Services.QuestService:ClaimLogin(player)
	end
	local today = Classes.Day()
	if data.LastDaily == today then
		local s = Classes.SecondsToRestock()
		self.ctx.Notify(player, string.format("Already claimed today's reward — come back in %dh %dm", s // 3600, (s % 3600) // 60), "Info")
		return
	end
	data.LastDaily = today
	self:AddDiamonds(player, Classes.DailyReward, "Daily Reward")
	self:Save(player)
end

function DataService:SetClassLevel(player, cls, level)
	local data = profiles[player]
	data.ClassLevel[cls] = math.clamp(level, 1, Classes.MaxLevel)
	if (player:GetAttribute("Class") or "Survivor") == cls then
		player:SetAttribute("ClassLevel", data.ClassLevel[cls])
		self.ctx.Services.SurvivalService:OnClassChosen(player, cls)
	end
	self:Push(player)
end

function DataService:Get(player)
	return profiles[player]
end

-- คืนที่รอดนานสุด (อัปเดตทุกเช้าที่รอดได้) -> ป้ายบนหัว + กระดานอันดับทั้งเกม + ป้าย Roblox
function DataService:SetBestNight(player, night)
	local data = profiles[player]
	if not data or night <= (data.BestNight or 0) then
		return
	end
	data.BestNight = night
	player:SetAttribute("BestNight", night)
	task.spawn(function()
		self:PushBoard(player)
		self:CheckBadges(player)
	end)
end

function DataService:PushBoard(player)
	local data = profiles[player]
	if not (data and board and storeOk and player.UserId > 0) then
		return
	end
	pcall(function()
		board:SetAsync(tostring(player.UserId), math.floor(data.BestNight or 0))
	end)
end

-- อันดับ 1..n ทั้งเกม: { { UserId, Value } ... } (nil = อ่านไม่ได้ เช่นยังไม่เปิด API Services)
function DataService:GetTop(n)
	if not (board and storeOk) then
		return nil
	end
	local ok, res = pcall(function()
		local pages = board:GetSortedAsync(false, n, 1)
		local out = {}
		for _, e in ipairs(pages:GetCurrentPage()) do
			table.insert(out, { UserId = tonumber(e.key), Value = e.value })
		end
		return out
	end)
	return ok and res or nil
end

-- ป้าย Roblox (Config.Badges): ให้เมื่อสถิติถึงเกณฑ์ (ข้ามป้ายที่ยังไม่ได้ใส่ BadgeId)
function DataService:CheckBadges(player)
	local data = profiles[player]
	if not data or player.UserId <= 0 then
		return
	end
	data.BadgesAwarded = data.BadgesAwarded or {}
	for _, b in ipairs(Config.Badges) do
		if (b.BadgeId or 0) > 0 and not data.BadgesAwarded[b.Id] and (data[b.Stat] or 0) >= b.Need then
			local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, b.BadgeId)
			if ok and has then
				data.BadgesAwarded[b.Id] = true
			elseif ok then
				local awarded = pcall(BadgeService.AwardBadge, BadgeService, player.UserId, b.BadgeId)
				if awarded then
					data.BadgesAwarded[b.Id] = true
					self.ctx.Notify(player, "🏅 Badge earned: " .. b.Name, "Reward")
				end
			end
		end
	end
end

-- เซฟ (ลองซ้ำ 3 ครั้งถ้าพลาด) · release = ออกเกมแล้ว ปลดล็อกให้เซิร์ฟถัดไปโหลดได้ทันที
--   คืน false = เซฟไม่ได้ (ล่ม / เซิร์ฟอื่นยึดล็อกไปแล้ว / โหลดไม่สำเร็จตั้งแต่แรก)
function DataService:Save(player, release)
	local data = profiles[player]
	if not (data and storeOk and player.UserId > 0) or data._NoSave then
		return false
	end
	for attempt = 1, 3 do
		local stolen = false
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old)
				local lock = type(old) == "table" and old._Lock
				if lock and lock.Job ~= jobId() then
					stolen = true
					return nil -- อีกเซิร์ฟถือข้อมูลอยู่ (คนนี้ย้ายไปแล้ว) -> ไม่เขียนทับของใหม่กว่า
				end
				data._Lock = (not release) and { Job = jobId(), T = os.time() } or nil
				return data
			end)
		end)
		if ok then
			if stolen then
				warn("[AS] save skipped: profile is now owned by another server", player.UserId)
				data._NoSave = true
				return false
			end
			return true
		end
		warn("[AS] save failed (try " .. attempt .. "):", err)
		if attempt < 3 then
			task.wait(attempt * 2)
		end
	end
	return false
end

---------------------------------------------------------------- เซฟรอบ (Game Pass Save Run)
-- โลกที่สร้างไว้ (World Pass): เก็บแยกคีย์ "runsave_<UserId>" (ตารางเดียวกับ RejoinService:SerializeRun) · โลกเดียว เซฟใหม่ทับของเก่า
local function runKey(userId)
	return "runsave_" .. userId
end

function DataService:SaveRun(player, run)
	if not storeOk then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(runKey(player.UserId), run)
	end)
	if not ok then
		warn("[AS] save run:", err)
	elseif player.Parent then
		player:SetAttribute("SavedNight", run.Night)
	end
	return ok
end

function DataService:LoadRun(userId)
	if not storeOk then
		return nil
	end
	local ok, v = pcall(function()
		return store:GetAsync(runKey(userId))
	end)
	return ok and type(v) == "table" and type(v.Seed) == "number" and v or nil
end

---------------------------------------------------------------- โลกที่สร้าง (จ่ายต่อ 1 โลก · WorldService)
-- รายชื่อโลกอยู่ในโปรไฟล์ data.Worlds[id] = { Name, Night, Created } · ตัวโลก (แมพ/แคมป์/ของ) เก็บแยกคีย์ "world_<UserId>_<id>"
local function worldKey(userId, id)
	return "world_" .. userId .. "_" .. id
end

-- ส่งรายชื่อโลกให้เมนู Worlds (attribute MyWorlds = JSON)
function DataService:PushWorlds(player)
	local data = profiles[player]
	if not data then
		return
	end
	local list = {}
	for id, w in pairs(type(data.Worlds) == "table" and data.Worlds or {}) do
		table.insert(list, { Id = id, Name = w.Name, Night = w.Night or 1, Created = w.Created or 0 })
	end
	table.sort(list, function(a, b)
		return a.Created < b.Created
	end)
	player:SetAttribute("MyWorlds", game:GetService("HttpService"):JSONEncode(list))
	player:SetAttribute("WorldCredits", data.WorldCredits or 0)
end

function DataService:SaveWorld(player, id, run)
	local data = profiles[player]
	if not (storeOk and data and type(data.Worlds) == "table" and data.Worlds[id]) then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(worldKey(player.UserId, id), run)
	end)
	if not ok then
		warn("[AS] save world:", err)
		return false
	end
	data.Worlds[id].Night = run.Night
	self:PushWorlds(player)
	return true
end

function DataService:LoadWorld(userId, id)
	if not storeOk then
		return nil
	end
	local ok, v = pcall(function()
		return store:GetAsync(worldKey(userId, id))
	end)
	return ok and type(v) == "table" and type(v.Seed) == "number" and v or nil
end

-- ลบโลก (ทีมตายหมดในโลก / เจ้าของกดลบ)
function DataService:DeleteWorld(player, id)
	local data = profiles[player]
	if data and type(data.Worlds) == "table" then
		data.Worlds[id] = nil
	end
	if storeOk then
		pcall(function()
			store:RemoveAsync(worldKey(player.UserId, id))
		end)
	end
	self:PushWorlds(player)
	task.spawn(self.Save, self, player)
end

---------------------------------------------------------------- ของขวัญ Ruby (dev ส่งให้ tester)
-- เก็บแยกคีย์ "gift_<UserId>" (ไม่แตะเซฟหลักของคนรับ -> ไม่โดนเซฟของเซิร์ฟอื่นเขียนทับ)
-- คนรับอยู่เซิร์ฟไหนก็ได้/ออฟไลน์: รับตอนเข้าเกม · ออนไลน์อยู่ = MessagingService แจ้งให้เซิร์ฟนั้นรับทันที
local GIFT_TOPIC = "ASGift"
local function giftKey(userId)
	return "gift_" .. userId
end

function DataService:QueueGift(userId, n, from)
	if not storeOk then
		return false, "DataStore unavailable (enable API Services first)"
	end
	local ok, err = pcall(function()
		store:UpdateAsync(giftKey(userId), function(old)
			old = type(old) == "table" and old or {}
			old.Diamonds = (old.Diamonds or 0) + n
			old.From = from
			return old
		end)
	end)
	if ok then
		pcall(MessagingService.PublishAsync, MessagingService, GIFT_TOPIC, userId)
	end
	return ok, err
end

-- รับของขวัญที่ค้างอยู่ (เข้าเกม / มีข้อความแจ้งจากเซิร์ฟอื่น) แล้วเซฟทันที
function DataService:ClaimGifts(player)
	if not (storeOk and profiles[player] and player.UserId > 0) then
		return
	end
	local got, from = 0, nil
	local ok = pcall(function()
		store:UpdateAsync(giftKey(player.UserId), function(old)
			got, from = 0, nil
			if type(old) ~= "table" or (old.Diamonds or 0) <= 0 then
				return nil
			end
			got, from = old.Diamonds, old.From
			return { Diamonds = 0 }
		end)
	end)
	if ok and got > 0 and player.Parent then
		self:AddDiamonds(player, got, "Gift from " .. tostring(from or "the team"), { Flat = true })
		self:Save(player)
	end
end

-- opts.Purchased = Ruby ที่ซื้อด้วย Robux (ไม่คูณ VIP) · opts.Flat = จำนวนตายตัว เช่นโค้ด (ไม่คูณ VIP/โบนัสเพื่อน)
function DataService:AddDiamonds(player, n, reason, opts)
	local data = profiles[player]
	if not data then
		return
	end
	local shop = self.ctx.Services.MonetizationService
	if not (opts and (opts.Purchased or opts.Flat)) and n > 0 and shop and shop:HasPass(player, "VIP") then
		n *= 2
		reason = (reason or "") .. " · VIP x2"
	end
	-- เล่นกับเพื่อน Roblox ในรอบเดียวกัน: +10% (FriendService)
	local friends = self.ctx.Services.FriendService
	if not (opts and (opts.Purchased or opts.Flat)) and n > 0 and friends then
		local extra = friends:Extra(player, n)
		if extra > 0 then
			n += extra
			reason = (reason or "") .. " · Friends +10%"
		end
	end
	data.Diamonds += n
	player:SetAttribute("Diamonds", data.Diamonds)
	self.ctx.Notify(player, string.format("♦️ +%d Ruby  (%s)", n, reason or ""), "Reward")
	self.ctx.Remotes.Get("Profile"):FireClient(player, data)
end

function DataService:Start(ctx)
	local Remotes = ctx.Remotes
	-- ของขวัญจากเซิร์ฟอื่น: ถ้าคนรับอยู่เซิร์ฟนี้ -> รับเลย
	--   SubscribeAsync รอเน็ตได้นาน (Studio ค้างหลายนาที) -> ทำเบื้องหลัง ไม่ให้บล็อกการเริ่มระบบอื่น
	task.spawn(pcall, function()
		MessagingService:SubscribeAsync(GIFT_TOPIC, function(msg)
			local p = Players:GetPlayerByUserId(tonumber(msg.Data) or 0)
			if p then
				self:ClaimGifts(p)
			end
		end)
	end)
	Remotes.Get("GetProfile").OnServerInvoke = function(player)
		return profiles[player]
	end
	Remotes.Get("BuyClass").OnServerEvent:Connect(function(player, classId)
		local data = profiles[player]
		local c = Classes.Data[classId]
		if not (data and c) or data.Owned[classId] then
			return
		end
		if c.Pass or c.SeasonReward then
			return -- คลาสพาส: ปลดด้วย Game Pass (MonetizationService) · คลาสซีซั่น: กดรับขั้นสุดท้ายของ Season Pass เท่านั้น
		end
		self:EnsureStock(data)
		if not Classes.Stock(data.StockDay, data.StockRoll, player.UserId)[classId] then
			ctx.Notify(player, "This class isn't in stock today — wait for restock or reroll", "Error")
			return
		end
		if data.Diamonds < c.Price then
			ctx.Notify(player, "♦️ Not enough Ruby", "Error")
			return
		end
		data.Diamonds -= c.Price
		data.Owned[classId] = true
		player:SetAttribute("Diamonds", data.Diamonds)
		ctx.Notify(player, "Unlocked class " .. c.Thai .. "!", "Reward")
		Remotes.Get("Profile"):FireClient(player, data)
		self:Save(player)
	end)
	Remotes.Get("ChooseClass").OnServerEvent:Connect(function(player, classId)
		local data = profiles[player]
		if not (data and Classes.Data[classId] and data.Owned[classId]) then
			return
		end
		-- เปลี่ยนคลาสได้เฉพาะในล็อบบี้ (กลางรอบเปลี่ยนแล้วได้สกิลคลาสใหม่แต่ไม่ได้ของเริ่มต้น)
		if player:GetAttribute("InRun") then
			return
		end
		data.Class = classId
		player:SetAttribute("Class", classId)
		player:SetAttribute("ClassLevel", data.ClassLevel[classId] or 1)
		ctx.Services.SurvivalService:OnClassChosen(player, classId)
		Remotes.Get("Profile"):FireClient(player, data)
	end)
	Remotes.Get("RerollStock").OnServerEvent:Connect(function(player)
		local data = profiles[player]
		if not data or player:GetAttribute("InRun") then
			return
		end
		if data.Diamonds < Classes.RerollPrice then
			ctx.Notify(player, "♦️ Not enough Ruby to reroll the stock", "Error")
			return
		end
		self:EnsureStock(data)
		data.Diamonds -= Classes.RerollPrice
		data.StockRoll += 1
		ctx.Notify(player, "🎲 Class shop stock rerolled", "Info")
		self:Push(player)
	end)
	Remotes.Get("SkipClassLevel").OnServerEvent:Connect(function(player, classId)
		local data = profiles[player]
		local c = Classes.Data[classId]
		if not (data and c and data.Owned[classId]) then
			return
		end
		local level = data.ClassLevel[classId] or 1
		if level >= Classes.MaxLevel then
			return
		end
		local price = Classes.SkipPrice(classId, level + 1)
		if data.Diamonds < price then
			ctx.Notify(player, "♦️ Not enough Ruby to skip a level", "Error")
			return
		end
		data.Diamonds -= price
		ctx.Notify(player, string.format("⭐ %s level %d!", c.Thai, level + 1), "Reward")
		self:SetClassLevel(player, classId, level + 1)
		self:Save(player)
	end)
	Remotes.Get("ClaimDaily").OnServerEvent:Connect(function(player)
		self:ClaimDaily(player)
	end)
	-- การตั้งค่า (เสียง/กราฟิก/ปุ่มมือถือ): เก็บเฉพาะค่าง่ายๆ ชื่อสั้นๆ
	Remotes.Get("SaveSettings").OnServerEvent:Connect(function(player, settings)
		local data = profiles[player]
		if not data or type(settings) ~= "table" then
			return
		end
		local clean, n = {}, 0
		for k, v in pairs(settings) do
			local tv = type(v)
			if type(k) == "string" and #k <= 24 and (tv == "number" or tv == "boolean" or (tv == "string" and #v <= 24)) then
				clean[k] = v
				n += 1
				if n >= 40 then
					break
				end
			end
		end
		data.Settings = clean
	end)
	Remotes.Get("TutorialDone").OnServerEvent:Connect(function(player)
		local data = profiles[player]
		if data and not data.TutorialSeen then
			data.TutorialSeen = true
			self:Save(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:Save(player, true)
		profiles[player] = nil
	end)
	-- เซิร์ฟปิด: เซฟทุกคนพร้อมกัน (ไม่ทีละคน) แล้วรอให้ครบก่อนปิด (Roblox ให้เวลา ~30 วิ)
	game:BindToClose(function()
		local left = 0
		for _, p in ipairs(Players:GetPlayers()) do
			left += 1
			task.spawn(function()
				pcall(self.Save, self, p, true)
				left -= 1
			end)
		end
		local t0 = os.clock()
		while left > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in ipairs(Players:GetPlayers()) do
				self:Save(p)
				self:CheckBadges(p)
			end
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000063"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--[[
	DevService — เครื่องมือนักพัฒนา (เปิดด้วย F8 หรือปุ่ม DEV มุมจอ)
	ใช้ได้เฉพาะ: ใน Roblox Studio / เจ้าของเกม / UserId ใน Config.DevUserIds (เช็กฝั่ง server ทุกคำสั่ง)
	client เรียก Remotes "DevCmd" (RemoteFunction): (action, arg1, arg2) -> ข้อความผลลัพธ์
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Animals = require(Shared.Animals)
local Items = require(Shared.Items)
local Classes = require(Shared.Classes)
local Config = require(Shared.Config)
local Nights = require(Shared.Nights)
local Recipes = require(Shared.Recipes)

local DevService = {}

function DevService:Init(ctx)
	self.ctx = ctx
end

function DevService:IsDev(player)
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok and rank >= 254 then
			return true
		end
	end
	return table.find(Config.DevUserIds or {}, player.UserId) ~= nil
end

local function rootOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

-- จุดบนพื้นด้านหน้าผู้เล่น
function DevService:FrontGround(player, dist)
	local root = rootOf(player)
	if not root then
		return nil
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local p = root.Position + look * dist
	local h = self.ctx.Layout and self.ctx.Layout:HeightAt(p.X, p.Z) or p.Y
	return Vector3.new(p.X, math.max(h, Config.WaterLevel) + 3, p.Z)
end

function DevService:Teleport(player, pos)
	local root = rootOf(player)
	if not (root and pos) then
		return "No character"
	end
	local y = pos.Y
	if self.ctx.Layout and pos.Y < 1000 then
		y = math.max(self.ctx.Layout:HeightAt(pos.X, pos.Z), Config.WaterLevel) + 6
	end
	pcall(function()
		player:RequestStreamAroundAsync(Vector3.new(pos.X, y, pos.Z), 5)
	end)
	-- หาพื้นจริง (Terrain + สิ่งก่อสร้าง) ด้วยการยิงลงจากฟ้า -> ไม่วาร์ปจมดิน/ตกแมพ
	if pos.Y < 1000 then
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		local ex = { player.Character }
		local an = workspace:FindFirstChild("Animals")
		if an then
			table.insert(ex, an)
		end
		rp.FilterDescendantsInstances = ex
		local hit = workspace:Raycast(Vector3.new(pos.X, y + 600, pos.Z), Vector3.new(0, -1400, 0), rp)
		if hit then
			y = math.max(hit.Position.Y, Config.WaterLevel) + 4
		end
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = CFrame.new(pos.X, y, pos.Z)
	return "Teleported"
end

---------------------------------------------------------------- คำสั่งทั้งหมด
local C = {}

-- ผู้เล่น
function C.god(self, p)
	local on = not p:GetAttribute("TestGod")
	p:SetAttribute("TestGod", on)
	return on and "🛡 God mode: ON" or "🛡 God mode: OFF"
end

function C.heal(self, p)
	local _, hum = rootOf(p)
	if hum then
		hum.Health = hum.MaxHealth
	end
	p:SetAttribute("Hunger", Config.HungerMax)
	if p:GetAttribute("Downed") then
		self.ctx.Services.SurvivalService:Revive(p, 1)
	end
	return "❤ HP/hunger full"
end

function C.speed(self, p, mult)
	mult = math.clamp(tonumber(mult) or 1, 0.5, 6)
	p:SetAttribute("DevSpeed", mult)
	return string.format("🏃 Speed x%.1f", mult)
end

function C.respawn(self, p)
	self.ctx.Services.SurvivalService:Spawn(p)
	return "Respawned"
end

function C.depart(self, p)
	if p:GetAttribute("InRun") then
		return "Already in the map"
	end
	if not self.ctx.State:GetAttribute("Ready") then
		return "The world isn't finished generating yet"
	end
	self.ctx.Services.LobbyService:Depart(p)
	return "🧭 Entered the map"
end

function C.lobby(self, p)
	self.ctx.Services.SurvivalService:ResetPlayer(p)
	self.ctx.Services.SurvivalService:CheckWipe()
	return "Back to lobby"
end

-- วาร์ป
function C.tp(self, p, target)
	local s = self.ctx.State
	if target ~= "camp" then
		p:SetAttribute("FogPass", true) -- วาร์ปไกล: ทะลุกำแพงหมอกให้อัตโนมัติ
	end
	if target == "camp" then
		local cp = self.ctx.CampPosition or s:GetAttribute("CampPos")
		return self:Teleport(p, cp + Vector3.new(10, 0, 10))
	elseif target == "front" then
		return self:Teleport(p, self:FrontGround(p, 120))
	end
	local pos = s:GetAttribute(target)
	if typeof(pos) ~= "Vector3" then
		return "Destination not found: " .. tostring(target)
	end
	if not p:GetAttribute("InRun") then
		return "Enter the map first (Enter Map button)"
	end
	return self:Teleport(p, pos + Vector3.new(14, 0, 14))
end

-- ไอเทม
function C.give(self, p, id, n)
	if not Items.Data[id] then
		return "No item: " .. tostring(id)
	end
	self.ctx.Services.InventoryService:Add(p, id, tonumber(n) or 1, true)
	return "🎁 Got " .. Items.DisplayName(id) .. " x" .. (tonumber(n) or 1)
end

function C.giveCategory(self, p, cat, n)
	local inv = self.ctx.Services.InventoryService
	local count = 0
	for id, d in pairs(Items.Data) do
		if d.Category == cat then
			inv:Add(p, id, tonumber(n) or 1, true)
			count += 1
		end
	end
	return string.format("🎁 Got all %s: %d items", cat, count)
end

function C.clearInv(self, p)
	self.ctx.Services.InventoryService:Reset(p)
	return "🗑 Bag cleared"
end

-- เรียกบอส (เฉพาะตัวที่มีโมเดลแล้วใน assets/rbxm/Animals)
function C.spawnBoss(self, p, id)
	local info = Animals.Data[id]
	if not info then
		return "Unknown: " .. tostring(id)
	end
	local a = self.ctx.Services.AnimalService:Spawn(id, self:FrontGround(p, 70), { Kind = "Boss", Night = self.ctx.State:GetAttribute("Night") or 1 })
	if not a then
		return "No model yet for " .. info.Thai
	end
	a.Model:SetAttribute("IsBoss", true)
	local s = self.ctx.State
	s:SetAttribute("BossId", id)
	s:SetAttribute("BossHP", a.Hum.MaxHealth)
	s:SetAttribute("BossMaxHP", a.Hum.MaxHealth)
	self.ctx.Services.AnimalService:BeginIntro(a) -- ฉากเปิดตัว: ตรึงไว้ ~7 วิ
	self.ctx.FireRun("Cinematic", "BossIntro", { Model = a.Model, Id = id, Name = info.Name, Thai = info.Thai, Element = info.Element })
	return "👑 Summoned " .. info.Thai
end

-- ลบสัตว์/บอสทั้งหมดในแมพ
function C.clearAnimals(self)
	local animals = self.ctx.Services.AnimalService
	for _, a in ipairs(table.clone(animals:All())) do
		animals:Remove(a)
	end
	self.ctx.State:SetAttribute("BossId", "")
	return "🧹 Removed all animals"
end

function C.skip(self)
	local dir = self.ctx.Services.DirectorService
	if not dir:IsRunning() then
		return "The run hasn't started (enter the map first)"
	end
	dir.skip = true
	return "⏭ Skipped phase " .. tostring(self.ctx.State:GetAttribute("Phase"))
end

function C.pause(self)
	local dir = self.ctx.Services.DirectorService
	dir.paused = not dir.paused
	return dir.paused and "⏸ Time paused" or "▶ Time resumed"
end

function C.setNight(self, _, n)
	local dir = self.ctx.Services.DirectorService
	n = math.clamp(math.floor(tonumber(n) or 1), 1, Config.TotalNights)
	dir.night = n -- กลางคืน: มีผลหลังจบคืนนี้ (Loop ใช้เลขนี้เป็นวันถัดไป)
	self.ctx.State:SetAttribute("Night", n)
	local boss = Nights.BossNights and Nights.BossNights[n]
	return string.format("🌙 Set to night %d%s", n, boss and (" (boss night: " .. boss .. ")") or "")
end

function C.nightNow(self)
	local dir = self.ctx.Services.DirectorService
	if not dir:IsRunning() then
		return "The run hasn't started (enter the map first)"
	end
	local phase = self.ctx.State:GetAttribute("Phase")
	if phase == "Day" then
		dir.skip = true
		task.delay(0.6, function()
			dir.skip = true
		end)
	elseif phase == "Dusk" then
		dir.skip = true
	end
	return "🌙 Skipping to night"
end

function C.bloodMoon(self)
	local s = self.ctx.State
	s:SetAttribute("BloodMoon", not s:GetAttribute("BloodMoon"))
	return s:GetAttribute("BloodMoon") and "🔴 Blood Moon: ON" or "Blood Moon: OFF"
end

-- แคมป์
function C.fuel(self)
	local camp = self.ctx.Services.CampService
	camp:AddFuel(1e6)
	return "🔥 Fuel filled"
end

function C.extinguish(self)
	local camp = self.ctx.Services.CampService
	camp:AddFuel(-1e6)
	return "💨 Campfire put out"
end

function C.fireLevel(self, _, d)
	local camp = self.ctx.Services.CampService
	camp.level = math.clamp(camp.level + (tonumber(d) or 1), 1, #Recipes.Campfire)
	camp.fuel = camp:Info().MaxFuel
	camp:UpdateVisual()
	camp:Publish()
	camp:RefreshPrompts()
	return "🔥 Campfire level " .. camp.level
end

function C.fogPass(self, p)
	local on = not p:GetAttribute("FogPass")
	p:SetAttribute("FogPass", on)
	return on and "🌫 Pass through fog wall: ON" or "🌫 Pass through fog wall: OFF"
end

function C.benchLevel(self, _, d)
	local camp = self.ctx.Services.CampService
	local max = 1
	for k in pairs(Recipes.BenchUpgrade) do
		max = math.max(max, k)
	end
	camp.bench = math.clamp(camp.bench + (tonumber(d) or 1), 1, max)
	camp:Publish()
	camp:RefreshPrompts()
	return "🔨 Crafting bench level " .. camp.bench
end

-- โปรไฟล์ / ร้าน
function C.diamonds(self, p, n)
	self.ctx.Services.DataService:AddDiamonds(p, tonumber(n) or 1000, "DEV")
	return "♦️ +" .. (tonumber(n) or 1000)
end

-- ส่ง Ruby ให้คนอื่น: target = ชื่อ/ชื่อที่แสดง/UserId · "*" = ทุกคนในเซิร์ฟ (ยกเว้นตัวเอง)
--   อยู่เซิร์ฟนี้ = ได้ทันที · ไม่อยู่ = เก็บเป็นของขวัญ ได้ตอนเข้าเกม (หรือทันทีถ้าออนไลน์เซิร์ฟอื่น)
function C.giftDiamonds(self, p, target, n)
	local data = self.ctx.Services.DataService
	n = math.floor(tonumber(n) or 0)
	if n <= 0 or n > 1000000 then
		return "❌ Amount must be 1 - 1,000,000"
	end
	target = tostring(target or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if target == "" then
		return "❌ Enter the recipient's name or UserId first"
	end
	local from = p.DisplayName
	if target == "*" then
		local names = {}
		for _, o in ipairs(Players:GetPlayers()) do
			if o ~= p then
				data:AddDiamonds(o, n, "Gift from " .. from, { Flat = true })
				data:Save(o)
				table.insert(names, o.Name)
			end
		end
		return #names > 0 and string.format("Sent %d Ruby to %d players: %s", n, #names, table.concat(names, ", ")) or "❌ No other players in this server"
	end
	local low = target:lower()
	for _, o in ipairs(Players:GetPlayers()) do
		if o.Name:lower() == low or o.DisplayName:lower() == low or tostring(o.UserId) == target then
			data:AddDiamonds(o, n, "Gift from " .. from, { Flat = true })
			data:Save(o)
			return string.format("Sent %d Ruby to %s (in this server)", n, o.Name)
		end
	end
	local uid = tonumber(target)
	local name = target
	if not uid then
		local ok, res = pcall(Players.GetUserIdFromNameAsync, Players, target)
		if not ok or not res then
			return "❌ No player named " .. target .. " (use the username, not the display name, or enter a UserId)"
		end
		uid = res
	else
		local ok, res = pcall(Players.GetNameFromUserIdAsync, Players, uid)
		name = ok and res or tostring(uid)
	end
	local ok, err = data:QueueGift(uid, n, from)
	if not ok then
		return "❌ Send failed: " .. tostring(err)
	end
	return string.format("Sent %d Ruby to %s · they get it when they join", n, name)
end

function C.unlockAll(self, p)
	local ds = self.ctx.Services.DataService
	local d = ds:Get(p)
	if not d then
		return "No profile"
	end
	for _, id in ipairs(Classes.Order) do
		d.Owned[id] = true
	end
	ds:Push(p)
	return "🔓 Unlocked all classes"
end

function C.maxClass(self, p)
	local ds = self.ctx.Services.DataService
	local cls = p:GetAttribute("Class") or "Survivor"
	ds:SetClassLevel(p, cls, Classes.MaxLevel)
	return "⭐ " .. Classes.Data[cls].Thai .. " max level"
end

function C.resetDaily(self, p)
	local ds = self.ctx.Services.DataService
	local d = ds:Get(p)
	if d then
		d.LastDaily = -1
		d.StockRoll = (d.StockRoll or 0) + 1
		ds:Push(p)
	end
	return "🔄 Reset daily reward + rerolled stock"
end

function C.resetProfile(self, p)
	local ds = self.ctx.Services.DataService
	local d = ds:Get(p)
	if d then
		d.Diamonds = 0
		d.Owned = { Survivor = true }
		d.Class = "Survivor"
		d.ClassLevel = {}
		d.ClassStats = {}
		d.PendingKits = {}
		p:SetAttribute("Class", "Survivor")
		p:SetAttribute("ClassLevel", 1)
		ds:Push(p)
	end
	return "♻ Reset profile (Ruby/classes)"
end

-- ข้อมูลสถานะ
function C.info(self, p)
	local s = self.ctx.State
	local animals = self.ctx.Services.AnimalService
	local root = rootOf(p)
	local biome = "-"
	if root and self.ctx.Layout and root.Position.Y < 1000 then
		biome = self.ctx.Layout:BiomeAt(root.Position.X, root.Position.Z)
	end
	return string.format("Phase %s · Night %d · %d animals · Biome %s · Position %s",
		tostring(s:GetAttribute("Phase")), s:GetAttribute("Night") or 0, #animals:All(), tostring(biome),
		root and string.format("%d,%d,%d", root.Position.X, root.Position.Y, root.Position.Z) or "-")
end

function DevService:Start(ctx)
	local rf = ctx.Remotes.Get("DevCmd")
	rf.OnServerInvoke = function(player, action, a, b)
		if not self:IsDev(player) then
			return "⛔ You don't have permission to use developer tools"
		end
		local fn = C[action]
		if not fn then
			return "Unknown command " .. tostring(action)
		end
		local ok, res = pcall(fn, self, player, a, b)
		if not ok then
			warn("[AS] dev", action, res)
			return "❌ " .. tostring(res)
		end
		return res
	end
	local function mark(p)
		p:SetAttribute("IsDev", self:IsDev(p))
	end
	Players.PlayerAdded:Connect(mark)
	for _, p in ipairs(Players:GetPlayers()) do
		mark(p)
	end
end

return DevService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000064"><Properties><string name="Name">DirectorService</string><ProtectedString name="Source"><![CDATA[--[[
	DirectorService — ผู้กำกับ 99 คืน
	  กลางวัน (สำรวจ/เก็บของ) -> พลบค่ำ (เตือน) -> กลางคืน (ฝูงบุกเป็นระลอก + กวางกลวง + บอส) -> เช้า
	  รอดครบ 99 คืน = ฉากจบ (ช่วยลูกสัตว์ธาตุครบ 4 = จบแบบสมบูรณ์)
	  ข้ามวัน (เตียง 2 + ศาลเจ้า 4 = +6): บวกจริงทุกครั้ง · คืนที่ถูกข้ามนับว่ารอด · บอส/คืนบุกใหญ่ของคืนนั้นย้ายมาคืนถัดไป · คืน 99 ข้ามไม่ได้
	  ทุกคนตาย = YOU PERISHED -> เริ่มรอบใหม่
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Animals = require(ReplicatedStorage.Shared.Animals)
local AnimalModels = require(ReplicatedStorage.Shared.AnimalModels)
local Classes = require(ReplicatedStorage.Shared.Classes)
local Analytics = require(script.Parent.Analytics)

local DirectorService = {}

local ELEMENT_THAI = { Earth = "Earth", Water = "Water", Air = "Frost", Fire = "Fire", All = "All Elements" }

function DirectorService:Init(ctx)
	self.ctx = ctx
	self.running = false
	self.rng = Random.new(ctx.Seed + 99)
	self.runId = 0
	self.night = 1
	self.lastElement = nil
	self.pendingSkips = 0 -- สิทธิ์ข้ามวันที่รอบวกตอนเช้า (ใช้ตอนกลางคืน / คืน 99)
	self.carry = {} -- เหตุการณ์ของคืนที่ถูกข้าม รอลงคืนถัดไปที่เล่นจริง
	self.bonus = 0 -- เวลากลางวันที่ได้เพิ่ม (เข้าศาลเจ้า/วิหาร) รอบวกในลูป Wait
	self.pendingBonus = 0 -- ได้ตอนกลางคืน -> บวกให้กลางวันถัดไป
end

-- เวลาเพิ่ม (วินาที): กลางวัน/พลบค่ำ = ยืดออกไปทันที · กลางคืน = เก็บไว้บวกให้กลางวันถัดไป
function DirectorService:AddTime(seconds)
	if not self.running then
		return false
	end
	local phase = self.ctx.State:GetAttribute("Phase")
	if phase == "Day" or phase == "Dusk" then
		self.bonus += seconds
		return "now"
	end
	self.pendingBonus += seconds
	return "nextDay"
end

function DirectorService:SetPhase(phase, length)
	local s = self.ctx.State
	local now = Workspace:GetServerTimeNow()
	s:SetAttribute("Phase", phase)
	s:SetAttribute("PhaseStart", now)
	s:SetAttribute("PhaseEnd", now + (length or 0))
	s:SetAttribute("PhaseLength", length or 0)
end

-- รอแบบยกเลิกได้ (ถ้าเริ่มรอบใหม่)
function DirectorService:Wait(seconds, runId)
	local t = 0
	while t < seconds do
		local dt = task.wait(0.25)
		if runId ~= self.runId then
			return false
		end
		if self.skip then -- DEV: ข้ามช่วงนี้
			self.skip = false
			self.skipped = true
			return true
		end
		if self.bonus > 0 then -- เข้าศาลเจ้า/วิหาร: ยืดเวลาช่วงนี้ (นาฬิกาบนจอขยับตาม)
			local s = self.ctx.State
			seconds += self.bonus
			s:SetAttribute("PhaseEnd", (s:GetAttribute("PhaseEnd") or 0) + self.bonus)
			s:SetAttribute("PhaseLength", (s:GetAttribute("PhaseLength") or 0) + self.bonus)
			self.bonus = 0
		end
		if self.paused then -- DEV: หยุดเวลา (เลื่อนเวลาสิ้นสุดช่วงออกไปด้วย ให้นาฬิกาบนจอหยุด)
			local s = self.ctx.State
			s:SetAttribute("PhaseStart", (s:GetAttribute("PhaseStart") or 0) + dt)
			s:SetAttribute("PhaseEnd", (s:GetAttribute("PhaseEnd") or 0) + dt)
		else
			t += dt
		end
	end
	return true
end

function DirectorService:SpawnRaid(id, plan, night)
	local layout = self.ctx.Layout
	local animals = self.ctx.Services.AnimalService
	local info = Animals.Data[id]
	local element = info.Element
	local pos = layout:RaidSpawnPoint(self.rng, Config.RaidSpawnRadius.Min, Config.RaidSpawnRadius.Max, element)
	local scale = Nights.Scale(night)
	if info.Behaviour == "Boss" then
		-- เลือดบอสเพิ่มตามจำนวนคนที่ยังรอดในรอบ (1 คน = x1.0 · +50% ต่อคนที่เพิ่ม) · คืนปกติไม่เพิ่มตามคืน (โหมดไม่รู้จบหลังคืน 99 ค่อยถึกขึ้น)
		local players = self.ctx.Services.SurvivalService:RunPlayerCount(true)
		local a = animals:Spawn(id, pos, {
			Kind = "Boss", HealthMult = Nights.BossHealthMult(players), DamageMult = Nights.BossDamageMult(players), Night = night,
		})
		if a then
			a.Model:SetAttribute("IsBoss", true)
			local s = self.ctx.State
			s:SetAttribute("BossId", id)
			s:SetAttribute("BossHP", a.Hum.MaxHealth)
			s:SetAttribute("BossMaxHP", a.Hum.MaxHealth)
			animals:BeginIntro(a) -- ฉากเปิดตัว: ตรึงไว้ ~7 วิ
			self.ctx.FireRun("Cinematic", "BossIntro", { Model = a.Model, Id = id, Name = info.Name, Thai = info.Thai, Element = info.Element })
		end
		return a
	end
	return animals:Spawn(id, pos, {
		Kind = "Raid", HealthMult = scale.Health, DamageMult = scale.Damage, SpeedMult = scale.Speed, Night = night,
	})
end

function DirectorService:RunNight(night, runId)
	local ctx = self.ctx
	local s = ctx.State
	local element = Nights.PickElement(night, self.rng, self.lastElement)
	self.lastElement = element
	-- งบฝูงบุกคูณตามจำนวนคนที่ยังรอดในรอบ (Nights.PlayerBudgetMult) — เพดาน Config.MaxRaidAnimals เท่าเดิม
	local players = ctx.Services.SurvivalService:RunPlayerCount(true)
	local plan = Nights.Plan(night, self.rng, element, players, self.carry)
	s:SetAttribute("NightElement", plan.Element)
	s:SetAttribute("BloodMoon", plan.BloodMoon)
	self:SetPhase("Night", Config.NightLength)
	local title = Nights.Named[plan.OriginNight or night] or ((plan.BigRaid and "Big Raid Night · " or "") .. "Night of " .. (ELEMENT_THAI[plan.Element] or ""))
	if Nights.IsEndless(night) then
		title = "♾ Endless · " .. title
	end
	ctx.FireRun("Cinematic", "NightStart", {
		Night = night, Element = plan.Element, BloodMoon = plan.BloodMoon, Boss = plan.Boss, Title = title, Endless = Nights.IsEndless(night),
		Elements = plan.Elements,
	})
	-- ฝูงบุกเฉพาะคืนบุกใหญ่ (ทุก 5 คืน + คืน 99) · คืนอื่นสงบ: บอกว่าอีกกี่คืนฝูงจะมา
	local played = self.played or night
	if not plan.BigRaid then
		local left = Nights.NextBigRaid(played) - played
		task.delay(6, function()
			if runId == self.runId then
				ctx.Broadcast(string.format("Big raid in %d nights", left), "Info")
			end
		end)
	end
	s:SetAttribute("NextRaidNight", night + (Nights.NextBigRaid(played + (plan.BigRaid and 1 or 0)) - played)) -- (โดยประมาณ ถ้าไม่มีตัวคูณวัน)
	local total = 0
	for _, w in ipairs(plan.Waves) do
		total += #w.Spawns
	end
	s:SetAttribute("RaidTotal", total)

	-- จิ้งจอกจันทราออกล่า (เตือนทุกคนในรอบล่วงหน้า 5 วินาที: ขอบจอแดง + ป้าย + เสียง)
	local stalkerAt = Config.NightLength * 0.12
	local warnAt = math.max(0.5, stalkerAt - 5)
	task.delay(warnAt, function()
		if runId ~= self.runId or s:GetAttribute("Phase") ~= "Night" or ctx.Services.AnimalService:CountKind("Stalker") > 0 or not AnimalModels.Has("Moonfang") then
			return -- (ยังไม่มีโมเดลจิ้งจอก = ไม่เตือนหลอก)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
				ctx.Remotes.Get("Cinematic"):FireClient(p, "StalkerWarning", { In = math.max(0, stalkerAt - warnAt) })
			end
		end
	end)
	task.delay(stalkerAt, function()
		if runId ~= self.runId or s:GetAttribute("Phase") ~= "Night" then
			return
		end
		local animals = ctx.Services.AnimalService
		if animals:CountKind("Stalker") == 0 then
			local pos = ctx.Layout:RaidSpawnPoint(self.rng, 260, 340)
			if animals:Spawn("Moonfang", pos, { Kind = "Stalker" }) then
				ctx.Broadcast("Something is watching from the darkness", "Danger")
			end
		end
	end)

	-- ปล่อยฝูงเป็นระลอก
	self.nightBoss = nil
	for wi, wave in ipairs(plan.Waves) do
		task.delay(Config.NightLength * wave.At, function()
			if runId ~= self.runId or s:GetAttribute("Phase") ~= "Night" or #wave.Spawns == 0 then
				return
			end
			if not wave.Boss then
				ctx.Broadcast(string.format("Animal wave %d has arrived", wi), "Danger")
				ctx.FireRun("Cinematic", "WaveIncoming", { Wave = wi, Element = plan.Element })
			end
			for i, id in ipairs(wave.Spawns) do
				if runId ~= self.runId or s:GetAttribute("Phase") ~= "Night" then
					return
				end
				-- (บอสไม่ต้องรอคิวเพดานฝูง)
				while not wave.Boss and ctx.Services.AnimalService.raidCount >= Nights.MaxRaid(Config.MaxRaidAnimals, ctx.Services.SurvivalService:RunPlayerCount(true)) do
					task.wait(1)
					if runId ~= self.runId or s:GetAttribute("Phase") ~= "Night" then
						return
					end
				end
				local a = self:SpawnRaid(id, plan, night)
				if wave.Boss then
					self.nightBoss = a
				end
				if i % 3 == 0 then
					task.wait(0.4)
				end
			end
		end)
	end
	if not plan.Boss then
		return self:Wait(Config.NightLength, runId)
	end
	-- คืนบอส: ใกล้เช้าแล้วบอสยังไม่ตาย -> หยุดนาฬิกาไว้ก่อน (ท้องฟ้าไม่เริ่มสว่าง) ให้มีเวลาฆ่าทัน
	local holdAt = Config.NightLength * 0.85
	self.skipped = false
	if not self:Wait(holdAt, runId) then
		return false
	end
	if self.skipped then
		return true
	end
	if not self:HoldForBoss(runId) then
		return false
	end
	if self.skipped then
		return true
	end
	return self:Wait(Config.NightLength - holdAt, runId)
end

-- หยุดนาฬิกาจนบอสตาย หรือครบ Config.BossHoldMax
function DirectorService:HoldForBoss(runId)
	local boss = self.nightBoss
	if not boss or boss.Dead or boss.Removed then
		return true
	end
	local s = self.ctx.State
	local left = Config.BossHoldMax
	s:SetAttribute("BossHoldEnd", Workspace:GetServerTimeNow() + left)
	self.ctx.Broadcast("The boss is still alive — dawn is held back!", "Danger")
	while left > 0 and not boss.Dead and not boss.Removed do
		local dt = task.wait(0.25)
		if runId ~= self.runId then
			return false
		end
		if self.skip then
			self.skip = false
			self.skipped = true
			break
		end
		s:SetAttribute("PhaseStart", (s:GetAttribute("PhaseStart") or 0) + dt)
		s:SetAttribute("PhaseEnd", (s:GetAttribute("PhaseEnd") or 0) + dt)
		if self.paused then
			s:SetAttribute("BossHoldEnd", s:GetAttribute("BossHoldEnd") + dt)
		else
			left -= dt
		end
	end
	s:SetAttribute("BossHoldEnd", 0)
	return true
end

-- รางวัลรอดคืนนี้: เฉพาะคนที่ยังรอดอยู่ในรอบ (คนที่ตายแล้วไม่ได้ และไม่ได้เกิดใหม่)
function DirectorService:RewardNight(night)
	local ctx = self.ctx
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
			local data = ctx.Services.DataService:Get(p)
			if data then
				ctx.Services.DataService:SetBestNight(p, night)
				data.NightsTotal = (data.NightsTotal or 0) + 1
				ctx.Services.DataService:AddClassStat(p, "Nights", 1)
				Analytics.NightReached(p, night)
				if ctx.Services.QuestService then
					ctx.Services.QuestService:Progress(p, "Night", 1, night)
				end
			end
			-- Ruby รอดคืน (คืนละ 1 / คืนพิเศษ Classes.NightRewards / โหมดไร้ขีดจำกัด) ปิดไว้ทั้งหมด
		end
	end
end

function DirectorService:Dawn(night)
	local ctx = self.ctx
	local animals = ctx.Services.AnimalService
	-- จิ้งจอกจันทราหายไปกับแสงเช้า · ฝูงบุก/บอสที่ยังไม่ตาย "ไม่หาย" อยู่บุกแคมป์ต่อจนกว่าจะโดนฆ่า
	-- (กันหนีออกจากแคมป์ตอนฝูงบุกแล้วรอเช้าให้หายเอง — ทิ้งแคมป์ = กองไฟ/กำแพงโดนพัง)
	animals:ClearKind("Stalker", true)
	if animals:CountKind("Boss") == 0 then
		ctx.State:SetAttribute("BossId", "")
	end
	ctx.State:SetAttribute("BloodMoon", false)
	ctx.FireRun("Cinematic", "Dawn", { Night = night })
	self:RewardNight(night)
	local left = animals.raidCount + animals:CountKind("Boss")
	if left > 0 then
		task.delay(4, function()
			ctx.Broadcast(string.format("%d animals are still attacking the camp — kill them all!", left), "Danger")
		end)
	end
end

function DirectorService:Loop(runId)
	local ctx = self.ctx
	local s = ctx.State
	while runId == self.runId do
		local night = self.night
		s:SetAttribute("Night", night)
		-- กลางวัน
		local dayLen = Config.DayLength + (night == 1 and Config.FirstDayBonus or 0)
		self:SetPhase("Day", dayLen - Config.DuskLength)
		self.bonus += self.pendingBonus -- ได้เวลาเพิ่มตอนกลางคืน -> กลางวันนี้ยาวขึ้น
		self.pendingBonus = 0
		ctx.FireRun("Cinematic", "DayStart", { Day = night })
		ctx.Services.TraderService:OnDay(night)
		if not self:Wait(dayLen - Config.DuskLength, runId) then
			return
		end
		self:SetPhase("Dusk", Config.DuskLength)
		ctx.FireRun("Cinematic", "Dusk", { Night = night })
		if not self:Wait(Config.DuskLength, runId) then
			return
		end
		-- กลางคืน (เตียงอาจข้ามวันระหว่างกลางวัน -> คืนนี้เป็นคืนถัดไป)
		night = self.night
		-- ฝูงบุกนับ "กลางคืนที่เล่นจริง" (ไม่ใช่เลขวัน): ตัวคูณ x วันกระโดดเลขวันได้ตามปกติ ไม่ทำให้บุกถี่
		self.played = (self.played or 0) + 1
		self.carry = { Played = self.played }
		if not self:RunNight(night, runId) then
			return
		end
		self:Dawn(night)
		if night == Config.TotalNights and not s:GetAttribute("Conquered") then
			self:Complete()
		end
		-- บอสที่ย้ายมาแต่คืนนี้มีบอสของตัวเองอยู่แล้ว -> เลื่อนไปคืนถัดไป · อย่างอื่นใช้ไปแล้ว
		self.carry = { Played = self.played or 0 }
		if self.night == night then -- (DEV setNight กลางคืน = ใช้เลขที่ตั้งไว้)
			self.night = night + 1
		end
		-- ตัวคูณวัน (ช่วยลูกสัตว์ธาตุ): เช้านี้นับ xN วัน = ผ่านเพิ่มอีก N-1 วัน
		local extra = self:DayMultiplier() - 1
		if extra > 0 then
			self.pendingSkips += extra
		end
		self:ApplyPendingSkips()
	end
end

-- ผ่านคืนนี้โดยไม่ต้องเล่น: นับว่ารอด · ฝูงบุก/พระจันทร์เลือด/บอสของคืนที่ข้าม "ไม่ยกมา" คืนถัดไป
-- (เดิมยกมา -> ตัวคูณ x2-x5 วันข้ามคืนบุกแทบทุกเช้า = บุกทุกคืน)
function DirectorService:PassNight()
	local night = self.night
	self:RewardNight(night)
	self.night = night + 1
	self.ctx.State:SetAttribute("Night", self.night)
end

-- ตัวคูณวัน (ช่วยลูกสัตว์) ให้ HUD โชว์ "DAY 12 (x3)" + เอฟเฟกต์ "x3" บินเข้าเลขวัน
-- ต้องตั้งก่อน Night เปลี่ยน (เครื่องลูกค้าค้างเลขเดิมไว้ระหว่างเล่นเอฟเฟกต์)
function DirectorService:AddBonusDays(n, source)
	local st = self.ctx.State
	st:SetAttribute("BonusSource", source or "")
	st:SetAttribute("BonusFrom", self.night)
	st:SetAttribute("BonusDays", (st:GetAttribute("BonusDays") or 0) + n)
end

-- ตัวคูณวัน = ผลรวมจากลูกสัตว์ธาตุที่ช่วยแล้ว (ดิน 2 · น้ำ 3 · น้ำแข็ง 4 · ไฟ 5) · ยังไม่มี = x1
function DirectorService:DayMultiplier()
	return math.max(1, math.floor(self.ctx.State:GetAttribute("BonusDays") or 0))
end

-- เพิ่มตัวคูณวัน (HUD โชว์ "DAY 12 (x5)" + เอฟเฟกต์ "xN" บินเข้าเลขวัน) · มีผลตั้งแต่เช้าถัดไป
function DirectorService:AddDayMultiplier(n, source)
	if not self:CanSkipDay() then
		return false
	end
	self:AddBonusDays(math.max(1, math.floor(tonumber(n) or 1)), source)
	return true
end

-- เตียง: +1 เข้าตัวคูณวัน (ยังไม่มีตัวคูณ = ปกติ x1 + เตียง 1 = x2) · มีผลตั้งแต่เช้าถัดไป
function DirectorService:AddBedMultiplier(player)
	if not self:CanSkipDay() then
		return false
	end
	local cur = math.floor(self.ctx.State:GetAttribute("BonusDays") or 0)
	local new = (cur > 0 and cur or 1) + 1
	self:AddBonusDays(new - cur, "Bed")
	self.ctx.Broadcast(string.format("🛏️ %s used a bed — days now count x%d!", player and player.DisplayName or "The team", new), "Good")
	return true
end

-- บวกสิทธิ์ที่เก็บไว้ (ตอนเช้า) · คืนสุดท้ายต้องเล่นจริง: ที่เหลือรอหลังจบคืน 99
function DirectorService:ApplyPendingSkips()
	local applied = 0
	-- ตัวคูณพาข้ามได้จริงทุกวัน (ไม่ต้องหยุดเล่นคืน 99) · ข้ามผ่านคืน 99 = พิชิต 99 คืนทันที แล้วเล่นต่อโหมดไม่รู้จบ
	while self.pendingSkips > 0 do
		self.pendingSkips -= 1
		applied += 1
		local passed = self.night
		self:PassNight()
		if passed == Config.TotalNights and not self.ctx.State:GetAttribute("Conquered") then
			self:Complete()
		end
		self.ctx.Services.TraderService:OnDay(self.night) -- ไม่ให้พลาดรอบพ่อค้า
	end
	self.ctx.State:SetAttribute("PendingDays", self.pendingSkips)
	if applied > 0 then
		self.ctx.Broadcast(string.format("x%d days! · Day %d", applied + 1, self.night), "Good")
	end
end

-- เตียง/ศาลเจ้าใช้ได้ตลอดรอบ
function DirectorService:CanSkipDay()
	return self.running and self.ctx.State:GetAttribute("Phase") ~= "Ended"
end

-- +1 วันจริงทุกครั้ง: กลางวัน/พลบค่ำมีผลทันที · กลางคืน (และวันที่ 99) เก็บไว้บวกตอนเช้า
-- fmt: ข้อความประกาศเอง (มี %d = วันที่) เช่น ช่วยลูกสัตว์ธาตุสำเร็จ · ไม่ใส่ = ข้อความเตียง
-- source: ชื่อที่ HUD โชว์ใต้ "+1" ("Bed" / "Spirit Pup")
-- n = กี่วัน (เตียง 1 · ลูกสัตว์ธาตุ Config.SpiritBonusDays) · ถึงคืน 99 แล้วหยุด ที่เหลือเก็บไว้บวกหลังเล่นคืน 99
-- fmt: string (มี %d = วันที่) หรือ function(วันที่ข้าม, วันที่) -> ข้อความ
function DirectorService:SkipDay(player, fmt, source, n)
	if not self:CanSkipDay() then
		return false
	end
	n = math.max(1, math.floor(tonumber(n) or 1))
	local phase = self.ctx.State:GetAttribute("Phase")
	local now = 0
	if phase == "Day" or phase == "Dusk" then
		local night = self.night
		now = n
	end
	if now > 0 then
		for _ = 1, now do
			local passed = self.night
			self:PassNight()
			if passed == Config.TotalNights and not self.ctx.State:GetAttribute("Conquered") then
				self:Complete()
			end
			if phase == "Day" then
				self.ctx.Services.TraderService:OnDay(self.night) -- ไม่ให้พลาดรอบพ่อค้า
			end
		end
		if type(fmt) == "function" then
			self.ctx.Broadcast(fmt(now, self.night), "Good")
		elseif fmt then
			self.ctx.Broadcast(string.format(fmt, self.night), "Good")
		elseif now == 1 then
			self.ctx.Broadcast(string.format("%s skipped 1 day · Day %d", player and player.DisplayName or "The team", self.night), "Good")
		else
			self.ctx.Broadcast(string.format("%s skipped %d days · Day %d", player and player.DisplayName or "The team", now, self.night), "Good")
		end
	end
	local later = n - now
	if later > 0 then
		self.pendingSkips += later
		self.ctx.State:SetAttribute("PendingSource", source or "")
		self.ctx.State:SetAttribute("PendingDays", self.pendingSkips)
		local when = self.night == Config.TotalNights and "after the final night" or "in the morning"
		if later == 1 then
			self.ctx.Broadcast(string.format("+1 Day (counted %s)", when), "Good")
		else
			self.ctx.Broadcast(string.format("x%d days (counted %s)", later, when), "Good")
		end
	end
	return true
end

function DirectorService:SpiritCount()
	local n = 0
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		if self.ctx.State:GetAttribute("Spirit" .. el) then
			n += 1
		end
	end
	return n
end

-- รอดครบ 99 คืน: ฉลอง + รางวัล แล้วเล่นต่อ (โหมดไร้ขีดจำกัด)
function DirectorService:Complete()
	local ctx = self.ctx
	local spirits = self:SpiritCount()
	local kind = spirits >= 4 and "True" or "Survived"
	ctx.State:SetAttribute("Conquered", true)
	ctx.FireRun("Cinematic", "Ending", { Kind = kind, Spirits = spirits, Nights = Config.TotalNights, Continue = true })
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
			local data = ctx.Services.DataService:Get(p)
			if data then
				data.Wins = (data.Wins or 0) + 1
				if kind == "True" then
					data.TrueEndings = (data.TrueEndings or 0) + 1
				end
			end
			if kind == "True" then -- รอดครบ 99 คืนเฉยๆ ไม่มี Ruby · ฉากจบสมบูรณ์ (ช่วยครบ 4) เท่านั้นที่ได้
				ctx.Services.DataService:AddDiamonds(p, 50, "Conquer 99 Nights")
			end
			ctx.Services.DataService:CheckBadges(p)
			ctx.Services.DataService:Save(p)
		end
	end
	ctx.Broadcast("Endless mode · Packs get stronger every night", "Reward")
end

function DirectorService:GameOver()
	local ctx = self.ctx
	if ctx.State:GetAttribute("Phase") == "Ended" or not self.running then
		return
	end
	self.runId += 1
	self:SetPhase("Ended", 12)
	ctx.State:SetAttribute("Ending", "Defeat")
	ctx.State:SetAttribute("BossId", "")
	local survived = self.night - 1
	local teamSize = 0
	self.wiped = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") then
			teamSize += 1
			table.insert(self.wiped, p)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") then
			local data = ctx.Services.DataService:Get(p)
			if data then
				data.Runs = (data.Runs or 0) + 1
			end
			ctx.Remotes.Get("Cinematic"):FireClient(p, "GameOver", {
				Night = self.night, Survived = survived, Best = data and data.BestNight or survived, Conquered = ctx.State:GetAttribute("Conquered"),
			})
			Analytics.Custom(p, "GameOverNight", self.night, { p:GetAttribute("Class") or "Survivor", tostring(teamSize) })
			Analytics.Custom(p, "TeamWipe", self.night, { tostring(teamSize) })
			Analytics.NightFailed(p, self.night)
			ctx.Services.DataService:Save(p)
		end
	end
	ctx.Services.AnimalService:ClearKind("Raid", true)
	ctx.Services.AnimalService:ClearKind("Stalker", true)
	task.delay(12, function()
		self:EndRun()
	end)
end

-- จบรอบ: เซิร์ฟเวอร์ของทีม (มาจากล็อบบี้หลัก) = ส่งทุกคนกลับล็อบบี้หลัก / ที่อื่น (Studio) = กลับล็อบบี้ในเซิร์ฟเวอร์นี้
function DirectorService:EndRun()
	local lobby = self.ctx.Services.LobbyService
	if lobby.IsTeamServer and lobby:ReturnToMainLobby(Players:GetPlayers(), { Result = "Defeat", Night = self.night }) then
		-- กันพลาด: ส่งไม่สำเร็จ (Roblox ล่ม ฯลฯ) -> กลับล็อบบี้ในเซิร์ฟเวอร์นี้แทน
		task.delay(20, function()
			if #Players:GetPlayers() > 0 and self.ctx.State:GetAttribute("Phase") == "Ended" then
				self:ResetRun()
			end
		end)
		return
	end
	-- กลับล็อบบี้ในเซิร์ฟเวอร์นี้ (Studio)
	self.wiped = nil
	self:ResetRun()
end

function DirectorService:IsRunning()
	return self.running
end

-- เริ่มรอบ (เรียกจากประตูล็อบบี้)
-- pendingSkips / carry: มาจากรอบที่เก็บไว้ (RejoinService)
function DirectorService:StartRun(night, pendingSkips, carry)
	if self.running then
		return
	end
	self.running = true
	self.runId += 1
	self.night = math.max(1, math.floor(tonumber(night) or 1))
	self.pendingSkips = math.max(0, math.floor(tonumber(pendingSkips) or 0))
	-- นับคืนที่เล่นจริงต่อจากเซฟ (ฝูงบุกนับจากตัวนี้) · เซฟเก่าที่มีฝูง/บอสค้างยกมา -> ไม่ใช้แล้ว
	self.played = type(carry) == "table" and math.max(0, math.floor(tonumber(carry.Played) or 0)) or 0
	self.carry = { Played = self.played }
	self.ctx.State:SetAttribute("PendingDays", self.pendingSkips)
	local runId = self.runId
	task.spawn(function()
		self:Loop(runId)
	end)
end

function DirectorService:ResetRun()
	local ctx = self.ctx
	self.running = false
	self.runId += 1
	self.night = 1
	self.lastElement = nil
	self.pendingSkips = 0
	self.played = 0
	self.carry = { Played = 0 }
	self.bonus, self.pendingBonus = 0, 0
	self.nightBoss = nil
	ctx.State:SetAttribute("BossHoldEnd", 0)
	ctx.State:SetAttribute("BedsUsed", 0)
	ctx.State:SetAttribute("Bed2Used", 0)
	ctx.State:SetAttribute("BonusDays", 0)
	ctx.State:SetAttribute("PendingDays", 0)
	ctx.State:SetAttribute("Ending", "")
	ctx.State:SetAttribute("Conquered", false)
	ctx.State:SetAttribute("BossId", "")
	ctx.Services.AnimalService:ClearKind(nil, false)
	ctx.Services.BuildingService:Clear()
	ctx.Services.CampService:Reset()
	ctx.Services.SpiritService:Reset()
	ctx.Services.LootService:Reset()
	for _, p in ipairs(Players:GetPlayers()) do
		ctx.Services.SurvivalService:ResetPlayer(p)
	end
	ctx.Services.LobbyService:ReturnAll()
	self:SetPhase("Lobby", 0)
	ctx.Broadcast("Back to the lobby", "Info")
end

function DirectorService:Start(ctx)
	ctx.State:SetAttribute("TotalNights", Config.TotalNights)
	self:SetPhase("Lobby", 0)
	-- ทดสอบอัตโนมัติ: ข้ามล็อบบี้ เริ่มรอบเลย
	if ReplicatedStorage:FindFirstChild("ASAutoTest") and not ReplicatedStorage:FindFirstChild("ASLobbyTest") then
		task.delay(2, function()
			for _, p in ipairs(Players:GetPlayers()) do
				ctx.Services.LobbyService:Depart(p)
			end
			self:StartRun()
		end)
	end
end

return DirectorService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000065"><Properties><string name="Name">DropService</string><ProtectedString name="Source"><![CDATA[--[[
	DropService — ของตกบนพื้นแบบ 99 Nights
	ตัดไม้/ทุบหิน/ล่าสัตว์/เปิดหีบ -> ของเด้งออกมากองบนพื้น -> กด E (หรือคลิกตอนถือกระสอบ) เก็บใส่กระสอบ
	DropService:Spawn(id, n, pos)  ·  ของตกเป็นชิ้นๆ ชิ้นละ 1 (ไม่รวมกอง) แบบ 99 Nights
	· ฟิสิกส์คิดบนเซิร์ฟเวอร์ (กันตกทะลุพื้นที่เครื่องผู้เล่นยังโหลดไม่ถึง) แล้วตรึงลงพื้นด้วย raycast
	· ของในแคมป์ไม่หาย · นอกแคมป์หายเองหลัง 15 นาที
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)

local DropService = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB

local LIFETIME = 900
local MAX_DROPS = 600 -- (ของเป็นชิ้นละ 1 แล้ว -> เพดานสูงขึ้น)
local STACK_MAX = 1 -- ของบนพื้น 1 โมเดล = 1 ชิ้น (ทิ้งจากกระสอบ/ย่างเนื้อ/ดรอป ไม่สแต็ก)
local MERGE_RADIUS = 3.5
local PICK_RANGE = 20
local PROMPT_RANGE = 12 -- ตรงกับ FOCUS_RANGE ฝั่ง client
local SETTLE_MAX = 4 -- วินาที: ปล่อยฟิสิกส์เด้งได้นานสุดก่อนตรึง
local FALL_LIMIT = 40 -- ตกต่ำกว่าจุดเกิดเกินนี้ = ทะลุโลก -> ย้ายกลับขึ้นพื้น

local folder
local drops = {} -- model -> { Id, Count, Born }
local order = {}

---------------------------------------------------------------- หาพื้นใต้ของ
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = false -- ตกน้ำ = ลอยบนผิวน้ำ ไม่จมหาย

local function groundBelow(x, z, top)
	local ex = { folder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ex, p.Character)
		end
	end
	local animals = Workspace:FindFirstChild("Animals")
	if animals then
		table.insert(ex, animals)
	end
	rayParams.FilterDescendantsInstances = ex
	return Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -300, 0), rayParams)
end

-- ผิวดินจริง (Terrain อย่างเดียว ไม่สนกิ่งไม้/หลังคา/โต๊ะ) · น้ำ = ผิวน้ำ
local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.IgnoreWater = false
local function terrainTop(x, z, top)
	terrainParams.FilterDescendantsInstances = { Workspace.Terrain }
	return Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -600, 0), terrainParams)
end

-- พื้นที่ของควรวาง: ของที่ชนได้ใต้ตัวของ (พื้นอาคาร/โต๊ะ) ถ้าอยู่ไม่ต่ำกว่าผิวดิน · ไม่งั้น = ผิวดิน
--   ของจมดิน/ทะลุลงไป -> ได้ผิวดินเสมอ (ไม่วางไว้ใต้ดิน) · ใต้กิ่งไม้/หลังคา -> ไม่ไปค้างข้างบน
-- จุดนี้มีของชนได้ (ลำต้น หิน กำแพง) ทับอยู่ไหม — ไม่นับพื้นดิน/ของดรอป/ตัวละคร/สัตว์
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.RespectCanCollide = false
local function blocked(pos, avoid)
	local ex = { folder, Workspace.Terrain }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ex, p.Character)
		end
	end
	local animals = Workspace:FindFirstChild("Animals")
	if animals then
		table.insert(ex, animals)
	end
	overlap.FilterDescendantsInstances = ex
	for _, part in ipairs(Workspace:GetPartBoundsInRadius(pos + V(0, 1.2, 0), 0.9, overlap)) do
		-- ลำต้น/ตัวหินของ node ที่ตีอยู่ (ชนได้หรือไม่ก็ตาม) หรือของแข็งชิ้นอื่น
		if (avoid and part:IsDescendantOf(avoid) and part.Transparency < 1) or (part.CanCollide and part.Transparency < 1) or part.Name == "Collider" then
			return true
		end
	end
	return false
end

local function surfaceFor(pos, origin)
	local T = terrainTop(pos.X, pos.Z, math.max(pos.Y, origin.Y) + 60)
	if T and T.Position.Y > pos.Y + 8 then
		-- เหนือหัวเป็นเพดานดิน (ถ้ำ/เกาะลอย) -> หาผิวที่ใกล้ระดับตัวของแทน
		T = terrainTop(pos.X, pos.Z, pos.Y + 2) or T
	end
	local S = groundBelow(pos.X, pos.Z, pos.Y + 1.5)
	if S and (not T or S.Position.Y >= T.Position.Y - 0.5) then
		return S
	end
	return T
end

-- หาจุดวางของที่ไม่ทับชิ้นอื่น (ตัดไม้/ล่าทีละหลายชิ้น หรือทิ้งของจากกระสอบรัวๆ เคยกองซ้อนกันเป็นตั้ง)
--   ไล่วงรอบจุดกลางทีละชั้น (ในพัดฝั่งผู้เล่นถ้ามี dir) เอาจุดแรกที่ไม่ทับของบนพื้น/ที่กำลังตก และไม่ชนลำต้น/กำแพง
--   ไม่มีจุดว่างเลย = เอาจุดที่ห่างของอื่นมากที่สุด · คืน จุด, รัศมีของชิ้นนี้
local function freeSpot(m, pos, rng, a, dist, dir, avoid)
	local ext = m:GetExtentsSize()
	local myR = math.max(ext.X, ext.Z) * 0.45 + 0.4
	local others = {}
	for om, od in pairs(drops) do
		local op = od.Land or (om.PrimaryPart and om.PrimaryPart.Position)
		if om ~= m and op and ((op - pos) * V(1, 0, 1)).Magnitude < dist + 24 then
			table.insert(others, { op, od.R or 1 })
		end
	end
	local function clearance(p)
		local c = math.huge
		for _, o in ipairs(others) do
			c = math.min(c, ((o[1] - p) * V(1, 0, 1)).Magnitude - o[2])
		end
		return c - myR
	end
	local base = dir and math.atan2(dir.Z, dir.X) or a
	local fan = dir and math.rad(75) or math.pi
	local land = pos + V(math.cos(a) * dist, 0, math.sin(a) * dist)
	local bestP, bestC = nil, -math.huge
	for ringI = 0, 8 do
		local r = dist + ringI * (myR * 1.6)
		local n = r < 0.1 and 1 or math.max(3, math.floor((fan * 2 * r) / (myR * 2.2)))
		local start = rng:NextInteger(0, n - 1) -- เริ่มมุมสุ่ม (ไม่ไปกองที่ขอบพัดก่อน)
		for kk = 0, n - 1 do
			local k = (kk + start) % n
			local t = n == 1 and 0.5 or k / (n - 1)
			local aa = base - fan + t * fan * 2 + (rng:NextNumber() - 0.5) * 0.15
			local cand = pos + V(math.cos(aa) * r, 0, math.sin(aa) * r)
			if not blocked(cand, avoid) then
				local c = clearance(cand)
				if c >= 0 then
					return cand, myR
				elseif c > bestC then
					bestP, bestC = cand, c
				end
			end
		end
	end
	return bestP or land, myR
end

-- ตรึงของลงพื้น: ถ้าวางอยู่บนพื้นดีแล้วไม่ขยับ (ท่าล้มตามธรรมชาติ) · ลอย/จมดิน/ทะลุโลก -> วางใหม่บนผิวพื้น
local function place(m, origin, force)
	local root = m.PrimaryPart
	if not (root and m.Parent) then
		return
	end
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local pos = root.Position
	local hit = pos.Y > origin.Y - FALL_LIMIT and surfaceFor(pos, origin)
	if not hit then
		pos = origin
		hit = surfaceFor(origin, origin)
	end
	if hit then
		local half = root.Size.Y / 2
		local gap = pos.Y - (hit.Position.Y + half)
		-- จมดินแม้นิดเดียว / ลอยเกินครึ่งตัว -> วางใหม่บนผิว (นอนเอียงตามธรรมชาติบนพื้นปล่อยไว้)
		if force or pos ~= root.Position or gap < -0.35 or gap > math.max(root.Size.X, root.Size.Y, root.Size.Z) * 0.6 then
			local _, ry = root.CFrame:ToEulerAnglesYXZ()
			m:PivotTo(CF(hit.Position + V(0, half, 0)) * ANG(0, ry, 0))
		end
	end
	-- ตรึงแล้วไม่ต้องชนกับผู้เล่น (กล่องใสของโมเดล Store จะได้ไม่ขวางทาง) · เมาส์ยังชี้โดน
	root.CanCollide = false
end

local function settle(m, origin)
	task.spawn(function()
		local root = m.PrimaryPart
		local t0 = os.clock()
		local still = 0
		while m.Parent and root.Parent and not root.Anchored do
			task.wait(0.2)
			local t = os.clock() - t0
			if root.Position.Y < origin.Y - FALL_LIMIT or t > SETTLE_MAX then
				break
			end
			if t > 0.6 and root.AssemblyLinearVelocity.Magnitude < 1 then
				still += 1
				if still >= 2 then
					break
				end
			else
				still = 0
			end
		end
		place(m, origin)
	end)
end

---------------------------------------------------------------- หน้าตาของแต่ละชนิด
local function piece(model, size, color, material, shape, cf)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CastShadow = true
	p.Massless = true
	p.CFrame = cf or CF()
	p.Parent = model
	return p
end

local function log(m, cf, len)
	local bark = piece(m, V(len, 0.95, 0.95), C(104, 72, 46), Enum.Material.Wood, Enum.PartType.Cylinder, cf)
	for i = -1, 1, 2 do
		piece(m, V(0.06, 0.82, 0.82), C(206, 168, 112), Enum.Material.Wood, Enum.PartType.Cylinder, cf * CF(i * len / 2, 0, 0))
	end
	return bark
end

local function rock(m, cf, color, material, s)
	s = s or 1
	local r = piece(m, V(1.5, 1.05, 1.3) * s, color, material or Enum.Material.Slate, Enum.PartType.Ball, cf)
	piece(m, V(0.9, 0.8, 0.9) * s, color:Lerp(Color3.new(0, 0, 0), 0.12), material or Enum.Material.Slate, Enum.PartType.Ball, cf * CF(0.45 * s, 0.15 * s, 0.2 * s))
	return r
end

local LOOKS = {
	Wood = function(m, n)
		local root = log(m, CF(), 2.6)
		if n >= 3 then
			log(m, CF(0.2, 0, 0.95) * ANG(0, 0.15, 0), 2.4)
			log(m, CF(0.1, 0.8, 0.48) * ANG(0, -0.1, 0), 2.5)
		elseif n == 2 then
			log(m, CF(0.2, 0, 0.95) * ANG(0, 0.15, 0), 2.4)
		end
		return root
	end,
	Stone = function(m)
		return rock(m, CF(), C(140, 140, 146))
	end,
	Coal = function(m)
		return rock(m, CF(), C(34, 32, 36), Enum.Material.Basalt, 0.85)
	end,
	Iron = function(m)
		local r = rock(m, CF(), C(120, 108, 100))
		for i = 1, 3 do
			piece(m, V(0.3, 0.3, 0.3), C(214, 140, 90), Enum.Material.Metal, Enum.PartType.Ball, CF(math.cos(i * 2) * 0.55, 0.35, math.sin(i * 2) * 0.5))
		end
		return r
	end,
	Fiber = function(m)
		local r = piece(m, V(1.6, 0.7, 0.7), C(150, 186, 92), Enum.Material.Grass, Enum.PartType.Cylinder)
		piece(m, V(0.2, 0.78, 0.78), C(120, 90, 60), Enum.Material.Fabric, Enum.PartType.Cylinder)
		return r
	end,
	Pelt = function(m)
		local r = piece(m, V(2.2, 0.25, 1.6), C(150, 110, 76), Enum.Material.Fabric)
		piece(m, V(1.8, 0.26, 1.2), C(176, 136, 96), Enum.Material.Fabric, nil, CF(0, 0.05, 0))
		return r
	end,
	Bone = function(m)
		local r = piece(m, V(1.8, 0.32, 0.32), C(232, 226, 206), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		for i = -1, 1, 2 do
			piece(m, V(0.5, 0.5, 0.5), C(236, 230, 212), Enum.Material.SmoothPlastic, Enum.PartType.Ball, CF(i * 0.9, 0, 0.15))
			piece(m, V(0.5, 0.5, 0.5), C(236, 230, 212), Enum.Material.SmoothPlastic, Enum.PartType.Ball, CF(i * 0.9, 0, -0.15))
		end
		return r
	end,
	Berries = function(m)
		local leaf = piece(m, V(1.2, 0.15, 1.2), C(70, 130, 60), Enum.Material.Grass)
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			piece(m, V(0.42, 0.42, 0.42), C(190, 34, 80), Enum.Material.SmoothPlastic, Enum.PartType.Ball, CF(math.cos(a) * 0.32, 0.25, math.sin(a) * 0.32))
		end
		return leaf
	end,
	RawMeat = function(m)
		local r = piece(m, V(1.4, 0.6, 1), C(206, 80, 84), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		piece(m, V(0.9, 0.18, 0.18), C(240, 232, 214), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, CF(0.8, 0, 0))
		return r
	end,
	CookedMeat = function(m)
		local r = piece(m, V(1.4, 0.6, 1), C(136, 70, 36), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		piece(m, V(0.9, 0.18, 0.18), C(240, 232, 214), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, CF(0.8, 0, 0))
		return r
	end,
}

local function gem(m, color)
	local r = piece(m, V(0.9, 1.3, 0.9), color, Enum.Material.Neon, nil, ANG(0, math.rad(45), 0))
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 10
	l.Brightness = 1.5
	l.Shadows = false
	l.Parent = r
	return r
end

local function bundle(m, color)
	local r = piece(m, V(1.2, 1, 1.2), color, Enum.Material.Fabric)
	piece(m, V(1.25, 0.2, 1.25), C(120, 90, 60), Enum.Material.Fabric, nil, CF(0, 0.2, 0))
	return r
end

-- ขนาดของตก (ด้านยาวสุด, stud) เมื่อใช้โมเดลจาก Creator Store
local STORE_SIZE = {
	Fiber = 1.8, Bone = 1.9, Berries = 1.9, RawMeat = 1.6, CookedMeat = 1.6, Stew = 1.6, Bandage = 1.4, BerryJuice = 1.7, BerryPie = 1.6, HerbSalve = 1.2,
	Wood = 2.4, Pelt = 2, TerraCore = 1.4, TidePearl = 1.3, GaleFeather = 1.8,
	Stone = 1.8, Iron = 1.7, Coal = 1.8, TerraHeart = 1.5, TideHeart = 1.5, FrostHeart = 1.5, EmberHeart = 1.5, Medkit = 1.4, EmberShard = 1.5,
}

-- โมเดลจาก Store: กล่องใส (Root ชนพื้น) + ชิ้นโมเดลเชื่อมติด
local function storeLook(m, id)
	local src, box = ItemModels.Clone(id, STORE_SIZE[id] or 1.7)
	local root = piece(m, Vector3.new(math.max(box.X, 0.4), math.max(box.Y, 0.4), math.max(box.Z, 0.4)), C(255, 255, 255))
	root.Transparency = 1
	for _, p in ipairs(src:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
		end
	end
	for _, c in ipairs(src:GetChildren()) do
		c.Parent = m
	end
	src:Destroy()
	-- พลังธาตุ/ของหายาก: เรืองแสงสีของไอเทม (มองเห็นตอนกลางคืน)
	local item = Items.Data[id]
	if item.Category == "Essence" or item.Category == "Relic" then
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness, l.Shadows = item.Color or C(255, 255, 255), 10, 1.5, false
		l.Parent = root
	end
	return root
end

-- ออร่าของพลังธาตุ: เปลวไฟอนิเมะเกาะตัว + ประกายดาว (เหมือนอาวุธธาตุ)
local ESSENCE_AURA = {
	TerraCore = { C(255, 200, 90), C(170, 110, 40) },
	GaleFeather = { C(235, 250, 255), C(150, 215, 255) },
	EmberShard = { C(255, 140, 40), C(255, 40, 20) },
	TerraHeart = { C(170, 255, 120), C(60, 160, 40) },
	TideHeart = { C(150, 225, 255), C(30, 120, 220) },
	FrostHeart = { C(240, 250, 255), C(150, 210, 255) },
	EmberHeart = { C(255, 170, 70), C(230, 50, 20) },
}
local function essenceAura(root, id)
	local col = ESSENCE_AURA[id]
	if not col then
		return
	end
	local seq = ColorSequence.new(col[1], col[2])
	local s = math.max(root.Size.X, root.Size.Y, root.Size.Z)
	local f = Instance.new("ParticleEmitter")
	f.Texture = "rbxassetid://16676455805" -- เปลวไฟ 4x4 (VFXPack Fire-Aura)
	f.FlipbookLayout, f.FlipbookMode = Enum.ParticleFlipbookLayout.Grid4x4, Enum.ParticleFlipbookMode.OneShot
	f.Color, f.LightEmission, f.LightInfluence, f.Brightness = seq, 0.8, 0, 2
	f.Shape, f.LockedToPart, f.ZOffset = Enum.ParticleEmitterShape.Box, true, -0.3
	f.Rate, f.Lifetime, f.Speed = 16, NumberRange.new(0.4, 0.6), NumberRange.new(0.4, 0.9)
	f.EmissionDirection, f.SpreadAngle, f.Acceleration = Enum.NormalId.Top, Vector2.new(15, 15), V(0, 3, 0)
	f.Rotation = NumberRange.new(-20, 20)
	f.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.45), NumberSequenceKeypoint.new(0.5, s * 0.6), NumberSequenceKeypoint.new(1, s * 0.2) })
	f.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) })
	f.Parent = root
	local st = Instance.new("ParticleEmitter")
	st.Texture = "rbxassetid://17087151546" -- ประกายดาว (VFXPack RNG-Aura)
	st.Color, st.LightEmission, st.LightInfluence, st.Brightness = seq, 1, 0, 3
	st.Shape, st.Rate, st.Lifetime = Enum.ParticleEmitterShape.Box, 6, NumberRange.new(0.6, 1)
	st.Speed, st.SpreadAngle, st.Drag = NumberRange.new(0.8, 2), Vector2.new(180, 180), 3
	st.Rotation = NumberRange.new(-180, 180)
	st.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 0) })
	st.Parent = root
end

-- เศษอัคคี: กระจุกคริสตัลแดงแหลม (โมเดลที่เลือกเป็น Union ดึงมาใช้ไม่ได้ เลยปั้นทรงเดียวกัน)
local function emberCrystal(m)
	local glass, core = C(235, 45, 35), C(255, 120, 60)
	local root = piece(m, V(0.42, 1.9, 0.42), glass, Enum.Material.Glass, nil, CF(0, 0.15, 0) * ANG(0, math.rad(45), 0))
	root.Transparency = 0.1
	piece(m, V(0.18, 1.5, 0.18), core, Enum.Material.Neon, nil, CF(0, 0.1, 0))
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		local h = 0.8 + (i % 2) * 0.35
		local p = piece(m, V(0.26, h, 0.26), glass, Enum.Material.Glass, nil,
			CF(math.cos(a) * 0.3, -0.75 + h / 2, math.sin(a) * 0.3) * ANG(math.sin(a) * 0.5, a, -math.cos(a) * 0.5))
		p.Transparency = 0.1
	end
	return root
end

-- จัดโมเดล tmp ให้เป็นของตกพื้น: ย่อให้ด้านยาวสุด <= maxLen · flat = วางนอน (ด้านบางสุดชี้ขึ้น) · คืน Root ใส (กล่องชนพื้น)
local function placeLook(m, tmp, maxLen, flat)
	for _, d in ipairs(tmp:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	-- ชิ้นล่องหน (กล่องชน/จุดยึดในโมเดล) ทำให้กรอบใหญ่เกินจริง -> ของย่อจนเล็กจิ๋ว: ตัดทิ้งถ้าไม่มีเอฟเฟกต์ติดอยู่
	local visible = 0
	for _, p in ipairs(tmp:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 0.99 then
			visible += 1
		end
	end
	if visible > 0 then
		for _, p in ipairs(tmp:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency >= 0.99 and not p:FindFirstChildWhichIsA("ParticleEmitter", true)
				and not p:FindFirstChildWhichIsA("Fire", true) and not p:FindFirstChildWhichIsA("Light", true) and not p:FindFirstChildWhichIsA("Attachment")
				and not p:FindFirstChildWhichIsA("BasePart", true) then
				p:Destroy()
			end
		end
	end
	local _, size = tmp:GetBoundingBox()
	local long = math.max(size.X, size.Y, size.Z)
	if long <= 0.05 then
		tmp:Destroy()
		return nil
	end
	if long > maxLen then
		pcall(function()
			tmp:ScaleTo(tmp:GetScale() * maxLen / long)
		end)
	end
	local cf
	cf, size = tmp:GetBoundingBox()
	local rot, box = CFrame.identity, size
	if flat then
		if size.X <= size.Y and size.X <= size.Z then
			rot, box = ANG(0, 0, math.pi / 2), V(size.Y, size.X, size.Z)
		elseif size.Z <= size.Y then
			rot, box = ANG(math.pi / 2, 0, 0), V(size.X, size.Z, size.Y)
		end
	end
	local to = rot * cf:Inverse()
	for _, p in ipairs(tmp:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = to * p.CFrame
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
			if p.Name == "Handle" then
				p.Name = "Grip"
			end
		end
	end
	for _, c in ipairs(tmp:GetChildren()) do
		c.Parent = m
	end
	tmp:Destroy()
	local root = piece(m, V(math.max(box.X, 0.4), math.max(box.Y, 0.4), math.max(box.Z, 0.4)), C(255, 255, 255))
	root.Transparency = 1
	return root
end

-- อาวุธ/เครื่องมือ: ใช้โมเดลเดียวกับตอนถือ (ToolFactory) วางนอนบนพื้น · เดิมไม่มีโมเดลดรอป = กล่องผ้าสีเข้ม (ดูเหมือนหนังสัตว์)
local function toolLook(m, id)
	local ToolFactory = require(script.Parent.ToolFactory)
	local ok, tool = pcall(ToolFactory.Build, id)
	if not ok or not tool then
		return nil
	end
	local tmp = Instance.new("Model")
	for _, c in ipairs(tool:GetChildren()) do
		c.Parent = tmp
	end
	tool:Destroy()
	return placeLook(m, tmp, 4, true)
end

-- เกราะ: โมเดลเกราะแข็งชุดเดียวกับที่สวม (Assets.Armor/<id>) ตั้งตรงบนพื้น
local function armorLook(m, id)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = assets and assets:FindFirstChild("Armor") and assets.Armor:FindFirstChild(id)
	if not src then
		return nil
	end
	local tmp = Instance.new("Model")
	for _, c in ipairs(src:GetChildren()) do
		c:Clone().Parent = tmp
	end
	-- ย่อตามขนาดส่วนที่มองเห็นจริง (ArmorModels.FIT.Ref) · กรอบโมเดลบางชิ้นใหญ่เกินตัวเกราะ (เกราะเหล็กเคยเล็กจิ๋ว)
	local fit = require(ReplicatedStorage.Shared.ArmorModels).FIT[id]
	if fit then
		pcall(function()
			tmp:ScaleTo(tmp:GetScale() * 2.3 / math.max(fit.Ref.X, fit.Ref.Y, fit.Ref.Z))
		end)
		return placeLook(m, tmp, 4, false)
	end
	return placeLook(m, tmp, 2.4, false)
end

local function build(id, n)
	local item = Items.Data[id]
	local m = Instance.new("Model")
	m.Name = "Drop_" .. id
	-- สตรีมมิ่งส่งทั้งโมเดลทีเดียว (ไม่งั้น client อาจได้ชิ้นส่วนแต่ไม่ได้ Root -> ชี้/เก็บไม่ได้)
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local look = LOOKS[id]
	local root
	if ItemModels.Has(id) then
		root = storeLook(m, id)
		m:SetAttribute("LookSource", "Store")
	elseif Items.Tools[id] or Items.Sacks[id] then
		root = toolLook(m, id)
		m:SetAttribute("LookSource", root and "Tool" or nil)
	elseif item.Category == "Armor" then
		root = armorLook(m, id)
		m:SetAttribute("LookSource", root and "Armor" or nil)
	end
	if root then
		-- (ได้โมเดลแล้ว)
	elseif id == "EmberShard" then
		root = emberCrystal(m)
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness, l.Shadows = item.Color, 10, 1.5, false
		l.Parent = root
	elseif look then
		root = look(m, n)
	elseif item.Category == "Essence" or item.Category == "Relic" then
		root = gem(m, item.Color or C(255, 255, 255))
	else
		root = bundle(m, item.Color or C(200, 190, 170))
		m:SetAttribute("LookSource", "Bundle") -- กล่องผ้าสำรอง (ยังไม่มีโมเดล)
	end
	essenceAura(root, id)
	root.Name = "Root"
	root.CanCollide = true
	root.Massless = false
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
		end
	end
	m.PrimaryPart = root
	-- ยา/อาวุธ/เกราะ/สิ่งก่อสร้าง (ไม่กินที่กระสอบ) = เก็บเข้าแถบเครื่องมือได้เลย ไม่ต้องถือกระสอบ (client เปิดปุ่ม E ให้ตลอด)
	m:SetAttribute("Direct", not Items.Bulk(id))
	-- ป้ายชื่อ (เห็นเมื่อเข้าใกล้)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(120, 26)
	bb.StudsOffsetWorldSpace = V(0, 1.8, 0)
	bb.MaxDistance = 28
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextSize = 15
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	t.Parent = bb
	bb.Parent = root
	local pr = Instance.new("ProximityPrompt")
	pr.Name = "Pickup"
	pr.ActionText = Items.Bulk(id) and "Put in Sack" or "Pick Up"
	pr.KeyboardKeyCode = Enum.KeyCode.E
	pr.HoldDuration = 0
	pr.MaxActivationDistance = PROMPT_RANGE
	pr.RequiresLineOfSight = false
	pr.Style = Enum.ProximityPromptStyle.Default
	pr.Enabled = false -- client เปิดเฉพาะชิ้นที่โฟกัส (กรอบขาว)
	pr.Parent = root
	if item.Category == "Food" or item.Category == "Medical" then
		local use = Instance.new("ProximityPrompt")
		use.Name = "Use"
		use.ActionText = item.Category == "Food" and "Eat" or "Use"
		use.KeyboardKeyCode = Enum.KeyCode.R
		use.HoldDuration = 0.4
		use.MaxActivationDistance = PROMPT_RANGE
		use.RequiresLineOfSight = false
		use.Enabled = false
		use.UIOffset = Vector2.new(0, 60)
		use.Parent = root
	end
	return m, root
end

local function refresh(m)
	local d = drops[m]
	if not d then
		return
	end
	local name = Items.DisplayName(d.Id)
	local text = d.Count > 1 and (name .. " ×" .. d.Count) or name
	local root = m.PrimaryPart
	root.Label.Text.Text = text
	root.Pickup.ObjectText = text
	m:SetAttribute("Count", d.Count)
end

function DropService:Remove(m)
	drops[m] = nil
	m:Destroy()
end

---------------------------------------------------------------- สร้างของตก
-- ดรอปของรางวัล: วัตถุดิบ/แก่นธาตุ x Config.LootMult (เศษ = สุ่มปัด) -> คืนจำนวนที่ออกจริง
local SCALED = { Resource = true, Essence = true }
local lootRng = Random.new()
function DropService:SpawnLoot(id, n, pos, opts)
	local info = Items.Data[id]
	if info and SCALED[info.Category] then
		local x = n * Config.LootMult
		n = math.floor(x) + (lootRng:NextNumber() < x % 1 and 1 or 0)
	end
	if n > 0 then
		self:Spawn(id, n, pos, opts)
	end
	return n
end

function DropService:Spawn(id, n, pos, opts)
	n = math.floor(n or 1)
	if n <= 0 or not Items.Data[id] then
		return
	end
	opts = opts or {}
	-- รวมกับกองเดิมที่อยู่ใกล้ (ของที่โยนไม่รวม จะได้ลอยไปถึงเป้า)
	for m, d in pairs((opts.Velocity or opts.Arc) and {} or drops) do
		if d.Id == id and d.Count < STACK_MAX and m.PrimaryPart and (m.PrimaryPart.Position - pos).Magnitude < MERGE_RADIUS then
			local add = math.min(n, STACK_MAX - d.Count)
			d.Count += add
			d.Born = os.clock()
			n -= add
			refresh(m)
			if n <= 0 then
				return m
			end
		end
	end
	local last
	while n > 0 do
		local c = math.min(n, STACK_MAX)
		n -= c
		local m, root = build(id, c)
		local rng = self.rng
		local a = rng:NextNumber() * math.pi * 2
		local spread = opts.Spread or 2.5
		-- ย้ายทั้งโมเดล (PivotTo) ไม่ใช่แค่ Root: ตอนยังไม่อยู่ใน Workspace รอยเชื่อมยังไม่ทำงาน
		-- ถ้าย้ายแค่ Root ชิ้นที่มองเห็นจะค้างอยู่ที่จุด 0,0,0 ใต้ดิน (เห็นแต่ป้ายชื่อ)
		if opts.Velocity or opts.Arc then
			m:PivotTo(CF(pos) * ANG(0, rng:NextNumber() * 6.28, 0))
		else
			m:PivotTo(CF(pos + V(math.cos(a) * spread * rng:NextNumber(), 2.2, math.sin(a) * spread * rng:NextNumber())) * ANG(0, rng:NextNumber() * 6.28, 0))
		end
		m:SetAttribute("ItemId", id)
		m.Parent = folder
		-- เซิร์ฟเวอร์คิดฟิสิกส์เอง: ถ้าให้เครื่องผู้เล่นคิด ของจะตกทะลุพื้นที่ยังสตรีมมาไม่ถึง
		pcall(root.SetNetworkOwner, root, nil)
		root.AssemblyLinearVelocity = opts.Velocity or V(math.cos(a) * 7, 16, math.sin(a) * 7)
		root.AssemblyAngularVelocity = V(rng:NextNumber() * 4, rng:NextNumber() * 4, rng:NextNumber() * 4)
		drops[m] = { Id = id, Count = c, Born = os.clock(), By = opts.By }
		table.insert(order, m)
		refresh(m)
		root.Pickup.Triggered:Connect(function(player)
			self:Pickup(player, m)
		end)
		local use = root:FindFirstChild("Use")
		if use then
			use.Triggered:Connect(function(player)
				self:UseDrop(player, m)
			end)
		end
		-- โยนเข้าเป้า (กองไฟ/เครื่องบด): ลอยเป็นเส้นโค้งด้วยสคริปต์ ไม่ใช้ฟิสิกส์
		--   (เดิมใช้ความเร็ว -> ชนตัวผู้เล่น/กระสอบในมือ/ท่อนฟืนแล้วพุ่งขึ้นฟ้า)
		if opts.Arc then
			root.Anchored = true
			root.CanCollide = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			local from, to = pos, opts.Arc
			local dur = math.clamp((to - from).Magnitude / 22, 0.35, 0.9)
			local h = 2.5 + (to - from).Magnitude * 0.12
			local spin = rng:NextNumber() * 6.28
			task.spawn(function()
				local t0 = os.clock()
				while m.Parent and root.Parent do
					local k = math.min((os.clock() - t0) / dur, 1)
					local p = from:Lerp(to, k) + V(0, 4 * h * k * (1 - k), 0)
					m:PivotTo(CF(p) * ANG(k * 4, spin, k * 2))
					if k >= 1 then
						break
					end
					task.wait()
				end
				place(m, to, true)
			end)
			last = m
			continue
		end
		-- หยุดเด้งแล้วตรึงลงพื้น (ประหยัดฟิสิกส์ + ผู้เล่นเตะไม่กระเด็น + กันลอย/จมดิน)
		if opts.Place then
			-- วางลงพื้นทันที ไม่ปล่อยฟิสิกส์ (ของที่ผู้เล่นทิ้ง: ไม่ชนตัว/กระสอบแล้วกระเด็น)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			-- วางตรงหน้าตัว ถ้ามีของวางอยู่แล้วขยับไปข้างๆ (ไม่ซ้อนทับกัน)
			local land, myR = freeSpot(m, pos, rng, a, 0, nil, nil)
			m:PivotTo(CF(land + V(0, 2.2, 0)) * ANG(0, rng:NextNumber() * 6.28, 0))
			place(m, land + V(0, 1, 0), true)
			drops[m].Land, drops[m].R = m.PrimaryPart and m.PrimaryPart.Position or land, myR
		elseif opts.Velocity then
			settle(m, pos + V(0, 1, 0))
		else
			-- ดรอปจากการตี/ล่า: เด้งเป็นเส้นโค้งสั้นๆ ด้วยสคริปต์ แล้ววางบนพื้น (ไม่ใช้ฟิสิกส์)
			--   เดิมใช้ฟิสิกส์ -> ชนตัวผู้เล่น/ขวานที่เหวี่ยง/ต้นไม้ที่ล้ม แล้วกระเด็นไปไกล
			root.Anchored = true
			root.CanCollide = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			local from = m:GetPivot().Position
			if opts.Dir then
				-- กระจายเป็นพัดหันไปทางผู้เล่น (±70°) ไม่ย้อนเข้าหาตัว node
				local base = math.atan2(opts.Dir.Z, opts.Dir.X)
				a = base + (rng:NextNumber() * 2 - 1) * math.rad(70)
			end
			local dist = spread * (0.6 + rng:NextNumber() * 0.8)
			local land, myR = freeSpot(m, pos, rng, a, dist, opts.Dir, opts.Avoid)
			local hit = surfaceFor(land + V(0, 3, 0), pos + V(0, 1, 0))
			local to = hit and (hit.Position + V(0, root.Size.Y / 2, 0)) or land
			drops[m].Land, drops[m].R = to, myR
			local spin = rng:NextNumber() * 6.28
			local dur = 0.45
			task.spawn(function()
				local t0 = os.clock()
				while m.Parent and root.Parent do
					local k = math.min((os.clock() - t0) / dur, 1)
					local p = from:Lerp(to, k) + V(0, 3.2 * 4 * k * (1 - k), 0)
					m:PivotTo(CF(p) * ANG(0, spin + k * 3, 0))
					if k >= 1 then
						break
					end
					task.wait()
				end
				place(m, to, true)
			end)
		end
		last = m
	end
	-- จำกัดจำนวนรวม: ทิ้งของเก่านอกแคมป์ก่อน (ของที่กองไว้ในแคมป์ไม่โดน)
	if #order > MAX_DROPS then
		local keep = {}
		local over = -MAX_DROPS
		for _ in pairs(drops) do
			over += 1
		end
		for _, old in ipairs(order) do
			if drops[old] and over > 0 and not self:InCamp(old) then
				over -= 1
				self:Remove(old)
			elseif drops[old] then
				table.insert(keep, old)
			end
		end
		while #keep > MAX_DROPS do
			self:Remove(table.remove(keep, 1))
		end
		order = keep
	end
	return last
end

function DropService:InCamp(m)
	local camp = self.ctx.CampPosition
	local r = m.PrimaryPart
	if not (camp and r) then
		return false
	end
	local cs = self.ctx.Services.CampService
	local radius = cs and cs.CampRadius and cs:CampRadius() or 60
	return ((r.Position - camp) * V(1, 0, 1)).Magnitude <= radius + 10
end

---------------------------------------------------------------- เก็บ
function DropService:Pickup(player, m)
	local d = drops[m]
	local char = player.Character
	if not (d and char and m.PrimaryPart) or self.ctx.Services.SurvivalService:IsIncapacitated(player) then
		return
	end
	if (char:GetPivot().Position - m.PrimaryPart.Position).Magnitude > PICK_RANGE then
		return
	end
	-- ต้องถือกระสอบในมือก่อนถึงจะเก็บได้ (แบบ 99 Nights)
	local inv = self.ctx.Services.InventoryService
	-- ยา/อาวุธ/เกราะ/สิ่งก่อสร้าง เข้าแถบเครื่องมือเลย (ไม่ต้องถือกระสอบ ไม่กินที่กระสอบ — กระสอบเต็มก็เก็บได้)
	if not Items.Bulk(d.Id) then
		if Items.Data[d.Id].Category == "Tool" and inv:Count(player, d.Id) > 0 then
			-- อาวุธมีได้ชิ้นเดียวต่อชนิด: ไม่เก็บซ้ำ (ไม่งั้นชิ้นที่เก็บหายไปเฉยๆ)
			self.ctx.Notify(player, "You already have " .. Items.DisplayName(d.Id) .. "", "Info")
			return
		end
		inv:Add(player, d.Id, d.Count)
		self:Remove(m)
		return
	end
	if not inv:HoldingSack(player) then
		self.ctx.Notify(player, "🎒 Hold your sack first (select it in the hotbar), then pick up items", "Info")
		return
	end
	local got = inv:AddToSack(player, d.Id, d.Count)
	if got <= 0 then
		self.ctx.Notify(player, string.format("🎒 Sack is full (%d/%d) — unload it at the crafting bench in camp", inv:Used(player), inv:Capacity(player)), "Warn")
		return
	end
	d.Count -= got
	if d.Count <= 0 then
		self:Remove(m)
	else
		refresh(m)
	end
end

-- กิน/ใช้ของบนพื้น 1 ชิ้น
function DropService:UseDrop(player, m)
	local d = drops[m]
	local char = player.Character
	if not (d and char and m.PrimaryPart) or self.ctx.Services.SurvivalService:IsIncapacitated(player)
		or (char:GetPivot().Position - m.PrimaryPart.Position).Magnitude > PICK_RANGE then
		return
	end
	local inv = self.ctx.Services.InventoryService
	local before = inv:Count(player, d.Id)
	inv:Add(player, d.Id, 1, true)
	self.ctx.Services.SurvivalService:UseItem(player, d.Id)
	if inv:Count(player, d.Id) > before then
		-- ใช้ไม่สำเร็จ (เช่นเลือดเต็ม) -> เอาคืนออกจากกระสอบ ของยังอยู่บนพื้น
		inv:Remove(player, d.Id, 1)
		return
	end
	d.Count -= 1
	if d.Count <= 0 then
		self:Remove(m)
	else
		refresh(m)
	end
end

-- ของตกในรัศมี (ใช้กับกองไฟ)
function DropService:Near(pos, radius, height)
	local out = {}
	for m, d in pairs(drops) do
		local r = m.PrimaryPart
		if r then
			local off = r.Position - pos
			if Vector3.new(off.X, 0, off.Z).Magnitude < radius and math.abs(off.Y) < (height or radius) then
				table.insert(out, { Model = m, Id = d.Id, Count = d.Count, By = d.By })
			end
		end
	end
	return out
end

-- โยนของจากมือเป็นวิถีโค้งไปตกที่ target
function DropService:Throw(player, id, n, target)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local from = head.Position + Vector3.new(0, 1, 0)
	self:Spawn(id, n, from, { Arc = target, By = player })
end

-- ทิ้งของจากกระสอบ: ยืนชิดกองไฟและหันหน้าเข้าหา -> โยนเข้ากองไฟ (ตั้งใจโยนเอง) ไม่งั้นวางหน้าตัว
--   (เดิมยืนห่าง 18 สตัดก็โยนเข้าไฟ = เหมือนกองไฟดูดของ)
function DropService:DropFromPlayer(player, id, n)
	local inv = self.ctx.Services.InventoryService
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 999)
	if not inv:HoldingSack(player) then
		return
	end
	if id == nil then
		id = inv:LastItem(player)
	end
	if not (id and Items.Data[id] and Items.Bulk(id)) then
		return
	end
	n = math.min(n, inv:Count(player, id))
	local char = player.Character
	if n <= 0 or not char then
		return
	end
	inv:Remove(player, id, n)
	inv:PopOrder(player, id)
	local cf = char:GetPivot()
	local fire = self.ctx.Services.CampService:FirePosition()
	local toFire = fire and (fire - cf.Position) * Vector3.new(1, 0, 1)
	if toFire and toFire.Magnitude < 10 and (toFire.Magnitude < 3 or cf.LookVector:Dot(toFire.Unit) > 0.5) then
		self:Throw(player, id, n, fire + Vector3.new(0, 1, 0))
	else
		self:Spawn(id, n, cf.Position + cf.LookVector * 5, { Spread = 0.5, Place = true })
	end
end

-- [Backspace] ทิ้งของในมือ: ถือกระสอบ = ทิ้งชิ้นล่าสุดในกระสอบ · ถืออาวุธ/เครื่องมือ = ทิ้งทั้งชิ้น · สิ่งปลูกสร้าง/ยา = ทิ้งทีละ 1
function DropService:DropHeld(player)
	local inv = self.ctx.Services.InventoryService
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not tool or not player:GetAttribute("InRun") then
		return
	end
	if tool:GetAttribute("Kind") == "Sack" then
		self:DropFromPlayer(player, nil, 1)
		return
	end
	local id = tool:GetAttribute("StructureKind") or tool:GetAttribute("MedKind") or tool:GetAttribute("ItemId")
	if not (id and Items.Data[id]) or Items.Sacks[id] or inv:Count(player, id) <= 0 then
		return
	end
	if not inv:Remove(player, id, 1) then
		return
	end
	if Items.Data[id].Category == "Tool" then
		inv:DestroyTool(player, id)
	else
		inv:SyncStructureTools(player)
	end
	local cf = char:GetPivot()
	self:Spawn(id, 1, cf.Position + cf.LookVector * 5, { Spread = 0.5, Place = true })
end

function DropService:Init(ctx)
	self.ctx = ctx
	self.rng = Random.new()
	folder = Instance.new("Folder")
	folder.Name = "Drops"
	folder.Parent = Workspace
end

function DropService:Start(ctx)
	ctx.Remotes.Get("PickupDrop").OnServerEvent:Connect(function(player, m)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		if typeof(m) == "Instance" and drops[m] then
			self:Pickup(player, m)
		end
	end)
	ctx.Remotes.Get("DropHeld").OnServerEvent:Connect(function(player)
		if not ctx.Services.SurvivalService:IsIncapacitated(player) then
			self:DropHeld(player)
		end
	end)
	ctx.Remotes.Get("DropItem").OnServerEvent:Connect(function(player, id, n)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		if id == nil or type(id) == "string" then
			self:DropFromPlayer(player, id, n)
		end
	end)
	-- หายเองเมื่อเก่าเกิน (ยกเว้นในแคมป์) + เช็กของที่ตรึงแล้วลอยค้าง (เช่นพื้นเดิมเป็นต้นไม้ที่โดนตัดไป)
	task.spawn(function()
		while true do
			task.wait(15)
			local now = os.clock()
			for m, d in pairs(drops) do
				local r = m.PrimaryPart
				if not (m.Parent and r) then
					self:Remove(m)
				elseif now - d.Born > LIFETIME and not self:InCamp(m) then
					self:Remove(m)
				elseif r.Anchored then
					local surf = surfaceFor(r.Position, r.Position)
					local gap = surf and (r.Position.Y - r.Size.Y / 2 - surf.Position.Y)
					if not surf or gap > 1.5 or gap < -1 then
						place(m, r.Position, true) -- ลอย/จมดิน -> วางใหม่บนผิว
					end
				end
			end
			local keep = {}
			for _, m in ipairs(order) do
				if drops[m] then
					table.insert(keep, m)
				end
			end
			order = keep
		end
	end)
end

return DropService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000066"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--[[
	EventService — เหตุการณ์สุ่มช่วงกลางวัน (0-2 ครั้งต่อวัน · วันแรกได้อย่างมาก 1 หลังผ่านไปสักพัก)
	  Meteor    "อุกกาบาตธาตุตก"  : ลูกไฟพุ่งลงจากฟ้า (client วาด) -> หลุมอุกกาบาต + แกนผลึก มีสัตว์ธาตุเฝ้า
	                                 ขุดแกน = แก่นธาตุคนละ 2-3 + Ruby 2-5 ให้ทุกคนที่อยู่ใกล้ + ลุ้นหัวใจอสูรธาตุนั้น 22%
	  Migration "ฝูงสัตว์อพยพ"      : ฝูงกวาง/กระต่ายเดินผ่านแถวแคมป์ (ล่าได้ ได้หนังเพิ่ม)
	  Supply    "เสบียงตกจากฟ้า"    : มาแน่นอนทุก 10 วัน (SUPPLY_EVERY · ไม่สุ่ม) หีบร่มชูชีพร่อนลง ควันแดง -> เปิดได้อาหาร/ยา/วัตถุดิบ
	ทุกอย่างหายไปเองตอนพลบค่ำ / กลับล็อบบี้ / จบเกม · ไม่ทำงานในล็อบบี้ · client: WorldEventsClient (Remotes "WorldEvent")
	GameState: Event_Meteor / Event_Migration / Event_Supply = ตำแหน่ง (หมุดบนแผนที่) · Event_MeteorElement
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Animals = require(ReplicatedStorage.Shared.Animals)
local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local Nights = require(ReplicatedStorage.Shared.Nights)

local EventService = {}

local ELEMENTS = { "Earth", "Water", "Air", "Fire" }
-- กล่อง Airdrop: อาวุธพิเศษ 1 ชิ้น (น้ำหนัก = % รวม 100)
local AIRDROP_WEAPONS = { { "Katana", 20 }, { "BattleAxe", 20 }, { "Crossbow", 15 }, { "WarHammer", 15 }, { "Scythe", 20 }, { "GiantSack", 10 } }
local THAI = { Earth = "Earth", Water = "Water", Air = "Frost", Fire = "Fire" }
local COLOR = {
	Earth = Color3.fromRGB(120, 245, 90), Water = Color3.fromRGB(70, 210, 255),
	Air = Color3.fromRGB(150, 210, 255), Fire = Color3.fromRGB(255, 110, 30),
}
local ESSENCE = { Earth = "TerraCore", Water = "TidePearl", Air = "GaleFeather", Fire = "EmberShard" }
local WEIGHTS = { { "Meteor", 45 }, { "Migration", 30 } } -- เหตุการณ์สุ่มรายวัน (หีบร่อนไม่สุ่ม: มาตามรอบ SUPPLY_EVERY)
local SUPPLY_EVERY = 10 -- หีบเสบียงร่อนจากฟ้า: มาแน่นอนทุกกี่วัน (วัน 10, 20, 30, ...)
local SUPPLY_DELAY = { 15, 30 } -- วินาทีหลังเริ่มกลางวันถึงประกาศ (ร่อน 17 วิ -> เหลือเวลาไปเปิดก่อนพลบค่ำ)
local METEOR_FALL = 13 -- วินาทีจากประกาศถึงตกกระทบ

local V = Vector3.new
local CF = CFrame.new

local function P(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	props.ClassName = nil
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		p[k] = v
	end
	if p.Material == Enum.Material.Neon then
		p.Material = Enum.Material.SmoothPlastic -- เกมนี้ไม่ใช้นีออน
	end
	p.Parent = parent
	return p
end

-- ความสูงพื้นจริง (ยิง ray ลง Terrain) — HeightAt เป็นค่าประมาณ ผิว Terrain จริงอาจสูงกว่า ทำให้ของจมดิน
local function groundY(x, z, fallback)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(Vector3.new(x, (fallback or 0) + 120, z), Vector3.new(0, -400, 0), rp)
	return hit and hit.Position.Y or fallback
end

local function light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = part
	return l
end

function EventService:Init(ctx)
	self.ctx = ctx
	self.rng = Random.new()
	self.token = 0
	self.active = {} -- [kind] = { Cleanup = fn }
end

---------------------------------------------------------------- ตัวช่วย
function EventService:RunPlayers()
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
			table.insert(out, p)
		end
	end
	return out
end

function EventService:Valid(token)
	local ctx = self.ctx
	return token == self.token
		and ctx.State:GetAttribute("Phase") == "Day"
		and ctx.Services.DirectorService:IsRunning()
		and ctx.Layout ~= nil
		and Workspace:FindFirstChild("World") ~= nil
		and #self:RunPlayers() > 0
end

function EventService:Folder()
	local world = Workspace:FindFirstChild("World")
	local f = world and world:FindFirstChild("Events")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Events"
		f.Parent = world or Workspace
	end
	return f
end

-- จุดบนบกที่ค่อนข้างราบ ห่างจุดพิเศษ/แคมป์
function EventService:FindSpot(minR, maxR, clearance)
	local layout = self.ctx.Layout
	local maxD = layout.Half - layout.EdgeOcean - 120
	for _ = 1, 50 do
		local ang = self.rng:NextNumber(0, math.pi * 2)
		local d = math.min(self.rng:NextNumber(minR, maxR), maxD)
		local x, z = math.cos(ang) * d, math.sin(ang) * d
		local h, biome, lava, main = layout:HeightAt(x, z)
		if h > layout.WaterLevel + 3 and not lava and h < 300 then
			local ok = true
			for _, o in ipairs({ { 9, 0 }, { -9, 0 }, { 0, 9 }, { 0, -9 } }) do
				local hh, _, ll = layout:HeightAt(x + o[1], z + o[2])
				if ll or math.abs(hh - h) > 6 or hh < layout.WaterLevel + 1 then
					ok = false
					break
				end
			end
			if ok then
				for _, sp in ipairs(layout.Specials) do
					local need = (sp.Radius or (sp.Kind == "Lair" and 100 or 45)) + clearance
					if (Vector3.new(sp.Position.X - x, 0, sp.Position.Z - z)).Magnitude < need then
						ok = false
						break
					end
				end
			end
			if ok then
				return Vector3.new(x, groundY(x, z, h), z), (biome ~= "Heart") and biome or main
			end
		end
	end
	return nil
end

function EventService:Register(kind, cleanup)
	self:Cleanup(kind)
	self.active[kind] = { Cleanup = cleanup }
end

function EventService:Cleanup(kind)
	local e = self.active[kind]
	if e then
		self.active[kind] = nil
		local ok, err = pcall(e.Cleanup)
		if not ok then
			warn("[AS] event cleanup " .. kind, err)
		end
	end
	self.ctx.State:SetAttribute("Event_" .. kind, nil)
end

function EventService:CleanupAll()
	for _, w in ipairs(WEIGHTS) do
		self:Cleanup(w[1])
	end
	self.ctx.State:SetAttribute("Event_MeteorElement", nil)
end

---------------------------------------------------------------- ตารางเหตุการณ์ของวัน
function EventService:PlanDay(token)
	local s = self.ctx.State
	local night = s:GetAttribute("Night") or 1
	local now = Workspace:GetServerTimeNow()
	local dayLeft = (s:GetAttribute("PhaseEnd") or now) - now
	local rng = self.rng
	-- หีบร่อนจากฟ้า: ครบทุก SUPPLY_EVERY วัน (วันข้ามด้วยเตียง/ลูกสัตว์ก็นับ -> ถึงหรือเลยรอบแล้วมาเลย)
	if night < (self.lastNight or 0) then
		self.nextSupply = nil -- เริ่มรอบใหม่
	end
	self.lastNight = night
	self.nextSupply = self.nextSupply or SUPPLY_EVERY
	local supplyAt
	if night >= self.nextSupply then
		self.nextSupply = night - night % SUPPLY_EVERY + SUPPLY_EVERY
		supplyAt = rng:NextNumber(SUPPLY_DELAY[1], SUPPLY_DELAY[2])
		task.delay(supplyAt, function()
			if self:Valid(token) then
				local ok, started = pcall(self.Supply, self, token)
				if not ok then
					warn("[AS] event Supply", started)
				elseif not started then
					self.nextSupply = math.min(self.nextSupply, night + 1) -- หาที่ลงไม่ได้ -> ลองใหม่พรุ่งนี้
				end
			end
		end)
	end
	local delays = {}
	if night <= 1 then
		-- วันแรก: ให้ตั้งตัวก่อน (อย่างน้อย ~2.5 นาที) แล้วค่อยมีได้ 1 เหตุการณ์
		if rng:NextNumber() < 0.75 then
			table.insert(delays, rng:NextNumber(150, 190))
		end
	else
		local r = rng:NextNumber()
		local count = (r < 0.2 and 0) or (r < 0.7 and 1) or 2
		local t = rng:NextNumber(20, 60)
		for _ = 1, count do
			table.insert(delays, t)
			t += rng:NextNumber(75, 115)
		end
	end
	local used = {}
	for _, delay in ipairs(delays) do
		if supplyAt and math.abs(delay - supplyAt) < 60 then
			delay = supplyAt + 60
		end
		if delay + 50 < dayLeft then
			local kind = self:PickKind(used)
			used[kind] = true
			task.delay(delay, function()
				if self:Valid(token) then
					local ok, err = pcall(self.Run, self, kind, token)
					if not ok then
						warn("[AS] event " .. kind, err)
					end
				end
			end)
		end
	end
end

function EventService:PickKind(used)
	local total = 0
	for _, w in ipairs(WEIGHTS) do
		if not used[w[1]] then
			total += w[2]
		end
	end
	local r = self.rng:NextNumber() * total
	for _, w in ipairs(WEIGHTS) do
		if not used[w[1]] then
			r -= w[2]
			if r <= 0 then
				return w[1]
			end
		end
	end
	return "Meteor"
end

-- คืนค่า true ถ้าเริ่มได้ (ไม่ได้ = ลองเหตุการณ์อื่นแทน)
function EventService:Run(kind, token)
	self[kind](self, token)
end

---------------------------------------------------------------- ☄ อุกกาบาตธาตุ
function EventService:Meteor(token)
	local ctx = self.ctx
	local spot, biome = self:FindSpot(380, 1150, 40)
	if not spot then
		return false
	end
	local el = table.find(ELEMENTS, biome) and biome or ELEMENTS[self.rng:NextInteger(1, 4)]
	local col = COLOR[el]
	local impactAt = Workspace:GetServerTimeNow() + METEOR_FALL
	ctx.State:SetAttribute("Event_Meteor", spot)
	ctx.State:SetAttribute("Event_MeteorElement", el)
	local yaw = self.rng:NextNumber(0, math.pi * 2)
	ctx.FireRun("WorldEvent", "Meteor", { Position = spot, Element = el, ImpactAt = impactAt, Fall = METEOR_FALL, Yaw = yaw })

	local model = Instance.new("Model")
	model.Name = "MeteorCrater"
	local guards = {}
	local claimed = false
	self:Register("Meteor", function()
		if model.Parent then
			model:Destroy()
		end
		for _, a in ipairs(guards) do
			if not a.Dead then
				ctx.Services.AnimalService:Vanish(a)
			end
		end
	end)

	task.delay(METEOR_FALL, function()
		if not self:Valid(token) or not self.active.Meteor then
			return
		end
		-- ตกกระทบ: ดาเมจ + กระเด็นคนที่อยู่ใกล้
		for _, p in ipairs(self:RunPlayers()) do
			local c = p.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r then
				local off = (r.Position - spot)
				if off.Magnitude < 20 then
					local dir = off * V(1, 0, 1)
					dir = dir.Magnitude > 0.1 and dir.Unit or V(1, 0, 0)
					ctx.Services.SurvivalService:Damage(p, 18 * (1 - off.Magnitude / 24), "Meteor", { Knockback = dir * 90 + V(0, 55, 0), Burn = el == "Fire" and 3 or nil })
				end
			end
		end
		-- หลุม: พื้นไหม้ + ขอบหินเอียงออก + ก้อนอุกกาบาตกลางหลุม + ผลึก
		local base = CF(spot)
		P(model, { Name = "Scorch", Shape = Enum.PartType.Cylinder, Size = V(0.6, 30, 30), CFrame = base * CF(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(38, 32, 30), Material = Enum.Material.Slate, CanCollide = false })
		P(model, { Name = "ScorchGlow", Shape = Enum.PartType.Cylinder, Size = V(0.2, 12, 12), CFrame = base * CF(0, 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = col, Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.35 })
		for i = 0, 15 do
			local a = i / 16 * math.pi * 2 + self.rng:NextNumber(-0.1, 0.1)
			local s = self.rng:NextNumber(3.5, 6)
			P(model, {
				Name = "Rim", Size = V(s * 1.4, s, s * 0.9),
				CFrame = base * CFrame.Angles(0, a, 0) * CF(0, s * 0.25, -14) * CFrame.Angles(math.rad(-35 + self.rng:NextNumber(-10, 10)), self.rng:NextNumber(-0.3, 0.3), 0),
				Color = Color3.fromRGB(58, 50, 46):Lerp(Color3.fromRGB(90, 80, 70), self.rng:NextNumber()), Material = Enum.Material.Slate,
			})
		end
		P(model, { Name = "Rock", Shape = Enum.PartType.Ball, Size = V(9, 9, 9), CFrame = base * CF(0, 2.6, 0), Color = Color3.fromRGB(40, 34, 36), Material = Enum.Material.Slate })
		local core = P(model, { Name = "Core", Shape = Enum.PartType.Ball, Size = V(4.5, 4.5, 4.5), CFrame = base * CF(0, 6.4, 0), Color = col, Material = Enum.Material.Neon, CanCollide = false })
		model:SetAttribute("Element", el)
		local shards = {}
		for i = 1, 7 do
			local a = i / 7 * math.pi * 2
			local h = self.rng:NextNumber(3, 6.5)
			table.insert(shards, P(model, {
				Name = "Shard", Size = V(1.2, h, 1.2),
				CFrame = base * CF(math.cos(a) * 3.2, 4 + h / 2 * 0.6, math.sin(a) * 3.2) * CFrame.Angles(math.cos(a) * 0.6, a, math.sin(a) * 0.6),
				Color = col, Material = Enum.Material.Neon, CanCollide = false,
			}))
		end
		do
			-- ก้อนอุกกาบาตจาก Creator Store (ลูกกลม/ผลึกปั้นเดิมซ่อนไว้เป็นตัวชน/จุดอ้างอิง)
			local PropBuilder = require(game:GetService("ReplicatedStorage").Shared.PropBuilder)
			local met = PropBuilder.Imported("MeteorLP", base * CF(0, 0.5, 0), 13, model)
			if met then
				-- กล่องรวมของโมเดลรวมหางเอฟเฟกต์ด้วย -> วางก้อนหิน (ชิ้นใหญ่สุด) ให้จมหลุมนิดๆ
				local big
				for _, d in ipairs(met:GetDescendants()) do
					if d:IsA("BasePart") and (not big or d.Size.Magnitude > big.Size.Magnitude) then
						big = d
					end
				end
				if big then
					met:PivotTo(met:GetPivot() + V(0, spot.Y + 2 - (big.Position.Y - big.Size.Y / 2), 0))
				end
				for _, n in ipairs({ "Rock", "Core" }) do
					local rp = model:FindFirstChild(n)
					if rp then
						rp.Transparency = 1
					end
				end
				for _, sh in ipairs(shards) do
					sh.Transparency = 1
				end
			end
		end
		light(core, col, 46, 3.5)
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Rate = 14
		sparks.Lifetime = NumberRange.new(1.2, 2.2)
		sparks.Speed = NumberRange.new(4, 9)
		sparks.SpreadAngle = Vector2.new(60, 60)
		sparks.Color = ColorSequence.new(col)
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
		sparks.Parent = core
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Rate = 6
		smoke.Lifetime = NumberRange.new(6, 9)
		smoke.Speed = NumberRange.new(8, 13)
		smoke.SpreadAngle = Vector2.new(12, 12)
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 22) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		smoke.Color = ColorSequence.new(Color3.fromRGB(70, 62, 60))
		smoke.Parent = core
		-- ลำแสงขึ้นฟ้า (มองเห็นจากไกล)
		local top = P(model, { Name = "BeamTop", Size = V(1, 1, 1), CFrame = base * CF(0, 320, 0), Transparency = 1, CanCollide = false, CanQuery = false })
		local a0 = Instance.new("Attachment")
		a0.Parent = core
		local a1 = Instance.new("Attachment")
		a1.Parent = top
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 3
		beam.Width1 = 9
		beam.LightEmission = 1
		beam.FaceCamera = true
		beam.Color = ColorSequence.new(col)
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureSpeed = 0.5
		beam.Parent = core
		pcall(function()
			model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		end)
		model.PrimaryPart = core
		model.Parent = self:Folder()

		-- ผู้เฝ้า (สัตว์ธาตุเดียวกัน — ถ้ายังไม่มีโมเดลจะไม่เกิด ก็ขุดได้เลย)
		local night = ctx.State:GetAttribute("Night") or 1
		local scale = Nights.Scale(night)
		local pool = Animals.RaidPool[el] or {}
		local n = math.min(4, 2 + math.floor(night / 10))
		for i = 1, (#pool > 0 and n or 0) do
			local a = i / n * math.pi * 2
			local p = spot + V(math.cos(a) * 19, 0, math.sin(a) * 19)
			local h = groundY(p.X, p.Z, ctx.Layout:HeightAt(p.X, p.Z))
			local g = ctx.Services.AnimalService:Spawn(pool[self.rng:NextInteger(1, #pool)], V(p.X, math.max(h, spot.Y) + 3, p.Z), {
				Kind = "Guardian", Home = spot, Leash = 55, SpeedMult = scale.Speed, Night = night, -- เลือด/ดาเมจคงที่ (Monster Balance)
			})
			if g then
				g.Model:SetAttribute("Guardian", true)
				table.insert(guards, g)
			end
		end

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Claim"
		prompt.ActionText = "Mine Meteor Core"
		prompt.HoldDuration = 2.5
		prompt.MaxActivationDistance = 15
		prompt.RequiresLineOfSight = false
		prompt.Parent = core
		local function guardsLeft()
			local left = 0
			for _, g in ipairs(guards) do
				if not g.Dead and not g.Removed then
					left += 1
				end
			end
			return left
		end
		local function refresh()
			local left = guardsLeft()
			prompt.ObjectText = left > 0 and string.format("%d guardians left", left) or (THAI[el] .. " Element Meteor")
			prompt.Enabled = left == 0 and not claimed
		end
		refresh()
		for _, g in ipairs(guards) do
			g.Model.AncestryChanged:Connect(refresh)
			g.Model:GetAttributeChangedSignal("Dead"):Connect(refresh)
		end
		prompt.Triggered:Connect(function(player)
			if claimed or guardsLeft() > 0 or not player:GetAttribute("InRun") then
				return
			end
			claimed = true
			prompt.Enabled = false
			local drops = ctx.Services.DropService
			local got = {}
			for _, p in ipairs(self:RunPlayers()) do
				local c = p.Character
				if c and (c:GetPivot().Position - spot).Magnitude < 80 then
					local k = self.rng:NextInteger(2, 3)
					k = drops:SpawnLoot(ESSENCE[el], k, core.Position, { Spread = 4 })
					got[ESSENCE[el]] = (got[ESSENCE[el]] or 0) + k
					ctx.Services.DataService:AddDiamonds(p, self.rng:NextInteger(2, 5), "Element Meteor")
				end
			end
			if self.rng:NextNumber() < 0.22 then
				local heart = Items.ElementHeart[el]
				drops:Spawn(heart, 1, core.Position, { Spread = 3 })
				got[heart] = 1
			end
			ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = core.Position, Chest = true })
			ctx.FireRun("WorldEvent", "MeteorClaimed", { Position = core.Position, Element = el })
			ctx.Broadcast(string.format("%s mined the %s meteor core!", player.DisplayName, THAI[el]), "Good")
			ctx.State:SetAttribute("Event_Meteor", nil)
			-- แกนแตก
			for _, s in ipairs(shards) do
				TweenService:Create(s, TweenInfo.new(0.6), { Transparency = 1, Size = s.Size * 0.2 }):Play()
			end
			TweenService:Create(core, TweenInfo.new(0.8), { Transparency = 1, Size = V(12, 12, 12) }):Play()
			sparks.Rate = 0
			smoke.Rate = 1
			beam.Enabled = false
		end)
	end)
	return true
end

---------------------------------------------------------------- 🦌 ฝูงสัตว์อพยพ
function EventService:Migration(token)
	local ctx = self.ctx
	local layout = ctx.Layout
	local animals = ctx.Services.AnimalService
	if not (Animals.Data.Deer and Animals.Data.Rabbit) then
		return false
	end
	-- เส้นทาง: คอร์ดตัดผ่านข้างแคมป์ (ระยะ 280-420 จากกองไฟ) ยาว ~700
	local path
	for _ = 1, 25 do
		local a = self.rng:NextNumber(0, math.pi * 2)
		local d = self.rng:NextNumber(280, 420)
		local mid = V(math.cos(a), 0, math.sin(a)) * d
		local dir = V(-math.sin(a), 0, math.cos(a)) * (self.rng:NextNumber() < 0.5 and 1 or -1)
		local pts, ok = {}, true
		for i = 0, 8 do
			local p = mid + dir * ((i / 8 - 0.5) * 700)
			local h, _, lava = layout:HeightAt(p.X, p.Z)
			if lava or h < layout.WaterLevel + 1.5 then
				ok = false
				break
			end
			table.insert(pts, V(p.X, groundY(p.X, p.Z, h) + 2, p.Z))
		end
		if ok then
			path = pts
			break
		end
	end
	if not path then
		return false
	end
	local herd = {}
	local function spawnSome(id, n, factor)
		for _ = 1, n do
			local off = V(self.rng:NextNumber(-14, 14), 0, self.rng:NextNumber(-14, 14))
			local p = path[1] + off
			local h = groundY(p.X, p.Z, layout:HeightAt(p.X, p.Z))
			local a = animals:Spawn(id, V(p.X, h + 1.5, p.Z), { Kind = "Migrant", Home = path[1] })
			if a then
				a.Wp = 2
				a.MigrateSpeed = factor * self.rng:NextNumber(0.9, 1.1)
				a.Offset = off * 0.6
				a.OnDeath = function(dead)
					-- สัตว์อพยพตัวอ้วน: ลุ้นหนัง/เนื้อเพิ่ม
					if self.rng:NextNumber() < 0.5 * Config.AnimalDropMult then
						ctx.Services.DropService:Spawn("Pelt", 1, dead.Root.Position)
					end
					if dead.Id == "Deer" and self.rng:NextNumber() < 0.5 * Config.AnimalDropMult then
						ctx.Services.DropService:Spawn("RawMeat", 1, dead.Root.Position)
					end
				end
				table.insert(herd, a)
			end
		end
	end
	spawnSome("Deer", self.rng:NextInteger(5, 8), 0.36)
	spawnSome("Rabbit", self.rng:NextInteger(4, 7), 0.42)
	if #herd == 0 then
		return false -- ยังไม่มีโมเดลกวาง/กระต่าย
	end
	local done = false
	self:Register("Migration", function()
		done = true
		for _, a in ipairs(herd) do
			if not a.Dead and not a.Removed then
				animals:Vanish(a)
			end
		end
	end)
	ctx.State:SetAttribute("Event_Migration", path[1])
	ctx.FireRun("WorldEvent", "Migration", { Position = path[1], To = path[#path] })
	task.spawn(function()
		local t0 = os.clock()
		while not done and self:Valid(token) and os.clock() - t0 < 170 do
			task.wait(1)
			local alive, sum = 0, Vector3.zero
			local now = os.clock()
			for _, a in ipairs(herd) do
				if not a.Dead and not a.Removed and a.Model.Parent then
					local wp = path[a.Wp]
					if not wp then
						animals:Vanish(a)
					else
						alive += 1
						sum += a.Root.Position
						if (a.FleeUntil or 0) < now then
							local target = wp + a.Offset
							if ((a.Root.Position - target) * V(1, 0, 1)).Magnitude < 14 then
								a.Wp += 1
							end
							animals:MoveTo(a, target, a.MigrateSpeed)
							a.WanderAt = now + 3 -- กันโหมดเดินเล่นแย่งคำสั่ง
							a.State = "Wander"
							a.Model:SetAttribute("State", "Wander")
						end
					end
				end
			end
			if alive == 0 then
				break
			end
			ctx.State:SetAttribute("Event_Migration", sum / alive)
		end
		if self.active.Migration and not done then
			self:Cleanup("Migration")
		end
	end)
	return true
end

---------------------------------------------------------------- 📦 เสบียงตกจากฟ้า
function EventService:Supply(token)
	local ctx = self.ctx
	local spot = self:FindSpot(220, 650, 25)
	if not spot then
		return false
	end
	local model = Instance.new("Model")
	model.Name = "SupplyDrop"
	local landCF = CF(spot + V(0, 1.75, 0)) * CFrame.Angles(0, self.rng:NextNumber(0, 6.28), 0)
	local wood, metal = Color3.fromRGB(122, 86, 52), Color3.fromRGB(70, 74, 80)
	local body = P(model, { Name = "Body", Size = V(4.6, 3.5, 4.6), CFrame = landCF, Color = wood, Material = Enum.Material.WoodPlanks })
	for _, y in ipairs({ -1.2, 1.2 }) do
		P(model, { Size = V(4.8, 0.35, 4.8), CFrame = landCF * CF(0, y, 0), Color = metal, Material = Enum.Material.Metal, CanCollide = false })
	end
	P(model, { Size = V(0.4, 3.6, 4.8), CFrame = landCF, Color = metal, Material = Enum.Material.Metal, CanCollide = false })
	local flare = P(model, { Name = "Flare", Size = V(0.7, 1.4, 0.7), CFrame = landCF * CF(1.6, 2.4, 1.6), Color = Color3.fromRGB(255, 60, 40), Material = Enum.Material.Neon, CanCollide = false })
	light(flare, Color3.fromRGB(255, 80, 60), 30, 3)
	local chute = Instance.new("Model")
	chute.Name = "Chute"
	local canopy = P(chute, { Name = "Canopy", Shape = Enum.PartType.Cylinder, Size = V(1.2, 16, 16), CFrame = landCF * CF(0, 11, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(230, 70, 60), Material = Enum.Material.Fabric, CanCollide = false })
	P(chute, { Shape = Enum.PartType.Cylinder, Size = V(1.3, 8, 8), CFrame = canopy.CFrame * CF(0.2, 0, 0), Color = Color3.fromRGB(245, 240, 230), Material = Enum.Material.Fabric, CanCollide = false })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local top = landCF * CF(math.cos(a) * 7, 10.5, math.sin(a) * 7)
		local bot = landCF * CF(math.cos(a) * 2, 1.7, math.sin(a) * 2)
		local mid = top.Position:Lerp(bot.Position, 0.5)
		P(chute, { Size = V(0.15, 0.15, (top.Position - bot.Position).Magnitude), CFrame = CFrame.lookAt(mid, bot.Position), Color = Color3.fromRGB(220, 220, 210), Material = Enum.Material.Fabric, CanCollide = false })
	end
	chute.Parent = model
	-- โมเดลกล่องแอร์ดรอปใหม่ (Import 3D): ใช้แทนกล่องไม้ปั้นเอง · ตัวกล่องเดิมซ่อนไว้เป็นจุดชน/จุดกด
	do
		local PropBuilder = require(game:GetService("ReplicatedStorage").Shared.PropBuilder)
		local crate = PropBuilder.Imported("AirdropCrate", landCF * CF(0, -1.75, 0), 7.6, model, false)
		if crate then
			for _, d in ipairs(model:GetChildren()) do
				if d:IsA("BasePart") and d ~= flare then
					d.Transparency = 1
				end
			end
			flare.Transparency = 0
			flare.CFrame = landCF * CF(2.8, 3.8, 2.8)
		end
	end
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Rate = 9
	smoke.Lifetime = NumberRange.new(7, 10)
	smoke.Speed = NumberRange.new(10, 16)
	smoke.SpreadAngle = Vector2.new(8, 8)
	smoke.Acceleration = V(1.5, 0, 0)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 20) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 70, 50), Color3.fromRGB(200, 120, 110))
	smoke.Enabled = false
	smoke.Parent = flare
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = d == body
		end
	end
	model.PrimaryPart = body
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	local fallH = 170
	model:PivotTo(landCF + V(0, fallH, 0))
	model.Parent = self:Folder()
	local done = false
	self:Register("Supply", function()
		done = true
		if model.Parent then
			model:Destroy()
		end
	end)
	ctx.State:SetAttribute("Event_Supply", spot)
	local fall = 17
	ctx.FireRun("WorldEvent", "Supply", { Position = spot, LandAt = Workspace:GetServerTimeNow() + fall })
	task.spawn(function()
		local t0 = os.clock()
		while not done and model.Parent do
			local t = math.min((os.clock() - t0) / fall, 1)
			model:PivotTo(landCF + V(math.sin(t * 9) * 1.5 * (1 - t), fallH * (1 - t), 0))
			if t >= 1 then
				break
			end
			task.wait(0.06)
		end
		if done or not model.Parent then
			return
		end
		smoke.Enabled = true
		local cf0 = chute:GetPivot()
		for _, d in ipairs(chute:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(2), { Transparency = 1 }):Play()
			end
		end
		chute:PivotTo(cf0 * CF(4, -4, 0) * CFrame.Angles(0, 0, 0.6))
		task.delay(2.2, function()
			chute:Destroy()
		end)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "OpenSupply"
		prompt.ActionText = "Open Supply Chest"
		prompt.ObjectText = "Supply Chest"
		prompt.HoldDuration = 1.5
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = body
		prompt.Triggered:Connect(function(player)
			if not prompt.Enabled or not player:GetAttribute("InRun") then
				return
			end
			prompt.Enabled = false
			local rng = self.rng
			local got = {}
			local pos = body.Position + V(0, 2, 0)
			-- จำนวนตามที่ตั้งตรงๆ (ไม่คูณ LootMult)
			local function give(id, n)
				if n > 0 then
					ctx.Services.DropService:Spawn(id, n, pos, { Spread = 3.5 })
					got[id] = (got[id] or 0) + n
				end
			end
			give("CookedMeat", rng:NextInteger(4, 5))
			give("Bandage", 3)
			give("Medkit", rng:NextNumber() < 0.2 and 1 or 0)
			give("Iron", rng:NextInteger(5, 6))
			give("Coal", rng:NextInteger(4, 5))
			give(ESSENCE[ELEMENTS[rng:NextInteger(1, 4)]], 1)
			-- อาวุธพิเศษ 1 ชิ้น (อาวุธกล่องระดับ 3 · น้ำหนัก = %)
			local roll = rng:NextNumber() * 100
			for _, e in ipairs(AIRDROP_WEAPONS) do
				roll -= e[2]
				if roll <= 0 then
					give(e[1], 1)
					break
				end
			end
			ctx.Services.DataService:AddDiamonds(player, rng:NextInteger(2, 3), "Supply Chest")
			ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = pos, Chest = true })
			ctx.Services.LootService:ChestFx(model, pos, 2, Color3.fromRGB(255, 120, 90))
			ctx.Broadcast(string.format("%s opened the supply chest", player.DisplayName), "Good")
			ctx.State:SetAttribute("Event_Supply", nil)
			task.delay(6, function()
				smoke.Enabled = false
			end)
		end)
	end)
	return true
end

---------------------------------------------------------------- เริ่มระบบ
function EventService:Start(ctx)
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = ctx.State:GetAttribute("Phase")
		self.token += 1
		if phase == "Day" then
			-- เผื่อมีของค้างจากวันก่อน
			self:CleanupAll()
			if ctx.Services.DirectorService:IsRunning() then
				self:PlanDay(self.token)
			end
		else
			-- พลบค่ำ / กลางคืน / ล็อบบี้ / จบเกม: เก็บทุกเหตุการณ์
			self:CleanupAll()
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000067"><Properties><string name="Name">FriendService</string><ProtectedString name="Source"><![CDATA[--[[
	FriendService — โบนัสเล่นกับเพื่อน
	  · มีเพื่อน Roblox อยู่ในรอบเดียวกัน (ทั้งคู่อยู่ในแมพ เซิร์ฟเวอร์เดียวกัน) = Ruby ที่ได้ระหว่างรอบ +10%
	    (DataService:AddDiamonds เรียก Extra) · เศษทศนิยมสะสมไว้ ไม่ปัดทิ้ง
	  · เช็กเพื่อนด้วย player:IsFriendsWith (pcall + จำผลไว้) · player attribute "FriendsHere" = จำนวนเพื่อนในเซิร์ฟเวอร์
	  · (หน้าชวนเพื่อนใน QuestUI ถูกเอาออกแล้ว — โบนัส +10% ยังทำงานเมื่อเล่นรอบเดียวกับเพื่อน)
]]

local Players = game:GetService("Players")

local FriendService = {}

FriendService.BonusRate = 0.10

local cache = {} -- cache[userIdA][userIdB] = true/false
local carry = {} -- [player] = เศษโบนัสที่ยังไม่ครบ 1 Ruby

function FriendService:Init(ctx)
	self.ctx = ctx
end

local function known(a, b)
	local row = cache[a.UserId]
	return row and row[b.UserId]
end

function FriendService:IsFriend(a, b)
	return a ~= b and known(a, b) == true
end

local function countHere(player)
	local n = 0
	for _, q in ipairs(Players:GetPlayers()) do
		if FriendService:IsFriend(player, q) then
			n += 1
		end
	end
	player:SetAttribute("FriendsHere", n)
end

local function check(a, b)
	if a == b or a.UserId <= 0 or b.UserId <= 0 or known(a, b) ~= nil then
		return
	end
	local ok, res = pcall(a.IsFriendsWith, a, b.UserId)
	if not ok then
		return -- ลองใหม่รอบหน้า (ตอนมีคนเข้า/ออก)
	end
	cache[a.UserId] = cache[a.UserId] or {}
	cache[b.UserId] = cache[b.UserId] or {}
	cache[a.UserId][b.UserId] = res == true
	cache[b.UserId][a.UserId] = res == true
	if a.Parent then
		countHere(a)
	end
	if b.Parent then
		countHere(b)
	end
end

-- จำนวนเพื่อนที่อยู่ในแมพรอบเดียวกันตอนนี้
function FriendService:FriendsInRun(player)
	if not player:GetAttribute("InRun") then
		return 0
	end
	local n = 0
	for _, q in ipairs(Players:GetPlayers()) do
		if q:GetAttribute("InRun") and self:IsFriend(player, q) then
			n += 1
		end
	end
	return n
end

function FriendService:Bonus(player)
	return self:FriendsInRun(player) > 0
end

-- Ruby โบนัสที่ต้องบวกเพิ่มจาก n (0 ถ้าไม่มีเพื่อนในรอบ)
function FriendService:Extra(player, n)
	if n <= 0 or not self:Bonus(player) then
		return 0
	end
	local v = n * self.BonusRate + (carry[player] or 0)
	local whole = math.floor(v)
	carry[player] = v - whole
	return whole
end

function FriendService:Start()
	local function onPlayer(p)
		p:SetAttribute("FriendsHere", 0)
		for _, q in ipairs(Players:GetPlayers()) do
			if q ~= p then
				task.spawn(check, p, q)
			end
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		carry[p] = nil
		cache[p.UserId] = nil
		for _, row in pairs(cache) do
			row[p.UserId] = nil
		end
		for _, q in ipairs(Players:GetPlayers()) do
			if q ~= p then
				countHere(q)
			end
		end
	end)
end

return FriendService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000068"><Properties><string name="Name">GuardianWaves</string><ProtectedString name="Source"><![CDATA[--[[
	GuardianWaves — ผู้เฝ้า 3 เวฟ ใช้ร่วมกันที่ศาลเจ้า (ช่วยลูกสัตว์) และวิหาร
	  เวฟ 1 = 3 ตัว -> เวฟ 2 = 5 ตัว -> เวฟ 3 = 7 ตัว · ปราบหมดเวฟแล้วพัก 5 วิ ค่อยมาเวฟถัดไป
	  w = ตารางสถานะของศาลเจ้า/วิหาร (ใช้ช่อง Wave, NextWaveAt, Guardians)
	  spawn(wave, count) -> รายชื่อสัตว์ที่เกิด · announce(text, kind) = บอกผู้เล่นแถวนั้น
]]

local GuardianWaves = {}

GuardianWaves.Counts = { 3, 5, 7 }
GuardianWaves.Cooldown = 5

function GuardianWaves.Alive(list)
	local n = 0
	for _, a in ipairs(list or {}) do
		if not a.Dead and a.Model and a.Model.Parent then
			n += 1
		end
	end
	return n
end

-- เริ่มเวฟ 1
function GuardianWaves.Begin(w, spawn)
	w.Wave = 1
	w.NextWaveAt = nil
	w.Guardians = spawn(1, GuardianWaves.Counts[1]) or {}
end

-- เรียกทุก tick หลังเริ่มแล้ว -> "fighting" (ยังมีผู้เฝ้า) / "cooldown" (พักก่อนเวฟถัดไป) / "done" (ครบ 3 เวฟ)
function GuardianWaves.Step(w, spawn, announce)
	if GuardianWaves.Alive(w.Guardians) > 0 then
		return "fighting"
	end
	local counts = GuardianWaves.Counts
	local total = #counts
	if (w.Wave or 0) >= total then
		return "done"
	end
	local now = os.clock()
	if not w.NextWaveAt then
		w.NextWaveAt = now + GuardianWaves.Cooldown
		announce(string.format("✔ Wave %d/%d cleared! Next wave (%d guardians) in %d seconds", w.Wave, total, counts[w.Wave + 1], GuardianWaves.Cooldown), "Good")
		return "cooldown"
	end
	if now < w.NextWaveAt then
		return "cooldown"
	end
	w.NextWaveAt = nil
	w.Wave += 1
	w.Guardians = spawn(w.Wave, counts[w.Wave]) or {}
	announce(string.format("⚔ Wave %d/%d — %d guardians!", w.Wave, total, counts[w.Wave]), "Warn")
	return "fighting"
end

return GuardianWaves
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000069"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--[[
	InventoryService — ของของผู้เล่น (server เป็นเจ้าของข้อมูล) แบบ 99 Nights
	· เครื่องมือ/อาวุธ/กระสอบ = Tool ในช่องด้านล่างของ Roblox (1 ชิ้นต่อชนิด)
	· ของอื่น (ไม้ หิน อาหาร ...) อยู่ใน "กระสอบ" มีความจุจำกัด (Items.Sacks)
	· คลังแคมป์ (Camp) ใช้ร่วมกันทั้งเซิร์ฟเวอร์ — เทกระสอบลงที่โต๊ะคราฟต์
	· คราฟต์/สร้าง/เติมไฟ ใช้ของจากกระสอบก่อน แล้วค่อยหยิบจากคลังแคมป์ 
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local Limits = require(ReplicatedStorage.Shared.Limits)
local CollectionService = game:GetService("CollectionService")
local ItemThumbs = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ItemThumbs"))
local ToolFactory = require(script.Parent.ToolFactory)

local InventoryService = {}
local inv = {}
local dirty = {}
local camp = {}

-- ของที่เทลงคลังแคมป์ได้ (อาหาร/ยาเก็บไว้กับตัว)
local DEPOSIT = { Resource = true, Essence = true, Relic = true }

function InventoryService:Init(ctx)
	self.ctx = ctx
	self.Camp = camp
	self.order = {}
end

function InventoryService:Get(player)
	if not inv[player] then
		inv[player] = {}
	end
	return inv[player]
end

function InventoryService:Count(player, id)
	return self:Get(player)[id] or 0
end

-- คลังแคมป์ใช้ร่วมได้ทุกที่ (แบบเดิม: สร้างกำแพง/กับดักไกลแคมป์ก็หยิบของจากคลังได้) — ข้อจำกัดเรื่องระยะอยู่ที่โต๊ะคราฟต์ใน CampService
function InventoryService:InCamp(_player)
	return true
end

-- จำนวนในคลังแคมป์ที่ผู้เล่นคนนี้ใช้ได้ตอนนี้ (นอกแคมป์ = 0)
function InventoryService:CampCount(player, id, inCamp)
	if inCamp == nil then
		inCamp = self:InCamp(player)
	end
	return inCamp and (camp[id] or 0) or 0
end

-- รวมของในกระสอบ + คลังแคมป์ (คลังแคมป์นับเฉพาะตอนอยู่ในแคมป์)
function InventoryService:Available(player, id, inCamp)
	local group = Items.AnyGroups[id]
	if group then
		local n = 0
		for _, g in ipairs(group) do
			n += self:Available(player, g, inCamp)
		end
		return n
	end
	return (self:Get(player)[id] or 0) + self:CampCount(player, id, inCamp)
end

local function markDirty(player)
	dirty[player] = true
end

local function markAll()
	for _, p in ipairs(Players:GetPlayers()) do
		dirty[p] = true
	end
end

function InventoryService:Capacity(player)
	local bag = self:Get(player)
	local cap = 0
	for id, c in pairs(Items.Sacks) do
		if (bag[id] or 0) > 0 then
			cap = math.max(cap, c)
		end
	end
	return cap
end

function InventoryService:Used(player)
	local n = 0
	for id, c in pairs(self:Get(player)) do
		if Items.Bulk(id) then
			n += c
		end
	end
	return n
end

function InventoryService:Space(player)
	return math.max(0, self:Capacity(player) - self:Used(player))
end

-- ที่เก็บ Tool ทั้งหมดของผู้เล่น (ทุก Backpack — ตอนเกิดใหม่ Roblox อาจมี Backpack เก่าค้างชั่วครู่ — + ตัวละคร)
function InventoryService:ToolHolders(player)
	local list = {}
	for _, c in ipairs(player:GetChildren()) do
		if c:IsA("Backpack") then
			table.insert(list, c)
		end
	end
	if player.Character then
		table.insert(list, player.Character)
	end
	return list
end

-- เครื่องมือต้องมีชนิดละ 1 อันเท่านั้น: ลบ Tool ที่ซ้ำ (เก็บอันที่ถืออยู่) และ Tool ที่ไม่มีในกระเป๋าแล้ว
function InventoryService:DedupeTools(player)
	local bag = self:Get(player)
	local keep = {}
	local removed = 0
	local holders = self:ToolHolders(player)
	-- อันที่ถือในมือมาก่อน
	table.sort(holders, function(a, b)
		return a == player.Character and b ~= player.Character
	end)
	for _, holder in ipairs(holders) do
		for _, t in ipairs(holder:GetChildren()) do
			local id = t:IsA("Tool") and not t:GetAttribute("StructureKind") and t:GetAttribute("ItemId")
			if id and Items.Data[id] and Items.Data[id].Category == "Tool" then
				if keep[id] or (bag[id] or 0) <= 0 then
					t:Destroy()
					removed += 1
				else
					keep[id] = t
				end
			end
		end
	end
	return removed
end

function InventoryService:GiveTool(player, id)
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then
		return
	end
	for _, container in ipairs(self:ToolHolders(player)) do
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t:GetAttribute("ItemId") == id then
				return
			end
		end
	end
	local tool = ToolFactory.Build(id)
	if tool then
		tool.Parent = backpack
	end
end

-- สิ่งก่อสร้างที่มีอยู่ -> Tool 1 อันต่อชนิดในแถบเครื่องมือ (ชื่อ + จำนวน + รูป) · หมดแล้วลบ Tool
function InventoryService:SyncStructureTools(player)
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then
		return
	end
	local bag = self:Get(player)
	local have = {}
	for _, holder in ipairs({ backpack, player.Character }) do
		for _, t in ipairs(holder and holder:GetChildren() or {}) do
			local kind = t:IsA("Tool") and (t:GetAttribute("StructureKind") or t:GetAttribute("MedKind"))
			if kind then
				if (bag[kind] or 0) <= 0 or have[kind] then
					t:Destroy()
				else
					have[kind] = t
				end
			end
		end
	end
	for id, n in pairs(bag) do
		local item = Items.Data[id]
		local med = item and item.Category == "Medical"
		if n > 0 and item and (item.Category == "Structure" or med) then
			local t = have[id]
			if not t then
				t = Instance.new("Tool")
				t.RequiresHandle = false
				t.CanBeDropped = false
				t.TextureId = ItemThumbs.Url(id)
				t:SetAttribute(med and "MedKind" or "StructureKind", id)
				if med then
					-- ยามีช่องของตัวเองในแถบเครื่องมือ (ไม่กินที่กระสอบ) · ถือแล้วคลิก = ช่วยเพื่อนที่ล้มใกล้ๆ ก่อน ไม่มีก็พันแผลตัวเอง
					--   ถือแล้วเห็นของในมือ (โมเดลจริง) · ใช้ = ท่าพันแผล + หลอดรอ (SurvivalService:UseMedical)
					ToolFactory.DressMedical(t, id)
					t.Activated:Connect(function()
						self.ctx.Services.SurvivalService:UseMedical(player, id)
					end)
				end
				t.Parent = backpack
			end
			t.Name = string.format("%s x%d", item.Thai, n)
			t:SetAttribute("Count", n)
			t.ToolTip = med and string.format("%s x%d · Click = revive downed teammate / heal yourself", item.Thai, n)
				or string.format("%s x%d · Click = place · R = rotate", item.Thai, n)
		end
	end
end

-- ใส่ของตรงๆ (ของเริ่มต้น/ซื้อ/คราฟต์) — ไม่สนความจุ
function InventoryService:Add(player, id, n, silent)
	n = n or 1
	if n <= 0 or not Items.Data[id] then
		return
	end
	local bag = self:Get(player)
	if Items.Sacks[id] then
		-- กระสอบมีได้ใบเดียว: ได้ใบใหญ่กว่า -> แทนใบเก่า · ได้ใบเล็กกว่า/เท่าเดิม -> ไม่รับ
		local best = self:BestSack(player)
		if best and Items.Sacks[best] >= Items.Sacks[id] then
			return
		end
		local wasHolding = false
		for sid in pairs(Items.Sacks) do
			if bag[sid] then
				bag[sid] = nil
				wasHolding = self:DestroyTool(player, sid) or wasHolding
			end
		end
		bag[id] = 1
		self:GiveTool(player, id)
		if wasHolding then
			self:EquipItem(player, id)
		end
		markDirty(player)
		if not silent then
			self.ctx.Remotes.Get("HitFx"):FireClient(player, "Pickup", { Item = id, Count = 1 })
		end
		return
	end
	if Limits.Structures[id] then
		local room = self:Room(player, id)
		if room < n then
			self.ctx.Notify(player, self:LimitText(id) .. " — maxed out", "Error")
			n = room
		end
		if n <= 0 then
			return
		end
		if Limits.Structures[id].Scope == "Server" then
			markAll()
		end
	end
	bag[id] = (bag[id] or 0) + n
	if Items.Data[id].Category == "Tool" then
		bag[id] = 1
		self:GiveTool(player, id)
	end
	markDirty(player)
	if not silent then
		self.ctx.Remotes.Get("HitFx"):FireClient(player, "Pickup", { Item = id, Count = n })
	end
end

-- เก็บของเข้ากระสอบตามที่ว่าง -> คืนจำนวนที่ใส่ได้
function InventoryService:AddToSack(player, id, n)
	local fit = math.min(n, self:Space(player))
	if fit > 0 then
		self:Add(player, id, fit)
		local order = self.order[player] or {}
		self.order[player] = order
		for _ = 1, fit do
			table.insert(order, id)
		end
	end
	return fit
end

-- ของชิ้นล่าสุดที่ยังอยู่ในกระสอบ (กด F ทิ้งตามลำดับ เข้าหลังออกก่อน)
function InventoryService:LastItem(player)
	local bag = self:Get(player)
	local order = self.order[player] or {}
	while #order > 0 do
		local id = order[#order]
		if (bag[id] or 0) > 0 and Items.Bulk(id) then
			return id
		end
		table.remove(order)
	end
	-- ของที่ได้มาทางอื่น (ของเริ่มต้น/คราฟต์)
	for id, n in pairs(bag) do
		if n > 0 and Items.Bulk(id) then
			return id
		end
	end
	return nil
end

function InventoryService:PopOrder(player, id)
	local order = self.order[player]
	if not order then
		return
	end
	for i = #order, 1, -1 do
		if order[i] == id then
			table.remove(order, i)
			return
		end
	end
end

-- ถือกระสอบอยู่ไหม
function InventoryService:HoldingSack(player)
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool:GetAttribute("Kind") == "Sack"
end

function InventoryService:Remove(player, id, n)
	n = n or 1
	local bag = self:Get(player)
	if (bag[id] or 0) < n then
		return false
	end
	bag[id] -= n
	if bag[id] <= 0 then
		bag[id] = nil
	end
	markDirty(player)
	return true
end

function InventoryService:Has(player, cost, mult, inCamp)
	if inCamp == nil then
		inCamp = self:InCamp(player)
	end
	for id, n in pairs(cost) do
		local need = math.max(1, math.ceil(n * (mult or 1)))
		if self:Available(player, id, inCamp) < need then
			return false
		end
	end
	return true
end

-- ใช้ของ: กระสอบก่อน แล้วค่อยคลังแคมป์
function InventoryService:Spend(player, cost, mult)
	local inCamp = self:InCamp(player)
	if not self:Has(player, cost, mult, inCamp) then
		return false
	end
	local bag = self:Get(player)
	local touchedCamp = false
	local function take(id, need)
		local fromBag = math.min(need, bag[id] or 0)
		bag[id] = (bag[id] or 0) - fromBag
		if bag[id] <= 0 then
			bag[id] = nil
		end
		local rest = need - fromBag
		if rest > 0 and inCamp then
			camp[id] = (camp[id] or 0) - rest
			if camp[id] <= 0 then
				camp[id] = nil
			end
			touchedCamp = true
		end
	end
	for id, n in pairs(cost) do
		local need = math.max(1, math.ceil(n * (mult or 1)))
		local group = Items.AnyGroups[id]
		if group then
			-- "ธาตุไหนก็ได้": หยิบจากชนิดที่มีเยอะสุดก่อนทีละชิ้น
			for _ = 1, need do
				local best, bestN = nil, 0
				for _, g in ipairs(group) do
					local a = self:Available(player, g, inCamp)
					if a > bestN then
						best, bestN = g, a
					end
				end
				if best then
					take(best, 1)
				end
			end
		else
			take(id, need)
		end
	end
	if touchedCamp then
		markAll()
	else
		markDirty(player)
	end
	return true
end

-- เทวัตถุดิบในกระสอบลงคลังแคมป์ -> คืนจำนวนชิ้น
function InventoryService:Deposit(player)
	local bag = self:Get(player)
	local moved, got = 0, {}
	for id, n in pairs(bag) do
		local d = Items.Data[id]
		if d and DEPOSIT[d.Category] and n > 0 then
			camp[id] = (camp[id] or 0) + n
			bag[id] = nil
			moved += n
			got[id] = n
		end
	end
	if moved > 0 then
		markAll()
	end
	return moved, got
end

function InventoryService:MarkAll()
	markAll()
end

function InventoryService:ResetCamp()
	table.clear(camp)
	markAll()
end

-- คืนคลังแคมป์ (รอบที่ทีมออกไปหมดแล้วกลับมาเล่นต่อ — RejoinService)
function InventoryService:SetCamp(t)
	table.clear(camp)
	for id, n in pairs(t or {}) do
		if type(n) == "number" and n > 0 and Items.Data[id] then
			camp[id] = n
		end
	end
	markAll()
end

function InventoryService:Reset(player)
	inv[player] = {}
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		backpack:ClearAllChildren()
	end
	if player.Character then
		for _, t in ipairs(player.Character:GetChildren()) do
			if t:IsA("Tool") then
				t:Destroy()
			end
		end
	end
	markDirty(player)
end

-- ---------------------------------------------------------------- จำนวนสูงสุด (Limits)
-- จำนวนที่ "มี" ตาม scope: ถือในกระเป๋า + วางอยู่ในแมพ
function InventoryService:LimitCount(player, id)
	local lim = Limits.Structures[id]
	if not lim then
		return 0
	end
	local n = 0
	if lim.Scope == "Server" then
		for p, bag in pairs(inv) do
			if p.Parent then
				n += bag[id] or 0
			end
		end
	else
		n = self:Count(player, id)
	end
	if id == "Bed" or id == "Bed2" then
		-- เตียง = โควต้าข้ามวัน: นับที่ใช้ไปแล้ว (เตียงพังก็ไม่คืน)
		return n + (self.ctx.State:GetAttribute(id == "Bed" and "BedsUsed" or "Bed2Used") or 0)
	end
	for _, m in ipairs(CollectionService:GetTagged("Structure")) do
		if m:GetAttribute("Kind") == id and (lim.Scope == "Server" or m:GetAttribute("Owner") == player.UserId) then
			n += 1
		end
	end
	return n
end

-- ได้เพิ่มอีกกี่ชิ้น (math.huge = ไม่จำกัด)
function InventoryService:Room(player, id)
	local lim = Limits.Structures[id]
	if not lim then
		return math.huge
	end
	return math.max(0, lim.Max - self:LimitCount(player, id))
end

function InventoryService:LimitText(id)
	local lim = Limits.Structures[id]
	return lim and string.format("%s: max %d %s", Items.DisplayName(id), lim.Max, lim.Scope == "Server" and "per game (whole server)" or "per player") or ""
end

-- ตั้ง attribute จำนวนปัจจุบันให้ client (หน้าคราฟต์โชว์ 3/8)
function InventoryService:SyncLimits(player)
	for id in pairs(Limits.Structures) do
		player:SetAttribute(Limits.AttrName(id), self:LimitCount(player, id))
	end
end

function InventoryService:MarkDirty(player)
	if player then
		markDirty(player)
	else
		markAll()
	end
end

-- กระสอบใบที่ใหญ่สุดที่มี (nil = ไม่มีกระสอบ)
function InventoryService:BestSack(player)
	local bag = self:Get(player)
	local best
	for id, c in pairs(Items.Sacks) do
		if (bag[id] or 0) > 0 and (not best or c > Items.Sacks[best]) then
			best = id
		end
	end
	return best
end

-- ลบ Tool ของไอเทมนี้ออกจากเป้/มือ -> คืน true ถ้าถืออยู่ในมือ
function InventoryService:DestroyTool(player, id)
	local holding = false
	for _, holder in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		for _, t in ipairs(holder and holder:GetChildren() or {}) do
			if t:IsA("Tool") and t:GetAttribute("ItemId") == id then
				holding = holding or holder == player.Character
				t:Destroy()
			end
		end
	end
	return holding
end

function InventoryService:EquipItem(player, id)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChild("Backpack")
	if not (hum and backpack and hum.Health > 0) then
		return false
	end
	for _, t in ipairs(backpack:GetChildren()) do
		if t:IsA("Tool") and t:GetAttribute("ItemId") == id then
			hum:EquipTool(t)
			return true
		end
	end
	return false
end

-- อาวุธหลักที่ให้ถือตอนเกิด: ขวานที่ดีที่สุด (หรือคทา/อาวุธคลาส ถ้าไม่มีขวาน)
function InventoryService:BestAxe(player)
	local bag = self:Get(player)
	local best, bestChop
	for id, n in pairs(bag) do
		local t = n > 0 and Items.Tools[id]
		if t and (t.Kind == "Axe" or t.Kind == "Staff") then
			local chop = (t.Chop or 0) + (t.Kind == "Axe" and 0.01 or 0) -- เท่ากัน -> เลือกขวาน
			if not best or chop > bestChop then
				best, bestChop = id, chop
			end
		end
	end
	return best
end

-- ลำดับช่องในแถบเครื่องมือ: ขวาน -> กระสอบ -> อื่นๆ
local function toolOrder(id)
	local t = Items.Tools[id]
	if t and t.Kind == "Axe" then
		return 1
	elseif Items.Sacks[id] then
		return 2
	elseif t and t.Kind == "Staff" then
		return 3
	end
	return 4
end
InventoryService.ToolOrder = toolOrder

-- คืน Tool ทุกชิ้นหลังเกิดใหม่
function InventoryService:RestoreTools(player)
	local ids = {}
	for id, n in pairs(self:Get(player)) do
		if n > 0 and Items.Data[id] and Items.Data[id].Category == "Tool" then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		local oa, ob = toolOrder(a), toolOrder(b)
		if oa ~= ob then
			return oa < ob
		end
		return a < b
	end)
	self:DedupeTools(player)
	for _, id in ipairs(ids) do
		self:GiveTool(player, id)
	end
	markDirty(player)
end

function InventoryService:Start(ctx)
	Players.PlayerRemoving:Connect(function(p)
		dirty[p] = nil
		-- ล้างทีหลัง: ให้ระบบอื่น (RejoinService) อ่านของในกระสอบตอนออกเกมได้ก่อน
		task.defer(function()
			inv[p] = nil
			dirty[p] = nil
			self.order[p] = nil
		end)
	end)
	-- ส่งข้อมูลเมื่อมีการเปลี่ยน (รวมเป็นรอบละครั้ง): { Bag, Camp, Cap, Used }
	task.spawn(function()
		local remote = ctx.Remotes.Get("Inventory")
		task.spawn(function()
			-- กวาดเครื่องมือซ้ำเป็นระยะ (กันกรณีที่ไม่ผ่าน markDirty)
			while true do
				task.wait(2)
				for _, p in ipairs(Players:GetPlayers()) do
					if inv[p] and self:DedupeTools(p) > 0 then
						warn("[Inventory] removed duplicate tools for " .. p.Name)
					end
				end
			end
		end)
		while true do
			task.wait(0.15)
			for p in pairs(dirty) do
				dirty[p] = nil
				if p.Parent then
					self:SyncStructureTools(p)
					self:DedupeTools(p)
					self:SyncLimits(p)
					local cap, used = self:Capacity(p), self:Used(p)
					remote:FireClient(p, { Bag = self:Get(p), Camp = camp, Cap = cap, Used = used })
					-- โชว์จำนวนในกระสอบบนช่องเครื่องมือ เช่น "กระสอบเก่า 3/10"
					for _, c in ipairs({ p:FindFirstChild("Backpack"), p.Character }) do
						for _, t in ipairs(c and c:GetChildren() or {}) do
							local id = t:IsA("Tool") and t:GetAttribute("ItemId")
							if id and Items.Sacks[id] then
								t.Name = string.format("%s %d/%d", Items.DisplayName(id), used, Items.Sacks[id])
								t:SetAttribute("Fill", string.format("%d/%d", used, Items.Sacks[id]))
							end
						end
					end
				end
			end
		end
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006A"><Properties><string name="Name">LobbyService</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyService — ล็อบบี้แบบ 99 Nights in the Forest
	  ค่ายฟาร์มกลางป่ายามค่ำคืน: พื้นดิน + ทางเดินไม้กระดาน, รั้วไม้สูงรอบค่าย, โรงนา/กังหันลม/ต้นไม้ใบเหลี่ยมเป็นฉากหลัง
	  ทางเข้า (ใต้): ลานไม้จุดเกิด + ซุ้มประตูไม้ซุง "WILDHEART CAMP"
	  กลาง: เต็นท์ "Classes" (ร้านคลาส + เวทีโชว์หุ่นที่กล้องร้านคลาสเล็ง) + กระดานข่าว
	  ซ้าย: หม้อรางวัลประจำวัน (Ruby ฟรี) + กระดานคนรอดนานสุด + แคมป์ไฟ
	  ขวา: แท่น "เริ่มเกม" เรืองแสง 4 แท่น — ขึ้นไปยืน เลือกขนาดทีม 1-5 คน -> คนครบ/หมดเวลา = ออกเดินทาง

	ออกเดินทาง:
	  - เกม publish แล้ว: ทั้งทีมถูกส่งไปเซิร์ฟเวอร์ส่วนตัวของทีม (TeleportService reserved server) เหมือนต้นฉบับ
	  - ใน Studio / เซิร์ฟเวอร์ของทีมเอง: ลงแมพในเซิร์ฟเวอร์นี้เลย
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local UserService = game:GetService("UserService")
local Workspace = game:GetService("Workspace")

local Shop = require(ReplicatedStorage.Shared.Shop)
local MeshProps = require(ReplicatedStorage.Shared.MeshProps)
local BaseDecor = require(ReplicatedStorage.Shared.BaseDecor)
local PropBuilder = require(ReplicatedStorage.Shared.PropBuilder)
local Config = require(ReplicatedStorage.Shared.Config)
local Classes = require(ReplicatedStorage.Shared.Classes)

local LobbyService = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB

LobbyService.Position = V(12000, 1799, 12000) -- ไกลนอกแมพ · Y 1799 = ผิวพื้น (y+1) ตรงเส้นตาราง voxel 4 studs ของ Terrain พอดี (หญ้าไม่ล้นขึ้นมาท่วมของ)
local COUNTDOWN = 20
local COUNTDOWN_FULL = 5
local COUNTDOWN_JOIN = 4

function LobbyService:Init(ctx)
	self.ctx = ctx
	self.boxes = {}
	-- เซิร์ฟเวอร์ที่ถูกจองให้ทีม (มาจากล็อบบี้) = เริ่มเล่นเลย ไม่ต้องมีล็อบบี้
	self.IsTeamServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
	-- หน้าโหลดฝั่งผู้เล่นใช้: เซิร์ฟเวอร์ทีม = ข้ามการโหลดค่าย แล้วรอจนลงแมพจริงค่อยเปิดจอ (ไม่โหลด 2 รอบ)
	ctx.State:SetAttribute("TeamServer", self.IsTeamServer)
end

local function P(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	props.ClassName = nil
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function cyl(parent, h, d, cf, color, mat)
	return P(parent, { Shape = Enum.PartType.Cylinder, Size = V(h, d, d), CFrame = cf * ANG(0, 0, math.pi / 2), Color = color, Material = mat })
end

local function label(parent, face, text, color, font)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.PixelsPerStud = 30
	sg.Parent = parent
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextScaled = true
	t.Font = font or Enum.Font.GothamBlack
	t.TextColor3 = color or C(255, 224, 150)
	t.Parent = sg
	return t
end

local function sign(parent, text, cf, size, color)
	local board = P(parent, { Size = size or V(14, 4, 0.6), CFrame = cf, Color = C(60, 44, 32), Material = Enum.Material.Wood })
	local a = label(board, Enum.NormalId.Front, text, color)
	label(board, Enum.NormalId.Back, text, color)
	return board, a
end

local function prompt(parent, action, object, key, dist)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = key or Enum.KeyCode.E
	p.MaxActivationDistance = dist or 14
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

local function mesh(kind, cf, parent, scale)
	if not MeshProps.Has(kind) then
		return nil
	end
	local m = MeshProps.Build(kind)
	if scale and scale ~= 1 then
		pcall(function()
			m:ScaleTo(scale)
		end)
	end
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

-- คนในเต็นท์คลาส (ที่ปรึกษาค่าย)
local function shopkeeper(parent, cf)
	local m = Instance.new("Model")
	m.Name = "Counselor"
	local coat = C(70, 90, 60)
	local body = P(m, { Name = "Body", Size = V(2.4, 3.2, 1.6), CFrame = cf * CF(0, 3.6, 0), Color = coat, Material = Enum.Material.Fabric })
	P(m, { Shape = Enum.PartType.Ball, Size = V(1.8, 1.8, 1.8), CFrame = cf * CF(0, 6, 0), Color = C(224, 184, 150) })
	P(m, { Size = V(2.6, 0.4, 2.6), CFrame = cf * CF(0, 6.9, 0), Color = C(90, 60, 40), Material = Enum.Material.Fabric })
	P(m, { Size = V(1.6, 1.2, 1.6), CFrame = cf * CF(0, 7.4, 0), Color = C(90, 60, 40), Material = Enum.Material.Fabric })
	P(m, { Size = V(2.2, 0.5, 0.4), CFrame = cf * CF(0, 5.3, -0.9), Color = C(150, 120, 90), Material = Enum.Material.Fabric })
	for _, x in ipairs({ -0.6, 0.6 }) do
		P(m, { Size = V(0.8, 2, 0.8), CFrame = cf * CF(x, 1, 0), Color = C(60, 46, 36) })
	end
	m.PrimaryPart = body
	m.Parent = parent
	return m, body
end

---------------------------------------------------------------- ชิ้นส่วนค่ายแบบ 99 Nights (ฟาร์ม/แคมป์ยามค่ำคืน)
local WOOD = { C(112, 80, 54), C(98, 70, 48), C(124, 90, 60), C(88, 62, 42) }
local LEAF = { C(44, 92, 52), C(52, 104, 56), C(38, 80, 48), C(60, 112, 60) }

local function light(part, color, range, brightness, shadows)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, shadows == true
	l.Parent = part
	return l
end

local function fireOn(part, size)
	if PropBuilder.RealFire(part, size / 4) then
		return part
	end
	local f = Instance.new("Fire")
	f.Size = size
	f.Heat = size * 1.3
	f.Parent = part
	return f
end

-- ลานไม้ (ดาดฟ้า) สี่เหลี่ยม
local function deck(parent, cf, w, d, rng)
	for x = -w / 2 + 1, w / 2 - 1, 2.1 do
		P(parent, { Size = V(1.95, 0.5, d), CFrame = cf * CF(x, 0.25, rng:NextNumber(-0.3, 0.3)), Color = WOOD[rng:NextInteger(1, #WOOD)], Material = Enum.Material.WoodPlanks })
	end
	for _, z in ipairs({ -d / 2 + 0.6, d / 2 - 0.6 }) do
		P(parent, { Size = V(w + 0.6, 0.7, 1), CFrame = cf * CF(0, 0.35, z), Color = C(78, 56, 40), Material = Enum.Material.Wood })
	end
end

-- เสาตะเกียง
-- เปลวไฟวิญญาณสีฟ้า (VFX): แกนเปลวขาวฟ้า + เปลวฟ้าพลิ้ว + ประกายลอยขึ้น + ออร่าเรืองนุ่มๆ · ก้อนนีออนเดิมกลายเป็นคริสตัลโปร่ง
local function seqN(t)
	local ks = {}
	for _, k in ipairs(t) do
		table.insert(ks, NumberSequenceKeypoint.new(k[1], k[2]))
	end
	return NumberSequence.new(ks)
end
local function spiritFlame(host, scale)
	scale = scale or 1
	-- ก้อนคริสตัลเดิมซ่อน (ไม่มีแท่งนีออน) เหลือแค่เปลวไฟเกิดตรงฐานคริสตัล = บนหัวเสาหิน
	host.Transparency = 1
	host.CastShadow = false
	local att = Instance.new("Attachment")
	att.Parent = host
	att.WorldCFrame = CFrame.new(host.Position - V(0, host.Size.Y * 0.45, 0))
	-- เปลวไฟฟ้าจาก Creator Store (Assets.VFX.BlueSoul) ขยายตามสเกล · จำกัด Rate ไม่ให้หนักเครื่อง
	local src = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("VFX")
	src = src and src:FindFirstChild("BlueSoul")
	if src then
		for _, e in ipairs(src:GetDescendants()) do
			if e:IsA("ParticleEmitter") then
				local c = e:Clone()
				local ks = {}
				for _, k in ipairs(e.Size.Keypoints) do
					table.insert(ks, NumberSequenceKeypoint.new(k.Time, k.Value * 1.6 * scale, k.Envelope * 1.6 * scale))
				end
				c.Size = NumberSequence.new(ks)
				c.Speed = NumberRange.new(e.Speed.Min * scale, e.Speed.Max * scale)
				c.Rate = math.min(e.Rate, 220)
				c.Enabled = true
				c.Parent = att
			end
		end
	end
	-- ประกายลอยขึ้นช้าๆ รอบเปลว
	local sp = Instance.new("ParticleEmitter")
	sp.Name = "SpiritSparks"
	sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sp.LightEmission, sp.LightInfluence = 1, 0
	sp.Rate = 5
	sp.Lifetime = NumberRange.new(1.4, 2.4)
	sp.Speed = NumberRange.new(1.5 * scale, 3 * scale)
	sp.SpreadAngle = Vector2.new(35, 35)
	sp.Drag = 1
	sp.Size = seqN({ { 0, 0.2 * scale }, { 1, 0 } })
	sp.Color = ColorSequence.new(C(190, 245, 255), C(120, 160, 255))
	sp.Parent = att
	light(host, C(110, 210, 255), 18 * scale, 1.6)
end

local function lanternPost(parent, cf, h)
	h = h or 8
	P(parent, { Size = V(0.8, h, 0.8), CFrame = cf * CF(0, h / 2, 0), Color = C(70, 50, 36), Material = Enum.Material.Wood })
	P(parent, { Size = V(0.4, 0.4, 2.2), CFrame = cf * CF(0, h - 0.4, -0.9), Color = C(70, 50, 36), Material = Enum.Material.Wood })
	local lamp = P(parent, { Size = V(1, 1.3, 1), CFrame = cf * CF(0, h - 1.5, -1.8), Color = C(255, 206, 130), Material = Enum.Material.Neon, CanCollide = false })
	P(parent, { Size = V(1.3, 0.2, 1.3), CFrame = cf * CF(0, h - 0.75, -1.8), Color = C(40, 36, 34), Material = Enum.Material.Metal, CanCollide = false })
	light(lamp, C(255, 186, 110), 22, 1.8)
	return lamp
end

-- ตอไม้มีไฟลุก (แบบหน้าเต็นท์ Classes)
local function fireStump(parent, cf, brightness, range)
	cyl(parent, 3, 3.4, cf * CF(0, 1.5, 0), C(120, 86, 58), Enum.Material.Wood)
	P(parent, { Shape = Enum.PartType.Cylinder, Size = V(0.1, 3, 3), CFrame = cf * CF(0, 3.02, 0) * ANG(0, 0, math.pi / 2), Color = C(70, 50, 36), Material = Enum.Material.Wood })
	local core = P(parent, { Size = V(1, 1, 1), CFrame = cf * CF(0, 3.6, 0), Transparency = 1, CanCollide = false })
	fireOn(core, 4)
	light(core, C(255, 150, 70), range or 26, brightness or 2.4, true)
end

local function crate(parent, cf, s)
	s = s or 3
	P(parent, { Size = V(s, s, s), CFrame = cf * CF(0, s / 2, 0), Color = C(150, 110, 70), Material = Enum.Material.WoodPlanks })
	P(parent, { Size = V(s * 1.42, 0.3, 0.32), CFrame = cf * CF(0, s / 2, -s / 2 - 0.05) * ANG(0, 0, math.rad(45)), Color = C(110, 78, 50), Material = Enum.Material.Wood })
end

-- กล่องชนของกระท่อม Classes: สแกนจากเมชจริงใน Blender (เสา ผนังหลัง ราวข้าง โต๊ะหน้า ชั้นวาง)
-- { x0, x1, z0, z1 } เป็นสัดส่วนของขนาดกระท่อม (กลาง = 0, หน้า = -z) สูงจากพื้นไม้ ~7.5 stud
local HUT_COLLIDERS = {
	{ 0.365, 0.392, -0.417, -0.362 }, { 0.392, 0.419, -0.390, -0.224 }, { 0.338, 0.365, -0.390, -0.362 }, { -0.308, -0.227, -0.390, -0.362 },
	{ 0.419, 0.446, -0.334, -0.307 }, { 0.311, 0.392, -0.334, -0.279 }, { -0.308, -0.281, -0.334, 0.301 }, { -0.254, -0.173, -0.307, -0.224 },
	{ 0.419, 0.446, -0.279, -0.058 }, { 0.311, 0.365, -0.279, -0.252 }, { -0.120, 0.231, -0.279, -0.169 }, { -0.281, -0.254, -0.279, -0.252 },
	{ -0.335, -0.308, -0.279, -0.252 }, { 0.446, 0.473, -0.252, -0.141 }, { 0.365, 0.392, -0.252, -0.196 }, { 0.338, 0.365, -0.224, -0.141 },
	{ -0.443, -0.308, -0.224, -0.113 }, { 0.365, 0.392, -0.169, -0.003 }, { -0.173, -0.147, -0.169, -0.141 }, { 0.338, 0.365, -0.113, -0.003 },
	{ -0.362, -0.308, -0.113, 0.301 }, { -0.443, -0.389, -0.113, -0.086 }, { -0.416, -0.362, -0.086, -0.058 }, { -0.416, -0.389, -0.058, 0.329 },
	{ 0.392, 0.446, -0.030, 0.080 }, { 0.150, 0.177, -0.030, 0.025 }, { 0.338, 0.365, 0.025, 0.163 }, { -0.039, -0.012, 0.025, 0.053 },
	{ -0.281, -0.254, 0.053, 0.301 }, { 0.392, 0.419, 0.080, 0.301 }, { -0.389, -0.362, 0.080, 0.329 }, { -0.443, -0.416, 0.135, 0.246 },
	{ -0.254, -0.227, 0.163, 0.218 }, { 0.446, 0.473, 0.191, 0.274 }, { -0.200, -0.173, 0.218, 0.329 }, { 0.365, 0.392, 0.246, 0.274 },
	{ 0.231, 0.284, 0.246, 0.329 }, { 0.123, 0.204, 0.246, 0.357 }, { -0.120, -0.012, 0.246, 0.301 }, { -0.173, -0.147, 0.246, 0.329 },
	{ -0.227, -0.200, 0.246, 0.357 }, { 0.419, 0.446, 0.274, 0.301 }, { -0.012, 0.123, 0.274, 0.329 }, { -0.443, -0.416, 0.274, 0.329 },
	{ 0.284, 0.392, 0.301, 0.329 }, { 0.204, 0.231, 0.301, 0.357 }, { -0.147, -0.039, 0.301, 0.357 }, { -0.470, -0.443, 0.301, 0.329 },
	{ 0.069, 0.123, 0.329, 0.357 }, { -0.039, 0.042, 0.329, 0.357 },
}

-- เต็นท์ Classes (ผ้าใบสีเขียวขี้ม้า หน้าเปิด) + เวทีโชว์หุ่น
local function classesTent(self, parent, cf)
	local W, D, H, E = 40, 32, 22, 9
	local canvas, canvasDark = C(134, 130, 70), C(108, 104, 56)
	local rng = Random.new(77)
	-- กระท่อม Classes (โมเดล Import) แทนเต็นท์ผ้าใบ: ของตกแต่งที่ทำเองข้างล่างจะซ่อนไว้ ใช้แค่ภายใน (เคาน์เตอร์ เวที)
	-- Import 3D ของ Roblox หมุนโมเดลให้หน้า (ป้าย Classes) อยู่ทาง -Z แล้ว = ทางเดียวกับหน้าเต็นท์ · ยกให้พ้นพื้นไม้ของลาน
	local hut = PropBuilder.Imported("ClassHut", cf * CF(0, 1.3, 0), W + 6, parent)
	local tentFolder = parent
	local hutDeck, hutSize, hutUnit
	if hut then
		hut.Name = "ClassHut"
		for _, d in ipairs(hut:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false -- เดินเข้าได้ (พื้น/ผนังชนด้วยกล่องล่องหนด้านล่าง)
			end
		end
		-- เมชนี้ถูกดึงลงตามกระดูกราก (Y -0.83 ของความสูง 1.7) -> ยกกลับให้ฐานจริงแตะพื้น
		local mesh = hut:FindFirstChildWhichIsA("MeshPart", true)
		local unit = mesh and mesh.Size.Y / 1.7 or 14
		hut:PivotTo(hut:GetPivot() + V(0, 0.832 * unit, 0))
		local _, hs = hut:GetBoundingBox()
		-- พื้นไม้ในกระท่อม (วัดจากโมเดล: สูง 0.13 จากฐาน)
		hutDeck = 1.3 + 0.13 * unit
		hutSize = hs
		hutUnit = unit
		P(parent, { Name = "HutFloor", Size = V(hs.X * 0.9, 1, hs.Z * 0.85), CFrame = cf * CF(0, hutDeck - 0.5, 0), Transparency = 1 })
		-- ผนัง/เสา/โต๊ะ ชนได้จริง (เมชกระท่อมปิดการชนไว้ เพราะการชนแบบเมชจะอุดทางเข้าทั้งหลัง)
		local walls = Instance.new("Folder")
		walls.Name = "HutColliders"
		for _, b in ipairs(HUT_COLLIDERS) do
			local sx, sz = (b[2] - b[1]) * hs.X, (b[4] - b[3]) * hs.Z
			P(walls, {
				Name = "HutWall", Size = V(math.max(sx, 0.6), 7.5, math.max(sz, 0.6)),
				CFrame = cf * CF((b[1] + b[2]) / 2 * hs.X, hutDeck + 3.75, (b[3] + b[4]) / 2 * hs.Z),
				Transparency = 1, CanQuery = false, CanTouch = false,
			})
		end
		-- หลังคาจั่ว (สันหลังคาวิ่งหน้า-หลัง) ชนได้: วัดจากเมชใน Blender เป็นสัดส่วนของกล่องกระท่อม
		-- ชายคาซ้าย x -0.50 สูง 0.55 · สัน x -0.05 สูง 0.91 · ชายคาขวา x 0.42 สูง 0.52 · ยาว z -0.44..0.47
		local bcf = hut:GetBoundingBox()
		local by = bcf.Y - hs.Y / 2
		for _, s in ipairs({ { -0.50, 0.55, -0.05, 0.91 }, { -0.05, 0.91, 0.42, 0.52 } }) do
			local p0 = V(s[1] * hs.X, by - cf.Y + s[2] * hs.Y, 0)
			local p1 = V(s[3] * hs.X, by - cf.Y + s[4] * hs.Y, 0)
			local d = p1 - p0
			local n = V(-d.Y, d.X, 0).Unit
			if n.Y < 0 then
				n = -n
			end
			local mid = (p0 + p1) / 2 - n * 0.6 + V(0, 0, 0.015 * hs.Z)
			P(walls, {
				Name = "HutRoof", Size = V(d.Magnitude + 1, 1.2, 0.91 * hs.Z),
				CFrame = cf * CF(mid) * ANG(0, 0, math.atan2(d.Y, d.X)),
				Transparency = 1, CanQuery = false, CanTouch = false,
			})
		end
		walls.Parent = parent
		tentFolder = Instance.new("Folder")
		tentFolder.Name = "TentHidden"
	end
	-- พื้นไม้ในเต็นท์
	deck(tentFolder, cf * CF(0, 1, 0), W - 2, D - 2, rng)
	-- หลังคาสองฝั่ง
	local slope = math.atan2(H - E, W / 2)
	local slen = math.sqrt((H - E) ^ 2 + (W / 2) ^ 2)
	for _, s in ipairs({ -1, 1 }) do
		P(tentFolder, { Size = V(slen + 1.5, 0.4, D + 3), CFrame = cf * CF(s * W / 4, (H + E) / 2 + 1, 0) * ANG(0, 0, -s * slope), Color = canvas, Material = Enum.Material.Fabric })
		-- ชายผ้าห้อยด้านหน้า
		P(tentFolder, { Size = V(slen + 1.5, 1.6, 0.2), CFrame = cf * CF(s * W / 4, (H + E) / 2 + 0.2, -D / 2 - 1.5) * ANG(0, 0, -s * slope), Color = canvasDark, Material = Enum.Material.Fabric })
		-- ผนังข้าง
		P(tentFolder, { Size = V(0.4, E, D), CFrame = cf * CF(s * W / 2, E / 2 + 1, 0), Color = canvasDark, Material = Enum.Material.Fabric })
	end
	-- ผนังหลัง + จั่ว
	P(tentFolder, { Size = V(W, E, 0.4), CFrame = cf * CF(0, E / 2 + 1, D / 2), Color = canvasDark, Material = Enum.Material.Fabric })
	for _, s in ipairs({ -1, 1 }) do
		P(tentFolder, { ClassName = "WedgePart", Size = V(0.4, H - E, W / 2), CFrame = cf * CF(s * W / 4, E + 1 + (H - E) / 2, D / 2) * ANG(0, s * -math.pi / 2, 0), Color = canvasDark, Material = Enum.Material.Fabric })
	end
	-- เสา + คานสัน
	for _, x in ipairs({ -W / 2, 0, W / 2 }) do
		local ph = (x == 0) and H + 1 or E + 1
		P(tentFolder, { Size = V(0.9, ph, 0.9), CFrame = cf * CF(x, ph / 2, -D / 2 - 0.5), Color = C(84, 62, 44), Material = Enum.Material.Wood })
	end
	P(tentFolder, { Size = V(0.8, 0.8, D + 4), CFrame = cf * CF(0, H + 1.4, 0), Color = C(84, 62, 44), Material = Enum.Material.Wood })
	-- เชือกยึด + หมุด
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -D / 2, 0, D / 2 }) do
			local a = (cf * CF(s * W / 2, E + 1, z)).Position
			local b = (cf * CF(s * (W / 2 + 7), 1, z)).Position
			P(tentFolder, { Size = V(0.12, 0.12, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b), Color = C(214, 204, 170), CanCollide = false, CanQuery = false })
			P(tentFolder, { Size = V(0.5, 1.2, 0.5), CFrame = CF(b + V(0, 0.4, 0)), Color = C(84, 62, 44), Material = Enum.Material.Wood })
		end
	end
	-- ป้าย "Classes" ไฟนีออนเขียว
	local signCf = cf * CF(0, 15.5, -D / 2 - 1.8)
	for _, x in ipairs({ -6, 6 }) do
		P(tentFolder, { Size = V(0.15, 4.5, 0.15), CFrame = signCf * CF(x, 4.2, 0), Color = C(40, 36, 34), Material = Enum.Material.Metal })
	end
	local board = P(tentFolder, { Size = V(17, 5.6, 0.6), CFrame = signCf, Color = C(80, 52, 34), Material = Enum.Material.WoodPlanks })
	P(tentFolder, { Size = V(17.8, 6.4, 0.4), CFrame = signCf * CF(0, 0, 0.2), Color = C(56, 38, 26), Material = Enum.Material.Wood })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.PixelsPerStud = 30
		sg.LightInfluence = 0
		sg.Parent = board
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 0.72)
		t.BackgroundTransparency = 1
		t.Text = "Classes"
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextColor3 = C(110, 255, 110)
		t.Parent = sg
		local st = Instance.new("UIStroke")
		st.Color, st.Thickness, st.Parent = C(20, 60, 20), 4, t
		local t2 = Instance.new("TextLabel")
		t2.Size = UDim2.fromScale(1, 0.26)
		t2.Position = UDim2.fromScale(0, 0.72)
		t2.BackgroundTransparency = 1
		t2.Text = "Class Shop · Walk in to talk"
		t2.TextScaled = true
		t2.Font = Enum.Font.GothamBold
		t2.TextColor3 = C(255, 236, 190)
		t2.Parent = sg
	end
	light(board, C(120, 255, 120), 16, 1.2)
	-- ภายใน: เคาน์เตอร์ + คนดูแลคลาส + ไวท์บอร์ด + ลังไม้ + โคมแขวน
	local counterCf = cf * CF(-11, 1.5, -6)
	P(tentFolder, { Size = V(10, 3.2, 3), CFrame = counterCf * CF(0, 1.6, 0), Color = C(110, 78, 50), Material = Enum.Material.WoodPlanks })
	P(tentFolder, { Size = V(10.6, 0.4, 3.6), CFrame = counterCf * CF(0, 3.3, 0), Color = C(140, 100, 64), Material = Enum.Material.WoodPlanks })
	-- ในกระท่อม: ที่ปรึกษายืนหลังโต๊ะยาวด้านหน้า หันออกทางเข้า
	local keeperCf = counterCf * CF(0, 0, 3.2) * ANG(0, math.pi, 0)
	if hutDeck then
		-- โต๊ะยาวในโมเดลอยู่ที่ x -0.75..0.25, y -0.85..-0.55 (หน่วยโมเดล, ด้านหน้า = -y) -> ยืนหลังโต๊ะ หันออกทางเข้า
		keeperCf = cf * CF(0.25 * hutUnit, hutDeck, -0.36 * hutUnit)
	end
	local keeper, kbody = shopkeeper(parent, keeperCf)
	-- ใช้ตัวละคร Roblox จริง (เจ้าหน้าที่อุทยาน) แทนหุ่นบล็อก
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local chars = assets and assets:FindFirstChild("Characters")
	-- คนขายคลาส: ลุงโพกผ้า (Arbang · Import จาก 3D Model/home/arbang.glb) · ยังไม่ได้ Import = เจ้าหน้าที่อุทยานเดิม
	local src = chars and (chars:FindFirstChild("Arbang") or chars:FindFirstChild("Scout"))
	if src then
		local npc = src:Clone()
		npc.Name = "CounselorModel"
		local mn, mx
		for _, d in ipairs(npc:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				if d.Transparency < 1 and d.Name ~= "HumanoidRootPart" then
					mn = mn and mn:Min(d.Position - d.Size / 2) or d.Position - d.Size / 2
					mx = mx and mx:Max(d.Position + d.Size / 2) or d.Position + d.Size / 2
				end
			end
		end
		local face = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
		local foot = Vector3.new((mn.X + mx.X) / 2, mn.Y, (mn.Z + mx.Z) / 2)
		if face then
			local look = face.CFrame.LookVector * Vector3.new(1, 0, 1)
			npc.PrimaryPart = face
			face.PivotOffset = face.CFrame:ToObjectSpace(CFrame.lookAt(foot, foot + look.Unit))
		else
			-- โมเดล Import ชิ้นเดียว (ไม่มีหัว/ราก): จุดหมุน = กลางเท้า หน้าหัน -Z · ย่อ/ขยายให้สูงเท่าคน
			npc.PrimaryPart = nil
			npc.WorldPivot = CFrame.new(foot)
			local h = mx.Y - mn.Y
			if h > 0.1 then
				pcall(function()
					npc:ScaleTo(npc:GetScale() * 5.6 / h)
				end)
			end
		end
		-- โมเดล Import 3D ชิ้นเดียว: หน้าเมชตรงกับ -Z ของจุดหมุนอยู่แล้ว (ภาพเทสแล้ว) -> วางตรงๆ หันออกหาคนเดินเข้ามา
		npc:PivotTo(keeperCf)
		npc.Parent = parent
		for _, d in ipairs(keeper:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Transparency = 1
				d.CanCollide = false
			end
		end
	end
	prompt(kbody, "View Classes", "Camp Advisor", Enum.KeyCode.E, 18).Triggered:Connect(function(p)
		self.ctx.Remotes.Get("Cinematic"):FireClient(p, "OpenClasses", {})
	end)
	if hut then
		-- ป้ายเดิมซ่อน แต่เก็บปุ่มเปิดร้านไว้ที่จุดเดิม
		board.Parent = parent
		board.Transparency = 1
		board.CanCollide = false
		board:ClearAllChildren()
	end
	if not hut then
		prompt(board, "Class Shop", "Classes", Enum.KeyCode.E, 30).Triggered:Connect(function(p)
			self.ctx.Remotes.Get("Cinematic"):FireClient(p, "OpenClasses", {})
		end)
	end
	-- ไวท์บอร์ดบนขาตั้ง (หลังเวที ซ้าย)
	local wbCf = cf * CF(-9, 1.5, D / 2 - 4) * ANG(0, math.rad(15), 0)
	local wb = P(tentFolder, { Size = V(9, 5.5, 0.3), CFrame = wbCf * CF(0, 6, 0), Color = C(196, 192, 200), Material = Enum.Material.SmoothPlastic })
	for _, x in ipairs({ -3.5, 3.5 }) do
		P(tentFolder, { Size = V(0.3, 8, 0.3), CFrame = wbCf * CF(x, 4, 0.4) * ANG(math.rad(8), 0, 0), Color = C(200, 200, 206), Material = Enum.Material.Metal })
	end
	label(wb, Enum.NormalId.Front, "Today's plan:\n1. Pick a class\n2. Step on a start pad\n3. Conquer the final night!", C(40, 60, 160), Enum.Font.GothamBold)
	-- ตอไม้มีไฟ (หลังเวที ขวา) + ลังไม้
	fireStump(tentFolder, cf * CF(10, 1.5, D / 2 - 4), 0.7, 14) -- ไฟอ่อนๆ ไม่ให้หน้าตัวละครบนเวทีสว่างจ้า
	crate(tentFolder, cf * CF(16, 1.5, D / 2 - 3))
	crate(tentFolder, cf * CF(16.5, 4.5, D / 2 - 3) * ANG(0, 0.5, 0), 2.4)
	crate(tentFolder, cf * CF(-16, 1.5, -10) * ANG(0, 0.3, 0))
	for _, z in ipairs({ -8, 6 }) do
		local lamp = P(tentFolder, { Size = V(1.2, 1.6, 1.2), CFrame = cf * CF(0, H - 4, z), Color = C(255, 214, 150), Material = Enum.Material.Neon, CanCollide = false })
		P(tentFolder, { Size = V(0.1, 4, 0.1), CFrame = cf * CF(0, H - 1.6, z), Color = C(40, 36, 34), CanCollide = false })
		light(lamp, C(255, 196, 130), 24, 0.8, true)
	end
	-- เวทีโชว์หุ่นคลาส (กล้องร้านคลาสเล็งมาที่นี่) หันหน้าเข้าหาทางเข้าเต็นท์
	local stageCf = cf * CF(0, 1.5, D / 2 - 7)
	if hutDeck then
		-- บนพื้นกระท่อม ด้านขวา-หลัง (กล้องร้านคลาสอยู่หน้าเวที 16 studs ไม่ติดที่ปรึกษา/โต๊ะ)
		stageCf = cf * CF(0.97 * hutUnit, hutDeck - 1.1, 0.35 * hutUnit)
	end
	cyl(parent, 1.2, 8, stageCf * CF(0, 0.6, 0), C(120, 84, 56), Enum.Material.WoodPlanks)
	cyl(parent, 0.5, 9, stageCf * CF(0, 0.25, 0), C(84, 60, 42), Enum.Material.Wood)
	P(parent, { Name = "ClassStage", Size = V(6, 0.2, 6), CFrame = stageCf * CF(0, 1.1, 0), Transparency = 1, CanCollide = false, CanQuery = false })
	local spot = P(parent, { Size = V(0.6, 0.6, 0.6), CFrame = stageCf * CF(0, 13, -6), Transparency = 1, CanCollide = false })
	local sl = Instance.new("SpotLight")
	sl.Face = Enum.NormalId.Bottom
	sl.Angle = 50
	sl.Range = 24
	sl.Brightness = 0.25
	sl.Color = C(255, 236, 210)
	sl.Parent = spot
end

-- หม้อรางวัลประจำวัน (หม้อดำ น้ำเขียวเรืองแสง)
local function dailyCauldron(self, parent, cf)
	-- โมเดลบ่อทับทิม (Import 3D ชื่อ RubyWell) แทนหม้อ · ไม่มีโมเดล = หม้อเดิม
	local well = PropBuilder.Imported("RubyWell", cf * ANG(0, math.pi, 0), 12, parent, true) -- หมุนกลับให้ด้านหน้าหันเข้าหาลาน · ชนได้ (ไม่เดินทะลุ)
	local pot
	if well then
		pot = P(parent, { Name = "WellAnchor", Size = V(6, 6, 6), CFrame = cf * CF(0, 3, 0), Transparency = 1, CanCollide = false, CanQuery = false })
		light(pot, C(255, 90, 130), 18, 1.4)
	else
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2
		P(parent, { Size = V(0.6, 3, 0.6), CFrame = cf * CF(math.cos(a) * 3, 1.4, math.sin(a) * 3) * ANG(math.sin(a) * 0.3, 0, -math.cos(a) * 0.3), Color = C(30, 30, 34), Material = Enum.Material.Metal })
	end
	pot = cyl(parent, 4, 7.5, cf * CF(0, 4, 0), C(32, 32, 36), Enum.Material.Metal)
	P(parent, { Shape = Enum.PartType.Ball, Size = V(7.8, 4, 7.8), CFrame = cf * CF(0, 2.6, 0), Color = C(32, 32, 36), Material = Enum.Material.Metal })
	cyl(parent, 0.6, 8.2, cf * CF(0, 6, 0), C(46, 46, 52), Enum.Material.Metal)
	local liquid = P(parent, { Shape = Enum.PartType.Cylinder, Size = V(0.3, 7, 7), CFrame = cf * CF(0, 5.9, 0) * ANG(0, 0, math.pi / 2), Color = C(90, 255, 110), Material = Enum.Material.Neon, CanCollide = false })
	light(liquid, C(90, 255, 120), 22, 2.6)
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Rate = 14
	bubbles.Lifetime = NumberRange.new(0.8, 1.6)
	bubbles.Speed = NumberRange.new(1, 3)
	bubbles.SpreadAngle = Vector2.new(20, 20)
	bubbles.LightEmission = 1
	bubbles.Size = NumberSequence.new(0.6, 0)
	bubbles.Color = ColorSequence.new(C(150, 255, 150))
	bubbles.EmissionDirection = Enum.NormalId.Right
	bubbles.Parent = liquid
	-- ไฟใต้หม้อ
	local under = P(parent, { Size = V(1, 1, 1), CFrame = cf * CF(0, 0.6, 0), Transparency = 1, CanCollide = false })
	fireOn(under, 3)
	for i = 0, 3 do
		cyl(parent, 4, 0.8, cf * CF(0, 0.5, 0) * ANG(0, i * math.pi / 4, 0) * ANG(0, 0, -math.pi / 2), C(90, 64, 44), Enum.Material.Wood)
	end
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(15, 4.4)
	bb.StudsOffset = V(0, 9, 0)
	bb.MaxDistance = 160
	bb.LightInfluence = 0
	bb.Parent = pot
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 0.6)
	t.BackgroundTransparency = 1
	t.Text = "Daily Reward ♦️"
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = C(130, 255, 120)
	t.Parent = bb
	local s1 = Instance.new("UIStroke")
	s1.Thickness, s1.Parent = 2.5, t
	local t2 = Instance.new("TextLabel")
	t2.Size = UDim2.fromScale(1, 0.38)
	t2.Position = UDim2.fromScale(0, 0.62)
	t2.BackgroundTransparency = 1
	t2.Text = "- Free Ruby every day -"
	t2.TextScaled = true
	t2.Font = Enum.Font.GothamBold
	t2.TextColor3 = C(255, 255, 255)
	t2.Parent = bb
	local s2 = Instance.new("UIStroke")
	s2.Thickness, s2.Parent = 2, t2
	prompt(pot, "Claim Daily Reward", "Magic Cauldron", Enum.KeyCode.E, 14).Triggered:Connect(function(p)
		self.ctx.Services.DataService:ClaimDaily(p)
	end)
end

-- ประตูมิติ (โมเดลหินจาก tools/lobby_art.py) -> ใส่ไฟ อนุภาค ป้าย 0/4 กลางม่าน เลขบนพื้น และโซนยืน
local PORTAL_IDLE, PORTAL_VEIL, PORTAL_GO, PORTAL_GO_VEIL = C(70, 230, 255), C(30, 190, 255), C(110, 245, 140), C(80, 230, 130)
local function portalHook(art, parent, i)
	local center = art:FindFirstChild("PortalCenter" .. i, true)
	local ring = art:FindFirstChild("PortalRing" .. i, true)
	local veil = art:FindFirstChild("PortalVeil" .. i, true)
	if not (center and ring and veil) then
		return nil
	end
	-- เลขประตูกลางลาน
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Parent = center
	local num = Instance.new("TextLabel")
	num.Size = UDim2.fromScale(0.8, 0.8)
	num.Position = UDim2.fromScale(0.1, 0.1)
	num.BackgroundTransparency = 1
	num.Font = Enum.Font.FredokaOne
	num.TextScaled = true
	num.Text = tostring(i)
	num.TextColor3 = C(235, 252, 255)
	num.Parent = sg
	local ns = Instance.new("UIStroke")
	ns.Thickness = 5
	ns.Color = C(10, 60, 90)
	ns.Parent = num
	-- แสงม่าน + ประกายลอยออกจากม่าน
	local glow = light(veil, PORTAL_VEIL, 26, 2.2)
	local att = Instance.new("Attachment")
	att.Parent = veil
	local motes = Instance.new("ParticleEmitter")
	motes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	motes.Shape = Enum.ParticleEmitterShape.Disc
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes.Rate = 8
	motes.Lifetime = NumberRange.new(1.5, 3)
	motes.Speed = NumberRange.new(1, 3)
	motes.SpreadAngle = Vector2.new(40, 40)
	motes.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(1, 0) })
	motes.LightEmission = 1
	motes.Color = ColorSequence.new(C(190, 245, 255))
	motes.Parent = att
	for _, tag in ipairs({ "L", "R" }) do
		local lamp = art:FindFirstChild("PortalBrazier" .. i .. tag, true)
		if lamp then
			spiritFlame(lamp, 0.75)
		end
	end
	-- ป้ายกลางม่าน (ตัวหนังสือขาวขอบเข้ม แบบภาพต้นแบบ)
	-- ป้ายลอยหน้าม่าน (เดิมจมอยู่ในม่าน/โดนเสาบัง = เห็นแค่ครึ่ง ๆ "4 / pad to start")
	local toPad = (center.Position - veil.Position) * V(1, 0, 1)
	toPad = toPad.Magnitude > 0.1 and toPad.Unit or veil.CFrame.LookVector
	local anchor = Instance.new("Attachment")
	anchor.Name = "PortalLabelAnchor"
	anchor.Parent = veil
	anchor.WorldPosition = veil.Position + toPad * 3.5
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(9, 4)
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true -- ไม่โดนเสา/ม่าน/ต้นไม้บัง
	bb.Adornee = anchor
	bb.Parent = veil
	local function line(y, h, txt, font)
		local t = Instance.new("TextLabel")
		t.Position = UDim2.fromScale(0, y)
		t.Size = UDim2.fromScale(1, h)
		t.BackgroundTransparency = 1
		t.Text = txt
		t.TextScaled = true
		t.Font = font
		t.TextColor3 = C(255, 255, 255)
		t.Parent = bb
		local st = Instance.new("UIStroke")
		st.Thickness = 3
		st.Color = C(8, 40, 70)
		st.Parent = t
		return t
	end
	local count = line(0.0, 0.5, "0/4", Enum.Font.FredokaOne)
	local sub = line(0.52, 0.24, "Step on the pad to start", Enum.Font.GothamBold)
	local names = line(0.78, 0.2, "", Enum.Font.GothamBold)
	names.TextColor3 = C(170, 245, 255)
	-- วงฟ้าเรืองแสงบนลานหน้าประตู (เขตยืนรอ เห็นชัดว่าใครอยู่ในวง แบบเกมเอาชีวิตรอดซอมบี้) + ประกายลอยขึ้นจากวง
	local cp = center.Position
	local disc = P(parent, { Name = "PortalZone" .. i, Shape = Enum.PartType.Cylinder, Size = V(0.06, 19.6, 19.6), CFrame = CF(cp.X, cp.Y + 0.02, cp.Z) * ANG(0, 0, math.pi / 2),
		Color = PORTAL_IDLE, Material = Enum.Material.Neon, Transparency = 0.62, CanCollide = false, CanQuery = false, CastShadow = false })
	local edge = ring -- ขอบวงเรืองแสงรอบลาน (จากโมเดล)
	TweenService:Create(disc, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.8 }):Play()
	local rise = Instance.new("ParticleEmitter")
	rise.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	rise.Shape = Enum.ParticleEmitterShape.Disc
	rise.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	rise.EmissionDirection = Enum.NormalId.Right -- แกนกระบอก = ขึ้นด้านบน
	rise.Rate = 10
	rise.Lifetime = NumberRange.new(1.6, 2.6)
	rise.Speed = NumberRange.new(2.5, 4.5)
	rise.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.4), NumberSequenceKeypoint.new(1, 0) })
	rise.LightEmission = 1
	rise.Color = ColorSequence.new(C(170, 245, 255))
	rise.Parent = disc
	local zone = P(parent, { Name = "MatchBox" .. i, Size = V(21, 12, 21), CFrame = CF(cp.X, cp.Y + 5, cp.Z), Transparency = 1, CanCollide = false, CanQuery = false })
	zone:SetAttribute("PadIndex", i)
	zone:SetAttribute("Size", 4)
	zone:SetAttribute("Count", 0)
	zone:SetAttribute("Countdown", -1)
	return { Index = i, Zone = zone, Size = 4, Text = count, Sub = sub, Names = names, Countdown = nil, Pad = veil, Ring = ring, Disc = disc, Edge = edge, Rise = rise, Runes = {}, Pillar = glow, Motes = motes }
end

---------------------------------------------------------------- สร้างล็อบบี้: ป่าโบราณศักดิ์สิทธิ์ (ประตูมิติหินโบราณ 4 ประตู + ซากรูน + ป่าดิบ + น้ำตก)
-- ฉากหิน/ต้นไม้/พืชทั้งหมดมาจาก ServerStorage.LobbyArt.LobbyRuins (สร้างด้วย tools/lobby_art.py) · ที่นี่ใส่ของที่ใช้งานได้ + ไฟ/อนุภาค
function LobbyService:Build()
	local old = Workspace:FindFirstChild("Lobby")
	if old then
		old:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = "Lobby"
	local base = CF(self.Position)
	m.WorldPivot = base
	local rng = Random.new(2024)
	-- หินใต้เกาะ (พื้นหญ้าด้านบน = Terrain ด้านล่าง)
	cyl(m, 8, 560, base * CF(0, -4, 0), C(96, 80, 60), Enum.Material.Ground)
	for i = 1, 5 do
		cyl(m, 16, 560 - i * 90, base * CF(0, -8 - i * 14, 0), C(60 - i * 5, 64 - i * 5, 60 - i * 5), Enum.Material.Rock)
	end

	local FX, FZ0, FZ1 = 120, -112, 104 -- ขอบค่าย (กำแพงหินพังในฉาก + กำแพงล่องหนกันตก)
	local deco = Instance.new("Folder")
	deco.Name = "Decor"
	deco.Parent = m

	------------------------------------------------ ฉากหลักจากโมเดล
	local art
	local src = ServerStorage:FindFirstChild("LobbyArt")
	src = src and src:FindFirstChild("LobbyRuins")
	if src then
		art = src:Clone()
		local origin = art:FindFirstChild("Origin")
		if origin then
			art.PrimaryPart = origin -- จุด 0,0,0 ของฉาก = จุดกลางล็อบบี้ (กันโมเดลเลื่อน/จมจากจุดหมุนกลางกล่อง)
		end
		art:PivotTo(base)
		art.Parent = m
		for _, d in ipairs(art:GetDescendants()) do
			if d:IsA("BasePart") then
				if d.Name == "CrystalLamp" then
					spiritFlame(d, 1)
				elseif d.Name == "WaterfallFoam" then
					local mist = Instance.new("ParticleEmitter")
					mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
					mist.Rate = 14
					mist.Lifetime = NumberRange.new(2, 3.5)
					mist.Speed = NumberRange.new(2, 5)
					mist.SpreadAngle = Vector2.new(60, 60)
					mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
					mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
					mist.Color = ColorSequence.new(C(235, 248, 255))
					mist.Parent = d
				end
			end
		end
		local campSign = art:FindFirstChild("CampSign", true)
		if campSign then
			-- ป้ายไม้แขวนใต้คานซุ้ม (สไตล์ป้ายแคมป์ 99 Nights) แทนแผ่นหินเดิม: ซ่อนแผ่นหิน + เถาวัลย์ที่ห้อยบังตัวหนังสือ
			local sp = campSign.Position
			for _, d in ipairs(art:GetDescendants()) do
				if d:IsA("BasePart") then
					local o = d.Position - sp
					if d == campSign or (math.abs(o.X) < 12 and o.Y > -4.5 and o.Y < 2.6 and math.abs(o.Z) < 3) then
						d.Transparency, d.CanCollide, d.CanQuery = 1, false, false
					end
				end
			end
			local sc = CF(sp.X, sp.Y - 0.3, sp.Z)
			local WOOD, LOG, ROPE = C(158, 104, 62), C(92, 60, 38), C(196, 168, 120)
			local board = P(deco, { Name = "CampSignBoard", Size = V(22, 5, 0.6), CFrame = sc, Color = WOOD, Material = Enum.Material.WoodPlanks })
			for _, y in ipairs({ -2.7, 2.7 }) do
				P(deco, { Size = V(23.4, 0.6, 0.9), CFrame = sc * CF(0, y, 0), Color = LOG, Material = Enum.Material.Wood })
			end
			for _, x in ipairs({ -11.4, 11.4 }) do
				P(deco, { Size = V(0.6, 6, 0.9), CFrame = sc * CF(x, 0, 0), Color = LOG, Material = Enum.Material.Wood })
				P(deco, { Size = V(0.25, 1.4, 0.25), CFrame = sc * CF(x * 0.8, 3.6, 0), Color = ROPE, Material = Enum.Material.Fabric, CanCollide = false })
			end
			for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
				local sg = Instance.new("SurfaceGui")
				sg.Face = face
				sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				sg.PixelsPerStud = 40
				sg.Parent = board
				local title = Instance.new("TextLabel")
				-- ตัวอักษรบรรทัดเดียว (ไม่ตัดขึ้นบรรทัดใหม่) อยู่กลางป้าย เว้นขอบที่เสาซุ้มบัง
				title.Size = UDim2.fromScale(0.72, 0.5)
				title.Position = UDim2.fromScale(0.14, 0.1)
				title.TextWrapped = false
				title.BackgroundTransparency = 1
				title.Text = "WILDHEART CAMP"
				title.TextScaled = true
				title.Font = Enum.Font.FredokaOne
				title.TextColor3 = C(255, 236, 190)
				title.Parent = sg
				local st = Instance.new("UIStroke")
				st.Color, st.Thickness, st.Parent = C(58, 32, 16), 3, title
				local sub = Instance.new("TextLabel")
				sub.Size = UDim2.fromScale(0.56, 0.2)
				sub.Position = UDim2.fromScale(0.22, 0.66)
				sub.TextWrapped = false
				sub.BackgroundTransparency = 1
				sub.Text = "~ SURVIVE 99 NIGHTS ~"
				sub.TextScaled = true
				sub.Font = Enum.Font.FredokaOne
				sub.TextColor3 = C(255, 200, 110)
				sub.Parent = sg
				local st2 = Instance.new("UIStroke")
				st2.Color, st2.Thickness, st2.Parent = C(58, 32, 16), 2, sub
			end
		end
		local groveSign = art:FindFirstChild("GroveSign", true)
		local signModel = groveSign and PropBuilder.Imported("LobbySign", CFrame.new(groveSign.Position.X, base.Y + 1, groveSign.Position.Z) * groveSign.CFrame.Rotation, 10.5, m, true) -- ชนได้ (ไม่เดินทะลุ)
		if signModel then
			-- ซ่อนป้ายหินเดิม + ฐานหิน
			local gp = groveSign.Position
			for _, d in ipairs(art:GetDescendants()) do
				if d:IsA("BasePart") and ((d.Position - gp) * V(1, 0, 1)).Magnitude < 4.2 and d.Position.Y < gp.Y + 3 then
					d.Transparency, d.CanCollide, d.CanQuery = 1, false, false
				end
			end
		elseif groveSign then
			for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
				local t = label(groveSign, face, "⚔ Walk through the portal to start the game", C(150, 240, 255), Enum.Font.GothamBlack)
				local st = Instance.new("UIStroke")
				st.Color, st.Thickness, st.Parent = C(8, 40, 60), 2, t
			end
		end
	else
		warn("[AS] ServerStorage.LobbyArt.LobbyRuins not found (run python tools/lobby_art.py then rebuild)")
	end
	-- กำแพงหินรอบค่าย (มองเห็นจริง สูง 11) + กำแพงล่องหนสูง 300 ทับอีกชั้น -> ปีน/กระโดดออกนอกค่ายไม่ได้ (กันตกแมพ)
	local walls = Instance.new("Folder")
	walls.Name = "CampWall"
	walls.Parent = m
	local WALL_H, WALL_T = 11, 3
	local STONE, STONE2, CAP = C(112, 108, 100), C(96, 92, 86), C(132, 128, 118)
	local function wallRun(x0, z0, x1, z1)
		local a, b = V(x0, 0, z0), V(x1, 0, z1)
		local len = (b - a).Magnitude
		local dir = (b - a).Unit
		local n = math.max(1, math.floor(len / 20 + 0.5))
		for k = 0, n - 1 do
			local p0, p1 = a + dir * (len * k / n), a + dir * (len * (k + 1) / n)
			local mid = (p0 + p1) / 2
			local cf = base * CFrame.lookAt(mid, mid + dir) -- แกน Z ตามแนวกำแพง
			P(walls, { Name = "Wall", Size = V(WALL_T, WALL_H, (p1 - p0).Magnitude + 0.1), CFrame = cf * CF(0, 1 + WALL_H / 2, 0),
				Color = (k % 2 == 0) and STONE or STONE2, Material = Enum.Material.Cobblestone })
			P(walls, { Name = "WallCap", Size = V(WALL_T + 1, 0.8, (p1 - p0).Magnitude + 0.1), CFrame = cf * CF(0, 1 + WALL_H + 0.4, 0), Color = CAP, Material = Enum.Material.Slate })
			-- เสาหินทุกช่วง
			local post = base * CF(p0.X, 0, p0.Z)
			P(walls, { Name = "WallPost", Size = V(WALL_T + 2, WALL_H + 3, WALL_T + 2), CFrame = post * CF(0, 1 + (WALL_H + 3) / 2, 0), Color = STONE2, Material = Enum.Material.Slate })
		end
		local mid = (a + b) / 2
		P(m, { Name = "Boundary", Size = V(4, 300, len + 8), CFrame = base * CFrame.lookAt(mid, mid + dir) * CF(0, 150, 0), Transparency = 1, CanQuery = false })
	end
	wallRun(-FX, FZ0, FX, FZ0)
	wallRun(FX, FZ0, FX, FZ1)
	wallRun(FX, FZ1, -FX, FZ1)
	wallRun(-FX, FZ1, -FX, FZ0)
	for _, c in ipairs({ { -FX, FZ0 }, { FX, FZ0 }, { FX, FZ1 }, { -FX, FZ1 } }) do
		P(walls, { Name = "WallPost", Size = V(WALL_T + 3, WALL_H + 5, WALL_T + 3), CFrame = base * CF(c[1], 1 + (WALL_H + 5) / 2, c[2]), Color = STONE2, Material = Enum.Material.Slate })
	end
	-- เพดานล่องหนกันกระโดดจากหลังคาออกไป (สูงเกินที่ผู้เล่นจะไปถึง)
	P(m, { Name = "Boundary", Size = V(FX * 2 + 20, 4, FZ1 - FZ0 + 20), CFrame = base * CF(0, 300, (FZ0 + FZ1) / 2), Transparency = 1, CanQuery = false })

	------------------------------------------------ พื้น Terrain: หญ้าจริง (มีใบหญ้าขึ้น) + ทางหินปูถนน/ลานหิน
	local terrain = Workspace.Terrain
	local GX, GZ, GR = 52, 8, 50 -- ลานประตูมิติ (ตรงกับ tools/lobby_art.py)
	-- ดินหนา 3 ช่อง (ชั้นเดียวบางๆ มีอากาศใต้ล่าง Terrain จะวาดผิวโป่งขึ้น ~2 stud -> ของทั้งล็อบบี้ดูจม)
	terrain:FillCylinder(base * CF(0, -5, 0), 12, 278, Enum.Material.Ground)
	terrain:FillCylinder(base * CF(0, -1, 0), 4, 278, Enum.Material.Grass)
	-- พื้นกันตกล่องหน (ใต้ผิวหญ้านิดเดียว) เผื่อ Terrain ยังสตรีมมาไม่ถึงเครื่องผู้เล่น
	P(m, { Name = "SafetyFloor", Shape = Enum.PartType.Cylinder, Size = V(1, 556, 556), CFrame = base * CF(0, 0.4, 0) * ANG(0, 0, math.pi / 2), Transparency = 1, CanQuery = false })
	local function road(x0, z0, x1, z1, w, mat)
		local a, b = Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z1)
		local mid = (a + b) / 2
		terrain:FillBlock(base * CFrame.lookAt(mid + Vector3.new(0, -1, 0), b + Vector3.new(0, -1, 0)), V(w, 4, (b - a).Magnitude + w * 0.5), mat or Enum.Material.Cobblestone)
	end
	local function plaza(x, z, r, mat)
		terrain:FillCylinder(base * CF(x, -1, z), 4, r, mat or Enum.Material.Cobblestone)
	end
	plaza(0, 88, 15)
	road(0, 76, 0, -30, 10)
	plaza(0, -34, 12)
	road(-86, 44, GX - 18, 44, 9)
	road(-42, 44, -42, -8, 8)
	plaza(-42, -16, 10)
	road(-42, 6, -76, 6, 7)
	plaza(-78, 6, 9)
	road(-62, 44, -62, 64, 6)
	plaza(-62, 74, 11)
	plaza(GX, GZ, 19)
	for _, ad in ipairs({ -60, -20, 20, 60 }) do
		local a = math.rad(ad)
		road(GX + math.cos(a) * 16, GZ + math.sin(a) * 16, GX + math.cos(a) * (GR - 10), GZ + math.sin(a) * (GR - 10), 7)
	end
	-- ล้าง Terrain ทุกช่องที่สูงกว่าผิวพื้น ด้วย FillRegion (ทั้งช่อง voxel พอดีกริด)
	-- FillBlock/FillCylinder ที่ขอบตรงเส้นกริดจะเหลือช่องบนครึ่งๆ -> ผิวหญ้านูนขึ้นมา ~2 stud ทำให้ของทั้งล็อบบี้ดูจม
	local top = base.Y + 1
	local p0 = Vector3.new(base.X - 300, top, base.Z - 300)
	local p1 = Vector3.new(base.X + 300, top + 32, base.Z + 300)
	terrain:FillRegion(Region3.new(p0, p1):ExpandToGrid(4), 4, Enum.Material.Air)

	------------------------------------------------ ต้นไม้/พุ่มไม้/เฟิร์น/หิน/เห็ด = โมเดลเมชชุดเดียวกับในแมพ (ไม่ใช่ลูกบอล)
	local veg = Instance.new("Folder")
	veg.Name = "Vegetation"
	veg.Parent = m
	local function plant(kind, x, z, scale)
		local inst = PropBuilder.Place(kind, (base * CF(x, 0.6, z)).Position, rng:NextNumber(0, math.pi * 2), scale or 1, nil, rng)
		if inst then
			CollectionService:RemoveTag(inst, "ResourceNode") -- ล็อบบี้: ตัด/เก็บไม่ได้
			CollectionService:RemoveTag(inst, "Hazard")
			inst:SetAttribute("Node", nil)
			inst.Parent = veg
		end
		return inst
	end
	local function outside(x, z)
		return math.abs(x) > FX + 10 or z < FZ0 - 10 or z > FZ1 + 10
	end
	-- ป่ารอบนอกกำแพง (ทึบ บังขอบเกาะ)
	for _ = 1, 90 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(128, 232)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if outside(x, z) and z > FZ0 - 30 and not (math.abs(x) < 26 and z > FZ1) then
			local k = rng:NextNumber()
			plant(k < 0.45 and "AncientOak" or (k < 0.85 and "Oak" or "Palm"), x, z, rng:NextNumber(0.9, 1.35))
		end
	end
	for _ = 1, 40 do -- พุ่มไม้ใต้ต้นไม้นอกกำแพง
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(124, 160)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if outside(x, z) and z > FZ0 - 20 and not (math.abs(x) < 26 and z > FZ1) then
			plant("Bush", x, z, rng:NextNumber(1.2, 1.8))
		end
	end
	-- ในค่าย: ไม่มีต้นไม้/พุ่มไม้ (บังทาง บังกล้อง) — มีแค่ป่าด้านนอกกำแพงเป็นฉากหลัง

	-- ของตกแต่งโทนเดียวกับกระท่อม Classes (โมเดลจริง): ม้านั่งท่อนซุง ลังไม้ กองฟืน โรงเก็บของ
	PropBuilder.StoreModel("CampShack", base * CF(-96, 1, -70) * ANG(0, math.rad(60), 0), deco)
	for _, info in ipairs({ { 22, -36, 0.4 }, { 25, -38, 1.2 }, { -30, 62, 0.3 }, { 110, 46, 0.9 }, { -104, 8, 0.2 } }) do
		PropBuilder.StoreModel("Crate", base * CF(info[1], 1, info[2]) * ANG(0, info[3], 0), deco)
	end

	------------------------------------------------ กลาง: เต็นท์ Classes
	classesTent(self, deco, base * CF(0, 0, -54) * ANG(0, math.pi, 0)) -- หน้าเต็นท์หันมาทางจุดเกิด

	-- กระดานข่าว (ขวาของเต็นท์)
	local nbCf = base * CF(30, 1, -30) * ANG(0, math.rad(162), 0) -- หน้าป้ายหันมาทางจุดเกิด
	for _, x in ipairs({ -6, 6 }) do
		P(deco, { Size = V(0.9, 12, 0.9), CFrame = nbCf * CF(x, 6, 0), Color = C(74, 52, 38), Material = Enum.Material.Wood })
	end
	local nb = P(deco, { Size = V(12.5, 8, 0.5), CFrame = nbCf * CF(0, 7.6, 0), Color = C(150, 96, 56), Material = Enum.Material.WoodPlanks })
	P(deco, { ClassName = "WedgePart", Size = V(14, 1.5, 2), CFrame = nbCf * CF(0, 12.4, 0), Color = C(90, 60, 40), Material = Enum.Material.Wood })
	local nbg = Instance.new("SurfaceGui")
	nbg.Face = Enum.NormalId.Front
	nbg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud -- ค่าเริ่มต้นคือ FixedSize 800x600 → ตัวหนังสือเล็กจิ๋ว
	nbg.PixelsPerStud = 40 -- ป้าย 12.5x8 = 500x320 px
	nbg.Parent = nb
	local nt = Instance.new("TextLabel")
	nt.Size = UDim2.fromScale(0.9, 0.9)
	nt.Position = UDim2.fromScale(0.05, 0.05)
	nt.BackgroundTransparency = 1
	nt.RichText = true
	-- TextScaled วัดความกว้างอักษรไทย/อีโมจิพลาด ทำให้ล้นขอบป้าย → ใช้ขนาดคงที่ + ตัดบรรทัดเอง
	nt.TextScaled = false
	nt.TextSize = 30
	nt.TextWrapped = true
	nt.Font = Enum.Font.GothamBold
	nt.TextColor3 = C(255, 240, 200)
	local nst = Instance.new("UIStroke")
	nst.Color, nst.Thickness, nst.Parent = C(70, 40, 20), 2, nt
	nt.Text = '<font color="#FFE066" size="40">Camp News</font>\n\nDefeat a boss = ♦️3-7\nRescue a Spirit Pup = ♦️5\nSanctums, meteors, chests = ♦️\n\n<font color="#8CFF8C">Free Ruby at the green cauldron every day!</font>'
	nt.Parent = nbg
	local nlamp = P(deco, { Size = V(0.9, 0.9, 0.9), CFrame = nbCf * CF(0, 12, -1.6), Color = C(255, 214, 150), Material = Enum.Material.Neon, CanCollide = false })
	light(nlamp, C(255, 196, 130), 14, 1.6)

	------------------------------------------------ ซ้าย: หม้อรางวัลประจำวัน + กระดานผู้รอดนานสุด + แคมป์ไฟ
	dailyCauldron(self, deco, base * CF(-42, 1, -16))
	local boardCf = base * CF(-88, 1, 6) * ANG(0, math.rad(90), 0)
	-- กระดานใหญ่ (กว้าง 26 x สูง 17) กรอบไม้หนา + ขอบทอง + หลังคา + โคมสองข้าง
	local board = P(deco, { Size = V(26, 17, 0.8), CFrame = boardCf * CF(0, 11, 0), Color = C(28, 26, 44), Material = Enum.Material.SmoothPlastic })
	for _, x in ipairs({ -13.6, 13.6 }) do
		P(deco, { Size = V(1.4, 21.5, 1.4), CFrame = boardCf * CF(x, 10.75, 0), Color = C(96, 64, 40), Material = Enum.Material.Wood })
		P(deco, { Size = V(2, 1, 2), CFrame = boardCf * CF(x, 0.5, 0), Color = C(96, 92, 88), Material = Enum.Material.Slate })
	end
	for _, y in ipairs({ 2.15, 19.85 }) do
		P(deco, { Size = V(27.6, 1.1, 1.3), CFrame = boardCf * CF(0, y, 0), Color = C(96, 64, 40), Material = Enum.Material.Wood })
	end
	for _, y in ipairs({ 2.75, 19.25 }) do
		P(deco, { Size = V(26.2, 0.18, 1.0), CFrame = boardCf * CF(0, y, 0), Color = C(255, 196, 70), Material = Enum.Material.Neon })
	end
	P(deco, { ClassName = "WedgePart", Size = V(30, 2.4, 3.2), CFrame = boardCf * CF(0, 21.6, 0), Color = C(120, 64, 40), Material = Enum.Material.WoodPlanks })
	self.boardGuis = { self:BuildBoardGui(board, Enum.NormalId.Back), self:BuildBoardGui(board, Enum.NormalId.Front) }
	-- แคมป์ไฟเล็ก + ม้านั่งท่อนซุง + เต็นท์นอน
	local fcf = base * CF(-62, 1, 74)
	-- ฟืนกระโจม + หินล้อม (โมเดล Store ชุดเดียวกับกองไฟแคมป์) — ไม่มีฟืน ไฟจะลอยเป็นพุ่มกลางลาน
	local ring = PropBuilder.CampfireLogs(fcf * CF(0, -0.15, 0), 7, deco) or mesh("Campfire", fcf, deco)
	if ring then
		ring.Name = "LobbyFireRing"
	end
	local core = P(deco, { Name = "LobbyFire", Size = V(1.6, 0.4, 1.6), CFrame = fcf * CF(0, 1.4, 0), Transparency = 1, CanCollide = false, CanQuery = false })
	fireOn(core, 5.6)
	light(core, C(255, 150, 70), 40, 2.8, true)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + 0.5
		local bcf = fcf * CF(math.cos(a) * 8, 0, math.sin(a) * 8) * ANG(0, -a, 0)
		if not PropBuilder.StoreModel("LogBench", bcf, deco) then
			cyl(deco, 7, 1.8, bcf * CF(0, 0.9, 0) * ANG(0, math.pi / 2, 0) * ANG(0, 0, -math.pi / 2), C(104, 74, 50), Enum.Material.Wood)
		end
	end
	BaseDecor.CanvasTent(deco, base * CF(-90, 1, 78) * ANG(0, math.rad(-70), 0), C(70, 104, 150))
	BaseDecor.CanvasTent(deco, base * CF(-80, 1, 96) * ANG(0, math.rad(-130), 0), C(196, 110, 52))

	------------------------------------------------ ประตูมิติ 4 ประตู (ลานฝั่งตะวันออก)
	self.boxes = {}
	if art then
		for i = 1, 4 do
			local box = portalHook(art, deco, i)
			if box then
				table.insert(self.boxes, box)
			end
		end
	end

	------------------------------------------------ ลังไม้ประปราย
	for _, info in ipairs({ { 24, -40 }, { 27, -44 }, { -26, -40 }, { 40, 60 }, { -102, 30 } }) do
		crate(deco, base * CF(info[1], 1, info[2]) * ANG(0, rng:NextNumber(0, 1), 0))
	end

	------------------------------------------------ วางของให้แตะพื้นพอดี (โมเดลแต่ละชิ้นมีจุดหมุนต่างกัน -> บางชิ้นจม/ลอย)
	local groundY = base.Y + 1
	local SKIP = { ClassHut = true, Counselor = true, CounselorModel = true } -- ที่ปรึกษายืนบนพื้นไม้กระท่อม ไม่ใช่พื้นหญ้า
	local function lowest(model)
		local y
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency < 1 then
				local cf, s = p.CFrame, p.Size
				local half = 0.5 * (math.abs(cf.XVector.Y) * s.X + math.abs(cf.YVector.Y) * s.Y + math.abs(cf.ZVector.Y) * s.Z)
				y = math.min(y or math.huge, p.Position.Y - half)
			end
		end
		return y
	end
	local function settle(container, embed)
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Folder") then
				settle(c, embed)
			elseif c:IsA("Model") and not SKIP[c.Name] then
				local bottom = lowest(c)
				local _, size = c:GetBoundingBox()
				local gap = bottom and bottom - groundY
				-- แตะพื้นแค่ของที่ตั้งใจวางบนพื้น (ลอยไม่เกิน 4 stud / จมไม่เกินครึ่งตัว) · ของแขวน/ฝังตั้งใจไม่ยุ่ง
				if gap and math.abs(gap + embed) > 0.1 and gap < 4 and gap > -size.Y * 0.5 then
					c:PivotTo(c:GetPivot() - V(0, gap + embed, 0))
				end
			end
		end
	end
	settle(deco, 0.05)
	settle(veg, 0.5) -- ต้นไม้/พุ่ม: ฝังโคนลงดินนิดหน่อย (ไม่เห็นโคนลอย)

	-- ผิวหญ้าที่ Roblox วาดจริงสูงกว่าขอบ voxel ~1.8-2 stud -> วัดผิวจริงแล้วยกทั้งล็อบบี้ขึ้นให้ของแตะพื้นพอดี (เดิมจมทั้งล็อบบี้)
	local lift = 0
	do
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { Workspace.Terrain }
		local ys = {}
		for _, xz in ipairs({ { 30, 30 }, { -60, 0 }, { 60, -60 }, { -100, 60 }, { 90, 80 } }) do
			local o = base * CF(xz[1], 40, xz[2])
			local hit = Workspace:Raycast(o.Position, V(0, -80, 0), rp)
			if hit then
				table.insert(ys, hit.Position.Y - groundY)
			end
		end
		table.sort(ys)
		lift = ys[math.ceil(#ys / 2)] or 0
		-- วัดไม่ได้ (Terrain เพิ่งสร้าง ฟิสิกส์ยังไม่พร้อม) -> ใช้ค่าที่วัดจากในเกมจริง: หญ้า +2.0 ทางหิน +1.8
		if lift < 0.15 or lift > 6 then
			lift = 1.9
		end
		m:PivotTo(m:GetPivot() + V(0, lift, 0))
	end
	self.spawnCf = base * CF(0, 4 + lift, 88)
	-- ส่งล็อบบี้ทั้งชุดถึงทุกเครื่องทันที (ไม่สตรีมทีละส่วน) + บอกจำนวนชิ้น ให้หน้าโหลดรอจนครบก่อนเข้า
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	m:SetAttribute("Parts", #m:GetDescendants())
	m.Parent = Workspace
	self.model = m
	return m
end

function LobbyService:SpawnPoint()
	local a = math.random() * math.pi * 2
	return (self.spawnCf * CF(math.cos(a) * 8, 0, math.sin(a) * 5)).Position
end

function LobbyService:InLobby(player)
	return not player:GetAttribute("InRun")
end

-- ลงแมพในเซิร์ฟเวอร์นี้
function LobbyService:Depart(player)
	local ctx = self.ctx
	if player:GetAttribute("InRun") then
		return
	end
	player:SetAttribute("InRun", true)
	local surv = ctx.Services.SurvivalService
	-- รอโหลดเซฟเสร็จก่อนแจกของเริ่มต้น (เซิร์ฟเวอร์ทีม: ผู้เล่นมาถึงตอนโลกพร้อมแล้ว แต่เซฟยังโหลดไม่เสร็จ
	--   -> เคยแจกของของ "ผู้รอดชีวิต" แทนคลาสจริง และแจกครั้งเดียวจบ ส่วนสกิลมาทีหลังเพราะอ่านคลาสสดๆ)
	local t0 = os.clock()
	while player.Parent and not ctx.Services.DataService:Get(player) and os.clock() - t0 < 20 do
		task.wait(0.25)
	end
	if not player.Parent then
		return
	end
	surv:OnClassChosen(player, player:GetAttribute("Class") or "Survivor")
	surv:GiveStartItems(player)
	ctx.Services.MonetizationService:GiveRunPerks(player)
	local data = ctx.Services.DataService:Get(player)
	if data and data.PendingKits then
		for kitId in pairs(data.PendingKits) do
			local kit = Shop.KitById[kitId]
			if kit then
				for id, n in pairs(kit.Items) do
					ctx.Services.InventoryService:Add(player, id, n, true)
				end
				ctx.Notify(player, "🎒 Received " .. kit.Name, "Reward")
			end
		end
		data.PendingKits = {}
	end
	if ctx.Services.QuestService then
		ctx.Services.QuestService:Progress(player, "Run", 1)
	end
	ctx.Remotes.Get("Cinematic"):FireClient(player, "Depart", {})
	surv:Spawn(player)
	if not ctx.Services.DirectorService:IsRunning() then
		ctx.Services.DirectorService:StartRun()
	end
end

-- ส่งทั้งทีม: publish แล้ว -> เซิร์ฟเวอร์ส่วนตัวของทีม / Studio -> ลงแมพที่นี่
-- ทีมที่กำลังเทเลพอร์ต: [player] = { Opts, Tries, At } — ระหว่างรอ (หลายวินาที) ห้ามขึ้นแท่น/นับถอยหลังซ้ำ
--   (เคยนับใหม่ 5 วิแล้วจองเซิร์ฟเวอร์ที่ 2 ส่งคนที่ยังไม่ไป -> ทีมแยกกันคนละเซิร์ฟ เข้าได้ไม่ครบ)
local TELEPORT_RETRIES = 3
local TELEPORT_TIMEOUT = 25

function LobbyService:RetryTeleport(player, reason)
	local d = self.departing and self.departing[player]
	if not d or not player.Parent then
		return
	end
	if d.Tries >= TELEPORT_RETRIES then
		-- ลองครบแล้วไม่ได้: เลิกล็อก กลับมายืนในล็อบบี้ได้ (แจ้งให้ขึ้นแท่นใหม่)
		self.departing[player] = nil
		player:SetAttribute("Departing", nil)
		warn("[AS] teleport gave up", player.Name, reason)
		self.ctx.Notify(player, "Couldn't send you to the team server (" .. tostring(reason or "") .. ") — step on the pad again", "Error")
		return
	end
	d.Tries += 1
	d.At = os.clock()
	task.spawn(function()
		task.wait(1.5)
		if self.departing[player] ~= d or not player.Parent then
			return
		end
		local ok, err = pcall(TeleportService.TeleportAsync, TeleportService, game.PlaceId, { player }, d.Opts)
		if not ok then
			self:RetryTeleport(player, err)
		end
	end)
end

-- worldOwner/worldId = เจ้าของโลก + โลกไหน (ห้องโลก WorldService) -> เซิร์ฟเวอร์ทีมเซฟโลกทุกเช้า
function LobbyService:DepartTeam(list, resumeFrom, worldOwner, worldId)
	local canTeleport = not RunService:IsStudio() and game.PlaceId ~= 0 and not self.IsTeamServer
	-- เล่นต่อจากเซฟ (Save Run ของหัวหน้าแท่น): โหลดรอบที่เซฟไว้ แล้วฝากให้เซิร์ฟเวอร์ใหม่ของทีมอ่านตอนเปิด
	local resumeRun
	if resumeFrom and resumeFrom.Parent then
		if canTeleport then
			resumeRun = worldId and self.ctx.Services.DataService:LoadWorld(resumeFrom.UserId, worldId)
				or self.ctx.Services.DataService:LoadRun(resumeFrom.UserId)
		end
		if not resumeRun then
			for _, p in ipairs(list) do
				self.ctx.Notify(p, canTeleport and "Couldn't load the saved run — starting a new run" or "Continue only works in the published game — starting a new run", "Warn")
			end
		end
	end
	if canTeleport then
		self.departing = self.departing or {}
		for _, p in ipairs(list) do
			self:LeavePad(p)
			p:SetAttribute("Departing", true)
			self.departing[p] = { Tries = 0, At = os.clock() }
			self.ctx.Services.DataService:Save(p)
			self.ctx.Remotes.Get("Cinematic"):FireClient(p, "Teleporting", {})
		end
		local ok, err = pcall(function()
			local code, privateServerId = TeleportService:ReserveServer(game.PlaceId)
			-- จำรหัสเซิร์ฟเวอร์ไว้ (RejoinService) ให้คนที่หลุดกลางรอบกลับเข้ามาได้
			local rejoin = self.ctx.Services.RejoinService
			if rejoin then
				rejoin:RegisterServer(privateServerId, code)
				if resumeRun then
					-- เซิร์ฟเวอร์ใหม่อ่าน run_<PrivateServerId> ตอนเปิด (RejoinService.LoadHeldRun) -> แมพเดิม คืนเดิม ของเดิม
					resumeRun.Expire = os.time() + rejoin.TTL
					if not rejoin:MSet("run_" .. privateServerId, resumeRun, rejoin.TTL) then
						error("couldn't hand the saved run to the team server")
					end
				end
			end
			local opts = Instance.new("TeleportOptions")
			opts.ReservedServerAccessCode = code
			opts:SetTeleportData({ Team = true, Resumed = resumeRun ~= nil, World = worldOwner, WorldId = worldId })
			for _, p in ipairs(list) do
				if self.departing[p] then
					self.departing[p].Opts = opts -- คนที่ล้มเหลวลองใหม่เข้าเซิร์ฟเวอร์เดียวกับทีม
				end
			end
			TeleportService:TeleportAsync(game.PlaceId, list, opts)
		end)
		if ok then
			return
		end
		warn("[AS] teleport failed, play here instead:", err)
		for _, p in ipairs(list) do
			self.departing[p] = nil
			if p.Parent then
				p:SetAttribute("Departing", nil)
			end
		end
	end
	for _, p in ipairs(list) do
		task.spawn(self.Depart, self, p)
	end
end

function LobbyService:ReturnAll()
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("InRun", false)
		self:RefreshTag(p)
	end
end

-- เซิร์ฟเวอร์ของทีม -> ส่งกลับล็อบบี้หลัก (เซิร์ฟเวอร์สาธารณะของเกมเดียวกัน) · คืน true ถ้าเริ่มส่งได้
function LobbyService:ReturnToMainLobby(list, info)
	if RunService:IsStudio() or game.PlaceId == 0 or #list == 0 then
		return false
	end
	for _, p in ipairs(list) do
		self.ctx.Services.DataService:Save(p)
		self.ctx.Remotes.Get("Cinematic"):FireClient(p, "Teleporting", { Back = true })
	end
	local ok, err = pcall(function()
		local opts = Instance.new("TeleportOptions")
		opts:SetTeleportData({ Back = true, Result = info and info.Result, Night = info and info.Night })
		TeleportService:TeleportAsync(game.PlaceId, list, opts)
	end)
	if not ok then
		warn("[AS] return to lobby failed:", err)
	end
	return ok
end

-- คนที่ตายแล้ว (กำลังดูเพื่อน) กดกลับล็อบบี้เอง
function LobbyService:LeaveRun(player)
	local surv = self.ctx.Services.SurvivalService
	if not player:GetAttribute("InRun") or not player:GetAttribute("Dead") then
		return
	end
	if self.IsTeamServer and self:ReturnToMainLobby({ player }, { Result = "Left" }) then
		return
	end
	surv:ResetPlayer(player)
	self:RefreshTag(player)
	surv:CheckWipe()
end

---------------------------------------------------------------- ป้ายบนหัว (ล็อบบี้): คืนที่รอดนานสุด + VIP
local function tierColor(best)
	if best >= 99 then
		return C(255, 214, 90), "👑"
	elseif best >= 50 then
		return C(255, 120, 90), "🔥"
	elseif best >= 25 then
		return C(190, 140, 255), "🌕"
	elseif best >= 10 then
		return C(120, 210, 255), "🌙"
	end
	return C(225, 225, 235), "🌙"
end

function LobbyService:RefreshTag(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	-- ติดป้ายไว้ที่ HumanoidRootPart (ไม่ใช่ Head): อวาตาร์บางคน (หัวไดนามิก/หัวพิเศษ) ถูกสลับชิ้น Head หลังโหลดชุด
	-- ป้ายที่อยู่ในหัวเก่าจะหายไปด้วย -> บางคนไม่มีวันบนหัว · ความสูงป้ายวัดจากหัวจริงทุกครั้งที่รีเฟรช
	local head = char:FindFirstChild("Head")
	local headUp = head and head:IsA("BasePart") and (head.Position.Y - root.Position.Y) or 1.6
	local bb = root:FindFirstChild("ASTag")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "ASTag"
		bb.Size = UDim2.fromOffset(200, 50)
		bb.MaxDistance = 80
		bb.LightInfluence = 0
		local list = Instance.new("UIListLayout")
		list.HorizontalAlignment = Enum.HorizontalAlignment.Center
		list.VerticalAlignment = Enum.VerticalAlignment.Bottom
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = bb
		-- ตัวหนังสือล้วน + ขอบดำบาง (ไม่มีกรอบพื้นหลัง)
		local function line(name, order, size)
			local t = Instance.new("TextLabel")
			t.Name = name
			t.LayoutOrder = order
			t.Size = UDim2.new(1, 0, 0, size)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.FredokaOne
			t.TextSize = size
			t.TextColor3 = C(255, 255, 255)
			t.Parent = bb
			local st = Instance.new("UIStroke")
			st.Thickness = 2
			st.Color = C(10, 10, 22)
			st.Parent = t
			return t
		end
		line("Title", 0, 15).Visible = false
		line("VIP", 1, 16)
		line("Class", 2, 17)
		line("Best", 3, 22)
		bb.Size = UDim2.fromOffset(240, 86)
		bb.Parent = root
	end
	bb.StudsOffsetWorldSpace = Vector3.new(0, math.clamp(headUp, 0.5, 12) + 2.4, 0)
	local best = player:GetAttribute("BestNight") or 0
	local color, icon = tierColor(best)
	local bestL = bb:FindFirstChild("Best")
	bestL.Text = string.format("%s %d days", icon, best)
	bestL.TextColor3 = color
	-- คลาสที่ใช้ + เลเวลคลาส
	local classL = bb:FindFirstChild("Class")
	if classL then
		local cid = player:GetAttribute("Class") or "Survivor"
		local cd = Classes.Data[cid]
		classL.Text = string.format("%s %s · Lv.%d", cd and cd.Icon or "🎒", cd and cd.Name or cid, player:GetAttribute("ClassLevel") or 1)
		classL.TextColor3 = C(170, 230, 255)
	end
	local vip = bb:FindFirstChild("VIP")
	vip.Visible = player:GetAttribute("Pass_VIP") == true
	vip.Text = "👑 VIP"
	vip.TextColor3 = C(255, 214, 90)
	-- ฉายาจาก Season Pass / โค้ด (SeasonService ตั้ง attribute "Title" + "TitleColor")
	local titleL = bb:FindFirstChild("Title")
	if titleL then
		local title = player:GetAttribute("Title")
		titleL.Visible = type(title) == "string" and title ~= ""
		titleL.Text = titleL.Visible and title or ""
		local tc = player:GetAttribute("TitleColor")
		titleL.TextColor3 = typeof(tc) == "Color3" and tc or C(255, 236, 170)
	end
	-- โชว์เฉพาะในล็อบบี้ (ในแมพไม่รกจอ)
	bb.Enabled = not player:GetAttribute("InRun")
end

---------------------------------------------------------------- กระดานอันดับทั้งเกม (ทุกเซิร์ฟเวอร์)
function LobbyService:BuildBoardGui(board, face)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.PixelsPerStud = 36
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.Parent = board
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = C(255, 255, 255)
	bg.Parent = sg
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(C(54, 60, 104), C(22, 24, 44))
	g.Rotation = 90
	g.Parent = bg
	-- หัวป้าย: ริบบิ้นทอง
	local head = Instance.new("Frame")
	head.Size = UDim2.fromScale(0.86, 0.15)
	head.Position = UDim2.fromScale(0.07, 0.035)
	head.BackgroundColor3 = C(255, 255, 255)
	head.Parent = bg
	local hc = Instance.new("UICorner")
	hc.CornerRadius = UDim.new(0.35, 0)
	hc.Parent = head
	local hg = Instance.new("UIGradient")
	hg.Color = ColorSequence.new(C(255, 214, 90), C(230, 140, 30))
	hg.Rotation = 90
	hg.Parent = head
	local hs = Instance.new("UIStroke")
	hs.Thickness = 5
	hs.Color = C(70, 34, 8)
	hs.Parent = head
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(0.94, 0.86)
	title.Position = UDim2.fromScale(0.03, 0.07)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = "🏆 Longest Survivors of All Time"
	title.TextColor3 = C(255, 255, 255)
	title.Parent = head
	local ts = Instance.new("UIStroke")
	ts.Thickness = 4
	ts.Color = C(70, 34, 8)
	ts.Parent = title
	title.Name = "Title"
	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.Size = UDim2.fromScale(1, 0.045)
	sub.Position = UDim2.fromScale(0, 0.195)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.Text = "Loading leaderboard..."
	sub.TextColor3 = C(200, 205, 235)
	sub.Parent = bg
	local rows = {}
	local n = Config.LeaderboardSize
	local top, h = 0.255, 0.725 / n
	local medal = { C(255, 205, 60), C(214, 222, 236), C(222, 146, 84) }
	for i = 1, n do
		local r = Instance.new("Frame")
		r.Size = UDim2.new(0.92, 0, h * 0.84, 0)
		r.Position = UDim2.new(0.04, 0, top + (i - 1) * h, 0)
		r.BackgroundColor3 = i <= 3 and C(70, 64, 120) or C(40, 44, 78)
		r.Parent = bg
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0.3, 0)
		rc.Parent = r
		if i <= 3 then
			local st = Instance.new("UIStroke")
			st.Thickness = 3
			st.Color = medal[i]
			st.Parent = r
		end
		local rank = Instance.new("TextLabel")
		rank.Size = UDim2.fromScale(0.08, 0.9)
		rank.Position = UDim2.fromScale(0.01, 0.05)
		rank.BackgroundTransparency = 1
		rank.Font = Enum.Font.FredokaOne
		rank.TextScaled = true
		rank.Text = tostring(i)
		rank.TextColor3 = medal[i] or C(210, 214, 236)
		rank.Parent = r
		local face2 = Instance.new("ImageLabel")
		face2.Size = UDim2.fromScale(0.07, 0.9)
		face2.Position = UDim2.fromScale(0.095, 0.05)
		face2.BackgroundColor3 = C(24, 26, 44)
		face2.Image = ""
		face2.Parent = r
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = face2
		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(1, 0)
		fc.Parent = face2
		local name = Instance.new("TextLabel")
		name.Size = UDim2.fromScale(0.5, 0.78)
		name.Position = UDim2.fromScale(0.19, 0.11)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBold
		name.TextScaled = true
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.Text = "—"
		name.TextColor3 = C(244, 244, 252)
		name.Parent = r
		local val = Instance.new("TextLabel")
		val.Size = UDim2.fromScale(0.28, 0.82)
		val.Position = UDim2.fromScale(0.7, 0.09)
		val.BackgroundTransparency = 1
		val.Font = Enum.Font.FredokaOne
		val.TextScaled = true
		val.TextXAlignment = Enum.TextXAlignment.Right
		val.Text = ""
		val.TextColor3 = C(255, 214, 90)
		val.Parent = r
		rows[i] = { Row = r, Face = face2, Name = name, Value = val }
	end
	return { Sub = sub, Rows = rows, Title = title }
end

local nameCache, thumbCache = {}, {}
local function displayName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		nameCache[userId] = p.DisplayName
		return p.DisplayName
	end
	local ok, infos = pcall(UserService.GetUserInfosByUserIdsAsync, UserService, { userId })
	if ok and infos and infos[1] then
		nameCache[userId] = infos[1].DisplayName
	else
		local ok2, n = pcall(Players.GetNameFromUserIdAsync, Players, userId)
		nameCache[userId] = ok2 and n or ("Player " .. userId)
	end
	return nameCache[userId]
end
local function thumb(userId)
	if thumbCache[userId] == nil then
		local ok, url = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		thumbCache[userId] = ok and url or ""
	end
	return thumbCache[userId]
end
local function rowsFromServer(self, weekly)
	local list = {}
	local qs = self.ctx.Services.QuestService
	for _, p in ipairs(Players:GetPlayers()) do
		local d = self.ctx.Services.DataService:Get(p)
		if d and p.UserId > 0 then
			local v = d.BestNight or 0
			if weekly then
				v = qs and qs:WeekBestOf(p) or 0
			end
			table.insert(list, { UserId = p.UserId, Value = v })
		end
	end
	table.sort(list, function(a, b)
		return a.Value > b.Value
	end)
	return list
end

local function inside(zone, pos)
	local rel = zone.CFrame:PointToObjectSpace(pos)
	return math.abs(rel.X) < zone.Size.X / 2 and math.abs(rel.Y) < zone.Size.Y / 2 and math.abs(rel.Z) < zone.Size.Z / 2
end

function LobbyService:Tick(dt)
	local s = self.ctx.State
	-- เทเลพอร์ตค้างนานเกิน (ไม่มี error แต่ยังไม่ไป) -> ลองส่งใหม่เข้าเซิร์ฟเวอร์เดิมของทีม
	for p, d in pairs(self.departing or {}) do
		if not p.Parent then
			self.departing[p] = nil
		elseif d.Opts and os.clock() - d.At > TELEPORT_TIMEOUT then
			self:RetryTeleport(p, "timeout")
		end
	end
	local worldReady = s:GetAttribute("Ready")
	local running = self.ctx.Services.DirectorService:IsRunning()
	local anyCountdown = -1
	local anyCount = 0
	-- สมาชิกแท่นแบบ "ติดแท่น": ขึ้นแท่นแล้วอยู่ในกลุ่มจนกว่าจะกดออก (LeavePad) / ออกเดินทาง / ออกเกม
	self.padOf = self.padOf or {}
	for p, box in pairs(self.padOf) do
		local r = p.Parent and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not (r and self:InLobby(p)) then
			self:LeavePad(p)
		else
			-- กันหลุดวง (แลค/ถูกดัน): ไกลเกินขอบวงมาก = ดึงกลับกลางแท่น (ฝั่งผู้เล่นคุมวงนุ่มๆ อยู่แล้ว)
			local rel = box.Zone.CFrame:PointToObjectSpace(r.Position)
			if V(rel.X, 0, rel.Z).Magnitude > 13 then
				r.CFrame = CF(box.Zone.Position + V(0, -2, 0))
			end
		end
	end
	self.padBlock = self.padBlock or {}
	for _, p in ipairs(Players:GetPlayers()) do
		local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if r and self:InLobby(p) then
			-- เพิ่งกดออกจากกลุ่ม: ห้ามถูกดึงกลับเข้าแท่นเดิม จนกว่าจะเดินพ้นแท่นนั้นจริงๆ (และอย่างน้อย 2 วิ)
			local block = self.padBlock[p]
			if block and os.clock() - block.At > 2 and not inside(block.Box.Zone, r.Position) then
				self.padBlock[p] = nil
				block = nil
			end
			if not self.padOf[p] and not (self.departing and self.departing[p]) and not p:GetAttribute("WorldRoom") then
				for _, box in ipairs(self.boxes) do
					-- มีหัวหน้าแท่นแล้วแต่ยังไม่เลือกจำนวน = คนอื่นยังเข้ากลุ่มไม่ได้ (ยืนรอบนแท่น เลือกแล้วเข้าเอง)
					local waitPick = #(box.Order or {}) > 0 and not box.Picked and not running
					if waitPick and not (block and block.Box == box) and inside(box.Zone, r.Position) then
						self.padWaitMsg = self.padWaitMsg or setmetatable({}, { __mode = "k" })
						if os.clock() - (self.padWaitMsg[p] or -99) > 5 then
							self.padWaitMsg[p] = os.clock()
							self.ctx.Notify(p, "Waiting for the pad leader to choose the team size", "Info")
						end
					end
					if not waitPick and not (block and block.Box == box) and inside(box.Zone, r.Position) and #(box.Order or {}) < box.Size then
						box.Order = box.Order or {}
						table.insert(box.Order, p)
						self.padOf[p] = box
						p:SetAttribute("Pad", box.Index)
						break
					end
				end
			end
			if r.Position.Y < self.Position.Y - 150 then
				r.CFrame = CFrame.new(self:SpawnPoint())
			end
		end
	end
	for _, box in ipairs(self.boxes) do
		local members, list = {}, {}
		for _, p in ipairs(box.Order or {}) do
			members[p] = true
			table.insert(list, p)
		end
		box.Members = members
		box.List = list
		local n = #list
		box.Text.Text = string.format("%d/%d", n, box.Size)
		if box.Names then
			local nm = {}
			for _, p in ipairs(list) do
				table.insert(nm, p.DisplayName)
			end
			box.Names.Text = table.concat(nm, " · ")
		end
		box.Zone:SetAttribute("Size", box.Size)
		box.Zone:SetAttribute("Count", n)
		box.Zone:SetAttribute("Countdown", box.Countdown and math.max(0, math.ceil(box.Countdown)) or -1)
		box.Zone:SetAttribute("Host", list[1] and list[1].UserId or 0)
		box.Zone:SetAttribute("Picked", box.Picked == true)
		-- เล่นต่อจากเซฟ: ใช้ได้เฉพาะตอนคนเลือกยังเป็นหัวหน้าแท่น
		if box.Resume and list[1] ~= box.Resume then
			box.Resume = nil
		end
		box.Zone:SetAttribute("ResumeNight", box.Resume and box.Resume:GetAttribute("SavedNight") or nil)
		if not worldReady then
			box.Sub.Text = string.format("⏳ Generating world %d%%", math.floor((s:GetAttribute("LoadProgress") or 0) * 100))
			box.Countdown = nil
		elseif s:GetAttribute("Phase") == "Ended" then
			box.Sub.Text = "Waiting for the previous run to end..."
			box.Countdown = nil
		elseif n == 0 then
			box.Countdown = nil
			box.Picked = false
			box.WaitSince = nil
			box.Resume = nil
			box.Sub.Text = running and "⚔ Join the team in progress" or "Step on the pad to start"
			box.Pad.Color = PORTAL_VEIL
			box.Ring.Color = PORTAL_IDLE
			if box.Disc then
				box.Disc.Color, box.Edge.Color, box.Rise.Rate = PORTAL_IDLE, PORTAL_IDLE, 10
			end
			box.Pillar.Color = PORTAL_VEIL
			box.Motes.Color = ColorSequence.new(C(190, 245, 255))
			box.Motes.Rate = 8
		elseif not box.Picked and not running then
			-- ยังไม่เลือกจำนวนคน: ยังไม่นับถอยหลัง (หัวหน้าแท่นเลือกก่อน แล้วค่อยเริ่มนับ)
			box.Countdown = nil
			box.Sub.Text = "Waiting for the pad leader to choose the team size"
			-- หัวหน้าไม่เลือกนาน 30 วิ (AFK) = ตั้ง 4 คนให้เอง ไม่ให้แท่นค้างจนคนอื่นเข้าไม่ได้
			box.WaitSince = box.WaitSince or os.clock()
			if os.clock() - box.WaitSince > 30 then
				box.Size = math.max(4, n)
				box.Picked = true
			end
			box.Pad.Color = PORTAL_VEIL
			box.Ring.Color = PORTAL_IDLE
			if box.Disc then
				box.Disc.Color, box.Edge.Color, box.Rise.Rate = PORTAL_IDLE, PORTAL_IDLE, 16
			end
			anyCount += n
		else
			local target = running and COUNTDOWN_JOIN or ((n >= box.Size) and COUNTDOWN_FULL or COUNTDOWN)
			box.Countdown = math.min(box.Countdown or target, target) - dt
			box.Sub.Text = string.format("Departing in %d", math.max(0, math.ceil(box.Countdown)))
			box.Pad.Color = PORTAL_GO_VEIL
			box.Ring.Color = PORTAL_GO
			if box.Disc then
				box.Disc.Color, box.Edge.Color, box.Rise.Rate = PORTAL_GO, PORTAL_GO, 30
			end
			box.Pillar.Color = PORTAL_GO_VEIL
			box.Motes.Color = ColorSequence.new(C(170, 255, 180))
			box.Motes.Rate = 24
			anyCountdown = math.max(anyCountdown, math.ceil(box.Countdown))
			anyCount += n
			if box.Countdown <= 0 then
				box.Countdown = nil
				local resume = not running and box.Resume or nil
				box.Resume = nil
				self:DepartTeam(list, resume)
			end
		end
	end
	s:SetAttribute("PortalCount", anyCount)
	s:SetAttribute("PortalCountdown", anyCountdown)
end

-- ออกจากกลุ่มแท่น: เอาออกจากรายชื่อ · ถ้ายังยืนบนแท่นอยู่ ส่งไปยืนนอกวง (ฝั่งจุดเกิด) จะได้ไม่ถูกดึงกลับเข้ากลุ่มทันที
function LobbyService:LeavePad(player, moveOut)
	local box = self.padOf and self.padOf[player]
	if not box then
		return
	end
	self.padOf[player] = nil
	local order = box.Order or {}
	local i = table.find(order, player)
	if i then
		table.remove(order, i)
	end
	if #order == 0 then
		box.Countdown = nil
		box.Size = 4
		box.Picked = false
		box.WaitSince = nil
	end
	if player.Parent then
		player:SetAttribute("Pad", nil)
	end
	if moveOut then
		self.padBlock = self.padBlock or {}
		self.padBlock[player] = { Box = box, At = os.clock() }
	end
	local r = moveOut and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if r then
		local c = box.Zone.Position
		local d = (self.spawnCf.Position - c) * V(1, 0, 1)
		d = d.Magnitude > 0.1 and d.Unit or V(0, 0, 1)
		local p = c + d * 17 -- พ้นกล่องแท่น (21x21) แม้ออกแนวทแยง
		r.CFrame = CF(V(p.X, c.Y - 2, p.Z), V(p.X, c.Y - 2, p.Z) + d)
	end
end

-- ดึงอันดับใหม่ทั้ง 2 แบบ (ทั้งเกม + สัปดาห์นี้) แล้วโชว์แบบที่กำลังเปิดอยู่ (ป้ายสลับเองทุก BOARD_FLIP วินาที)
local BOARD_FLIP = 12
function LobbyService:RefreshBoard()
	if not self.boardGuis then
		return
	end
	local list = self.ctx.Services.DataService:GetTop(Config.LeaderboardSize)
	local qs = self.ctx.Services.QuestService
	local week = qs and qs:GetTopWeekly(Config.LeaderboardSize)
	self.boardLists = {
		All = { List = list or rowsFromServer(self, false), Global = list ~= nil },
		Week = { List = week or rowsFromServer(self, true), Global = week ~= nil },
	}
	self:ShowBoard()
end

function LobbyService:ShowBoard()
	local mode = self.boardMode or "All"
	local info = self.boardLists and self.boardLists[mode]
	if not (self.boardGuis and info) then
		return
	end
	local list, global = info.List, info.Global
	local vipNames = {}
	local nameColors = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Pass_VIP") then
			vipNames[p.UserId] = true
		end
		local nc = p:GetAttribute("NameColor")
		if typeof(nc) == "Color3" then
			nameColors[p.UserId] = nc
		end
	end
	for _, gui in ipairs(self.boardGuis) do
		if gui.Title then
			gui.Title.Text = mode == "Week" and "📅 Longest Survivors This Week" or "🏆 Longest Survivors of All Time"
		end
		local tabs = mode == "Week" and "All Time · [ This Week ]" or "[ All Time ] · This Week"
		gui.Sub.Text = tabs .. "  —  " .. (global and "All servers · Updates every minute" or "This server only (save system not connected yet)")
		for i, r in ipairs(gui.Rows) do
			local e = list[i]
			if e and (e.Value or 0) > 0 then
				r.Name.Text = displayName(e.UserId)
				r.Name.TextColor3 = vipNames[e.UserId] and Color3.fromRGB(255, 214, 90) or nameColors[e.UserId] or Color3.fromRGB(240, 240, 250)
				r.Value.Text = string.format("%d days", e.Value)
				r.Face.Image = thumb(e.UserId)
				r.Row.Visible = true
			else
				r.Name.Text = "—"
				r.Value.Text = ""
				r.Face.Image = ""
				r.Row.Visible = i <= 3
			end
		end
	end
end

function LobbyService:Start(ctx)
	ctx.Remotes.Get("LeaveRun").OnServerEvent:Connect(function(player)
		self:LeaveRun(player)
	end)
	-- ป้ายบนหัว: สร้างทุกครั้งที่เกิด + อัปเดตเมื่อสถิติ/สถานะเปลี่ยน
	local function hookTag(player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Head", 10)
			self:RefreshTag(player)
		end)
		player:GetAttributeChangedSignal("BestNight"):Connect(function()
			self:RefreshTag(player)
		end)
		player:GetAttributeChangedSignal("InRun"):Connect(function()
			self:RefreshTag(player)
		end)
		for _, attr in ipairs({ "Class", "ClassLevel" }) do
			player:GetAttributeChangedSignal(attr):Connect(function()
				self:RefreshTag(player)
			end)
		end
		if player.Character then
			self:RefreshTag(player)
		end
		-- กลับมาจากเซิร์ฟเวอร์ของทีม: สรุปผลรอบที่แล้ว
		local okJoin, join = pcall(function()
			return player:GetJoinData()
		end)
		local td = okJoin and join and join.TeleportData
		if type(td) == "table" and td.Back and not self.IsTeamServer then
			task.delay(6, function()
				if player.Parent and td.Result == "Defeat" then
					ctx.Notify(player, string.format("🔥 Last run: the team reached night %d — try again!", tonumber(td.Night) or 0), "Info")
				end
			end)
		end
	end
	Players.PlayerAdded:Connect(hookTag)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(hookTag, p)
	end
	-- กันพลาด: ไล่เช็กป้ายบนหัวทุกคนทุก 3 วิ (ตัวละครโหลดช้า/ชุดเปลี่ยน/หัวถูกสลับ)
	task.spawn(function()
		while true do
			task.wait(3)
			for _, p in ipairs(Players:GetPlayers()) do
				pcall(self.RefreshTag, self, p)
			end
		end
	end)
	-- เทเลพอร์ตบางคนล้มเหลว (เน็ตหลุด/เซิร์ฟเวอร์ยังไม่พร้อม) -> ลองใหม่เข้าเซิร์ฟเวอร์เดียวกับทีม
	pcall(function()
		TeleportService.TeleportInitFailed:Connect(function(player, result, msg)
			if self.departing and self.departing[player] then
				warn("[AS] teleport init failed", player.Name, tostring(result), tostring(msg))
				self:RetryTeleport(player, msg or tostring(result))
			end
		end)
	end)
	ctx.Remotes.Get("PadSize").OnServerEvent:Connect(function(player, index, n)
		local box = self.boxes and self.boxes[tonumber(index) or 0]
		n = math.floor(tonumber(n) or 0)
		if not box or n < 1 or n > 8 or not (box.Members and box.Members[player]) then
			return
		end
		if box.List and box.List[1] ~= player then
			ctx.Notify(player, "Only the pad leader (first one on) can choose the team size", "Info")
			return
		end
		box.Size = math.max(n, #(box.List or {}))
		box.Countdown = nil
		box.Picked = true -- เริ่มนับถอยหลังหลังเลือกจำนวนแล้วเท่านั้น
		box.WaitSince = nil
	end)
	-- หัวหน้าแท่นที่มี Save Run: เลือกเล่นต่อจากรอบที่เซฟไว้ (on = false ยกเลิก)
	ctx.Remotes.Get("PadResume").OnServerEvent:Connect(function(player, index, on)
		local box = self.boxes and self.boxes[tonumber(index) or 0]
		if not box or not (box.List and box.List[1] == player) then
			return
		end
		-- แท่นธรรมดาไม่มีเล่นต่อจากเซฟแล้ว (โลกที่เซฟไว้เปิดจากเมนู Worlds -> WorldService)
		box.Resume = nil
	end)
	ctx.Remotes.Get("LeavePad").OnServerEvent:Connect(function(player)
		self:LeavePad(player, true)
	end)
	ctx.Remotes.Get("BuyKit").OnServerEvent:Connect(function(player, kitId)
		local kit = Shop.KitById[kitId]
		local data = ctx.Services.DataService:Get(player)
		if not (kit and data) then
			return
		end
		if player:GetAttribute("InRun") then
			ctx.Notify(player, "Starter kits can only be bought in the lobby", "Error")
			return
		end
		data.PendingKits = data.PendingKits or {}
		if data.PendingKits[kitId] then
			ctx.Notify(player, "You already bought this kit (you'll get it when you depart)", "Info")
			return
		end
		if data.Diamonds < kit.Price then
			ctx.Notify(player, "♦️ Not enough Ruby", "Error")
			return
		end
		data.Diamonds -= kit.Price
		data.PendingKits[kitId] = true
		player:SetAttribute("Diamonds", data.Diamonds)
		ctx.Notify(player, "🛒 Bought " .. kit.Name .. " — you'll get it when you depart", "Reward")
		ctx.Remotes.Get("Profile"):FireClient(player, data)
	end)
	-- เซิร์ฟเวอร์ของทีม: ไม่มีล็อบบี้ ลงแมพทันทีที่โลกพร้อม
	if self.IsTeamServer then
		local function arrive(p)
			task.spawn(function()
				while not ctx.State:GetAttribute("Ready") do
					task.wait(0.5)
				end
				-- หลุดกลางรอบแล้วกลับมา: คืนสถานะเดิม (RejoinService) แทนการเริ่มใหม่
				local rejoin = ctx.Services.RejoinService
				if p.Parent and rejoin and rejoin:OnTeamArrive(p) then
					return
				end
				self:Depart(p)
			end)
		end
		Players.PlayerAdded:Connect(arrive)
		for _, p in ipairs(Players:GetPlayers()) do
			arrive(p)
		end
	end
	task.spawn(function()
		local t, flip = 0, 0
		while true do
			local dt = task.wait(0.25)
			t += dt
			flip += dt
			if flip >= BOARD_FLIP and self.boardLists then
				flip = 0
				self.boardMode = self.boardMode == "Week" and "All" or "Week"
				task.spawn(function()
					local ok, err = pcall(self.ShowBoard, self)
					if not ok then
						warn("[AS] board", err)
					end
				end)
			end
			local ok, err = pcall(self.Tick, self, dt)
			if not ok then
				warn("[AS] lobby", err)
			end
			if t > 60 or not self.boardOnce then
				t = 0
				self.boardOnce = true
				task.spawn(function()
					local ok, err = pcall(self.RefreshBoard, self)
					if not ok then
						warn("[AS] board", err)
					end
				end)
			end
		end
	end)
end

return LobbyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006B"><Properties><string name="Name">LootService</string><ProtectedString name="Source"><![CDATA[--[[
	LootService — หีบในซากปรักหักพัง (เปิดได้รอบละครั้ง) + อันตรายในโลก (ลาวา/ปล่องไฟ)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ChestLid = require(game:GetService("ReplicatedStorage").Shared.ChestLid)
local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local LootService = {}

local LOOT = {
	Earth = { { "Iron", 1, 3 }, { "TerraCore", 0, 2 }, { "Bandage", 0, 1 }, { "Berries", 2, 4 } },
	Water = { { "Fiber", 3, 5 }, { "Iron", 1, 2 }, { "TidePearl", 0, 2 }, { "Bandage", 0, 1 }, { "CookedMeat", 1, 2 } },
	Air = { { "Stone", 3, 5 }, { "Iron", 1, 3 }, { "GaleFeather", 0, 2 }, { "Bandage", 0, 1 }, { "Pelt", 1, 2 } },
	Fire = { { "Coal", 2, 4 }, { "Iron", 1, 3 }, { "EmberShard", 0, 2 }, { "Bandage", 0, 1 }, { "Stone", 2, 4 } },
}

-- กล่อง 3 ระดับ (โมเดล Props/Chest1-3 · ไม่มี = กล่องไม้เดิม) กระจายทั่วแมพ Config.CrateCount ใบ
--   ระดับ 1 (ธรรมดา) / 2 (หายาก) / 3 (ตำนาน) : สุ่มตามน้ำหนัก Config.CrateTierWeight · ระดับสูง = อาวุธดีขึ้น ของมากขึ้น
local TIER_TOOLS = {
	-- น้ำหนัก = % (แต่ละระดับรวม 100)
	{ { "StoneAxe", 18 }, { "Spear", 16 }, { "Dagger", 16 }, { "SpikedClub", 14 }, { "Pickaxe", 10 }, { "Torch", 9 }, { "Bow", 6 }, { "GoodSack", 11 } },
	{ { "IronSword", 18 }, { "Mace", 18 }, { "IronAxe", 16 }, { "Bow", 12 }, { "Crossbow", 7 }, { "Katana", 6 }, { "GoodSack", 13 }, { "GiantSack", 10 } },
	{ { "Katana", 20 }, { "BattleAxe", 21 }, { "Crossbow", 19 }, { "WarHammer", 14 }, { "Scythe", 14 }, { "GiantSack", 12 } },
}
-- ของใช้ในกล่อง (ไม่มีไม้ — ไม้หาเองจากต้นไม้)
local TIER_EXTRA = {
	{ count = { 2, 3 }, pool = { { "Bandage", 1, 1 }, { "CookedMeat", 1, 2 }, { "Berries", 2, 4 }, { "Coal", 1, 3 }, { "Fiber", 2, 4 }, { "Pelt", 1, 2 } } },
	{ count = { 3, 4 }, pool = { { "Bandage", 1, 2 }, { "CookedMeat", 2, 3 }, { "Iron", 2, 4 }, { "Coal", 2, 4 }, { "Pelt", 2, 3 }, { "Bone", 2, 3 }, { "AnyEssence", 1, 1 } } },
	{ count = { 4, 5 }, pool = { { "Medkit", 1, 1 }, { "Iron", 4, 6 }, { "Coal", 3, 5 }, { "Pelt", 3, 4 }, { "AnyEssence", 1, 2 }, { "AnyEssence", 1, 2 }, { "Stew", 1, 2 } } },
}
local TIER_NAME = { "Supply Crate", "Rare Chest", "Legendary Chest" }
local TIER_LIGHT = { Color3.fromRGB(150, 255, 170), Color3.fromRGB(190, 140, 255), Color3.fromRGB(255, 214, 110) }
local ESSENCES = { "TerraCore", "TidePearl", "GaleFeather", "EmberShard" }
LootService.TierTools = TIER_TOOLS

-- (เดิม) กล่องเสบียงกระจายทั่วแมพ: อาวุธ/เครื่องมือทั่วไป 1 ชิ้น (ไม่มีของธาตุ) + ของใช้อีก 2-3 อย่าง
local CRATE_TOOLS = { { "StoneAxe", 25 }, { "Spear", 22 }, { "Bow", 15 }, { "Pickaxe", 15 }, { "Torch", 13 }, { "IronAxe", 7 }, { "GoodSack", 3 } }
local CRATE_EXTRA = {
	{ "Bandage", 1, 1 }, { "CookedMeat", 1, 2 }, { "Berries", 2, 4 }, { "Iron", 1, 3 },
	{ "Coal", 1, 3 }, { "Fiber", 2, 4 }, { "Pelt", 1, 2 },
}

local function weighted(rng, list)
	local total = 0
	for _, e in ipairs(list) do
		total += e[2]
	end
	local r = rng:NextNumber() * total
	for _, e in ipairs(list) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return list[1][1]
end

function LootService:Init(ctx)
	self.ctx = ctx
	self.chests = {}
	self.rayParams = RaycastParams.new()
	self.rayParams.FilterType = Enum.RaycastFilterType.Include
	self.rayParams.FilterDescendantsInstances = { Workspace.Terrain }
end

-- เอฟเฟกต์เปิดกล่อง (ทุกคนที่อยู่ใกล้เห็น): กล่องสั่น -> เด้ง -> แสงพุ่ง + ประกาย · tier 1-3 = ยิ่งสูงยิ่งอลัง
--   หีบที่มีฝาจริง (ChestLid): สั่น -> ฝาเด้งเปิด (เครื่องผู้เล่นเล่นแอนิเมชัน) แล้วเซิร์ฟเวอร์ตั้งฝาเปิดค้างไว้
--   only = ผู้เล่น: กล่องส่วนตัว (เปิดได้ทุกคน คนละรอบ) -> เล่นเฉพาะเครื่องคนเปิด ไม่ขยับฝาฝั่งเซิร์ฟเวอร์
function LootService:ChestFx(model, pos, tier, color, only)
	tier = math.clamp(tier or 1, 1, 3)
	local data = { Model = model, Position = pos, Tier = tier, Color = color or TIER_LIGHT[tier] }
	if only then
		self.ctx.Remotes.Get("HitFx"):FireClient(only, "ChestOpen", data)
		return
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("ChestOpen", data)
	local lid, hinge = ChestLid.Find(model)
	if lid then
		local closed = ChestLid.Closed(lid)
		task.delay(1.2, function()
			if lid.Parent and model:GetAttribute("Opened") ~= false then
				lid.CFrame = ChestLid.CFrameAt(closed, hinge, 1)
			end
		end)
	end
end

-- ปิดฝาคืน (เริ่มรอบใหม่)
function LootService.CloseLid(model)
	local lid = ChestLid.Find(model)
	if lid and typeof(lid:GetAttribute("ClosedCF")) == "CFrame" then
		lid.CFrame = lid:GetAttribute("ClosedCF")
	end
end

-- กล่องเปิดได้ทุกคน คนละ 1 ครั้งต่อรอบ: จำคนที่เปิดแล้วเป็น attribute "Opened_<UserId>" (client ซ่อนกล่องเฉพาะเครื่องคนนั้น)
local function openKey(player)
	return "Opened_" .. player.UserId
end
local function clearOpened(inst)
	for k in pairs(inst:GetAttributes()) do
		if string.sub(k, 1, 7) == "Opened_" then
			inst:SetAttribute(k, nil)
		end
	end
end

function LootService:Open(chest, player)
	local key = openKey(player)
	if chest:GetAttribute(key) or not player:GetAttribute("InRun") then
		return
	end
	chest:SetAttribute(key, true)
	local el = chest:GetAttribute("Element") or "Earth"
	local rng = Random.new()
	local got = {}
	for _, entry in ipairs(LOOT[el]) do
		local n = rng:NextInteger(entry[2], entry[3])
		if n > 0 then
			n = self.ctx.Services.DropService:SpawnLoot(entry[1], n, chest:GetPivot().Position + Vector3.new(0, 1, 0))
			got[entry[1]] = n > 0 and n or nil
		end
	end
	if rng:NextNumber() < 0.15 then
		self.ctx.Services.DataService:AddDiamonds(player, rng:NextInteger(1, 3), "Treasure Chest")
	end
	self.ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = chest:GetPivot().Position, Chest = true })
	self:ChestFx(chest, chest:GetPivot().Position, 2, nil, player)
end

function LootService:SetupChest(chest)
	local body = chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart")
	if not body then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open Chest"
	prompt.ObjectText = "Ancient Chest"
	prompt.HoldDuration = 0.8
	prompt.MaxActivationDistance = 12
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		self:Open(chest, player)
	end)
	chest:SetAttribute("LidCF", chest.Lid.CFrame)
	table.insert(self.chests, chest)
end

---------------------------------------------------------------- กล่องเสบียง (กระจายทั่วแมพ)
function LootService:OpenCrate(crate, player)
	local key = openKey(player)
	if crate:GetAttribute(key) then
		return
	end
	crate:SetAttribute(key, true)
	local pin = self.pins and self.pins[crate]
	if pin then
		pin:SetAttribute(key, true)
	end
	local rng = Random.new()
	local tier = math.clamp(crate:GetAttribute("Tier") or 1, 1, 3)
	local pos = crate:GetPivot().Position + Vector3.new(0, 2, 0)
	local got = self:GiveTierLoot(tier, pos, rng)
	if tier >= 2 then
		self.ctx.Services.DataService:AddDiamonds(player, rng:NextInteger(tier == 3 and 3 or 1, tier == 3 and 4 or 2), TIER_NAME[tier])
	end
	self.ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = pos, Chest = true })
	-- เอฟเฟกต์ + ปิดปุ่ม + กล่องจางหาย: เฉพาะเครื่องคนเปิด (CombatClient) · คนอื่นยังเปิดกล่องนี้ได้
	self:ChestFx(crate, pos, tier, nil, player)
end

-- ของในกล่องระดับ tier (1-3) วางพื้นรอบ pos · คืน { [id] = จำนวน } (วิหารใช้ระดับ 3)
function LootService:GiveTierLoot(tier, pos, rng)
	rng = rng or Random.new()
	local drops = self.ctx.Services.DropService
	local got = {}
	local function give(id, n)
		if id == "AnyEssence" then
			id = ESSENCES[rng:NextInteger(1, #ESSENCES)]
		end
		if n > 0 then
			drops:Spawn(id, n, pos, { Spread = 3 })
			got[id] = (got[id] or 0) + n
		end
	end
	give(weighted(rng, TIER_TOOLS[tier]), 1)
	local ex = TIER_EXTRA[tier]
	local pool = table.clone(ex.pool)
	for _ = 1, rng:NextInteger(ex.count[1], ex.count[2]) do
		local e = table.remove(pool, rng:NextInteger(1, #pool))
		give(e[1], rng:NextInteger(e[2], e[3]))
	end
	if tier == 1 and rng:NextNumber() < 0.08 then
		give("Medkit", 1)
	end
	return got
end

function LootService:SpawnCrates()
	local layout = self.ctx.Layout
	local world = Workspace:FindFirstChild("World")
	if not (layout and world) then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "SupplyCrates"
	folder.Parent = world
	local PropBuilder = require(game:GetService("ReplicatedStorage").Shared.PropBuilder)
	local size = layout.Size or 6144
	local count = Config.CrateCount or 40
	local weights = Config.CrateTierWeight or { 18, 14, 8 }
	local rng = Random.new((self.ctx.State:GetAttribute("Seed") or 1) + 777)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { Workspace.Terrain, world }
	local placed = {}
	local tries = 0
	-- ห้ามซ้อนในของ: เดิมเช็กแค่ยิงลงจากฟ้าตรงจุดเดียว -> กล่องเกิดในก้อนหิน/แท่งน้ำแข็ง/ซากที่ยื่นมาคลุม
	--   (มีปุ่ม Open แต่มองไม่เห็นกล่อง · เทส --crateprobe เจอ 3/40 ใบ) -> ต้องโล่งทั้งกล่อง + ขอบรอบ
	local clearParams = OverlapParams.new()
	clearParams.FilterType = Enum.RaycastFilterType.Include
	clearParams.FilterDescendantsInstances = { world }
	local function spotClear(p)
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(p + Vector3.new(0, 4.5, 0)), Vector3.new(11, 8, 11), clearParams)) do
			local s = part.Size
			-- หญ้า/เฟิร์นเล็กๆ (ทะลุได้) ไม่นับ · ของแข็งทุกชิ้น (หินแร่แยกเป็นก้อนเล็ก) + ของใหญ่ (ต้นไม้ พุ่ม ซาก) = ไม่โล่ง
			if part.Transparency < 0.9 and not part:IsDescendantOf(folder) and (part.CanCollide or math.max(s.X, s.Y, s.Z) > 3) then
				return false
			end
		end
		return true
	end
	while #placed < count and tries < count * 30 do
		tries += 1
		local a, r = rng:NextNumber(0, math.pi * 2), size * 0.42 * math.sqrt(rng:NextNumber(0.02, 1))
		local x, z = math.cos(a) * r, math.sin(a) * r
		local ok = r > 150 -- ไม่วางในแคมป์
		for _, p in ipairs(placed) do
			if ok and (p - Vector3.new(x, p.Y, z)).Magnitude < size * (tries < count * 15 and 0.06 or 0.035) then
				ok = false
			end
		end
		local hit = ok and Workspace:Raycast(Vector3.new(x, 1500, z), Vector3.new(0, -3000, 0), rp)
		-- ต้องตกบนพื้นดินโล่ง (ไม่ใช่น้ำ/บนหิน/ในซาก) และไม่ชันเกิน
		if hit and hit.Instance == Workspace.Terrain and hit.Material ~= Enum.Material.Water and hit.Normal.Y > 0.85 and spotClear(hit.Position) then
			local cf = CFrame.new(hit.Position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			-- ระดับ: สุ่มตามน้ำหนัก (ครบจำนวนแน่นอน: ระดับ 3 = weights[3] ใบ ฯลฯ)
			local tier = 1
			do
				local left = { weights[1], weights[2], weights[3] }
				for _, c in ipairs(folder:GetChildren()) do
					local t = c:GetAttribute("Tier")
					if t then
						left[t] -= 1
					end
				end
				local total = math.max(0, left[1]) + math.max(0, left[2]) + math.max(0, left[3])
				local roll = rng:NextNumber() * math.max(total, 1)
				for t = 3, 1, -1 do
					roll -= math.max(0, left[t])
					if roll <= 0 and left[t] > 0 then
						tier = t
						break
					end
				end
			end
			local width = ({ 5.4, 6.2, 7.2 })[tier]
			local crate = PropBuilder.Imported("Chest" .. tier .. "Open", cf, width, folder, true) -- ฝาเปิดได้จริง
				or PropBuilder.Imported("Chest" .. tier, cf, width, folder, true)
			crate = crate or PropBuilder.StoreModel("Crate", cf, folder)
			if not crate then
				crate = Instance.new("Model")
				local box = Instance.new("Part")
				box.Name = "Body"
				box.Size = Vector3.new(3.6, 3.6, 3.6)
				box.CFrame = cf * CFrame.new(0, 1.8, 0)
				box.Anchored = true
				box.Color = Color3.fromRGB(150, 106, 64)
				box.Material = Enum.Material.WoodPlanks
				box.Parent = crate
				crate.PrimaryPart = box
				crate.Parent = folder
			end
			crate.Name = "SupplyCrate"
			crate:SetAttribute("Tier", tier)
			local body = crate.PrimaryPart or crate:FindFirstChildWhichIsA("BasePart", true)
			-- แสงเรืองอ่อนๆ ตามสีระดับ ให้มองเห็นจากไกล (โดยเฉพาะกลางคืน)
			local glow = Instance.new("PointLight")
			glow.Color = TIER_LIGHT[tier]
			glow.Range = 11 + tier * 4
			glow.Brightness = 0.6 + tier * 0.3
			glow.Parent = body
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Open"
			prompt.ObjectText = TIER_NAME[tier]
			prompt.HoldDuration = 0.4 + tier * 0.3
			prompt.MaxActivationDistance = 13
			prompt.RequiresLineOfSight = false
			prompt.Parent = body
			prompt.Triggered:Connect(function(player)
				if player:GetAttribute("InRun") and not self.ctx.Services.SurvivalService:IsIncapacitated(player) then
					self:OpenCrate(crate, player)
				end
			end)
			CollectionService:AddTag(crate, "SupplyCrate")
			table.insert(placed, hit.Position)
		end
	end
	self.crates = folder
	self:PublishPins()
end

-- หมุดกล่องบนแผนที่: ReplicatedStorage.MapPins (Vector3Value "Crate" · Tier/Opened)
--   กล่องจริงอยู่ไกล = StreamingEnabled ไม่ส่งมาให้ client -> ต้องส่งตำแหน่งแยกไว้ให้ MapUI
function LootService:PublishPins()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local old = ReplicatedStorage:FindFirstChild("MapPins")
	if old then
		old:Destroy()
	end
	local pins = Instance.new("Folder")
	pins.Name = "MapPins"
	self.pins = {}
	for _, crate in ipairs(self.crates and self.crates:GetChildren() or {}) do
		local pin = Instance.new("Vector3Value")
		pin.Name = "Crate"
		pin.Value = crate:GetPivot().Position
		pin:SetAttribute("Tier", crate:GetAttribute("Tier") or 1)
		self.pins[crate] = pin -- เปิดแล้ว = "Opened_<UserId>" (หมุดจางเฉพาะคนที่เปิด)
		pin.Parent = pins
	end
	pins.Parent = ReplicatedStorage
end

function LootService:Reset()
	for _, pin in pairs(self.pins or {}) do
		clearOpened(pin)
	end
	for _, crate in ipairs(self.crates and self.crates:GetChildren() or {}) do
		clearOpened(crate)
		LootService.CloseLid(crate)
		for _, d in ipairs(crate:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Transparency = d:GetAttribute("BaseTransparency") or d.Transparency
				local bc = d:GetAttribute("BaseCollide")
				if bc ~= nil then
					d.CanCollide = bc
				end
			elseif d:IsA("ProximityPrompt") or d:IsA("Light") or d:IsA("ParticleEmitter") then
				d.Enabled = true
			end
		end
	end
	for _, chest in ipairs(self.chests) do
		clearOpened(chest)
		LootService.CloseLid(chest)
		local lid = chest:FindFirstChild("Lid")
		if lid and chest:GetAttribute("LidCF") then
			lid.CFrame = chest:GetAttribute("LidCF")
		end
		local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt then
			prompt.Enabled = true
		end
	end
end

-- ลาวา / ปล่องไฟ
function LootService:HazardTick(dt)
	local surv = self.ctx.Services.SurvivalService
	local vents = CollectionService:GetTagged("Hazard")
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if r and surv:IsAlive(p) then
			local res = Workspace:Raycast(r.Position, Vector3.new(0, -7, 0), self.rayParams)
			if res and res.Material == Enum.Material.CrackedLava then
				surv:Damage(p, 2 * dt, "Lava") -- ลาวา: 2 ดาเมจ/วิ
			end
			for _, v in ipairs(vents) do
				if (v:GetPivot().Position - r.Position).Magnitude < 6 then
					surv:Damage(p, 2 * dt, "Lava")
				end
			end
		end
	end
end

function LootService:Start(ctx)
	for _, chest in ipairs(CollectionService:GetTagged("Chest")) do
		self:SetupChest(chest)
	end
	local ok, err = pcall(self.SpawnCrates, self)
	if not ok then
		warn("[AS] Couldn't place supply crate:", err)
	end
	task.spawn(function()
		while true do
			local dt = task.wait(0.5)
			pcall(self.HazardTick, self, dt)
		end
	end)
end

return LootService
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX0000006C"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	ANIMAL SURVIVAL — 99 Nights of the Elements
	Main (server): สุ่ม seed -> สร้างแมพยักษ์ 4 ธาตุ -> วางพร็อพ/สถานที่ -> เปิดทุกระบบ -> ให้ผู้เล่นเกิด
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
if ReplicatedStorage:FindFirstChild("ASAutoTest") and not ReplicatedStorage:FindFirstChild("ASSiteProbe") then -- ถ่ายเช็กจุดสำคัญใช้แมพขนาดจริง
	Config.ApplyTestOverrides()
end
local Remotes = require(Shared.Remotes)
local MapLayout = require(Shared.MapLayout)
local MapGenerator = require(Shared.MapGenerator)
local PropBuilder = require(Shared.PropBuilder)
local Atmosphere = require(Shared.Atmosphere)
local Items = require(Shared.Items)

Players.CharacterAutoLoads = false
Remotes.Init()

---------------------------------------------------------------- สถานะเกม (client อ่านจาก attributes)
local State = Instance.new("Folder")
State.Name = "GameState"
State:SetAttribute("Ready", false)
State:SetAttribute("Phase", "Loading")
State:SetAttribute("LoadProgress", 0)
State:SetAttribute("Night", 1)
State.Parent = ReplicatedStorage

-- เซิร์ฟเวอร์ทีมที่เปิดใหม่เพื่อเล่นรอบเดิมต่อ (ทุกคนหลุดออกไปก่อนหน้า) -> ใช้ seed เดิม = แมพเดิม
local resume = require(script.Parent:WaitForChild("RejoinService")).LoadHeldRun()
local seedValue = ReplicatedStorage:FindFirstChild("ASSeed")
local seed = (resume and resume.Seed) or (seedValue and seedValue.Value) or Config.Seed or Random.new():NextInteger(1, 2 ^ 30)
State:SetAttribute("Seed", seed)
State:SetAttribute("MapSize", Config.MapSize)
State:SetAttribute("WaterLevel", Config.WaterLevel)
print(string.format("[AS] seed=%d map=%d", seed, Config.MapSize))

local layout = MapLayout.new(seed, Config.MapSize, Config)

-- ลบแมพตัวอย่างจากปลั๊กอิน (ถ้าเซฟติดมา)
Workspace.Terrain:Clear()
local old = Workspace:FindFirstChild("World")
if old then
	old:Destroy()
end
Atmosphere.Install(Lighting)
Atmosphere.Apply(Lighting, Atmosphere.Values("Heart", 0))

---------------------------------------------------------------- บริการทั้งหมด
local Server = script.Parent
local ctx = {
	Config = Config,
	Layout = layout,
	Seed = seed,
	Resume = resume,
	State = State,
	Remotes = Remotes,
	Services = {},
	CampPosition = Vector3.new(0, layout:HeightAt(0, 0) + 0.5, 0),
}
State:SetAttribute("CampPos", ctx.CampPosition)
function ctx.Notify(player, text, kind)
	Remotes.Get("Notify"):FireClient(player, text, kind or "Info")
end
-- ส่งให้เฉพาะผู้เล่นที่อยู่ในรอบ (ในแมพ) — คนในล็อบบี้ไม่ต้องเห็นเหตุการณ์ในเกม
function ctx.FireRun(remoteName, ...)
	local remote = Remotes.Get(remoteName)
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		if p:GetAttribute("InRun") then
			remote:FireClient(p, ...)
		end
	end
end
-- except = ไม่ส่งให้คนนี้ (เช่น คนที่ล้มเองไม่ต้องเห็น "X ล้มลง")
function ctx.Broadcast(text, kind, except)
	local remote = Remotes.Get("Notify")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= except and p:GetAttribute("InRun") then
			remote:FireClient(p, text, kind or "Info")
		end
	end
end

local order = {
	"DataService", "DevService", "InventoryService", "DropService", "SurvivalService", "LobbyService", "MonetizationService", "ResourceService", "CampService", "BuildingService",
	"CombatService", "AnimalService", "SkillService", "SpiritService", "MountService", "LootService", "TraderService", "DirectorService",
	"FriendService", "SeasonService", "QuestService",
	"PingService", "RejoinService",
	"EventService", "SanctumService", "PortalService", "WorldService",
}
for _, name in ipairs(order) do
	ctx.Services[name] = require(Server:WaitForChild(name))
end
for _, name in ipairs(order) do
	ctx.Services[name]:Init(ctx)
end
local function start(names)
	for _, name in ipairs(names) do
		local ok, err = pcall(function()
			ctx.Services[name]:Start(ctx)
		end)
		if not ok then
			warn("[AS] start " .. name .. " failed:", err)
		end
	end
end

-- ช่วงที่ 1: ล็อบบี้พร้อมทันที (ผู้เล่นเกิดในล็อบบี้ระหว่างรอสร้างแมพ)
ctx.Services.LobbyService:Build()
start({ "DataService", "DevService", "InventoryService", "SurvivalService", "LobbyService", "MonetizationService", "RejoinService", "WorldService" })
start({ "FriendService", "SeasonService", "QuestService" }) -- ภารกิจ / ล็อกอิน / Season Pass / โค้ด / โบนัสเพื่อน

---------------------------------------------------------------- สร้างโลก
local t0 = os.clock()
-- Studio (กด Play) เซิร์ฟเวอร์กับผู้เล่นอยู่โปรแกรมเดียวกัน -> แบ่งเวลาสร้างโลกต่อเฟรมให้น้อยลง หน้าโหลด/ล็อบบี้จะไม่กระตุก
local genBudget = game:GetService("RunService"):IsStudio() and 0.016 or 0.04
MapGenerator.Generate(layout, {
	Yield = true,
	Budget = genBudget,
	Progress = function(done, total)
		State:SetAttribute("LoadProgress", done / total * 0.8)
	end,
})
State:SetAttribute("LoadProgress", 0.85)
print(string.format("[AS] terrain %.1fs", os.clock() - t0))
local world = PropBuilder.BuildWorld(layout, { Density = Config.PropDensity, Yield = true, Budget = genBudget * 0.75 })
-- แคมป์วางบนพื้นจริง (สูงกว่า HeightAt ได้) -> อัปเดตตำแหน่งแคมป์ให้ตรง
local campModel = world:FindFirstChild("Sites") and world.Sites:FindFirstChild("Camp")
if campModel and campModel:GetAttribute("GroundY") then
	ctx.CampPosition = Vector3.new(0, campModel:GetAttribute("GroundY") + 0.5, 0)
	State:SetAttribute("CampPos", ctx.CampPosition)
end
State:SetAttribute("LoadProgress", 1)
print(string.format("[AS] world ready %.1fs props=%d", os.clock() - t0, world:GetAttribute("PropCount") or 0))
for _, sp in ipairs(layout.Specials) do
	if sp.Kind == "Shrine" or sp.Kind == "Lair" or sp.Kind == "Ruins" then
		State:SetAttribute(sp.Kind .. "_" .. sp.Element, sp.Position)
	end
end
for _, site in ipairs(layout.SiteList) do
	State:SetAttribute("Site_" .. site.Element, Vector3.new(site.X, 0, site.Z))
end

-- ช่วงที่ 2: ระบบในแมพ
start({ "DropService", "ResourceService", "CampService", "BuildingService", "CombatService", "AnimalService", "SkillService", "SpiritService", "MountService", "LootService", "TraderService", "DirectorService", "PingService", "EventService", "SanctumService", "PortalService" })

-- โหมดลองเล่น: ของเต็มกระเป๋า
if ReplicatedStorage:FindFirstChild("ASSandbox") then
	local function stock(p)
		task.wait(3)
		for id, item in pairs(Items.Data) do
			ctx.Services.InventoryService:Add(p, id, item.Category == "Tool" and 1 or 50, true)
		end
	end
	Players.PlayerAdded:Connect(stock)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(stock, p)
	end
end

Remotes.Get("Ping").OnServerEvent:Connect(function(player, msg)
	print("[AS] ping from", player.Name, msg)
end)

State:SetAttribute("Ready", true)
print("[AS] READY")
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006D"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationService — ร้านค้า Robux
	  · เติม Ruby (Developer Product): Config.DiamondPacks — กันเติมซ้ำด้วยเลขใบเสร็จ (PurchaseId) ที่เก็บไว้ในเซฟ
	  · ซื้อเป็นของขวัญ: เลือกเพื่อนในเซิร์ฟก่อน (GiftTarget) -> ซื้อแพ็ก -> Ruby เข้าเพื่อน (ออกเกมไปแล้ว = ได้ตอนเข้าเกม)
	  · คืนชีพ: Config.ReviveProductId — ล้มอยู่ = ลุกทันที เลือดเต็ม · ไม่ได้ล้ม (เพื่อนช่วยไปก่อน) = เก็บเป็นตั๋วคืนชีพ
	  · Game Pass: Config.GamePasses — Season Pass, Save Run (เซฟรอบ: RejoinService:SaveRunFor)
	  · ID ที่ยังเป็น 0 = ยังไม่ได้สร้างใน Creator Hub → ข้ามไป (ปุ่มในร้านขึ้นว่า "เร็วๆ นี้")
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Classes = require(ReplicatedStorage.Shared.Classes)

local MonetizationService = {}
local owned = {} -- [player] = { [passKey] = true }
local giftTo = {} -- [ผู้ซื้อ] = { UserId, Name, At } เพื่อนที่จะได้ Ruby จากการซื้อครั้งถัดไป
local GIFT_WINDOW = 300 -- เลือกเพื่อนแล้วต้องซื้อภายในกี่วินาที

local packByProduct = {}
for _, pack in ipairs(Config.DiamondPacks) do
	if (pack.ProductId or 0) > 0 then
		packByProduct[pack.ProductId] = pack
	end
end
local passById, passByKey = {}, {}
for _, pass in ipairs(Config.GamePasses) do
	passByKey[pass.Id] = pass
	if (pass.PassId or 0) > 0 then
		passById[pass.PassId] = pass
	end
end

-- ของเริ่มต้นจาก Game Pass (ให้ทุกครั้งที่ลงแมพ)
local RUN_ITEMS = {
	GiantSack = { GiantSack = 1 },
	Medic = { Bandage = 3, Medkit = 1 },
	Torch = { Torch = 1, Coal = 5 },
}

function MonetizationService:Init(ctx)
	self.ctx = ctx
end

function MonetizationService:HasPass(player, key)
	return owned[player] ~= nil and owned[player][key] == true
end

-- (เดิม: เสนอขาย/เลือกบันทึก Save Run หลังทีมตายหมด) -> เลิกใช้แล้ว: พาสนี้กลายเป็น World Pass (WorldService)
function MonetizationService:OfferSaveRun()
end

local function setOwned(player, key)
	owned[player] = owned[player] or {}
	owned[player][key] = true
	player:SetAttribute("Pass_" .. key, true)
	-- คลาสพาส (Classes.Data[id].Pass == key): ใส่ในคลาสที่มีของเซฟ -> ร้าน/เลือกคลาส/ภารกิจ ใช้ได้ตามปกติ
	task.spawn(function()
		local ds = MonetizationService.ctx and MonetizationService.ctx.Services.DataService
		local data
		for _ = 1, 60 do
			data = ds and ds:Get(player)
			if data or not player.Parent then
				break
			end
			task.wait(0.5)
		end
		if not (data and data.Owned) then
			return
		end
		local changed = false
		for id, c in pairs(Classes.Data) do
			if c.Pass == key and not data.Owned[id] then
				data.Owned[id] = true
				changed = true
			end
		end
		if changed then
			MonetizationService.ctx.Remotes.Get("Profile"):FireClient(player, data)
			task.spawn(ds.Save, ds, player)
		end
	end)
end

-- ให้สิทธิ์พาส (DEV/เทส) — ปกติมาจาก LoadPasses / PromptGamePassPurchaseFinished
function MonetizationService:GrantPass(player, key)
	setOwned(player, key)
end

function MonetizationService:LoadPasses(player)
	owned[player] = owned[player] or {}
	for _, pass in ipairs(Config.GamePasses) do
		if (pass.PassId or 0) > 0 then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.PassId)
			if ok and has then
				setOwned(player, pass.Id)
			end
		end
	end
end

-- เรียกตอนลงแมพ (LobbyService:Depart)
function MonetizationService:GiveRunPerks(player)
	local inv = self.ctx.Services.InventoryService
	for key, items in pairs(RUN_ITEMS) do
		if self:HasPass(player, key) then
			for id, n in pairs(items) do
				inv:Add(player, id, n, true)
			end
			self.ctx.Notify(player, "🎫 Game Pass items: " .. passByKey[key].Name, "Reward")
		end
	end
end

local function remember(data, purchaseId)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > 100 do
		table.remove(data.Receipts, 1)
	end
end

-- คืนชีพ: ล้มอยู่ = ลุกเลือดเต็ม · ไม่ได้ล้ม = ตั๋วคืนชีพ 1 ใบ (ใช้ตอนล้มครั้งหน้า)
local function reviveReceipt(self, receipt, player, data)
	local ds = self.ctx.Services.DataService
	local surv = self.ctx.Services.SurvivalService
	-- ชุบ: ตัวเองก่อน (ล้ม/ตายในรอบ) · โหมดชุบทั้งทีม = ตัวเองยืนอยู่แล้วก็ชุบเพื่อนที่ล้ม/ตายคนถัดไป
	local target = surv:IsFallen(player) and player or nil
	if not target and player:GetAttribute("ReviveAll") then
		for _, p in ipairs(Players:GetPlayers()) do
			if surv:IsFallen(p) then
				target = p
				break
			end
		end
	end
	if target then
		surv:ReviveAny(target)
		if target == player then
			self.ctx.Notify(player, "Revived!", "Good")
		else
			self.ctx.Notify(target, player.DisplayName .. " revived you!", "Good")
			self.ctx.Notify(player, "Revived " .. target.DisplayName, "Good")
		end
	else
		data.ReviveTokens = (data.ReviveTokens or 0) + 1
		player:SetAttribute("ReviveTokens", data.ReviveTokens)
		self.ctx.Notify(player, "Got 1 Revive Ticket — use it next time you're down", "Reward")
	end
	remember(data, receipt.PurchaseId)
	if ds:StoreReady() then
		ds:Save(player)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ซื้อแพ็กเป็นของขวัญ: Ruby เข้าเพื่อน (อยู่เซิร์ฟนี้ = ทันที · ไม่อยู่ = เก็บไว้ให้ตอนเข้าเกม)
local function giftReceipt(self, receipt, player, data, pack, gift)
	local ds = self.ctx.Services.DataService
	local total = pack.Diamonds + (pack.Bonus or 0)
	local friend = Players:GetPlayerByUserId(gift.UserId)
	local fdata = friend and ds:Get(friend)
	if fdata then
		ds:AddDiamonds(friend, total, "Gift from " .. player.DisplayName, { Purchased = true })
		if ds:StoreReady() and not ds:Save(friend) then
			fdata.Diamonds -= total
			friend:SetAttribute("Diamonds", fdata.Diamonds)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		self.ctx.Remotes.Get("Cinematic"):FireClient(friend, "Purchased", { Kind = "Gift", Name = player.DisplayName, Diamonds = total })
	else
		local ok = ds:QueueGift(gift.UserId, total, player.DisplayName)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	giftTo[player] = nil
	player:SetAttribute("GiftTo", nil)
	remember(data, receipt.PurchaseId)
	if ds:StoreReady() then
		ds:Save(player)
	end
	self.ctx.Notify(player, string.format("Sent %d Ruby to %s!", total, gift.Name), "Reward")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- สร้างโลก (จ่ายต่อ 1 โลก): ได้ "สิทธิ์สร้างโลก" 1 ครั้ง -> WorldService สร้างโลกให้ทันที (เมนู Worlds ส่งค่าที่ตั้งไว้รอ)
local function worldReceipt(self, receipt, player, data)
	local ds = self.ctx.Services.DataService
	data.WorldCredits = (data.WorldCredits or 0) + 1
	remember(data, receipt.PurchaseId)
	if ds:StoreReady() and not ds:Save(player) then
		data.WorldCredits -= 1
		table.remove(data.Receipts, #data.Receipts)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	player:SetAttribute("WorldCredits", data.WorldCredits)
	task.spawn(self.ctx.Services.WorldService.OnCredit, self.ctx.Services.WorldService, player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ชุบทั้งทีม (จ่ายทีเดียว): ชุบทุกคนที่ล้ม/ตายในรอบ · ไม่มีใครล้มแล้ว (ชุบกันเองทัน) = ได้ตั๋วคืนชีพตามจำนวนแทน
local function reviveAllReceipt(self, receipt, player, data)
	local ds = self.ctx.Services.DataService
	local surv = self.ctx.Services.SurvivalService
	local done = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if surv:IsFallen(p) then
			surv:ReviveAny(p)
			done += 1
			if p ~= player then
				self.ctx.Notify(p, player.DisplayName .. " revived the whole team!", "Good")
			end
		end
	end
	if done == 0 then
		-- ไม่มีใครล้มแล้ว (ชุบกันเองทันก่อนจ่ายเสร็จ) -> เก็บเป็นตั๋วคืนชีพ 1 ใบ
		data.ReviveTokens = (data.ReviveTokens or 0) + 1
		player:SetAttribute("ReviveTokens", data.ReviveTokens)
		self.ctx.Notify(player, "Everyone is already up — got 1 Revive Ticket instead", "Reward")
	else
		self.ctx.Notify(player, string.format("Revived the whole team (%d)!", done), "Good")
	end
	remember(data, receipt.PurchaseId)
	if ds:StoreReady() then
		ds:Save(player)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function processReceipt(self, receipt)
	local reviveAllN = (Config.ReviveAllProductId or 0) > 0 and receipt.ProductId == Config.ReviveAllProductId
	local isRevive = (Config.ReviveProductId or 0) > 0 and receipt.ProductId == Config.ReviveProductId
	local isWorld = (Config.WorldProductId or 0) > 0 and receipt.ProductId == Config.WorldProductId
	local pack = packByProduct[receipt.ProductId]
	if not (pack or isRevive or isWorld or reviveAllN) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local ds = self.ctx.Services.DataService
	local data = player and ds:Get(player)
	if not data then
		-- ยังโหลดเซฟไม่เสร็จ/ออกเกมไปแล้ว: Roblox จะส่งใบเสร็จนี้มาใหม่ตอนเข้าเกมครั้งหน้า
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	data.Receipts = data.Receipts or {}
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if isRevive then
		return reviveReceipt(self, receipt, player, data)
	end
	if isWorld then
		return worldReceipt(self, receipt, player, data)
	end
	if reviveAllN then
		return reviveAllReceipt(self, receipt, player, data)
	end
	local gift = giftTo[player]
	if gift and os.clock() - gift.At < GIFT_WINDOW then
		return giftReceipt(self, receipt, player, data, pack, gift)
	end
	local total = pack.Diamonds + (pack.Bonus or 0)
	ds:AddDiamonds(player, total, "Top-up: " .. pack.Name, { Purchased = true })
	remember(data, receipt.PurchaseId)
	if ds:StoreReady() and not ds:Save(player) then
		-- เซฟไม่ผ่าน: คืนค่าแล้วให้ Roblox ส่งใบเสร็จมาใหม่ (กัน Ruby หาย/ได้ซ้ำ)
		data.Diamonds -= total
		table.remove(data.Receipts, #data.Receipts)
		player:SetAttribute("Diamonds", data.Diamonds)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	self.ctx.Remotes.Get("Cinematic"):FireClient(player, "Purchased", { Kind = "Pack", Name = pack.Name, Diamonds = total })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService:Start(ctx)
	MarketplaceService.ProcessReceipt = function(receipt)
		local ok, res = pcall(processReceipt, self, receipt)
		if ok then
			return res
		end
		warn("[AS] ProcessReceipt", res)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = passById[passId]
		if purchased and pass then
			setOwned(player, pass.Id)
			ctx.Notify(player, "🎫 Game Pass received: " .. pass.Name .. " — thanks for your support!", "Reward")
			ctx.Remotes.Get("Cinematic"):FireClient(player, "Purchased", { Kind = "Pass", Name = pass.Name })
			ctx.Services.LobbyService:RefreshTag(player)
		end
	end)
	-- เลือกเพื่อนที่จะซื้อ Ruby ให้ (ต้องอยู่เซิร์ฟเดียวกัน · nil = ยกเลิก ซื้อให้ตัวเอง)
	ctx.Remotes.Get("GiftTarget").OnServerEvent:Connect(function(player, userId)
		local friend = type(userId) == "number" and Players:GetPlayerByUserId(userId)
		if friend and friend ~= player then
			giftTo[player] = { UserId = friend.UserId, Name = friend.DisplayName, At = os.clock() }
			player:SetAttribute("GiftTo", friend.DisplayName)
		else
			giftTo[player] = nil
			player:SetAttribute("GiftTo", nil)
		end
	end)
	-- ทีมล้มหมด: โหมด "ชุบทั้งทีม" (ซื้อคืนชีพแต่ละครั้ง = ชุบคนที่ล้ม/ตายคนถัดไป)
	ctx.Remotes.Get("ReviveAllMode").OnServerEvent:Connect(function(player, on)
		player:SetAttribute("ReviveAll", on == true or nil)
	end)
	-- ใช้ตั๋วคืนชีพตอนล้ม
	ctx.Remotes.Get("UseReviveToken").OnServerEvent:Connect(function(player)
		local ds, surv = ctx.Services.DataService, ctx.Services.SurvivalService
		local data = ds:Get(player)
		if not (data and (data.ReviveTokens or 0) > 0 and surv:IsDowned(player)) then
			return
		end
		data.ReviveTokens -= 1
		player:SetAttribute("ReviveTokens", data.ReviveTokens)
		surv:Revive(player, 1)
		ctx.Notify(player, "Revived!", "Good")
		task.spawn(ds.Save, ds, player)
	end)
	ctx.Remotes.Get("GetShopInfo").OnServerInvoke = function(player)
		local passes = {}
		for key in pairs(owned[player] or {}) do
			passes[key] = true
		end
		return { Passes = passes }
	end
	local function onPlayer(player)
		self:LoadPasses(player)
		ctx.Services.LobbyService:RefreshTag(player)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		owned[p] = nil
		giftTo[p] = nil
	end)
end

return MonetizationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006E"><Properties><string name="Name">MountService</string><ProtectedString name="Source"><![CDATA[--[[
	MountService — ขี่ลูกสัตว์ธาตุที่ช่วยแล้ว (ตัวที่เดินเล่นอยู่ในแคมป์ SpiritService:SpawnPet)
	  กด E ที่ตัวสัตว์ = ขึ้นขี่: เชื่อมตัวสัตว์ไว้ใต้ผู้เล่น (Weld) -> ผู้เล่นบังคับเดินเองทั้งคู่ (ตัวละครผู้เล่น = ลื่น ไม่หน่วงเน็ต)
	    ยกผู้เล่นขึ้นนั่งบนหลัง (HipHeight) · client เล่นท่านั่ง + วิ่งเร็วขึ้น (attribute Riding / MountSpeed -> MountClient, CombatClient)
	  ลง = ปุ่ม/คีย์ (remote Dismount) · ตาย/ล้ม/ออกเกม/ตัวสัตว์หาย = ลงเอง
	  ลงตรงไหน -> สัตว์รอตรงนั้น (AnimalService:ThinkPet)
]]

local Players = game:GetService("Players")

local MountService = {}
MountService.SpeedMult = 1.6
local SINK = 0.25 -- ก้นจมขนหลังสัตว์นิดหน่อย (ไม่ลอยเหนือหลัง)

function MountService:Init(ctx)
	self.ctx = ctx
	self.rides = {} -- [player] = { Pet, Weld, Hip, Saved }
end

function MountService:AddPet(a)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Ride"
	prompt.ActionText = "Ride"
	prompt.ObjectText = a.Info.Thai
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = a.Root
	prompt.Triggered:Connect(function(player)
		self:Mount(player, a)
	end)
	a.RidePrompt = prompt
	a.Model.Destroying:Connect(function()
		if a.Rider then
			self:Dismount(a.Rider, true)
		end
	end)
end

function MountService:Mount(player, a)
	if a.Rider or a.Removed or self.rides[player] or player:GetAttribute("Downed") or player:GetAttribute("Dead") then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum and hum.Health > 0) or hum.SeatPart then
		return
	end
	local model = a.Model
	local bcf, size = model:GetBoundingBox()
	local rootUp = a.Root.Position.Y - (bcf.Position.Y - size.Y / 2) -- root สูงจากเท้าสัตว์เท่าไร
	-- ความสูงหลังสัตว์ (ที่นั่ง) · โมเดลเมชเดียว (ผิว+กระดูก) ตั้ง Skin.Back = สัดส่วนความสูงตัว (หูยาว/หัวโต ไม่ใช่หลัง)
	local skinSpec = a.Info.Model and a.Info.Model.Skin
	local back = size.Y * (skinSpec and skinSpec.Back or 0.72)
	local body = model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		-- นั่งบนหลังจริง (ไม่ใช่ยอดปีก/เขา): ขอบบนของลำตัว
		back = math.clamp(body.Position.Y + body.Size.Y * 0.4 - (bcf.Position.Y - size.Y / 2), size.Y * 0.35, size.Y * 0.9)
	end
	local ride = { Pet = a, Hip = hum.HipHeight, Back = back, Saved = {} }
	a.Rider = player
	a.Hum:MoveTo(a.Root.Position)
	a.Hum.EvaluateStateMachine = false -- Humanoid ของสัตว์เลิกออกแรงเอง (ผู้เล่นพาไป)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			ride.Saved[d] = { d.CanCollide, d.Massless, d.CanQuery, d.Anchored }
			d.CanCollide, d.Massless, d.CanQuery, d.Anchored = false, true, false, false
		elseif d:IsA("AlignOrientation") or d:IsA("AlignPosition") then
			ride.Saved[d] = d.Enabled
			d.Enabled = false
		end
	end
	-- ยกผู้เล่นขึ้นหลังสัตว์ แล้วเชื่อมสัตว์ไว้ใต้ตัว (เท้าสัตว์แตะพื้นพอดี)
	--   ก้น (ใต้ LowerTorso/Torso) ต้องแตะหลังสัตว์พอดี: ระยะจากกลางตัว (HRP) ลงไปถึงก้น = seat
	--   (เดิมบวกความสูงหลังเพิ่มจากความสูงขาตอนยืน -> ลอยสูงกว่าหลังเท่าความยาวขา)
	local half = hrp.Size.Y / 2
	local legs = hum.RigType == Enum.HumanoidRigType.R6 and 2 or 0 -- R6: ขายาว 2 ไม่นับใน HipHeight
	local pelvis = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
	local seat = pelvis and (hrp.Position.Y - (pelvis.Position.Y - pelvis.Size.Y / 2)) or half
	local hrpAbove = back + seat - SINK -- กลางตัวผู้เล่นสูงจากพื้นเท่าไร
	local oldAbove = ride.Hip + half + legs
	hum.HipHeight = math.max(0, hrpAbove - half - legs)
	-- ผู้เล่นหันทางเดียวกับหัวสัตว์ (root ของสัตว์หันหน้า -Z = ทิศหัว) แล้วย้ายไปอยู่เหนือกลางหลัง
	local look = a.Root.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local seat = Vector3.new(bcf.Position.X, hrp.Position.Y + hrpAbove - oldAbove, bcf.Position.Z)
	local rel = hrp.CFrame:Inverse() * char:GetPivot()
	char:PivotTo(CFrame.lookAt(seat, seat + look) * rel)
	-- นั่งกลางหลัง: จุดกลางกล่องตัวสัตว์ (ไม่ใช่ root ที่มักอยู่ค่อนไปทางอก) อยู่ใต้ผู้เล่นพอดี · หันทางเดียวกับสัตว์
	local off = a.Root.CFrame:PointToObjectSpace(bcf.Position)
	local w = Instance.new("Weld")
	w.Name = "MountWeld"
	w.Part0 = hrp
	w.Part1 = a.Root
	w.C0 = CFrame.new(-off.X, -hrpAbove + rootUp, -off.Z)
	w.Parent = a.Root
	ride.Weld = w
	pcall(function()
		hrp:SetNetworkOwner(player)
	end)
	if a.RidePrompt then
		a.RidePrompt.Enabled = false
	end
	self.rides[player] = ride
	model:SetAttribute("Ridden", true)
	player:SetAttribute("MountSpeed", MountService.SpeedMult)
	player:SetAttribute("Riding", a.Info.Thai)
end

-- gone = ตัวสัตว์ถูกลบไปแล้ว (จบรอบ) -> แค่คืนสภาพผู้เล่น
function MountService:Dismount(player, gone)
	local ride = self.rides[player]
	if not ride then
		return
	end
	self.rides[player] = nil
	local a = ride.Pet
	player:SetAttribute("Riding", nil)
	player:SetAttribute("MountSpeed", nil)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if ride.Weld then
		ride.Weld:Destroy()
	end
	if hum and hum.Parent then
		hum.HipHeight = ride.Hip
	end
	if gone or a.Removed or not a.Model.Parent then
		a.Rider = nil
		return
	end
	-- ลงข้างๆ: สัตว์ขยับไปด้านขวาของผู้เล่น (ความสูงเท้าเท่าเดิม = อยู่บนพื้นแล้ว)
	if hrp and hrp.Parent then
		a.Model:PivotTo(a.Model:GetPivot() + hrp.CFrame.RightVector * (a.Radius + 3.5))
	end
	for inst, v in pairs(ride.Saved) do
		if inst.Parent then
			if inst:IsA("BasePart") then
				inst.CanCollide, inst.Massless, inst.CanQuery, inst.Anchored = v[1], v[2], v[3], v[4]
			else
				inst.Enabled = v
			end
		end
	end
	a.Hum.EvaluateStateMachine = true
	pcall(function()
		a.Root:SetNetworkOwner(nil)
	end)
	a.Model:SetAttribute("Ridden", nil)
	if a.RidePrompt then
		a.RidePrompt.Enabled = true
	end
	a.Rider = nil
	a.WanderAt = os.clock() + 2
	a.StayAt = a.Root.Position -- รอตรงที่ลง (AnimalService:ThinkPet)
end

function MountService:Start(ctx)
	ctx.Remotes.Get("Dismount").OnServerEvent:Connect(function(player)
		self:Dismount(player)
	end)
	local function hook(player)
		player.CharacterRemoving:Connect(function()
			self:Dismount(player)
		end)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 10)
			if hum then
				hum.Died:Connect(function()
					self:Dismount(player)
				end)
			end
		end)
		player:GetAttributeChangedSignal("Downed"):Connect(function()
			if player:GetAttribute("Downed") then
				self:Dismount(player)
			end
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
		if p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Died:Connect(function()
					self:Dismount(p)
				end)
			end
		end
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(p)
		self:Dismount(p)
	end)
end

return MountService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006F"><Properties><string name="Name">PingService</string><ProtectedString name="Source"><![CDATA[--[[
	PingService — ปิงบอกเพื่อนร่วมทีม (กด G / ปุ่มบนจอมือถือ)
	  client ส่งจุดที่เล็ง + ของที่เล็งโดน -> server ตรวจ (จำกัด 1 ครั้ง / 1.5 วิ) แล้วตัดสินชนิดปิงเอง:
	    Enemy (แดง)  = เล็งโดนสัตว์
	    Item  (เหลือง) = เล็งโดนของบนพื้น / หีบ
	    Go    (ฟ้า)   = "มาที่นี่"
	  ส่งต่อให้ทุกคนที่อยู่ในรอบเดียวกัน (รวมคนปิง)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local PingService = {}
PingService.Cooldown = 1.5
PingService.MaxDistance = 2500

function PingService:Init(ctx)
	self.ctx = ctx
	self.last = {}
end

-- ลูกโดยตรงของ folder ที่ inst อยู่ข้างใน (เช่น โมเดลสัตว์ใน Workspace.Animals)
local function topIn(folder, inst)
	if not (folder and inst:IsDescendantOf(folder)) then
		return nil
	end
	local m = inst
	while m.Parent and m.Parent ~= folder do
		m = m.Parent
	end
	return m
end

local function classify(target)
	if typeof(target) ~= "Instance" or not target:IsDescendantOf(Workspace) then
		return "Go", nil
	end
	local animal = topIn(Workspace:FindFirstChild("Animals"), target)
	if animal and animal:IsA("Model") then
		if animal:GetAttribute("Kind") == "Spirit" then
			return "Go", nil
		end
		return "Enemy", animal
	end
	local drop = topIn(Workspace:FindFirstChild("Drops"), target)
	if drop then
		return "Item", drop
	end
	local node = target
	while node and node ~= Workspace do
		if CollectionService:HasTag(node, "Chest") then
			return "Item", node
		end
		node = node.Parent
	end
	return "Go", nil
end

local function finite(v)
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e5 and math.abs(v.Y) < 1e5 and math.abs(v.Z) < 1e5
end

function PingService:Ping(player, position, target)
	if typeof(position) ~= "Vector3" or not finite(position) then
		return
	end
	if not player:GetAttribute("InRun") or player:GetAttribute("Dead") then
		return
	end
	local now = os.clock()
	if (self.last[player] or 0) > now - self.Cooldown then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - position).Magnitude > self.MaxDistance then
		return
	end
	self.last[player] = now
	local kind, model = classify(target)
	local data = { From = player.UserId, Name = player.DisplayName, Position = position, Kind = kind, Target = model }
	local remote = self.ctx.Remotes.Get("TeamPing")
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") then
			remote:FireClient(p, data)
		end
	end
end

function PingService:Start(ctx)
	ctx.Remotes.Get("TeamPing").OnServerEvent:Connect(function(player, position, target)
		self:Ping(player, position, target)
	end)
	Players.PlayerRemoving:Connect(function(p)
		self.last[p] = nil
	end)
end

return PingService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000070"><Properties><string name="Name">PortalService</string><ProtectedString name="Source"><![CDATA[--[[
	PortalService — ประตูมิติของศาลเจ้า/วิหาร (แท็ก "RealmPortal" จาก PropBuilder.BuildPortal)
	  กด E ที่ม่านประตู -> วาร์ปไป attribute Dest (หันหน้าไป DestLook)
	  วาร์ปแบบกันตกทะลุ: ตรึงตัว -> ย้าย -> โหลดพื้นรอบปลายทาง (StreamingEnabled) -> ปล่อย
]]

local CollectionService = game:GetService("CollectionService")

local PortalService = {}

PortalService.EnterBonus = 120 -- เข้าศาลเจ้า/วิหารแต่ละแห่งครั้งแรกของรอบ = เวลา +2 นาที

function PortalService:Init(ctx)
	self.ctx = ctx
	self.busy = {}
	self.bonusGiven = {} -- [RealmKey] = runId ที่ให้เวลาไปแล้ว
end

-- เข้าศาลเจ้า/วิหารครั้งแรกของรอบ: ทั้งทีมได้เวลาเพิ่ม (ไม่ใช่วันเพิ่ม)
function PortalService:GiveEnterBonus(player, veil)
	local key = veil:GetAttribute("RealmKey")
	local dir = self.ctx.Services.DirectorService
	if not key or not player:GetAttribute("InRun") or self.bonusGiven[key] == dir.runId then
		return
	end
	local how = dir:AddTime(self.EnterBonus)
	if not how then
		return
	end
	self.bonusGiven[key] = dir.runId
	local place = key:match("^Sanctum") and "a Sanctum" or "a Shrine"
	self.ctx.Broadcast(string.format("⏳ %s entered %s — +%d minutes %s", player.DisplayName, place, self.EnterBonus // 60,
		how == "now" and "added to the day" or "added to the next day"), "Good")
end

-- ความสูงกลางลำตัว (HumanoidRootPart) เหนือพื้นตอนยืน
local function standHeight(char, root)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		return hum.HipHeight + root.Size.Y / 2
	end
	return 3
end

-- ผิวพื้นที่ยืนได้ใต้จุด pos (ดิน + ของแข็งที่ชนได้ เช่น ฐานซุ้ม/หิน) ไม่นับตัวละคร
local function groundAt(pos)
	local skip = {}
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		if p.Character then
			table.insert(skip, p.Character)
		end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = skip
	rp.RespectCanCollide = true
	local hit = workspace:Raycast(pos + Vector3.new(0, 14, 0), Vector3.new(0, -70, 0), rp)
	return hit and hit.Position.Y
end

-- ฉากวาร์ป: ดูดเข้าม่าน (0.5 วิ ฝั่งผู้เล่นเล่นภาพ) -> ย้ายตัว -> พุ่งออกที่ปลายทาง
--   onGround: ปลายทางบนพื้นโลก (ประตูกลับ) -> วางเท้าบนผิวพื้นจริง ณ ตอนวาร์ป
--   (Dest ที่คำนวณตอนสร้างแมพอาจต่ำกว่าผิวดินบนทางลาด -> ตัวจมดินติด)
PortalService.SuckTime = 0.5
function PortalService:Teleport(player, dest, look, color, onGround)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or self.busy[player] then
		return
	end
	self.busy[player] = true
	local cin = self.ctx.Remotes.Get("Cinematic")
	cin:FireClient(player, "Warp", { Phase = "In", Color = color or Color3.fromRGB(200, 230, 255) })
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	local t0 = os.clock()
	pcall(function()
		player:RequestStreamAroundAsync(dest, 8)
	end)
	task.wait(math.max(0, PortalService.SuckTime - (os.clock() - t0)))
	if not root.Parent then
		self.busy[player] = nil
		return
	end
	local lift = standHeight(char, root) + 0.3
	local gy = onGround and groundAt(dest)
	if gy then
		dest = Vector3.new(dest.X, gy + lift, dest.Z)
	end
	char:PivotTo(CFrame.lookAt(dest, Vector3.new(look.X, dest.Y, look.Z)))
	cin:FireClient(player, "Warp", { Phase = "Out", Color = color or Color3.fromRGB(200, 230, 255) })
	task.delay(1.2, function()
		if not root.Parent then
			self.busy[player] = nil
			return
		end
		root.Anchored = false
		-- กันพลาดรอบสอง: ปล่อยตัวแล้วยังจมใต้ผิวพื้น -> ยกขึ้นมายืนบนพื้น
		task.wait(0.6)
		local now = onGround and root.Parent and groundAt(root.Position)
		if now and root.Position.Y < now + lift - 1.5 then
			root.AssemblyLinearVelocity = Vector3.zero
			char:PivotTo(root.CFrame + Vector3.new(0, now + lift - root.Position.Y, 0))
		end
		self.busy[player] = nil
	end)
end

local function hook(self, veil)
	local prompt = veil:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		return
	end
	prompt.Triggered:Connect(function(player)
		if veil:GetAttribute("Sealed") then
			self.ctx.Notify(player, "🔒 This place is sealed for the rest of this run", "Info")
			return
		end
		local dest, look = veil:GetAttribute("Dest"), veil:GetAttribute("DestLook")
		if typeof(dest) == "Vector3" then
			local lt = veil:FindFirstChildWhichIsA("Light")
			self:Teleport(player, dest, typeof(look) == "Vector3" and look or dest + Vector3.new(0, 0, -10), lt and lt.Color, veil:GetAttribute("DestGround"))
			self:GiveEnterBonus(player, veil)
		end
	end)
end

function PortalService:Start()
	for _, v in ipairs(CollectionService:GetTagged("RealmPortal")) do
		hook(self, v)
	end
	-- ศาลเจ้าถูกสร้างใหม่ตอนเริ่มรอบ (SpiritService.Reset) -> ประตูใหม่ต้องต่อด้วย
	CollectionService:GetInstanceAddedSignal("RealmPortal"):Connect(function(v)
		hook(self, v)
	end)
end

return PortalService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000071"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[--[[
	QuestService — ภารกิจรายวัน/รายสัปดาห์ · ล็อกอิน 7 วัน · ความสำเร็จ (รับ Ruby) · โค้ดแลกรางวัล · อันดับรายสัปดาห์
	  ระบบอื่นแจ้งความคืบหน้าด้วย ctx.Services.QuestService:Progress(player, kind, n, extra)
	    kind: "Kill" "Night"(extra = คืนที่รอด) "Fuel" "Gather"(extra = itemId) "Craft" "Revive" "Spirit" "Boss" "Run"
	    นับเฉพาะตอนอยู่ในแมพ (InRun) · ภารกิจ "FriendNight" นับเองตอนรอดผ่านคืนพร้อมเพื่อน Roblox (FriendService)
	  ข้อมูลในเซฟ (DataService): Quests, LoginStreak, BestStreak, AchClaimed, CodesUsed, WeekBest
	    + สถิติ Revives, FuelAdded, Crafts, Gathered, SpiritsSaved, QuestsDone, Runs
	  หม้อรางวัลประจำวันในล็อบบี้ = รับรางวัลล็อกอินของวันนั้น (DataService:ClaimDaily ส่งต่อมาที่ ClaimLogin) ไม่ได้ซ้ำ
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Classes = require(Shared.Classes)
local Quests = require(Shared.Quests)
local Codes = require(script.Parent:WaitForChild("Codes"))

local QuestService = {}

-- kind -> ช่องสถิติในเซฟที่ต้องบวกเพิ่ม (Kills / NightsTotal / BossKills ระบบเดิมนับให้อยู่แล้ว)
local STAT = { Revive = "Revives", Fuel = "FuelAdded", Craft = "Crafts", Spirit = "SpiritsSaved", Run = "Runs" }

local dirty = {} -- [player] = true -> ส่งโปรไฟล์ใหม่ให้ client เมื่อกลับล็อบบี้
local achSeen = {} -- [player] = { [achId] = true } แจ้งเตือน "ปลดล็อกความสำเร็จ" ครั้งเดียว
local saveQueued = {}
local codeCooldown = {}
local weekStores = {}

function QuestService:Init(ctx)
	self.ctx = ctx
end

local function ds(self)
	return self.ctx.Services.DataService
end

---------------------------------------------------------------- เตรียมข้อมูล (วันใหม่/สัปดาห์ใหม่ = สุ่มภารกิจชุดใหม่)
function QuestService:Ensure(player, data)
	local changed = false
	data.Quests = type(data.Quests) == "table" and data.Quests or {}
	local q = data.Quests
	local day, week = Quests.Day(), Quests.Week()
	if q.Day ~= day or type(q.Daily) ~= "table" then
		q.Day = day
		q.Daily = Quests.Roll("Daily", day, player.UserId, Quests.PerDay)
		changed = true
	end
	if q.Week ~= week or type(q.Weekly) ~= "table" then
		q.Week = week
		q.Weekly = Quests.Roll("Weekly", week, player.UserId, Quests.PerWeek)
		changed = true
	end
	for _, k in ipairs({ "AchClaimed", "CodesUsed", "WeekBest" }) do
		if type(data[k]) ~= "table" then
			data[k] = {}
		end
	end
	data.LoginStreak = tonumber(data.LoginStreak) or 0
	data.BestStreak = tonumber(data.BestStreak) or 0
	return changed
end

-- เรียกจาก DataService:Load ทันทีหลังโหลดเซฟ
function QuestService:OnLoad(player, data)
	self:Ensure(player, data)
	local seen = {}
	for _, a in ipairs(Quests.Achievements) do
		if Quests.StatOf(data, a.Stat) >= Quests.NeedOf(a, Classes.CollectCount) then
			seen[a.Id] = true
		end
	end
	achSeen[player] = seen
	local season = self.ctx.Services.SeasonService
	if season then
		season:OnLoad(player, data)
	end
end

function QuestService:MarkDirty(player)
	dirty[player] = true
end

-- เซฟแบบรวบ (กดรับหลายอันติดกัน = เขียน DataStore ครั้งเดียว)
function QuestService:SaveSoon(player)
	if saveQueued[player] then
		return
	end
	saveQueued[player] = true
	task.delay(6, function()
		saveQueued[player] = nil
		if player.Parent then
			ds(self):Save(player)
		end
	end)
end

function QuestService:Push(player)
	dirty[player] = nil
	ds(self):Push(player)
end

---------------------------------------------------------------- ความคืบหน้า
function QuestService:CheckAchievements(player, data)
	local seen = achSeen[player]
	if not seen then
		return
	end
	for _, a in ipairs(Quests.Achievements) do
		if not seen[a.Id] and Quests.StatOf(data, a.Stat) >= Quests.NeedOf(a, Classes.CollectCount) then
			seen[a.Id] = true
			if not data.AchClaimed[a.Id] then
				self.ctx.Notify(player, "🏅 Achievement unlocked: " .. a.Text .. " — claim ♦️ " .. a.Ruby .. " on the \"Badges\" page in the lobby", "Reward")
			end
		end
	end
end

local function bump(self, player, list, key, n)
	for _, e in ipairs(list or {}) do
		if e.Id == key and not e.Claimed and (e.Prog or 0) < e.Need then
			e.Prog = math.min(e.Need, (e.Prog or 0) + n)
			if e.Prog >= e.Need then
				local icon, text = Quests.Describe(e)
				self.ctx.Notify(player, string.format("📜 Quest complete! %s %s — go back to the lobby to claim your reward", icon, text), "Reward")
			end
		end
	end
end

function QuestService:Progress(player, kind, n, extra)
	n = tonumber(n) or 1
	if n <= 0 or not (player and player.Parent) or not player:GetAttribute("InRun") then
		return
	end
	local data = ds(self):Get(player)
	if not data then
		return
	end
	self:Ensure(player, data)
	local keys = { kind }
	if kind == "Gather" then
		data.Gathered = (tonumber(data.Gathered) or 0) + n
		keys = { extra }
	elseif STAT[kind] then
		data[STAT[kind]] = (tonumber(data[STAT[kind]]) or 0) + n
	end
	if kind == "Night" then
		self:OnNightSurvived(player, data, tonumber(extra) or 0)
		local friends = self.ctx.Services.FriendService
		if friends and friends:Bonus(player) then
			table.insert(keys, "FriendNight")
		end
	end
	for _, key in ipairs(keys) do
		if key then
			bump(self, player, data.Quests.Daily, key, n)
			bump(self, player, data.Quests.Weekly, key, n)
		end
	end
	local xp = Quests.XP[kind]
	local season = self.ctx.Services.SeasonService
	if xp and season then
		season:AddXP(player, xp * n)
	end
	self:CheckAchievements(player, data)
	dirty[player] = true
end

---------------------------------------------------------------- กดรับภารกิจ
function QuestService:ClaimQuest(player, scope, index)
	local data = ds(self):Get(player)
	if not data or (scope ~= "Daily" and scope ~= "Weekly") or type(index) ~= "number" then
		return
	end
	if self:Ensure(player, data) then
		self:Push(player)
		return
	end
	local e = data.Quests[scope] and data.Quests[scope][math.floor(index)]
	if not e or e.Claimed or (e.Prog or 0) < e.Need then
		return
	end
	e.Claimed = true
	data.QuestsDone = (tonumber(data.QuestsDone) or 0) + 1
	local _, text = Quests.Describe(e)
	ds(self):AddDiamonds(player, e.Ruby or 0, (scope == "Daily" and "Daily quest: " or "Weekly quest: ") .. text)
	local season = self.ctx.Services.SeasonService
	if season then
		season:AddXP(player, scope == "Daily" and Quests.DailyXP or Quests.WeeklyXP)
	end
	self:CheckAchievements(player, data)
	self:Push(player)
	self:SaveSoon(player)
end

---------------------------------------------------------------- ล็อกอิน 7 วัน (หม้อรางวัลประจำวัน)
function QuestService:ClaimLogin(player)
	local data = ds(self):Get(player)
	if not data then
		return
	end
	self:Ensure(player, data)
	local today = Quests.Day()
	if data.LastDaily == today then
		self.ctx.Notify(player, "Already claimed today — come back in " .. Quests.FormatTime(Quests.SecondsToDayReset()), "Info")
		return
	end
	local streak = 1
	if data.LastDaily == today - 1 then
		streak = (data.LoginStreak % #Quests.LoginRewards) + 1
	end
	data.LastDaily = today
	data.LoginStreak = streak
	data.BestStreak = math.max(data.BestStreak or 0, streak)
	local ruby = Quests.LoginRewards[streak] or Quests.LoginRewards[1]
	ds(self):AddDiamonds(player, ruby, string.format("Login day %d/%d", streak, #Quests.LoginRewards))
	if streak == #Quests.LoginRewards then
		self.ctx.Notify(player, "🎁 7 days in a row! Big reward claimed — a new streak starts tomorrow", "Reward")
	end
	local season = self.ctx.Services.SeasonService
	if season then
		season:AddXP(player, Quests.LoginXP)
	end
	self:CheckAchievements(player, data)
	self:Push(player)
	ds(self):Save(player)
end

---------------------------------------------------------------- ความสำเร็จ
function QuestService:ClaimAchievement(player, id)
	local data = ds(self):Get(player)
	local a = type(id) == "string" and Quests.AchievementById[id]
	if not (data and a) then
		return
	end
	self:Ensure(player, data)
	if data.AchClaimed[a.Id] then
		return
	end
	if Quests.StatOf(data, a.Stat) < Quests.NeedOf(a, Classes.CollectCount) then
		self.ctx.Notify(player, "You haven't completed this achievement yet", "Error")
		return
	end
	data.AchClaimed[a.Id] = true
	ds(self):AddDiamonds(player, a.Ruby, "Achievement: " .. a.Text)
	self:Push(player)
	self:SaveSoon(player)
end

---------------------------------------------------------------- โค้ด
local function normalize(code)
	if type(code) ~= "string" or #code > 40 then
		return nil
	end
	code = string.upper((code:gsub("%s+", "")))
	if code == "" then
		return nil
	end
	return code
end

function QuestService:Redeem(player, raw)
	local now = os.clock()
	if (codeCooldown[player] or 0) > now then
		return { Ok = false, Text = "Slow down, try again in a moment" }
	end
	codeCooldown[player] = now + 1.5
	local data = ds(self):Get(player)
	if not data then
		return { Ok = false, Text = "Data is still loading, try again" }
	end
	self:Ensure(player, data)
	local code = normalize(raw)
	local info = code and Codes[code]
	if not info then
		return { Ok = false, Text = "❌ Code not found — check the spelling" }
	end
	local t = os.time()
	if info.Starts and t < info.Starts then
		return { Ok = false, Text = "⏳ This code isn't active yet" }
	end
	if info.Expires and t >= info.Expires then
		return { Ok = false, Text = "⌛ This code has expired" }
	end
	if data.CodesUsed[code] then
		return { Ok = false, Text = "✔ Code already used (one use per player)" }
	end
	data.CodesUsed[code] = true
	local reward = { Ruby = info.Ruby, Title = info.Title, Color = info.Color }
	if (info.Ruby or 0) > 0 then
		ds(self):AddDiamonds(player, info.Ruby, "Code " .. code, { Flat = true })
	end
	local season = self.ctx.Services.SeasonService
	if season and (info.Title or info.Color) then
		season:GrantCosmetics(player, reward)
	end
	self:Push(player)
	ds(self):Save(player)
	return { Ok = true, Text = "🎉 Code redeemed! You got " .. Quests.RewardText(reward) }
end

---------------------------------------------------------------- อันดับรายสัปดาห์ (OrderedDataStore แยกต่อสัปดาห์)
local function weekStore(week)
	if weekStores[week] == nil then
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_W" .. week)
		end)
		weekStores[week] = ok and store or false
	end
	return weekStores[week] or nil
end

function QuestService:OnNightSurvived(player, data, night)
	if night <= 0 then
		return
	end
	local week = Quests.Week()
	local wb = data.WeekBest
	if wb.Week ~= week then
		wb.Week = week
		wb.Night = 0
	end
	if night <= (wb.Night or 0) then
		return
	end
	wb.Night = night
	if not (ds(self):StoreReady() and player.UserId > 0) then
		return
	end
	local store = weekStore(week)
	if not store then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			store:UpdateAsync(tostring(player.UserId), function(old)
				return math.max(tonumber(old) or 0, night)
			end)
		end)
		if not ok then
			warn("[AS] weekly board", err)
		end
	end)
end

-- อันดับสัปดาห์นี้: { { UserId, Value } ... } หรือ nil ถ้าอ่านไม่ได้ (Studio ยังไม่เปิด API Services)
function QuestService:GetTopWeekly(n)
	if not ds(self):StoreReady() then
		return nil
	end
	local store = weekStore(Quests.Week())
	if not store then
		return nil
	end
	local ok, res = pcall(function()
		local pages = store:GetSortedAsync(false, n, 1)
		local out = {}
		for _, e in ipairs(pages:GetCurrentPage()) do
			table.insert(out, { UserId = tonumber(e.key), Value = e.value })
		end
		return out
	end)
	return ok and res or nil
end

-- คืนที่ดีที่สุดสัปดาห์นี้ของคนในเซิร์ฟเวอร์ (ใช้ตอนอ่าน DataStore ไม่ได้)
function QuestService:WeekBestOf(player)
	local data = ds(self):Get(player)
	local wb = data and data.WeekBest
	if type(wb) == "table" and wb.Week == Quests.Week() then
		return wb.Night or 0
	end
	return 0
end

---------------------------------------------------------------- Start
function QuestService:Start(ctx)
	local R = ctx.Remotes
	R.Get("ClaimQuest").OnServerEvent:Connect(function(player, scope, index)
		self:ClaimQuest(player, scope, index)
	end)
	R.Get("ClaimAchievement").OnServerEvent:Connect(function(player, id)
		self:ClaimAchievement(player, id)
	end)
	R.Get("RedeemCode").OnServerInvoke = function(player, code)
		local ok, res = pcall(self.Redeem, self, player, code)
		if ok then
			return res
		end
		warn("[AS] redeem", res)
		return { Ok = false, Text = "Something went wrong, try again" }
	end
	local function onPlayer(player)
		player:GetAttributeChangedSignal("InRun"):Connect(function()
			if not player:GetAttribute("InRun") and dirty[player] then
				self:Push(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		dirty[p], achSeen[p], saveQueued[p], codeCooldown[p] = nil, nil, nil, nil
	end)
	-- วันใหม่/สัปดาห์ใหม่ระหว่างออนไลน์ + ส่งความคืบหน้าให้คนที่อยู่ล็อบบี้
	task.spawn(function()
		while true do
			task.wait(5)
			for _, p in ipairs(Players:GetPlayers()) do
				local data = ds(self):Get(p)
				if data then
					if self:Ensure(p, data) then
						dirty[p] = true
						ctx.Notify(p, "📜 New quests are here! Open the \"Quests\" menu in the lobby", "Info")
					end
					local season = ctx.Services.SeasonService
					if season and season:Ensure(p, data) then
						dirty[p] = true
					end
					if dirty[p] and not p:GetAttribute("InRun") then
						self:Push(p)
					end
				end
			end
		end
	end)
end

return QuestService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000072"><Properties><string name="Name">RejoinService</string><ProtectedString name="Source"><![CDATA[--[[
	RejoinService — หลุด/ออกเกมกลางรอบ กลับเข้ารอบเดิมได้ภายใน 1 ชั่วโมง
	  เซิร์ฟเวอร์ของรอบ (ปกติ = เซิร์ฟเวอร์ของทีม):
	    · คนในรอบออกเกม (ยังไม่ตาย / รอบยังไม่จบ) -> เก็บสถานะไว้ในเซิร์ฟเวอร์นี้ 1 ชม.
	      (ของในกระสอบ + เครื่องมือ, เครื่องมือที่ถือ, คลาส, เลือด, ความหิว, ล้มอยู่ไหม)
	    · บันทึกลง MemoryStore: u_<UserId> = { PlaceId, Code (รหัสเซิร์ฟเวอร์ส่วนตัว), ServerId, Expire }
	    · กลับมาถึง -> คืนสถานะเดิมแทนการเริ่มใหม่ · รอบจบ/เซิร์ฟเวอร์ปิด -> ล้างทั้งหมด
	  ล็อบบี้หลัก:
	    · เข้าเกมแล้วมีบันทึก -> ถาม "กลับเข้ารอบเดิม?" (บอกเวลาที่เหลือ) -> ตกลง = เทเลพอร์ตกลับเซิร์ฟเวอร์เดิม
	  รหัสเซิร์ฟเวอร์ส่วนตัว: ล็อบบี้เก็บไว้ตอนจอง (RegisterServer) เซิร์ฟเวอร์ของทีมอ่านด้วย PrivateServerId ของตัวเอง
	  Studio / ไม่มี MemoryStore: ไม่เทเลพอร์ต แต่ยังกลับเข้ารอบในเซิร์ฟเวอร์เดียวกันได้ (ไม่ error)
	  ทุกคนออกเกมหมด (เล่นคนเดียวแล้วหลุด ฯลฯ) -> เซิร์ฟเวอร์ปิดแน่ ๆ:
	    · ไม่นับว่าแพ้ เก็บทั้งรอบลง MemoryStore run_<PrivateServerId> (seed, คืนที่, กองไฟ/โต๊ะ/เชื้อเพลิง, คลังแคมป์,
	      สิ่งก่อสร้าง, สัตว์วิญญาณ/รังบอส, สถานะผู้เล่นแต่ละคน)
	    · กดกลับเข้ารอบ -> รหัสเดิมเปิดเซิร์ฟเวอร์ใหม่ (PrivateServerId เดิม) -> Main อ่าน seed เดิม (แมพเดียวกัน)
	      -> คนแรกมาถึงคืนรอบ (เริ่มกลางวันของคืนที่ค้างไว้) แล้วคืนของให้แต่ละคน
]]

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Items = require(game:GetService("ReplicatedStorage").Shared.Items)

local RejoinService = {}
RejoinService.TTL = 3600
local SERVER_TTL = 86400
local MAP_NAME = "ASRejoin_v1"

function RejoinService:Init(ctx)
	self.ctx = ctx
	self.saved = {} -- [userId] = snapshot
	self.offers = {} -- [player] = { Local = bool, Record = table }
	self.lastAnswer = {}
	self.enabled = not RunService:IsStudio() and game.PlaceId ~= 0
	if self.enabled then
		local ok, map = pcall(function()
			return MemoryStoreService:GetSortedMap(MAP_NAME)
		end)
		self.map = ok and map or nil
	end
end

---------------------------------------------------------------- MemoryStore (ทุกคำสั่งห่อ pcall)
function RejoinService:MGet(key)
	if not self.map then
		return nil
	end
	local ok, v = pcall(function()
		return self.map:GetAsync(key)
	end)
	return ok and v or nil
end

function RejoinService:MSet(key, value, ttl)
	if not self.map then
		return false
	end
	local ok, err = pcall(function()
		self.map:SetAsync(key, value, ttl)
	end)
	if not ok then
		warn("[AS] rejoin memorystore set:", err)
	end
	return ok
end

function RejoinService:MRemove(key)
	if not self.map then
		return
	end
	pcall(function()
		self.map:RemoveAsync(key)
	end)
end

local function isTeamServerId()
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

-- Main เรียกก่อนสุ่ม seed: เซิร์ฟเวอร์ทีมที่เปิดใหม่จากรอบที่ทุกคนหลุดออกไป -> ข้อมูลรอบเดิม (nil = เริ่มใหม่)
function RejoinService.LoadHeldRun()
	if RunService:IsStudio() or game.PlaceId == 0 or not isTeamServerId() then
		return nil
	end
	for _ = 1, 3 do
		local ok, v = pcall(function()
			return MemoryStoreService:GetSortedMap(MAP_NAME):GetAsync("run_" .. game.PrivateServerId)
		end)
		if ok then
			if type(v) == "table" and type(v.Seed) == "number" and (v.Expire or 0) > os.time() then
				return v
			end
			return nil
		end
		task.wait(1)
	end
	return nil
end

local function isTeamServer(self)
	local lobby = self.ctx.Services.LobbyService
	return lobby ~= nil and lobby.IsTeamServer == true
end

-- ล็อบบี้: จองเซิร์ฟเวอร์ของทีมแล้ว เก็บรหัสไว้ให้เซิร์ฟเวอร์นั้นอ่าน (ใช้ส่งคนกลับเข้ามา)
function RejoinService:RegisterServer(privateServerId, code)
	if not (self.map and type(privateServerId) == "string" and privateServerId ~= "" and type(code) == "string") then
		return
	end
	task.spawn(function()
		self:MSet("ps_" .. privateServerId, code, SERVER_TTL)
	end)
end

-- เซิร์ฟเวอร์ของทีม: รหัสของตัวเอง (อ่านครั้งเดียวแล้วจำไว้)
function RejoinService:ServerCode()
	if self.code then
		return self.code
	end
	if not (self.map and game.PrivateServerId ~= "") then
		return nil
	end
	local v = self:MGet("ps_" .. game.PrivateServerId)
	if type(v) == "string" then
		self.code = v
	end
	return self.code
end

---------------------------------------------------------------- เก็บ / คืนสถานะ
local function runActive(self)
	local director = self.ctx.Services.DirectorService
	return director ~= nil and director:IsRunning() and self.ctx.State:GetAttribute("Phase") ~= "Ended"
end

function RejoinService:Snapshot(player)
	local inv = self.ctx.Services.InventoryService
	local bag = {}
	for id, n in pairs(inv:Get(player)) do
		if type(n) == "number" and n > 0 and Items.Data[id] then
			bag[id] = n
		end
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local tool = char and char:FindFirstChildOfClass("Tool")
	local auras = {}
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		if player:GetAttribute("Aura_" .. el) then
			table.insert(auras, el)
		end
	end
	return {
		Bag = bag,
		Auras = auras,
		Class = player:GetAttribute("Class"),
		Armor = player:GetAttribute("Armor"),
		Health = hum and hum.Health or nil,
		Hunger = player:GetAttribute("Hunger"),
		Downed = player:GetAttribute("Downed") == true,
		Equipped = tool and tool:GetAttribute("ItemId") or nil,
		Expire = os.time() + self.TTL,
	}
end

function RejoinService:OnRemoving(player)
	local uid = player.UserId
	pcall(self.SaveRunFor, self, player, true) -- เจ้าของโลกออกเกมกลางรอบ = เซฟโลกไว้เล่นต่อ
	-- ออกจากรอบตามปกติ (ตาย/รอบจบ/กลับล็อบบี้) ไม่ต้องเก็บ
	if not player:GetAttribute("InRun") or player:GetAttribute("Dead") or not runActive(self) then
		return
	end
	local ok, snap = pcall(self.Snapshot, self, player)
	if not ok or not snap then
		return
	end
	self.saved[uid] = snap
	-- ไม่เหลือใครในรอบแล้ว -> เซิร์ฟเวอร์จะปิด: เก็บทั้งรอบไว้ให้กลับมาเล่นต่อ
	local others = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p:GetAttribute("InRun") then
			others = true
		end
	end
	if not others then
		self:HoldRun()
	end
	if isTeamServer(self) and self.map then
		task.spawn(function()
			local code = self:ServerCode()
			if not code then
				return
			end
			self:MSet("u_" .. uid, { PlaceId = game.PlaceId, Code = code, ServerId = game.PrivateServerId, Expire = snap.Expire }, self.TTL)
			-- ระหว่างรอเขียน รอบอาจจบ/ถูกคืนสถานะไปแล้ว -> ลบทิ้ง
			if self.saved[uid] ~= snap then
				self:MRemove("u_" .. uid)
			end
		end)
	end
end

-- ทั้งรอบ -> ตาราง (MemoryStore เก็บได้ ≤ 32KB)
function RejoinService:SerializeRun()
	local S = self.ctx.Services
	local players = {}
	for uid, snap in pairs(self.saved) do
		players[tostring(uid)] = snap
	end
	return {
		Seed = self.ctx.Seed,
		Night = S.DirectorService.night,
		PendingSkips = S.DirectorService.pendingSkips,
		BonusDays = self.ctx.State:GetAttribute("BonusDays") or 0,
		Carry = S.DirectorService.carry,
		Conquered = self.ctx.State:GetAttribute("Conquered") == true,
		Camp = { S.CampService.level, S.CampService.bench, math.floor(S.CampService.fuel) },
		Stock = table.clone(S.InventoryService.Camp),
		Structures = S.BuildingService:Serialize(),
		Spirit = S.SpiritService:Serialize(),
		Sanctums = S.SanctumService:Serialize(),
		Trees = S.ResourceService:Serialize(), -- ต้นไม้ที่ตัดไปแล้ว (ยังไม่งอก)
		Players = players,
		Expire = os.time() + self.TTL,
	}
end

function RejoinService:WriteRun()
	if not self.held then
		return
	end
	local ok, run = pcall(self.SerializeRun, self)
	if not ok then
		warn("[AS] rejoin serialize:", run)
		return
	end
	self:MSet("run_" .. game.PrivateServerId, run, self.TTL)
end

-- Save Run (Game Pass): เก็บทั้งรอบ + ของของทุกคนที่ยังเล่นอยู่ ลงเซฟถาวรของคนนี้ (DataService:SaveRun)
--   เรียกตอนรุ่งเช้าทุกวัน และตอนคนนี้ออกเกมกลางรอบ · คืนค่า true = เซฟแล้ว
function RejoinService:SaveRunFor(player, leaving)
	-- เซฟเฉพาะในโลกที่สร้าง (WorldService) ลงช่องของเจ้าของโลก · โหมดแท่นธรรมดาไม่เซฟ
	local world = self.ctx.Services.WorldService
	if not (world and world:IsWorldOwner(player) and player:GetAttribute("InRun") and runActive(self)) then
		return false
	end
	local ok, run = pcall(self.SerializeRun, self)
	if not ok or type(run) ~= "table" then
		warn("[AS] save run serialize:", run)
		return false
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
			local ok2, snap = pcall(self.Snapshot, self, p)
			if ok2 and snap then
				snap.Downed = false
				run.Players[tostring(p.UserId)] = snap
			end
		end
	end
	run.SavedAt = os.time()
	local ds = self.ctx.Services.DataService
	local worldId = self.ctx.State:GetAttribute("WorldId")
	if leaving then
		task.spawn(ds.SaveWorld, ds, player, worldId, run)
		return true
	end
	return ds:SaveWorld(player, worldId, run)
end

-- คนสุดท้ายออกจากรอบ (ไม่ได้ตาย): เก็บรอบไว้ แทนการจบรอบ (เซิร์ฟเวอร์ทีมที่มี MemoryStore เท่านั้น)
function RejoinService:HoldRun()
	if self.held or not (isTeamServer(self) and self.map and runActive(self)) then
		return
	end
	self.held = true
	task.spawn(self.WriteRun, self)
end

-- ล้างทุกอย่าง (รอบจบ / เซิร์ฟเวอร์กำลังปิด)
function RejoinService:ClearAll()
	local ids = {}
	for uid in pairs(self.saved) do
		table.insert(ids, uid)
	end
	table.clear(self.saved)
	self.held = false
	if isTeamServer(self) and self.map then
		for _, uid in ipairs(ids) do
			task.spawn(self.MRemove, self, "u_" .. uid)
		end
		task.spawn(self.MRemove, self, "run_" .. game.PrivateServerId)
	end
end

-- คืนสถานะที่เก็บไว้ -> true ถ้าคืนได้
function RejoinService:TryRestore(player)
	local uid = player.UserId
	local snap = self.saved[uid]
	if not snap then
		return false
	end
	if snap.Expire < os.time() or not runActive(self) or player:GetAttribute("InRun") then
		self.saved[uid] = nil
		return false
	end
	self.saved[uid] = nil
	self.held = false
	if isTeamServer(self) then
		task.spawn(self.MRemove, self, "u_" .. uid)
	end
	local ctx = self.ctx
	local surv = ctx.Services.SurvivalService
	local inv = ctx.Services.InventoryService
	player:SetAttribute("InRun", true)
	player:SetAttribute("StartItemsGiven", true)
	-- คลาสเดิม (ถ้ายังเป็นเจ้าของ)
	local data = ctx.Services.DataService:Get(player)
	local cls = snap.Class
	if data and cls and data.Owned and data.Owned[cls] then
		data.Class = cls
		player:SetAttribute("Class", cls)
		player:SetAttribute("ClassLevel", (data.ClassLevel and data.ClassLevel[cls]) or 1)
	end
	surv:OnClassChosen(player, player:GetAttribute("Class") or "Survivor")
	if type(snap.Armor) == "string" and Items.Data[snap.Armor] then
		player:SetAttribute("Armor", snap.Armor) -- ใส่เกราะ/เลือดเพิ่มตอนเกิด (OnCharacter)
	end
	for _, el in ipairs(type(snap.Auras) == "table" and snap.Auras or {}) do
		player:SetAttribute("Aura_" .. el, true) -- ออร่าวิหาร: ใส่เอฟเฟกต์/เลือดเพิ่มตอนเกิด (OnCharacter)
	end
	for id, n in pairs(snap.Bag) do
		inv:Add(player, id, n, true)
	end
	ctx.Remotes.Get("Cinematic"):FireClient(player, "Depart", {})
	-- เกิดใหม่ที่แคมป์/เตียง แล้วใส่เลือด/ความหิว/ของในมือ/สถานะล้มกลับ (หลัง OnCharacter ตั้งค่าเริ่มต้นเสร็จ)
	local conn
	conn = player.CharacterAdded:Connect(function(char)
		conn:Disconnect()
		task.delay(2, function()
			if not (player.Parent and char.Parent) then
				return
			end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and type(snap.Health) == "number" and snap.Health == snap.Health then
				hum.Health = math.clamp(snap.Health, 1, hum.MaxHealth)
			end
			if type(snap.Hunger) == "number" then
				player:SetAttribute("Hunger", snap.Hunger)
			end
			if hum and snap.Equipped then
				local backpack = player:FindFirstChild("Backpack")
				for _, t in ipairs(backpack and backpack:GetChildren() or {}) do
					if t:IsA("Tool") and t:GetAttribute("ItemId") == snap.Equipped then
						hum:EquipTool(t)
						break
					end
				end
			end
			if snap.Downed then
				surv:Down(player, "Rejoin")
			end
		end)
	end)
	surv:Spawn(player)
	ctx.Notify(player, "↩ Rejoined your run — your sack items and tools are all still here", "Good")
	ctx.Broadcast(string.format("%s rejoined the run", player.DisplayName), "Info")
	return true
end

-- เซิร์ฟเวอร์ของทีม: คนมาถึง -> คืนสถานะเดิม (true) หรือให้ LobbyService ลงแมพตามปกติ (false)
-- เซิร์ฟเวอร์ใหม่ของรอบที่เก็บไว้: คืนโลก (ครั้งเดียว) แล้วเริ่มนับคืนต่อจากเดิม
function RejoinService:ApplyResume()
	local run = self.ctx.Resume
	if self.resumed or type(run) ~= "table" then
		return
	end
	self.resumed = true
	local S = self.ctx.Services
	local steps = {
		function()
			S.CampService:Restore(run.Camp and run.Camp[1], run.Camp and run.Camp[2], run.Camp and run.Camp[3])
		end,
		function()
			S.InventoryService:SetCamp(run.Stock)
			S.CampService:UpdateStockSign()
		end,
		function()
			S.BuildingService:Restore(run.Structures)
		end,
		function()
			S.SpiritService:Restore(run.Spirit)
		end,
		function()
			S.SanctumService:Restore(run.Sanctums)
		end,
		function()
			S.ResourceService:Restore(run.Trees)
		end,
	}
	for _, fn in ipairs(steps) do
		local ok, err = pcall(fn)
		if not ok then
			warn("[AS] resume:", err)
		end
	end
	self.ctx.State:SetAttribute("Conquered", run.Conquered == true)
	self.ctx.State:SetAttribute("BonusDays", tonumber(run.BonusDays) or 0)
	S.DirectorService:StartRun(run.Night, run.PendingSkips, run.Carry)
	for uid, snap in pairs(type(run.Players) == "table" and run.Players or {}) do
		if type(snap) == "table" and type(snap.Bag) == "table" then
			snap.Expire = os.time() + self.TTL
			self.saved[tonumber(uid)] = snap
		end
	end
	task.spawn(self.MRemove, self, "run_" .. game.PrivateServerId)
	print(string.format("[AS] resumed held run: night %s, %d structures", tostring(run.Night), #(run.Structures or {})))
end

function RejoinService:OnTeamArrive(player)
	if self.ctx.Resume and not self.resumed then
		self:ApplyResume()
	end
	if self.saved[player.UserId] then
		-- รอโหลดเซฟ (คลาส) ให้เสร็จก่อนคืนสถานะ
		local t0 = os.clock()
		while player.Parent and not self.ctx.Services.DataService:Get(player) and os.clock() - t0 < 20 do
			task.wait(0.25)
		end
	end
	if self:TryRestore(player) then
		return true
	end
	local ok, join = pcall(function()
		return player:GetJoinData()
	end)
	local td = ok and type(join) == "table" and join.TeleportData
	if type(td) == "table" and td.Rejoin and not runActive(self) then
		-- ตั้งใจกลับเข้ารอบเดิม แต่ไม่มีสถานะแล้ว (รอบจบ/เซิร์ฟเวอร์เดิมปิดไปแล้ว) -> ล้างบันทึก แล้วส่งกลับล็อบบี้หลัก
		task.spawn(self.MRemove, self, "u_" .. player.UserId)
		local lobby = self.ctx.Services.LobbyService
		if lobby and lobby:ReturnToMainLobby({ player }, { Result = "RunGone" }) then
			return true
		end
		self.ctx.Notify(player, "Your previous run has ended — starting a new run instead", "Info")
	end
	return false
end

---------------------------------------------------------------- ล็อบบี้: ถาม "กลับเข้ารอบเดิม?"
function RejoinService:CheckOffer(player)
	if not player.Parent or player:GetAttribute("InRun") then
		return
	end
	local uid = player.UserId
	local now = os.time()
	local snap = self.saved[uid]
	if snap and snap.Expire > now and runActive(self) then
		-- รอบยังเล่นอยู่ในเซิร์ฟเวอร์นี้ (Studio / เล่นในเซิร์ฟเวอร์ล็อบบี้)
		self.offers[player] = { Local = true }
		self.ctx.Remotes.Get("RejoinOffer"):FireClient(player, { Left = snap.Expire - now, Local = true })
		return
	end
	if isTeamServer(self) or not self.map then
		return
	end
	local rec = self:MGet("u_" .. uid)
	if type(rec) ~= "table" or type(rec.Code) ~= "string" or type(rec.Expire) ~= "number" then
		return
	end
	if rec.Expire <= os.time() or (rec.PlaceId and rec.PlaceId ~= game.PlaceId) then
		self:MRemove("u_" .. uid)
		return
	end
	if not player.Parent or player:GetAttribute("InRun") then
		return
	end
	self.offers[player] = { Local = false, Record = rec }
	self.ctx.Remotes.Get("RejoinOffer"):FireClient(player, { Left = rec.Expire - os.time(), Local = false })
end

function RejoinService:Answer(player, accept)
	local offer = self.offers[player]
	if not offer then
		return
	end
	local now = os.clock()
	if (self.lastAnswer[player] or 0) > now - 2 then
		return
	end
	self.lastAnswer[player] = now
	local uid = player.UserId
	if accept ~= true then
		self.offers[player] = nil
		self.saved[uid] = nil
		if not offer.Local then
			task.spawn(self.MRemove, self, "u_" .. uid)
		end
		return
	end
	if player:GetAttribute("InRun") then
		self.offers[player] = nil
		return
	end
	if offer.Local then
		self.offers[player] = nil
		if not self:TryRestore(player) then
			self.ctx.Notify(player, "Your previous run has ended", "Error")
		end
		return
	end
	local rec = offer.Record
	if not (rec and rec.Expire > os.time()) then
		self.offers[player] = nil
		self.ctx.Notify(player, "Time to rejoin your previous run has expired", "Error")
		task.spawn(self.MRemove, self, "u_" .. uid)
		return
	end
	self.ctx.Services.DataService:Save(player)
	self.ctx.Remotes.Get("Cinematic"):FireClient(player, "Teleporting", {})
	local ok, err = pcall(function()
		local opts = Instance.new("TeleportOptions")
		opts.ReservedServerAccessCode = rec.Code
		opts:SetTeleportData({ Rejoin = true })
		TeleportService:TeleportAsync(game.PlaceId, { player }, opts)
	end)
	if not ok then
		warn("[AS] rejoin teleport failed:", err)
		self.ctx.Notify(player, "Couldn't rejoin your previous run, try again", "Error")
		-- ให้กดใหม่ได้
		self.ctx.Remotes.Get("RejoinOffer"):FireClient(player, { Left = rec.Expire - os.time(), Local = false })
	end
end

function RejoinService:Start(ctx)
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		if ctx.State:GetAttribute("Phase") ~= "Day" then
			return
		end
		-- โลกที่สร้าง: รุ่งเช้าทุกวัน เซฟโลกลงช่องของเจ้าของ
		for _, p in ipairs(Players:GetPlayers()) do
			task.spawn(function()
				if self:SaveRunFor(p) then
					ctx.Broadcast(string.format("🌍 World saved · Night %d", ctx.Services.DirectorService.night or 1), "Good")
				end
			end)
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		self.offers[p] = nil
		self.lastAnswer[p] = nil
		self:OnRemoving(p)
	end)
	ctx.Remotes.Get("RejoinAnswer").OnServerEvent:Connect(function(player, accept)
		self:Answer(player, accept)
	end)
	-- เทเลพอร์ตล้มเหลว (เซิร์ฟเวอร์เต็ม/ปิด ฯลฯ) -> แจ้งผู้เล่น
	pcall(function()
		TeleportService.TeleportInitFailed:Connect(function(player, _, msg)
			if self.offers[player] and not self.offers[player].Local then
				ctx.Notify(player, "Couldn't rejoin your previous run: " .. tostring(msg or ""), "Error")
				local rec = self.offers[player].Record
				if rec and rec.Expire > os.time() then
					ctx.Remotes.Get("RejoinOffer"):FireClient(player, { Left = rec.Expire - os.time(), Local = false })
				end
			end
		end)
	end)
	-- รอบจบ -> ไม่มีรอบให้กลับแล้ว
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = ctx.State:GetAttribute("Phase")
		if phase == "Ended" or phase == "Lobby" then
			self:ClearAll()
		end
	end)
	game:BindToClose(function()
		if self.held then
			self:WriteRun()
			return
		end
		if next(self.saved) then
			local ids = {}
			for uid in pairs(self.saved) do
				table.insert(ids, uid)
			end
			table.clear(self.saved)
			if isTeamServer(self) then
				for _, uid in ipairs(ids) do
					self:MRemove("u_" .. uid)
				end
			end
		end
	end)
	-- ล็อบบี้หลัก: คนเข้ามา -> เช็กว่ามีรอบค้างไหม
	local function onPlayer(player)
		local ok, join = pcall(function()
			return player:GetJoinData()
		end)
		local td = ok and type(join) == "table" and join.TeleportData
		local runGone = type(td) == "table" and td.Back and td.Result == "RunGone"
		task.delay(6, function()
			if not player.Parent then
				return
			end
			if runGone then
				ctx.Notify(player, "Your previous run has ended — start a new one at the start pad", "Info")
				return
			end
			if not isTeamServer(self) then
				self:CheckOffer(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	-- สถานะหมดอายุ
	task.spawn(function()
		while true do
			task.wait(60)
			local now = os.time()
			for uid, snap in pairs(self.saved) do
				if snap.Expire < now then
					self.saved[uid] = nil
				end
			end
		end
	end)
end

return RejoinService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000073"><Properties><string name="Name">ResourceService</string><ProtectedString name="Source"><![CDATA[--[[
	ResourceService — ของที่เก็บได้ในโลก (แท็ก ResourceNode จาก PropBuilder)
	ตี/ฟัน -> ได้ของตามดาเมจ -> หมดแล้ว (ต้นไม้ล้ม/หินแตก) -> งอกใหม่ภายหลัง
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)

local ResourceService = {}

function ResourceService:Init(ctx)
	self.ctx = ctx
	self.overlap = OverlapParams.new()
	self.overlap.FilterType = Enum.RaycastFilterType.Include
	self.felled = {} -- [ต้นไม้ที่ล้ม] = วันที่ล้ม (State.Night)
end

-- หา node ใกล้จุดนั้นที่สุด
-- รัศมีฐานของ node (ลำต้น/ตัวหิน) แนวนอน: ต้นไม้ใช้ Collider ลำต้น · อื่นๆ ใช้กรอบโมเดล
function ResourceService:Footprint(node)
	local col = node:FindFirstChild("Collider")
	if col and col:IsA("BasePart") then
		return math.max(col.Size.Y, col.Size.Z) / 2
	end
	if node:IsA("Model") then
		local _, size = node:GetBoundingBox()
		return math.clamp(math.min(size.X, size.Z) / 2, 0.5, 8)
	elseif node:IsA("BasePart") then
		return math.clamp(math.min(node.Size.X, node.Size.Z) / 2, 0.5, 8)
	end
	return 1.5
end

function ResourceService:FindNode(position, radius)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return nil
	end
	self.overlap.FilterDescendantsInstances = { world }
	local parts = Workspace:GetPartBoundsInRadius(position, radius, self.overlap)
	local best, bestD
	for _, p in ipairs(parts) do
		local node = p:FindFirstAncestorWhichIsA("Model")
		while node and not CollectionService:HasTag(node, "ResourceNode") do
			node = node.Parent and node.Parent:IsA("Model") and node.Parent or nil
		end
		if node and not node:GetAttribute("Depleted") then
			local d = (p.Position - position).Magnitude
			if not bestD or d < bestD then
				best, bestD = node, d
			end
		end
	end
	return best
end

local function setVisible(node, visible)
	for _, d in ipairs(node:GetDescendants()) do
		if d:IsA("BasePart") then
			if visible then
				d.Transparency = d:GetAttribute("OrigT") or 0
				d.CanCollide = d:GetAttribute("OrigC") ~= false
			else
				if d:GetAttribute("OrigT") == nil then
					d:SetAttribute("OrigT", d.Transparency)
					d:SetAttribute("OrigC", d.CanCollide)
				end
				d.Transparency = 1
				d.CanCollide = false
			end
			d.CanQuery = visible
		elseif d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Fire") then
			d.Enabled = visible
		end
	end
end

function ResourceService:Fell(node, from)
	node:SetAttribute("Depleted", true)
	local kind = node:GetAttribute("Node")
	-- แอนิเมชันล้ม/แตกเล่นฝั่งเครื่องผู้เล่น (BreakFX: โคลนโมเดลไปเล่นลื่นๆ ตามวัสดุ — ต้นไม้ล้มตามทิศที่ฟัน/หินแตกเป็นก้อน/คริสตัลแตกเป็นเศษ)
	-- เซิร์ฟเวอร์แค่ซ่อนของจริง (หน่วงนิดให้เครื่องผู้เล่นโคลนทันก่อน)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("NodeBreak", { Node = node, Kind = kind, Position = node:GetPivot().Position, From = from, Yield = node:GetAttribute("Yield") })
	task.delay(0.3, function()
		if node:GetAttribute("Depleted") then
			setVisible(node, false)
		end
	end)
	if kind == "Tree" then
		-- ต้นไม้: งอกใหม่ตามจำนวนวันในเกม (นับวันที่ข้ามด้วยเตียง/ศาลเจ้าด้วย) ไม่ใช่วินาที
		self.felled[node] = self.ctx.State:GetAttribute("Night") or 1
		return
	end
	local regrow = node:GetAttribute("Regrow") or 240
	task.delay(regrow, function()
		self:Regrow(node)
	end)
end

function ResourceService:Regrow(node)
	self.felled[node] = nil
	if node.Parent then
		node:SetAttribute("HP", node:GetAttribute("MaxHP"))
		node:SetAttribute("Depleted", false)
		setVisible(node, true)
	end
end

-- เก็บ/คืนต้นไม้ที่ล้มอยู่ (RejoinService ย้ายเซิร์ฟกลางรอบ): แมพสร้างจาก seed เดิม -> ต้นเดิมอยู่ตำแหน่งเดิม
--   เดิมไม่ได้เก็บ -> ย้ายเซิร์ฟแล้วต้นไม้ที่ตัดไปงอกคืนครบ (ปั๊มไม้ได้)
local function nodeKey(node)
	local p = node:GetPivot().Position
	return math.floor(p.X + 0.5) .. "," .. math.floor(p.Z + 0.5)
end

function ResourceService:Serialize()
	local out = {}
	for node, at in pairs(self.felled) do
		if node.Parent then
			table.insert(out, { nodeKey(node), at })
		end
	end
	return out
end

function ResourceService:Restore(list)
	if type(list) ~= "table" or #list == 0 then
		return 0
	end
	local want = {}
	for _, e in ipairs(list) do
		if type(e) == "table" and type(e[1]) == "string" then
			want[e[1]] = tonumber(e[2]) or 1
		end
	end
	local n = 0
	for _, node in ipairs(CollectionService:GetTagged("ResourceNode")) do
		if node:GetAttribute("Node") == "Tree" and not node:GetAttribute("Depleted") then
			local at = want[nodeKey(node)]
			if at then
				node:SetAttribute("Depleted", true)
				node:SetAttribute("HP", 0)
				setVisible(node, false)
				self.felled[node] = at
				n += 1
			end
		end
	end
	return n
end

-- วันเปลี่ยน: ต้นที่ล้มครบ Config.TreeRegrowDays คืน -> ทยอยงอกคืน (คืนละ TreeRegrowChance ต่อต้น ไม่ขึ้นพร้อมกันทั้งป่า)
-- เริ่มรอบใหม่ (วันนับถอยกลับ) งอกคืนทั้งหมด
function ResourceService:CheckTrees()
	local night = self.ctx.State:GetAttribute("Night") or 1
	for node, at in pairs(self.felled) do
		if not node.Parent then
			self.felled[node] = nil -- แมพใหม่ (รอบใหม่) ลบต้นเก่าไปแล้ว
		elseif night < at or (night >= at + Config.TreeRegrowDays and math.random() < Config.TreeRegrowChance) then
			self:Regrow(node)
		end
	end
end

-- ตี node: power = แรงของเครื่องมือ (Chop/Mine) · พุ่มเบอร์รี่ = ฟันไม่พัง ไม่ได้อะไร
function ResourceService:Hit(player, node, tool)
	local kind = node:GetAttribute("Node")
	local surv = self.ctx.Services.SurvivalService
	if kind == "Bush" then
		return false -- พุ่มเบอร์รี่: ฟันไม่ได้อะไร (กินที่พุ่มอย่างเดียว)
	end
	local power
	if kind == "Tree" then
		power = (tool.Chop or 0) * surv:Perk(player, "ChopMult", 1)
	else
		power = (tool.Mine or 0) * surv:Perk(player, "MineMult", 1)
	end
	if power <= 0 then
		self.ctx.Notify(player, kind == "Tree" and "You need an axe to chop wood" or "You need an axe/pickaxe to break this", "Error")
		return false
	end
	if kind == "Tree" or kind == "Rock" then
		power = math.max(power, 1) -- เครื่องมืออ่อนสุดก็ตีครบ 6/10 ครั้ง ไม่ลากยาวกว่านั้น · เครื่องมือแรงกว่า = เร็วกว่า
	end
	local hp = node:GetAttribute("HP") or 1
	local dealt = math.min(hp, power)
	hp -= dealt
	node:SetAttribute("HP", hp)
	local yield = node:GetAttribute("Yield")
	local per = node:GetAttribute("YieldPerHP") or 1
	-- เก็บเศษไว้ (ทศนิยม) ต่อ node ต่อคน
	local key = "Frac_" .. player.UserId
	local amount = dealt * per * Config.LootMult + (node:GetAttribute(key) or 0)
	local whole = hp <= 0 and math.floor(amount + 0.5) or math.floor(amount) -- ทุบจบ = ปัดเศษที่ค้าง
	node:SetAttribute(key, hp <= 0 and 0 or amount - whole)
	local drops = self.ctx.Services.DropService
	local nodePos = node:GetPivot().Position
	local toward = player.Character and player.Character:GetPivot().Position or nodePos
	-- ของต้องตกนอกตัว node ฝั่งที่ผู้เล่นยืน (ต้นใหญ่/หินก้อนโต เคยตกเข้าไปในลำต้น/ในหิน)
	local dir = (toward - nodePos) * Vector3.new(1, 0, 1)
	dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.xAxis
	local radius = self:Footprint(node)
	local dropPos = nodePos + dir * (radius + 2)
	local dropOpts = { Dir = dir, Avoid = node, Spread = 2 }
	if whole > 0 then
		drops:Spawn(yield, whole, dropPos, dropOpts)
	end
	local quests = self.ctx.Services.QuestService
	if quests and whole > 0 then
		quests:Progress(player, "Gather", whole, yield)
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("NodeHit", { Position = node:GetPivot().Position, Kind = kind, Node = node })
	if hp <= 0 then
		local bonus = node:GetAttribute("Bonus")
		if bonus then
			drops:SpawnLoot(bonus, 2, dropPos, dropOpts)
			if quests then
				quests:Progress(player, "Gather", 2, bonus)
			end
		end
		if kind == "Tree" and yield == "Wood" then
			drops:Spawn("Wood", 1, dropPos, dropOpts)
			if quests then
				quests:Progress(player, "Gather", 1, "Wood")
			end
		end
		local pos = player.Character and player.Character:GetPivot().Position or node:GetPivot().Position
		self:Fell(node, pos)
	end
	return true
end

---------------------------------------------------------------- พุ่มเบอร์รี่
-- พุ่มไม่มีวันพัง: พุ่มละ 6-7 ลูก (ลูกจริงในโมเดล ชื่อ "Berry") · ผู้เล่นชี้ลูกบนต้นแล้วคลิก/แตะ = เก็บลูกนั้น (client: BerryPicker ใน Main)
--   เก็บหมดพุ่มแล้ว -> รอ BERRY_COOLDOWN วัน (นับจาก State.Night) ถึงงอกคืนเต็มพุ่มทีเดียว
--   แท็ก "BerrySource" = ของที่ชี้เก็บลูกได้ (พุ่มในป่า + แปลงเบอร์รี่ใน BuildingService)
local BERRY_MIN, BERRY_MAX = 6, 7
local BERRY_COOLDOWN = 4 -- วัน
local PICK_RANGE = 18 -- ระยะเอื้อมเก็บลูก (เผื่อแลค)
local bushes = {} -- [node] = { Berries = {part}, Max, Count, EmptyNight }

-- ลูกเบอร์รี่ = ชิ้นเล็กในโมเดลพุ่ม (เล็กกว่า 30% ของใบพุ่ม) · โมเดลที่ไม่มีลูกแยก -> ปั้นลูกกลมวางรอบพุ่ม
local function berryParts(node)
	local parts, biggest = {}, 0
	for _, d in ipairs(node:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			biggest = math.max(biggest, d.Size.Magnitude)
		end
	end
	local out = {}
	for _, d in ipairs(parts) do
		if d.Size.Magnitude < biggest * 0.3 then
			table.insert(out, d)
		end
	end
	if #out >= 3 then
		return out
	end
	for _, d in ipairs(parts) do
		if d.Name == "Berries" then
			d.Transparency = 1
		end
	end
	local cf, size = node:GetBoundingBox()
	local rng = Random.new(math.floor(cf.X * 7 + cf.Z * 13))
	out = {}
	for i = 1, 6 do
		local ang = i / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local h = rng:NextNumber(-0.15, 0.3)
		local r = math.sqrt(math.max(0.05, 1 - (h * 2) ^ 2)) * 0.48
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		b.Size = Vector3.one * math.clamp(size.Y * 0.14, 0.5, 1.1)
		b.Color = Color3.fromRGB(214, 40, 90)
		b.Material = Enum.Material.SmoothPlastic
		b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch = true, false, false, false
		b.CFrame = CFrame.new(cf.Position + Vector3.new(math.cos(ang) * size.X * r, h * size.Y, math.sin(ang) * size.Z * r))
		b.Parent = node
		table.insert(out, b)
	end
	return out
end

local function setBerry(b, on)
	if b:GetAttribute("OrigT") == nil then
		b:SetAttribute("OrigT", b.Transparency)
	end
	b.Transparency = on and b:GetAttribute("OrigT") or 1
	b:SetAttribute("Picked", not on)
end
ResourceService.SetBerry = setBerry

local function refresh(st)
	local n = 0
	for _, b in ipairs(st.Berries) do
		if not b:GetAttribute("Picked") then
			n += 1
		end
	end
	st.Count = n
	st.Node:SetAttribute("Berries", n)
end

-- ให้เบอร์รี่ 1 ลูก: how = "Sack" (ใส่กระสอบ) / "Eat" (กินเลย) · กระสอบเต็ม = ลูกหล่นข้างตัว
function ResourceService:GiveBerry(player, from, how)
	local inv = self.ctx.Services.InventoryService
	if how == "Eat" then
		inv:Add(player, "Berries", 1, true)
		self.ctx.Services.SurvivalService:UseItem(player, "Berries")
	elseif inv:Space(player) >= 1 then
		inv:AddToSack(player, "Berries", 1)
	else
		local toward = player.Character and player.Character:GetPivot().Position or from
		local dir = (toward - from) * Vector3.new(1, 0, 1)
		dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.xAxis
		self.ctx.Services.DropService:Spawn("Berries", 1, from + dir * 3, { Dir = dir, Spread = 1 })
	end
	if self.ctx.Services.QuestService then
		self.ctx.Services.QuestService:Progress(player, "Gather", 1, "Berries")
	end
	-- ลูกลอยจากต้นเข้าตัวผู้เล่น (ClassFX/CombatClient: BerryPick)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("BerryPick", { From = from, Player = player, Eat = how == "Eat" })
end

-- เก็บลูกจากพุ่มในป่า: part = ลูกที่ชี้ (nil/ใช้ไม่ได้ = ลูกไหนก็ได้ที่เหลือ)
function ResourceService:PickBerry(player, node, how, part)
	local st = bushes[node]
	if not st or st.Count <= 0 then
		return false
	end
	if not (part and table.find(st.Berries, part) and not part:GetAttribute("Picked")) then
		part = nil
		for i = #st.Berries, 1, -1 do
			if not st.Berries[i]:GetAttribute("Picked") then
				part = st.Berries[i]
				break
			end
		end
	end
	if not part then
		return false
	end
	local from = part.Position
	setBerry(part, false)
	refresh(st)
	if st.Count <= 0 then
		st.EmptyNight = self.ctx.State:GetAttribute("Night") or 1 -- เริ่มนับคูลดาวน์ตอนพุ่มหมด
	end
	self:GiveBerry(player, from, how)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("NodeHit", { Position = node:GetPivot().Position, Kind = "Bush", Node = node })
	return true
end

function ResourceService:SetupBush(node)
	if node:GetAttribute("Node") ~= "Bush" or bushes[node] then
		return
	end
	local world = Workspace:FindFirstChild("World")
	if not (world and node:IsDescendantOf(world)) then
		return
	end
	local berries = berryParts(node)
	local cf = node:GetPivot()
	local max = math.min(#berries, Random.new(math.floor(cf.X * 7 + cf.Z * 13)):NextInteger(BERRY_MIN, BERRY_MAX))
	-- ลูกในโมเดลเกิน -> ซ่อนลูกส่วนเกินถาวร
	for i = #berries, max + 1, -1 do
		berries[i].Transparency = 1
		table.remove(berries, i)
	end
	for _, b in ipairs(berries) do
		b.Name = "Berry"
		setBerry(b, true)
	end
	local st = { Node = node, Berries = berries, Max = max, Count = max }
	bushes[node] = st
	node:SetAttribute("Depleted", false)
	node:SetAttribute("MaxBerries", max)
	refresh(st)
	CollectionService:AddTag(node, "BerrySource")
	node.Destroying:Connect(function()
		bushes[node] = nil
	end)
end

-- client ชี้ลูกแล้วกด: ตรวจระยะ/สถานะก่อนให้ของ
local lastPick = {}
function ResourceService:OnPickRequest(player, source, part, how)
	if typeof(source) ~= "Instance" or typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(source) then
		return
	end
	if not player:GetAttribute("InRun") or self.ctx.Services.SurvivalService:IsIncapacitated(player) then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - part.Position).Magnitude > PICK_RANGE then
		return
	end
	local now = os.clock()
	if (lastPick[player] or 0) > now - 0.12 then
		return
	end
	lastPick[player] = now
	how = how == "Eat" and "Eat" or "Sack"
	if bushes[source] then
		self:PickBerry(player, source, how, part)
	elseif source:FindFirstChild("Crops") then
		self.ctx.Services.BuildingService:PickCrop(player, source, part, how)
	end
end

function ResourceService:Start(ctx)
	self.ctx.State:GetAttributeChangedSignal("Night"):Connect(function()
		self:CheckTrees()
		-- พุ่มที่หมด: ครบ BERRY_COOLDOWN วัน -> งอกคืนเต็มพุ่ม · คืนนับย้อน (เริ่มรอบใหม่) = เต็มทันที
		local night = self.ctx.State:GetAttribute("Night") or 1
		for _, st in pairs(bushes) do
			if st.EmptyNight and (night - st.EmptyNight >= BERRY_COOLDOWN or night < st.EmptyNight) then
				st.EmptyNight = nil
				for _, b in ipairs(st.Berries) do
					setBerry(b, true)
				end
				refresh(st)
			end
		end
	end)
	CollectionService:GetInstanceAddedSignal("ResourceNode"):Connect(function(node)
		task.defer(self.SetupBush, self, node)
	end)
	for _, node in ipairs(CollectionService:GetTagged("ResourceNode")) do
		self:SetupBush(node)
	end
	ctx.Remotes.Get("PickBerry").OnServerEvent:Connect(function(player, source, part, how)
		self:OnPickRequest(player, source, part, how)
	end)
end

return ResourceService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000074"><Properties><string name="Name">SanctumService</string><ProtectedString name="Source"><![CDATA[--[[
	SanctumService — วิหารโบราณศักดิ์สิทธิ์ 4 ธาตุ (ธาตุละ 1 แห่ง · พรีแฟบจาก tools/world_art.py -> ServerStorage.WorldArt)
	  ตำแหน่ง: MapLayout.Sanctums (MapGenerator ปรับพื้นให้แล้ว) · client อ่าน GameState "Sanctum_<El>"
	  ปริศนา: เข้าใกล้ -> เสารูน 3 ต้นกะพริบบอกลำดับ -> ปลุกเสา (ProximityPrompt) ให้ถูกลำดับภายใน 30 วินาที
	         ผิด/หมดเวลา = เริ่มใหม่ · สำเร็จ = ประตูผนึกยุบลง + แสงพุ่ง -> หีบศักดิ์สิทธิ์ (ของหายาก) · รอบละครั้ง
	  เปิดหีบ = คนที่ช่วยกัน (ปลุกเสา/ตีผู้พิทักษ์/เปิดหีบ) ได้ออร่าธาตุติดตัวทั้งรอบ (SurvivalService:GiveAura)
	         แล้วประตูมิติข้างนอกปิดผนึก (veil attribute Sealed -> PortalService ไม่วาร์ป) เข้าวิหารนี้ไม่ได้อีกจนจบรอบ
	  กลับล็อบบี้ (Phase = Lobby) = รีเซ็ตทุกวิหาร
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Animals = require(ReplicatedStorage.Shared.Animals)
local PropBuilder = require(ReplicatedStorage.Shared.PropBuilder)
local SiteSpec = require(ReplicatedStorage.Shared.SiteSpec)
local GuardianWaves = require(script.Parent.GuardianWaves)

local SanctumService = {}

local ELEMENTS = { "Earth", "Water", "Air", "Fire" }
local THAI = { Earth = "Earth", Water = "Water", Air = "Frost", Fire = "Fire" }
local COLOR = {
	Earth = Color3.fromRGB(120, 245, 90), Water = Color3.fromRGB(70, 210, 255),
	Air = Color3.fromRGB(110, 190, 255), Fire = Color3.fromRGB(255, 110, 30),
}
local ESSENCE = { Earth = "TerraCore", Water = "TidePearl", Air = "GaleFeather", Fire = "EmberShard" }
local HEART = { Earth = "TerraHeart", Water = "TideHeart", Air = "FrostHeart", Fire = "EmberHeart" }
local AURA_TEXT = {
	Earth = "Earth Aura: Max HP +15%", Water = "Water Aura: Hunger 15% slower",
	Air = "Frost Aura: Stamina drains 15% slower", Fire = "Fire Aura: Damage +15%",
}
local TIME_LIMIT = 30
local SHOW_RANGE = 75 -- ผู้เล่นเข้าใกล้ลานเท่านี้ = เสากะพริบบอกลำดับ
local DIM = 0.22 -- ความสว่างตอนเสาหลับ (สัดส่วนของสีจริง)

local function dim(c, k)
	return Color3.new(c.R * k, c.G * k, c.B * k)
end

local function sound(parent, id, volume, speed, maxDist)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 1
	s.PlaybackSpeed = speed or 1
	s.RollOffMaxDistance = maxDist or 400
	s.RollOffMinDistance = 20
	s.Parent = parent
	s:Play()
	task.delay(8, function()
		s:Destroy()
	end)
end

local function light(part, color, range, brightness, enabled)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Enabled = enabled ~= false
	l.Parent = part
	return l
end

function SanctumService:Init(ctx)
	self.ctx = ctx
	self.sites = {}
	self.rng = Random.new()
end

---------------------------------------------------------------- สร้าง
function SanctumService:Build(el, sp, src, parent)
	local m = src:Clone()
	local origin = m:FindFirstChild("Origin")
	if not origin then
		m:Destroy()
		return
	end
	m.PrimaryPart = origin
	-- ระดับพื้น = ระดับที่ MapGenerator ปรับเรียบไว้ (ลานพิธีปรับดินซ้ำอีกรอบตอนสร้าง)
	local pos = sp.Position
	-- เกมนี้ไม่ใช้นีออน: ลายรูน/คริสตัล = หินแกะสีตามธาตุ (ไม่เรืองแสง)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			d.Material = Enum.Material.Slate
			local c = d.Color
			d.Color = Color3.new(c.R * 0.8, c.G * 0.8, c.B * 0.8)
		end
	end
	local camp = self.ctx.CampPosition or Vector3.zero
	local flat = Vector3.new(camp.X, pos.Y, camp.Z)
	-- หันทางเข้า (-Z ของพรีแฟบ) ไปทางแคมป์
	local cf = (flat - pos).Magnitude > 1 and CFrame.lookAt(pos, flat) or CFrame.new(pos)
	m:PivotTo(cf)
	-- ประตูมิติบนพื้น -> ห้องในปราสาทบนฟ้า: ปริศนาเสารูน + หีบ อยู่บนพื้นหินเรียบในห้อง (ไม่ลอย/ไม่จม)
	local temple = PropBuilder.BuildRealm(cf, el, m, THAI[el] .. " Sanctum", "Enter Sanctum", "Sanctum")
	local roomTop = temple:GetAttribute("FloorTop") or PropBuilder.RealmY + 0.5
	-- กรอบในห้อง: แนวเดียวกับประตูข้างนอก (-Z = ฝั่งที่คนเข้ามา)
	cf = CFrame.new(cf.Position.X, roomTop, cf.Position.Z) * (cf - cf.Position)
	if temple then
		-- ทิ้งฉากหินปั้นเดิมทั้งหมด เหลือเฉพาะชิ้นที่ใช้เล่น (เสารูน 3 ต้น, หีบ, ช่องรูน, คริสตัล, ลำแสง)
		local KEEP = {
			Origin = true, Obelisk1 = true, Obelisk2 = true, Obelisk3 = true, VaultChest = true, ChestLid = true,
			AltarCrystal = true, Beacon = true, VaultLight = true, HintSlot1 = true, HintSlot2 = true, HintSlot3 = true,
		}
		for _, ch in ipairs(m:GetChildren()) do
			if ch ~= temple and not KEEP[ch.Name] and ch.Name ~= "PortalOut" then
				ch:Destroy()
			end
		end
		m.Parent = parent
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { workspace.Terrain, temple }
		local function bottomOf(o)
			if o:IsA("Model") then
				local bcf, size = o:GetBoundingBox()
				return bcf.Position, bcf.Position.Y - size.Y / 2
			end
			return o.Position, o.Position.Y - o.Size.Y / 2
		end
		-- ย้ายกลุ่มชิ้นทั้งหมดตาม delta เดียวกัน แล้ววางลงบนพื้นจริง (ไม่ลอย)
		local function place(group, target)
			local p0, b0 = bottomOf(group[1])
			local flatTarget = target or p0
			local dy
			if target and target.Y then
				dy = target.Y - b0 -- จุดบนลานของวิหาร (รู้ความสูงพื้นแล้ว)
			else
				local hit = workspace:Raycast(Vector3.new(flatTarget.X, b0 + 60, flatTarget.Z), Vector3.new(0, -160, 0), rp)
				dy = hit and (hit.Position.Y - b0) or 0
			end
			local delta = Vector3.new(flatTarget.X - p0.X, dy, flatTarget.Z - p0.Z)
			for _, o in ipairs(group) do
				if o:IsA("Model") then
					o:PivotTo(o:GetPivot() + delta)
				else
					o.CFrame += delta
				end
			end
		end
		-- หีบศักดิ์สิทธิ์ตั้งหน้าประตูวิหาร (ลานปริศนาอยู่ฝั่งแคมป์)
		local chestGroup = {}
		for _, n in ipairs({ "VaultChest", "ChestLid", "VaultLight", "Beacon" }) do
			local o = m:FindFirstChild(n)
			if o then
				table.insert(chestGroup, o)
			end
		end
		-- เสารูนใหญ่ขึ้น (เห็นชัดบนวิหารใหญ่)
		for i = 1, 3 do
			local o = m:FindFirstChild("Obelisk" .. i)
			if o then
				pcall(function()
					o:ScaleTo(o:GetScale() * 1.6)
				end)
			end
		end
		-- ลานพิธีหินกลมบนพื้นหน้าวิหาร: เสารูน 3 ต้นเป็นสามเหลี่ยมฝั่งแคมป์ · หีบกลางลานฝั่งวิหาร · ช่องรูนหน้าหีบ · คริสตัลหลังหีบ
		--   (เดิมวางบนหลังคา/ชั้นบนของโมเดล Store + สร้างบันไดเอง -> ลอย/ขึ้นไม่ได้)
		local plazaTop = roomTop
		local function at(x, z)
			local w = (cf * CFrame.new(x, 0, z)).Position
			return Vector3.new(w.X, plazaTop, w.Z)
		end
		if #chestGroup > 0 then
			place(chestGroup, at(0, 12))
		end
		local OB = { { -17, -8 }, { 17, -8 }, { 0, -21 } }
		for i = 1, 3 do
			local o = m:FindFirstChild("Obelisk" .. i)
			if o then
				place({ o }, at(OB[i][1], OB[i][2]))
				-- ตัวเสา = หินรูนจาก Creator Store (RuneStoneLP) ตั้งบนแท่นฐาน (Activator) ของพรีแฟบ
				--   ชิ้นปั้นเดิมซ่อนไว้ (ยังใช้เป็นจุดกด/ป้ายลำดับ) · ตอนติดสว่าง = Highlight ทั้งก้อน (SetObelisk)
				local ocf, osz = o:GetBoundingBox()
				local bottom = ocf.Position.Y - osz.Y / 2
				local foot = Vector3.new(ocf.Position.X, plazaTop + 0.9, ocf.Position.Z)
				local vis = PropBuilder.Imported("RuneStoneLP", CFrame.lookAt(foot, Vector3.new(cf.Position.X, foot.Y, cf.Position.Z)), 8, o, true) -- กว้าง 8 = สูง ~10 (กล่องรอบเสาเดิมสูงผิดปกติ เคยได้หินยักษ์บังลาน)
				if vis then
					vis.Name = "StoneVisual"
					for _, d in ipairs(o:GetDescendants()) do
						if d:IsA("BasePart") and not d:IsDescendantOf(vis) and d.Name ~= "Activator" then
							d.Transparency = 1
							d.CanCollide = false
						end
					end
				end
			end
		end
		for i, n in ipairs({ "AltarCrystal", "HintSlot1", "HintSlot2", "HintSlot3" }) do
			local o = m:FindFirstChild(n)
			if o then
				place({ o }, i == 1 and at(0, 22) or at((i - 3) * 6, 3))
			end
		end
		pos = Vector3.new(cf.Position.X, plazaTop, cf.Position.Z) -- จุดศูนย์กลางกิจกรรม = กลางลานพิธี
	end
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	m:SetAttribute("Element", el)
	local col = COLOR[el]
	local site = {
		Element = el, Model = m, Center = pos, State = "Idle", Progress = 0, NextShow = 0,
		Obelisks = {}, Hints = {}, Door = {}, Lid = {}, Helpers = {},
	}
	-- ไฟ/อนุภาคประกอบฉาก
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Brazier" then
				local f = Instance.new("Fire")
				f.Size = 4
				f.Heat = 6
				f.Color = el == "Fire" and Color3.fromRGB(255, 140, 40) or col
				f.SecondaryColor = dim(col, 0.6)
				f.Parent = d
				light(d, col, 24, 1.6)
			elseif d.Name == "CaveGlow" then
				light(d, col, 32, 2.2)
			elseif d.Name == "AltarCrystal" then
				light(d, col, 26, 1.8)
				site.AltarCrystal = d
			elseif d.Name == "Mist" then
				local mist = Instance.new("ParticleEmitter")
				mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
				mist.Rate = 3
				mist.Lifetime = NumberRange.new(5, 8)
				mist.Speed = NumberRange.new(0.6, 1.4)
				mist.SpreadAngle = Vector2.new(180, 10)
				mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 16) })
				mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0.82), NumberSequenceKeypoint.new(1, 1) })
				mist.Color = ColorSequence.new(col)
				mist.LightEmission = 0.3
				mist.Parent = d
			elseif d.Name == "VaultLight" then
				site.VaultLight = light(d, col, 34, 4, false)
			elseif d.Name == "Beacon" then
				site.Beacon = d
			elseif d.Name:match("^HintSlot%d$") then
				local i = tonumber(d.Name:sub(-1))
				site.Hints[i] = { Part = d, Color = col }
			end
		end
	end
	-- เสารูน
	for i = 1, 3 do
		local ob = m:FindFirstChild("Obelisk" .. i)
		if ob then
			-- ขอบเรืองสีธาตุ + ลำแสงขึ้นฟ้า: มองเห็นเสาได้จากไกล/ในหมอก
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 0.85
			hl.FillColor = col
			hl.OutlineColor = col
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.Occluded
			hl.Parent = ob
			local base = ob:GetPivot().Position
			local _, osz = ob:GetBoundingBox()
			local a0 = Instance.new("Attachment")
			local anchorPart = ob:FindFirstChildWhichIsA("BasePart", true)
			if anchorPart then
				a0.WorldPosition = base + Vector3.new(0, osz.Y * 0.5, 0)
				a0.Parent = anchorPart
				local skyPart = Instance.new("Part")
				skyPart.Anchored, skyPart.CanCollide, skyPart.CanQuery, skyPart.Transparency = true, false, false, 1
				skyPart.Size = Vector3.one
				skyPart.CFrame = CFrame.new(base + Vector3.new(0, 140, 0))
				skyPart.Parent = ob
				local a1 = Instance.new("Attachment")
				a1.Parent = skyPart
				local beam = Instance.new("Beam")
				beam.Attachment0, beam.Attachment1 = a0, a1
				beam.Width0, beam.Width1 = 2.2, 4
				beam.LightEmission = 1
				beam.FaceCamera = true
				beam.Color = ColorSequence.new(col)
				beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
				beam.Parent = anchorPart
			end
			local o = { Index = i, Model = ob, Glow = {}, Lit = false }
			for _, d in ipairs(ob:GetDescendants()) do
				if d:IsA("BasePart") and (d.Name == "Glyph" or d.Name == "Crystal") then
					table.insert(o.Glow, { Part = d, Color = d.Color })
				elseif d.Name == "Activator" then
					o.Activator = d
				elseif d.Name == "Top" then
					o.Top = d
				end
			end
			if o.Activator then
				o.Light = light(o.Activator, col, 22, 2.5, false)
				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "Wake"
				prompt.ActionText = "Awaken Rune Pillar"
				prompt.ObjectText = "Ancient Rune Pillar"
				prompt.HoldDuration = 0.4
				prompt.MaxActivationDistance = 13
				prompt.RequiresLineOfSight = false
				prompt.Parent = o.Activator
				prompt.Triggered:Connect(function(player)
					self:Activate(site, i, player)
				end)
				o.Prompt = prompt
			end
			if o.Top then
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(90, 90)
				bb.AlwaysOnTop = true
				bb.MaxDistance = 220
				bb.Enabled = false
				bb.Parent = o.Top
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundTransparency = 1
				t.Font = Enum.Font.FredokaOne
				t.TextScaled = true
				t.TextColor3 = Color3.new(1, 1, 1)
				t.TextStrokeColor3 = dim(col, 0.4)
				t.TextStrokeTransparency = 0
				t.Text = ""
				t.Parent = bb
				o.Billboard, o.Label = bb, t
			end
			site.Obelisks[i] = o
		end
	end
	-- ประตูผนึก + หีบ
	local door = m:FindFirstChild("VaultDoor")
	if door then
		local maxY, minY = -math.huge, math.huge
		for _, d in ipairs(door:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(site.Door, { Part = d, CFrame = d.CFrame })
				maxY = math.max(maxY, d.Position.Y + d.Size.Y / 2)
				minY = math.min(minY, d.Position.Y - d.Size.Y / 2)
			end
		end
		site.DoorDrop = math.max(4, maxY - minY + 0.6)
		local slab = door:FindFirstChild("DoorSlab")
		site.DoorPos = slab and slab.Position or pos
	end
	local lid = m:FindFirstChild("ChestLid")
	if lid then
		for _, d in ipairs(lid:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(site.Lid, { Part = d, CFrame = d.CFrame })
			end
		end
		local lb = lid:FindFirstChild("LidBody")
		if lb then
			site.LidHinge = lb.CFrame * CFrame.new(0, -lb.Size.Y / 2, lb.Size.Z / 2)
		end
	end
	local chest = m:FindFirstChild("VaultChest")
	local body = chest and chest:FindFirstChild("ChestBody")
	if body then
		-- โมเดลกล่องตำนาน (Props/Chest3) แทนหีบเดิม: ซ่อนชิ้นเดิม (ตัวหีบยังเป็นจุดกด/ที่วางของ)
		local PropBuilder = require(game:GetService("ReplicatedStorage").Shared.PropBuilder)
		local base = body.CFrame * CFrame.new(0, -body.Size.Y / 2, 0)
		local goldCF, goldW = CFrame.new(base.Position) * body.CFrame.Rotation, math.max(body.Size.X, body.Size.Z) * 1.6
		local gold = PropBuilder.Imported("Chest3Open", goldCF, goldW, chest, true) -- ฝาเปิดได้จริง
			or PropBuilder.Imported("Chest3", goldCF, goldW, chest, true)
		if gold then
			gold.Name = "Chest3Visual"
			for _, d in ipairs(chest:GetDescendants()) do
				if d:IsA("BasePart") and not d:IsDescendantOf(gold) then
					d.Transparency = 1
					if d ~= body then
						d.CanCollide = false
					end
				elseif (d:IsA("Decal") or d:IsA("Texture")) and not d:IsDescendantOf(gold) then
					d.Transparency = 1
				end
			end
			site.Lid = {}
		end
		site.ChestBody = body
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "OpenVault"
		prompt.ActionText = "Open Sacred Chest"
		prompt.ObjectText = THAI[el] .. " Sanctum Chest"
		prompt.HoldDuration = 1.2
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = body
		prompt.Triggered:Connect(function(player)
			self:OpenChest(site, player)
		end)
		site.ChestPrompt = prompt
	end
	m.Parent = parent
	self:ResetSite(site)
	self.sites[el] = site
end

---------------------------------------------------------------- สถานะเสา/ช่องรูน
function SanctumService:SetObelisk(o, mode)
	-- mode: "Dim" | "Flash" | "Lit" | "Fail"
	-- ทั้งก้อนหินรูนเรืองตามสถานะ (Highlight ที่ใส่ตอนสร้าง)
	local hl = o.Model and o.Model:FindFirstChildOfClass("Highlight")
	if hl then
		local col = o.Glow[1] and o.Glow[1].Color or hl.OutlineColor
		local fill = (mode == "Dim" and 0.92) or (mode == "Flash" and 0.25) or 0.45
		hl.FillColor = mode == "Fail" and Color3.fromRGB(255, 50, 40) or col
		hl.OutlineColor = hl.FillColor
		TweenService:Create(hl, TweenInfo.new(mode == "Flash" and 0.15 or 0.35), { FillTransparency = fill, OutlineTransparency = mode == "Dim" and 0.4 or 0 }):Play()
	end
	for _, g in ipairs(o.Glow) do
		if g.Part.Parent then
			local target = g.Color
			if mode == "Dim" then
				target = dim(g.Color, DIM)
			elseif mode == "Fail" then
				target = Color3.fromRGB(255, 50, 40)
			end
			TweenService:Create(g.Part, TweenInfo.new(mode == "Flash" and 0.15 or 0.35), { Color = target }):Play()
		end
	end
	if o.Light then
		o.Light.Enabled = mode ~= "Dim"
		o.Light.Color = mode == "Fail" and Color3.fromRGB(255, 50, 40) or o.Glow[1] and o.Glow[1].Color or o.Light.Color
		o.Light.Brightness = mode == "Flash" and 5 or 2.5
	end
end

function SanctumService:SetHints(site, n)
	for i, h in pairs(site.Hints) do
		if h.Part.Parent then
			h.Part.Color = i <= n and h.Color or dim(h.Color, 0.15)
		end
	end
end

function SanctumService:NearbyPlayers(site, radius)
	local out = {}
	local surv = self.ctx.Services.SurvivalService
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		if c and p:GetAttribute("InRun") and surv:IsAlive(p) and (c:GetPivot().Position - site.Center).Magnitude < radius then
			table.insert(out, p)
		end
	end
	return out
end

function SanctumService:Tell(site, text, kind, radius)
	for _, p in ipairs(self:NearbyPlayers(site, radius or 160)) do
		self.ctx.Notify(p, text, kind)
	end
end

---------------------------------------------------------------- ปริศนา
function SanctumService:ShowSequence(site)
	site.State = "Showing"
	site.ShowId = (site.ShowId or 0) + 1
	local showId = site.ShowId
	task.spawn(function()
		for _, o in pairs(site.Obelisks) do
			self:SetObelisk(o, "Dim")
		end
		task.wait(0.6)
		for step, idx in ipairs(site.Order) do
			if site.ShowId ~= showId or site.State ~= "Showing" then
				return
			end
			local o = site.Obelisks[idx]
			if o then
				self:SetObelisk(o, "Flash")
				if o.Billboard then
					o.Label.Text = tostring(step)
					o.Billboard.Enabled = true
				end
				if o.Activator then
					sound(o.Activator, "rbxasset://sounds/volume_slider.ogg", 0.8, 0.7 + step * 0.15, 180)
				end
				task.wait(1.1)
				self:SetObelisk(o, "Dim")
				if o.Billboard then
					o.Billboard.Enabled = false
				end
				task.wait(0.4)
			end
		end
		if site.ShowId == showId and site.State == "Showing" then
			site.State = "Ready"
			site.NextShow = os.clock() + 16
		end
	end)
end

-- ผู้พิทักษ์วิหาร 1 เวฟ (GuardianWaves: 3 -> 5 -> 7 ตัว) เกิดรอบลาน
function SanctumService:SpawnGuardians(site, count)
	local list = {}
	local pool = Animals.RaidPool[site.Element]
	if not pool then
		return list
	end
	local animals = self.ctx.Services.AnimalService
	local layout = self.ctx.Layout
	for i = 1, count do
		local ang = i / count * math.pi * 2 + self.rng:NextNumber(-0.3, 0.3)
		local p = site.Center + Vector3.new(math.cos(ang) * 34, 0, math.sin(ang) * 34)
		local h = layout:HeightAt(p.X, p.Z)
		local g = animals:Spawn(pool[self.rng:NextInteger(1, #pool)], Vector3.new(p.X, math.max(h, site.Center.Y) + 3, p.Z), {
			Kind = "Guardian", Home = site.Center, Leash = 60, Yaw = ang + i, -- เลือด/ดาเมจคงที่ (Monster Balance)
		})
		if g then
			g.Model:SetAttribute("Guardian", true)
			g.OnHurt = function(attacker)
				if typeof(attacker) == "Instance" and attacker:IsA("Player") then
					site.Helpers[attacker] = true
				end
			end
			table.insert(list, g)
		end
	end
	return list
end

-- เข้าลานวิหาร = ผู้พิทักษ์ 3 เวฟ · ครบแล้วเสารูนถึงเริ่มกะพริบบอกลำดับ (ปริศนา)
--   ทุกคนออกจากลานนาน 30 วิ = ผู้พิทักษ์ที่เหลือหายไป กลับมาเริ่มเวฟ 1 ใหม่
function SanctumService:TickWaves(site)
	local near = #self:NearbyPlayers(site, SHOW_RANGE) > 0
	local function spawn(_, count)
		return self:SpawnGuardians(site, count)
	end
	if not site.Wave then
		if near then
			GuardianWaves.Begin(site, spawn)
			self:Tell(site, string.format("⚔ The %s Sanctum guardians awaken! Wave 1/%d — %d guardians", THAI[site.Element], #GuardianWaves.Counts, GuardianWaves.Counts[1]), "Warn", SHOW_RANGE + 20)
		end
		return
	end
	if not near then
		site.Away = (site.Away or 0) + 0.5
		if site.Away > 30 then
			self:ClearGuardians(site)
		end
		return
	end
	site.Away = 0
	local step = GuardianWaves.Step(site, spawn, function(text, kind)
		self:Tell(site, text, kind, SHOW_RANGE + 20)
	end)
	if step == "done" then
		site.WavesDone = true
		site.Announced = true
		site.NextShow = os.clock() + 1
		self:Tell(site, "✨ All guardians defeated! Memorize the order the rune pillars flash, then awaken them in that order", "Good", SHOW_RANGE + 20)
	end
end

function SanctumService:ClearGuardians(site)
	for _, g in ipairs(site.Guardians or {}) do
		self.ctx.Services.AnimalService:Remove(g)
	end
	site.Guardians = {}
	site.Wave, site.NextWaveAt, site.Away = nil, nil, 0
end

function SanctumService:Activate(site, idx, player)
	if site.State == "Solved" then
		return
	end
	if not player:GetAttribute("InRun") or self.ctx.Services.SurvivalService:IsIncapacitated(player) then
		return
	end
	local o = site.Obelisks[idx]
	if not o or o.Lit then
		return
	end
	site.Helpers[player] = true
	if not site.WavesDone then
		self.ctx.Notify(player, "⚔ Defeat all 3 waves of guardians first", "Info")
		return
	end
	if site.State == "Showing" or site.State == "Failing" then
		self.ctx.Notify(player, "👁 Wait for the rune pillars to finish flashing the order first", "Info")
		return
	end
	if site.State ~= "Input" then
		site.State = "Input"
		site.Progress = 0
		site.Deadline = os.clock() + TIME_LIMIT
		self.ctx.State:SetAttribute("Sanctum" .. site.Element .. "Deadline", Workspace:GetServerTimeNow() + TIME_LIMIT)
		self:Tell(site, string.format("⏳ The %s Sanctum has awakened! Awaken the rune pillars in order within %d seconds", THAI[site.Element], TIME_LIMIT), "Warn")
	end
	if site.Order[site.Progress + 1] == idx then
		site.Progress += 1
		o.Lit = true
		self:SetObelisk(o, "Lit")
		self:SetHints(site, site.Progress)
		if o.Activator then
			sound(o.Activator, "rbxasset://sounds/volume_slider.ogg", 1, 0.9 + site.Progress * 0.2, 220)
		end
		if site.Progress >= #site.Order then
			self:Solve(site, player)
		else
			self:Tell(site, string.format("✨ Rune pillar %d/%d awakened", site.Progress, #site.Order), "Good", 120)
		end
	else
		self:Fail(site, "❌ Wrong order! The seal pushed back — watch the flashing lights again")
	end
end

function SanctumService:Fail(site, text)
	site.State = "Failing"
	site.Progress = 0
	self.ctx.State:SetAttribute("Sanctum" .. site.Element .. "Deadline", nil)
	self:Tell(site, text, "Error")
	for _, o in pairs(site.Obelisks) do
		o.Lit = false
		self:SetObelisk(o, "Fail")
		if o.Activator then
			sound(o.Activator, "rbxasset://sounds/volume_slider.ogg", 0.8, 0.45, 160)
		end
	end
	self:SetHints(site, 0)
	task.delay(1.2, function()
		if site.State == "Failing" then
			for _, o in pairs(site.Obelisks) do
				self:SetObelisk(o, "Dim")
			end
			site.State = "Idle"
			site.NextShow = os.clock() + 2
		end
	end)
end

function SanctumService:Solve(site, player)
	site.State = "Solved"
	local el = site.Element
	local col = COLOR[el]
	self.ctx.State:SetAttribute("Sanctum" .. el .. "Deadline", nil)
	self.ctx.State:SetAttribute("Sanctum" .. el .. "Solved", true)
	for _, o in pairs(site.Obelisks) do
		if o.Prompt then
			o.Prompt.Enabled = false
		end
	end
	-- ประตูผนึกยุบลงพื้น
	local info = TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	for _, d in ipairs(site.Door) do
		TweenService:Create(d.Part, info, { CFrame = d.CFrame - Vector3.new(0, site.DoorDrop, 0) }):Play()
	end
	local doorPos = site.DoorPos or site.Center
	local anchor = Instance.new("Part")
	anchor.Name = "VaultFx"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = doorPos
	anchor.Parent = site.Model
	site.Fx = { anchor }
	sound(anchor, "rbxasset://sounds/impact_explosion_03.mp3", 1.2, 0.5, 600)
	sound(anchor, "rbxasset://sounds/action_jump_land.mp3", 1.5, 0.35, 300)
	-- แสงพุ่ง: ลูกแสงขยาย + ไฟในห้อง + ลำแสงจากยอดวิหารขึ้นฟ้า
	local burst = Instance.new("Part")
	burst.Shape = Enum.PartType.Ball
	burst.Material = Enum.Material.SmoothPlastic
	burst.Color = col
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.Size = Vector3.new(2, 2, 2)
	burst.Position = doorPos
	burst.Parent = site.Model
	TweenService:Create(burst, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(44, 44, 44), Transparency = 1 }):Play()
	task.delay(1.8, function()
		burst:Destroy()
	end)
	local flash = light(anchor, col, 60, 0)
	TweenService:Create(flash, TweenInfo.new(0.4), { Brightness = 10 }):Play()
	task.delay(0.5, function()
		if flash.Parent then
			TweenService:Create(flash, TweenInfo.new(3), { Brightness = 0 }):Play()
		end
	end)
	if site.VaultLight then
		site.VaultLight.Enabled = true
	end
	if site.Beacon then
		local a0 = Instance.new("Attachment")
		a0.Parent = site.Beacon
		local top = Instance.new("Part")
		top.Name = "BeamTop"
		top.Anchored = true
		top.CanCollide = false
		top.CanQuery = false
		top.Transparency = 1
		top.Size = Vector3.new(1, 1, 1)
		top.Position = site.Beacon.Position + Vector3.new(0, 420, 0)
		top.Parent = site.Model
		local a1 = Instance.new("Attachment")
		a1.Parent = top
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 6
		beam.Width1 = 16
		beam.LightEmission = 1
		beam.FaceCamera = true
		beam.Color = ColorSequence.new(col)
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
		beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		beam.TextureSpeed = 0.6
		beam.Parent = site.Beacon
		table.insert(site.Fx, a0)
		table.insert(site.Fx, top)
		table.insert(site.Fx, beam)
	end
	self.ctx.FireRun("WorldEvent", "SanctumOpened", { Element = el, Position = doorPos, By = player and player.DisplayName })
	task.delay(3.5, function()
		if site.State == "Solved" and not site.Opened and site.ChestPrompt then
			site.ChestPrompt.Enabled = true
		end
	end)
end

function SanctumService:OpenChest(site, player)
	if site.Opened or site.State ~= "Solved" or not player:GetAttribute("InRun") then
		return
	end
	site.Opened = true
	if site.ChestPrompt then
		site.ChestPrompt.Enabled = false
	end
	local el = site.Element
	local ctx = self.ctx
	local rng = self.rng
	-- ฝาหีบพลิกเปิดรอบบานพับด้านหลัง (+Z ของหีบ)
	local hinge = site.LidHinge
	if hinge then
		local rot = hinge * CFrame.Angles(math.rad(80), 0, 0) * hinge:Inverse()
		for _, d in ipairs(site.Lid) do
			TweenService:Create(d.Part, TweenInfo.new(0.8, Enum.EasingStyle.Back), { CFrame = rot * d.CFrame }):Play()
		end
	end
	local pos = (site.ChestBody and site.ChestBody.Position or site.Center) + Vector3.new(0, 1.5, 0)
	local drops = ctx.Services.DropService
	local got = {}
	local function give(id, n)
		if n > 0 then
			n = drops:SpawnLoot(id, n, pos, { Spread = 3.5 })
			got[id] = (got[id] or 0) + n
		end
	end
	give(ESSENCE[el], rng:NextInteger(4, 6))
	for _, other in ipairs(ELEMENTS) do
		if other ~= el and rng:NextNumber() < 0.3 then
			give(ESSENCE[other], 1)
		end
	end
	give("Iron", rng:NextInteger(3, 5))
	give("Medkit", 1)
	-- ลงวิหารได้ครั้งเดียว: ของระดับ 3 (อาวุธตำนาน 1 ชิ้น + ของเสริม) เหมือนกล่องตำนาน
	for id, n in pairs(ctx.Services.LootService:GiveTierLoot(3, pos, rng)) do
		got[id] = (got[id] or 0) + n
	end
	if rng:NextNumber() < 0.2 then
		give(HEART[el], 1)
	end
	-- ออร่าธาตุ: เฉพาะคนที่ช่วยกัน (ปลุกเสา / ตีผู้พิทักษ์ / คนเปิดหีบ) ที่ยังอยู่ในรอบ
	site.Helpers[player] = true
	local surv = ctx.Services.SurvivalService
	for p in pairs(site.Helpers) do
		if p.Parent and p:GetAttribute("InRun") and surv:GiveAura(p, el) then
			ctx.Notify(p, "✨ Gained " .. AURA_TEXT[el] .. " (lasts the whole run)", "Reward")
		end
	end
	ctx.Broadcast(string.format("Cleared the %s Sanctum · Got %s", THAI[el], AURA_TEXT[el]), "Reward")
	for _, p in ipairs(self:NearbyPlayers(site, 70)) do
		ctx.Services.DataService:AddDiamonds(p, rng:NextInteger(5, 8), "Ancient Sanctum: " .. THAI[el])
	end
	task.spawn(self.SealAfterClear, self, site)
	ctx.Remotes.Get("HitFx"):FireClient(player, "Loot", { Items = got, Position = pos, Chest = true })
	ctx.Services.LootService:ChestFx(site.ChestBody and site.ChestBody.Parent, pos, 3)
	if site.ChestBody then
		sound(site.ChestBody, "rbxasset://sounds/volume_slider.ogg", 1, 1.6, 200)
	end
end

-- เคลียร์แล้ว: ปิดประตูมิติข้างนอก (เข้าวิหารนี้ไม่ได้อีกจนจบรอบ) · คนที่ยังอยู่ในห้องออกทางประตูกลับได้ตามปกติ
function SanctumService:PortalVeil(site)
	local out = site.Model and site.Model:FindFirstChild("PortalOut", true)
	if not out then
		return nil
	end
	for _, d in ipairs(out:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			return d.Parent, d
		end
	end
end

function SanctumService:SealPortal(site)
	local veil, prompt = self:PortalVeil(site)
	if veil then
		veil:SetAttribute("Sealed", true)
		site.PortalAction = site.PortalAction or prompt.ActionText
		prompt.ActionText = "Sealed"
	end
end

-- เก็บ/คืนสถานะ (RejoinService): วิหารที่เปิดหีบแล้ว ต้องยังปิดผนึกในเซิร์ฟเวอร์ใหม่ของรอบเดิม
function SanctumService:Serialize()
	local out = {}
	for el, site in pairs(self.sites) do
		if site.Opened then
			out[el] = true
		end
	end
	return out
end

function SanctumService:Restore(st)
	for el in pairs(type(st) == "table" and st or {}) do
		local site = self.sites[el]
		if site then
			site.State = "Solved"
			site.Opened = true
			site.WavesDone = true
			self.ctx.State:SetAttribute("Sanctum" .. el .. "Solved", true)
			for _, o in pairs(site.Obelisks) do
				if o.Prompt then
					o.Prompt.Enabled = false
				end
			end
			self:SealPortal(site)
		end
	end
end

function SanctumService:SealAfterClear(site)
	task.wait(3)
	if not site.Opened then
		return
	end
	self:SealPortal(site)
	self.ctx.Broadcast(string.format("The %s Sanctum is now sealed", THAI[site.Element]), "Info")
end

---------------------------------------------------------------- รีเซ็ต (รอบใหม่)
function SanctumService:ResetSite(site)
	site.State = "Idle"
	site.Helpers = {}
	local veil, prompt = self:PortalVeil(site)
	if veil then
		veil:SetAttribute("Sealed", nil)
		if site.PortalAction then
			prompt.ActionText = site.PortalAction
		end
	end
	site.Progress = 0
	site.Opened = false
	if site.ChestBody then
		self.ctx.Services.LootService.CloseLid(site.ChestBody.Parent)
	end
	self:ClearGuardians(site)
	site.WavesDone = false
	site.NextShow = 0
	site.ShowId = (site.ShowId or 0) + 1
	local order = { 1, 2, 3 }
	for i = #order, 2, -1 do
		local j = self.rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	site.Order = order
	for _, o in pairs(site.Obelisks) do
		o.Lit = false
		self:SetObelisk(o, "Dim")
		if o.Prompt then
			o.Prompt.Enabled = true
		end
		if o.Billboard then
			o.Billboard.Enabled = false
		end
	end
	self:SetHints(site, 0)
	for _, d in ipairs(site.Door) do
		d.Part.CFrame = d.CFrame
	end
	for _, d in ipairs(site.Lid) do
		d.Part.CFrame = d.CFrame
	end
	if site.ChestPrompt then
		site.ChestPrompt.Enabled = false
	end
	if site.VaultLight then
		site.VaultLight.Enabled = false
	end
	for _, f in ipairs(site.Fx or {}) do
		if f.Parent then
			f:Destroy()
		end
	end
	site.Fx = {}
	local st = self.ctx.State
	st:SetAttribute("Sanctum" .. site.Element .. "Solved", false)
	st:SetAttribute("Sanctum" .. site.Element .. "Deadline", nil)
end

function SanctumService:Reset()
	for _, site in pairs(self.sites) do
		self:ResetSite(site)
	end
end

---------------------------------------------------------------- ลูป
function SanctumService:Tick()
	local now = os.clock()
	for _, site in pairs(self.sites) do
		if not site.WavesDone and site.State ~= "Solved" then
			self:TickWaves(site)
		elseif site.State == "Input" and now > (site.Deadline or 0) then
			self:Fail(site, "⌛ Time's up! The rune pillars went back to sleep — watch the order again")
		elseif (site.State == "Idle" or site.State == "Ready") and now >= site.NextShow then
			if #self:NearbyPlayers(site, SHOW_RANGE) > 0 then
				if not site.Announced then
					site.Announced = true
					self:Tell(site, "👁 Memorize the order the rune pillars flash, then awaken them in that order!", "Info", SHOW_RANGE + 20)
				end
				self:ShowSequence(site)
			end
		end
	end
end

function SanctumService:Start(ctx)
	local layout = ctx.Layout
	local sanctums = layout and layout.Sanctums
	if not sanctums then
		return
	end
	local art = ServerStorage:FindFirstChild("WorldArt")
	local world = Workspace:FindFirstChild("World")
	local folder = Instance.new("Folder")
	folder.Name = "Sanctums"
	folder.Parent = world or Workspace
	for _, el in ipairs(ELEMENTS) do
		local sp = sanctums[el]
		if sp then
			ctx.State:SetAttribute("Sanctum_" .. el, sp.Position)
			local src = art and art:FindFirstChild("Sanctum_" .. el)
			if src then
				local ok, err = pcall(self.Build, self, el, sp, src, folder)
				if not ok then
					warn("[AS] sanctum " .. el .. ":", err)
				end
			end
		end
	end
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		if ctx.State:GetAttribute("Phase") == "Lobby" then
			self:Reset()
			for _, site in pairs(self.sites) do
				site.Announced = false
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(self.Tick, self)
			if not ok then
				warn("[AS] sanctum tick", err)
			end
		end
	end)
end

return SanctumService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000075"><Properties><string name="Name">SeasonService</string><ProtectedString name="Source"><![CDATA[--[[
	SeasonService — Season Pass 30 วัน (สายฟรี + สายพรีเมียม) + ฉายา/สีฉายา
	  · XP ได้จากภารกิจ/ล็อกอิน/รอดผ่านคืน/ล่าสัตว์/บอส/ช่วยวิญญาณ (QuestService เรียก AddXP)
	  · ขึ้นซีซั่นใหม่ (ทุก 30 วัน นับจาก Quests.SeasonEpoch) = XP และขั้นที่รับแล้วเริ่มใหม่ (ฉายา/สีที่ได้ไปแล้วอยู่ถาวร)
	  · สายพรีเมียม: Game Pass "SeasonPass" ใน Config.GamePasses (MonetizationService:HasPass)
	  · ฉายาที่ใส่อยู่ = player attribute "Title" (+ "TitleColor") -> ป้ายบนหัวในล็อบบี้ (LobbyService:RefreshTag)
	  เซฟ: Season = { Id, XP, Free = { T1 = true }, Prem = { ... } }, Titles, NameColors, EquipTitle, EquipColor
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Quests = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Quests"))
local Classes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Classes"))

local SeasonService = {}

local DEFAULT_TITLE_COLOR = Color3.fromRGB(255, 236, 170)

function SeasonService:Init(ctx)
	self.ctx = ctx
end

local function ds(self)
	return self.ctx.Services.DataService
end

function SeasonService:Ensure(_player, data)
	local changed = false
	local cur = Quests.Season()
	if type(data.Season) ~= "table" or data.Season.Id ~= cur then
		data.Season = { Id = cur, XP = 0, Free = {}, Prem = {} }
		changed = true
	end
	data.Season.Free = type(data.Season.Free) == "table" and data.Season.Free or {}
	data.Season.Prem = type(data.Season.Prem) == "table" and data.Season.Prem or {}
	data.Season.XP = tonumber(data.Season.XP) or 0
	for _, k in ipairs({ "Titles", "NameColors" }) do
		if type(data[k]) ~= "table" then
			data[k] = {}
		end
	end
	if type(data.EquipTitle) ~= "string" then
		data.EquipTitle = ""
	end
	if type(data.EquipColor) ~= "string" then
		data.EquipColor = ""
	end
	return changed
end

function SeasonService:OnLoad(player, data)
	self:Ensure(player, data)
	self:Apply(player, data)
end

function SeasonService:HasPremium(player)
	local shop = self.ctx.Services.MonetizationService
	return shop ~= nil and shop:HasPass(player, Quests.SeasonPassKey)
end

-- ฉายาที่ใส่อยู่ -> attributes บนตัวผู้เล่น -> ป้ายบนหัว/กระดานอันดับ
function SeasonService:Apply(player, data)
	data = data or ds(self):Get(player)
	if not data then
		return
	end
	local t = Quests.Titles[data.EquipTitle]
	local col = Quests.Colors[data.EquipColor]
	player:SetAttribute("Title", t and (t.Icon .. " " .. t.Text) or "")
	player:SetAttribute("TitleColor", col and col.Color or DEFAULT_TITLE_COLOR)
	player:SetAttribute("NameColor", col and col.Color or nil)
	local lobby = self.ctx.Services.LobbyService
	if lobby and lobby.RefreshTag then
		task.spawn(lobby.RefreshTag, lobby, player)
	end
end

function SeasonService:AddXP(player, n)
	local data = ds(self):Get(player)
	n = math.floor(tonumber(n) or 0)
	if not data or n <= 0 then
		return
	end
	self:Ensure(player, data)
	local before = Quests.TierOf(data.Season.XP)
	data.Season.XP += n
	local after = Quests.TierOf(data.Season.XP)
	if after > before then
		self.ctx.Notify(player, string.format("🎟 Season Pass tier %d! Claim rewards in the \"Quests\" menu", after), "Reward")
	end
	local qs = self.ctx.Services.QuestService
	if qs then
		qs:MarkDirty(player)
	end
end

-- ฉายา/สี (ไม่รวม Ruby) — ใช้กับรางวัลซีซั่นและโค้ด
function SeasonService:GrantCosmetics(player, reward)
	local data = ds(self):Get(player)
	if not data then
		return
	end
	self:Ensure(player, data)
	local equip = false
	if reward.Title and Quests.Titles[reward.Title] then
		if not data.Titles[reward.Title] then
			data.Titles[reward.Title] = true
			self.ctx.Notify(player, "🏷 New title: " .. Quests.Titles[reward.Title].Text, "Reward")
		end
		if data.EquipTitle == "" then
			data.EquipTitle = reward.Title
			equip = true
		end
	end
	if reward.Color and Quests.Colors[reward.Color] then
		if not data.NameColors[reward.Color] then
			data.NameColors[reward.Color] = true
			self.ctx.Notify(player, "🎨 New title color: " .. Quests.Colors[reward.Color].Text, "Reward")
		end
		if data.EquipColor == "" then
			data.EquipColor = reward.Color
			equip = true
		end
	end
	if equip then
		self:Apply(player, data)
	end
end

-- คลาสจากพาส · มีอยู่แล้ว -> Ruby ชดเชยครึ่งราคา (คลาสพาสราคา 0 = ไม่ชดเชย)
function SeasonService:GrantClass(player, classId, reason)
	local data = ds(self):Get(player)
	local c = Classes.Data[classId]
	if not (data and c) then
		return
	end
	data.Owned = type(data.Owned) == "table" and data.Owned or {}
	if data.Owned[classId] then
		local refund = Quests.ClassRefund(classId)
		if refund <= 0 then
			return -- คลาสพาส (ราคา 0): มีแล้วก็ไม่ชดเชย (Ruby ของขั้นนั้นได้อยู่แล้ว)
		end
		self.ctx.Notify(player, string.format("You already have the %s class — got %d Ruby instead", c.Thai, refund), "Reward")
		ds(self):AddDiamonds(player, refund, reason)
		return
	end
	data.Owned[classId] = true
	data.SeasonClasses = type(data.SeasonClasses) == "table" and data.SeasonClasses or {}
	data.SeasonClasses[classId] = true -- จำว่าได้จากการกดรับ (DataService:Load ถอดคลาสซีซั่นที่ไม่ได้มาทางนี้)
	self.ctx.Notify(player, c.Icon .. " Unlocked class " .. c.Thai .. " from the Season Pass!", "Reward")
	ds(self):Push(player)
end

local function grant(self, player, reward, reason)
	if (reward.Ruby or 0) > 0 then
		ds(self):AddDiamonds(player, reward.Ruby, reason)
	end
	if reward.Class then
		self:GrantClass(player, reward.Class, reason)
	end
	if reward.Title or reward.Color then
		self:GrantCosmetics(player, reward)
	end
end

-- track = "Free" / "Prem" / "All" (รับทุกขั้นที่ถึงแล้ว) · tier = 1..30
function SeasonService:Claim(player, track, tier)
	local data = ds(self):Get(player)
	if not data then
		return
	end
	self:Ensure(player, data)
	local reached = Quests.TierOf(data.Season.XP)
	local prem = self:HasPremium(player)
	local list = {}
	if track == "All" then
		for t = 1, reached do
			table.insert(list, { "Free", t })
			if prem then
				table.insert(list, { "Prem", t })
			end
		end
	elseif (track == "Free" or track == "Prem") and type(tier) == "number" then
		table.insert(list, { track, math.floor(tier) })
	else
		return
	end
	local got = 0
	for _, e in ipairs(list) do
		local tr, t = e[1], e[2]
		local reward = Quests.Track[tr][t]
		local key = "T" .. t
		if reward and t >= 1 and t <= reached and not data.Season[tr][key] then
			if tr == "Prem" and not prem then
				self.ctx.Notify(player, "🔒 The premium track needs the Season Pass (Shop → Game Pass)", "Info")
			else
				data.Season[tr][key] = true
				grant(self, player, reward, string.format("Season Pass tier %d%s", t, tr == "Prem" and " (Premium)" or ""))
				got += 1
			end
		end
	end
	if got > 0 then
		local qs = self.ctx.Services.QuestService
		if qs then
			qs:Push(player)
			qs:SaveSoon(player)
		end
	elseif track == "All" then
		self.ctx.Notify(player, "No rewards to claim yet — earn a bit more XP!", "Info")
	end
end

-- kind = "Title" / "Color" · id = "" = ถอด
function SeasonService:Equip(player, kind, id)
	local data = ds(self):Get(player)
	if not data or type(id) ~= "string" then
		return
	end
	self:Ensure(player, data)
	if kind == "Title" and (id == "" or data.Titles[id]) then
		data.EquipTitle = id
	elseif kind == "Color" and (id == "" or data.NameColors[id]) then
		data.EquipColor = id
	else
		return
	end
	self:Apply(player, data)
	local qs = self.ctx.Services.QuestService
	if qs then
		qs:Push(player)
	end
end

function SeasonService:Start(ctx)
	ctx.Remotes.Get("ClaimSeason").OnServerEvent:Connect(function(player, track, tier)
		self:Claim(player, track, tier)
	end)
	ctx.Remotes.Get("EquipCosmetic").OnServerEvent:Connect(function(player, kind, id)
		self:Equip(player, kind, id)
	end)
	-- ซื้อ Season Pass ระหว่างเล่น -> ให้ client วาดสายพรีเมียมใหม่
	local function hook(player)
		player:GetAttributeChangedSignal("Pass_" .. Quests.SeasonPassKey):Connect(function()
			local qs = ctx.Services.QuestService
			if qs then
				qs:Push(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
end

return SeasonService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000076"><Properties><string name="Name">SkillService</string><ProtectedString name="Source"><![CDATA[--[[
	SkillService — สกิลกดของคลาส 5 ดาว (Classes.ActiveSkills · ปลดตามเลเวล · คลาสหนึ่งมีได้หลายสกิล)
	  Swarm (แวมไพร์ Lv3)       : ค้างคาว 5 ตัว (เลือด 200) ตามเจ้าของ ไล่กัดมอน · อยู่จนโดนตีตาย หรือกดใหม่ = ฝูงใหม่มาแทน
	  ShadowVeil (พ่อมดมืด Lv2) : ล่องหน + วิ่งเร็วขึ้น 50% 4 วิ · มอนมองไม่เห็น · ทำดาเมจ = หลุดล่องหน
	  DarkMeteor (พ่อมดมืด Lv3) : อุกกาบาตมืดตกตรงจุดที่เล็ง ดาเมจแรงวงกว้าง + วงไฟมืด 10 วิ เผา 2% เลือด/วิ (บอสรวมไม่เกิน 5%)
	  ThornBind (พงไพร Lv3)     : สตั้นมอนรอบตัว 4 วิ (บอส 2 วิ) + พิษ 1% เลือด/วิ 15 วิ (บอสรวม 4%)
	ผู้เล่น: attribute "Skills" = รหัสสกิลที่ใช้ได้คั่นด้วย "," · "SkillReady_<Id>" = เวลาเซิร์ฟเวอร์ที่คูลดาวน์หมด
	ฝั่งเครื่องผู้เล่น: ClassSkill.lua (ช่องสกิลหน้าแถบของ · ปุ่ม Q / Z)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Classes = require(ReplicatedStorage.Shared.Classes)

local SkillService = {}

local BAT_COUNT, BAT_HP, BAT_DAMAGE, BAT_RANGE = 5, 200, 14, 48
local BAT_KILL_HEAL = 0.05 -- ค้างคาวฆ่ามอนได้ 1 ตัว = เจ้าของได้เลือดคืน 5% ของเลือดสูงสุด
local hurtBatRef -- = hurtBat (ประกาศด้านล่าง)
local swarms = {} -- [player] = { bats... }

local function now()
	return Workspace:GetServerTimeNow()
end

function SkillService:Init(ctx)
	self.ctx = ctx
	self.folder = Instance.new("Folder")
	self.folder.Name = "Summons"
	self.folder.Parent = Workspace
	self.groundParams = RaycastParams.new()
	self.groundParams.FilterType = Enum.RaycastFilterType.Include
	self.groundParams.FilterDescendantsInstances = { Workspace.Terrain }
end

-- สกิลที่ผู้เล่นคนนี้ใช้ได้ตอนนี้ (ต้องอยู่ในรอบ) -> { {Id, Cooldown, Icon}, ... }
function SkillService:SkillsOf(player)
	if not player:GetAttribute("InRun") then
		return {}
	end
	return Classes.ActiveSkills(player:GetAttribute("Class") or "Survivor", player:GetAttribute("ClassLevel") or 1)
end

function SkillService:SkillOf(player, id)
	for _, sk in ipairs(self:SkillsOf(player)) do
		if sk.Id == id then
			return sk
		end
	end
	return nil
end

function SkillService:Refresh(player)
	local ids = {}
	for _, sk in ipairs(self:SkillsOf(player)) do
		table.insert(ids, sk.Id)
	end
	player:SetAttribute("Skills", table.concat(ids, ","))
	if not self:SkillOf(player, "Swarm") then
		self:Dismiss(player) -- ไม่ใช่แวมไพร์เลเวล 3 แล้ว (เปลี่ยนคลาส/ออกจากรอบ) = ค้างคาวหาย
	end
	if not self:SkillOf(player, "ShadowVeil") then
		self:BreakVeil(player)
	end
end

local function rootOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

---------------------------------------------------------------- ค้างคาว (Swarm)
local function batModel()
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local props = assets and assets:FindFirstChild("Props")
	local src = props and props:FindFirstChild("VampBat")
	local m
	if src then
		m = src:Clone()
		-- ข้อต่อปีกเดิมของโมเดลเก่า (C0/C1 ไม่ตรงท่ากาง) ดึงปีกพับเข้าตัวตอนบินจริง -> สร้างใหม่ให้ท่าพัก = ปีกกางเหมือนในโมเดล
		-- บานพับอยู่ที่โคนปีก (ข้างลำตัว) หมุนรอบแกนตั้ง = กระพือ (ClassSkill ใส่ Transform)
		local body = m:FindFirstChild("Torso")
		if body then
			for _, j in ipairs(m:GetDescendants()) do
				if j:IsA("JointInstance") then
					j:Destroy()
				end
			end
			for _, w in ipairs(m:GetChildren()) do
				if w:IsA("BasePart") and w ~= body and w.Name:find("Wing") then
					local loc = body.CFrame:PointToObjectSpace(w.Position)
					local side = loc.X >= 0 and 1 or -1
					local hinge = body.CFrame * CFrame.new(side * body.Size.X * 0.4, loc.Y, loc.Z)
					local j = Instance.new("Motor6D")
					j.Name = (w.Name:find("Left") and "Left" or "Right") .. " Shoulder"
					j.Part0, j.Part1 = body, w
					j.C0 = body.CFrame:ToObjectSpace(hinge)
					j.C1 = w.CFrame:ToObjectSpace(hinge)
					j.Parent = body
				end
			end
		end
		-- ปีกเป็นแผ่นเมชหน้าเดียว (มองจากหลังแล้วหาย) -> ก๊อปกลับด้าน (Scale Z ติดลบ) เชื่อมติดปีกเดิม = เห็นทั้งสองด้าน
		for _, w in ipairs(m:GetChildren()) do
			local mesh = w:IsA("BasePart") and w.Name:find("Wing") and w:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				local back = w:Clone()
				for _, c in ipairs(back:GetChildren()) do
					if not c:IsA("SpecialMesh") then
						c:Destroy()
					end
				end
				back.Name = w.Name .. "Back"
				local bm = back:FindFirstChildOfClass("SpecialMesh")
				bm.Scale = bm.Scale * Vector3.new(1, 1, -1)
				back.Parent = m
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1 = w, back
				weld.Parent = back
			end
		end
	else
		-- สำรอง: ตัวดำปีกแดงจากชิ้นพื้นฐาน (ถ้ายังไม่มีโมเดล Store)
		m = Instance.new("Model")
		local body = Instance.new("Part")
		body.Name = "Torso"
		body.Size = Vector3.new(0.6, 1.4, 0.6)
		body.Color = Color3.fromRGB(30, 26, 32)
		body.Parent = m
	end
	m.Name = "VampBat"
	pcall(function()
		m:ScaleTo(m:GetScale() * 1.4) -- ตัวใหญ่ขึ้น มองเห็นชัด
	end)
	local torso = m:FindFirstChild("Torso") or m:FindFirstChildWhichIsA("BasePart", true)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = d ~= torso
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	m.PrimaryPart = torso
	-- ลอยด้วยแรง (เคลื่อนไหวลื่นบนเครื่องผู้เล่น ไม่กระตุกแบบย้ายตำแหน่งตรงๆ)
	local att = Instance.new("Attachment")
	att.Parent = torso
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 1e6
	ap.MaxVelocity = 70
	ap.Responsiveness = 30
	ap.Parent = torso
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e6
	ao.Responsiveness = 25
	ao.Parent = torso
	-- หลอดเลือดเล็กบนหัว
	local bb = Instance.new("BillboardGui")
	bb.Name = "HP"
	bb.Size = UDim2.fromOffset(46, 6)
	bb.StudsOffset = Vector3.new(0, 1.8, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Parent = torso
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 10, 14)
	back.BorderSizePixel = 0
	back.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(220, 40, 60)
	fill.BorderSizePixel = 0
	fill.Parent = back
	return m, torso, ap, ao, fill
end

-- ค้างคาวรับดาเมจแทนเจ้าของ: ตัวที่เลือดเหลือมากสุดรับ BAT_GUARD ของดาเมจ -> คืนดาเมจที่เหลือให้ผู้เล่น
local BAT_GUARD = 0.6
function SkillService:Absorb(player, amount)
	local best
	for _, b in ipairs(swarms[player] or {}) do
		if not b.Dead and b.Model.Parent and (not best or b.HP > best.HP) then
			best = b
		end
	end
	if not best then
		return amount
	end
	local take = amount * BAT_GUARD
	self.ctx.Remotes.Get("HitFx"):FireAllClients("BatGuard", { Bat = best.Torso, Player = player })
	hurtBatRef(self, best, take)
	return amount - take
end

-- ค้างคาวที่ยังอยู่ของผู้เล่นคนนี้ (ใช้ในเทส)
function SkillService:Bats(player)
	return swarms[player] or {}
end

function SkillService:Dismiss(player)
	local list = swarms[player]
	swarms[player] = nil
	for _, b in ipairs(list or {}) do
		b.Dead = true
		if b.Model.Parent then
			self.ctx.Remotes.Get("HitFx"):FireAllClients("Gust", { Position = b.Torso.Position, Radius = 4 })
			b.Model:Destroy()
		end
	end
end

-- ค้างคาวโดนมอนกัด: มอนที่ดุ (ไม่ใช่สัตว์เชื่อง) อยู่ชิด = เสียเลือดตามแรงของมอน
local function hurtBat(self, b, amount)
	b.HP -= amount
	b.Fill.Size = UDim2.fromScale(math.clamp(b.HP / BAT_HP, 0, 1), 1)
	if b.HP <= 0 and not b.Dead then
		b.Dead = true
		self.ctx.Remotes.Get("HitFx"):FireAllClients("Gust", { Position = b.Torso.Position, Radius = 4 })
		b.Model:Destroy()
	end
end
hurtBatRef = hurtBat

function SkillService:Swarm(player)
	self:Dismiss(player) -- กดใหม่ = ฝูงเดิมหาย
	local root = rootOf(player)
	if not root then
		return false
	end
	local list = {}
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	for i = 1, BAT_COUNT do
		local m, torso, ap, ao, fill = batModel()
		local a = i / BAT_COUNT * math.pi * 2
		local start = root.Position + Vector3.new(math.cos(a) * 4, 5, math.sin(a) * 4)
		m:PivotTo(CFrame.lookAt(start, start + look))
		ap.Position = start
		m:SetAttribute("Owner", player.UserId)
		m.Parent = self.folder
		pcall(function()
			torso:SetNetworkOwner(nil) -- เซิร์ฟเวอร์คุมทิศทาง (ทุกคนเห็นเหมือนกัน)
		end)
		table.insert(list, { Model = m, Torso = torso, Align = ap, Orient = ao, Fill = fill, HP = BAT_HP, Slot = a, NextBite = 0, NextHurt = 0 })
	end
	swarms[player] = list
	self.ctx.Remotes.Get("HitFx"):FireAllClients("SkillSwarm", { Position = root.Position, Player = player })
	return true
end

-- จัดแถวหลังเจ้าของ: บน 3 ตัว ล่าง 2 ตัว (x = ซ้าย/ขวา, y = สูง)
local FORMATION = {
	Vector2.new(-6.6, 7.4), Vector2.new(0, 8), Vector2.new(6.6, 7.4),
	Vector2.new(-3.3, 4.4), Vector2.new(3.3, 4.4),
}
local FORM_BACK = 3

-- ทุก 0.1 วิ: บินตามเจ้าของเป็นแถว · มีมอนใกล้ = พุ่งไปกัด
function SkillService:TickBats()
	local animals = self.ctx.Services.AnimalService
	local combat = self.ctx.Services.CombatService
	local t = now()
	for player, list in pairs(swarms) do
		local root = rootOf(player)
		if not root or not player.Parent or not player:GetAttribute("InRun") then
			self:Dismiss(player)
			continue
		end
		local alive = {}
		for _, b in ipairs(list) do
			if not b.Dead and b.Model.Parent then
				table.insert(alive, b)
			end
		end
		if #alive == 0 then
			swarms[player] = nil
			continue
		end
		swarms[player] = alive
		for i, b in ipairs(alive) do
			local pos = b.Torso.Position
			local target = animals:Nearest(root.Position, BAT_RANGE, true)
			local goal
			if target and target.Root and not target.Dead then
				-- วนรอบเป้าแต่ละตัวคนละมุม
				local ang = b.Slot + t * 3
				goal = target.Root.Position + Vector3.new(math.cos(ang) * 3, 2.5, math.sin(ang) * 3)
				if (pos - target.Root.Position).Magnitude < 8 then
					if t >= b.NextBite then
						b.NextBite = t + 0.9
						local deadBefore = target.Dead
						local tpos = target.Root.Position
						local batDmg = BAT_DAMAGE * self.ctx.Services.SurvivalService:Perk(player, "DamageMult", 1)
						if target.Kind == "Boss" or target.Info.Behaviour == "Boss" then
							batDmg *= 0.5 -- บอสโดนค้างคาวกัดแค่ครึ่ง
						end
						combat:DamageAnimal(target, batDmg, player, { Source = "Summon" })
						self.ctx.Remotes.Get("HitFx"):FireAllClients("BatBite", { Position = tpos, From = pos })
						if target.Dead and not deadBefore then
							local surv = self.ctx.Services.SurvivalService
							local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
							if hum then
								surv:Heal(player, hum.MaxHealth * BAT_KILL_HEAL)
							end
							self.ctx.Remotes.Get("HitFx"):FireAllClients("BatDrain", { Position = tpos, Player = player })
						end
					end
					-- มอนกัดกลับ
					if t >= b.NextHurt and target.Info.Behaviour ~= "Passive" then
						b.NextHurt = t + 1.2
						hurtBat(self, b, (target.Info.Damage or 10) * 0.6)
					end
				end
			end
			local face
			if goal then
				local dir = (goal - pos) * Vector3.new(1, 0, 1)
				face = dir.Magnitude > 0.5 and dir.Unit or nil
			else
				-- ไม่มีเป้า: เข้าแถวหลังเจ้าของ หันทางเดียวกับเจ้าของ
				local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
				look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
				local right = look:Cross(Vector3.yAxis)
				local f = FORMATION[(i - 1) % #FORMATION + 1]
				goal = root.Position - look * FORM_BACK + right * f.X + Vector3.new(0, f.Y + math.sin(t * 2.5 + i) * 0.35, 0)
				face = look
			end
			if not b.Dead then
				b.Align.Position = goal
				if face then
					-- โมเดล Store ตั้งตรง ปีกกางแกน X: บินตัวตั้ง เอนหน้าเล็กน้อย -> กล้องหลังตัวเห็นปีกกางเต็ม
					b.Orient.CFrame = CFrame.lookAt(Vector3.zero, face) * CFrame.Angles(-0.3, 0, 0)
				end
			end
		end
	end
end

---------------------------------------------------------------- ล่องหน (ShadowVeil)
local VEIL_TIME = 4
local veils = {} -- [player] = { Token, Parts = { [part] = transparency เดิม } }

function SkillService:BreakVeil(player)
	local v = veils[player]
	if not v then
		return
	end
	veils[player] = nil
	for part, t in pairs(v.Parts) do
		if part.Parent then
			part.Transparency = t
		end
	end
	player:SetAttribute("Invisible", nil)
	player:SetAttribute("SkillSpeed", nil)
end

function SkillService:ShadowVeil(player)
	self:BreakVeil(player)
	local char = player.Character
	if not char then
		return false
	end
	local v = { Token = {}, Parts = {} }
	veils[player] = v
	for _, d in ipairs(char:GetDescendants()) do
		if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" and d.Transparency < 1 then
			v.Parts[d] = d.Transparency
			d.Transparency = 0.85 + d.Transparency * 0.15 -- เกือบใส (เพื่อนยังพอเห็นเงาจางๆ)
		end
	end
	player:SetAttribute("Invisible", true)
	player:SetAttribute("SkillSpeed", 1.5)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("SkillVeil", { Position = char:GetPivot().Position, Player = player })
	local token = v.Token
	task.delay(VEIL_TIME, function()
		if veils[player] and veils[player].Token == token then
			self:BreakVeil(player)
		end
	end)
	return true
end

---------------------------------------------------------------- อุกกาบาตมืด (DarkMeteor)
local DM_RADIUS, DM_ZONE, DM_ZONE_TIME = 24, 20, 10
local DM_LOCK = 100 -- ล็อกเป้ามอนที่ใกล้ที่สุดในระยะนี้ (ไม่มี = ตกตรงที่เล็ง)
function SkillService:DarkMeteor(player, aim)
	local root = rootOf(player)
	if not root then
		return false
	end
	local surv = self.ctx.Services.SurvivalService
	local animals = self.ctx.Services.AnimalService
	local combat = self.ctx.Services.CombatService
	local function ground(p)
		local hit = Workspace:Raycast(p + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), self.groundParams)
		return hit and hit.Position or p
	end
	-- ล็อกเป้า: มอนที่ใกล้ที่สุด (ลูกอุกกาบาตตามตัวจนตก) · ไม่มีมอน = ตกตรงที่เล็ง/หน้าตัว
	local target = animals:Nearest(root.Position, DM_LOCK, true)
	local center
	if target and target.Root then
		center = target.Root.Position
	else
		center = root.Position + root.CFrame.LookVector * 30
		if typeof(aim) == "Vector3" and (aim - root.Position).Magnitude < 120 then
			center = aim
		end
	end
	center = ground(center)
	self.ctx.Remotes.Get("HitFx"):FireAllClients("SkillDarkMeteor", { Position = center, Radius = DM_RADIUS, Zone = DM_ZONE, Duration = DM_ZONE_TIME, Target = target and target.Model or nil })
	task.delay(1.1, function() -- ตรงกับลูกตกฝั่ง client (ClassFX: fall 1.1 วิ)
		if target and not target.Dead and target.Root and target.Root.Parent then
			center = ground(target.Root.Position) -- เป้าขยับระหว่างตก: ตกตรงตัวเป้า
		end
		-- ตกกระแทก: ดาเมจแรงวงกว้าง
		local dmg = 160 * surv:Perk(player, "DamageMult", 1)
		for _, a in ipairs(animals:InRadius(center, DM_RADIUS, false)) do
			if a.Kind ~= "Spirit" then
				combat:DamageAnimal(a, dmg, player, { Source = "Skill" })
			end
		end
		-- วงไฟมืด: เผา 2% เลือดสูงสุด/วิ (บอส 0.5%/วิ รวมไม่เกิน 5%)
		local stop = os.clock() + DM_ZONE_TIME
		local burned = {} -- [animal] = % ที่เผาไปแล้ว
		while os.clock() < stop do
			for _, a in ipairs(animals:InRadius(center, DM_ZONE, true)) do
				local boss = a.Kind == "Boss" or a.Info.Behaviour == "Boss"
				local pct, cap = 0.02, 0.2
				if boss then
					pct, cap = 0.005, 0.05
				end
				local done = burned[a] or 0
				pct = math.min(pct, cap - done)
				if pct > 1e-6 then
					burned[a] = done + pct
					combat:DamageAnimal(a, a.Hum.MaxHealth * pct, player, { Source = "Skill", Silent = true })
				end
			end
			task.wait(1)
		end
	end)
	return true
end

---------------------------------------------------------------- พันธนาการหนาม (ThornBind)
local TB_RADIUS = 42 -- วงกว้าง (AOE)
function SkillService:ThornBind(player)
	local root = rootOf(player)
	if not root then
		return false
	end
	local t = os.clock()
	for _, a in ipairs(self.ctx.Services.AnimalService:InRadius(root.Position, TB_RADIUS, true)) do
		local boss = a.Kind == "Boss" or a.Info.Behaviour == "Boss"
		local stun = boss and 2 or 4
		a.StunUntil = t + stun
		a.PoisonUntil = t + 15
		a.PoisonPct = boss and (0.04 / 15) or 0.01 -- บอสรวมไม่เกิน 4% / 15 วิ
		a.PoisonBy = player
		self.ctx.Remotes.Get("HitFx"):FireAllClients("SkillThornMark", { Model = a.Model, Stun = stun, Poison = 15 })
	end
	self.ctx.Remotes.Get("HitFx"):FireAllClients("SkillThornBind", { Position = root.Position, Radius = TB_RADIUS, Player = player })
	return true
end

---------------------------------------------------------------- ใช้สกิล
function SkillService:Use(player, id, aim)
	local sk = type(id) == "string" and self:SkillOf(player, id)
	if not sk or self.ctx.Services.SurvivalService:IsIncapacitated(player) then
		return false
	end
	local key = "SkillReady_" .. sk.Id
	if now() < (player:GetAttribute(key) or 0) then
		return false
	end
	local ok = false
	if sk.Id == "Swarm" then
		ok = self:Swarm(player)
	elseif sk.Id == "ShadowVeil" then
		ok = self:ShadowVeil(player)
	elseif sk.Id == "DarkMeteor" then
		ok = self:DarkMeteor(player, aim)
	elseif sk.Id == "ThornBind" then
		ok = self:ThornBind(player)
	end
	if ok then
		player:SetAttribute(key, now() + sk.Cooldown)
	end
	return ok
end

function SkillService:Start(ctx)
	ctx.Remotes.Get("UseSkill").OnServerEvent:Connect(function(player, id, aim)
		self:Use(player, id, aim)
	end)
	local function hook(player)
		for _, a in ipairs({ "Class", "ClassLevel", "InRun" }) do
			player:GetAttributeChangedSignal(a):Connect(function()
				self:Refresh(player)
			end)
		end
		self:Refresh(player)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(hook, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		self:Dismiss(p)
		veils[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(self.TickBats, self)
			if not ok then
				warn("[AS] Skill bats:", err)
			end
		end
	end)
end

return SkillService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000077"><Properties><string name="Name">SpiritService</string><ProtectedString name="Source"><![CDATA[--[[
	SpiritService — ภารกิจหลักของการผจญภัย
	ศาลเจ้า 4 ธาตุ: ลูกสัตว์ธาตุถูกขังในกรง มีสัตว์เฝ้า
	  เข้าถึงลาน = ฉากเปิด (ShrineIntro): ผู้เฝ้าเดินเข้าหากรง -> เราวิ่งเข้าไป -> ผู้เฝ้าหันมาคำราม -> สู้
	  ปราบผู้เฝ้า -> ปลดผนึก = ฉากจบ (ShrineCleared): กรงแตก -> เสาผลึกธาตุผุดขึ้นที่ไบโอม -> ลูกสัตว์ไปอยู่แคมป์
	    ลูกสัตว์โตขึ้น เดินเล่นในแคมป์เอง (ขี่ได้ MountService) + ข้ามไป 1 วัน (เหมือนเตียง) + บัฟถาวร
	  ช่วยครบ = ฉากจบสมบูรณ์
	  รังบอส 4 ธาตุ: เข้าใกล้ = บอสตื่น (สู้ได้ทุกเวลา) ชนะ = หัวใจอสูร + Ruby
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local Animals = require(ReplicatedStorage.Shared.Animals)
local Classes = require(ReplicatedStorage.Shared.Classes)
local Config = require(ReplicatedStorage.Shared.Config)
local Nights = require(ReplicatedStorage.Shared.Nights)
local PropBuilder = require(ReplicatedStorage.Shared.PropBuilder)
local GuardianWaves = require(script.Parent.GuardianWaves)

local SpiritService = {}

local LAIR_RESPAWN = 15 * 60 -- บอสในรังตายแล้วกลับมาใหม่หลังกี่วินาที
local INTRO_TIME, INTRO_TURN = 12, 9 -- ฉากเปิดศาลเจ้า: ผู้เฝ้าถูกปล่อย / หันมาหาผู้เล่น (ตรงกับ Cinematics.ShrineIntro)
local CLEAR_PILLAR, CLEAR_HOME = 3.6, 8.6 -- ฉากจบศาลเจ้า: เสาผุด / ลูกสัตว์ไปโผล่ที่แคมป์ (ตรงกับ Cinematics.ShrineCleared)
local PET_SIZE = 1.9 -- ลูกสัตว์ที่ช่วยแล้วโตขึ้นที่แคมป์ (ตัวใหญ่พอให้ขี่)
-- อนุสาวรีย์ลูกสัตว์ธาตุ (3D Model/anuzon -> Assets.Props.Monument<El>) ผุดแทนเสาผลึกตอนช่วยสำเร็จ · ไม่มีโมเดล = เสาผลึกเดิม
local MONUMENT_WIDTH = 30 -- ความกว้างฐาน (stud) สูงราว 40
local MONUMENT_YAW = 0 -- แก้ทิศหน้าโมเดล (Import 3D: บันได = -Z ของโมเดล -> lookAt หาแคมป์ตรง ๆ)
local CRYSTAL = { Earth = "TerraCrystal", Water = "TideCrystal", Air = "GaleCrystal", Fire = "EmberCrystal" }
local PILLAR_COLOR = {
	Earth = Color3.fromRGB(120, 245, 90), Water = Color3.fromRGB(70, 210, 255),
	Air = Color3.fromRGB(200, 235, 255), Fire = Color3.fromRGB(255, 120, 40),
}

local BUFF_TEXT = {
	Earth = "Buildings slowly repair themselves",
	Water = "The campfire burns fuel 25% slower",
	Air = "Everyone runs 10% faster",
	Fire = "The campfire burns enemies that enter the safe zone",
}

function SpiritService:Init(ctx)
	self.ctx = ctx
	self.shrines = {} -- [element] = { Model, Pup, Guardians, Freed, Rescued, Prompt }
	self.lairs = {} -- [element] = { Model, Boss, Cleared, LastSeen }
end

local function charRoot(p)
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function nearestPlayer(pos, radius)
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r then
			local d = (r.Position - pos).Magnitude
			if d < radius and (not bestD or d < bestD) then
				best, bestD = p, d
			end
		end
	end
	return best, bestD
end

local function playersNear(pos, radius)
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and (r.Position - pos).Magnitude < radius then
			table.insert(out, p)
		end
	end
	return out
end

---------------------------------------------------------------- ศาลเจ้า
function SpiritService:SetupShrine(model)
	local el = model:GetAttribute("Element")
	local cage = model:FindFirstChild("Cage")
	local seal = cage and cage:FindFirstChild("Seal")
	local base = model:GetPivot().Position
	local sh = { Model = model, Element = el, Base = base, SitePos = model:GetAttribute("SitePos") or base, Guardians = {}, Freed = false, Rescued = false }
	-- จุดยืนตอนวาร์ปเข้าห้อง (ประตูข้างนอก Dest) -> ทิศที่ผู้เล่นเดินมาหากรง ใช้วางผู้เฝ้าในฉากเปิด
	for _, d in ipairs(model:GetDescendants()) do
		local dest = d:GetAttribute("Dest")
		if typeof(dest) == "Vector3" and math.abs(dest.Y - base.Y) < 30 then
			sh.Entry = dest
			sh.OutVeil = d
			break
		end
	end
	self.shrines[el] = sh
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Unseal"
	prompt.ActionText = "Unseal"
	prompt.ObjectText = el .. " Sealed Cage"
	prompt.HoldDuration = 3
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = seal or model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		self:Free(el, player)
	end)
	sh.Prompt = prompt
	self:SpawnPup(sh)
end

function SpiritService:SpawnPup(sh)
	if sh.Pup and sh.Pup.Model.Parent then
		sh.Pup.Model:Destroy()
	end
	local id = Animals.Spirits[sh.Element]
	local a = self.ctx.Services.AnimalService:Spawn(id, sh.Base + Vector3.new(0, 0.3, 0), { Kind = "Spirit", NoSnap = true })
	if a then
		a.Root.Anchored = true
		a.Model:SetAttribute("State", "Caged")
		sh.Pup = a
	end
end

function SpiritService:SpawnGuardians(sh)
	local pool = Animals.RaidPool[sh.Element]
	local animals = self.ctx.Services.AnimalService
	local rng = Random.new()
	sh.Guardians = {}
	-- ครั้งแรกของรอบ = ฉากเปิด: ผู้เฝ้าเริ่มที่ข้างลาน/หลังกรง แล้วค่อยๆ เดินเข้าล้อมกรง
	local intro = not sh.IntroPlayed and sh.Entry ~= nil
	sh.IntroPlayed = true
	local frame = sh.Entry and CFrame.lookAt(sh.Base, Vector3.new(sh.Entry.X, sh.Base.Y, sh.Entry.Z)) -- -Z = ทางที่ผู้เล่นเดินมา
	local count = GuardianWaves.Counts[1] -- เวฟ 1 (เวฟ 2-3 = SpawnWave)
	sh.Wave, sh.NextWaveAt = 1, nil
	for i = 1, count do
		local id = pool[math.min(i, #pool)]
		local pos, stand
		if intro then
			local side = ({ -1, 1, 0 })[i]
			pos = (frame * CFrame.new(side * 36, 2, i == 3 and 28 or 8)).Position
			stand = (frame * CFrame.new(side * 11, 0, i == 3 and 11 or 2)).Position
		else
			local ang = i / count * math.pi * 2
			pos = sh.Base + Vector3.new(math.cos(ang) * 18, 2, math.sin(ang) * 18)
		end
		local h = self.ctx.Layout:HeightAt(pos.X, pos.Z)
		local a = animals:Spawn(id, Vector3.new(pos.X, math.max(h, sh.Base.Y) + 1, pos.Z), {
			Kind = "Guardian", Home = sh.Base, Leash = 70, -- เลือด/ดาเมจ x1.5 (Config.ShrineGuardianMult)
			HealthMult = Config.ShrineGuardianMult, DamageMult = Config.ShrineGuardianMult,
			Yaw = intro and math.atan2(pos.X - sh.Base.X, pos.Z - sh.Base.Z) or nil, -- หันหน้าเข้าหากรง
		})
		if a then
			a.Model:SetAttribute("Guardian", true)
			table.insert(sh.Guardians, a)
			if intro then
				-- เดินช้าๆ เข้าหากรงให้ถึงใน ~7 วิ (AI หยุดคิดจนจบฉาก)
				a.IntroUntil = os.clock() + INTRO_TIME
				local dist = (Vector3.new(stand.X, 0, stand.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
				local factor = math.clamp(dist / 7 / ((a.Info.Speed or 16) * a.SpeedMult), 0.12, 1)
				animals:MoveTo(a, Vector3.new(stand.X, sh.Base.Y + 2, stand.Z), factor)
			end
		end
	end
	sh.GuardiansSpawned = true
	if not intro then
		self.ctx.Broadcast(string.format("The %s Shrine guardians have awakened", sh.Element), "Warn")
		return
	end
	local cin = self.ctx.Remotes.Get("Cinematic")
	local pupName = sh.Pup and sh.Pup.Info.Thai or ""
	for _, p in ipairs(playersNear(sh.Base, 170)) do
		cin:FireClient(p, "ShrineIntro", { Element = sh.Element, Cage = sh.Base, Entry = sh.Entry, Name = pupName, Dur = INTRO_TIME, Turn = INTRO_TURN })
	end
	-- ตัวหลังกรงขู่ใส่ลูกสัตว์ก่อน (ระหว่างช็อตผู้เฝ้าเดินเข้าหา)
	task.delay(INTRO_TURN - 2.8, function()
		local g = sh.Guardians[1]
		if g and not g.Dead and g.Model.Parent then
			animals:MarkAttack(g, "Bite")
		end
	end)
	-- ผู้เฝ้าเห็นเรา: หยุด หันมา คำราม
	task.delay(INTRO_TURN, function()
		for _, g in ipairs(sh.Guardians) do
			if not g.Dead and g.Model.Parent then
				local p = nearestPlayer(g.Root.Position, 250)
				local r = p and charRoot(p)
				animals:Stop(g)
				if r then
					animals:Face(g, r.Position)
				end
				animals:MarkAttack(g, "Roar")
			end
		end
	end)
	task.delay(INTRO_TIME, function()
		self.ctx.Broadcast(string.format("The %s Shrine guardians have awakened", sh.Element), "Warn")
	end)
end

-- เวฟ 2-3: ผู้เฝ้าโผล่รอบกรง (ไม่มีฉากเปิด)
function SpiritService:SpawnWave(sh, wave, count)
	local pool = Animals.RaidPool[sh.Element]
	local animals = self.ctx.Services.AnimalService
	local rng = Random.new()
	local list = {}
	for i = 1, count do
		local ang = i / count * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
		local r = rng:NextNumber(16, 24)
		local pos = sh.Base + Vector3.new(math.cos(ang) * r, 2, math.sin(ang) * r)
		local h = self.ctx.Layout:HeightAt(pos.X, pos.Z)
		local a = animals:Spawn(pool[(i - 1) % #pool + 1], Vector3.new(pos.X, math.max(h, sh.Base.Y) + 1, pos.Z), {
			Kind = "Guardian", Home = sh.Base, Leash = 70, -- เลือด/ดาเมจ x1.5 (Config.ShrineGuardianMult)
			HealthMult = Config.ShrineGuardianMult, DamageMult = Config.ShrineGuardianMult,
			Yaw = math.atan2(sh.Base.X - pos.X, sh.Base.Z - pos.Z), -- หันออกหาทางที่ผู้เล่นอยู่
		})
		if a then
			a.Model:SetAttribute("Guardian", true)
			table.insert(list, a)
		end
	end
	return list
end

-- ช่วยแล้ว = ประตูข้างนอกปิดจนจบรอบ (คนที่อยู่ข้างในยังออกทางประตูกลับได้) · เริ่มรอบใหม่สร้างศาลเจ้าใหม่ ประตูเปิดเอง
function SpiritService:SealPortal(sh)
	local veil = sh.OutVeil
	if not veil then
		warn("[AS] Shrine", sh.Element, "outer portal not found")
		return
	end
	veil:SetAttribute("Sealed", true)
	local prompt = veil:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.ActionText = "Sealed"
	end
end

function SpiritService:Free(el, player)
	local sh = self.shrines[el]
	if not sh or sh.Freed or not sh.Pup then
		return
	end
	sh.Freed = true
	sh.Prompt.Enabled = false
	self:SealPortal(sh)
	-- กรงแตก
	local cage = sh.Model:FindFirstChild("Cage")
	if cage then
		for _, d in ipairs(cage:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = false
				d.AssemblyLinearVelocity = Vector3.new(math.random(-25, 25), math.random(20, 45), math.random(-25, 25))
				TweenService:Create(d, TweenInfo.new(2), { Transparency = 1 }):Play()
			end
		end
	end
	local a = sh.Pup
	local pillarPos = self:PillarPos(sh)
	local home = self:PetSpot(el)
	-- คนในห้องศาลเจ้าดูฉากจบเต็ม (ลูกสัตว์ดีใจ -> เสาผุดที่ไบโอม -> ไปโผล่ที่แคมป์) · โหลดพื้นรอบเสา/แคมป์ล่วงหน้า
	local cin = self.ctx.Remotes.Get("Cinematic")
	for _, p in ipairs(playersNear(sh.Base, 170)) do
		cin:FireClient(p, "ShrineCleared", {
			Element = el, Name = a.Info.Thai, Cage = sh.Base, Pillar = pillarPos, Home = home, Player = player.DisplayName,
			PillarAt = CLEAR_PILLAR, HomeAt = CLEAR_HOME, Buff = BUFF_TEXT[el], PetId = Animals.Spirits[el],
		})
		task.spawn(function()
			pcall(function()
				p:RequestStreamAroundAsync(pillarPos, 4)
			end)
			pcall(function()
				p:RequestStreamAroundAsync(home, 4)
			end)
		end)
	end
	self.ctx.Broadcast(string.format("%s freed %s", player.DisplayName, a.Info.Thai), "Reward")
	task.delay(CLEAR_PILLAR, function()
		if sh.Model.Parent then
			self:RaisePillar(sh, false)
		end
	end)
	task.delay(CLEAR_HOME, function()
		if sh.Model.Parent then
			self:Rescue(a, player)
		end
	end)
end

-- ดวงไฟธาตุบนเสาธงที่แคมป์ติดสว่าง
function SpiritService:LightOrb(el, info)
	local camp = self.ctx.Services.CampService.campModel
	local orb = camp and camp:FindFirstChild("SpiritOrb_" .. el)
	if not orb then
		return
	end
	orb.Material = Enum.Material.Neon
	orb.Color = info.Model.Colors.Glow or info.Model.Colors.Main
	if not orb:FindFirstChildOfClass("PointLight") then
		local l = Instance.new("PointLight")
		l.Color = orb.Color
		l.Range = 26
		l.Brightness = 3
		l.Parent = orb
	end
end

-- จุดที่ลูกสัตว์โผล่ที่แคมป์: รอบกองไฟคนละทิศ (ห่างกองไฟพอ ไม่ยืนทับไฟ)
function SpiritService:PetSpot(el)
	local campPos = self.ctx.CampPosition
	local ang = ({ Earth = 0, Water = 1, Air = 2, Fire = 3 })[el] * math.pi / 2 + 0.6
	local p = campPos + Vector3.new(math.cos(ang) * 24, 0, math.sin(ang) * 24)
	return Vector3.new(p.X, self.ctx.Layout:HeightAt(p.X, p.Z) + 2, p.Z)
end

-- ลูกสัตว์ (โตแล้ว) ไปอยู่แคมป์: เดินเล่นเองในเขตแคมป์ ไม่ต้องตามใคร · ขี่ได้ (MountService)
function SpiritService:SpawnPet(sh)
	local animals = self.ctx.Services.AnimalService
	if sh.Pup then
		animals:Remove(sh.Pup)
		sh.Pup = nil
	end
	if sh.Pet and not sh.Pet.Removed then
		return sh.Pet
	end
	local pos = self:PetSpot(sh.Element)
	local spiritId = Animals.Spirits[sh.Element]
	local petScale = Animals.Data[spiritId].Model.Skin.PetScale or PET_SIZE -- แต่ละตัวโตไม่เท่ากัน ให้ขนาดพอดีขี่
	local a = animals:Spawn(spiritId, pos, { Kind = "Spirit", SizeMult = petScale, Yaw = math.random() * math.pi * 2 })
	if not a then
		return nil
	end
	a.Pet = true
	a.Home = self.ctx.CampPosition
	a.WanderAt = os.clock() + 5 -- ยืนดีใจให้เห็นหน้าก่อน (ฉากจบ) ค่อยเดินเล่น
	a.Model:SetAttribute("Pet", true)
	a.Model:SetAttribute("State", "Idle")
	sh.Pet = a
	self.ctx.Remotes.Get("HitFx"):FireAllClients("Vanish", { Position = pos })
	if self.ctx.Services.MountService then
		self.ctx.Services.MountService:AddPet(a)
	end
	return a
end

-- เสาผลึกธาตุยักษ์ผุดขึ้นที่ไบโอม (หลังประตูศาลเจ้า) = ศาลเจ้านี้ช่วยสำเร็จแล้ว · ลำแสงขึ้นฟ้าเห็นได้ทั้งแมพ
local function hasMonument(el)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local props = assets and assets:FindFirstChild("Props")
	return props ~= nil and props:FindFirstChild("Monument" .. el) ~= nil
end

function SpiritService:PillarPos(sh)
	local site = sh.SitePos
	local away = (site - self.ctx.CampPosition) * Vector3.new(1, 0, 1)
	away = away.Magnitude > 1 and away.Unit or Vector3.new(0, 0, 1)
	local p = site + away * (hasMonument(sh.Element) and 46 or 34) -- อนุสาวรีย์ฐานกว้าง -> ถอยห่างซุ้มประตูอีกหน่อย
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(Vector3.new(p.X, site.Y + 200, p.Z), Vector3.new(0, -500, 0), rp)
	return Vector3.new(p.X, hit and hit.Position.Y or self.ctx.Layout:HeightAt(p.X, p.Z), p.Z)
end

function SpiritService:RaisePillar(sh, instant)
	if sh.Pillar and sh.Pillar.Parent then
		return
	end
	local el = sh.Element
	local col = PILLAR_COLOR[el] or Color3.new(1, 1, 1)
	local pos = self:PillarPos(sh)
	local m = Instance.new("Model")
	m.Name = "ClearPillar_" .. el
	local rng = Random.new()
	if hasMonument(el) then
		-- อนุสาวรีย์ลูกสัตว์ธาตุ หันบันไดเข้าหาแคมป์ (ยืน/เดินขึ้นได้)
		local look = (self.ctx.CampPosition - pos) * Vector3.new(1, 0, 1)
		look = look.Magnitude > 1 and look.Unit or Vector3.new(0, 0, -1)
		local cf = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(MONUMENT_YAW), 0)
		PropBuilder.Imported("Monument" .. el, cf - Vector3.new(0, 0.6, 0), MONUMENT_WIDTH, m, true)
	else
		-- ผลึกธาตุยักษ์ตรงกลาง + ผลึกเล็กล้อมรอบ (โมเดลผลึก Creator Store ชุดเดียวกับในแมพ)
		PropBuilder.DecoCrystal(CRYSTAL[el], pos - Vector3.new(0, 1, 0), rng:NextNumber(0, 6.28), 6.5, m)
		for k = 0, 6 do
			local ang = k / 7 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
			local q = pos + Vector3.new(math.cos(ang) * 13, -0.5, math.sin(ang) * 13)
			PropBuilder.DecoCrystal(CRYSTAL[el], q, rng:NextNumber(0, 6.28), rng:NextNumber(1.8, 2.8), m)
		end
	end
	local _, size = m:GetBoundingBox()
	local core = Instance.new("Part")
	core.Name = "PillarCore"
	core.Anchored, core.CanCollide, core.CanQuery, core.CanTouch, core.Transparency = true, false, false, false, 1
	core.Size = Vector3.new(1, 1, 1)
	core.CFrame = CFrame.new(pos + Vector3.new(0, size.Y * 0.5, 0))
	core.Parent = m
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = col, 60, 3, false
	l.Parent = core
	local a0 = Instance.new("Attachment")
	a0.Parent = core
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 900, 0)
	a1.Parent = core
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = a0, a1
	beam.Width0, beam.Width1 = 16, 34
	beam.LightEmission, beam.LightInfluence = 1, 0
	beam.FaceCamera = true
	beam.Segments = 2
	beam.Color = ColorSequence.new(col)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.7, 0.75), NumberSequenceKeypoint.new(1, 1) })
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureSpeed = 0.3
	beam.Enabled = instant == true -- ลำแสงยิงขึ้นฟ้าตอนเสาโผล่สุด
	beam.Parent = core
	local up = Instance.new("ParticleEmitter")
	up.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	up.Color = ColorSequence.new(col)
	up.LightEmission = 1
	up.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	up.Lifetime = NumberRange.new(2, 3.5)
	up.Speed = NumberRange.new(10, 22)
	up.SpreadAngle = Vector2.new(12, 12)
	up.Rate = 26
	up.Parent = core
	pcall(function()
		m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	m:SetAttribute("Element", el)
	m.Parent = sh.Model
	sh.Pillar = m
	if instant then
		return
	end
	-- ผุดขึ้นจากดิน 3 วิ + ฝุ่นฟุ้ง + เสียงครืน
	local final = m:GetPivot()
	local depth = size.Y + 2
	m:PivotTo(final - Vector3.new(0, depth, 0))
	local dust = Instance.new("Part")
	dust.Anchored, dust.CanCollide, dust.CanQuery, dust.CanTouch, dust.Transparency = true, false, false, false, 1
	dust.Size = Vector3.new(24, 1, 24)
	dust.CFrame = CFrame.new(pos)
	dust.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(180, 160, 130), col)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 16) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(12, 26)
	e.SpreadAngle = Vector2.new(80, 80)
	e.Shape = Enum.ParticleEmitterShape.Disc
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.Rate = 40
	e.Parent = dust
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local k = math.clamp((os.clock() - t0) / 3.1, 0, 1)
		local eased = 1 - (1 - k) ^ 3
		if m.Parent then
			local jit = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 0.6 * (1 - k)
			m:PivotTo(final - Vector3.new(0, depth * (1 - eased), 0) + jit)
		end
		if k >= 1 then
			conn:Disconnect()
			if m.Parent then
				m:PivotTo(final)
			end
			e.Enabled = false
			beam.Enabled = true
			Debris:AddItem(dust, 3)
		end
	end)
end

function SpiritService:Rescue(a, player)
	local el = a.Info.Element
	local sh = self.shrines[el]
	if not sh or sh.Rescued then
		return
	end
	sh.Rescued = true
	local s = self.ctx.State
	s:SetAttribute("Spirit" .. el, true)
	self:LightOrb(el, a.Info)
	self:SpawnPet(sh)
	if not (sh.Pillar and sh.Pillar.Parent) then
		self:RaisePillar(sh, true)
	end
	local count = 0
	for _, e in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		if s:GetAttribute("Spirit" .. e) then
			count += 1
		end
	end
	s:SetAttribute("SpiritCount", count)
	-- บวกตัวคูณวันตามธาตุ (Config.SpiritBonusDays: ไม้ +1 · น้ำ +2 · น้ำแข็ง +3 · ไฟ +4)
	local days = Config.SpiritBonusDays[el] or 1
	local name = a.Info.Thai
	-- ตัวคูณวัน: ยังไม่มี = ปกติ x1 แล้วบวกเพิ่ม (ช่วยไม้ = x2 · ไม้+น้ำ = x4 · ครบ 4 ตัว = x11)
	local director = self.ctx.Services.DirectorService
	local cur = math.floor(s:GetAttribute("BonusDays") or 0)
	local skipped = director:AddDayMultiplier(days + (cur > 0 and 0 or 1), "Spirit Pup")
	if skipped then
		self.ctx.Broadcast(string.format("🌟 Rescued %s — days now count x%d!", name, director:DayMultiplier()), "Good")
	end
	self.ctx.FireRun("Cinematic", "SpiritRescued", { Element = el, Name = name, Buff = BUFF_TEXT[el], Count = count, Day = skipped, Days = days, Mult = director:DayMultiplier() })
	for _, p in ipairs(Players:GetPlayers()) do
		self.ctx.Services.DataService:AddDiamonds(p, Classes.SpiritReward, "Rescued " .. a.Info.Thai)
		if self.ctx.Services.QuestService then
			self.ctx.Services.QuestService:Progress(p, "Spirit", 1)
		end
	end
end

-- เก็บ/คืนสถานะ (RejoinService)
function SpiritService:Serialize()
	local s = self.ctx.State
	local out = { Spirits = {}, Lairs = {} }
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		out.Spirits[el] = s:GetAttribute("Spirit" .. el) == true or nil
		out.Lairs[el] = s:GetAttribute("Lair" .. el .. "Cleared") == true or nil
	end
	return out
end

function SpiritService:Restore(st)
	if type(st) ~= "table" then
		return
	end
	local s = self.ctx.State
	local count = 0
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		local sh = self.shrines[el]
		if type(st.Spirits) == "table" and st.Spirits[el] and sh then
			count += 1
			sh.Freed, sh.Rescued = true, true
			self:SealPortal(sh)
			if sh.Prompt then
				sh.Prompt.Enabled = false
			end
			local cage = sh.Model:FindFirstChild("Cage")
			if cage then
				cage:Destroy()
			end
			for _, g in ipairs(sh.Guardians or {}) do
				if g.Model and g.Model.Parent then
					g.Model:Destroy()
				end
			end
			sh.Guardians = {}
			sh.GuardiansSpawned = true
			s:SetAttribute("Spirit" .. el, true)
			local info = Animals.Data[Animals.Spirits[el]]
			if info then
				self:LightOrb(el, info)
			end
			self:SpawnPet(sh)
			self:RaisePillar(sh, true)
		end
		local lair = self.lairs[el]
		if type(st.Lairs) == "table" and st.Lairs[el] and lair then
			lair.Cleared = true
			lair.RespawnAt = os.clock() + LAIR_RESPAWN -- เวลาที่เหลือไม่ได้เก็บไว้ -> นับใหม่เต็ม 15 นาที
			s:SetAttribute("Lair" .. el .. "Cleared", true)
			local sigil = lair.Model:FindFirstChild("Sigil")
			if sigil then
				sigil.Color = Color3.fromRGB(255, 220, 120)
				sigil.Transparency = 0.3
			end
		end
	end
	s:SetAttribute("SpiritCount", count)
end

---------------------------------------------------------------- รังบอส
function SpiritService:SetupLair(model)
	local el = model:GetAttribute("Element")
	local spawnPart = model:FindFirstChild("BossSpawn")
	self.lairs[el] = { Model = model, Element = el, Pos = spawnPart and spawnPart.Position or model:GetPivot().Position, Cleared = false }
end

function SpiritService:WakeLair(lair, player)
	local info = Animals.Data[({ Earth = "Terragon", Water = "Leviathan", Air = "TempestRoc", Fire = "Solfang" })[lair.Element]]
	local id = ({ Earth = "Terragon", Water = "Leviathan", Air = "TempestRoc", Fire = "Solfang" })[lair.Element]
	local a = self.ctx.Services.AnimalService:Spawn(id, lair.Pos + Vector3.new(0, 2, 0), {
		Kind = "Guardian", Home = lair.Pos, Leash = 60, HealthMult = Nights.BossHealthMult(self.ctx.Services.SurvivalService:RunPlayerCount(true)),
		DamageMult = Nights.BossDamageMult(self.ctx.Services.SurvivalService:RunPlayerCount(true)), -- ตีธรรมดา + สกิล +25%/คน
	})
	if not a then
		return
	end
	a.Model:SetAttribute("IsBoss", true)
	a.Model:SetAttribute("Lair", lair.Element)
	self.ctx.Services.AnimalService:BeginIntro(a) -- ฉากเปิดตัว: ตรึงไว้ ~7 วิ
	lair.Boss = a
	lair.LastSeen = os.clock()
	local s = self.ctx.State
	s:SetAttribute("BossId", id)
	s:SetAttribute("BossHP", a.Hum.MaxHealth)
	s:SetAttribute("BossMaxHP", a.Hum.MaxHealth)
	for _, p in ipairs(Players:GetPlayers()) do
		local r = charRoot(p)
		if r and (r.Position - lair.Pos).Magnitude < 300 then
			self.ctx.Remotes.Get("Cinematic"):FireClient(p, "BossIntro", { Model = a.Model, Id = id, Name = info.Name, Thai = info.Thai, Element = info.Element })
		end
	end
end

function SpiritService:OnBossKilled(a)
	local el = a.Model:GetAttribute("Lair")
	if not el then
		return
	end
	local lair = self.lairs[el]
	if not lair then
		return
	end
	lair.Cleared = true
	lair.Boss = nil
	lair.RespawnAt = os.clock() + LAIR_RESPAWN
	self.ctx.State:SetAttribute("Lair" .. el .. "Cleared", true)
	self.ctx.State:SetAttribute("Lair" .. el .. "RespawnAt", workspace:GetServerTimeNow() + LAIR_RESPAWN)
	local sigil = lair.Model:FindFirstChild("Sigil")
	if sigil then
		sigil.Color = Color3.fromRGB(255, 220, 120)
		sigil.Transparency = 0.3
	end
	self.ctx.Broadcast(string.format("Defeated %s · Respawns in %d min", a.Info.Thai, LAIR_RESPAWN / 60), "Reward")
end

-- บอสในรังกลับมาเกิด (ครบเวลา): รังพร้อมปลุกอีกครั้งเมื่อมีคนเข้าใกล้
function SpiritService:RespawnLair(lair)
	lair.Cleared = false
	lair.RespawnAt = nil
	local el = lair.Element
	self.ctx.State:SetAttribute("Lair" .. el .. "Cleared", false)
	self.ctx.State:SetAttribute("Lair" .. el .. "RespawnAt", nil)
	local sigil = lair.Model:FindFirstChild("Sigil")
	if sigil then
		sigil.Color = require(ReplicatedStorage.Shared.PropBuilder).ElementColor[el]
		sigil.Transparency = 0.6
	end
	local id = ({ Earth = "Terragon", Water = "Leviathan", Air = "TempestRoc", Fire = "Solfang" })[el]
	local info = Animals.Data[id]
	self.ctx.Broadcast(string.format("%s has returned to its lair", info and info.Thai or "Boss"), "Warn")
end

---------------------------------------------------------------- loop
function SpiritService:Tick()
	local animals = self.ctx.Services.AnimalService
	for el, sh in pairs(self.shrines) do
		if not sh.Freed then
			local p = nearestPlayer(sh.Base, 140)
			if p and not sh.GuardiansSpawned then
				self:SpawnGuardians(sh)
			end
			if sh.GuardiansSpawned and not sh.Prompt.Enabled then
				-- ผู้เฝ้า 3 เวฟ (3 -> 5 -> 7 ตัว พักเวฟละ 5 วิ) ครบแล้วค่อยปลดผนึกได้
				local step = GuardianWaves.Step(sh, function(wave, count)
					return self:SpawnWave(sh, wave, count)
				end, function(text, kind)
					for _, pl in ipairs(playersNear(sh.Base, 170)) do
						self.ctx.Notify(pl, text, kind)
					end
				end)
				if step == "done" then
					sh.Prompt.Enabled = true
					self.ctx.Broadcast(string.format("The %s Shrine seal has weakened · Hold E", el), "Good")
				end
			end
			-- ไม่มีคนอยู่ใกล้นาน -> ผู้เฝ้ากลับไป (เกิดใหม่รอบหน้า)
			if sh.GuardiansSpawned and not p and not sh.Prompt.Enabled then
				sh.Away = (sh.Away or 0) + 1
				if sh.Away > 30 then
					for _, g in ipairs(sh.Guardians) do
						animals:Remove(g)
					end
					sh.GuardiansSpawned = false
					sh.Wave, sh.NextWaveAt = nil, nil -- กลับมาใหม่ = เริ่มเวฟ 1
					sh.Away = 0
				end
			else
				sh.Away = 0
			end
		end
	end
	for _, lair in pairs(self.lairs) do
		if lair.Cleared and lair.RespawnAt and os.clock() >= lair.RespawnAt then
			self:RespawnLair(lair)
		end
		if not lair.Cleared then
			local p = nearestPlayer(lair.Pos, 130)
			if p and not lair.Boss then
				self:WakeLair(lair, p)
			elseif lair.Boss then
				if lair.Boss.Dead then
					lair.Boss = nil
				elseif nearestPlayer(lair.Pos, 320) then
					lair.LastSeen = os.clock()
				elseif os.clock() - (lair.LastSeen or 0) > 40 then
					animals:Vanish(lair.Boss)
					lair.Boss = nil
					self.ctx.State:SetAttribute("BossId", "")
				end
			end
		end
	end
	-- บัฟวิญญาณไฟ: เผาศัตรูในเขตกองไฟ
	if self.ctx.State:GetAttribute("SpiritFire") then
		local safe = self.ctx.Services.CampService:SafeRadius()
		if safe > 0 then
			for _, a in ipairs(animals:InRadius(self.ctx.CampPosition, safe, true)) do
				self.ctx.Services.CombatService:DamageAnimal(a, 6, nil, { Silent = true, Burn = 4 })
			end
		end
	end
end

function SpiritService:Reset()
	local s = self.ctx.State
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		s:SetAttribute("Spirit" .. el, false)
		s:SetAttribute("Lair" .. el .. "Cleared", false)
	end
	s:SetAttribute("SpiritCount", 0)
	-- สร้างศาลเจ้าใหม่ (กรงกลับมา)
	local PropBuilder = require(ReplicatedStorage.Shared.PropBuilder)
	local sites = workspace.World.Sites
	for el, sh in pairs(self.shrines) do
		if sh.Pet then
			self.ctx.Services.AnimalService:Remove(sh.Pet) -- ลูกสัตว์ที่แคมป์ (มีคนขี่อยู่ = MountService คืนสภาพผู้ขี่เอง)
		end
		local sp = { Kind = "Shrine", Element = el, Position = sh.SitePos or sh.Base }
		sh.Model:Destroy()
		local m = PropBuilder.BuildShrine(sp, sites)
		self:SetupShrine(m)
	end
	for _, lair in pairs(self.lairs) do
		lair.Cleared = false
		lair.RespawnAt = nil
		s:SetAttribute("Lair" .. lair.Element .. "RespawnAt", nil)
		lair.Boss = nil
		local sigil = lair.Model:FindFirstChild("Sigil")
		if sigil then
			sigil.Color = require(ReplicatedStorage.Shared.PropBuilder).ElementColor[lair.Element]
			sigil.Transparency = 0.6
		end
	end
	-- ลบดวงวิญญาณที่เสาธง
	local camp = self.ctx.Services.CampService.campModel
	if camp then
		for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
			local orb = camp:FindFirstChild("SpiritOrb_" .. el)
			if orb then
				orb.Material = Enum.Material.Glass
				orb.Color = Color3.fromRGB(60, 60, 66)
				local l = orb:FindFirstChildOfClass("PointLight")
				if l then
					l:Destroy()
				end
			end
		end
	end
end

function SpiritService:Start(ctx)
	local s = ctx.State
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		s:SetAttribute("Spirit" .. el, false)
	end
	s:SetAttribute("SpiritCount", 0)
	for _, m in ipairs(CollectionService:GetTagged("Shrine")) do
		self:SetupShrine(m)
	end
	for _, m in ipairs(CollectionService:GetTagged("Lair")) do
		self:SetupLair(m)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(self.Tick, self)
			if not ok then
				warn("[AS] spirit tick", err)
			end
		end
	end)
end

return SpiritService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000078"><Properties><string name="Name">SurvivalService</string><ProtectedString name="Source"><![CDATA[--[[
	SurvivalService — ความหิว, เลือด, ล้ม/ช่วยเพื่อน, ตาย/เกิดใหม่, คลาส, กินอาหาร
	ดาเมจใส่ผู้เล่นทุกชนิดต้องผ่าน SurvivalService:Damage() (ระบบล้มจะได้ทำงาน)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local ArmorModels = require(ReplicatedStorage.Shared.ArmorModels)
local medBusy -- [player] = true ระหว่างพันแผล (ตั้งค่าที่ UseMedical)
local Classes = require(ReplicatedStorage.Shared.Classes)
local Analytics = require(script.Parent.Analytics)

local SurvivalService = {}
local state = {} -- [player] = { Downed, DownedAt, Dead, Burn, LastHit }

function SurvivalService:Init(ctx)
	self.ctx = ctx
end

-- ออร่าวิหาร (ได้จากการเคลียร์วิหารธาตุ อยู่ทั้งรอบ): ดิน = เลือดสูงสุด +15% · น้ำ = หิวช้าลง 15%
--   น้ำแข็ง = สตามิน่าลดช้าลง 15% (ฝั่ง client) · ไฟ = ดาเมจ +15%
local AURA_PERK = { HungerMult = { "Aura_Water", 0.85 }, DamageMult = { "Aura_Fire", 1.15 } }

function SurvivalService:Perk(player, name, default)
	local v = Classes.PerksFor(player:GetAttribute("Class") or "Survivor", player:GetAttribute("ClassLevel") or 1)[name]
	if v == nil then
		v = default
	end
	local aura = AURA_PERK[name]
	if aura and type(v) == "number" and player:GetAttribute(aura[1]) then
		v *= aura[2]
	end
	return v
end

-- เลือดสูงสุด = 100 + ทักษะคลาส + เกราะ (x1.15 ถ้ามีออร่าดิน)
function SurvivalService:MaxHealthFor(player)
	local hp = 100 + self:Perk(player, "MaxHealthBonus", 0) + self:ArmorHP(player)
	if player:GetAttribute("Aura_Earth") then
		hp *= 1.15
	end
	return math.floor(hp + 0.5)
end

local AURA_COLOR = {
	Earth = Color3.fromRGB(120, 245, 90), Water = Color3.fromRGB(70, 210, 255),
	Air = Color3.fromRGB(200, 235, 255), Fire = Color3.fromRGB(255, 120, 40),
}

-- ออร่าบนตัว (อ่อนๆ): ประกายสีธาตุลอยขึ้นรอบตัว + แสงจาง
local function attachAura(char, el)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or root:FindFirstChild("Aura_" .. el) then
		return
	end
	local col = AURA_COLOR[el]
	local att = Instance.new("Attachment")
	att.Name = "Aura_" .. el
	att.Parent = root
	local p = Instance.new("ParticleEmitter")
	p.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	p.Color = ColorSequence.new(col)
	p.LightEmission = 1
	p.LightInfluence = 0
	p.Rate = 12
	p.Lifetime = NumberRange.new(1, 1.6)
	p.Speed = NumberRange.new(0.6, 1.4)
	p.SpreadAngle = Vector2.new(180, 180)
	p.Acceleration = Vector3.new(0, 1.6, 0)
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	p.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	p.Shape = Enum.ParticleEmitterShape.Cylinder
	p.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	p.Parent = att
	local l = Instance.new("PointLight")
	l.Color = col
	l.Range = 9
	l.Brightness = 0.8
	l.Shadows = false
	l.Parent = att
end

-- ให้ออร่าวิหารธาตุ el (ซ้ำ = ไม่ได้เพิ่ม)
function SurvivalService:GiveAura(player, el)
	if player:GetAttribute("Aura_" .. el) then
		return false
	end
	player:SetAttribute("Aura_" .. el, true)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if el == "Earth" and hum then
		local frac = hum.Health / math.max(hum.MaxHealth, 1)
		hum.MaxHealth = self:MaxHealthFor(player)
		hum.Health = hum.MaxHealth * frac
	end
	if char then
		attachAura(char, el)
	end
	return true
end

local function humanoidOf(player)
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid"), char
end

function SurvivalService:IsAlive(player)
	local s = state[player]
	local hum = humanoidOf(player)
	return hum and hum.Health > 0 and s and not s.Dead and not s.Downed
end

-- จำนวนผู้เล่นในรอบ (aliveOnly = เฉพาะคนที่ยังไม่ตาย) ขั้นต่ำ 1 — ใช้ปรับความยากตามจำนวนคน
function SurvivalService:RunPlayerCount(aliveOnly)
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and not (aliveOnly and p:GetAttribute("Dead")) then
			n += 1
		end
	end
	return math.max(1, n)
end

function SurvivalService:IsDowned(player)
	return state[player] and state[player].Downed
end

---------------------------------------------------------------- ดาเมจ
function SurvivalService:Damage(player, amount, source, opts)
	local s = state[player]
	local hum, char = humanoidOf(player)
	if not (s and hum and char) or s.Dead or s.Downed or hum.Health <= 0 or player:GetAttribute("TestGod") then
		return
	end
	if char:FindFirstChildOfClass("ForceField") then
		return
	end
	amount *= self:Perk(player, "DamageTakenMult", 1)
	-- แวมไพร์: ค้างคาวที่ยังอยู่รับดาเมจแทน (SkillService:Absorb)
	local skill = self.ctx.Services.SkillService
	if skill then
		amount = skill:Absorb(player, amount)
		if amount <= 0 then
			return
		end
	end
	s.LastHit = os.clock()
	s.LastSource = source
	self.ctx.Remotes.Get("HitFx"):FireClient(player, "Hurt", { Amount = amount, Source = source })
	if hum.Health - amount <= 0 then
		hum.Health = 1
		self:Down(player, source)
	else
		hum.Health -= amount
	end
	if opts and opts.Knockback and char.PrimaryPart then
		self.ctx.Remotes.Get("HitFx"):FireClient(player, "Knockback", { Velocity = opts.Knockback })
	end
	if opts and opts.Burn then
		s.Burn = math.max(s.Burn or 0, opts.Burn)
	end
end

-- หัวอยู่ใต้ผิวน้ำ (terrain water) จริงไหม
function SurvivalService:HeadUnderwater(char)
	local head = char:FindFirstChild("Head")
	if not head then
		return false
	end
	local p = head.Position
	local layout = self.ctx.Layout
	if p.Y > (layout and layout.WaterLevel or Config.WaterLevel) - 0.3 then
		return false
	end
	local region = Region3.new(p - Vector3.new(0.5, 0.5, 0.5), p + Vector3.new(0.5, 0.5, 0.5)):ExpandToGrid(4)
	local ok, mats, occ = pcall(Workspace.Terrain.ReadVoxels, Workspace.Terrain, region, 4)
	return ok and mats[1] and mats[1][1] and mats[1][1][1] == Enum.Material.Water and occ[1][1][1] > 0.5 or false
end

function SurvivalService:Heal(player, amount)
	local hum = humanoidOf(player)
	if hum and hum.Health > 0 then
		hum.Health = math.min(hum.MaxHealth, hum.Health + amount)
	end
end

---------------------------------------------------------------- ล้ม / ช่วย / ตาย
-- ล้ม = นอนราบกับพื้น ขยับ/ตี/ใช้ของไม่ได้ นอนรอจนกว่าเพื่อนจะมาช่วย (ไม่มีจับเวลา) · ล้มหมดทั้งทีม = แพ้ (CheckWipe)
-- ไม่มีใครช่วยทัน = ตาย (ดูเพื่อนเล่นต่อจนจบรอบ ไม่เกิดใหม่) · ไม่เหลือใครยืนอยู่เลย = แพ้ทั้งทีม
function SurvivalService:IsIncapacitated(player)
	local s = state[player]
	return s ~= nil and (s.Downed or s.Dead)
end

-- ตรึงตัวนอนราบบนพื้น (เซิร์ฟเวอร์ตรึงเอง ทุกเครื่องเห็นตรงกัน)
local function layDown(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), params)
	local groundY = hit and hit.Position.Y or (root.Position.Y - 3)
	local _, yaw = root.CFrame:ToOrientation()
	root.AssemblyLinearVelocity = Vector3.zero
	root.Anchored = true
	root.CFrame = CFrame.new(root.Position.X, groundY + 1, root.Position.Z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-90), 0, 0)
end

local function standUp(player, char)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local _, yaw = root.CFrame:ToOrientation()
	root.CFrame = CFrame.new(root.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0)
	root.Anchored = false
	pcall(function()
		root:SetNetworkOwner(player)
	end)
end

function SurvivalService:Down(player, source)
	local s = state[player]
	local hum, char = humanoidOf(player)
	if not (s and hum and char) or s.Downed or s.Dead then
		return
	end
	-- ล็อบบี้ (ไม่ได้อยู่ในรอบ): ไม่มีระบบล้ม แค่ฟื้นเลือด
	if not player:GetAttribute("InRun") then
		hum.Health = hum.MaxHealth
		return
	end
	s.Downed = true
	s.DownedAt = os.clock()
	s.DownSource = source or s.LastSource
	player:SetAttribute("Downed", true)
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum:UnequipTools()
	layDown(char)
	self.ctx.Broadcast(string.format("%s is down! Go help, quick", player.DisplayName), "Danger", player) -- คนล้มเห็นข้อความติดจอแทน
	self.ctx.Remotes.Get("Cinematic"):FireClient(player, "Downed", {})
	-- ปุ่มช่วยเพื่อน
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Revive"
		prompt.ActionText = "Revive (uses a bandage)"
		prompt.ObjectText = player.DisplayName
		prompt.HoldDuration = Config.ReviveTime
		prompt.MaxActivationDistance = Config.ReviveRange
		prompt.RequiresLineOfSight = false
		prompt.Parent = root
		-- กดค้างช่วยเพื่อน = ท่าก้มพันแผล (MedAnim ฝั่ง client) · ไม่มีหลอดของเรา (ปุ่มมีวงรอของมันเอง)
		prompt.PromptButtonHoldBegan:Connect(function(helper)
			if helper ~= player and self:IsAlive(helper) then
				self:SetMedPose(helper, "Revive", 0, root.Position)
			end
		end)
		prompt.PromptButtonHoldEnded:Connect(function(helper)
			if not medBusy[helper] then
				self:SetMedPose(helper, nil)
			end
		end)
		prompt.Triggered:Connect(function(helper)
			if not medBusy[helper] then
				self:SetMedPose(helper, nil)
			end
			if helper == player or not self:IsAlive(helper) or not self:IsDowned(player) then
				return
			end
			local inv = self.ctx.Services.InventoryService
			local used
			if inv:Remove(helper, "Bandage", 1) then
				used = "Bandage"
			elseif inv:Remove(helper, "Medkit", 1) then
				used = "Medkit"
			end
			if not used then
				self.ctx.Notify(helper, "You need a bandage or a first aid kit", "Error")
				return
			end
			-- ทักษะหมอ (HealMult) แรงขึ้นทั้งผ้าพันแผลและชุดปฐมพยาบาล (เดิมวงเล็บผิด: ชุดปฐมพยาบาลไม่ได้โบนัส)
			self:Revive(player, math.min(1, (used == "Medkit" and 0.8 or 0.4) * self:Perk(helper, "HealMult", 1)))
			if self.ctx.Services.QuestService then
				self.ctx.Services.QuestService:Progress(helper, "Revive", 1)
			end
			self.ctx.Broadcast(string.format("%s revived %s just in time", helper.DisplayName, player.DisplayName), "Good")
		end)
	end
	self:CheckWipe()
end

function SurvivalService:Revive(player, frac)
	local s = state[player]
	local hum, char = humanoidOf(player)
	if not (s and hum) or not s.Downed then
		return
	end
	s.Downed = false
	player:SetAttribute("Downed", false)
	hum.Health = hum.MaxHealth * math.clamp(frac or 0.4, 0.1, 1)
	hum.WalkSpeed = Config.BaseWalkSpeed * self:Perk(player, "SpeedMult", 1)
	hum.JumpPower = 50
	hum.AutoRotate = true
	local prompt = char and char:FindFirstChild("Revive", true)
	if prompt then
		prompt:Destroy()
	end
	standUp(player, char)
	self.ctx.Remotes.Get("Cinematic"):FireClient(player, "Revived", {})
end

-- ทีมล้มหมด: กด "กลับล็อบบี้" (ไม่ชุบ) · ทุกคนในรอบกดครบ = จบรอบทันที ไม่ต้องรอนับถอยหลัง
function SurvivalService:SkipWipe(player)
	if not (self.wipeUntil and self.wipeSkip) or not player:GetAttribute("InRun") then
		return
	end
	self.wipeSkip[player] = true
	local team, voted = 0, 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") then
			team += 1
			if self.wipeSkip[p] then
				voted += 1
			end
		end
	end
	self.ctx.State:SetAttribute("WipeSkips", voted)
	if voted >= team then
		self.wipeUntil = os.clock() -- ครบทุกคน: ตัวรอในลูปจบรอบเลย
	end
end

-- ล้มหรือตายอยู่ในรอบ (ชุบได้ตอนทีมล้มหมด)
function SurvivalService:IsFallen(player)
	local s = state[player]
	return s ~= nil and player:GetAttribute("InRun") == true and (s.Downed or s.Dead) == true
end

-- ชุบด้วย Robux: ล้มอยู่ = ลุกเลือดเต็ม · ตายแล้ว = เกิดใหม่ที่แคมป์ (ยังอยู่ในรอบ)
function SurvivalService:ReviveAny(player)
	local s = state[player]
	if not s then
		return
	end
	if s.Downed then
		self:Revive(player, 1)
	elseif s.Dead and player:GetAttribute("InRun") then
		self:Spawn(player)
	end
end

function SurvivalService:Die(player)
	local s = state[player]
	local hum, char = humanoidOf(player)
	if not s or s.Dead then
		return
	end
	s.Downed = false
	s.Dead = true
	player:SetAttribute("Downed", false)
	player:SetAttribute("Dead", true)
	local prompt = char and char:FindFirstChild("Revive", true)
	if prompt then
		prompt:Destroy()
	end
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = false
	end
	if hum then
		hum.Health = 0
	end
	-- ล็อบบี้: เกิดใหม่ทันที
	if not player:GetAttribute("InRun") then
		task.delay(3, function()
			if player.Parent and s.Dead then
				self:Spawn(player)
			end
		end)
		return
	end
	-- ในรอบ: ไม่เกิดใหม่ — ดูเพื่อนเล่นต่อ (หรือกดกลับล็อบบี้เอง)
	local alive = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("InRun") and self:IsAlive(p) then
			alive += 1
		end
	end
	self.ctx.Remotes.Get("Cinematic"):FireClient(player, "Died", { Night = self.ctx.State:GetAttribute("Night"), Alive = alive })
	self.ctx.Broadcast(string.format("%s has died", player.DisplayName), "Danger")
	Analytics.Custom(player, "PlayerDied", self.ctx.State:GetAttribute("Night") or 1, {
		tostring(s.DownSource or s.LastSource or "Unknown"), player:GetAttribute("Class") or "Survivor",
	})
	s.DownSource = nil
	self:CheckWipe()
end

-- ไม่เหลือใครยืนอยู่ในรอบเลย (ล้ม/ตายหมด) = แพ้ทั้งทีม (ทุกช่วงเวลา ไม่ใช่แค่กลางคืน)
function SurvivalService:CheckWipe()
	local director = self.ctx.Services.DirectorService
	if not (director and director:IsRunning()) or self.ctx.State:GetAttribute("Phase") == "Ended" then
		return
	end
	local function standing()
		local count, alive = 0, 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("InRun") then
				count += 1
				if self:IsAlive(p) then
					alive += 1
				end
			end
		end
		return count, alive
	end
	local count, alive = standing()
	if alive > 0 then
		return
	end
	if count == 0 then
		-- ทุกคนออกจากรอบไปแล้ว · ออกเกมกลางรอบ (ไม่ได้ตาย) = เก็บรอบไว้ให้กลับมาเล่นต่อ (RejoinService) ไม่นับว่าแพ้
		local rejoin = self.ctx.Services.RejoinService
		if rejoin and rejoin.held then
			return
		end
		director:GameOver()
		return
	end
	-- มีสินค้าคืนชีพ/ตั๋วคืนชีพ: รอ Config.WipeGrace วิ ให้กดคืนชีพก่อนแพ้ (ไม่มี = 2 วิเหมือนเดิม)
	if self.wipeUntil then
		return
	end
	local grace = 2
	if (Config.ReviveProductId or 0) > 0 then
		grace = Config.WipeGrace or 15
	else
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("InRun") and (p:GetAttribute("ReviveTokens") or 0) > 0 and self:IsDowned(p) then
				grace = Config.WipeGrace or 15
			end
		end
	end
	self.wipeUntil = os.clock() + grace
	self.wipeSkip = {}
	self.ctx.State:SetAttribute("WipeSkips", 0)
	if grace > 2 then
		self.ctx.State:SetAttribute("WipeAt", Workspace:GetServerTimeNow() + grace)
	end
	task.spawn(function()
		while os.clock() < self.wipeUntil do
			task.wait(0.25)
			local c2, a2 = standing()
			if a2 > 0 then
				break -- มีคนลุกขึ้นแล้ว
			end
		end
		self.wipeUntil = nil
		self.wipeSkip = nil
		self.ctx.State:SetAttribute("WipeAt", nil)
		self.ctx.State:SetAttribute("WipeSkips", nil)
		local c2, a2 = standing()
		if a2 == 0 and (c2 > 0 or count > 0) then
			director:GameOver()
		end
	end)
end

---------------------------------------------------------------- เกิด
function SurvivalService:Spawn(player)
	local s = state[player] or {}
	state[player] = s
	s.Dead = false
	s.Downed = false
	s.Burn = 0
	player:SetAttribute("Dead", false)
	player:SetAttribute("Downed", false)
	player:LoadCharacter()
end

function SurvivalService:SpawnPoint(player)
	if not player:GetAttribute("InRun") then
		return self.ctx.Services.LobbyService:SpawnPoint()
	end
	local camp = self.ctx.CampPosition
	local a = math.random() * math.pi * 2
	return camp + Vector3.new(math.cos(a) * 14, 4, math.sin(a) * 14)
end

function SurvivalService:OnCharacter(player, char)
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = self:MaxHealthFor(player)
	hum.Health = hum.MaxHealth
	task.delay(0.5, function()
		for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
			if char.Parent and player:GetAttribute("Aura_" .. el) then
				attachAura(char, el)
			end
		end
	end)
	-- เกราะที่สวมอยู่ (คราฟต์ในรอบนี้) -> ใส่โมเดลกลับหลังเกิดใหม่
	local armor = player:GetAttribute("Armor")
	if armor and player:GetAttribute("InRun") then
		task.delay(0.5, function()
			if char.Parent and player:GetAttribute("Armor") == armor then
				ArmorModels.Attach(char, armor)
			end
		end)
	end
	hum.WalkSpeed = Config.BaseWalkSpeed * self:Perk(player, "SpeedMult", 1)
	local pos = self:SpawnPoint(player)
	-- ล็อบบี้อยู่ไกลจากแมพมาก (StreamingEnabled): ตรึงตัวไว้จนพื้นตรงจุดเกิดโหลดถึงเครื่องผู้เล่น ไม่งั้นตกทะลุโลก
	root.Anchored = true
	task.defer(function()
		local look = player:GetAttribute("InRun") and self.ctx.CampPosition + Vector3.new(0, 4, 0) or pos + Vector3.new(0, 0, -10)
		root.CFrame = CFrame.new(pos, Vector3.new(look.X, pos.Y, look.Z))
		pcall(function()
			player:RequestStreamAroundAsync(pos, 12)
		end)
		task.wait(1.5)
		if root.Parent then
			root.Anchored = false
		end
	end)
	-- กันตกทะลุโลก (พื้นยังโหลดไม่ทัน): ร่วงต่ำเกินไป -> ดึงกลับจุดเกิดแล้วตรึงรอโหลด
	task.spawn(function()
		while char.Parent and root.Parent do
			task.wait(1)
			if player:GetAttribute("InRun") and root.Position.Y < Config.WaterLevel - 150 then
				local back = self:SpawnPoint(player)
				root.Anchored = true
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = CFrame.new(back)
				pcall(function()
					player:RequestStreamAroundAsync(back, 12)
				end)
				task.wait(1.5)
				root.Anchored = false
			end
		end
	end)
	local ff = Instance.new("ForceField")
	ff.Visible = true
	ff.Parent = char
	task.delay(4, function()
		ff:Destroy()
	end)
	hum.Died:Connect(function()
		local s = state[player]
		if s and not s.Dead then
			self:Die(player)
		end
	end)
	if not player:GetAttribute("Hunger") then
		player:SetAttribute("Hunger", Config.HungerMax)
	end
	player:SetAttribute("Hunger", math.max(player:GetAttribute("Hunger"), Config.HungerMax * 0.6))
	self.ctx.Services.InventoryService:RestoreTools(player)
end

function SurvivalService:OnClassChosen(player, classId)
	local c = Classes.Data[classId]
	if not c then
		return
	end
	local hum = humanoidOf(player)
	if hum then
		hum.WalkSpeed = Config.BaseWalkSpeed * self:Perk(player, "SpeedMult", 1)
		-- เลือดสูงสุดตามทักษะ (คงสัดส่วนเลือดเดิม)
		local frac = hum.Health / math.max(hum.MaxHealth, 1)
		hum.MaxHealth = self:MaxHealthFor(player)
		hum.Health = hum.MaxHealth * frac
	end
	player:SetAttribute("StaminaMult", self:Perk(player, "StaminaMult", 1))
end

-- ของเริ่มต้นของคลาส (ให้ตอนออกเดินทางจากล็อบบี้)
function SurvivalService:GiveStartItems(player)
	if player:GetAttribute("StartItemsGiven") then
		return
	end
	local c = Classes.Data[player:GetAttribute("Class") or "Survivor"]
	if not c then
		return
	end
	player:SetAttribute("StartItemsGiven", true)
	Analytics.Custom(player, "ClassUsed", player:GetAttribute("ClassLevel") or 1, { player:GetAttribute("Class") or "Survivor" })
	player:SetAttribute("Hunger", Config.HungerMax)
	local inv = self.ctx.Services.InventoryService
	-- ทุกคลาส: ขวาน + กระสอบเริ่มต้นเสมอ (ช่อง 1 = ขวาน, ช่อง 2 = กระสอบ) แล้วถือขวานในมือทันที
	local ids = {}
	for id in pairs(c.StartItems) do
		table.insert(ids, id)
	end
	local hasAxe = false
	for _, id in ipairs(ids) do
		local t = Items.Tools[id]
		hasAxe = hasAxe or (t ~= nil and t.Kind == "Axe")
	end
	if not hasAxe then
		table.insert(ids, "OldAxe")
	end
	table.insert(ids, "OldSack")
	table.sort(ids, function(a, b)
		local oa, ob = inv.ToolOrder(a), inv.ToolOrder(b)
		if oa ~= ob then
			return oa < ob
		end
		return a < b
	end)
	for _, id in ipairs(ids) do
		local item = Items.Data[id]
		if item and item.Category == "Armor" then
			self:EquipArmor(player, id) -- เกราะเริ่มต้น: สวมเลย (ไม่เข้ากระเป๋า)
		else
			inv:Add(player, id, c.StartItems[id] or 1, true)
		end
	end
end

-- ถือขวาน (อาวุธหลัก) ในมือตอนเกิด/ออกเดินทาง
function SurvivalService:EquipStartWeapon(player)
	if not player:GetAttribute("InRun") then
		return
	end
	local inv = self.ctx.Services.InventoryService
	local char = player.Character
	if char and char:FindFirstChildOfClass("Tool") then
		return
	end
	local id = inv:BestAxe(player)
	if id then
		inv:EquipItem(player, id)
	end
end

-- เริ่มรอบใหม่ (หลังจบเกม) -> กลับล็อบบี้
-- เลือดที่เกราะเพิ่มให้
function SurvivalService:ArmorHP(player)
	local item = Items.Data[player:GetAttribute("Armor") or ""]
	return item and item.ArmorHP or 0
end

-- สวมเกราะ: เพิ่มเลือดสูงสุด (เลือดปัจจุบันเพิ่มเท่ากัน) + ใส่โมเดลบนตัว · id = nil ถอด
function SurvivalService:EquipArmor(player, id)
	local hum, char = humanoidOf(player)
	local before = self:MaxHealthFor(player)
	player:SetAttribute("Armor", id)
	local diff = self:MaxHealthFor(player) - before
	if hum then
		hum.MaxHealth = math.max(1, hum.MaxHealth + diff)
		if hum.Health > 0 then
			hum.Health = math.clamp(hum.Health + math.max(diff, 0), 1, hum.MaxHealth)
		end
	end
	if char then
		if id then
			ArmorModels.Attach(char, id)
		else
			ArmorModels.Remove(char)
		end
	end
end

function SurvivalService:ResetPlayer(player)
	player:SetAttribute("Armor", nil)
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		player:SetAttribute("Aura_" .. el, nil)
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for _, d in ipairs(root and root:GetChildren() or {}) do
		if d.Name:sub(1, 5) == "Aura_" then
			d:Destroy()
		end
	end
	player:SetAttribute("InRun", false)
	player:SetAttribute("StartItemsGiven", false)
	player:SetAttribute("Hunger", Config.HungerMax)
	player:SetAttribute("FullUntil", nil)
	self.ctx.Services.InventoryService:Reset(player)
	self:OnClassChosen(player, player:GetAttribute("Class") or "Survivor")
	self:Spawn(player)
end

---------------------------------------------------------------- กิน / ใช้ยา
function SurvivalService:UseItem(player, id)
	local item = Items.Data[id]
	if not item or not self:IsAlive(player) then
		return
	end
	local inv = self.ctx.Services.InventoryService
	if item.Category == "Food" then
		if not inv:Remove(player, id, 1) then
			return
		end
		local h = player:GetAttribute("Hunger") or 0
		player:SetAttribute("Hunger", math.min(Config.HungerMax, h + item.Food))
		if item.Heal and item.Heal > 0 then
			self:Heal(player, item.Heal * self:Perk(player, "HealMult", 1)) -- นักหาของป่า: อาหารฟื้นเลือดแรงขึ้นด้วย
		elseif item.Heal and item.Heal < 0 then
			self:Damage(player, -item.Heal, "Food")
		end
		if item.Stamina then
			player:SetAttribute("StaminaRefill", (player:GetAttribute("StaminaRefill") or 0) + 1) -- client เติมหลอดเต็ม
		end
		if item.Full then
			player:SetAttribute("FullUntil", Workspace:GetServerTimeNow() + item.Full.Time)
			player:SetAttribute("FullMult", item.Full.Mult)
		end
		self.ctx.Remotes.Get("HitFx"):FireClient(player, "Eat", { Item = id })
	elseif item.Category == "Medical" then
		local hum = humanoidOf(player)
		if hum and hum.Health < hum.MaxHealth and inv:Remove(player, id, 1) then
			self:Heal(player, item.Heal * self:Perk(player, "HealMult", 1))
			self.ctx.Remotes.Get("HitFx"):FireClient(player, "Heal", { Item = id })
		end
	end
end

local medCool = setmetatable({}, { __mode = "k" })
-- เวลาใช้ยา (วินาที): ตัวเอง / ช่วยเพื่อนที่ล้ม
local MED_TIME = { Bandage = 1.6, Medkit = 2.4, HerbSalve = 1.2 }
local MED_REVIVE_TIME = { Bandage = 2.2, Medkit = 2.6 }
-- [player] = true ระหว่างกำลังพันแผล (กดซ้ำไม่เริ่มใหม่)
medBusy = setmetatable({}, { __mode = "k" })

-- ท่าใช้ยา (MedAnim ฝั่ง client อ่าน attribute): pose = "Self" / "Revive" / nil (เลิก)
--   time > 0 = แสดงหลอดรอบนจอผู้ใช้ · at = จุดที่ก้มไปหา (หันตัวเข้าหาเพื่อน)
function SurvivalService:SetMedPose(player, pose, time, at, item)
	player:SetAttribute("MedUse", pose)
	player:SetAttribute("MedItem", pose and item or nil)
	player:SetAttribute("MedTime", pose and time or nil)
	player:SetAttribute("MedStart", pose and Workspace:GetServerTimeNow() or nil)
	local _, char = humanoidOf(player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if pose and at and root then
		local flat = Vector3.new(at.X, root.Position.Y, at.Z)
		if (flat - root.Position).Magnitude > 0.5 then
			char:PivotTo(CFrame.lookAt(root.Position, flat))
		end
	end
end

-- ถือผ้าพันแผล/ชุดปฐมพยาบาลแล้วคลิก: มีเพื่อนล้มอยู่ใกล้ -> ช่วยชีวิตเพื่อน · ไม่มี -> ฟื้นเลือดตัวเอง
--   ต้องยืนพันแผลจนหลอดเต็ม (ท่าพันแผล) · ขยับตัว/โดนตี/เก็บของลง/เพื่อนหาย = ยกเลิก ไม่เสียของ
function SurvivalService:UseMedical(player, id)
	local item = Items.Data[id]
	local hum, char = humanoidOf(player)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (item and item.Category == "Medical" and hum and root) or not self:IsAlive(player) or medBusy[player] then
		return
	end
	local inv = self.ctx.Services.InventoryService
	if inv:Count(player, id) <= 0 then
		return
	end
	if os.clock() - (medCool[player] or 0) < 0.6 then
		return
	end
	medCool[player] = os.clock()
	local pos = root.Position
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local _, pc = humanoidOf(p)
		if item.Revive and p ~= player and pc and self:IsDowned(p) then
			local d = (pc:GetPivot().Position - pos).Magnitude
			if d <= Config.ReviveRange + 4 and (not bestD or d < bestD) then
				best, bestD = p, d
			end
		end
	end
	if not best and hum.Health >= hum.MaxHealth - 0.5 then
		self.ctx.Notify(player, "❤ HP is full — save your " .. item.Thai .. " for reviving downed teammates", "Info")
		return
	end
	local dur = (best and MED_REVIVE_TIME[id] or MED_TIME[id]) or 2
	local bc = best and select(2, humanoidOf(best)) -- รักษาตัวเอง (ไม่มีเพื่อนล้ม) = best เป็น nil
	medBusy[player] = true
	self:SetMedPose(player, best and "Revive" or "Self", dur, bc and bc:GetPivot().Position, id)
	local startPos = root.Position
	local lastHp = hum.Health
	local function stop(reason)
		medBusy[player] = nil
		if player:GetAttribute("MedUse") then
			self:SetMedPose(player, nil)
		end
		if reason then
			self.ctx.Notify(player, "✖ Stopped bandaging — " .. reason, "Warn")
		end
	end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur do
			task.wait(0.1)
			if not (char.Parent and player.Parent) or not self:IsAlive(player) or self:IsIncapacitated(player) then
				return stop()
			end
			local tool = char:FindFirstChildOfClass("Tool")
			if not (tool and tool:GetAttribute("MedKind") == id) then
				return stop("Put away " .. item.Thai .. "")
			end
			if hum.Health < lastHp - 0.5 then
				return stop("Got hit")
			end
			lastHp = math.max(lastHp, hum.Health)
			if ((root.Position - startPos) * Vector3.new(1, 0, 1)).Magnitude > 2.5 then
				return stop("Moved (you must stand still while bandaging)")
			end
			if best then
				local _, pc = humanoidOf(best)
				if not (pc and self:IsDowned(best)) or (pc:GetPivot().Position - root.Position).Magnitude > Config.ReviveRange + 6 then
					return stop(self:IsDowned(best) and "Too far from your teammate" or nil)
				end
			end
		end
		stop()
		if best then
			if not self:IsDowned(best) or not inv:Remove(player, id, 1) then
				return
			end
			self:Revive(best, math.min(1, (id == "Medkit" and 0.8 or 0.4) * self:Perk(player, "HealMult", 1)))
			if self.ctx.Services.QuestService then
				self.ctx.Services.QuestService:Progress(player, "Revive", 1)
			end
			self.ctx.Remotes.Get("HitFx"):FireClient(player, "Heal", { Item = id })
			self.ctx.Broadcast(string.format("%s revived %s just in time", player.DisplayName, best.DisplayName), "Good")
			return
		end
		if inv:Remove(player, id, 1) then
			self:Heal(player, item.Heal * self:Perk(player, "HealMult", 1))
			self.ctx.Remotes.Get("HitFx"):FireClient(player, "Heal", { Item = id })
		end
	end)
end

---------------------------------------------------------------- loop
function SurvivalService:Start(ctx)
	Players.CharacterAutoLoads = false
	ctx.Remotes.Get("WipeSkip").OnServerEvent:Connect(function(player)
		self:SkipWipe(player)
	end)
	ctx.Remotes.Get("UseItem").OnServerEvent:Connect(function(player, id)
		if type(id) == "string" then
			self:UseItem(player, id)
		end
	end)
	local function onPlayer(player)
		state[player] = { Dead = false, Downed = false, Burn = 0 }
		ctx.Services.DataService:Load(player)
		player:SetAttribute("Hunger", Config.HungerMax)
		player.CharacterAdded:Connect(function(char)
			self:OnCharacter(player, char)
		end)
		-- เกิดในล็อบบี้ทันที (แมพสร้างเสร็จเมื่อไรค่อยเข้าประตู)
		player:SetAttribute("InRun", false)
		task.spawn(function()
			self:OnClassChosen(player, player:GetAttribute("Class") or "Survivor")
			self:Spawn(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		state[p] = nil
		-- คนในรอบออกจากเกม: เช็กว่ายังเหลือคนยืนอยู่ไหม
		if p:GetAttribute("InRun") then
			task.defer(function()
				self:CheckWipe()
			end)
		end
	end)

	-- ความหิว / ไฟไหม้ / หมดเวลาล้ม
	task.spawn(function()
		local dt = 0.5
		local loops = 0
		while true do
			task.wait(dt)
			loops += 1
			for _, player in ipairs(Players:GetPlayers()) do
				local s = state[player]
				local hum, char = humanoidOf(player)
				-- ตำแหน่งคร่าวๆ ให้เพื่อนร่วมทีมเห็นบนเข็มทิศ (ตัวละครไกลๆ อาจไม่ได้โหลดถึงเครื่องเพื่อน)
				if loops % 2 == 0 and char and player:GetAttribute("InRun") then
					local pv = char:GetPivot().Position
					player:SetAttribute("RunPos", Vector3.new(math.floor(pv.X), math.floor(pv.Y), math.floor(pv.Z)))
				end
				if s and hum and char and hum.Health > 0 and not s.Dead and player:GetAttribute("InRun") then
					if not s.Downed then
						-- หิว (นอกเขตกองไฟที่มองไม่เห็น = หิวเร็วขึ้น)
						local mult = self:Perk(player, "HungerMult", 1)
						if (player:GetAttribute("FullUntil") or 0) > Workspace:GetServerTimeNow() then
							mult *= player:GetAttribute("FullMult") or 1 -- พายเบอร์รี่: หิวช้าลงชั่วคราว
						end
						local h = (player:GetAttribute("Hunger") or 0) - Config.HungerDrainPerSec * dt * mult
						player:SetAttribute("Hunger", math.max(0, h))
						if h <= 0 then
							self:Damage(player, Config.StarveDamagePerSec * dt, "Hunger")
						end
						if (s.Burn or 0) > 0 then
							self:Damage(player, s.Burn * dt, "Burn")
							s.Burn = math.max(0, s.Burn - 2 * dt)
						end
						-- ดำน้ำ: หัวจมน้ำ = ลมหายใจลด · หมด = จมน้ำเสียเลือด · โผล่พ้นน้ำ = เติมคืน
						local maxAir = Config.BreathMax * self:Perk(player, "BreathMult", 1)
						local air = s.Air or maxAir
						if self:HeadUnderwater(char) then
							air = math.max(0, air - dt)
							if air <= 0 then
								self:Damage(player, Config.DrownDamagePerSec * dt, "Drown")
							end
						else
							air = math.min(maxAir, air + Config.BreathRefillPerSec * dt)
						end
						if air ~= s.Air then
							s.Air = air
							player:SetAttribute("Air", air)
							player:SetAttribute("AirMax", maxAir)
						end
						-- ฟื้นเลือดช้าๆ ตอนอิ่ม
						if h > Config.HungerMax * 0.6 and os.clock() - (s.LastHit or 0) > 8 then
							self:Heal(player, 0.6 * dt)
						end
						-- ทักษะฟื้นเลือด (ทำงานตลอด ถ้าไม่อดอาหาร)
						local regen = self:Perk(player, "Regen", 0)
						if regen > 0 and h > 0 then
							self:Heal(player, regen * dt)
						end
						-- ฟื้นเลือดเป็น % ของเลือดสูงสุด (พงไพร: 3% ทุก 2 วิ = 1.5%/วิ)
						local regenPct = self:Perk(player, "RegenPct", 0)
						if regenPct > 0 and h > 0 then
							self:Heal(player, hum.MaxHealth * regenPct * dt)
						end
						-- กลับมานั่งข้างกองไฟ (ในเขตไฟที่ติดอยู่) = ฟื้นเลือดเร็ว ~3/วิ (เต็มหลอดใน ~30 วิ) · โดนตีอยู่ไม่ฟื้น
						local camp = self.ctx.Services.CampService
						local fire = camp and camp:FirePosition()
						if fire and camp:IsLit() and os.clock() - (s.LastHit or 0) > 3 and hum.Health < hum.MaxHealth
							and ((char:GetPivot().Position - fire) * Vector3.new(1, 0, 1)).Magnitude <= camp:SafeRadius() then
							self:Heal(player, 3 * dt)
						end
					end
				end
			end
		end
	end)
end

return SurvivalService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000079"><Properties><string name="Name">ToolFactory</string><ProtectedString name="Source"><![CDATA[--[[
	ToolFactory — สร้าง Tool (อาวุธ/เครื่องมือ) พร้อมหน้าตา
	ทุก Tool มี Handle + attribute ItemId; ฝั่ง client กดตี -> Remotes.Attack
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Items = require(ReplicatedStorage.Shared.Items)
local ItemThumbs = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ItemThumbs"))
local MeshProps = require(ReplicatedStorage.Shared.MeshProps)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
-- อาวุธ/เครื่องมือที่ใช้โมเดลจริง (ที่เหลือปั้นเอง: คบเพลิง หอก ตรีศูล)
local MESH_TOOLS = { OldAxe = true, StoneAxe = true, IronAxe = true, Pickaxe = true, Bow = true, GaleBow = true, TerraHammer = true, EmberBlade = true, FourfoldBlade = true }
-- ด้าน "หน้า" ของโมเดลจริงแต่ละชิ้น (แกนของชิ้น Handle) = ด้านที่ต้องหันออกไปข้างหน้าตัวละคร (ทิศที่ฟัน/ยิง)
-- วัดจากเมชจริง (PropMeshData): ทุกชิ้นตั้งตามแกน +Y (หัวอยู่บน) แบนตามแกน Z · ใบ/หัวอยู่ด้าน +X หรือ -X
--   ขวานเก่า: ใบด้าน +X · ขวานหิน: ใบด้าน -X (กลับข้างกัน!) · ธนู: หลังคันโค้งด้าน +X (สายอยู่ -X)
--   ขวานเหล็ก/อีเตอร์/ค้อน/ดาบ: สมมาตรซ้ายขวา -> ใช้ +X (คมหันหน้า ด้านแบนหันข้าง)
-- ⚠ ดาบทั้งสองเล่มโมเดลกลับหัว (ด้ามอยู่บน ใบดาบชี้ลง -Y) -> MESH_HEAD บอกว่า "หัว" (ใบ) อยู่ทาง -Y
local MESH_HEAD = {
	EmberBlade = Vector3.new(0, -1, 0),
	FourfoldBlade = Vector3.new(0, -1, 0),
}
local MESH_FRONT = {
	OldAxe = Vector3.new(1, 0, 0),
	StoneAxe = Vector3.new(-1, 0, 0),
	IronAxe = Vector3.new(1, 0, 0),
	Pickaxe = Vector3.new(1, 0, 0),
	Bow = Vector3.new(1, 0, 0),
	GaleBow = Vector3.new(1, 0, 0),
	TerraHammer = Vector3.new(1, 0, 0),
	EmberBlade = Vector3.new(1, 0, 0),
	FourfoldBlade = Vector3.new(1, 0, 0),
}

-- อาวุธจาก Roblox Creator Store (assets/rbxm/Weapons/<ItemId>.rbxmx -> ReplicatedStorage.Assets.Weapons)
-- Length = ความยาวในมือ (stud) · Head/Front = แกนของชิ้น Handle (วัดจากโมเดลจริง) ที่เป็นหัว/คม · ไม่มี = เดาจากรูปทรง
-- Aura = ออร่าธาตุรอบอาวุธ: "Earth" | "Water" | "Wind" | "Fire" | "Rainbow" | "Shadow" (เปลวอนิเมะ + ประกาย + เส้นแสงตามรอยฟัน)
local STORE_WEAPONS = {
	OldAxe = { Length = 3.2, Front = Vector3.new(0, 0, -1) }, StoneAxe = { Length = 3.2 }, IronAxe = { Length = 3.6 }, Pickaxe = { Length = 3.4, Head = Vector3.new(0, 1, 0) },
	Torch = { Length = 3, Fire = true }, Spear = { Length = 6 },
	Bow = { Length = 4.2, Front = Vector3.new(0, 0, 1), Flip = true },
	TerraHammer = { Length = 4.2, Aura = "Earth" },
	TidalTrident = { Length = 5.6, Aura = "Water" },
	GaleBow = { Length = 4.4, Aura = "Wind" },
	EmberBlade = { Length = 4.6, Head = Vector3.new(0, 0, -1), Flip = true, Aura = "Fire" },
	FourfoldBlade = { Length = 4.8, Front = Vector3.new(0, 0, 1), Aura = "Rainbow" },
	EmberStaff = { Length = 5.4, Head = Vector3.new(0, 1, 0), TipFire = true }, -- Store "Fire Staff" (52093942) ตั้งตรงแกน +Y หัวไฟอยู่บน
	-- อาวุธทั่วไปชุดใหม่ (Creator Store) · HeadUp = โมเดลต้นฉบับตั้งตรงหัวอยู่บน -> วัดทิศหัวจากด้านบนของโลก
	--   (ชิ้นส่วนในไฟล์หมุนแกนไว้ไม่เหมือนกัน: บอกแกน +Y ของชิ้นตรงๆ แล้วดาบ/คทาออกมานอน)
	--   Head = ตั้งแกนหัวเอง (ชิ้นที่แกนในไฟล์ตรงกับรูปทรง) · ตรวจด้วย build_rbxlx.py --chestprobe (ภาพ wpn_*)
	Dagger = { Length = 2.7, Head = Vector3.new(0, 1, 0) },
	SpikedClub = { Length = 3.6, HeadUp = true },
	IronSword = { Length = 4.2, Head = Vector3.new(0, 1, 0) },
	Mace = { Length = 3.9, HeadUp = true },
	BattleAxe = { Length = 4.4, Head = Vector3.new(0, 1, 0) },
	-- หน้าไม้: ถือแนวนอนแบบปืน ด้ามในมือ คันธนูอยู่ปลายหน้า (ด้ามยาวแกน Z ของชิ้น · ลูกศรอยู่ +Y = ด้านบน) · Grip = ท่าจับตายตัว
	Crossbow = { Length = 3.4, Grip = (CFrame.new(0, -0.25, -0.5) * CFrame.Angles(0, math.pi, 0)):Inverse() },
	Katana = { Length = 4.8, HeadUp = true },
	WarHammer = { Length = 4.6, Head = Vector3.new(0, 1, 0) },
	-- เคียว: ด้ามตั้ง ใบอยู่บนหันไปข้างหน้า · เลื่อนไปหน้า 1.8 ให้ด้ามอยู่ในมือพอดี (ตรวจด้วย --gripprobe)
	Scythe = { Length = 5.6, Head = Vector3.new(0, 1, 0), GripTurn = CFrame.new(0, 0, 1.8) },
	-- อาวุธประจำคลาส 5 ดาว (Import 3D จาก 3D Model/weapon: ตั้งตรง หัวอยู่บน +Y) · ยังไม่ Import = ด้ามไม้สำรอง
	ArcaneStaff = { Length = 5.4, Head = Vector3.new(0, 1, 0), Aura = "Shadow" },
	BloodScythe = { Length = 5.6, Head = Vector3.new(0, 1, 0) }, -- ด้ามจากไฟล์ Import ตรงมือแล้ว (ไม่ต้องเลื่อนแบบเคียวเก่า)
	VerdantStaff = { Length = 5.4, Head = Vector3.new(0, 1, 0), Aura = "Earth" },
}

-- ออร่าธาตุ: ประกายลอยรอบตัวอาวุธ + หมอกเรืองแสงบางๆ + แสงส่อง
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 180, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 255, 90)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 230, 120)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 160, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 255)),
})
-- ออร่าธาตุแบบอนิเมะ: เปลวไฟ flipbook ห่อตัวอาวุธ + ประกายดาว + เส้นแสงตามรอยฟัน + แสงเรือง
local FLAME_TEX = "rbxassetid://16676455805" -- เปลวไฟ 4x4 (VFXPack/Auras/Fire-Aura-01)
local STAR_TEX = "rbxassetid://17087151546" -- ประกายดาว (VFXPack/Auras/RNG-Aura-02)
local function seq2(a, b)
	return ColorSequence.new(a, b)
end
local AURAS = {
	Earth = { Tex = FLAME_TEX, Color = seq2(Color3.fromRGB(255, 190, 90), Color3.fromRGB(150, 90, 40)), Light = Color3.fromRGB(230, 150, 70), Emission = 0.6 },
	Water = { Tex = FLAME_TEX, Color = seq2(Color3.fromRGB(80, 200, 255), Color3.fromRGB(20, 90, 255)), Light = Color3.fromRGB(70, 180, 255), Emission = 0.8 },
	Wind = { Tex = FLAME_TEX, Color = seq2(Color3.fromRGB(225, 250, 255), Color3.fromRGB(140, 210, 255)), Light = Color3.fromRGB(220, 240, 255), Emission = 0.45 },
	Fire = { Tex = FLAME_TEX, Color = seq2(Color3.fromRGB(255, 120, 40), Color3.fromRGB(255, 40, 20)), Light = Color3.fromRGB(255, 80, 40), Emission = 0.9 },
	Rainbow = { Tex = FLAME_TEX, Color = RAINBOW, Light = Color3.fromRGB(230, 200, 255), Emission = 1 },
	-- เงามืด (คทาพ่อมดมืด): เปลวม่วงเข้มไล่ไปดำ
	Shadow = { Tex = FLAME_TEX, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(190, 90, 255)), ColorSequenceKeypoint.new(0.45, Color3.fromRGB(95, 20, 170)), ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 0, 22)) }), Light = Color3.fromRGB(140, 50, 230), Emission = 0.35 },
}
local function addAura(handle, kind, tool)
	local A = AURAS[kind] or AURAS.Fire
	-- ขอบเขตของอาวุธทั้งชิ้นในพิกัดของ Handle -> แกนยาว + ความหนา
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), -Vector3.new(math.huge, math.huge, math.huge)
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") then
			local cf = handle.CFrame:ToObjectSpace(p.CFrame)
			for _, sx in ipairs({ -0.5, 0.5 }) do
				for _, sy in ipairs({ -0.5, 0.5 }) do
					for _, sz in ipairs({ -0.5, 0.5 }) do
						local v = cf * (p.Size * Vector3.new(sx, sy, sz))
						lo, hi = lo:Min(v), hi:Max(v)
					end
				end
			end
		end
	end
	local size, mid = hi - lo, (hi + lo) / 2
	local axis = size.X >= size.Y and size.X >= size.Z and Vector3.xAxis or (size.Y >= size.Z and Vector3.yAxis or Vector3.zAxis)
	local len = size:Dot(axis)
	local thick = math.clamp((size.X + size.Y + size.Z - len) / 2, 0.4, 1.4)

	-- กล่องปล่อยอนุภาค (Part ใส ไม่ชน) ครอบตัวอาวุธทั้งชิ้น
	local box = Instance.new("Part")
	box.Name = "AuraBox"
	box.Transparency, box.CanCollide, box.CanQuery, box.CanTouch, box.Massless = 1, false, false, false, true
	box.Size = Vector3.new(math.max(size.X, 0.3), math.max(size.Y, 0.3), math.max(size.Z, 0.3))
	box.CFrame = handle.CFrame * CFrame.new(mid)
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = handle, box
	w.Parent = box
	box.Parent = tool

	local function emitter(props)
		local e = Instance.new("ParticleEmitter")
		e.LightInfluence, e.Shape = 0, Enum.ParticleEmitterShape.Box
		e.Color = A.Color
		for k, v in pairs(props) do
			e[k] = v
		end
		e.Parent = box
		return e
	end
	local fs = math.clamp(thick, 0.55, 1)
	-- เปลวออร่าเคลื่อนไหว (flipbook) ลุกท่วมตัวอาวุธ อยู่หลังตัวอาวุธเล็กน้อย
	emitter({
		Texture = A.Tex, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4, FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
		Rate = math.floor(18 + len * 10), Lifetime = NumberRange.new(0.35, 0.55), Speed = NumberRange.new(0.3, 0.8), LockedToPart = true,
		EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(15, 15), Acceleration = Vector3.new(0, 3, 0),
		Rotation = NumberRange.new(-20, 20), LightEmission = A.Emission, Brightness = 2, ZOffset = -0.4,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, fs * 0.7), NumberSequenceKeypoint.new(0.5, fs), NumberSequenceKeypoint.new(1, fs * 0.3) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.2, 0.05), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) }),
	})
	-- ประกายดาวลอยวิบวับ
	emitter({
		Texture = STAR_TEX, Rate = math.floor(3 + len), Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(0.8, 2),
		SpreadAngle = Vector2.new(180, 180), Drag = 3, LightEmission = 1, Brightness = 2.5, Rotation = NumberRange.new(-180, 180), ZOffset = 0.5,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.32), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) }),
	})
	-- เส้นแสงตามรอยฟัน (เห็นตอนเหวี่ยงอาวุธ)
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position, a1.Position = -axis * (len * 0.45), axis * (len * 0.45)
	a0.Parent, a1.Parent = box, box
	local tr = Instance.new("Trail")
	tr.Attachment0, tr.Attachment1 = a0, a1
	tr.Color, tr.LightEmission, tr.LightInfluence, tr.Brightness = A.Color, 1, 0, 2
	tr.Lifetime, tr.MinLength, tr.FaceCamera = 0.22, 0.05, false
	tr.Texture, tr.TextureMode = "rbxassetid://16664715772", Enum.TextureMode.Stretch
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.3) })
	tr.Parent = box
	-- ขอบเรืองแสงสีธาตุรอบตัวอาวุธ
	local hl = Instance.new("Highlight")
	hl.Adornee, hl.DepthMode = tool, Enum.HighlightDepthMode.Occluded
	hl.FillColor, hl.FillTransparency = A.Light, 0.8
	hl.OutlineColor, hl.OutlineTransparency = A.Light, 0.1
	hl.Parent = box
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness = A.Light, 9, 1.2
	l.Parent = box
end

local ToolFactory = {}
ToolFactory.StoreWeapons = STORE_WEAPONS

-- สีไฟเผาของอาวุธ = สีออร่า (ColorSequence) · ไม่มีออร่า = สีตามธาตุ · ไม่มีธาตุ = ไฟส้มปกติ
local ELEMENT_AURA = { Earth = "Earth", Water = "Water", Air = "Wind", Fire = "Fire", All = "Rainbow" }
function ToolFactory.BurnColor(toolId, tool)
	local cfg = STORE_WEAPONS[toolId]
	local kind = (cfg and cfg.Aura) or (tool and ELEMENT_AURA[tool.Element]) or "Fire"
	local A = AURAS[kind] or AURAS.Fire
	return A.Color, A.Emission
end

-- โมเดลอาวุธจาก Store -> ชิ้นทั้งหมดเชื่อมกับ Handle (ชิ้นใหญ่สุด) + ย่อขยายให้ยาวตาม Length
local function buildStore(itemId, tool)
	local cfg = STORE_WEAPONS[itemId]
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src = cfg and assets and assets:FindFirstChild("Weapons") and assets.Weapons:FindFirstChild(itemId)
	if not src then
		return nil
	end
	local m = Instance.new("Model")
	for _, c in ipairs(src:GetChildren()) do
		c:Clone().Parent = m
	end
	local parts, big = {}, nil
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			if not big or d.Size.Magnitude > big.Size.Magnitude then
				big = d
			end
		elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	if not big then
		return nil
	end
	-- ทิศหัวจากท่าที่โมเดลตั้งอยู่ในไฟล์ (ขึ้นบนของโลก -> แกนหลักของ Handle ที่ใกล้ที่สุด)
	local upDir
	if cfg.HeadUp then
		local v = big.CFrame:VectorToObjectSpace(Vector3.yAxis)
		local a = Vector3.new(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
		if a.X >= a.Y and a.X >= a.Z then
			upDir = Vector3.new(math.sign(v.X), 0, 0)
		elseif a.Y >= a.Z then
			upDir = Vector3.new(0, math.sign(v.Y), 0)
		else
			upDir = Vector3.new(0, 0, math.sign(v.Z))
		end
	end
	local _, size = m:GetBoundingBox()
	pcall(function()
		m:ScaleTo(m:GetScale() * cfg.Length / math.max(size.X, size.Y, size.Z))
	end)
	for _, p in ipairs(parts) do
		p.Anchored = false
		p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
		p.Massless = true
		if p ~= big then
			local w = Instance.new("WeldConstraint")
			w.Part0, w.Part1 = big, p
			w.Parent = big
		end
	end
	big.Name = "Handle"
	-- ย้ายทุกชิ้นขึ้นมาอยู่ใต้ Tool ตรงๆ (Handle ต้องเป็นลูกของ Tool โดยตรง · บางโมเดลซ้อน Model ไว้ข้างใน)
	for _, p in ipairs(parts) do
		p.Parent = tool
	end
	m:Destroy()
	if cfg.TipFire then
		-- คทา: เปลวไฟ + แสงเรืองที่หัวคทา (ปลายด้าน +Y)
		local tip = Instance.new("Attachment")
		tip.Name = "StaffTip"
		tip.Position = Vector3.new(0, big.Size.Y / 2 - 0.2, 0)
		tip.Parent = big
		local f = Instance.new("Fire")
		f.Size, f.Heat = 1.6, 4
		f.Color, f.SecondaryColor = Color3.fromRGB(255, 140, 40), Color3.fromRGB(255, 60, 20)
		f.Parent = tip
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness, l.Shadows = Color3.fromRGB(255, 130, 50), 14, 2, false
		l.Parent = tip
	end
	if cfg.Fire then
		-- ไฟที่ปลายคบ: ใส่ในชิ้นหัว (ชิ้นที่ไม่ใช่ด้าม) ถ้ามี · ไม่มีก็ใส่ที่ปลายด้านยาวของด้าม
		local head
		for _, p in ipairs(parts) do
			if p ~= big then
				head = p
			end
		end
		local host = head
		if not host then
			host = Instance.new("Attachment")
			local axis = big.Size.X >= big.Size.Y and big.Size.X >= big.Size.Z and Vector3.xAxis or (big.Size.Y >= big.Size.Z and Vector3.yAxis or Vector3.zAxis)
			host.Position = axis * (big.Size:Dot(axis) / 2)
			host.Parent = big
		end
		local f = Instance.new("Fire")
		f.Size, f.Heat = 2.5, 6
		f.Parent = host
		-- หัวคบ (ชิ้นที่มีไฟ) ต้องชี้ขึ้นตอนถือ: บอกทิศหัวตามแกนหลักของด้าม
		if head then
			local rel = big.CFrame:PointToObjectSpace(head.Position)
			local a = Vector3.new(math.abs(rel.X), math.abs(rel.Y), math.abs(rel.Z))
			if a.X >= a.Y and a.X >= a.Z then
				return big, Vector3.new(math.sign(rel.X), 0, 0)
			elseif a.Y >= a.Z then
				return big, Vector3.new(0, math.sign(rel.Y), 0)
			end
			return big, Vector3.new(0, 0, math.sign(rel.Z))
		end
	end
	return big, upDir
end

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB

local function part(tool, name, size, color, material, shape)
	local p = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	p.Name = name
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = tool
	return p
end

-- ติดชิ้นกับ Handle ด้วยตำแหน่งสัมพัทธ์
local function attach(handle, p, offset)
	p.CFrame = handle.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = handle
	w.Part1 = p
	w.Parent = p
end

local function glow(p, color, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = 2
	l.Shadows = false
	l.Parent = p
	return l
end

-- ด้าม (Handle) ตั้งตามแกน Y, จับที่ล่างของด้าม
local function shaft(tool, length, thickness, color, material)
	local h = part(tool, "Handle", V(thickness, length, thickness), color, material or Enum.Material.Wood)
	h.CFrame = CF(0, 0, 0)
	return h
end

local Shapes = {}

local function axeHead(tool, h, len, color, material, edge)
	local head = part(tool, "Head", V(0.5, 1.4, 1.9), color, material)
	attach(h, head, CF(0, len * 0.42, -0.7))
	local blade = part(tool, "Blade", V(0.35, 1.9, 0.9), edge, Enum.Material.Metal, "Wedge")
	attach(h, blade, CF(0, len * 0.42, -1.9) * ANG(0, math.pi, 0))
end

Shapes.OldAxe = function(tool)
	local h = shaft(tool, 4, 0.4, C(120, 86, 56))
	axeHead(tool, h, 4, C(110, 110, 116), Enum.Material.CorrodedMetal, C(150, 150, 156))
end
Shapes.StoneAxe = function(tool)
	local h = shaft(tool, 4, 0.45, C(110, 80, 52))
	axeHead(tool, h, 4, C(130, 128, 124), Enum.Material.Slate, C(160, 156, 150))
	local wrap = part(tool, "Wrap", V(0.55, 0.8, 0.55), C(170, 200, 110), Enum.Material.Fabric)
	attach(h, wrap, CF(0, 1.4, 0))
end
Shapes.IronAxe = function(tool)
	local h = shaft(tool, 4.4, 0.45, C(80, 58, 40))
	axeHead(tool, h, 4.4, C(70, 74, 82), Enum.Material.Metal, C(210, 214, 222))
end
Shapes.Pickaxe = function(tool)
	local h = shaft(tool, 4.2, 0.42, C(110, 80, 52))
	local head = part(tool, "Head", V(0.45, 0.5, 4), C(120, 120, 128), Enum.Material.Metal)
	attach(h, head, CF(0, 1.8, 0) * ANG(0.15, 0, 0))
end
-- ค้อนช่าง: ด้ามไม้สั้น + หัวเหล็ก (ด้านตอก + เขี้ยวถอนตะปู)
Shapes.BuildHammer = function(tool)
	local h = shaft(tool, 2.4, 0.3, C(150, 104, 62))
	local grip = part(tool, "Grip", V(0.36, 0.7, 0.36), C(120, 50, 40), Enum.Material.Fabric)
	attach(h, grip, CF(0, -0.7, 0))
	local head = part(tool, "Head", V(0.42, 0.42, 0.85), C(96, 100, 110), Enum.Material.Metal)
	attach(h, head, CF(0, 1.25, -0.1))
	local face = part(tool, "Face", V(0.38, 0.5, 0.5), C(180, 184, 192), Enum.Material.Metal, "Cylinder")
	attach(h, face, CF(0, 1.25, -0.62) * ANG(0, math.pi / 2, 0))
	local claw = part(tool, "Claw", V(0.32, 0.32, 0.7), C(96, 100, 110), Enum.Material.Metal, "Wedge")
	attach(h, claw, CF(0, 1.3, 0.55) * ANG(-0.35, 0, 0))
end
Shapes.Spear = function(tool)
	local h = shaft(tool, 7, 0.35, C(130, 96, 62))
	local tip = part(tool, "Tip", V(0.25, 1.6, 0.6), C(236, 228, 210), Enum.Material.SmoothPlastic, "Wedge")
	attach(h, tip, CF(0, 4.2, 0))
	local wrap = part(tool, "Wrap", V(0.45, 0.6, 0.45), C(160, 60, 50), Enum.Material.Fabric)
	attach(h, wrap, CF(0, 3.2, 0))
end
Shapes.Torch = function(tool)
	local h = shaft(tool, 3, 0.4, C(100, 72, 46))
	local head = part(tool, "Flame", V(0.7, 0.8, 0.7), C(255, 160, 60), Enum.Material.Neon, "Ball")
	attach(h, head, CF(0, 1.7, 0))
	local f = Instance.new("Fire")
	f.Size = 2.5
	f.Heat = 6
	f.Parent = head
	local l = glow(head, C(255, 170, 90), Items.Tools.Torch.Light)
	l.Shadows = true
end
Shapes.EmberStaff = function(tool)
	local h = shaft(tool, 5.4, 0.35, C(70, 40, 30))
	local orb = part(tool, "Orb", V(0.9, 0.9, 0.9), C(255, 130, 40), Enum.Material.Neon, "Ball")
	attach(h, orb, CF(0, 3, 0))
	local f = Instance.new("Fire")
	f.Size, f.Heat = 1.6, 4
	f.Parent = orb
	glow(orb, C(255, 130, 50), 14)
end
Shapes.Bow = function(tool)
	local h = shaft(tool, 1.2, 0.35, C(120, 86, 56))
	for i = -1, 1, 2 do
		local limb = part(tool, "Limb", V(0.25, 2.6, 0.35), C(140, 100, 60), Enum.Material.Wood)
		attach(h, limb, CF(0, i * 1.6, 0.5) * ANG(i * -0.45, 0, 0))
	end
	local string_ = part(tool, "String", V(0.06, 4.8, 0.06), C(240, 236, 220), Enum.Material.SmoothPlastic)
	attach(h, string_, CF(0, 0, 1.15))
end
Shapes.TerraHammer = function(tool)
	local h = shaft(tool, 5, 0.5, C(90, 70, 50))
	local head = part(tool, "Head", V(1.8, 1.8, 3.4), C(96, 100, 86), Enum.Material.Slate)
	attach(h, head, CF(0, 2.4, 0))
	for i = -1, 1, 2 do
		local crystal = part(tool, "Crystal", V(0.7, 1.4, 0.7), C(130, 240, 100), Enum.Material.Neon)
		attach(h, crystal, CF(0, 3.4, i * 1) * ANG(i * 0.4, 0, 0))
	end
	glow(head, C(130, 240, 100), 12)
end
Shapes.TidalTrident = function(tool)
	local h = shaft(tool, 7, 0.35, C(60, 110, 150), Enum.Material.Metal)
	for i = -1, 1 do
		local prong = part(tool, "Prong", V(0.25, 1.8, 0.25), C(110, 220, 255), Enum.Material.Neon)
		attach(h, prong, CF(i * 0.55, 4.2 - math.abs(i) * 0.3, 0))
	end
	local bar = part(tool, "Bar", V(1.5, 0.3, 0.3), C(80, 150, 200), Enum.Material.Metal)
	attach(h, bar, CF(0, 3.3, 0))
	glow(bar, C(90, 210, 255), 12)
end
Shapes.GaleBow = function(tool)
	local h = shaft(tool, 1.2, 0.35, C(210, 220, 240), Enum.Material.Metal)
	for i = -1, 1, 2 do
		local limb = part(tool, "Limb", V(0.25, 3.2, 0.4), C(230, 240, 255), Enum.Material.Neon)
		attach(h, limb, CF(0, i * 1.9, 0.6) * ANG(i * -0.5, 0, 0))
		local feather = part(tool, "Feather", V(0.1, 1.2, 0.8), C(150, 200, 255), Enum.Material.Neon, "Wedge")
		attach(h, feather, CF(0, i * 3.3, 1.2))
	end
	local string_ = part(tool, "String", V(0.06, 5.8, 0.06), C(200, 230, 255), Enum.Material.Neon)
	attach(h, string_, CF(0, 0, 1.4))
	glow(h, C(200, 230, 255), 10)
end
Shapes.EmberBlade = function(tool)
	local h = shaft(tool, 1.6, 0.4, C(40, 30, 30), Enum.Material.Metal)
	local guard = part(tool, "Guard", V(2.2, 0.4, 0.6), C(60, 40, 36), Enum.Material.Metal)
	attach(h, guard, CF(0, 0.9, 0))
	local blade = part(tool, "Blade", V(0.35, 5.6, 1.2), C(40, 30, 30), Enum.Material.Basalt)
	attach(h, blade, CF(0, 3.8, 0))
	local edge = part(tool, "Edge", V(0.4, 5.4, 0.25), C(255, 120, 30), Enum.Material.Neon)
	attach(h, edge, CF(0, 3.8, -0.6))
	local f = Instance.new("Fire")
	f.Size = 2
	f.Heat = 5
	f.Parent = blade
	glow(blade, C(255, 120, 40), Items.Tools.EmberBlade.Light)
end
Shapes.FourfoldBlade = function(tool)
	local h = shaft(tool, 1.8, 0.4, C(30, 30, 36), Enum.Material.Metal)
	local guard = part(tool, "Guard", V(2.8, 0.5, 0.7), C(230, 200, 120), Enum.Material.Metal)
	attach(h, guard, CF(0, 1, 0))
	local blade = part(tool, "Blade", V(0.4, 6.4, 1.3), C(240, 244, 255), Enum.Material.Glass)
	attach(h, blade, CF(0, 4.3, 0))
	local colors = { C(130, 240, 100), C(80, 210, 255), C(230, 240, 255), C(255, 120, 30) }
	for i, col in ipairs(colors) do
		local rune = part(tool, "Rune", V(0.45, 0.7, 0.5), col, Enum.Material.Neon)
		attach(h, rune, CF(0, 2 + i * 1.2, 0))
	end
	glow(blade, C(255, 245, 220), Items.Tools.FourfoldBlade.Light)
end

-- กระสอบ: ถุงผ้าผูกเชือก สะพายในมือ
local function buildSack(itemId)
	local tool = Instance.new("Tool")
	tool.Name = Items.DisplayName(itemId)
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ItemId", itemId)
	tool.TextureId = ItemThumbs.Url(itemId) -- รูปในแถบเครื่องมือ
	tool:SetAttribute("Kind", "Sack")
	tool.ToolTip = string.format("Capacity %d items · Click items on the ground to collect", Items.Sacks[itemId])
	local s = itemId == "GiantSack" and 1.35 or (itemId == "GoodSack" and 1.15 or 1)
	local color = Items.SackColor[itemId]
	local h = part(tool, "Handle", V(0.4, 1.2, 0.4), C(120, 90, 60), Enum.Material.Fabric)
	if ItemModels.Has(itemId) then
		-- โมเดลจาก Creator Store: มือกำหูกระเป๋า (ขอบบนอยู่ที่มือพอดี) ตัวกระเป๋าห้อยลง + ดึงเข้าหาตัว (Handle ใส)
		--   ตอนถือ แขนยื่นไปหน้า -> แกน -Y ของ Handle = ลงพื้น · +Z = เข้าหาลำตัว
		h.Transparency = 1
		local src, box = ItemModels.Clone(itemId, 2 * s)
		for _, p in ipairs(src:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CFrame = h.CFrame * CF(0, -box.Y * 0.4, 0.45) * p.CFrame
				p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = h, p
				w.Parent = p
			end
		end
		for _, c in ipairs(src:GetChildren()) do
			c.Parent = tool
		end
		src:Destroy()
		tool.GripPos = V(0, 0, 0)
		return tool
	end
	local body = part(tool, "Bag", V(2.2, 2.4, 2.2) * s, color, Enum.Material.Fabric, "Ball")
	attach(h, body, CF(0, -1.6 * s, 0))
	local neck = part(tool, "Neck", V(0.9, 0.5, 0.9) * s, color:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Fabric, "Cylinder")
	attach(h, neck, CF(0, -0.45 * s, 0) * ANG(0, 0, math.pi / 2))
	local rope = part(tool, "Rope", V(1.0, 0.18, 1.0) * s, C(200, 170, 110), Enum.Material.Fabric, "Cylinder")
	attach(h, rope, CF(0, -0.55 * s, 0) * ANG(0, 0, math.pi / 2))
	if itemId ~= "OldSack" then
		local patch_ = part(tool, "Patch", V(0.8, 0.8, 0.1), C(220, 200, 150), Enum.Material.Fabric)
		attach(h, patch_, CF(0, -1.6 * s, -1.08 * s))
	end
	tool.GripPos = V(0, 0.3, 0)
	return tool
end

-- front (ไม่บังคับ) = ทิศ "หน้า" ของเครื่องมือในแกนของ Handle (ถ้ารู้จากเมชจริง) — ไม่งั้นเดาจากรูปทรง
function ToolFactory.GripFor(tool, handle, kind, front, headOverride)
	local lo = V(math.huge, math.huge, math.huge)
	local hi = -lo
	local centroid, mass = V(), 0
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") then
			local rel = handle.CFrame:ToObjectSpace(p.CFrame)
			local h = p.Size / 2
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = rel * V(h.X * sx, h.Y * sy, h.Z * sz)
						lo = V(math.min(lo.X, c.X), math.min(lo.Y, c.Y), math.min(lo.Z, c.Z))
						hi = V(math.max(hi.X, c.X), math.max(hi.Y, c.Y), math.max(hi.Z, c.Z))
					end
				end
			end
			local m = p.Size.X * p.Size.Y * p.Size.Z
			centroid += rel.Position * m
			mass += m
		end
	end
	if mass <= 0 then
		return CF()
	end
	centroid /= mass
	local ext = hi - lo
	local mid = (lo + hi) / 2
	-- แกนยาวสุด + ด้านที่หนักกว่า = หัว
	local axis
	if ext.X >= ext.Y and ext.X >= ext.Z then
		axis = V(1, 0, 0)
	elseif ext.Y >= ext.Z then
		axis = V(0, 1, 0)
	else
		axis = V(0, 0, 1)
	end
	local len = ext:Dot(axis)
	local sign = ((centroid - mid):Dot(axis) >= 0) and 1 or -1
	local head = axis * sign
	if headOverride then
		head = headOverride
		axis = V(math.abs(head.X), math.abs(head.Y), math.abs(head.Z))
		len = ext:Dot(axis)
	end
	local up = V(0, 1, 0)
	local function headUp()
		if head:Dot(up) > 0.999 then
			return CF()
		elseif head:Dot(up) < -0.999 then
			return ANG(math.pi, 0, 0)
		end
		return CFrame.fromAxisAngle(up:Cross(head).Unit, math.acos(math.clamp(up:Dot(head), -1, 1)))
	end
	-- บิดรอบด้ามให้ทิศ f หันไปข้างหน้าตัวละคร (แบบเดียวกับขวานเก่าที่ถือถูกอยู่แล้ว)
	local function faceForward(rot, f)
		local b = rot:VectorToObjectSpace(f)
		return ANG(0, math.atan2(b.X, b.Z) + math.pi, 0)
	end
	if kind == "Bow" then
		-- ธนู: จับกลางคัน (ค่อนไปทางหลังคัน) ตั้งคันขึ้น หลังคันหันไปข้างหน้า สายหันเข้าหาตัว
		local rot = headUp()
		if front then
			local widthAxis = math.abs(front.X) > 0.5 and ext.X or (math.abs(front.Z) > 0.5 and ext.Z or ext.Y)
			return CF(mid + front * widthAxis * 0.25) * rot * faceForward(rot, front)
		end
		return CF(mid) * rot * ANG(0, math.pi / 2, 0)
	end
	local tail = mid - head * (len / 2)
	local grip = tail + head * (len * ((kind == "Spear" or kind == "Staff") and 0.35 or 0.18))
	if front then
		local rot = headUp()
		return CF(grip) * rot * faceForward(rot, front)
	end
	-- ทิศคม: ส่วนหัว (30% บนสุด) ยื่นออกจากแนวด้ามไปทางไหน -> ให้หันไปข้างหน้า
	local blade, bmass = V(), 0
	local topLo, topHi = V(math.huge, math.huge, math.huge), V(-math.huge, -math.huge, -math.huge)
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") then
			local c = handle.CFrame:ToObjectSpace(p.CFrame).Position
			if (c - mid):Dot(head) > len * 0.2 then
				local perp = (c - mid) - head * (c - mid):Dot(head)
				local m = p.Size.X * p.Size.Y * p.Size.Z
				blade += perp * m
				bmass += m
				topLo = V(math.min(topLo.X, c.X - p.Size.X / 2), math.min(topLo.Y, c.Y - p.Size.Y / 2), math.min(topLo.Z, c.Z - p.Size.Z / 2))
				topHi = V(math.max(topHi.X, c.X + p.Size.X / 2), math.max(topHi.Y, c.Y + p.Size.Y / 2), math.max(topHi.Z, c.Z + p.Size.Z / 2))
			end
		end
	end
	if bmass > 0 then
		blade /= bmass
	end
	if bmass == 0 then
		-- เครื่องมือชิ้นเดียว (เมชเดียว): ส่วนหัวกว้างสุดตามแกนที่ตั้งฉากกับด้าม
		topLo, topHi = lo, hi
	end
	if blade.Magnitude < 0.05 then
		-- หัวสมมาตร (เช่น ขวานสองคม): ใช้แกนที่กว้างสุดของส่วนหัว
		local e = topHi - topLo
		local cands = {}
		for _, ax in ipairs({ V(1, 0, 0), V(0, 1, 0), V(0, 0, 1) }) do
			if math.abs(ax:Dot(head)) < 0.5 then
				table.insert(cands, { ax, e:Dot(ax) })
			end
		end
		table.sort(cands, function(x, y)
			return x[2] > y[2]
		end)
		blade = cands[1] and cands[1][1] or V()
	end
	-- หมุนให้ +Y ของด้ามมาตรฐาน = ทิศหัว แล้วใช้มุมจับแบบเดียวกับด้ามปั้น
	-- แกน +Y ของมือ R15 (ตอนยกแขนถือของ) ชี้ขึ้น -> หัวเครื่องมือชี้ขึ้น ด้ามตั้งฉากกับแขน
	-- แล้วบิดรอบด้ามให้คม (blade) หันไปข้างหน้า (ทิศที่ฟัน)
	local rot = headUp()
	local twist = CF()
	if blade.Magnitude > 0.01 then
		twist = faceForward(rot, blade)
	end
	return CF(grip) * rot * twist
end

-- ยา (ผ้าพันแผล/ชุดปฐมพยาบาล): ใส่โมเดลจริงจาก Store ให้ถือในมือ (Handle ใส อยู่กลางโมเดล)
local MED_SIZE = { Bandage = 0.95, Medkit = 1.5, HerbSalve = 0.9 }
function ToolFactory.DressMedical(tool, itemId)
	if tool:FindFirstChild("Handle") then
		return
	end
	tool.RequiresHandle = true
	local h = part(tool, "Handle", V(0.4, 0.4, 0.4), C(240, 236, 220))
	h.Transparency = 1
	h.CanTouch, h.CanQuery = false, false
	local src = ItemModels.Has(itemId) and ItemModels.Clone(itemId, MED_SIZE[itemId] or 1)
	if src then
		for _, p in ipairs(src:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CFrame = h.CFrame * p.CFrame
				p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = h, p
				w.Parent = p
			end
		end
		for _, c in ipairs(src:GetChildren()) do
			c.Parent = tool
		end
		src:Destroy()
	else
		h.Transparency = 0
		h.Size = itemId == "Medkit" and V(1.3, 0.9, 0.5) or V(0.5, 0.8, 0.5)
		h.Color = Items.Data[itemId] and Items.Data[itemId].Color or h.Color
	end
	-- มือกำกลางของ ดันออกหน้ามือเล็กน้อย
	tool.Grip = CF(0, 0, -0.15)
end

function ToolFactory.Build(itemId)
	if Items.Sacks[itemId] then
		return buildSack(itemId)
	end
	local spec = Items.Tools[itemId]
	local shape = Shapes[itemId]
	-- อาวุธจาก Store ที่ไม่มีแบบปั้นเองสำรอง: ใช้ด้ามไม้ธรรมดาแทนถ้าโหลดโมเดลไม่ได้
	if not (spec and (shape or STORE_WEAPONS[itemId])) then
		return nil
	end
	shape = shape or function(t)
		shaft(t, 3.4, 0.35, C(110, 80, 50))
	end
	local tool = Instance.new("Tool")
	tool.Name = Items.DisplayName(itemId)
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ItemId", itemId)
	tool.TextureId = ItemThumbs.Url(itemId) -- รูปในแถบเครื่องมือ
	tool:SetAttribute("Kind", spec.Kind)
	local handle, headDir = buildStore(itemId, tool)
	if handle then
		local cfg = STORE_WEAPONS[itemId]
		if cfg.Aura then
			addAura(handle, cfg.Aura, tool)
		elseif spec.Light then
			glow(handle, C(255, 245, 220), spec.Light)
		end
		tool.Grip = cfg.Grip or ToolFactory.GripFor(tool, handle, spec.Kind, cfg.Front, cfg.Head or headDir)
		if cfg.GripTurn then
			tool.Grip *= cfg.GripTurn -- หมุนท่าจับเพิ่ม (เช่น ใบเคียวให้หันไปข้างหน้า)
		end
		if cfg.Flip then
			-- หันกลับด้าน 180° รอบแกนด้าม (โมเดลบางชิ้นวางหน้า-หลังสลับกัน)
			tool.Grip *= CFrame.Angles(0, math.pi, 0)
		end
		return tool
	end
	if MESH_TOOLS[itemId] and MeshProps.Has(itemId) then
		handle = MeshProps.BuildTool(itemId, tool)
		if spec.Light then
			glow(handle, itemId == "EmberBlade" and C(255, 120, 40) or C(255, 245, 220), spec.Light)
		end
		if itemId == "EmberBlade" then
			local f = Instance.new("Fire")
			f.Size = 2
			f.Heat = 5
			f.Parent = handle
		end
	else
		shape(tool)
		handle = tool:FindFirstChild("Handle")
	end
	-- ท่าถือ: หาแกนยาวของเครื่องมือจริง (โมเดลแต่ละชิ้นวางแกนไม่เหมือนกัน) -> หัว (ใบขวาน/ใบดาบ) ชี้ขึ้น มือจับใกล้ปลายด้าม
	local isMesh = MESH_TOOLS[itemId] and MeshProps.Has(itemId)
	tool.Grip = ToolFactory.GripFor(tool, handle, spec.Kind, isMesh and MESH_FRONT[itemId] or nil, isMesh and MESH_HEAD[itemId] or nil)
	return tool
end

return ToolFactory
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007A"><Properties><string name="Name">TraderService</string><ProtectedString name="Source"><![CDATA[--[[
	TraderService — พ่อค้าเร่ (แบบ Pelt Trader ใน 99 Nights)
	มาที่แคมป์ช่วงกลางวันทุก 3 วัน (วันที่ 2, 5, 8 ...) แลกหนัง/กระดูก/แก่นธาตุ เป็นยา วัตถุดิบ และอาวุธ
	เดินออกมาจากป่า -> ยืนนอกขอบเขตแคมป์ (ไม่บังที่สร้างฐาน · ตัวทะลุได้) · สร้างของมาทับ = เดินหลบไปจุดใหม่
	พลบค่ำ = เก็บร้านแล้วเดินกลับเข้าป่า
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shop = require(ReplicatedStorage.Shared.Shop)
local Items = require(ReplicatedStorage.Shared.Items)
local Limits = require(ReplicatedStorage.Shared.Limits)
local MeshProps = require(ReplicatedStorage.Shared.MeshProps)

local TraderService = {}

local V = Vector3.new
local CF = CFrame.new
local C = Color3.fromRGB

function TraderService:Init(ctx)
	self.ctx = ctx
end

local function part(parent, props)
	local p = Instance.new(props.ClassName or "Part")
	props.ClassName = nil
	p.Anchored = true
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

-- ตัวพ่อค้า: ผู้ชายผ้าคลุมแบกเป้ใหญ่ + โคมไฟ (สร้างจากชิ้นส่วน)
local function buildTrader(cf)
	-- พ่อค้าเร่จาก Creator Store (คนคลุมผ้า) + ตัวชนใสไว้ติดปุ่มแลกของ
	local PropBuilder = require(game:GetService("ReplicatedStorage").Shared.PropBuilder)
	local store = Instance.new("Model")
	store.Name = "Trader"
	if PropBuilder.Imported("TraderNPC", cf, 3.8, store) then
		local body = part(store, { Name = "Body", Size = V(2.6, 6.6, 2), CFrame = cf * CF(0, 3.3, 0), Transparency = 1 })
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness = C(255, 200, 120), 18, 1.5
		l.Parent = body
		return store, body
	end
	store:Destroy()
	local m = Instance.new("Model")
	m.Name = "Trader"
	local cloak = C(110, 80, 52)
	local body = part(m, { Name = "Body", Size = V(2.6, 4.4, 1.8), CFrame = cf * CF(0, 3.4, 0), Color = cloak, Material = Enum.Material.Fabric })
	part(m, { Shape = Enum.PartType.Ball, Size = V(1.9, 1.9, 1.9), CFrame = cf * CF(0, 6.4, 0), Color = C(220, 180, 150) })
	part(m, { ClassName = "WedgePart", Size = V(2.6, 1.6, 2.4), CFrame = cf * CF(0, 7.4, 0.3), Color = cloak, Material = Enum.Material.Fabric })
	part(m, { Size = V(2.8, 3.8, 2.2), CFrame = cf * CF(0, 4.2, 1.9), Color = C(130, 96, 60), Material = Enum.Material.Fabric })
	part(m, { Size = V(1, 1.2, 1), CFrame = cf * CF(0, 6.6, 2.1), Color = C(90, 70, 50), Material = Enum.Material.Wood })
	part(m, { Size = V(0.8, 2.6, 0.8), CFrame = cf * CF(-1, 1, 0), Color = C(70, 50, 36) })
	part(m, { Size = V(0.8, 2.6, 0.8), CFrame = cf * CF(1, 1, 0), Color = C(70, 50, 36) })
	local lamp = part(m, { Size = V(0.8, 1, 0.8), CFrame = cf * CF(1.8, 3.4, -0.8), Color = C(255, 210, 130), Material = Enum.Material.Neon })
	local l = Instance.new("PointLight")
	l.Color = C(255, 200, 120)
	l.Range = 18
	l.Brightness = 2
	l.Parent = lamp
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 50)
	bb.StudsOffset = V(0, 5, 0)
	bb.MaxDistance = 120
	bb.Parent = body
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = "🐾 Wandering Trader"
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = C(255, 220, 150)
	t.TextStrokeTransparency = 0.3
	t.Parent = bb
	if MeshProps.Has("Barrel") then
		local b = MeshProps.Build("Barrel")
		b:PivotTo(cf * CF(-3.5, 0, 1))
		b.Parent = m
	end
	if MeshProps.Has("Chest") then
		local c = MeshProps.Build("Chest")
		c:PivotTo(cf * CF(3.5, 0, 1))
		c.Parent = m
	end
	m.PrimaryPart = body
	return m, body
end

---------------------------------------------------------------- เดินเข้า/ออก + จุดยืนนอกเขตสร้าง
-- โมเดลพ่อค้าเป็นเมชก้อนเดียว (ไม่มีกระดูก) -> เดินแบบโยกตัว: เด้งขึ้นลงตามก้าว + เอียงซ้ายขวา + โน้มตัวไปหน้า
local WALK_SPEED = 9 -- stud/วิ
local WALK_IN = 55 -- เริ่มเดินจากนอกจุดยืนเท่านี้ (ในป่า)
local STAND_OUT = 8 -- ยืนนอกขอบเขตแคมป์ (เขตวางสิ่งก่อสร้าง) เท่านี้ -> ไม่บังที่สร้างฐาน

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.FilterDescendantsInstances = { workspace.Terrain }

local function ground(pos)
	return workspace:Raycast(pos + V(0, 80, 0), V(0, -300, 0), groundParams)
end

-- จุดนี้ว่างไหม (ไม่มีต้นไม้/หิน/สิ่งก่อสร้างทับ)
function TraderService:Clear(pos)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = { self.model }
	for _, pl in ipairs(Players:GetPlayers()) do
		table.insert(ex, pl.Character)
	end
	params.FilterDescendantsInstances = ex
	for _, p in ipairs(workspace:GetPartBoundsInBox(CF(pos + V(0, 4, 0)), V(7, 6, 7), params)) do
		if p.CanCollide and p.Transparency < 0.95 and p.Size.Magnitude > 3 then
			return false
		end
	end
	return true
end

-- จุดยืน: วงรอบนอกเขตแคมป์ เริ่มจากทิศเดิม (ตะวันตกเฉียงใต้) แล้วไล่ซ้าย/ขวาทีละ 20° หาจุดบนบก ไม่ชันเกิน ไม่มีของทับ
function TraderService:FindSpot(avoid)
	local camp = self.ctx.CampPosition
	local r = self.ctx.Services.CampService:CampRadius() + STAND_OUT
	local base = math.atan2(18, -30)
	local fallback
	for i = 0, 17 do
		local ang = base + (i % 2 == 0 and 1 or -1) * math.ceil(i / 2) * math.rad(20)
		local dir = V(math.cos(ang), 0, math.sin(ang))
		local hit = ground(camp + dir * r)
		if hit and hit.Material ~= Enum.Material.Water and hit.Material ~= Enum.Material.CrackedLava and math.abs(hit.Position.Y - camp.Y) < 14 then
			fallback = fallback or { hit.Position, dir }
			if self:Clear(hit.Position) and not (avoid and (hit.Position - avoid).Magnitude < 12) then
				return hit.Position, dir
			end
		end
	end
	if fallback then
		return fallback[1], fallback[2]
	end
	local dir = V(math.cos(base), 0, math.sin(base))
	return camp + dir * r, dir
end

-- วางโมเดลที่เท้า (pos) หันไปทาง look · bob = ระยะก้าว (0 = ยืนนิ่ง)
function TraderService:Pose(pos, look, phase)
	local m = self.model
	if not (m and m.Parent) then
		return
	end
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = V(0, 0, -1)
	end
	local cf = CFrame.lookAt(pos, pos + flat)
	if phase then
		local s = math.sin(phase)
		cf = cf * CF(0, math.abs(s) * 0.35, 0) * CFrame.Angles(math.rad(-4), 0, s * math.rad(4))
	end
	m:PivotTo(cf * self.rel)
	self.feet, self.look = pos, flat
end

-- เดินตามจุดบนพื้นจนถึงจุดสุดท้าย แล้วเรียก done (หยุดการเดินเดิมก่อนเสมอ)
function TraderService:WalkTo(points, done)
	if self.walk then
		self.walk:Disconnect()
		self.walk = nil
	end
	local i, phase = 1, 0
	self.walk = game:GetService("RunService").Heartbeat:Connect(function(dt)
		local target = points[i]
		local from = self.feet
		if not (target and from and self.model and self.model.Parent) then
			self.walk:Disconnect()
			self.walk = nil
			return
		end
		local d = V(target.X - from.X, 0, target.Z - from.Z)
		local step = WALK_SPEED * dt
		local pos
		if d.Magnitude <= step then
			pos = target
			i += 1
		else
			pos = from + d.Unit * step
		end
		local hit = ground(pos)
		pos = V(pos.X, hit and hit.Position.Y or pos.Y, pos.Z)
		phase += dt * 7.5
		self:Pose(pos, d.Magnitude > 0.01 and d or self.look, phase)
		if i > #points then
			self.walk:Disconnect()
			self.walk = nil
			if done then
				done()
			end
		end
	end)
end

-- instant = เกิดที่จุดยืนเลย ไม่ต้องเดินเข้า (เทสต์)
function TraderService:Arrive(instant)
	if self.model then
		if not self.leaving then
			return
		end
		self:Remove() -- กำลังเดินออกอยู่แล้วถูกเรียกมาใหม่ -> ลบตัวเก่าทิ้ง
	end
	local camp = self.ctx.CampPosition
	local spot, dir = self:FindSpot()
	-- มาเยือนรอบใหม่ = รีเซ็ตโควต้าแลกของของทุกคน
	for _, pl in ipairs(Players:GetPlayers()) do
		for _, o in ipairs(Shop.Trader) do
			pl:SetAttribute("Trade_" .. o.Id, nil)
		end
	end
	local cf0 = CF(spot)
	local m, body = buildTrader(cf0)
	self.model, self.leaving, self.ready = m, false, false
	self.rel = cf0:ToObjectSpace(m:GetPivot())
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false -- เดินทะลุได้ ไม่ขวางทาง
		end
	end
	local p = Instance.new("ProximityPrompt")
	p.ActionText = "Trade"
	p.ObjectText = "Wandering Trader"
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.Enabled = false
	p.Parent = body
	p.Triggered:Connect(function(player)
		self.ctx.Remotes.Get("Cinematic"):FireClient(player, "OpenTrader", {})
	end)
	self.prompt = p
	local function arrived()
		self:Pose(spot, camp - spot)
		self.ready = true
		p.Enabled = true
		self.ctx.State:SetAttribute("TraderHere", true)
		self.ctx.Broadcast("The wandering trader has arrived at camp", "Reward")
	end
	if instant then
		self.feet = spot
		m.Parent = workspace
		arrived()
		return
	end
	-- เดินออกมาจากป่า มุ่งตรงเข้าหาแคมป์ แล้วหยุดที่จุดยืน
	local start = spot + dir * WALK_IN
	local hit = ground(start)
	start = hit and hit.Position or start
	self.feet = start
	self:Pose(start, -dir, 0)
	m.Parent = workspace
	self:WalkTo({ spot }, arrived)
end

-- มีคนสร้าง/ย้ายของมาทับใกล้พ่อค้า (เช่น อัปเกรดกองไฟแล้วเขตแคมป์กว้างขึ้น) -> พ่อค้าเดินหลบไปจุดว่างใหม่
function TraderService:MakeRoom(pos, size)
	if not (self.model and self.ready and not self.leaving and self.feet) then
		return
	end
	local reach = (size and math.max(size.X, size.Z) / 2 or 3) + 5
	if ((self.feet - pos) * V(1, 0, 1)).Magnitude > reach then
		return
	end
	local spot = self:FindSpot(pos)
	local camp = self.ctx.CampPosition
	self.ready = false
	self:WalkTo({ spot }, function()
		self:Pose(spot, camp - spot)
		self.ready = true
	end)
end

function TraderService:Remove()
	if self.walk then
		self.walk:Disconnect()
		self.walk = nil
	end
	if self.model then
		self.model:Destroy()
	end
	self.model, self.prompt, self.feet, self.ready, self.leaving = nil, nil, nil, false, false
end

-- instant = หายไปเลย (จบเกม/กลับล็อบบี้) · ปกติ = เก็บร้านแล้วเดินกลับเข้าป่า
function TraderService:Leave(instant)
	if not self.model or self.leaving then
		if instant and self.model then
			self:Remove()
		end
		return
	end
	self.leaving, self.ready = true, false
	if self.prompt then
		self.prompt.Enabled = false
	end
	self.ctx.State:SetAttribute("TraderHere", false)
	self.ctx.Broadcast("The wandering trader has left", "Info")
	if instant or not self.feet then
		self:Remove()
		return
	end
	local out = self.feet - self.ctx.CampPosition
	out = V(out.X, 0, out.Z)
	out = out.Magnitude > 0.1 and out.Unit or V(1, 0, 0)
	self:WalkTo({ self.feet + out * (WALK_IN + 15) }, function()
		self:Remove()
	end)
end

function TraderService:OnDay(day)
	if day >= 2 and (day - 2) % Shop.TraderEvery == 0 then
		self:Arrive()
	end
end

function TraderService:Start(ctx)
	local function trade(player, offerId)
		if ctx.Services.SurvivalService:IsIncapacitated(player) then
			return
		end
		local offer = Shop.TraderById[offerId]
		if not (offer and self.model and self.ready) then
			return
		end
		local char = player.Character
		if not char or (char:GetPivot().Position - self.model:GetPivot().Position).Magnitude > 30 then
			ctx.Notify(player, "You must be near the trader", "Error")
			return
		end
		local inv = ctx.Services.InventoryService
		-- โควต้าต่อการมาเยือน + ของที่มีแล้ว/ครบจำนวน -> ไม่ให้แลก (ไม่เสียของ)
		local key = "Trade_" .. offerId
		local used = player:GetAttribute(key) or 0
		if used >= Limits.TradesPerVisit then
			ctx.Notify(player, string.format("You've traded this %d times already — wait for the trader's next visit", Limits.TradesPerVisit), "Error")
			return
		end
		for id, n in pairs(offer.Give) do
			if Items.Data[id] and Items.Data[id].Category == "Tool" and inv:Count(player, id) > 0 then
				ctx.Notify(player, "You already have " .. Items.DisplayName(id) .. "", "Info")
				return
			end
			if inv:Room(player, id) < n then
				ctx.Notify(player, inv:LimitText(id) .. " — maxed out", "Error")
				return
			end
		end
		if not inv:Spend(player, offer.Cost) then
			ctx.Notify(player, "Not enough items to trade", "Error")
			return
		end
		for id, n in pairs(offer.Give) do
			inv:Add(player, id, n)
		end
		player:SetAttribute(key, used + 1)
		ctx.Notify(player, string.format("🐾 Trade complete! (%d more trades left for this item)", Limits.TradesPerVisit - used - 1), "Good")
	end
	TraderService.TestTrade = trade
	ctx.Remotes.Get("Trade").OnServerEvent:Connect(trade)
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		local ph = ctx.State:GetAttribute("Phase")
		if ph == "Dusk" or ph == "Night" then
			self:Leave()
		elseif ph == "Ended" or ph == "Lobby" then
			self:Leave(true)
		end
	end)
end

return TraderService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007B"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[--[[
	WorldService — โหมด "สร้างโลก" (จ่ายต่อ 1 โลก: Developer Product Config.WorldProductId)
	  เมนู Worlds: เห็นห้องโลกทุกห้องในเซิร์ฟเวอร์นี้ · กด "+" = ซื้อ 1 ครั้ง ได้โลกใหม่ 1 โลก (สร้างอีกก็ซื้ออีก)
	    ตั้งรหัสผ่าน/จำนวนคนตอนสร้าง · โลกที่สร้างไว้เก็บได้ Config.WorldMaxSlots โลก (DataService data.Worlds) เปิดเล่นต่อเมื่อไรก็ได้
	    เข้าห้องคนอื่นได้เมื่อ คืนของโลก <= คืนที่ตัวเองเคยรอดไกลสุด + Config.WorldNightGate (ยังไม่เคยเล่น = ถึงคืน 20)
	    หัวห้องออกจากห้อง/ออกเกม = ปิดห้อง ทุกคนเด้งออก · หัวห้องกดเริ่ม = ไปเซิร์ฟเวอร์ของทีม (LobbyService:DepartTeam)
	  ในโลก (State.WorldOwner/WorldId): เซฟโลกทุกเช้า (RejoinService:SaveRunFor -> DataService:SaveWorld)
	    เจ้าของออกเกม = เซฟแล้วส่งทุกคนกลับล็อบบี้ · ทีมตายหมด (ไม่ชุบ) = โลกหาย (DataService:DeleteWorld)
	  ห้องโชว์ใน ReplicatedStorage.Worlds (Configuration ต่อห้อง: HostId/HostName/WorldName/Night/Count/Size/Locked/Members/New)
	  remote WorldAction(action, a, b, c): "Create"(password, size) / "Open"(worldId, password, size) / "Delete"(worldId)
	    / "Join"(hostId, password) / "Leave" / "Start"
]]

local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldService = {}

function WorldService:Init(ctx)
	self.ctx = ctx
	self.rooms = {} -- [host] = { Host, Password, Night, Size, Members = { player... }, New, Inst }
	self.roomOf = {} -- [player] = room
	self.pending = {} -- [player] = { Password, Size } ค่าที่ตั้งไว้ระหว่างรอซื้อสร้างโลก
	local f = Instance.new("Folder")
	f.Name = "Worlds"
	f.Parent = ReplicatedStorage
	self.folder = f
end

local function notify(self, p, text, kind)
	self.ctx.Notify(p, text, kind or "Info")
end

-- คืนที่เข้าห้องได้สูงสุดของคนนี้
function WorldService:MaxNight(player)
	local data = self.ctx.Services.DataService:Get(player)
	return math.floor(tonumber(data and data.BestNight) or 0) + (Config.WorldNightGate or 20)
end

function WorldService:Publish(room)
	local inst = room.Inst
	if not inst then
		inst = Instance.new("Configuration")
		inst.Name = tostring(room.Host.UserId)
		inst.Parent = self.folder
		room.Inst = inst
	end
	local ids = {}
	for _, m in ipairs(room.Members) do
		table.insert(ids, tostring(m.UserId))
	end
	inst:SetAttribute("HostId", room.Host.UserId)
	inst:SetAttribute("HostName", room.Host.DisplayName)
	inst:SetAttribute("WorldName", room.WorldName)
	inst:SetAttribute("Night", room.Night)
	inst:SetAttribute("New", room.New)
	inst:SetAttribute("Count", #room.Members)
	inst:SetAttribute("Size", room.Size)
	inst:SetAttribute("Locked", room.Password ~= "")
	inst:SetAttribute("Members", table.concat(ids, ","))
	inst:SetAttribute("Invited", table.concat(room.InviteList or {}, ","))
end

function WorldService:RemoveMember(room, p, why)
	local i = table.find(room.Members, p)
	if i then
		table.remove(room.Members, i)
	end
	self.roomOf[p] = nil
	if p.Parent then
		p:SetAttribute("WorldRoom", nil)
		if why then
			notify(self, p, why, "Info")
		end
	end
end

-- ปิดห้อง: ทุกคนเด้งออก
function WorldService:Close(room, why)
	for _, m in ipairs(table.clone(room.Members)) do
		self:RemoveMember(room, m, m ~= room.Host and why or nil)
	end
	self.rooms[room.Host] = nil
	if room.Inst then
		room.Inst:Destroy()
	end
end

function WorldService:Leave(player)
	local room = self.roomOf[player]
	if not room then
		return
	end
	if room.Host == player then
		self:Close(room, "🌍 The host closed the world room")
	else
		self:RemoveMember(room, player)
		self:Publish(room)
		notify(self, room.Host, player.DisplayName .. " left your world room")
	end
end

local function cleanPassword(pw)
	pw = type(pw) == "string" and pw or ""
	pw = pw:gsub("[%c]", ""):sub(1, 12)
	return pw
end

-- ชื่อโลก (คนอื่นเห็น) ต้องผ่านตัวกรองข้อความของ Roblox · กรองไม่ได้/ว่าง = ชื่อสำรอง
local function cleanName(player, name, fallback)
	name = type(name) == "string" and name:gsub("[%c]", ""):gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 24) or ""
	if name == "" then
		return fallback
	end
	local ok, res = pcall(function()
		return TextService:FilterStringAsync(name, player.UserId):GetNonChatStringForBroadcastAsync()
	end)
	return ok and type(res) == "string" and res ~= "" and res or fallback
end

-- เปิดห้องของโลกที่สร้างไว้ (โลกใหม่ = คืน 1 · โลกที่เคยเล่น = คืนที่เซฟล่าสุด)
function WorldService:Open(player, worldId, password, size)
	local data = self.ctx.Services.DataService:Get(player)
	local w = data and type(data.Worlds) == "table" and data.Worlds[worldId]
	if not w or player:GetAttribute("InRun") or player:GetAttribute("Departing") then
		return
	end
	self:Leave(player)
	self.ctx.Services.LobbyService:LeavePad(player, true)
	local room = {
		Host = player,
		WorldId = worldId,
		WorldName = w.Name or "World",
		Password = cleanPassword(password),
		Night = w.Night or 1,
		New = w.Played ~= true,
		Size = math.clamp(math.floor(tonumber(size) or 4), 1, Config.WorldMaxSize or 8),
		Members = { player },
		Invited = {}, -- [UserId] = true คนที่หัวห้องเชิญ (เข้าได้ไม่ต้องใส่รหัส)
		InviteList = {},
	}
	self.rooms[player] = room
	self.roomOf[player] = room
	player:SetAttribute("WorldRoom", player.UserId)
	self:Publish(room)
	notify(self, player, string.format("🌍 %s is open%s — invite friends or wait for them to join", room.WorldName, room.New and "" or (" · Night " .. room.Night)), "Good")
end

-- สร้างโลกใหม่ (ใช้สิทธิ์ที่ซื้อแล้ว 1 ครั้ง) แล้วเปิดห้องทันที
function WorldService:Create(player, name, password, size)
	local ds = self.ctx.Services.DataService
	local data = ds:Get(player)
	if not data or player:GetAttribute("InRun") then
		return
	end
	data.Worlds = type(data.Worlds) == "table" and data.Worlds or {}
	local count = 0
	for _ in pairs(data.Worlds) do
		count += 1
	end
	if count >= (Config.WorldMaxSlots or 5) then
		notify(self, player, string.format("You can keep up to %d worlds — delete one first", Config.WorldMaxSlots or 5), "Error")
		return
	end
	local free = (Config.WorldProductId or 0) == 0 and RunService:IsStudio() -- Studio ยังไม่ตั้งสินค้า = สร้างฟรีไว้เทส
	if not free then
		if (data.WorldCredits or 0) <= 0 then
			-- ยังไม่ได้ซื้อ: จำค่าที่ตั้งไว้ แล้วให้เครื่องผู้เล่นเด้งหน้าซื้อ (ซื้อเสร็จ -> OnCredit สร้างต่อเอง)
			self.pending[player] = { Name = name, Password = password, Size = size }
			if (Config.WorldProductId or 0) > 0 then
				self.ctx.Remotes.Get("Cinematic"):FireClient(player, "BuyWorld", {})
			else
				notify(self, player, "Creating worlds is coming soon", "Info")
			end
			return
		end
		data.WorldCredits -= 1
	end
	local n = (data.WorldsMade or 0) + 1
	data.WorldsMade = n
	local id = tostring(os.time()) .. "_" .. n
	local worldName = cleanName(player, name, "World " .. n)
	data.Worlds[id] = { Name = worldName, Night = 1, Created = os.time() }
	self.pending[player] = nil
	ds:PushWorlds(player)
	task.spawn(ds.Save, ds, player)
	notify(self, player, "🌍 Created " .. worldName .. "!", "Reward")
	self:Open(player, id, password, size)
end

-- ซื้อสำเร็จ (MonetizationService worldReceipt): มีค่าที่รออยู่ = สร้างโลกเลย
function WorldService:OnCredit(player)
	local p = self.pending[player]
	if p and player.Parent then
		self:Create(player, p.Name, p.Password, p.Size)
	else
		notify(self, player, "🌍 World purchased — press + Create to make it", "Reward")
	end
end

function WorldService:Delete(player, worldId)
	local room = self.rooms[player]
	if room and room.WorldId == worldId then
		self:Close(room, "🌍 The host deleted the world")
	end
	self.ctx.Services.DataService:DeleteWorld(player, worldId)
	notify(self, player, "🗑 World deleted", "Info")
end

function WorldService:Join(player, hostId, password, viaInvite)
	if player:GetAttribute("InRun") or player:GetAttribute("Departing") then
		return
	end
	local host = Players:GetPlayerByUserId(tonumber(hostId) or 0)
	local room = host and self.rooms[host]
	if not room then
		notify(self, player, "That world room is gone", "Error")
		return
	end
	if self.roomOf[player] == room then
		return
	end
	if #room.Members >= room.Size then
		notify(self, player, "That world room is full", "Error")
		return
	end
	local invited = viaInvite and room.Invited[player.UserId]
	if room.Password ~= "" and not invited and cleanPassword(password) ~= room.Password then
		notify(self, player, "🔒 Wrong password", "Error")
		return
	end
	local max = self:MaxNight(player)
	if room.Night > max then
		notify(self, player, string.format("This world is on Night %d — you can join worlds up to Night %d (your best night + %d)", room.Night, max, Config.WorldNightGate or 20), "Error")
		return
	end
	self:Leave(player)
	self.ctx.Services.LobbyService:LeavePad(player, true)
	table.insert(room.Members, player)
	self.roomOf[player] = room
	player:SetAttribute("WorldRoom", host.UserId)
	self:Publish(room)
	room.Invited[player.UserId] = nil
	local i = table.find(room.InviteList, tostring(player.UserId))
	if i then
		table.remove(room.InviteList, i)
	end
	self:Publish(room)
	notify(self, player, "🌍 Joined " .. room.WorldName .. " — wait for the host to enter the world", "Good")
	notify(self, host, player.DisplayName .. " joined your world room")
end

-- หัวห้องเชิญคนในเซิร์ฟเวอร์นี้ (คนที่ยังไม่อยู่ห้องไหน) -> คนนั้นเห็นหน้าต่างเชิญ กดรับ = เข้าเลยไม่ต้องใส่รหัส
function WorldService:Invite(player, userId)
	local room = self.rooms[player]
	local target = Players:GetPlayerByUserId(tonumber(userId) or 0)
	if not (room and target) or target == player then
		return
	end
	if target:GetAttribute("InRun") or self.roomOf[target] then
		notify(self, player, target.DisplayName .. " is busy right now", "Info")
		return
	end
	if #room.Members >= room.Size then
		notify(self, player, "Your room is full", "Error")
		return
	end
	if room.Night > self:MaxNight(target) then
		notify(self, player, string.format("%s can't join yet — Night %d is too far for them", target.DisplayName, room.Night), "Error")
		return
	end
	room.Invited[target.UserId] = true
	if not table.find(room.InviteList, tostring(target.UserId)) then
		table.insert(room.InviteList, tostring(target.UserId))
	end
	self:Publish(room)
	self.ctx.Remotes.Get("Cinematic"):FireClient(target, "WorldInvite", {
		HostId = player.UserId, HostName = player.DisplayName, WorldName = room.WorldName, Night = room.Night, New = room.New,
	})
	notify(self, player, "📨 Invited " .. target.DisplayName, "Good")
end

-- หัวห้องเชิญคนออกจากห้อง
function WorldService:Kick(player, userId)
	local room = self.rooms[player]
	local target = Players:GetPlayerByUserId(tonumber(userId) or 0)
	if room and target and target ~= player and self.roomOf[target] == room then
		self:RemoveMember(room, target, "The host removed you from the world room")
		self:Publish(room)
	end
end

function WorldService:StartRoom(player)
	local room = self.rooms[player]
	if not room then
		return
	end
	local list = {}
	for _, m in ipairs(room.Members) do
		if m.Parent and not m:GetAttribute("InRun") then
			table.insert(list, m)
		end
	end
	local resume = not room.New and player or nil
	local worldId = room.WorldId
	self.rooms[player] = nil
	for _, m in ipairs(room.Members) do
		self.roomOf[m] = nil
		if m.Parent then
			m:SetAttribute("WorldRoom", nil)
		end
	end
	if room.Inst then
		room.Inst:Destroy()
	end
	local lobby = self.ctx.Services.LobbyService
	local canTeleport = not RunService:IsStudio() and game.PlaceId ~= 0 and not lobby.IsTeamServer
	if not canTeleport then
		-- Studio: เล่นในเซิร์ฟเวอร์นี้ (โลกเดิมโหลดได้เฉพาะเกมที่ publish แล้ว -> ที่นี่เริ่มคืน 1)
		self.ctx.State:SetAttribute("WorldOwner", player.UserId)
		self.ctx.State:SetAttribute("WorldId", worldId)
	end
	-- เริ่มเล่นแล้ว = ไม่ใช่โลกใหม่ (ห้องครั้งหน้าโชว์คืนที่เซฟ)
	local data = self.ctx.Services.DataService:Get(player)
	if data and type(data.Worlds) == "table" and data.Worlds[worldId] then
		data.Worlds[worldId].Played = true
	end
	lobby:DepartTeam(list, resume, player.UserId, worldId)
end

---------------------------------------------------------------- ในโลก (เซิร์ฟเวอร์ของทีม)
function WorldService:IsWorldOwner(player)
	return self.ctx.State:GetAttribute("WorldOwner") == player.UserId
end

-- เจ้าของโลกออกเกม: เซฟแล้วส่งทุกคนกลับล็อบบี้
function WorldService:OnOwnerLeft(owner)
	local ctx = self.ctx
	local director = ctx.Services.DirectorService
	if not director:IsRunning() or ctx.State:GetAttribute("Phase") == "Ended" then
		return
	end
	pcall(ctx.Services.RejoinService.SaveRunFor, ctx.Services.RejoinService, owner, true)
	local others = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= owner then
			table.insert(others, p)
			notify(self, p, "🌍 The world owner left — the world is saved, back to the lobby", "Warn")
		end
	end
	ctx.State:SetAttribute("WorldOwner", nil)
	task.delay(3, function()
		local lobby = ctx.Services.LobbyService
		if not (lobby.IsTeamServer and lobby:ReturnToMainLobby(others, { Result = "HostLeft" })) then
			director:ResetRun()
		end
	end)
end

function WorldService:Start(ctx)
	ctx.Remotes.Get("WorldAction").OnServerEvent:Connect(function(player, action, a, b, c)
		if action == "Create" then
			self:Create(player, a, b, c)
		elseif action == "Open" and type(a) == "string" then
			self:Open(player, a, b, c)
		elseif action == "Delete" and type(a) == "string" then
			self:Delete(player, a)
		elseif action == "Join" then
			self:Join(player, a, b, c == true)
		elseif action == "Invite" then
			self:Invite(player, a)
		elseif action == "Kick" then
			self:Kick(player, a)
		elseif action == "Leave" then
			self:Leave(player)
		elseif action == "Start" then
			self:StartRoom(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		self.pending[p] = nil
		self:Leave(p)
		if self:IsWorldOwner(p) then
			self:OnOwnerLeft(p)
		end
	end)
	-- เซิร์ฟเวอร์ของทีมที่มาจากห้องโลก: จำว่าเป็นโลกของใคร (TeleportData.World)
	local function onPlayer(p)
		-- คนที่เคยซื้อ Game Pass Save Run (เลิกขายแล้ว) -> ได้สิทธิ์สร้างโลกฟรี 1 โลก (ครั้งเดียว)
		local function oldPass()
			local ds = ctx.Services.DataService
			local data = ds:Get(p)
			if p:GetAttribute("Pass_SaveRun") and data and not data.SaveRunCredit then
				data.SaveRunCredit = true
				data.WorldCredits = (data.WorldCredits or 0) + 1
				ds:PushWorlds(p)
				task.spawn(ds.Save, ds, p)
				notify(self, p, "🌍 Thanks for buying Save Run — you got 1 free world (press + Create World)", "Reward")
			end
		end
		p:GetAttributeChangedSignal("Pass_SaveRun"):Connect(oldPass)
		task.spawn(function()
			-- พาสเช็กเสร็จก่อนเซฟโหลดได้ -> รอเซฟแล้วเช็กอีกรอบ
			local t0 = os.clock()
			while p.Parent and not ctx.Services.DataService:Get(p) and os.clock() - t0 < 30 do
				task.wait(0.5)
			end
			oldPass()
		end)
		local ok, join = pcall(function()
			return p:GetJoinData()
		end)
		local td = ok and type(join) == "table" and join.TeleportData
		if type(td) == "table" and tonumber(td.World) and ctx.State:GetAttribute("WorldOwner") == nil then
			ctx.State:SetAttribute("WorldOwner", tonumber(td.World))
			ctx.State:SetAttribute("WorldId", tostring(td.WorldId or ""))
		end
		if type(td) == "table" and td.Back and td.Result == "HostLeft" then
			task.delay(6, function()
				if p.Parent then
					notify(self, p, "🌍 The world owner left — their world is saved", "Info")
				end
			end)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, p)
	end
	-- ทีมตายหมด (ไม่มีใครชุบ) ในโลก = โลกหาย · กลับล็อบบี้ (Studio) = ไม่ใช่โลกแล้ว
	ctx.State:GetAttributeChangedSignal("Ending"):Connect(function()
		local owner = ctx.State:GetAttribute("WorldOwner")
		local p = owner and Players:GetPlayerByUserId(owner)
		if ctx.State:GetAttribute("Ending") == "Defeat" and p then
			task.spawn(ctx.Services.DataService.DeleteWorld, ctx.Services.DataService, p, ctx.State:GetAttribute("WorldId"))
			ctx.Broadcast("💀 The whole team fell — this world is lost", "Danger")
		end
	end)
	ctx.State:GetAttributeChangedSignal("Phase"):Connect(function()
		if ctx.State:GetAttribute("Phase") == "Lobby" and not ctx.Services.LobbyService.IsTeamServer then
			ctx.State:SetAttribute("WorldOwner", nil)
			ctx.State:SetAttribute("WorldId", nil)
		end
	end)
end

return WorldService
