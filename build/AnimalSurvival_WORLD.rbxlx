	WarHammer = 13106821277,
	Scythe = 83223944436703,
	EmberShard = 80654769388421,
	EmberTotem = 4638108969,
	FarmPlot = 93660859808046,
	Fiber = 11814511082,
	FourfoldBlade = 8300795842,
	GaleBow = 55918184,
