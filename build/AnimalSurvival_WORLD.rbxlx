<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">ChestLid</string><ProtectedString name="Source"><![CDATA[--[[
	ChestLid — ฝาหีบที่เปิดได้จริง (โมเดล Props/Chest1Open-3Open: MeshPart "Body" + "Lid")
	  ฝามี Attachment "Hinge" = บานพับขอบบนด้านหลัง (+Z ของชิ้น) · เปิด = หมุนรอบแกน X ของบานพับ
	  ใช้ทั้งเซิร์ฟเวอร์ (ตั้งค่าฝาเปิดค้าง) และเครื่องผู้เล่น (เล่นแอนิเมชันเปิดนุ่มๆ) -> คิดมุมเหมือนกัน
]]

local ChestLid = {}

ChestLid.OpenDeg = 105

-- ฝา + บานพับในโมเดล (ไม่มี = หีบรุ่นเก่า เปิดฝาไม่ได้)
function ChestLid.Find(model)
	if not model then
		return nil
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d.Name == "Hinge" and d:IsA("Attachment") and d.Parent:IsA("BasePart") then
			return d.Parent, d
		end
	end
	return nil
end

-- ตำแหน่งฝาเมื่อเปิดไป frac (0 = ปิด, 1 = เปิดสุด · เกิน 1 ได้ตอนเด้ง)
function ChestLid.CFrameAt(closedCF, hinge, frac)
	local h = closedCF * hinge.CFrame
	return h * CFrame.Angles(math.rad(ChestLid.OpenDeg * frac), 0, 0) * h:Inverse() * closedCF
end

-- ตำแหน่งปิดเดิมของฝา (จำไว้ครั้งแรกที่เห็น)
function ChestLid.Closed(lid)
	local cf = lid:GetAttribute("ClosedCF")
	if typeof(cf) ~= "CFrame" then
		cf = lid.CFrame
		lid:SetAttribute("ClosedCF", cf)
	end
	return cf
end

return ChestLid
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Classes</string><ProtectedString name="Source"><![CDATA[--[[
	Classes — คลาสตัวละคร (ซื้อด้วย Ruby ♦️ เซฟข้ามรอบ) แบบร้านคลาสของ 99 Nights
	  - ดาว 1-5 (ความหายาก) · เลเวล 1-3 ต่อคลาส: เก็บสถิติตอนเล่นคลาสนั้นจนครบ หรือจ่าย Ruby "ข้าม"
	  - ทักษะเลเวล 1/2/3 ปลดตามเลเวล (Perks ของเลเวลหลังทับค่าของเลเวลก่อน)
	  - สต็อกร้านสุ่มใหม่ทุกวัน (UTC) ต่อผู้เล่น — คลาสที่ "ไม่มีสต๊อค" ซื้อไม่ได้จนกว่าจะรีโรล/วันใหม่

	Perks ที่ระบบอื่นอ่าน:
		ChopMult, MineMult, DamageMult, BuildDiscount, WallHealthMult, SpeedMult, StaminaMult,
		ElementDamageMult, FuelDrainMult, HungerMult, HealMult, DamageTakenMult, ExtraDrops, WildPeace,
		MaxHealthBonus (+เลือดสูงสุด), Regen (ฟื้นเลือด/วินาที)
]]

local Classes = {}

Classes.Order = {
	"Survivor", "Forager", "Lumberjack", "Medic", "Hunter", "Builder", "Scout", "Elementalist", "Vampire",
	"Sage", -- คลาสพาส (ท้ายสุด) · ปลดล็อกด้วย Game Pass เท่านั้น ไม่มีขายด้วย Ruby
}

Classes.MaxLevel = 3

-- Skills[1..3] = ทักษะเลเวล 1/2/3: { Name, Text, Perks } — Perks ของเลเวลหลังทับค่าเดียวกันของเลเวลก่อน
Classes.Data = {
	Survivor = {
		Name = "Survivor", Thai = "Survivor", Role = "All-Rounder", Stars = 1, Price = 0, Icon = "🔥",
		StartItems = { OldAxe = 1, Torch = 1 },
		Skills = {
			{ Name = "Never Give Up", Text = "Max HP +15 · Hunger 10% slower", Perks = { MaxHealthBonus = 15, HungerMult = 0.9 } },
			{ Name = "Traveler", Text = "Run 5% faster · Stamina +15%", Perks = { SpeedMult = 1.05, StaminaMult = 1.15 } },
			{ Name = "Survival Instinct", Text = "Max HP +25 · Regen 0.3 HP/sec", Perks = { MaxHealthBonus = 25, Regen = 0.3 } },
		},
	},
	Forager = {
		Name = "Forager", Thai = "Forager", Role = "Supplies", Stars = 2, Price = 100, Icon = "🍓",
		StartItems = { OldAxe = 1, Berries = 6 },
		Skills = {
			{ Name = "Big Basket", Text = "Hunting drops +1 extra meat/pelt/bone/fiber", Perks = { ExtraDrops = 1 } },
			{ Name = "Food Expert", Text = "Hunger 25% slower · Food and healing 20% stronger", Perks = { HungerMult = 0.75, HealMult = 1.2 } },
			{ Name = "Full Harvest", Text = "Hunting drops +2 extra meat/pelt/bone/fiber", Perks = { ExtraDrops = 2 } },
		},
	},
	Lumberjack = {
		Name = "Lumberjack", Thai = "Lumberjack", Role = "Gathering", Stars = 2, Price = 150, Icon = "🪓",
		StartItems = { StoneAxe = 1 },
		Skills = {
			{ Name = "Log Arms", Text = "Chop wood x1.6", Perks = { ChopMult = 1.6 } },
			{ Name = "Trusty Axe", Text = "Mine rock and ore x1.4 · Stamina +20%", Perks = { MineMult = 1.4, StaminaMult = 1.2 } },
			{ Name = "Forest Feller", Text = "Chop wood x2.2 · Mine rock/ore x1.6", Perks = { ChopMult = 2.2, MineMult = 1.6 } },
		},
	},
	Medic = {
		Name = "Medic", Thai = "Field Medic", Role = "Support", Stars = 2, Price = 200, Icon = "🩹",
		StartItems = { OldAxe = 1, Bandage = 3 },
		Skills = {
			{ Name = "Healer's Hands", Text = "Bandages, medicine and reviving teammates heal x1.5", Perks = { HealMult = 1.5 } },
			{ Name = "Recovery", Text = "Regen 0.5 HP/sec at all times", Perks = { Regen = 0.5 } },
			{ Name = "Battlefield Doctor", Text = "Healing x2 · Max HP +15", Perks = { HealMult = 2, MaxHealthBonus = 15 } },
		},
	},
	Hunter = {
		Name = "Hunter", Thai = "Hunter", Role = "Combat", Stars = 3, Price = 350, Icon = "🏹",
		StartItems = { OldAxe = 1, Bow = 1 },
		Skills = {
			{ Name = "Hawk Eye", Text = "All weapon damage +15%", Perks = { DamageMult = 1.15 } },
			{ Name = "Never Miss", Text = "Damage +25% · Hunting drops +1 extra meat/pelt/bone/fiber", Perks = { DamageMult = 1.25, ExtraDrops = 1 } },
			{ Name = "Alpha Hunter", Text = "Damage +40% · Run 5% faster", Perks = { DamageMult = 1.4, SpeedMult = 1.05 } },
		},
	},
	Builder = {
		Name = "Builder", Thai = "Builder", Role = "Base Defense", Stars = 3, Price = 400, Icon = "🔨",
		StartItems = { OldAxe = 1, LogWall = 2 },
		Skills = {
			{ Name = "Thrifty Builder", Text = "Buildings cost 20% fewer materials", Perks = { BuildDiscount = 0.2 } },
			{ Name = "Hardwood", Text = "Walls and buildings are x1.5 tougher", Perks = { WallHealthMult = 1.5 } },
			{ Name = "Fortress", Text = "35% fewer materials · Buildings x2 tougher", Perks = { BuildDiscount = 0.35, WallHealthMult = 2 } },
		},
	},
	Scout = {
		Name = "Scout", Thai = "Scout", Role = "Exploration", Stars = 4, Price = 650, Icon = "🧭",
		StartItems = { OldAxe = 1, IronArmor = 1 }, -- เกราะเงิน (เกราะเหล็ก) สวมตั้งแต่เริ่ม
		Skills = {
			{ Name = "Quick Feet", Text = "Run 12% faster", Perks = { SpeedMult = 1.12 } },
			{ Name = "Iron Lungs", Text = "Stamina x1.6 · Hunger 10% slower", Perks = { StaminaMult = 1.6, HungerMult = 0.9 } },
			{ Name = "Shadow of the Wilds", Text = "Run 20% faster · Stamina x2 · Hunting drops +1 extra item", Perks = { SpeedMult = 1.2, StaminaMult = 2, ExtraDrops = 1 } },
		},
	},

	-- พ่อมดมืด: ดาเมจทุกอย่าง +30% · เลเวล 2 = สกิลล่องหน · เลเวล 3 = สกิลอุกกาบาตมืด (SkillService)
	Elementalist = {
		Name = "Dark Sorcerer", Thai = "Dark Sorcerer", Role = "Dark Magic", Stars = 5, Price = 1000, Icon = "🔮",
		StartItems = { OldAxe = 1, ArcaneStaff = 1 }, -- ขวาน (ทุกคลาสมี) + คทาอาคม (อาวุธประจำคลาส · ยิงลูกพลังระเบิด)
		Skills = {
			{ Name = "Dark Power", Text = "All damage +30%", Perks = { DamageMult = 1.3 } },
			{ Name = "Shadow Veil", Text = "Skill: turn invisible and run 50% faster for 4s (breaks when you deal damage) · Cooldown 30s", Perks = { DamageMult = 1.3 },
				Active = { Id = "ShadowVeil", Cooldown = 30, Icon = "👻" } },
			{ Name = "Dark Meteor", Text = "Skill: a dark meteor crashes from the sky, heavy damage in a wide area and leaves a dark fire zone for 10s (burns 2% HP/sec, bosses 5% total) · Cooldown 120s", Perks = { DamageMult = 1.3 },
				Active = { Id = "DarkMeteor", Cooldown = 120, Icon = "☄" } },
		},
	},
	-- แวมไพร์: ฆ่ามอนได้เลือดคืน (KillHealPct = สัดส่วนเลือดสูงสุด) · ตีแรง · เลเวล 3 = สกิลกดเรียกฝูงค้างคาว (SkillService)
	Vampire = {
		Name = "Vampire", Thai = "Vampire", Role = "Lifesteal", Stars = 5, Price = 1000, Icon = "🦇",
		StartItems = { OldAxe = 1, BloodScythe = 1 },
		Skills = {
			{ Name = "Blood Bite", Text = "Heal 2% max HP after every monster kill", Perks = { KillHealPct = 0.02 } },
			{ Name = "Blood Moon", Text = "Attack +30%", Perks = { KillHealPct = 0.02, DamageMult = 1.3 } },
			{ Name = "Swarm", Text = "Skill: summon 5 bats (200 HP) that attack monsters (half damage to bosses) · Cooldown 120s · Using it again replaces the old swarm", Perks = { KillHealPct = 0.02, DamageMult = 1.3 },
				Active = { Id = "Swarm", Cooldown = 120, Icon = "🦇" } },
		},
	},
	-- คลาส "พงไพร" (ผู้พิทักษ์ป่า): รางวัล Season Pass สายพรีเมียมขั้น SeasonReward (กดรับเองใน Quests) · ซื้อพาสอย่างเดียวยังไม่ได้ · ไม่อยู่ในสต็อกร้าน
	-- รหัสคลาสยังเป็น "Sage" (คนที่ได้คลาสพาสไปแล้วเซฟไว้ด้วยรหัสนี้) · โมเดล Assets.Characters.Sage
	Sage = {
		Name = "Wildwood Druid", Thai = "Wildwood Druid", Role = "Pass Exclusive", Stars = 5, Price = 0, SeasonReward = 30, Icon = "🌿",
		StartItems = { OldAxe = 1, VerdantStaff = 1 },
		Skills = {
			{ Name = "Forest's Embrace", Text = "Regen 3% HP every 2 seconds", Perks = { RegenPct = 0.015 } },
			{ Name = "Wild Stride", Text = "Run 30% faster", Perks = { RegenPct = 0.015, SpeedMult = 1.3 } },
			{ Name = "Thorn Bind", Text = "Skill: stun nearby monsters for 4s (bosses 2s) and poison them — lose 1% HP/sec for 15s (bosses 4% total) · Cooldown 150s", Perks = { RegenPct = 0.015, SpeedMult = 1.3 },
				Active = { Id = "ThornBind", Cooldown = 150, Icon = "🌿" } },
		},
	},
}

-- สกิลกด (เลเวลที่ปลดแล้วสูงสุดที่มี Active) -> { Id, Cooldown, Icon } หรือ nil
function Classes.ActiveSkill(id, level)
	local c = Classes.Data[id]
	if not c then
		return nil
	end
	for lv = math.clamp(level or 1, 1, Classes.MaxLevel), 1, -1 do
		if c.Skills[lv].Active then
			return c.Skills[lv].Active
		end
	end
	return nil
end

-- สกิลกดทั้งหมดที่ปลดแล้ว (เลเวลน้อย -> มาก) -> { {Id, Cooldown, Icon}, ... }
function Classes.ActiveSkills(id, level)
	local c = Classes.Data[id]
	local out = {}
	for lv = 1, math.clamp(level or 1, 1, Classes.MaxLevel) do
		if c and c.Skills[lv].Active then
			table.insert(out, c.Skills[lv].Active)
		end
	end
	return out
end

-- คลาสที่ต้องมี Game Pass (Data.Pass) ใช้ได้ไหม · data = โปรไฟล์ · player = เช็ก attribute Pass_<key>
function Classes.IsOwned(id, data, player)
	local c = Classes.Data[id]
	if not c then
		return false
	end
	if data and data.Owned and data.Owned[id] then
		return true
	end
	return c.Pass ~= nil and player ~= nil and player:GetAttribute("Pass_" .. c.Pass) == true
end

-- จำนวนคลาสที่สะสมได้ด้วย Ruby (ภารกิจ "สะสมครบทุกคลาส" ไม่นับคลาสพาส)
Classes.CollectCount = 0
for _, id in ipairs(Classes.Order) do
	if not (Classes.Data[id].Pass or Classes.Data[id].SeasonReward) then
		Classes.CollectCount += 1
	end
end

-- ใช้กับโค้ดเก่า: Perks / Desc = ทักษะเลเวล 1
for _, c in pairs(Classes.Data) do
	c.Perks = c.Skills[1].Perks
	c.Desc = c.Skills[1].Name .. ": " .. c.Skills[1].Text
end

-- Perks รวมถึงเลเวลที่ปลดแล้ว
function Classes.PerksFor(id, level)
	local c = Classes.Data[id] or Classes.Data.Survivor
	local out = {}
	for lv = 1, math.clamp(level or 1, 1, Classes.MaxLevel) do
		for k, v in pairs(c.Skills[lv].Perks) do
			out[k] = v
		end
	end
	return out
end

---------------------------------------------------------------- เลเวล
-- ข้อกำหนดเพื่อขึ้นเลเวล (สถิติที่เก็บตอนสวมใส่คลาสนั้น)
Classes.StatNames = { Kills = "Hunt", Nights = "Survive nights" }
Classes.StatOrder = { "Kills", "Nights" }

function Classes.Requirement(id, level)
	local s = (Classes.Data[id] or Classes.Data.Survivor).Stars
	if level == 2 then
		return { Kills = 40 + 20 * s, Nights = 3 + s }
	elseif level == 3 then
		return { Kills = 200 + 100 * s, Nights = 10 + 4 * s }
	end
	return nil
end

-- จ่าย Ruby ข้ามไปเลเวลถัดไป
function Classes.SkipPrice(id, level)
	local s = (Classes.Data[id] or Classes.Data.Survivor).Stars
	return level == 2 and 60 * s or 180 * s
end

---------------------------------------------------------------- สต็อกร้าน
Classes.RerollPrice = 25
Classes.StockOdds = { [1] = 0.9, [2] = 0.75, [3] = 0.55, [4] = 0.35, [5] = 0.2 } -- โอกาสมีของต่อดาว
Classes.StarColor = {
	[1] = Color3.fromRGB(170, 176, 186), [2] = Color3.fromRGB(110, 210, 90), [3] = Color3.fromRGB(70, 160, 255),
	[4] = Color3.fromRGB(190, 100, 255), [5] = Color3.fromRGB(255, 160, 40),
}

function Classes.Day(now)
	return math.floor((now or os.time()) / 86400)
end

-- วินาทีที่เหลือก่อนสต็อกรีเซ็ต
function Classes.SecondsToRestock(now)
	now = now or os.time()
	return (Classes.Day(now) + 1) * 86400 - now
end

-- ชุดคลาสที่มีของในวัน/รอบรีโรลนี้ (ผลเหมือนกันทั้ง server และ client)
function Classes.Stock(day, roll, userId)
	local rng = Random.new(day * 7919 + (roll or 0) * 104729 + ((userId or 0) % 100000))
	local stock = {}
	local count = 0
	for _, id in ipairs(Classes.Order) do
		local c = Classes.Data[id]
		if c.Price > 0 and rng:NextNumber() < Classes.StockOdds[c.Stars] then
			stock[id] = true
			count += 1
		end
	end
	if count == 0 then
		stock.Forager = true
	end
	return stock
end

---------------------------------------------------------------- Ruby
-- Ruby ที่ได้ตอนรอดถึงคืน
Classes.NightRewards = { [5] = 5, [10] = 10, [25] = 20, [50] = 40, [75] = 60, [99] = 150 } -- ตอนนี้ไม่ได้ใช้ (DirectorService ปิด Ruby รอดคืนไว้)
Classes.BossReward = { Earth = 3, Water = 5, Air = 5, Fire = 7 } -- Ruby ต่อการฆ่าบอส 1 ครั้ง ตามธาตุ (ทุกคนในระยะได้)
Classes.SpiritReward = 5
Classes.DailyReward = 5 -- หม้อรางวัลประจำวันในล็อบบี้

return Classes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	Config — ค่าตั้งต้นของทั้งเกม (แก้ตรงนี้ที่เดียว)
	ANIMAL SURVIVAL : 99 Nights of the Elements
]]

local Config = {}

Config.GameName = "ANIMAL SURVIVAL"
Config.Subtitle = "Legends of the Four Elements"

---------------------------------------------------------------- แมพ
-- ขนาดแมพ (ด้านละกี่ studs) 6144 = ~1.7 กม. ต่อด้าน / ใส่ 8192 ได้ถ้าเครื่องเซิร์ฟเวอร์ไหว
Config.MapSize = 6144
Config.VoxelRes = 4 -- ความละเอียด Terrain (ห้ามเปลี่ยน)
Config.ChunkVoxels = 48 -- ขนาดชิ้นที่สร้างทีละครั้ง (48 voxel = 192 studs)
Config.WaterLevel = 20 -- ระดับน้ำทะเล (Y)
Config.Seed = nil -- nil = สุ่มใหม่ทุกเซิร์ฟเวอร์ (ไบโอมสลับตำแหน่งทุกรอบ)
Config.PreviewSeed = 99 -- seed ที่ปลั๊กอินใช้สร้างแมพตัวอย่างตอน Edit
Config.HeartRadius = 260 -- ทุ่งกลางรอบกองไฟ (ราบเรียบ ปลอดภัยตอนกลางวัน)
Config.EdgeOcean = 420 -- ขอบแมพเป็นทะเลลึก กันคนออกนอกแมพ
Config.PropDensity = 1.0 -- ความหนาแน่นต้นไม้/หิน (ลดได้ถ้าเครื่องช้า)

---------------------------------------------------------------- เวลา
Config.TotalNights = 99 -- รอดครบ 99 คืน = "พิชิต" (จบเนื้อเรื่อง) แต่เล่นต่อได้ไม่จำกัดเพื่อทำสถิติ
Config.EndlessBossEvery = 25 -- หลังคืน 99: บอสวนกลับมาบุกทุกกี่คืน (124, 149, ...)
Config.DayLength = 150 -- วินาที (2:30 นาที รวมช่วงพลบค่ำ)
Config.DuskLength = 25 -- ช่วงพลบค่ำ (ท้ายกลางวัน) เตือนว่าฝูงกำลังมา
Config.NightLength = 90 -- 1:30 นาที
Config.BossHoldMax = 120 -- คืนบอส: บอสยังไม่ตายตอนใกล้เช้า -> หยุดนาฬิการอได้สูงสุดกี่วินาที
Config.FirstDayBonus = 0 -- วันแรกยาวเท่าวันอื่น
Config.TreeRegrowDays = 4 -- ต้นไม้ที่โค่นแล้วเริ่มงอกใหม่ได้หลังผ่านไปกี่คืน
Config.TreeRegrowChance = 0.3 -- ครบแล้ว: แต่ละคืนต้นที่ล้มอยู่มีโอกาสงอกคืนเท่านี้ (ทยอยขึ้นทีละน้อย ไม่ขึ้นพร้อมกันทั้งป่า)
Config.AnimalDropMult = 0.7 -- ของที่สัตว์/มอนดรอป (เนื้อ/หนัง/กระดูก/ฯลฯ) คูณเท่านี้ · ไม่รวมบอส

---------------------------------------------------------------- ผู้เล่น
Config.HungerMax = 100
Config.HungerDrainPerSec = 100 / 900 -- หมดใน ~15 นาที (เดิม 9 นาที)
Config.StarveDamagePerSec = 2.5
Config.BreathMax = 20 -- ดำน้ำได้นานสุด (วิ) · หัวจมน้ำ = ลมหายใจลด 1/วิ
Config.BreathRefillPerSec = 6 -- โผล่พ้นน้ำ = ลมหายใจกลับมาเต็มใน ~3 วิ
Config.DrownDamagePerSec = 10 -- ลมหายใจหมด = เสียเลือดต่อวิ
Config.ReviveTime = 3.5
Config.ReviveRange = 10
Config.BaseWalkSpeed = 18
Config.SprintSpeed = 28
Config.StaminaMax = 100
Config.InteractRange = 14
Config.BuildRange = 60

---------------------------------------------------------------- สัตว์
-- สัตว์เกิดได้เฉพาะตัวที่มีโมเดลแล้ว (assets/rbxm/Animals/<Id>.rbxmx) — ตอนนี้มีแค่บอส 4 ไบโอม
Config.AnimalsEnabled = true
Config.LootMult = 0.7 -- ตัวคูณของดรอปทั้งเกม (วัตถุดิบ/แก่นธาตุ เท่านั้น — อาหาร/ยาไม่ลด)
Config.MonsterDamageScale = 0.5 -- ดาเมจมอนทั่วไป (สัตว์ป่า/บุกแคมป์/ผู้พิทักษ์) ที่ตีผู้เล่น — ลดความยาก (เดิม 0.75)
Config.BossDamageScale = 1 -- (ตอนนี้ดาเมจบอสตั้งเป็นตัวเลขจริงใน Animals: Damage/SkillDamage) ดาเมจบอส (ตีธรรมดา + สกิลทุกท่า)
Config.BossSkillCooldown = 20 -- (เดิม 25) คูลดาวน์ของแต่ละสกิล (วินาที นับหลังร่ายจบ) · ท่าเดิมใช้ซ้ำได้เมื่อครบเวลานี้ (บอสทุกตัว ทั้งบุกแคมป์/ในรัง)
Config.BossSkillGap = 5 -- เว้นระหว่างสกิล (วินาที หลังร่ายจบก่อนร่ายท่าถัดไป) · ไม่มีท่าไหนพร้อม -> รอจนพร้อม
Config.BossCastMult = 1.82 -- (เดิม 2.6 · ร่ายเร็วขึ้น 30% = x0.7) ท่าร่ายบอสช้าลงกี่เท่า (คูณเวลาง้าง/วงเตือนทุกสกิล · บอสตั้งเองได้ด้วย Info.CastMult)
Config.StalkerStare = 3 -- จิ้งจอกจันทรา (ตัวไล่): จ้องกี่วินาทีก่อนพุ่งตี (เหยื่อไม่ได้ถือคบเพลิง)
Config.BossFirstSkill = 2 -- วินาทีหลังเกิดก่อนร่ายสกิลแรก (เดิม 6)
Config.MaxWildAnimals = 70 -- สัตว์ป่ากลางวันทั้งแมพ
Config.WildSpawnRadius = { Min = 140, Max = 420 } -- เกิดรอบตัวผู้เล่น
Config.WildDespawnRadius = 900
-- กล่องทั่วแมพ: จำนวนทั้งหมด + จำนวนแต่ละระดับ (ธรรมดา / หายาก / ตำนาน) · วิหาร = ระดับ 3 เสมอ
Config.CrateCount = 40
Config.CrateTierWeight = { 18, 14, 8 }
-- สัตว์ป่ากลางวันมีถิ่นของตัวเอง (ไม่ใช่ฝูงบุกกลางคืน): ไม่ไล่ตามข้ามแมพจนถึงแคมป์
-- ช่วยลูกสัตว์ธาตุสำเร็จ = ข้ามวันตามธาตุ (Air = ไบโอมน้ำแข็ง) · เตียง = 1 วัน
Config.SpiritBonusDays = { Earth = 1, Water = 2, Air = 3, Fire = 4 } -- ช่วยลูกสัตว์: บวกเข้าตัวคูณวัน (ไม้ +1 · น้ำ +2 · น้ำแข็ง +3 · ไฟ +4) · ยังไม่มีตัวคูณ = เริ่มจาก x1
Config.ShrineGuardianMult = 1.5 -- มอนในดันช่วยลูกสัตว์ (ผู้เฝ้าศาล ทุกเวฟ): เลือด + ดาเมจ x1.5
Config.WildLeash = 70 -- รัศมีถิ่นจากจุดเกิด (stud) · ผู้เล่นออกนอกถิ่น +40 = เลิกไล่ แล้วเดินกลับถิ่น
Config.WildChaseTime = 14 -- ไล่ไม่ถึงตัวนานเกินนี้ (วินาที) = เลิกไล่
Config.WildGiveUpTime = 10 -- เลิกไล่แล้ว ไม่สนใจคนนั้นอีกกี่วินาที
Config.RaidSpawnRadius = { Min = 220, Max = 320 } -- ฝูงบุกเกิดรอบกองไฟ
Config.MaxRaidAnimals = 18 -- สัตว์บุกพร้อมกันสูงสุด (เดิม 55)
Config.RaidBosses = false -- บอสบุกแคมป์คืน 25/50/75/99 (ปิด: บอสอยู่ในรังเท่านั้น)
Config.AnimalThinkRate = 0.25 -- วินาทีต่อรอบคิดของ AI

---------------------------------------------------------------- นักพัฒนา
-- UserId ที่ใช้เครื่องมือ DEV (F8) ในเกมจริงได้ (ใน Studio และเจ้าของเกมใช้ได้เสมอ)
Config.DevUserIds = {}

---------------------------------------------------------------- อันดับ (ทั้งเกม ทุกเซิร์ฟเวอร์)
