	GoldArmor = 73779488166589,
	Wood = 248338900,
}

function ItemThumbs.Url(id)
	local aid = ItemThumbs[id]
	return aid and string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", aid) or ""
end

return ItemThumbs
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--[[
	Items — ไอเทมทั้งหมด
	Category: Resource / Food / Essence / Medical / Tool / Structure / Relic / Armor
	Fuel = ค่าเชื้อเพลิงเมื่อโยนเข้ากองไฟ
]]

