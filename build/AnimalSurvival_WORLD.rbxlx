	{ Id = "SeasonPass", PassId = 2063569631, Robux = 499, Icon = "🎟", Name = "Season Pass", Desc = "Unlocks the Season Pass premium track every season · More Ruby + special titles/title colors · Wildwood Druid class" },
	{ Id = "SaveRun", PassId = 2064000575, Robux = 799, Icon = "💾", Name = "Save Run", Desc = "Retired — owners got 1 free world (Worlds menu)" }, -- เลิกขาย: แทนด้วยสร้างโลกจ่ายต่อครั้ง (Config.WorldProductId)
}
-- คืนชีพทันที (Developer Product ซื้อซ้ำได้) · 0 = ยังไม่ได้สร้าง -> ไม่มีปุ่มซื้อ
Config.ReviveProductId = 3726412294
-- ชุบทั้งทีมจ่ายทีเดียว (ราคาเดียว 129 Robux ไม่ว่ากี่คน): Developer Product "Revive All" · 0 = ยังไม่ตั้ง -> ซื้อทีละคนแทน
Config.ReviveAllProductId = 3728747675
Config.ReviveAllRobux = 129 -- ราคาที่โชว์ระหว่างรอดึงราคาจริงจาก Roblox
Config.WorldRobux = 199 -- ราคาที่โชว์ระหว่างรอดึงราคาจริง
Config.WorldProductId = 3728749227 -- Developer Product "Create World" 199 Robux (จ่ายต่อ 1 โลก) · 0 = Studio สร้างฟรี / เกมจริงปิดปุ่มสร้าง
Config.WorldMaxSlots = 5 -- เก็บโลกได้สูงสุดกี่โลกต่อคน
Config.WorldNightGate = 20 -- เข้าห้องโลกได้ถึงคืน = คืนที่ตัวเองเคยรอดไกลสุด + เท่านี้ (ยังไม่เคยเล่น = คืน 20)
Config.WorldMaxSize = 8 -- คนในห้องโลกสูงสุด (เซิร์ฟเวอร์ทีมต้องรับได้ >= เท่านี้: Creator Hub > Places > Server size)
-- ล้มหมดทั้งทีม: รอให้กดคืนชีพก่อนแพ้กี่วินาที (มีสินค้าคืนชีพ/ตั๋วคืนชีพ) · ไม่มี = 2 วินาทีเหมือนเดิม
Config.WipeGrace = 30
-- ป้าย Roblox: Stat = ค่าในเซฟที่ใช้เช็ก, Need = ต้องถึงเท่าไร
Config.Badges = {
	{ Id = "Welcome", BadgeId = 0, Name = "Welcome to the Wilds", Stat = "Joined", Need = 1 },
	{ Id = "Night5", BadgeId = 0, Name = "Survive to Night 5", Stat = "BestNight", Need = 5 },
	{ Id = "Night10", BadgeId = 0, Name = "Survive to Night 10", Stat = "BestNight", Need = 10 },
	{ Id = "Night25", BadgeId = 0, Name = "Survive to Night 25", Stat = "BestNight", Need = 25 },
	{ Id = "Night50", BadgeId = 0, Name = "Survive to Night 50", Stat = "BestNight", Need = 50 },
	{ Id = "Night99", BadgeId = 0, Name = "Conquer 99 Nights", Stat = "BestNight", Need = 99 },
	{ Id = "Night150", BadgeId = 0, Name = "Legend of the Wilds (150 Nights)", Stat = "BestNight", Need = 150 },
	{ Id = "Boss1", BadgeId = 0, Name = "Beast Slayer", Stat = "BossKills", Need = 1 },
	{ Id = "Spirits4", BadgeId = 0, Name = "Guardian of Four Elements", Stat = "TrueEndings", Need = 1 },
	{ Id = "Kills250", BadgeId = 0, Name = "Master Hunter (250 kills)", Stat = "Kills", Need = 250 },
}

---------------------------------------------------------------- การทดสอบ
-- ReplicatedStorage.ASAutoTest มีอยู่ = โหมดทดสอบ: แมพเล็ก เวลาเร็ว
function Config.ApplyTestOverrides()
	Config.MapSize = 2048
	Config.DayLength = 80
	Config.FirstDayBonus = 0
	Config.NightLength = 35
	Config.DuskLength = 8
	Config.PropDensity = 0.5
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">ItemModels</string><ProtectedString name="Source"><![CDATA[--[[
	ItemModels — โมเดลไอเทมจาก Creator Store (ReplicatedStorage.Assets.Items.<ItemId>)
	ItemModels.Has(id)
	ItemModels.Clone(id, size, opts) -> Model (ด้านยาวสุด = size stud) · opts.Ground = จุดหมุนที่พื้นตรงกลาง (ไม่งั้นกึ่งกลางกล่อง) · opts.Yaw = หมุน (องศา)
	คืนค่า model, ขนาดกล่องหลังย่อขยาย
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Items = require(script.Parent.Items)

local ItemModels = {}

-- Items.Data[id].Model = ใช้โมเดลของไอเทมอื่น (เช่น หัวใจอสูร 4 ธาตุใช้โมเดล BeastHeart แล้วย้อมสี)
local function source(id)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Items")
	local d = Items.Data[id]
	return folder and (folder:FindFirstChild(id) or (d and d.Model and folder:FindFirstChild(d.Model)))
end

-- ย้อมสีโมเดล (Items.Data[id].Tint): ถอดเท็กซ์เจอร์เดิม (สีแดงทับสีใหม่หมด) แล้วใช้สีชิ้นแทน
function ItemModels.Tint(m, id)
	local d = Items.Data[id]
	local c = d and d.Tint
	if not c then
		return
	end
	for _, x in ipairs(m:GetDescendants()) do
		if x:IsA("SpecialMesh") then
			x.TextureId = ""
			x.VertexColor = Vector3.one
		elseif x:IsA("BasePart") then
			x.Material = Enum.Material.SmoothPlastic
			x.Color = c
			if x:IsA("MeshPart") then
				x.TextureID = ""
			end
		end
	end
end

function ItemModels.Has(id)
	return source(id) ~= nil
end

function ItemModels.Clone(id, size, opts)
	opts = opts or {}
	local src = source(id)
	if not src then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = id
	for _, c in ipairs(src:GetChildren()) do
		c:Clone().Parent = m
	end
	ItemModels.Tint(m, id)
	-- ตัดของที่ไม่ใช่หน้าตา (สคริปต์/เสียง/GUI ที่ติดมากับโมเดล)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("GuiBase") or d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
			d:Destroy()
		end
	end
	if opts.Yaw then
		-- หมุนรอบแกนตั้งก่อนจัดตำแหน่ง (ให้ด้านหน้าของโมเดลตรงกับทิศที่เกมใช้)
		local r = CFrame.Angles(0, math.rad(opts.Yaw), 0)
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CFrame = r * p.CFrame
			end
		end
	end
	local _, box = m:GetBoundingBox()
	local k = size / math.max(box.X, box.Y, box.Z, 0.01)
	pcall(function()
		m:ScaleTo(k)
	end)
	-- จัดตำแหน่ง: กล่องรวมอยู่กลางจุดกำเนิด (หรือฐานกล่องอยู่ที่พื้น)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), -Vector3.new(math.huge, math.huge, math.huge)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			local h = p.Size / 2
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = p.CFrame * Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)
						lo, hi = lo:Min(c), hi:Max(c)
					end
				end
			end
		end
	end
	local mid = (lo + hi) / 2
	local target = opts.Ground and Vector3.new(mid.X, lo.Y, mid.Z) or mid
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = p.CFrame - target
		end
	end
	m.WorldPivot = CFrame.new()
	return m, hi - lo
end

return ItemModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">ItemThumbs</string><ProtectedString name="Source"><![CDATA[--[[
	ItemThumbs — เลขโมเดลต้นฉบับใน Creator Store ของแต่ละไอเทม (สร้างจาก referent ใน assets/rbxm/Items + Weapons)
