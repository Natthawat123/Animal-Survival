Items.Data = {
	-- ทรัพยากรพื้นฐาน
	Wood = { Name = "Wood", Thai = "Wood", Category = "Resource", Fuel = 15, Color = Color3.fromRGB(150, 104, 62) },
	Stone = { Name = "Stone", Thai = "Stone", Category = "Resource", Color = Color3.fromRGB(150, 150, 156) },
