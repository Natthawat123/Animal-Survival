function Biomes.Get(id)
	return Biomes.Data[id]
end

return Biomes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Classes</string><ProtectedString name="Source"><![CDATA[--[[
	Classes — คลาสตัวละคร (ซื้อด้วย Ruby ♦️ เซฟข้ามรอบ) แบบร้านคลาสของ 99 Nights
	  - ดาว 1-5 (ความหายาก) · เลเวล 1-3 ต่อคลาส: เก็บสถิติตอนเล่นคลาสนั้นจนครบ หรือจ่าย Ruby "ข้าม"
	  - ทักษะเลเวล 1/2/3 ปลดตามเลเวล (Perks ของเลเวลหลังทับค่าของเลเวลก่อน)
	  - สต็อกร้านสุ่มใหม่ทุกวัน (UTC) ต่อผู้เล่น — คลาสที่ "ไม่มีสต๊อค" ซื้อไม่ได้จนกว่าจะรีโรล/วันใหม่

	Perks ที่ระบบอื่นอ่าน:
		ChopMult, MineMult, DamageMult, BuildDiscount, WallHealthMult, SpeedMult, StaminaMult, EssenceMult,
		ElementDamageMult, FuelDrainMult, HungerMult, HealMult, DamageTakenMult, ExtraDrops, WildPeace,
		MaxHealthBonus (+เลือดสูงสุด), Regen (ฟื้นเลือด/วินาที)
]]

local Classes = {}

Classes.Order = {
	"Survivor", "Forager", "Lumberjack", "Medic", "Hunter", "Builder", "Scout", "Elementalist",
}

Classes.MaxLevel = 3

-- Skills[1..3] = ทักษะเลเวล 1/2/3: { Name, Text, Perks } — Perks ของเลเวลหลังทับค่าเดียวกันของเลเวลก่อน
Classes.Data = {
	Survivor = {
		Name = "Survivor", Thai = "ผู้รอดชีวิต", Role = "รอบด้าน", Stars = 1, Price = 0, Icon = "🔥",
		StartItems = { OldAxe = 1, Torch = 1 },
		Skills = {
			{ Name = "ใจไม่ยอมแพ้", Text = "เลือดสูงสุด +15 · หิวช้าลง 10%", Perks = { MaxHealthBonus = 15, HungerMult = 0.9 } },
			{ Name = "นักเดินทาง", Text = "วิ่งเร็วขึ้น 5% · สตามิน่า +15%", Perks = { SpeedMult = 1.05, StaminaMult = 1.15 } },
			{ Name = "สัญชาตญาณรอด", Text = "เลือดสูงสุด +25 · ฟื้นเลือด 0.3 ต่อวินาที", Perks = { MaxHealthBonus = 25, Regen = 0.3 } },
		},
	},
	Forager = {
		Name = "Forager", Thai = "นักหาของป่า", Role = "เสบียง", Stars = 2, Price = 100, Icon = "🍓",
		StartItems = { OldAxe = 1, Berries = 6 },
		Skills = {
			{ Name = "ตะกร้าใหญ่", Text = "เก็บของ/ล่าสัตว์ ได้ของเพิ่ม +1 ชิ้น", Perks = { ExtraDrops = 1 } },
			{ Name = "รู้จักของกิน", Text = "หิวช้าลง 25% · อาหาร/ยาฟื้นเลือดแรงขึ้น 20%", Perks = { HungerMult = 0.75, HealMult = 1.2 } },
			{ Name = "เก็บเกี่ยวเต็มมือ", Text = "ได้ของเพิ่มเป็น +2 ชิ้น", Perks = { ExtraDrops = 2 } },
		},
	},
	Lumberjack = {
		Name = "Lumberjack", Thai = "คนตัดไม้", Role = "เก็บทรัพยากร", Stars = 2, Price = 150, Icon = "🪓",
		StartItems = { StoneAxe = 1 },
		Skills = {
			{ Name = "แขนท่อนซุง", Text = "ตัดไม้แรง x1.6", Perks = { ChopMult = 1.6 } },
			{ Name = "ขวานคู่ใจ", Text = "ทุบหินและแร่แรง x1.4 · สตามิน่า +20%", Perks = { MineMult = 1.4, StaminaMult = 1.2 } },
			{ Name = "ล้มป่าในพริบตา", Text = "ตัดไม้แรง x2.2 · ทุบหิน/แร่แรง x1.6", Perks = { ChopMult = 2.2, MineMult = 1.6 } },
		},
	},
	Medic = {
		Name = "Medic", Thai = "หมอสนาม", Role = "สนับสนุน", Stars = 2, Price = 200, Icon = "🩹",
		StartItems = { OldAxe = 1, Bandage = 3 },
		Skills = {
			{ Name = "มือหมอ", Text = "ผ้าพันแผล ยา และการชุบชีวิตเพื่อน ฮีลแรง x1.5", Perks = { HealMult = 1.5 } },
			{ Name = "ร่างกายฟื้นตัว", Text = "ฟื้นเลือด 0.5 ต่อวินาทีตลอดเวลา", Perks = { Regen = 0.5 } },
			{ Name = "แพทย์สนามรบ", Text = "ฮีลแรง x2 · เลือดสูงสุด +15", Perks = { HealMult = 2, MaxHealthBonus = 15 } },
		},
	},
	Hunter = {
		Name = "Hunter", Thai = "นายพราน", Role = "ต่อสู้", Stars = 3, Price = 350, Icon = "🏹",
		StartItems = { OldAxe = 1, Bow = 1 },
		Skills = {
			{ Name = "ตาเหยี่ยว", Text = "ดาเมจทุกอาวุธ +15%", Perks = { DamageMult = 1.15 } },
			{ Name = "ล่าไม่พลาด", Text = "ดาเมจ +25% · ล่าสัตว์/เก็บของได้เพิ่ม +1 ชิ้น", Perks = { DamageMult = 1.25, ExtraDrops = 1 } },
			{ Name = "นักล่าจ่าฝูง", Text = "ดาเมจ +40% · วิ่งเร็วขึ้น 5%", Perks = { DamageMult = 1.4, SpeedMult = 1.05 } },
		},
	},
	Builder = {
		Name = "Builder", Thai = "ช่างสร้าง", Role = "ป้องกันฐาน", Stars = 3, Price = 400, Icon = "🔨",
		StartItems = { OldAxe = 1, LogWall = 2 },
		Skills = {
			{ Name = "ช่างประหยัด", Text = "สร้างสิ่งก่อสร้างใช้วัตถุดิบน้อยลง 20%", Perks = { BuildDiscount = 0.2 } },
			{ Name = "ไม้เนื้อแข็ง", Text = "กำแพงและสิ่งก่อสร้างถึกขึ้น x1.5", Perks = { WallHealthMult = 1.5 } },
			{ Name = "ป้อมปราการ", Text = "วัตถุดิบน้อยลง 35% · สิ่งก่อสร้างถึก x2", Perks = { BuildDiscount = 0.35, WallHealthMult = 2 } },
		},
	},
	Scout = {
		Name = "Scout", Thai = "หน่วยลาดตระเวน", Role = "สำรวจ", Stars = 4, Price = 650, Icon = "🧭",
		StartItems = { OldAxe = 1, Torch = 1 },
		Skills = {
			{ Name = "ขาไว", Text = "วิ่งเร็วขึ้น 12%", Perks = { SpeedMult = 1.12 } },
			{ Name = "ปอดเหล็ก", Text = "สตามิน่า x1.6 · หิวช้าลง 10%", Perks = { StaminaMult = 1.6, HungerMult = 0.9 } },
			{ Name = "เงาแห่งพงไพร", Text = "วิ่งเร็วขึ้น 20% · สตามิน่า x2 · ได้ของเพิ่ม +1 ชิ้น", Perks = { SpeedMult = 1.2, StaminaMult = 2, ExtraDrops = 1 } },
		},
	},

	Elementalist = {
		Name = "Elementalist", Thai = "จอมเวทธาตุ", Role = "เวทธาตุ", Stars = 5, Price = 1000, Icon = "🔮",
		StartItems = { OldAxe = 1, EmberStaff = 1 }, -- ขวาน (ทุกคลาสมี) + คทาเพลิง (ยิงลูกไฟ + ฟาดตัดไม้ได้)
		Skills = {
			{ Name = "สัมผัสธาตุ", Text = "เก็บแก่นธาตุได้ x2 · อาวุธธาตุแรงขึ้น 15% · ร่างบาง เลือดสูงสุด -10", Perks = { EssenceMult = 2, ElementDamageMult = 1.15, MaxHealthBonus = -10 } },
			{ Name = "พลังธาตุ", Text = "อาวุธธาตุแรงขึ้น 35%", Perks = { ElementDamageMult = 1.35 } },
			{ Name = "ผู้ควบคุมธาตุ", Text = "แก่นธาตุ x3 · อาวุธธาตุแรงขึ้น 60%", Perks = { EssenceMult = 3, ElementDamageMult = 1.6 } },
		},
	},

}

-- ใช้กับโค้ดเก่า: Perks / Desc = ทักษะเลเวล 1
for _, c in pairs(Classes.Data) do
	c.Perks = c.Skills[1].Perks
	c.Desc = c.Skills[1].Name .. ": " .. c.Skills[1].Text
end

-- Perks รวมถึงเลเวลที่ปลดแล้ว
function Classes.PerksFor(id, level)
	local c = Classes.Data[id] or Classes.Data.Survivor
	local out = {}
	for lv = 1, math.clamp(level or 1, 1, Classes.MaxLevel) do
		for k, v in pairs(c.Skills[lv].Perks) do
			out[k] = v
		end
	end
	return out
end

---------------------------------------------------------------- เลเวล
-- ข้อกำหนดเพื่อขึ้นเลเวล (สถิติที่เก็บตอนสวมใส่คลาสนั้น)
Classes.StatNames = { Kills = "ล่าสัตว์", Nights = "รอดคืน" }
Classes.StatOrder = { "Kills", "Nights" }

function Classes.Requirement(id, level)
	local s = (Classes.Data[id] or Classes.Data.Survivor).Stars
	if level == 2 then
		return { Kills = 40 + 20 * s, Nights = 3 + s }
	elseif level == 3 then
		return { Kills = 200 + 100 * s, Nights = 10 + 4 * s }
	end
	return nil
end

-- จ่าย Ruby ข้ามไปเลเวลถัดไป
function Classes.SkipPrice(id, level)
	local s = (Classes.Data[id] or Classes.Data.Survivor).Stars
	return level == 2 and 60 * s or 180 * s
end

---------------------------------------------------------------- สต็อกร้าน
Classes.RerollPrice = 25
Classes.StockOdds = { [1] = 0.9, [2] = 0.75, [3] = 0.55, [4] = 0.35, [5] = 0.2 } -- โอกาสมีของต่อดาว
Classes.StarColor = {
	[1] = Color3.fromRGB(170, 176, 186), [2] = Color3.fromRGB(110, 210, 90), [3] = Color3.fromRGB(70, 160, 255),
	[4] = Color3.fromRGB(190, 100, 255), [5] = Color3.fromRGB(255, 160, 40),
}

function Classes.Day(now)
	return math.floor((now or os.time()) / 86400)
end

-- วินาทีที่เหลือก่อนสต็อกรีเซ็ต
function Classes.SecondsToRestock(now)
	now = now or os.time()
	return (Classes.Day(now) + 1) * 86400 - now
end

-- ชุดคลาสที่มีของในวัน/รอบรีโรลนี้ (ผลเหมือนกันทั้ง server และ client)
function Classes.Stock(day, roll, userId)
	local rng = Random.new(day * 7919 + (roll or 0) * 104729 + ((userId or 0) % 100000))
	local stock = {}
	local count = 0
	for _, id in ipairs(Classes.Order) do
		local c = Classes.Data[id]
		if c.Price > 0 and rng:NextNumber() < Classes.StockOdds[c.Stars] then
			stock[id] = true
			count += 1
		end
	end
	if count == 0 then
		stock.Forager = true
	end
	return stock
end

---------------------------------------------------------------- Ruby
-- Ruby ที่ได้ตอนรอดถึงคืน
Classes.NightRewards = { [5] = 5, [10] = 10, [25] = 20, [50] = 40, [75] = 60, [99] = 150 }
Classes.BossReward = 25
Classes.SpiritReward = 15
Classes.DailyReward = 5 -- หม้อรางวัลประจำวันในล็อบบี้

return Classes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	Config — ค่าตั้งต้นของทั้งเกม (แก้ตรงนี้ที่เดียว)
	ANIMAL SURVIVAL : 99 Nights of the Elements
]]

local Config = {}

Config.GameName = "ANIMAL SURVIVAL"
Config.Subtitle = "Legends of the Four Elements"

---------------------------------------------------------------- แมพ
-- ขนาดแมพ (ด้านละกี่ studs) 6144 = ~1.7 กม. ต่อด้าน / ใส่ 8192 ได้ถ้าเครื่องเซิร์ฟเวอร์ไหว
Config.MapSize = 6144
Config.VoxelRes = 4 -- ความละเอียด Terrain (ห้ามเปลี่ยน)
Config.ChunkVoxels = 48 -- ขนาดชิ้นที่สร้างทีละครั้ง (48 voxel = 192 studs)
Config.WaterLevel = 20 -- ระดับน้ำทะเล (Y)
Config.Seed = nil -- nil = สุ่มใหม่ทุกเซิร์ฟเวอร์ (ไบโอมสลับตำแหน่งทุกรอบ)
Config.PreviewSeed = 99 -- seed ที่ปลั๊กอินใช้สร้างแมพตัวอย่างตอน Edit
Config.HeartRadius = 260 -- ทุ่งกลางรอบกองไฟ (ราบเรียบ ปลอดภัยตอนกลางวัน)
Config.EdgeOcean = 420 -- ขอบแมพเป็นทะเลลึก กันคนออกนอกแมพ
Config.PropDensity = 1.0 -- ความหนาแน่นต้นไม้/หิน (ลดได้ถ้าเครื่องช้า)

---------------------------------------------------------------- เวลา
Config.TotalNights = 99 -- รอดครบ 99 คืน = "พิชิต" (จบเนื้อเรื่อง) แต่เล่นต่อได้ไม่จำกัดเพื่อทำสถิติ
Config.EndlessBossEvery = 25 -- หลังคืน 99: บอสวนกลับมาบุกทุกกี่คืน (124, 149, ...)
Config.DayLength = 150 -- วินาที (2:30 นาที รวมช่วงพลบค่ำ)
Config.DuskLength = 25 -- ช่วงพลบค่ำ (ท้ายกลางวัน) เตือนว่าฝูงกำลังมา
Config.NightLength = 60 -- 1 นาที
Config.FirstDayBonus = 0 -- วันแรกยาวเท่าวันอื่น

---------------------------------------------------------------- ผู้เล่น
Config.HungerMax = 100
Config.HungerDrainPerSec = 100 / 540 -- หมดใน ~9 นาที
Config.StarveDamagePerSec = 2.5
Config.DownedTime = 30 -- ล้มแล้วรอเพื่อนช่วยกี่วินาที
Config.ReviveTime = 3.5
Config.ReviveRange = 10
Config.BaseWalkSpeed = 18
Config.SprintSpeed = 28
Config.StaminaMax = 100
Config.InteractRange = 14
Config.BuildRange = 60

---------------------------------------------------------------- สัตว์
-- สัตว์เกิดได้เฉพาะตัวที่มีโมเดลแล้ว (assets/rbxm/Animals/<Id>.rbxmx) — ตอนนี้มีแค่บอส 4 ไบโอม
Config.AnimalsEnabled = true
Config.LootMult = 0.7 -- ตัวคูณของดรอปทั้งเกม (วัตถุดิบ/แก่นธาตุ เท่านั้น — อาหาร/ยาไม่ลด)
Config.MaxWildAnimals = 70 -- สัตว์ป่ากลางวันทั้งแมพ
Config.WildSpawnRadius = { Min = 140, Max = 420 } -- เกิดรอบตัวผู้เล่น
Config.WildDespawnRadius = 900
Config.RaidSpawnRadius = { Min = 330, Max = 470 } -- ฝูงบุกเกิดรอบกองไฟ
Config.MaxRaidAnimals = 55
Config.AnimalThinkRate = 0.25 -- วินาทีต่อรอบคิดของ AI

---------------------------------------------------------------- นักพัฒนา
-- UserId ที่ใช้เครื่องมือ DEV (F8) ในเกมจริงได้ (ใน Studio และเจ้าของเกมใช้ได้เสมอ)
Config.DevUserIds = {}

---------------------------------------------------------------- อันดับ (ทั้งเกม ทุกเซิร์ฟเวอร์)
Config.LeaderboardStore = "BestNight_v1" -- OrderedDataStore ของ "คืนที่รอดนานสุด"
Config.LeaderboardSize = 10

---------------------------------------------------------------- ร้านค้า Robux / Game Pass / Badge
-- ⚠ ต้องสร้างของจริงใน Creator Hub ก่อน แล้วเอาเลข ID มาใส่ตรงนี้ (0 = ยังไม่ตั้ง → ปุ่มขึ้นว่า "เร็วๆ นี้" ไม่พัง)
--   Developer Product: Creator Hub → เกม → การสร้างรายได้ → ผลิตภัณฑ์สำหรับนักพัฒนา
--   Game Pass       : Creator Hub → เกม → การสร้างรายได้ → บัตรผ่าน
--   Badge           : Creator Hub → เกม → การมีส่วนร่วม → ป้าย
Config.DiamondPacks = {
	{ Id = "Pack1", ProductId = 0, Diamonds = 60, Bonus = 0, Robux = 25, Icon = "♦️", Name = "ถุง Ruby เล็ก" },
	{ Id = "Pack2", ProductId = 0, Diamonds = 150, Bonus = 15, Robux = 59, Icon = "♦️", Name = "ถุง Ruby" },
	{ Id = "Pack3", ProductId = 0, Diamonds = 320, Bonus = 50, Robux = 119, Icon = "💰", Name = "หีบ Ruby", Tag = "ยอดนิยม" },
	{ Id = "Pack4", ProductId = 0, Diamonds = 700, Bonus = 150, Robux = 239, Icon = "👑", Name = "กอง Ruby มหึมา" },
	{ Id = "Pack5", ProductId = 0, Diamonds = 1500, Bonus = 400, Robux = 479, Icon = "🏆", Name = "ขุมทรัพย์ราชา", Tag = "คุ้มสุด" },
}
Config.GamePasses = {
	{ Id = "VIP", PassId = 0, Robux = 199, Icon = "👑", Name = "VIP", Desc = "Ruby ที่ได้จากการเล่น x2 · ป้าย VIP บนหัว · ชื่อสีทองในกระดานอันดับ" },
	{ Id = "GiantSack", PassId = 0, Robux = 149, Icon = "🎒", Name = "กระสอบยักษ์", Desc = "เริ่มทุกรอบด้วยกระสอบยักษ์ (ใส่ของได้มากสุด) แทนกระสอบเก่า" },
	{ Id = "Medic", PassId = 0, Robux = 99, Icon = "🩹", Name = "หน่วยแพทย์", Desc = "เริ่มทุกรอบด้วยผ้าพันแผล 3 + ชุดปฐมพยาบาล 1 (ช่วยเพื่อนที่ล้มได้ทันที)" },
	{ Id = "Torch", PassId = 0, Robux = 79, Icon = "🔥", Name = "คบเพลิงนิรันดร์", Desc = "เริ่มทุกรอบพร้อมคบเพลิง (ไล่กวางกลวง) + ถ่านหิน 5" },
	{ Id = "SeasonPass", PassId = 0, Robux = 299, Icon = "🎟", Name = "Season Pass", Desc = "ปลดล็อกสายพรีเมียมของ Season Pass ทุกซีซั่น · Ruby มากขึ้น + ฉายา/สีฉายาพิเศษ" },
}
-- ป้าย Roblox: Stat = ค่าในเซฟที่ใช้เช็ก, Need = ต้องถึงเท่าไร
Config.Badges = {
	{ Id = "Welcome", BadgeId = 0, Name = "ยินดีต้อนรับสู่ป่า", Stat = "Joined", Need = 1 },
	{ Id = "Night5", BadgeId = 0, Name = "รอดถึงคืนที่ 5", Stat = "BestNight", Need = 5 },
	{ Id = "Night10", BadgeId = 0, Name = "รอดถึงคืนที่ 10", Stat = "BestNight", Need = 10 },
	{ Id = "Night25", BadgeId = 0, Name = "รอดถึงคืนที่ 25", Stat = "BestNight", Need = 25 },
	{ Id = "Night50", BadgeId = 0, Name = "รอดถึงคืนที่ 50", Stat = "BestNight", Need = 50 },
	{ Id = "Night99", BadgeId = 0, Name = "พิชิต 99 คืน", Stat = "BestNight", Need = 99 },
	{ Id = "Night150", BadgeId = 0, Name = "ตำนานแห่งป่า (150 คืน)", Stat = "BestNight", Need = 150 },
	{ Id = "Boss1", BadgeId = 0, Name = "ผู้ปราบอสูร", Stat = "BossKills", Need = 1 },
	{ Id = "Spirits4", BadgeId = 0, Name = "ผู้พิทักษ์สี่ธาตุ", Stat = "TrueEndings", Need = 1 },
	{ Id = "Kills250", BadgeId = 0, Name = "นายพรานผู้ยิ่งใหญ่ (250 ตัว)", Stat = "Kills", Need = 250 },
}

---------------------------------------------------------------- การทดสอบ
-- ReplicatedStorage.ASAutoTest มีอยู่ = โหมดทดสอบ: แมพเล็ก เวลาเร็ว
function Config.ApplyTestOverrides()
	Config.MapSize = 2048
	Config.DayLength = 80
	Config.FirstDayBonus = 0
	Config.NightLength = 35
	Config.DuskLength = 8
	Config.PropDensity = 0.5
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">ItemModels</string><ProtectedString name="Source"><![CDATA[--[[
	ItemModels — โมเดลไอเทมจาก Creator Store (ReplicatedStorage.Assets.Items.<ItemId>)
	ItemModels.Has(id)
	ItemModels.Clone(id, size, opts) -> Model (ด้านยาวสุด = size stud) · opts.Ground = จุดหมุนที่พื้นตรงกลาง (ไม่งั้นกึ่งกลางกล่อง) · opts.Yaw = หมุน (องศา)
	คืนค่า model, ขนาดกล่องหลังย่อขยาย
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemModels = {}

local function source(id)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Items")
	return folder and folder:FindFirstChild(id)
end

function ItemModels.Has(id)
	return source(id) ~= nil
end

function ItemModels.Clone(id, size, opts)
	opts = opts or {}
	local src = source(id)
	if not src then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = id
	for _, c in ipairs(src:GetChildren()) do
		c:Clone().Parent = m
	end
	-- ตัดของที่ไม่ใช่หน้าตา (สคริปต์/เสียง/GUI ที่ติดมากับโมเดล)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("GuiBase") or d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
			d:Destroy()
		end
	end
	if opts.Yaw then
		-- หมุนรอบแกนตั้งก่อนจัดตำแหน่ง (ให้ด้านหน้าของโมเดลตรงกับทิศที่เกมใช้)
		local r = CFrame.Angles(0, math.rad(opts.Yaw), 0)
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CFrame = r * p.CFrame
			end
		end
	end
	local _, box = m:GetBoundingBox()
	local k = size / math.max(box.X, box.Y, box.Z, 0.01)
	pcall(function()
		m:ScaleTo(k)
	end)
	-- จัดตำแหน่ง: กล่องรวมอยู่กลางจุดกำเนิด (หรือฐานกล่องอยู่ที่พื้น)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), -Vector3.new(math.huge, math.huge, math.huge)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			local h = p.Size / 2
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = p.CFrame * Vector3.new(h.X * sx, h.Y * sy, h.Z * sz)
						lo, hi = lo:Min(c), hi:Max(c)
					end
				end
			end
		end
	end
	local mid = (lo + hi) / 2
	local target = opts.Ground and Vector3.new(mid.X, lo.Y, mid.Z) or mid
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = p.CFrame - target
		end
	end
	m.WorldPivot = CFrame.new()
	return m, hi - lo
end

return ItemModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">ItemThumbs</string><ProtectedString name="Source"><![CDATA[--[[
	ItemThumbs — เลขโมเดลต้นฉบับใน Creator Store ของแต่ละไอเทม (สร้างจาก referent ใน assets/rbxm/Items + Weapons)
	ใช้ทำรูปไอคอน rbxthumb:// (เช่น ไอคอนช่องเครื่องมือของ Roblox)
]]

local ItemThumbs = {
	Bandage = 12857564167,
	BeastHeart = 108474997,
	Bed = 13450150185,
	Berries = 107227111280509,
	Bow = 222117411,
	Coal = 277453200,
	CookPot = 81103558244121,
	CookedMeat = 342730254,
	EmberBlade = 244648837,
	EmberStaff = 52093942,
	EmberShard = 80654769388421,
	EmberTotem = 4638108969,
	FarmPlot = 93660859808046,
	Fiber = 11814511082,
	FourfoldBlade = 8300795842,
	GaleBow = 55918184,
	GaleFeather = 11667163117,
	GaleTotem = 80994968560699,
	GiantSack = 77231308653953,
	GoodSack = 8846237519,
	Iron = 17134887215,
	IronAxe = 114164136130143,
	Lantern = 87570116399197,
	LogWall = 119453325119661,
	Medkit = 6712879750,
	OldAxe = 122042211239954,
	OldSack = 18523642844,
	Pelt = 9482961833,
	Pickaxe = 101775581284008,
	RawMeat = 17251885494,
	Spear = 4239209497,
	Stew = 8807056485,
	Stone = 118694975427907,
	StoneAxe = 88566817567680,
	StoneWall = 8988297469,
	SunBeacon = 9216601077,
	TerraCore = 7820798627,
	TerraHammer = 13106821277,
	TerraTotem = 4124162583,
	TidalTrident = 129333375158140,
	TidePearl = 76238014304806,
	Torch = 118933541,
	Wood = 248338900,
}

function ItemThumbs.Url(id)
	local aid = ItemThumbs[id]
	return aid and string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", aid) or ""
end

return ItemThumbs
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--[[
	Items — ไอเทมทั้งหมด
	Category: Resource / Food / Essence / Medical / Tool / Structure / Relic
	Fuel = ค่าเชื้อเพลิงเมื่อโยนเข้ากองไฟ
]]

local Items = {}

Items.Data = {
	-- ทรัพยากรพื้นฐาน
	Wood = { Name = "Wood", Thai = "ไม้", Category = "Resource", Fuel = 15, Color = Color3.fromRGB(150, 104, 62) },
	Stone = { Name = "Stone", Thai = "หิน", Category = "Resource", Color = Color3.fromRGB(150, 150, 156) },
	Fiber = { Name = "Fiber", Thai = "เส้นใย", Category = "Resource", Color = Color3.fromRGB(170, 200, 110) },
	Iron = { Name = "Iron Ore", Thai = "แร่เหล็ก", Category = "Resource", Color = Color3.fromRGB(196, 150, 120) },
