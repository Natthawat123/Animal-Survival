	Underwater = true, NoCollide = true, Scale = { 0.8, 1.8 },
	Build = function()
		local rng = Random.new(77)
		local palette = { C(255, 110, 150), C(255, 160, 80), C(120, 230, 255), C(190, 120, 255) }
