		Spirit = "EmberPup",
	},
}

-- บรรยากาศตอนกลางคืน (ผสมทับสีของไบโอม)
Biomes.Night = {
	Normal = {
		Color = Color3.fromRGB(58, 72, 112), Decay = Color3.fromRGB(22, 26, 48), DensityAdd = 0.08,
		Tint = Color3.fromRGB(186, 204, 255), Saturation = -0.1, Contrast = 0.14,
	},
