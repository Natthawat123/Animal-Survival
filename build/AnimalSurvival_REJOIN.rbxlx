		Thai = "ทะเลสาบกระแสน้ำวน",
		Color = Color3.fromRGB(70, 170, 255),
		Element = "Water",
		Terrain = { Top = "Sand", Sub = "Sand", Cliff = "Limestone", Shore = "Salt" },
		Atmosphere = {
