<Item class="StarterGui" referent="RBX0000009A"><Properties><string name="Name">StarterGui</string><bool name="ResetPlayerGuiOnSpawn">false</bool></Properties></Item>
<Item class="StarterPlayer" referent="RBX0000009E"><Properties><string name="Name">StarterPlayer</string><float name="CharacterWalkSpeed">18</float><float name="CameraMaxZoomDistance">90</float></Properties><Item class="StarterPlayerScripts" referent="RBX0000009B"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000091"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX0000006A"><Properties><string name="Name">AmbientFX</string><ProtectedString name="Source"><![CDATA[--[[
	AmbientFX — อนุภาคลอยรอบตัว (เปลี่ยนตามไบโอม/เวลา) + ลมพัดขึ้นเกาะลอยฟ้า
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AmbientFX = {}

local TEX = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Rate = 0
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = parent
	return e
end

local NS = NumberSequence.new
local NSK = NumberSequenceKeypoint.new

function AmbientFX.Init(state, atmosphereController)
	local box = Instance.new("Part")
	box.Name = "AmbientBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Transparency = 1
	box.Size = Vector3.new(140, 50, 140)
	box.Parent = Workspace.CurrentCamera

	local fx = {
		Pollen = emitter(box, {
			Texture = TEX.Spark, Lifetime = NumberRange.new(6, 10), Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180),
			Size = NS(0.18), LightEmission = 0.6, Color = ColorSequence.new(Color3.fromRGB(255, 240, 170)),
			Transparency = NS({ NSK(0, 1), NSK(0.2, 0.2), NSK(0.8, 0.2), NSK(1, 1) }), Acceleration = Vector3.new(0.5, -0.1, 0.3),
		}),
		Fireflies = emitter(box, {
			Texture = TEX.Spark, Lifetime = NumberRange.new(4, 8), Speed = NumberRange.new(0.5, 2), SpreadAngle = Vector2.new(180, 180),
			Size = NS({ NSK(0, 0.1), NSK(0.5, 0.4), NSK(1, 0.1) }), LightEmission = 1, LightInfluence = 0,
			Color = ColorSequence.new(Color3.fromRGB(180, 255, 120)), Transparency = NS({ NSK(0, 1), NSK(0.3, 0), NSK(0.7, 0.3), NSK(1, 1) }),
			RotSpeed = NumberRange.new(-30, 30),
		}),
		Mist = emitter(box, {
			Texture = TEX.Smoke, Lifetime = NumberRange.new(8, 12), Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(30, 180),
			Size = NS({ NSK(0, 8), NSK(1, 18) }), LightEmission = 0.1, Color = ColorSequence.new(Color3.fromRGB(220, 236, 245)),
			Transparency = NS({ NSK(0, 1), NSK(0.4, 0.82), NSK(1, 1) }), Acceleration = Vector3.new(1, 0, 0),
		}),
		Wind = emitter(box, {
			Texture = TEX.Smoke, Lifetime = NumberRange.new(1.2, 2), Speed = NumberRange.new(40, 60), SpreadAngle = Vector2.new(4, 4),
			EmissionDirection = Enum.NormalId.Right, Size = NS({ NSK(0, 0.5), NSK(1, 1.5) }), LightEmission = 0.3,
			Color = ColorSequence.new(Color3.fromRGB(240, 246, 255)), Transparency = NS({ NSK(0, 1), NSK(0.3, 0.75), NSK(1, 1) }),
			Squash = NS(-1.5),
		}),
		Snow = emitter(box, {
			Texture = TEX.Spark, Lifetime = NumberRange.new(5, 8), Speed = NumberRange.new(3, 6), SpreadAngle = Vector2.new(20, 20),
			EmissionDirection = Enum.NormalId.Bottom, Size = NS(0.25), LightEmission = 0.4, Color = ColorSequence.new(Color3.new(1, 1, 1)),
			Acceleration = Vector3.new(4, 0, 2),
		}),
		Embers = emitter(box, {
			Texture = TEX.Spark, Lifetime = NumberRange.new(3, 6), Speed = NumberRange.new(2, 6), SpreadAngle = Vector2.new(25, 25),
			EmissionDirection = Enum.NormalId.Top, Size = NS({ NSK(0, 0.35), NSK(1, 0) }), LightEmission = 1, LightInfluence = 0,
			Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 60, 20)), Acceleration = Vector3.new(1, 2, 0.5),
		}),
		Ash = emitter(box, {
			Texture = TEX.Smoke, Lifetime = NumberRange.new(6, 9), Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = Enum.NormalId.Bottom, Size = NS(0.3), Color = ColorSequence.new(Color3.fromRGB(80, 76, 76)),
			Transparency = NS(0.3), RotSpeed = NumberRange.new(-90, 90), Rotation = NumberRange.new(0, 360),
		}),
		BloodMist = emitter(box, {
			Texture = TEX.Smoke, Lifetime = NumberRange.new(8, 12), Speed = NumberRange.new(1, 2), SpreadAngle = Vector2.new(180, 180),
			Size = NS({ NSK(0, 10), NSK(1, 20) }), Color = ColorSequence.new(Color3.fromRGB(140, 20, 24)),
			Transparency = NS({ NSK(0, 1), NSK(0.5, 0.8), NSK(1, 1) }),
		}),
	}

	-- อัตราอนุภาคตามไบโอม (กลางวัน, กลางคืน)
	local RATES = {
		Heart = { Pollen = { 18, 2 }, Fireflies = { 0, 26 }, Mist = { 0, 4 } },
		Lobby = { Fireflies = { 8, 8 } },
		Earth = { Fireflies = { 6, 40 }, Mist = { 2, 6 }, Pollen = { 10, 0 } },
		Water = { Mist = { 4, 5 }, Wind = { 2, 2 } },
		Air = { Wind = { 10, 8 }, Snow = { 30, 40 } },
		Fire = { Embers = { 30, 40 }, Ash = { 25, 25 } },
	}

	local player = Players.LocalPlayer
	local updraftParams = OverlapParams.new()
	updraftParams.FilterType = Enum.RaycastFilterType.Include

	RunService.RenderStepped:Connect(function(dt)
		local cam = Workspace.CurrentCamera
		box.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 4, 0))
		local biome = atmosphereController.Biome or "Heart"
		local nightPhase = state:GetAttribute("Phase") == "Night" and biome ~= "Lobby"
		local rates = RATES[biome] or {}
		for name, e in pairs(fx) do
			local r = rates[name]
			local target = r and (nightPhase and r[2] or r[1]) or 0
			if name == "BloodMist" then
				target = state:GetAttribute("BloodMoon") and nightPhase and 6 or 0
			end
			e.Rate = target * (AmbientFX.RateMult or 1) -- ตั้งค่ากราฟิก: ต่ำ = ลด/ปิดอนุภาคลอย
		end
		-- ลมพัดขึ้น
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			for _, zone in ipairs(CollectionService:GetTagged("Updraft")) do
				if zone:IsA("BasePart") then
					local rel = zone.CFrame:PointToObjectSpace(root.Position)
					local half = zone.Size / 2
					if math.abs(rel.X) < half.X and math.abs(rel.Z) < half.Z and rel.Y > -half.Y and rel.Y < half.Y then
						local v = root.AssemblyLinearVelocity
						root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, 85), v.Z)
					end
				end
			end
		end
	end)
end

return AmbientFX
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006B"><Properties><string name="Name">AnimalAnimator</string><ProtectedString name="Source"><![CDATA[--[[
	AnimalAnimator — อนิเมชันแบบคำนวณสด (procedural) ของสัตว์ทุกตัว บนเครื่องผู้เล่น
	ตั้งค่า Motor6D.Transform ทุกเฟรม (ไม่ต้องอัปโหลดอนิเมชัน ไม่กินเน็ต)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AnimalSkins = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("AnimalSkins"))

local AnimalAnimator = {}

local rigs = {} -- [model] = rig
local sin, cos, abs, clamp = math.sin, math.cos, math.abs, math.clamp
local ANG = CFrame.Angles
local CF = CFrame.new

local BossAnimator = require(script.Parent:WaitForChild("BossAnimator"))
local ClipAnimator = require(script.Parent:WaitForChild("ClipAnimator"))

local function collect(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local motors = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	local rig = {
		Model = model, Root = root, M = motors, Phase = math.random() * 10, Seed = math.random() * 100,
		Template = model:GetAttribute("Template") or "Quadruped", Id = model:GetAttribute("AnimalId"),
		AttackT = -10, LastAttack = model:GetAttribute("AttackAt") or 0, DeadT = nil, Size = model:GetExtentsSize(),
	}
	model:GetAttributeChangedSignal("AttackAt"):Connect(function()
		rig.AttackT = os.clock()
		rig.AttackKind = model:GetAttribute("AttackKind") or "Bite"
	end)
	model:GetAttributeChangedSignal("Dead"):Connect(function()
		if model:GetAttribute("Dead") and not rig.DeadT then
			rig.DeadT = os.clock()
		end
	end)
	model:GetAttributeChangedSignal("Vanish"):Connect(function()
		rig.VanishT = os.clock()
	end)
	return rig
end

local function add(model)
	if rigs[model] or not model:IsA("Model") then
		return
	end
	task.defer(function()
		if not model.Parent then
			return
		end
		model:WaitForChild("HumanoidRootPart", 5)
		if model:GetAttribute("MeshSkin") then
			pcall(AnimalSkins.Skin, model)
		end
		local rig = collect(model)
		if rig then
			rigs[model] = rig
			-- โมเดลมีผิว+กระดูก (บอสจาก Import 3D): รอผิวโหลดแล้วผูกกระดูก
			if BossAnimator.Has(model) and model:WaitForChild("Skin", 10) then
				pcall(BossAnimator.Attach, rig)
			elseif ClipAnimator.Has(model) and model:WaitForChild("Skin", 10) then
				pcall(ClipAnimator.Attach, rig) -- ท่าจากไฟล์ (Meshy) เล่นเอง
			end
		end
	end)
end

local function setT(rig, name, cf)
	local m = rig.M[name]
	if m then
		m.Transform = cf
	end
end

-- ท่าโจมตี (0..1) ตามเวลาตั้งแต่เริ่ม
local function attackCurve(rig, now)
	local t = now - rig.AttackT
	local kind = rig.AttackKind or "Bite"
	local dur = (kind == "Roar" or kind == "Stare") and 1.1 or 0.45
	if t < 0 or t > dur then
		return 0, kind
	end
	local x = t / dur
	return sin(x * math.pi), kind
end

local function fade(model, alpha)
	local skinned = model:GetAttribute("Skinned")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not (skinned and d:GetAttribute("SkinPart")) then
			local base = d:GetAttribute("BaseT")
			if base == nil then
				base = d.Transparency
				d:SetAttribute("BaseT", base)
			end
			d.LocalTransparencyModifier = alpha
		elseif d:IsA("Decal") then
			d.Transparency = alpha
		elseif d:IsA("Light") or d:IsA("Fire") or d:IsA("ParticleEmitter") then
			if alpha > 0.5 then
				d.Enabled = false
			end
		end
	end
end

---------------------------------------------------------------- สัตว์น้ำ: เอฟเฟกต์ประจำตัว + ตอนโจมตี
local VFXLib = require(script.Parent:WaitForChild("VFXLib"))
local WATER_ID = { ReefCrab = true, TideOrca = true, InkOctopus = true }
local function waterFx(rig)
	if rig.WetFx or not WATER_ID[rig.Id] then
		return
	end
	rig.WetFx = true
	local size = rig.Size
	-- หยดน้ำไหลจากตัวตลอด (ตัวเปียก)
	local drip = Instance.new("ParticleEmitter")
	drip.Name = "Drip"
	drip.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drip.Color = ColorSequence.new(Color3.fromRGB(170, 230, 255), Color3.fromRGB(90, 180, 255))
	drip.LightEmission, drip.LightInfluence = 0.6, 0.4
	drip.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0.05) })
	drip.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	drip.Lifetime = NumberRange.new(0.5, 0.9)
	drip.Speed = NumberRange.new(0, 1)
	drip.Acceleration = Vector3.new(0, -30, 0)
	drip.Rate = 6 + size.X
	drip.Shape = Enum.ParticleEmitterShape.Box
	drip.Parent = rig.Root
	-- ฟองอากาศลอยขึ้นรอบตัวเบาๆ
	local bub = Instance.new("ParticleEmitter")
	bub.Name = "Bubbles"
	bub.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bub.Color = ColorSequence.new(Color3.fromRGB(220, 250, 255))
	bub.LightEmission = 0.8
	bub.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.4) })
	bub.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	bub.Lifetime = NumberRange.new(1, 1.8)
	bub.Speed = NumberRange.new(1, 2.5)
	bub.SpreadAngle = Vector2.new(25, 25)
	bub.Rate = 3
	bub.Parent = rig.Root
	if rig.Id == "TideOrca" then
		rig.NextSpray = os.clock() + math.random() * 5
	end
end
-- จอเปื้อนหมึก (โดนหมึกยักษ์ฟาดใกล้ๆ)
local function inkScreen()
	local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "ASInk"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 30
	gui.Parent = pg
	for i = 1, 7 do
		local blob = Instance.new("Frame")
		local s = math.random(160, 380)
		blob.Size = UDim2.fromOffset(s, s * math.random(70, 110) / 100)
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.fromScale(math.random(15, 85) / 100, math.random(15, 85) / 100)
		blob.BackgroundColor3 = Color3.fromRGB(12, 8, 24)
		blob.BackgroundTransparency = 0.08
		blob.Rotation = math.random(0, 360)
		blob.Parent = gui
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = blob
		game:GetService("TweenService"):Create(blob, TweenInfo.new(2.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.6 + i * 0.08),
			{ BackgroundTransparency = 1, Position = blob.Position + UDim2.fromScale(0, 0.06) }):Play()
	end
	game:GetService("Debris"):AddItem(gui, 3.6)
end
local function inkCloud(pos, size, look)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
	p.Size = Vector3.one
	p.CFrame = CFrame.lookAt(pos, pos + (look or Vector3.new(0, 0, -1)))
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(70, 40, 110), Color3.fromRGB(24, 14, 40))
	e.LightInfluence = 0.5
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.25), NumberSequenceKeypoint.new(0.4, size * 0.7), NumberSequenceKeypoint.new(1, size * 1.1) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.5, 0.7), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.9, 1.6)
	e.Speed = NumberRange.new(size * 2, size * 4)
	e.SpreadAngle = Vector2.new(35, 35)
	e.EmissionDirection = Enum.NormalId.Front
	e.Drag = 4
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	e.Rate = 0
	e.Parent = p
	e:Emit(16)
	game:GetService("Debris"):AddItem(p, 2.5)
end
local function waterAttackFx(rig, kind)
	local root = rig.Root
	local size = math.max(rig.Size.X, rig.Size.Z)
	task.delay(0.3, function()
		if not root.Parent then
			return
		end
		local front = root.Position + root.CFrame.LookVector * size * 0.45
		if rig.Template == "Whale" then
			pcall(VFXLib.Play, "WaterBurst", CFrame.new(front), { Scale = size / 10, Duration = 0.4 })
			pcall(VFXLib.Play, "WaterSplash", CFrame.new(front), { Scale = size / 12, Duration = 0.4 })
		elseif rig.Template == "Octopus" then
			inkCloud(front, size * 0.3, root.CFrame.LookVector)
			pcall(VFXLib.Play, "WaterSplash", CFrame.new(front), { Scale = size / 12, Duration = 0.3 })
			local char = Players.LocalPlayer.Character
			if char and (char:GetPivot().Position - front).Magnitude < size * 0.9 + 4 then
				inkScreen()
			end
		end
	end)
	local _ = kind
end

-- ปลาวาฬ: ว่ายเป็นคลื่น (หางขึ้นลง) ครีบพาย · โจมตี = พุ่งเงยหัวอ้าปากงับ
local function animateWhale(rig, now, walk, att)
	local ph = now * (1.6 + walk * 2.6) + rig.Seed
	local size = math.max(rig.Size.Z, rig.Size.X)
	setT(rig, "Tail1", ANG(sin(ph) * 0.16 - att * 0.15, sin(ph * 0.5) * 0.05, 0))
	setT(rig, "Tail2", ANG(sin(ph - 1.1) * 0.38 - att * 0.3, 0, 0))
	local paddle = 0.22 + sin(ph * 0.8) * 0.2
	setT(rig, "FinL", ANG(sin(ph * 0.8) * 0.15, 0, paddle))
	setT(rig, "FinR", ANG(sin(ph * 0.8) * 0.15, 0, -paddle))
	setT(rig, "Jaw", ANG(-att * 0.75 + (sin(now * 0.7 + rig.Seed) + 1) * 0.03, 0, 0))
	-- จมลงครึ่งตัว: เห็นหลัง + ครีบหลังโผล่พ้นน้ำ · ตอนงับพุ่งขึ้นเหนือน้ำ
	local sink = -rig.Size.Y * 0.42 * (1 - att * 0.8)
	setT(rig, "Root", CF(0, sink + sin(ph) * size * 0.012 + att * size * 0.08, -att * size * 0.15) * ANG(sin(ph + 0.6) * 0.035 + att * 0.32, 0, sin(ph * 0.5) * 0.03))
	-- พ่นน้ำจากรูหายใจเป็นระยะ
	if rig.NextSpray and now > rig.NextSpray then
		rig.NextSpray = now + 6 + math.random() * 5
		local top = rig.Root.Position + Vector3.new(0, rig.Size.Y * 0.45, 0) + rig.Root.CFrame.LookVector * size * 0.12
		pcall(VFXLib.Play, "WaterSplash", CFrame.new(top), { Scale = size / 20, Duration = 0.5 })
	end
end

-- หมึก: หนวดม้วนเป็นคลื่นรอบตัว · เดิน = หนวดสลับยกเป็นจังหวะ · โจมตี = หนวดหน้าเงื้อขึ้นแล้วฟาดลง
local function animateOctopus(rig, now, p, walk, att)
	if not rig.TentFront then
		rig.TentFront = {}
		for i = 1, 8 do
			local m = rig.M["Tent" .. i]
			if m and m.Part1 then
				local d = rig.Root.CFrame:VectorToObjectSpace(m.Part1.Position - rig.Root.Position)
				rig.TentFront[i] = math.max(0, -d.Unit.Z)
			end
		end
	end
	local t = (now - rig.AttackT)
	local windup = t < 0.25 and t / 0.25 or 0
	local strike = (t >= 0.25 and t < 0.6) and sin((t - 0.25) / 0.35 * math.pi) or 0
	for i = 1, 8 do
		local off = i * 0.785 + rig.Seed
		local curl = sin(now * 2.4 + off) * 0.16 - 0.05
		local lift = sin(p * 2 + i * 1.57) * 0.4 * walk
		local sweep = sin(p * 2 + i * 1.57 + 1.57) * 0.22 * walk + sin(now * 1.3 + off) * 0.06
		local f = rig.TentFront[i] or 0
		curl += f * (-1.2 * windup + 0.7 * strike)
		setT(rig, "Tent" .. i, ANG(curl - math.max(lift, 0), sweep, 0))
	end
	local size = rig.Size.Y
	setT(rig, "Root", CF(0, abs(sin(p * 2)) * size * 0.06 * walk + sin(now * 2 + rig.Seed) * size * 0.02 + windup * size * 0.12, -strike * size * 0.2)
		* ANG(windup * 0.2 - strike * 0.15, sin(p) * 0.08 * walk, 0))
	local _ = att
end

local function animate(rig, now, dt, camPos, playerPos)
	local root = rig.Root
	local vel = root.AssemblyLinearVelocity
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local size = math.max(rig.Size.Z, rig.Size.X, 2)
	local stride = clamp(speed / (size * 1.1), 0, 3.2)
	rig.Phase += dt * (1.5 + stride * 4.5)
	local p = rig.Phase
	local walk = clamp(speed / 6, 0, 1)
	local att, kind = attackCurve(rig, now)
	local state = rig.Model:GetAttribute("State")
	local tmpl = rig.Template

	-- ตาย: ล้มตะแคง แล้วจาง
	if rig.DeadT then
		local t = now - rig.DeadT
		local k = clamp(t / 0.55, 0, 1)
		setT(rig, "Root", CF(0, -rig.Size.Y * 0.18 * k, 0) * ANG(0, 0, 1.45 * k * k))
		for _, n in ipairs({ "LegFL", "LegFR", "LegBL", "LegBR" }) do
			setT(rig, n, ANG(0.5 * k, 0, 0))
		end
		setT(rig, "Neck", ANG(0.4 * k, 0, 0))
		if t > 1.4 then
			fade(rig.Model, clamp((t - 1.4) / 1.4, 0, 1))
		end
		return
	end
	if rig.VanishT then
		fade(rig.Model, clamp((now - rig.VanishT) / 1, 0, 1))
	end

	local breathe = sin(now * 2.2 + rig.Seed) * 0.025
	waterFx(rig)
	if WATER_ID[rig.Id] and rig.AttackT ~= rig.FxAttackT then
		rig.FxAttackT = rig.AttackT
		if rig.AttackT > 0 then
			waterAttackFx(rig, kind)
		end
	end
	if tmpl == "Whale" then
		animateWhale(rig, now, walk, att)
		return
	elseif tmpl == "Octopus" then
		animateOctopus(rig, now, p, walk, att)
		return
	end
	if tmpl == "Bird" then
		local flying = rig.Model:GetAttribute("Flying")
		local dive = kind == "Dive" and att > 0
		local flapSpeed = dive and 4 or (flying and 9 or 2)
		local amp = dive and 0.25 or (flying and 0.85 or 0.1)
		local f = sin(now * flapSpeed + rig.Seed) * amp
		local sweep = dive and -0.9 or 0
		setT(rig, "WingL", ANG(0, sweep, -f))
		setT(rig, "WingR", ANG(0, -sweep, f))
		setT(rig, "Root", CF(0, -f * 0.5, 0) * ANG(dive and -0.5 or 0, 0, 0))
		setT(rig, "Neck", ANG(sin(now * 1.3 + rig.Seed) * 0.1 - att * 0.4, sin(now * 0.7) * 0.3, 0))
		setT(rig, "Jaw", ANG(att * 0.5, 0, 0))
		return
	end

	if tmpl == "Crab" then
		for i = 1, 6 do
			local side = i <= 3 and 1 or -1
			local off = (i % 2 == 0) and 0 or math.pi
			setT(rig, "Leg" .. i, ANG(sin(p * 2 + off) * 0.35 * walk, 0, side * (abs(sin(p * 2 + off)) * 0.25 * walk + breathe)))
		end
		local snap = sin(now * 3 + rig.Seed) * 0.08
		setT(rig, "ClawL", ANG(-att * 0.9 + snap, att * 0.4, 0))
		setT(rig, "ClawR", ANG(-att * 0.9 - snap, -att * 0.4, 0))
		setT(rig, "Root", CF(0, abs(sin(p * 2)) * 0.15 * walk, 0) * ANG(0, sin(p) * 0.06 * walk, 0))
		return
	end

	-- สี่ขา / เลื้อยคลาน / เต่า
	local legAmp = (tmpl == "Reptile") and 0.5 or (tmpl == "Tortoise" and 0.35 or 0.75)
	local swing = sin(p * 2) * legAmp * walk
	local rabbit = rig.Id == "Rabbit"
	if rabbit then
		local hop = abs(sin(p * 1.5)) * walk
		setT(rig, "LegFL", ANG(-hop * 0.9, 0, 0))
		setT(rig, "LegFR", ANG(-hop * 0.9, 0, 0))
		setT(rig, "LegBL", ANG(hop * 1.1, 0, 0))
		setT(rig, "LegBR", ANG(hop * 1.1, 0, 0))
		setT(rig, "Root", CF(0, hop * 0.9, 0) * ANG(hop * 0.25, 0, 0))
	else
		local diag = (tmpl == "Reptile") and 0 or 0.15
		setT(rig, "LegFL", ANG(swing, 0, 0))
		setT(rig, "LegBR", ANG(swing * (1 - diag), 0, 0))
		setT(rig, "LegFR", ANG(-swing, 0, 0))
		setT(rig, "LegBL", ANG(-swing * (1 - diag), 0, 0))
		local bob = abs(sin(p * 2)) * 0.12 * size * 0.08 * walk
		local sway = (tmpl == "Reptile") and sin(p * 2) * 0.12 * walk or 0
		local lean = 0
		if state == "Windup" then
			lean = 0.15
			setT(rig, "LegFL", ANG(-0.4, 0, 0))
			setT(rig, "LegFR", ANG(-0.4, 0, 0))
		elseif state == "Charge" then
			lean = -0.12
		end
		setT(rig, "Root", CF(0, bob + breathe * 0.4, 0) * ANG(lean, sway, 0))
	end

	-- หัว: มองผู้เล่นที่ใกล้ + กัด/คำราม
	local neckPitch, neckYaw = sin(p * 2) * 0.05 * walk + breathe, 0
	if state == "Graze" then
		neckPitch = 0.55 + sin(now * 1.5) * 0.05
	end
	if playerPos then
		local toP = playerPos - root.Position
		if toP.Magnitude < 45 then
			local localDir = root.CFrame:VectorToObjectSpace(toP)
			neckYaw = clamp(math.atan2(-localDir.X, -localDir.Z), -0.7, 0.7)
		end
	end
	local jaw = 0
	if kind == "Bite" or kind == "Spit" or kind == "Leap" then
		neckPitch += att * 0.35
		jaw = att * 0.7
	elseif kind == "Roar" then
		neckPitch -= att * 0.55
		jaw = att * 0.9
	elseif kind == "Stare" then
		neckPitch = -0.1
		neckYaw += sin(now * 0.8) * 0.05 + att * 0.35 -- เอียงคอช้าๆ น่ากลัว
	end
	setT(rig, "Neck", ANG(neckPitch, neckYaw, kind == "Stare" and att * 0.5 or 0))
	setT(rig, "Jaw", ANG(jaw, 0, 0))

	-- หาง
	local wag = sin(now * (state == "Chase" and 9 or 3) + rig.Seed) * (0.25 + 0.2 * walk)
	if tmpl == "Reptile" then
		for i = 1, 3 do
			setT(rig, "Tail" .. i, ANG(0, sin(now * 2.4 - i * 0.9 + p) * (0.18 + 0.12 * walk), 0))
		end
	else
		setT(rig, "Tail1", ANG(-0.15 + sin(now * 2) * 0.08, wag, 0))
	end
end

function AnimalAnimator.Init()
	for _, m in ipairs(CollectionService:GetTagged("Animal")) do
		add(m)
	end
	CollectionService:GetInstanceAddedSignal("Animal"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("Animal"):Connect(function(m)
		rigs[m] = nil
	end)
	local player = Players.LocalPlayer
	RunService.Stepped:Connect(function(_, dt)
		local now = os.clock()
		local cam = Workspace.CurrentCamera.CFrame.Position
		local char = player.Character
		local playerPos = char and char:GetPivot().Position
		for model, rig in pairs(rigs) do
			if not model.Parent then
				rigs[model] = nil
			elseif (rig.Root.Position - cam).Magnitude < 420 then
				local ok, err = pcall(animate, rig, now, dt, cam, playerPos)
				if not ok then
					rigs[model] = nil
					warn("[AS] anim", err)
				elseif rig.Clip and (not rig.DeadT or ClipAnimator.HasDeath(rig)) then
					local vel = rig.Root.AssemblyLinearVelocity
					ClipAnimator.Animate(rig, dt, Vector3.new(vel.X, 0, vel.Z).Magnitude)
				elseif model:GetAttribute("SkinRig") == "Static" then
					-- โมเดลนิ่งจาก Store: กระโดดดุ๊กดิ๊กตอนเดิน / หายใจเบาๆ ตอนยืน
					local j = rig.Root:FindFirstChild("SkinJoint")
					if j then
						local vel = rig.Root.AssemblyLinearVelocity
						local moving = Vector3.new(vel.X, 0, vel.Z).Magnitude > 1.5
						rig.HopT = (rig.HopT or 0) + dt * (moving and 11 or 2.2)
						local s = math.sin(rig.HopT)
						local hop = moving and math.abs(s) * 0.45 or (s + 1) * 0.04
						j.Transform = CFrame.new(0, hop, 0) * CFrame.Angles(moving and -0.08 or 0, 0, moving and s * 0.1 or 0)
					end
				elseif rig.Boss then
					local vel = rig.Root.AssemblyLinearVelocity
					local okB, errB = pcall(BossAnimator.Animate, rig, {
						Now = now, Dt = dt, Speed = Vector3.new(vel.X, 0, vel.Z).Magnitude,
						Flying = model:GetAttribute("Flying") and not model:GetAttribute("Grounded"), DeadT = rig.DeadT,
					})
					if not okB then
						warn("[AS] boss anim", rig.Id, errB)
						rig.Boss = nil
					end
				end
			end
		end
	end)
end

return AnimalAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006C"><Properties><string name="Name">AtmosphereController</string><ProtectedString name="Source"><![CDATA[--[[
	AtmosphereController — แสงแดด/ดวงจันทร์ตามเวลาเกม + เปลี่ยนบรรยากาศนุ่มๆ ตามไบโอมที่ยืนอยู่
	  - คืนพระจันทร์เลือด = ฟ้าแดงเข้ม
	  - เกินระยะ "หมอกเปิด" ของกองไฟ = หมอกหนา (อัปเกรดกองไฟเพื่อเปิดแมพ)
	  - กองไฟดับตอนกลางคืน = มืดลงอีก
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Atmosphere = require(Shared.Atmosphere)
local MapLayout = require(Shared.MapLayout)

local AtmosphereController = {}

local function clockFor(state, now)
	local phase = state:GetAttribute("Phase") or "Day"
	local s, e = state:GetAttribute("PhaseStart") or now, state:GetAttribute("PhaseEnd") or now
	local f = math.clamp((now - s) / math.max(e - s, 0.01), 0, 1)
	if phase == "Day" then
		return 6.4 + f * 11.0, 0
	elseif phase == "Dusk" then
		return 17.4 + f * 1.7, f * 0.65
	elseif phase == "Night" then
		local t = 19.1 + f * 10.6
		local n = 1
		if f < 0.08 then
			n = 0.65 + f / 0.08 * 0.35
		elseif f > 0.9 then
			n = 1 - (f - 0.9) / 0.1 * 0.7
		end
		return t % 24, n
	end
	return 14, 0
end

function AtmosphereController.Init(state)
	AtmosphereController.State = state
	Atmosphere.Install(Lighting)
	local layout
	local function ensureLayout()
		if not layout and state:GetAttribute("Seed") then
			layout = MapLayout.new(state:GetAttribute("Seed"), state:GetAttribute("MapSize") or Config.MapSize, Config)
			AtmosphereController.Layout = layout
		end
		return layout
	end
	ensureLayout()
	state:GetAttributeChangedSignal("Seed"):Connect(ensureLayout)

	local current = Atmosphere.Values("Heart", 0)
	local biome = "Heart"
	local lastBiomeCheck = 0
	local veil = 0
	local inCamp = 0 -- 1 = อยู่ในเขตแคมป์, 0 = ออกนอกแคมป์ (มืดลงอีกนิด)
	AtmosphereController.Biome = "Heart"

	-- ไฟส่องพื้นที่ในแคมป์ตอนกลางคืน (ฝั่งผู้เล่น): ดวงไฟล่องหนเรียงเป็นตารางในเขตแคมป์ แสงไม่เกินขอบแคมป์มาก
	-- สร้างใหม่เมื่อรัศมีแคมป์เปลี่ยน (อัปเกรดกองไฟ) · ความสว่างตามความมืด (กลางวัน/ไฟดับ = ปิด)
	local campLights, lightsR, lightsLevel = {}, nil, -1
	local folder
	local function buildCampLights(R)
		if folder then
			folder:Destroy()
		end
		campLights = {}
		folder = Instance.new("Folder")
		folder.Name = "CampNightLights"
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Include
		rp.FilterDescendantsInstances = { Workspace.Terrain }
		local inner = math.max(R - 22, 18) -- ดวงไฟอยู่ลึกเข้ามาจากขอบ แสงจะจางหมดราวขอบแคมป์
		local step = 30
		local lim = math.floor(inner / step) * step -- ตารางสมมาตรรอบกองไฟ (0,0)
		for x = -lim, lim, step do
			for z = -lim, lim, step do
				if x * x + z * z <= inner * inner then
					local hit = Workspace:Raycast(Vector3.new(x, 800, z), Vector3.new(0, -1600, 0), rp)
					local gy = hit and hit.Position.Y or 20
					local part = Instance.new("Part")
					part.Name = "CampLight"
					part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
					part.Transparency = 1
					part.Size = Vector3.new(1, 1, 1)
					part.Position = Vector3.new(x, gy + 14, z)
					local l = Instance.new("PointLight")
					l.Color = Color3.fromRGB(255, 208, 150)
					l.Range = 34
					l.Shadows = false
					l.Brightness = 0
					l.Parent = part
					part.Parent = folder
					table.insert(campLights, l)
				end
			end
		end
		folder.Parent = Workspace
	end
	local function updateCampLights(level)
		local R = state:GetAttribute("CampRadius")
		if level > 0 and R and (R ~= lightsR or not folder or not folder.Parent) then
			lightsR = R
			buildCampLights(R)
			lightsLevel = -1
		end
		level = math.floor(level * 20 + 0.5) / 20 -- อัปเดตเฉพาะตอนค่าเปลี่ยน
		if level ~= lightsLevel then
			lightsLevel = level
			for _, l in ipairs(campLights) do
				l.Brightness = 1.6 * level
				l.Enabled = level > 0
			end
		end
	end

	RunService.RenderStepped:Connect(function(dt)
		local now = Workspace:GetServerTimeNow()
		local clock, night = clockFor(state, now)
		local cam = Workspace.CurrentCamera
		local pos = cam.CFrame.Position
		-- ล็อบบี้: บ่ายแดดลอดป่าตลอด (ค่าแสงมาจาก Biomes.Data.Lobby)
		-- ล็อบบี้อยู่ไกลนอกแมพ (12000,1800,12000) · มิติศาลเจ้า/วิหารลอยสูง ~2400 เหนือแมพ (ห้ามนับเป็นล็อบบี้)
		local outside = math.abs(pos.X) > 6000 or math.abs(pos.Z) > 6000
		local inLobby = pos.Y > 1200 and outside
		local inRealm = pos.Y > 1900 and not outside
		if inLobby then
			clock, night = 15.4, 0
		elseif inRealm then
			clock, night = 14, 0 -- มิติ: กลางวันสว่างตลอด โทนตามไบโอมใต้เกาะ
		elseif state:GetAttribute("TestClock") then
			clock, night = state:GetAttribute("TestClock"), 0 -- ภาพทดสอบ: ตรึงเวลากลางวัน
		end
		Lighting.ClockTime = clock
		if os.clock() - lastBiomeCheck > 0.3 and (inLobby or ensureLayout()) then
			lastBiomeCheck = os.clock()
			biome = inLobby and "Lobby" or layout:BiomeAt(pos.X, pos.Z)
			AtmosphereController.Biome = biome
			-- หมอกนอกเขตที่กองไฟเปิดไว้
			local reveal = state:GetAttribute("CampReveal") or 99999
			local d = math.sqrt(pos.X * pos.X + pos.Z * pos.Z)
			veil = (inLobby or inRealm) and 0 or math.clamp((d - (reveal - 220)) / 260, 0, 1) -- ใกล้กำแพงหมอก = ฟ้าขมุกขมัว
			-- เขตแคมป์ (แคมป์อยู่กลางแมพ 0,0): วัดจากตัวละคร ค่อยๆ จางออกช่วง 40 stud นอกขอบ
			local root = game:GetService("Players").LocalPlayer.Character
			root = root and root:FindFirstChild("HumanoidRootPart")
			local cp = root and root.Position or pos
			local cd = math.sqrt(cp.X * cp.X + cp.Z * cp.Z)
			local campR = state:GetAttribute("CampRadius") or 60
			inCamp = inLobby and 0 or math.clamp(1 - (cd - campR) / 40, 0, 1)
		end
		local mode = state:GetAttribute("BloodMoon") and "BloodMoon" or nil
		local target = Atmosphere.Values(biome, night, mode)
		if veil > 0 then
			target.Density = target.Density + veil * 0.3
			target.Haze = target.Haze + veil * 4
			target.AtmColor = target.AtmColor:Lerp(Color3.fromRGB(150, 150, 160), veil * 0.6)
		end
		-- กลางคืน: สว่างเฉพาะพื้นที่ในแคมป์ (ไฟดวงในเขตแคมป์ ดู updateCampLights) · ข้างนอกมืดตามปกติแม้มองจากในแคมป์
		-- (ไม่ยกค่าแสงทั้งจอ เพราะ Exposure/Ambient เป็นค่ารวม จะทำให้ป่าข้างนอกสว่างตามไปด้วย) · เดินออกนอกแคมป์ = มืดลงอีกนิด
		local campLit = not inLobby and not inRealm and night > 0 and (state:GetAttribute("CampFuel") or 1) > 0
		if campLit then
			target.Exposure = target.Exposure - (1 - inCamp) * night * 0.1
		end
		updateCampLights(campLit and night or 0)
		if not inLobby and night > 0.5 and (state:GetAttribute("CampFuel") or 1) <= 0 then
			target.Exposure = target.Exposure - 0.35
			target.Tint = target.Tint:Lerp(Color3.fromRGB(150, 160, 200), 0.4)
		end
		-- ผู้เล่นล้ม = ภาพจาง
		local lp = game:GetService("Players").LocalPlayer
		if lp:GetAttribute("Downed") then
			target.Saturation = -0.7
			target.Contrast = 0.3
		end
		local alpha = 1 - math.exp(-dt * 1.6)
		current = Atmosphere.Blend(current, target, alpha)
		Atmosphere.Apply(Lighting, current)
		-- ใต้น้ำ
		local grade = Lighting:FindFirstChild("ASGrade")
		if grade and pos.Y < (state:GetAttribute("WaterLevel") or 20) - 0.5 then
			local mat = Workspace.Terrain:ReadVoxels(Region3.new(pos - Vector3.new(2, 2, 2), pos + Vector3.new(2, 2, 2)):ExpandToGrid(4), 4)
			if mat[1] and mat[1][1] and mat[1][1][1] == Enum.Material.Water then
				grade.TintColor = Color3.fromRGB(120, 200, 255)
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				if atm then
					atm.Density = 0.6
					atm.Color = Color3.fromRGB(40, 120, 160)
				end
			end
		end
	end)
end

return AtmosphereController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006D"><Properties><string name="Name">AutoTool</string><ProtectedString name="Source"><![CDATA[--[[
	AutoTool — สลับเครื่องมืออัตโนมัติ (ตั้งค่า: "สลับเครื่องมืออัตโนมัติ" ค่าเริ่มต้น = เปิด)
	  ตี/คลิกใส่ต้นไม้   -> ขวานที่ตัดไม้แรงที่สุด (Chop)
	  ตี/คลิกใส่หิน/แร่  -> อีเต้อ/เครื่องมือที่ขุดแรงที่สุด (Mine)
	  ตี/คลิกใส่สัตว์    -> อาวุธดาเมจสูงสุดที่ถึงระยะ (ไกลเกินระยะประชิด = เลือกเฉพาะธนู)
	  ถือของอยู่แล้วไม่สลับเอง (ตีด้วยของในมือ) · มือเปล่าคลิกใส่เป้าถึงจะหยิบของที่เหมาะให้
	  ถือกระสอบ = ไม่ยุ่ง (คลิกใช้เก็บของ)
	CombatClient เรียก AutoTool.Before(tool) ก่อนตี -> ถ้าสลับให้แล้ว คืน true (CombatClient ตีด้วยของใหม่เอง)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))
local ClientSettings = require(script.Parent.ClientSettings)

local AutoTool = {}
AutoTool.Blocked = nil -- fn() -> true = ห้ามหยิบของตอนมือเปล่า (เช่น กำลังวางสิ่งก่อสร้าง)
local player = Players.LocalPlayer
local NODE_REACH = 16

local function enabled()
	return ClientSettings.Get("AutoTool") ~= false
end

-- จุดที่เล็ง (เมาส์ / นิ้วที่แตะ / กลางจอ)
local function aimRay(screenPos)
	local cam = Workspace.CurrentCamera
	local p = screenPos or UserInputService:GetMouseLocation()
	return cam:ViewportPointToRay(p.X, p.Y)
end

-- เป้าที่เล็งโดน: "Tree" / "Rock" / "Animal" + ระยะจากตัว
function AutoTool.Target(screenPos)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local ray = aimRay(screenPos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, Workspace.CurrentCamera }
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if not (res and res.Instance) then
		return nil
	end
	local dist = (res.Position - root.Position).Magnitude
	local animals = Workspace:FindFirstChild("Animals")
	if animals and res.Instance:IsDescendantOf(animals) then
		local m = res.Instance
		while m.Parent and m.Parent ~= animals do
			m = m.Parent
		end
		if m:GetAttribute("Kind") == "Spirit" then
			return nil
		end
		return "Animal", dist
	end
	local node = res.Instance:FindFirstAncestorWhichIsA("Model")
	while node and not CollectionService:HasTag(node, "ResourceNode") do
		node = node.Parent and node.Parent:IsA("Model") and node.Parent or nil
	end
	if node and not node:GetAttribute("Depleted") then
		local kind = node:GetAttribute("Node")
		if kind == "Tree" or kind == "Rock" then
			return kind, dist
		end
	end
	return nil
end

-- ค่าความเหมาะสมของเครื่องมือกับเป้า (nil = ใช้ไม่ได้/ไม่ถึง)
local function score(id, kind, dist)
	local t = id and Items.Tools[id]
	if not t then
		return nil
	end
	if kind == "Tree" then
		return dist <= NODE_REACH and (t.Chop or 0) > 0 and t.Chop or nil
	elseif kind == "Rock" then
		return dist <= NODE_REACH and (t.Mine or 0) > 0 and t.Mine or nil
	elseif kind == "Animal" then
		if dist > t.Range + 6 then
			return nil
		end
		return t.Damage
	end
	return nil
end

local function bestTool(kind, dist)
	local best, bestScore
	for _, c in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		for _, t in ipairs(c and c:GetChildren() or {}) do
			if t:IsA("Tool") then
				local s = score(t:GetAttribute("ItemId"), kind, dist)
				if s and (not bestScore or s > bestScore) then
					best, bestScore = t, s
				end
			end
		end
	end
	return best, bestScore
end

-- คืนเครื่องมือที่ควรสลับไป (nil = ของในมือดีอยู่แล้ว / ไม่มีเป้า)
function AutoTool.Suggest(current, screenPos)
	if not enabled() or not player:GetAttribute("InRun") or player:GetAttribute("Downed") or player:GetAttribute("Dead") then
		return nil
	end
	if current and current:GetAttribute("Kind") == "Sack" then
		return nil
	end
	local kind, dist = AutoTool.Target(screenPos)
	if not kind then
		return nil
	end
	local best, bestScore = bestTool(kind, dist)
	if not best or best == current then
		return nil
	end
	local cur = current and score(current:GetAttribute("ItemId"), kind, dist)
	if cur and cur >= bestScore then
		return nil
	end
	return best
end

local function equip(tool)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum and tool.Parent then
		hum:EquipTool(tool)
		return true
	end
	return false
end

-- เรียกจาก CombatClient ก่อนตี: สลับแล้วตีด้วยของใหม่ (swing(tool)) หลังขึ้นมือ
-- ถือของอยู่แล้ว = ใช้ของในมือเสมอ ไม่สลับเอง (ผู้เล่นเลือกเอง) · หยิบให้อัตโนมัติเฉพาะตอนมือเปล่า (AutoTool.Init)
function AutoTool.Before(current, swing)
	if current then
		return false
	end
	local best = AutoTool.Suggest(current)
	if not best then
		return false
	end
	if not equip(best) then
		return false
	end
	task.delay(0.12, function()
		if best.Parent == player.Character then
			swing(best)
		end
	end)
	return true
end

-- มือเปล่า: คลิก/แตะใส่ต้นไม้/หิน/สัตว์ -> หยิบของที่เหมาะขึ้นมือแล้วตีเลย
function AutoTool.Init(swing)
	local function emptyHanded()
		local char = player.Character
		return char ~= nil and char:FindFirstChildOfClass("Tool") == nil
	end
	local function try(screenPos)
		if not emptyHanded() or (AutoTool.Blocked and AutoTool.Blocked()) then
			return
		end
		local best = AutoTool.Suggest(nil, screenPos)
		if best and equip(best) then
			task.delay(0.12, function()
				if best.Parent == player.Character then
					swing(best)
				end
			end)
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		try(nil)
	end)
	UserInputService.TouchTapInWorld:Connect(function(pos, processed)
		if processed then
			return
		end
		try(pos)
	end)
end

return AutoTool
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006E"><Properties><string name="Name">Backpack</string><ProtectedString name="Source"><![CDATA[--[[
	Backpack — แถบเครื่องมือ + กระเป๋า หน้าตาแบบของ Roblox (แทน CoreGui Backpack)
	  ต่างจากของ Roblox: ปุ่มกระเป๋าโชว์ตลอด (ไม่ต้องรอของเกินช่อง) · ลากจัดลำดับ/สลับช่องได้ทั้งเมาส์และนิ้ว
	  ช่อง = Tool ทั้งหมดใน Backpack/ตัวละคร (อาวุธ เครื่องมือ กระสอบ สิ่งก่อสร้าง)
	  กดเลข 1-9,0 / แตะช่อง = ถือ-เก็บ · ` หรือปุ่มกระเป๋า = เปิดกระเป๋า
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local ItemIcon = require(script.Parent.ItemIcon)

local Backpack = {}
local player = Players.LocalPlayer
local N = 10
local SLOT = 60
local KEYS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6, [Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9, [Enum.KeyCode.Zero] = 10,
}
local slots = {} -- [i] = Tool
local ui = { Slots = {} }
local shown = true
local picked -- Tool ที่แตะเลือกไว้ (มือถือ: แตะของ -> แตะช่อง)
local drag -- { Tool, From = slotIndex|nil, Ghost, Start, Moved }

-- สีแบบแถบเครื่องมือของ Roblox
local BG = Color3.fromRGB(25, 27, 29)
local BG_T = 0.3
local SEL = Color3.fromRGB(255, 255, 255)

-- Tool ทั้งหมด (ตัวละครก่อน = อันที่ถือ) · ไอเทมเดียวกันโชว์ช่องเดียว (กันช่องซ้ำตอน server ยังลบ Tool ซ้ำไม่ทัน)
local function tools()
	local list, seen = {}, {}
	local holders = { player.Character }
	for _, c in ipairs(player:GetChildren()) do
		if c:IsA("Backpack") then
			table.insert(holders, c)
		end
	end
	for _, holder in ipairs(holders) do
		for _, t in ipairs(holder:GetChildren()) do
			if t:IsA("Tool") then
				local key = t:GetAttribute("StructureKind") or t:GetAttribute("ItemId") or t
				if not seen[key] then
					seen[key] = true
					table.insert(list, t)
				end
			end
		end
	end
	return list
end

local function equipped(t)
	return t and player.Character and t.Parent == player.Character
end

local function toggle(t)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not (t and hum) then
		return
	end
	if equipped(t) then
		hum:UnequipTools()
	else
		hum:EquipTool(t)
	end
end

-- รูปในช่อง: TextureId ของ Tool -> โมเดลจริง -> ชื่อ
local function fillIcon(holder, t)
	holder:ClearAllChildren()
	if not t then
		return
	end
	if t.TextureId ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = t.TextureId
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = holder
		return
	end
	local id = t:GetAttribute("StructureKind") or t:GetAttribute("ItemId")
	if id then
		local vp = ItemIcon.Make(holder, id, { Size = UDim2.fromScale(1, 1) })
		if vp:FindFirstChildOfClass("Camera") then
			return
		end
		vp:Destroy()
	end
	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.fromScale(1, 1)
	txt.Font = Enum.Font.BuilderSansBold
	txt.TextScaled = true
	txt.TextWrapped = true
	txt.TextColor3 = Color3.new(1, 1, 1)
	txt.Text = t.Name
	txt.Parent = holder
end

local function countText(t)
	local n = t:GetAttribute("Count")
	if n and n > 1 then
		return "x" .. n
	end
	return t:GetAttribute("Fill") or ""
end

local function slotAt(pos)
	for i, s in pairs(ui.Slots) do
		local a, z = s.Button.AbsolutePosition, s.Button.AbsoluteSize
		if pos.X >= a.X and pos.X <= a.X + z.X and pos.Y >= a.Y and pos.Y <= a.Y + z.Y then
			return i
		end
	end
end

-- ใส่ Tool ลงช่อง i (ของเดิมในช่องสลับไปช่องเก่าของ Tool นี้)
local function assign(t, i)
	local from = table.find(slots, t)
	local old = slots[i]
	slots[i] = t
	if from and from ~= i then
		slots[from] = old
	end
	Backpack.Refresh()
end

local function startPress(t, fromSlot, input)
	drag = { Tool = t, From = fromSlot, Start = Vector2.new(input.Position.X, input.Position.Y), Moved = false }
end

local function makeGhost(t)
	local g = Instance.new("Frame")
	g.Size = UDim2.fromOffset(SLOT, SLOT)
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.BackgroundColor3 = BG
	g.BackgroundTransparency = 0.15
	g.ZIndex = 50
	g.Parent = ui.Gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = g
	local h = Instance.new("Frame")
	h.BackgroundTransparency = 1
	h.Size = UDim2.new(1, -8, 1, -8)
	h.Position = UDim2.fromOffset(4, 4)
	h.ZIndex = 51
	h.Parent = g
	fillIcon(h, t)
	return g
end

local function buildSlot(i)
	local b = Instance.new("TextButton")
	b.Name = "Slot" .. i
	b.Text = ""
	b.AutoButtonColor = false
	b.Size = UDim2.fromOffset(SLOT, SLOT)
	b.BackgroundColor3 = BG
	b.BackgroundTransparency = BG_T
	b.LayoutOrder = i
	b.Parent = ui.Bar
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = SEL
	stroke.Thickness = 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, -10, 1, -10)
	holder.Position = UDim2.fromOffset(5, 5)
	holder.Parent = b
	local key = Instance.new("TextLabel")
	key.BackgroundTransparency = 1
	key.Size = UDim2.fromOffset(16, 16)
	key.Position = UDim2.fromOffset(3, 1)
	key.Font = Enum.Font.BuilderSansBold
	key.TextSize = 13
	key.TextColor3 = Color3.new(1, 1, 1)
	key.Text = tostring(i % 10)
	key.ZIndex = 2
	key.Parent = b
	local count = Instance.new("TextLabel")
	count.BackgroundTransparency = 1
	count.Size = UDim2.new(1, -6, 0, 14)
	count.AnchorPoint = Vector2.new(0, 1)
	count.Position = UDim2.new(0, 3, 1, -1)
	count.Font = Enum.Font.BuilderSansBold
	count.TextSize = 12
	count.TextXAlignment = Enum.TextXAlignment.Right
	count.TextColor3 = Color3.new(1, 1, 1)
	count.TextStrokeTransparency = 0.4
	count.ZIndex = 2
	count.Parent = b
	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if slots[i] then
				startPress(slots[i], i, input)
			elseif picked then
				assign(picked, i)
				picked = nil
			end
		end
	end)
	ui.Slots[i] = { Button = b, Stroke = stroke, Holder = holder, Count = count, Key = key }
end

function Backpack.Build()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
	task.spawn(function()
		for _ = 1, 10 do
			task.wait(1)
			pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			end)
		end
	end)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ASBackpack"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")
	ui.Gui = gui
	local scale = Instance.new("UIScale")
	local function rescale()
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(vp.X / ((SLOT + 5) * N + 140), 1), 0.55, 1)
	end
	-- แถบช่อง (ล่างกลาง) + ปุ่มกระเป๋าท้ายแถบ
	local bar = Instance.new("Frame")
	bar.Name = "Hotbar"
	bar.BackgroundTransparency = 1
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -6)
	bar.Size = UDim2.fromOffset((SLOT + 5) * N + SLOT, SLOT)
	bar.Parent = gui
	scale.Parent = bar
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Padding = UDim.new(0, 5)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = bar
	ui.Bar = bar
	for i = 1, N do
		buildSlot(i)
	end
	-- ปุ่มกระเป๋า: วงกลมเข้ม + ไอคอนกระเป๋าของ Roblox เอง (ตัวเดียวกับแถบบน) · เปิดอยู่ = ไอคอนทึบ
	-- อยู่มุมขวาบนสุด ในแถวเดียวกับปุ่ม Roblox ด้านบน (ScreenGui แยก ไม่เว้นที่แถบบน)
	local topGui = Instance.new("ScreenGui")
	topGui.Name = "ASBackpackButton"
	topGui.ResetOnSpawn = false
	topGui.IgnoreGuiInset = true
	topGui.DisplayOrder = 6
	topGui.Parent = gui.Parent
	ui.TopGui = topGui
	local bagBtn = Instance.new("ImageButton")
	bagBtn.Name = "InventoryButton"
	bagBtn.Size = UDim2.fromOffset(44, 44)
	bagBtn.AnchorPoint = Vector2.new(1, 0)
	bagBtn.Position = UDim2.new(1, -16, 0, 12)
	bagBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 21)
	bagBtn.BackgroundTransparency = 0.3
	bagBtn.Image = ""
	bagBtn.Parent = topGui
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(1, 0)
	bc.Parent = bagBtn
	local bt = Instance.new("ImageLabel")
	bt.BackgroundTransparency = 1
	bt.AnchorPoint = Vector2.new(0.5, 0.5)
	bt.Position = UDim2.fromScale(0.5, 0.5)
	bt.Size = UDim2.fromScale(0.62, 0.62)
	bt.Image = "rbxasset://textures/ui/TopBar/inventoryOff@3x.png"
	bt.ScaleType = Enum.ScaleType.Fit
	bt.Parent = bagBtn
	ui.BagIcon = bt
	bagBtn.Activated:Connect(function()
		Backpack.ToggleInventory()
	end)
	ui.BagBtn = bagBtn

	-- กระเป๋า (เหนือแถบ): ของทั้งหมด ลากลงช่อง / แตะของแล้วแตะช่อง
	local inv = Instance.new("Frame")
	inv.Name = "Inventory"
	inv.AnchorPoint = Vector2.new(0.5, 1)
	inv.Position = UDim2.new(0.5, 0, 1, -(SLOT + 16))
	inv.Size = UDim2.fromOffset((SLOT + 5) * N + SLOT, 250)
	inv.BackgroundColor3 = BG
	inv.BackgroundTransparency = BG_T
	inv.Visible = false
	inv.Parent = gui
	local ic = Instance.new("UICorner")
	ic.CornerRadius = UDim.new(0, 8)
	ic.Parent = inv
	local is = scale:Clone()
	is.Parent = inv
	scale:GetPropertyChangedSignal("Scale"):Connect(function()
		is.Scale = scale.Scale
	end)
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -20, 0, 28)
	title.Position = UDim2.fromOffset(12, 6)
	title.Font = Enum.Font.BuilderSansBold
	title.TextSize = 18
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = "กระเป๋า  ·  ลากของไปวางที่ช่องด้านล่าง (สลับช่องได้)"
	title.Parent = inv
	ui.InvTitle = title
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.new(1, -16, 1, -44)
	scroll.Position = UDim2.fromOffset(8, 38)
	scroll.ScrollBarThickness = 5
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = inv
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(SLOT, SLOT)
	g.CellPadding = UDim2.fromOffset(5, 5)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = scroll
	ui.Inv, ui.InvScroll = inv, scroll

	-- ลาก: ตามเมาส์/นิ้ว แล้วปล่อยลงช่อง
	UserInputService.InputChanged:Connect(function(input)
		if not drag then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			if not drag.Moved and (p - drag.Start).Magnitude > 8 then
				drag.Moved = true
				drag.Ghost = makeGhost(drag.Tool)
				Backpack.Refresh()
			end
			if drag.Ghost then
				drag.Ghost.Position = UDim2.fromOffset(p.X, p.Y)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not drag then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local d = drag
		drag = nil
		if d.Ghost then
			d.Ghost:Destroy()
		end
		local p = Vector2.new(input.Position.X, input.Position.Y)
		if d.Moved then
			local i = slotAt(p)
			if i then
				assign(d.Tool, i)
			elseif d.From and ui.Inv.Visible then
				-- ลากออกจากแถบไปที่กระเป๋า = เอาออกจากช่อง
				slots[d.From] = nil
				Backpack.Refresh()
			end
		elseif d.From then
			toggle(d.Tool) -- แตะช่อง = ถือ/เก็บ
		else
			picked = (picked ~= d.Tool) and d.Tool or nil -- แตะของในกระเป๋า = เลือก แล้วแตะช่อง
		end
		Backpack.Refresh() -- ลากเสร็จ: ซ่อนช่องว่างกลับ
	end)
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		local i = KEYS[input.KeyCode]
		if i and bar.Visible and slots[i] then
			toggle(slots[i])
		elseif input.KeyCode == Enum.KeyCode.Backquote then
			Backpack.ToggleInventory()
		end
	end)
	local function watch(holder)
		if holder then
			holder.ChildAdded:Connect(function()
				task.defer(Backpack.Refresh)
			end)
			holder.ChildRemoved:Connect(function()
				task.defer(Backpack.Refresh)
			end)
		end
	end
	watch(player:WaitForChild("Backpack", 30))
	if player.Character then
		watch(player.Character)
	end
	player.CharacterAdded:Connect(function(c)
		watch(c)
		task.defer(function()
			watch(player:WaitForChild("Backpack", 10))
			Backpack.Refresh()
		end)
	end)
	task.spawn(function()
		while gui.Parent do
			task.wait(0.5)
			local ok, err = pcall(Backpack.Refresh) -- จำนวน/ชื่อเปลี่ยน (Count, กระสอบ 3/10) · error ห้ามทำลูปตาย (ช่องค้างของเก่า)
			if not ok then
				warn("[Backpack] refresh error: " .. tostring(err))
			end
		end
	end)
	Backpack.Refresh()
end

function Backpack.Refresh()
	if not ui.Bar then
		return
	end
	local list = tools()
	local present = {}
	for _, t in ipairs(list) do
		present[t] = true
	end
	for i = 1, N do
		if slots[i] and not present[slots[i]] then
			slots[i] = nil
		end
	end
	for _, t in ipairs(list) do
		if not table.find(slots, t) then
			for i = 1, N do
				if not slots[i] then
					slots[i] = t
					break
				end
			end
		end
	end
	if picked and not present[picked] then
		picked = nil
	end
	for i = 1, N do
		local s = ui.Slots[i]
		local t = slots[i]
		if s.Tool ~= t or (t and s.Tex ~= t.TextureId) then
			fillIcon(s.Holder, t)
			s.Tool = t
			s.Tex = t and t.TextureId
		end
		s.Count.Text = t and countText(t) or ""
		local on = equipped(t)
		s.Stroke.Thickness = on and 3 or (picked and 1 or 0)
		s.Stroke.Color = picked and Color3.fromRGB(120, 220, 255) or SEL
		s.Button.BackgroundTransparency = on and 0.05 or BG_T
		-- โชว์เฉพาะช่องที่มีของ (ช่องว่างโผล่ตอนเปิดกระเป๋า/กำลังลาก/เลือกของไว้ จะได้มีที่วาง)
		s.Button.Visible = t ~= nil or ui.Inv.Visible or drag ~= nil or picked ~= nil
	end
	ui.Bar.Visible = shown and (#list > 0 or player:GetAttribute("InRun") == true)
	ui.TopGui.Enabled = ui.Bar.Visible
	if not ui.Bar.Visible then
		ui.Inv.Visible = false
	end
	if ui.Inv.Visible then
		Backpack.RefreshInventory(list)
	end
end

function Backpack.RefreshInventory(list)
	list = list or tools()
	for _, c in ipairs(ui.InvScroll:GetChildren()) do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	ui.InvTitle.Text = picked and ("เลือก " .. picked.Name .. " แล้ว — แตะช่องด้านล่างที่จะใส่") or "กระเป๋า  ·  ลากของไปวางที่ช่องด้านล่าง (สลับช่องได้)"
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	for k, t in ipairs(list) do
		local b = Instance.new("TextButton")
		b.Text = ""
		b.AutoButtonColor = false
		b.BackgroundColor3 = BG
		b.BackgroundTransparency = table.find(slots, t) and 0.55 or 0.15
		b.LayoutOrder = k
		b.Parent = ui.InvScroll
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 8)
		c.Parent = b
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(120, 220, 255)
		st.Thickness = picked == t and 3 or 0
		st.Parent = b
		local h = Instance.new("Frame")
		h.BackgroundTransparency = 1
		h.Size = UDim2.new(1, -10, 1, -10)
		h.Position = UDim2.fromOffset(5, 5)
		h.Parent = b
		fillIcon(h, t)
		local cnt = Instance.new("TextLabel")
		cnt.BackgroundTransparency = 1
		cnt.Size = UDim2.new(1, -6, 0, 14)
		cnt.AnchorPoint = Vector2.new(0, 1)
		cnt.Position = UDim2.new(0, 3, 1, -1)
		cnt.Font = Enum.Font.BuilderSansBold
		cnt.TextSize = 12
		cnt.TextXAlignment = Enum.TextXAlignment.Right
		cnt.TextColor3 = Color3.new(1, 1, 1)
		cnt.TextStrokeTransparency = 0.4
		cnt.Text = countText(t)
		cnt.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				startPress(t, nil, input)
			end
		end)
	end
end

function Backpack.ToggleInventory(force)
	if not ui.Inv then
		return
	end
	if force == nil then
		force = not ui.Inv.Visible
	end
	ui.Inv.Visible = force and ui.Bar.Visible
	ui.BagIcon.Image = ui.Inv.Visible and "rbxasset://textures/ui/TopBar/inventoryOn@3x.png" or "rbxasset://textures/ui/TopBar/inventoryOff@3x.png"
	if not ui.Inv.Visible then
		picked = nil
	end
	Backpack.Refresh()
end

-- ซ่อนทั้งหมด (ตาย/ดูคนอื่น)
function Backpack.SetVisible(on)
	shown = on
	Backpack.Refresh()
end

return Backpack
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000006F"><Properties><string name="Name">BossAnimator</string><ProtectedString name="Source"><![CDATA[--[[
	BossAnimator — ขยับกระดูกบอสที่มีผิว (Import 3D) ฝั่ง client ทุกเฟรม (ไม่ต้องอัปแอนิเมชัน)
	  BossAnimator.Attach(rig)          เรียกครั้งเดียวตอนบอสโผล่ (rig จาก AnimalAnimator)
	  BossAnimator.Animate(rig, ctx)    ทุกเฟรม: ctx = { Now, Dt, Speed, Flying, DeadT }

	- ท่าทุกท่าคำนวณเป็น "เป้าหมาย" แล้วไหลเข้าหาแบบนุ่ม (ไม่กระตุกตอนเปลี่ยนท่า)
	- หัว/คอหันมองผู้เล่นตลอด
	- ท่าร่ายสกิลอ่านจาก attribute Cast / CastAt / CastTime (เซิร์ฟเวอร์ตั้งใน BossAbilities) -> ง้าง -> กระแทก -> คืนตัว
	หมุนด้วยแกนของตัวบอส (หน้า = -Z, ขึ้น = +Y, ขวา = +X) แล้วแปลงเป็นแกนของแต่ละกระดูก
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local BossFX = require(script.Parent:WaitForChild("BossFX"))

local BossAnimator = {}

local sin, cos, max, abs, clamp, atan2, exp = math.sin, math.cos, math.max, math.abs, math.clamp, math.atan2, math.exp
local ANG = CFrame.Angles
local V = Vector3.new

-- บทบาท -> ชื่อกระดูกในไฟล์ (ตรงกับ blender/prep_boss.py)
local ROLES = {
	Terragon = {
		Hips = "Bone_000", Spine1 = "Bone_014", Spine2 = "Bone_013", Chest = "Bone_011", Neck = "Bone_032", Head = "Bone_031",
		UpperArmR = "Bone_036", ForeArmR = "Bone_035", UpperArmL = "Bone_041", ForeArmL = "Bone_040",
		ThighR = "Bone_006", ShinR = "Bone_005", ThighL = "Bone_010", ShinL = "Bone_009", FootR = "Bone_004", FootL = "Bone_008",
	},
	TempestRoc = {
		Hips = "Bone_000", Spine1 = "Bone_002", Spine2 = "Bone_001", Chest = "Bone_004", Neck = "Bone_003", Head = "Bone_015",
		UpperArmR = "Bone_019", ForeArmR = "Bone_018", UpperArmL = "Bone_024", ForeArmL = "Bone_023",
		ThighR = "Bone_013", ShinR = "Bone_012", ThighL = "Bone_009", ShinL = "Bone_008", FootR = "Bone_011", FootL = "Bone_007",
	},
	Solfang = {
		Hips = "Bone_000", Spine1 = "Bone_005", Spine2 = "Bone_004", Chest = "Bone_002",
		Neck1 = "Bone_032", Neck2 = "Bone_031", Neck3 = "Bone_030", Neck4 = "Bone_029", Head = "Bone_027", Jaw = "Bone_026",
		ArmR1 = "Bone_042", ArmR2 = "Bone_040", ArmL1 = "Bone_037", ArmL2 = "Bone_035",
		WingR1 = "Bone_046", WingR2 = "Bone_045", WingR3 = "Bone_044", WingL1 = "Bone_050", WingL2 = "Bone_049", WingL3 = "Bone_048",
		ThighR = "Bone_015", ShinR = "Bone_014", ThighL = "Bone_010", ShinL = "Bone_009",
		Tail1 = "Bone_024", Tail2 = "Bone_023", Tail3 = "Bone_022", Tail4 = "Bone_021", Tail5 = "Bone_020", Tail6 = "Bone_019", Tail7 = "Bone_018",
	},
	-- โมซาซอรัส: โครงกระดูกเริ่มที่หัว (Root/Neck อยู่ที่หัว ลำตัว Body1.. ห้อยจากคอ) -> ห้ามหมุน Neck (= หมุนทั้งตัวรอบหัว)
	--   หัน/ก้มเงยด้วย Head (ลูก: Skull -> Jaw ปากล่าง + Snout ปากบน)
	Leviathan = {
		Root = "Bone_000", Neck = "Bone_001", Head = "Bone_003", Jaw = "Bone_007", Snout = "Bone_009",
		Body1 = "Bone_005", Body2 = "Bone_004", Body3 = "Bone_011", Body4 = "Bone_010", Body5 = "Bone_023", Body6 = "Bone_022",
		Tail1 = "Bone_038", Tail2 = "Bone_037", Tail3 = "Bone_036",
		FlipperFR = "Bone_016", FlipperFL = "Bone_021", FlipperBR = "Bone_031", FlipperBL = "Bone_035",
	},
}

local function smooth(x)
	x = clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- ท่าเปิดตัว (เล่นบนเครื่องเราตอนฉากเปิดตัวบอส): model -> { Start, Kind, Wind }
local intro = setmetatable({}, { __mode = "k" })
local INTRO_KIND = { Biped = "Roar", Dragon = "Roar", Mosasaur = "Rear" }
function BossAnimator.PlayIntro(model, wind)
	local kind = model:GetAttribute("SkinRig") or "Biped"
	-- โกเลมดิน: ทุบพื้น · ที่เหลือ: คำราม/ยกตัว
	local k = (model:GetAttribute("AnimalId") == "Terragon") and "Slam" or INTRO_KIND[kind] or "Roar"
	intro[model] = { Start = os.clock(), Kind = k, Wind = wind or 0.9 }
	return k
end

function BossAnimator.Has(model)
	return model:GetAttribute("Skinned") == true and ROLES[model:GetAttribute("AnimalId")] ~= nil
end

function BossAnimator.Attach(rig)
	local model = rig.Model
	local mesh = model:FindFirstChild("Skin")
	local map = ROLES[rig.Id]
	if not (mesh and map) then
		return false
	end
	local byName = {}
	for _, d in ipairs(mesh:GetDescendants()) do
		if d:IsA("Bone") then
			byName[d.Name] = d
		end
	end
	local root = rig.Root
	local bones = {}
	for role, name in pairs(map) do
		local b = byName[name]
		if b then
			local rest = root.CFrame:ToObjectSpace(b.WorldCFrame).Rotation
			bones[role] = { Bone = b, Rest = rest, RestInv = rest:Inverse(), Cur = { 0, 0, 0, 0, 0, 0 } }
		end
	end
	rig.Boss = {
		Bones = bones, Kind = model:GetAttribute("SkinRig") or "Biped", Phase = 0,
		H = mesh.Size.Y, L = math.max(mesh.Size.X, mesh.Size.Z), Look = { 0, 0 }, Element = model:GetAttribute("Element"),
	}
	pcall(BossFX.Aura, model, model:GetAttribute("Element"))
	return true
end

---------------------------------------------------------------- ท่า (เป้าหมาย)
-- P[role] = { pitch, yaw, roll, dx, dy, dz }  (หน่วยมุม = เรเดียน, ระยะ = studs ในแกนตัวบอส)
local function add(P, role, x, y, z, dx, dy, dz)
	local e = P[role]
	if not e then
		e = { 0, 0, 0, 0, 0, 0 }
		P[role] = e
	end
	e[1] += x or 0
	e[2] += y or 0
	e[3] += z or 0
	e[4] += dx or 0
	e[5] += dy or 0
	e[6] += dz or 0
end

-- น้ำหนักท่าร่าย: A = ช่วงง้าง, Hh = ช่วงกระแทก (หายไปเองหลังคืนตัว)
local function castWeights(age, w)
	local A = smooth(age / (w * 0.75)) * (1 - smooth((age - w) / 0.15))
	local Hh = smooth((age - w) / 0.12) * (1 - smooth((age - w - 0.35) / 0.6))
	return A, Hh
end

local function biped(P, B, t, w, ph, cast, age, cw)
	local H = B.H
	local sw = sin(ph)
	-- หายใจ + ถ่ายน้ำหนัก (ยืนนิ่งก็ยังมีชีวิต)
	local breathe = sin(t * 1.3)
	local shift = sin(t * 0.45)
	add(P, "Chest", breathe * 0.05, 0, 0)
	add(P, "Spine2", breathe * 0.02, 0, 0)
	add(P, "Hips", 0, 0, shift * 0.035 * (1 - w), shift * 0.012 * H * (1 - w), breathe * 0.004 * H)
	add(P, "UpperArmL", sin(t * 0.9) * 0.05, 0, -0.14 + breathe * 0.03)
	add(P, "UpperArmR", sin(t * 0.9 + 1) * 0.05, 0, 0.14 - breathe * 0.03)
	add(P, "ForeArmL", 0.3, 0, 0)
	add(P, "ForeArmR", 0.3, 0, 0)
	-- เดิน: ก้าวยาว ย่อตัว แกว่งแขนสวน บิดลำตัว
	if w > 0.02 then
		add(P, "ThighL", sw * 0.6 * w, 0, 0)
		add(P, "ThighR", -sw * 0.6 * w, 0, 0)
		add(P, "ShinL", -max(0, cos(ph)) * 0.95 * w, 0, 0)
		add(P, "ShinR", -max(0, -cos(ph)) * 0.95 * w, 0, 0)
		add(P, "UpperArmL", -sw * 0.5 * w, 0, 0)
		add(P, "UpperArmR", sw * 0.5 * w, 0, 0)
		add(P, "ForeArmL", max(0, -sw) * 0.4 * w, 0, 0)
		add(P, "ForeArmR", max(0, sw) * 0.4 * w, 0, 0)
		add(P, "Hips", 0, sw * 0.08 * w, sin(ph) * 0.05 * w, 0, (abs(cos(ph)) - 0.6) * 0.035 * H * w)
		add(P, "Spine1", -0.06 * w, -sw * 0.06 * w, 0)
		add(P, "Chest", 0, -sw * 0.08 * w, 0)
		-- เท้าลงพื้นทุกครึ่งรอบ: ฝุ่น + จอสั่น
		local step = math.floor(ph / math.pi)
		if B.LastStep ~= step then
			B.LastStep = step
			if w > 0.25 then
				local foot = B.Bones[(step % 2 == 0) and "FootL" or "FootR"]
				if foot then
					pcall(BossFX.Footstep, foot.Bone.WorldPosition, H / 50, B.Element)
				end
			end
		end
	end
	if not cast then
		return
	end
	local A, Hh = castWeights(age, cw)
	if cast == "Slam" then
		-- ง้างแขนเหนือหัว เอนหลัง -> ทุบลงพื้น ย่อตัว
		add(P, "UpperArmL", 2.7 * A + 0.7 * Hh, 0, 0.25 * A)
		add(P, "UpperArmR", 2.7 * A + 0.7 * Hh, 0, -0.25 * A)
		add(P, "ForeArmL", 0.5 * A, 0, 0)
		add(P, "ForeArmR", 0.5 * A, 0, 0)
		add(P, "Spine1", 0.15 * A - 0.35 * Hh, 0, 0)
		add(P, "Spine2", 0.15 * A - 0.3 * Hh, 0, 0)
		add(P, "Chest", 0.12 * A - 0.2 * Hh, 0, 0)
		add(P, "Head", 0.2 * A - 0.25 * Hh, 0, 0)
		add(P, "Hips", 0, 0, 0, 0, 0.03 * H * A - 0.09 * H * Hh)
		add(P, "ThighL", 0.45 * Hh, 0, -0.1 * Hh)
		add(P, "ThighR", 0.45 * Hh, 0, 0.1 * Hh)
		add(P, "ShinL", -0.8 * Hh, 0, 0)
		add(P, "ShinR", -0.8 * Hh, 0, 0)
	elseif cast == "Roar" or cast == "Summon" then
		local k = max(A, Hh)
		local shake = sin(t * 34) * 0.03 * k
		local up = cast == "Summon" and 1 or 0
		add(P, "Chest", 0.3 * k, 0, shake)
		add(P, "Spine2", 0.12 * k, 0, 0)
		add(P, "Head", 0.35 * k + shake, 0, 0)
		add(P, "UpperArmL", (0.6 + 2.0 * up) * k, 0, -(1.0 - 0.5 * up) * k)
		add(P, "UpperArmR", (0.6 + 2.0 * up) * k, 0, (1.0 - 0.5 * up) * k)
		add(P, "ForeArmL", 0.7 * k, 0, 0)
		add(P, "ForeArmR", 0.7 * k, 0, 0)
		add(P, "Hips", 0, 0, 0, 0, -0.02 * H * k)
	end
end

local function dragon(P, B, t, w, ph, cast, age, cw, flying)
	local H = B.H
	local flap = flying and sin(t * 3.6) or sin(t * 1.1) * 0.12
	local amp = flying and 0.8 or 1
	add(P, "WingL1", 0, 0, flap * amp + (flying and 0 or 0.35))
	add(P, "WingR1", 0, 0, -flap * amp - (flying and 0 or 0.35))
	local f2 = flying and sin(t * 3.6 - 0.8) * 0.5 or 0.25
	add(P, "WingL2", 0, 0, f2)
	add(P, "WingR2", 0, 0, -f2)
	add(P, "WingL3", 0, 0, f2 * 0.6)
	add(P, "WingR3", 0, 0, -f2 * 0.6)
	for i = 1, 7 do
		add(P, "Tail" .. i, 0.03, sin(t * 1.8 - i * 0.55) * (0.07 + i * 0.022), 0)
	end
	local breathe = sin(t * 1.2)
	-- ท่าตั้งต้นของโมเดลคอ/หัวก้มลงหาพื้น -> เงยคอเป็นโค้ง S และเชิดหัวให้มองไปข้างหน้า (เห็นหน้า/ปาก)
	for i, role in ipairs({ "Neck1", "Neck2", "Neck3", "Neck4" }) do
		add(P, role, breathe * 0.03 + (i <= 2 and 0.12 or 0.04), sin(t * 0.7 + i * 0.5) * 0.05, 0)
	end
	add(P, "Head", 0.28, 0, 0)
	add(P, "Chest", breathe * 0.04, 0, 0)
	add(P, "Jaw", -0.05 - max(0, sin(t * 0.9)) * 0.08, 0, 0)
	if flying then
		add(P, "ThighL", -0.8, 0, 0)
		add(P, "ThighR", -0.8, 0, 0)
		add(P, "ShinL", 0.6, 0, 0)
		add(P, "ShinR", 0.6, 0, 0)
		add(P, "ArmL1", -0.6, 0, 0)
		add(P, "ArmR1", -0.6, 0, 0)
		add(P, "Hips", -0.06 + flap * 0.04, 0, 0, 0, -flap * 0.03 * H)
	else
		local sw = sin(ph) * 0.5 * w
		add(P, "ArmL1", sw, 0, 0)
		add(P, "ThighR", sw, 0, 0)
		add(P, "ArmR1", -sw, 0, 0)
		add(P, "ThighL", -sw, 0, 0)
		add(P, "Hips", 0, sin(ph) * 0.05 * w, 0, 0, abs(cos(ph)) * 0.02 * H * w)
	end
	if not cast then
		return
	end
	local A, Hh = castWeights(age, cw)
	local k = max(A, Hh)
	if cast == "Roar" then
		local shake = sin(t * 30) * 0.04 * k
		for _, role in ipairs({ "Neck1", "Neck2", "Neck3", "Neck4" }) do
			add(P, role, 0.2 * k, shake, 0)
		end
		add(P, "Head", 0.35 * k, 0, 0)
		add(P, "Jaw", -0.95 * k, 0, 0)
		add(P, "WingL1", 0, 0, -0.7 * k)
		add(P, "WingR1", 0, 0, 0.7 * k)
		add(P, "Hips", 0.15 * k, 0, 0)
	elseif cast == "Breath" then
		local shake = sin(t * 22) * 0.03 * Hh
		for _, role in ipairs({ "Neck1", "Neck2", "Neck3", "Neck4" }) do
			add(P, role, 0.12 * A - 0.12 * Hh, shake, 0)
		end
		add(P, "Head", -0.1 * Hh, 0, 0)
		add(P, "Jaw", -0.3 * A - 0.8 * Hh, 0, 0)
		add(P, "WingL1", 0, 0, -0.4 * k)
		add(P, "WingR1", 0, 0, 0.4 * k)
		add(P, "Chest", 0.12 * A - 0.08 * Hh, 0, 0)
	elseif cast == "Nova" then
		add(P, "WingL1", 0, 0, -1.1 * A + 0.9 * Hh)
		add(P, "WingR1", 0, 0, 1.1 * A - 0.9 * Hh)
		add(P, "WingL2", 0, 0, -0.4 * A)
		add(P, "WingR2", 0, 0, 0.4 * A)
		for _, role in ipairs({ "Neck1", "Neck2", "Neck3", "Neck4" }) do
			add(P, role, 0.14 * A - 0.12 * Hh, 0, 0)
		end
		add(P, "Jaw", -0.7 * k, 0, 0)
	end
end

local function mosasaur(P, B, t, w, cast, age, cw)
	local speed = 1.2 + w * 2.2
	local amp = 0.05 + w * 0.05
	-- ลำตัวว่ายส่ายเป็นคลื่นจากคอไปหาง (ช่วงหน้าแกว่งน้อย หางแกว่งมาก)
	local chain = { "Body1", "Body2", "Body3", "Body4", "Body5", "Body6", "Tail1", "Tail2", "Tail3" }
	for i, role in ipairs(chain) do
		local k = (i - 1) / (#chain - 1)
		add(P, role, sin(t * speed * 0.5 - i * 0.4) * 0.012, sin(t * speed - i * 0.55) * amp * (0.25 + k * 1.1), 0)
	end
	-- หัวส่ายสวนลำตัวเล็กน้อย (หัวนิ่งกว่าตัว ดูมีน้ำหนัก)
	add(P, "Head", 0, -sin(t * speed + 0.6) * amp * 0.35, 0)
	local pad = sin(t * speed) * 0.35
	add(P, "FlipperFL", 0, 0, -0.2 - pad)
	add(P, "FlipperFR", 0, 0, 0.2 + pad)
	add(P, "FlipperBL", 0, 0, -0.15 + pad * 0.6)
	add(P, "FlipperBR", 0, 0, 0.15 - pad * 0.6)
	-- หายใจ: ปากขยับนิดๆ
	add(P, "Jaw", -0.03 - max(0, sin(t * 0.8)) * 0.07, 0, 0)
	add(P, "Root", 0, 0, 0, 0, sin(t * speed * 0.5) * 0.015 * B.H)
	if not cast then
		return
	end
	local A, Hh = castWeights(age, cw)
	local k = max(A, Hh)
	if cast == "Rear" or cast == "Slam" then
		-- ยกหัว/อกขึ้นสูง (ยกทั้งตัวแล้วเอียงลำตัวให้หางยังแตะพื้น) อ้าปาก -> ฟาดหัวลง
		local lift = 0.22 * B.H * A - 0.08 * B.H * Hh
		local tilt = math.atan2(lift, B.L * 0.55)
		add(P, "Root", 0, 0, 0, 0, lift)
		add(P, "Body1", tilt * 0.6, 0, 0)
		add(P, "Body2", tilt * 0.4, 0, 0)
		add(P, "Head", 0.25 * A - 0.45 * Hh, 0, 0)
		add(P, "Jaw", -0.75 * A - 0.25 * Hh, 0, 0)
		add(P, "Snout", 0.12 * A, 0, 0)
		add(P, "FlipperFL", 0, 0, -0.5 * A)
		add(P, "FlipperFR", 0, 0, 0.5 * A)
	elseif cast == "Roar" then
		local shake = sin(t * 28) * 0.04 * k
		add(P, "Root", 0, 0, 0, 0, 0.06 * B.H * k)
		add(P, "Body1", 0.08 * k, 0, 0)
		add(P, "Head", 0.3 * k, shake, shake * 0.5)
		add(P, "Jaw", -0.95 * k, 0, 0)
		add(P, "Snout", 0.18 * k, 0, 0)
	end
end

---------------------------------------------------------------- ใส่ท่าลงกระดูก (นุ่ม)
local function apply(B, P, dt)
	local a = 1 - exp(-dt * 7.5)
	for role, e in pairs(B.Bones) do
		local p = P[role]
		local cur = e.Cur
		for i = 1, 6 do
			cur[i] += ((p and p[i] or 0) - cur[i]) * a
		end
		local rot = e.RestInv * ANG(cur[1], cur[2], cur[3]) * e.Rest
		if cur[4] ~= 0 or cur[5] ~= 0 or cur[6] ~= 0 then
			e.Bone.Transform = CFrame.new(e.RestInv * V(cur[4], cur[5], cur[6])) * rot
		else
			e.Bone.Transform = rot
		end
	end
end

-- หัว/คอหันมองผู้เล่น (เครื่องเรา)
local function lookAt(P, B, rig, dt)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local yaw, pitch = 0, 0
	if hrp then
		local rel = rig.Root.CFrame:PointToObjectSpace(hrp.Position)
		yaw = clamp(atan2(-rel.X, -rel.Z), -1.0, 1.0)
		pitch = clamp(atan2(rel.Y - B.H * 0.4, V(rel.X, 0, rel.Z).Magnitude), -0.45, 0.3)
	end
	local a = 1 - exp(-dt * 3)
	B.Look[1] += (yaw - B.Look[1]) * a
	B.Look[2] += (pitch - B.Look[2]) * a
	yaw, pitch = B.Look[1], B.Look[2]
	if B.Kind == "Dragon" then
		for _, role in ipairs({ "Neck1", "Neck2", "Neck3", "Neck4" }) do
			add(P, role, pitch * 0.15, yaw * 0.18, 0)
		end
		add(P, "Head", pitch * 0.4, yaw * 0.28, 0)
	elseif B.Kind == "Mosasaur" then
		add(P, "Head", pitch * 0.6, yaw * 0.55, 0) -- เฉพาะหัว (Neck = หมุนทั้งตัว)
	else
		add(P, "Neck", pitch * 0.4, yaw * 0.4, 0)
		add(P, "Head", pitch * 0.6, yaw * 0.6, 0)
		add(P, "Chest", 0, yaw * 0.15, 0)
	end
end

function BossAnimator.Animate(rig, ctx)
	local B = rig.Boss
	if not B then
		return
	end
	local model = rig.Model
	local P = {}
	local dt = ctx.Dt
	-- ตาย: ล้มลง
	if ctx.DeadT then
		local d = smooth((ctx.Now - ctx.DeadT) / 1.4)
		if B.Kind == "Dragon" then
			add(P, "Hips", 0, 0, 1.5 * d)
			add(P, "WingL1", 0, 0, 0.9 * d)
			add(P, "WingR1", 0, 0, -0.9 * d)
		elseif B.Kind == "Mosasaur" then
			add(P, "Root", 0, 0, 2.6 * d)
		else
			add(P, "Hips", 1.35 * d, 0, 0.25 * d, 0, -0.2 * B.H * d)
			add(P, "UpperArmL", 0.5 * d, 0, -1.0 * d)
			add(P, "UpperArmR", 0.5 * d, 0, 1.0 * d)
		end
		apply(B, P, dt)
		return
	end
	-- ความเร็วที่วัดจากเครื่องเรากระตุกขึ้นลง -> ทำให้นุ่มก่อน (ไม่สลับท่าเดิน/ยืนไปมา, ก้าวไม่สะดุด)
	B.SpeedS = (B.SpeedS or ctx.Speed) + (ctx.Speed - (B.SpeedS or ctx.Speed)) * (1 - exp(-dt * 4))
	local speed = B.SpeedS < 0.6 and 0 or B.SpeedS
	B.W = (B.W or 0) + (clamp(speed / 12, 0, 1) - (B.W or 0)) * (1 - exp(-dt * 3))
	local w = B.W
	B.Phase += dt * (speed / math.max(B.H * 0.5, 4)) * math.pi * 2 * 0.5
	local cast = model:GetAttribute("Cast")
	local age, cw = 0, 1
	if cast then
		age = Workspace:GetServerTimeNow() - (model:GetAttribute("CastAt") or 0)
		cw = model:GetAttribute("CastTime") or 1
		if age > cw + 1.2 then
			cast = nil
		end
	end
	local it = intro[model]
	if not cast and it then
		age = os.clock() - it.Start
		if age < it.Wind + 1.6 then
			cast, cw = it.Kind, it.Wind
		else
			intro[model] = nil
		end
	end
	if B.Kind == "Dragon" then
		dragon(P, B, ctx.Now, w, B.Phase, cast, age, cw, ctx.Flying)
	elseif B.Kind == "Mosasaur" then
		mosasaur(P, B, ctx.Now, w, cast, age, cw)
	else
		biped(P, B, ctx.Now, w, B.Phase, cast, age, cw)
	end
	lookAt(P, B, rig, dt)
	apply(B, P, dt)
end

return BossAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000070"><Properties><string name="Name">BossFX</string><ProtectedString name="Source"><![CDATA[--[[
	BossFX — เอฟเฟกต์สกิลบอส + ออร่าประจำตัว (วาดฝั่ง client ทั้งหมด เซิร์ฟเวอร์ส่งแค่ตำแหน่ง/เวลา)
	ใช้อนุภาคจริงจากคลัง VFX (VFXLib: แพ็กจาก Creator Store) + โมเดลก้อนหินจริง แทนรูปทรงพื้นฐาน
	  BossTelegraph · BossImpact · BossSpikes · BossWave · BossBreath · BossBlizzard
	  BossFX.Aura(model, element) · BossFX.Footstep(pos, scale, element)
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local VFXLib = require(script.Parent:WaitForChild("VFXLib"))

local BossFX = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB
local NS, NSK = NumberSequence.new, NumberSequenceKeypoint.new

local TEX = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

-- เอฟเฟกต์ในคลัง (ทดสอบแล้วว่าแสดงผลได้)
local FX = {
	Blast = "LightBlast/SUPER ANIME LIGHT GOLDEN BLAST/FireMegaExplosion",
	BlastWind = "LightBlast/SUPER ANIME LIGHT GOLDEN BLAST/WindBig",
	RockRing = "VFXPack/vfx pack/f",
	Explosion = "VFXPack/Anime/Realistic-Explosion-01",
	Fire1 = "VFXPack/Anime/Fire-01",
	Fire2 = "VFXPack/Anime/Fire-02",
	Fire3 = "VFXPack/Anime/Fire-03",
	Flamethrower = "VFXPack/Anime/Flamethrower-01",
	FireBall = "VFXPack/Big/Ball-01",
	Tornado = "VFXPack/Big/Tornado-01",
	Ice = "IceStomp",
	WaterSwirl = "VFXPack/Auras/Water-Aura-01",
	Crack = "VFXPack/Anime/Crack-01",
	RealFire = "RealFire/particles/the beutiful fire",
	-- น้ำของจริงจาก Creator Store (อนุภาค)
	Splash = "WaterSplash", -- น้ำกระเซ็นพุ่งสมจริง
	WaterBurst = "WaterBurst", -- ระเบิดน้ำ: วงคลื่น + เสาน้ำ
}
-- เมชเอฟเฟกต์น้ำ (ต้องเห็นชิ้นส่วนจริง ไม่ผ่าน VFXLib ที่ซ่อนชิ้นส่วน)
local MESH = {
	Tornado = "WaterTornado", -- กรวยพายุน้ำหมุน
	SplashMesh = "WaterMeshPack/Hybrid's Water VFX Pack/WaterSplash",
	SplashMesh2 = "WaterMeshPack/Hybrid's Water VFX Pack/WaterSplash2",
	Dome = "WaterMeshPack/Hybrid's Water VFX Pack/WaterExplosion1",
	Twist = "WaterMeshPack/Hybrid's Water VFX Pack/TwistY1",
}

-- สีย้อมเอฟเฟกต์ / สีเศษ / วัสดุเศษ ตามธาตุ
local STYLE = {
	Earth = { Tint = C(230, 170, 80), Main = C(170, 230, 90), Debris = C(112, 98, 82), Mat = Enum.Material.Slate, Dust = C(150, 130, 100) },
	Water = { Tint = C(80, 190, 255), Main = C(80, 200, 255), Debris = C(150, 215, 245), Mat = Enum.Material.Glass, Dust = C(210, 240, 255) },
	Air = { Tint = C(150, 220, 255), Main = C(160, 220, 255), Debris = C(190, 230, 255), Mat = Enum.Material.Ice, Dust = C(235, 245, 255) },
	Fire = { Main = C(255, 110, 30), Debris = C(58, 40, 36), Mat = Enum.Material.Basalt, Dust = C(90, 70, 60) },
}

local function style(el)
	return STYLE[el] or STYLE.Earth
end

local function folder()
	local f = Workspace:FindFirstChild("BossFX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "BossFX"
		f.Parent = Workspace
	end
	return f
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Neon
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = folder()
	return p
end

local function tween(obj, t, goal, s, d)
	local tw = TweenService:Create(obj, TweenInfo.new(t, s or Enum.EasingStyle.Quad, d or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function emitAt(pos, props, count, life)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = a
	e:Emit(count)
	Debris:AddItem(a, life or 4)
	return e
end

local function shakeFor(pos, radius, power)
	local cam = Workspace.CurrentCamera
	local d = (cam.CFrame.Position - pos).Magnitude
	local k = math.clamp(1 - d / (radius * 5 + 60), 0, 1)
	if k > 0 and BossFX.Shake then
		BossFX.Shake(power * k, 0.5 + 0.4 * k)
	end
end

local function play(name, cf, opts)
	return VFXLib.Play(FX[name] or name, cf, opts)
end

-- เมช VFX ของจริง (Assets.VFX/<path>) วางเท้าที่ cf สูง height · คืน model (ผู้เรียกสั่งหมุน/จางเอง) · หายเองหลัง life วินาที
local function meshFx(name, cf, height, life)
	local src = VFXLib.Find(MESH[name] or name)
	if not src then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = "MeshFX_" .. name
	local c = src:Clone()
	c.Parent = m
	-- พายุน้ำ: ตัดกล่องเมฆ/ท้องฟ้าน้ำขนาดใหญ่ ("Storm") ออก (เคยย้อมทั้งจอเป็นสีฟ้า) เหลือแค่กรวยน้ำ
	for _, d in ipairs(c:GetDescendants()) do
		if d.Name == "Storm" then
			d:Destroy()
		end
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			-- (ชิ้น "Car1" ของพายุน้ำ = กรวยหลัก ทุกชิ้นอยู่ข้างใต้ ห้ามลบ)
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("LuaSourceContainer") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	local bcf, size = m:GetBoundingBox()
	-- กรวยพายุ/เกลียวน้ำ: โมเดลบางชิ้นเก็บแบบนอน -> หมุนให้แกนยาวสุดตั้งขึ้น (เคยเห็นพายุนอนราบบนพื้น)
	if (name == "Tornado" or name == "Twist") and size.Y < math.max(size.X, size.Z) then
		local rot = size.X >= size.Z and ANG(0, 0, math.pi / 2) or ANG(math.pi / 2, 0, 0)
		local c = CF(bcf.Position)
		m:PivotTo(c * rot * c:ToObjectSpace(m:GetPivot())) -- หมุนรอบจุดกลางกล่อง
		bcf, size = m:GetBoundingBox()
	end
	m.WorldPivot = CF(bcf.Position - V(0, size.Y / 2, 0))
	pcall(function()
		m:ScaleTo(m:GetScale() * height / math.max(size.Y, 0.1))
	end)
	m:PivotTo(cf)
	m.Parent = folder()
	Debris:AddItem(m, life or 3)
	return m
end

-- จางเมชทั้งชิ้นลงในเวลา t (โปร่งใสขึ้นจากค่าเดิม)
local function fadeModel(m, t, delayT)
	task.delay(delayT or 0, function()
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				tween(d, t, { Transparency = 1 })
			elseif d:IsA("Decal") then
				tween(d, t, { Transparency = 1 })
			elseif d:IsA("ParticleEmitter") then
				d.Enabled = false
			end
		end
	end)
end

-- หมุนรอบแกนตั้งต่อเนื่อง (พายุน้ำ)
local function spinModel(m, speed, dur, rise)
	local base = m:GetPivot()
	local t0 = os.clock()
	task.spawn(function()
		while m.Parent and os.clock() - t0 < dur do
			local t = os.clock() - t0
			m:PivotTo(base * CF(0, (rise or 0) * math.min(t / 0.35, 1), 0) * ANG(0, t * speed, 0))
			task.wait()
		end
	end)
end

-- น้ำกระเซ็นจริง (อนุภาคจาก Store "WaterSplash") คุมเอง: ทิศพุ่ง = แกน +Y ของ cf · speed/life/ขนาด/แรงโน้มถ่วง
--   (ผ่าน VFXLib + ScaleTo แล้วความเร็วโดนขยายตาม -> ละอองพุ่งขึ้นฟ้าไกลเกิน)
local splashTpl
local function spray(cf, o)
	if splashTpl == nil then
		local src = VFXLib.Find("WaterSplash")
		splashTpl = src and src:FindFirstChildWhichIsA("ParticleEmitter", true) or false
	end
	local a = Instance.new("Attachment")
	a.Parent = Workspace.Terrain
	a.WorldCFrame = cf
	local e
	if splashTpl then
		e = splashTpl:Clone()
		local ks = {}
		for _, k in ipairs(splashTpl.Size.Keypoints) do
			table.insert(ks, NSK(k.Time, k.Value * (o.Scale or 3), k.Envelope * (o.Scale or 3)))
		end
		e.Size = NS(ks)
	else
		e = Instance.new("ParticleEmitter")
		e.Texture = TEX.Smoke
		e.Color = ColorSequence.new(C(200, 235, 255))
		e.Size = NS({ NSK(0, 1.5 * (o.Scale or 3)), NSK(1, 3 * (o.Scale or 3)) })
		e.Transparency = NS({ NSK(0, 0.3), NSK(1, 1) })
	end
	e.EmissionDirection = Enum.NormalId.Top
	e.Speed = NumberRange.new((o.Speed or 20) * 0.8, o.Speed or 20)
	e.Lifetime = NumberRange.new((o.Life or 1) * 0.7, o.Life or 1)
	e.Acceleration = V(0, -(o.Gravity or 40), 0)
	e.SpreadAngle = Vector2.new(o.Spread or 20, o.Spread or 20)
	e.Rate = o.Rate or 0
	e.Enabled = (o.Rate or 0) > 0
	e.Parent = a
	if o.Burst then
		e:Emit(o.Burst)
	end
	Debris:AddItem(a, (o.Time or 0) + (o.Life or 1) + 0.5)
	if o.Time then
		task.delay(o.Time, function()
			e.Enabled = false
		end)
	end
	return a, e
end

-- ก้อนหิน/ผลึกจริง (โมเดล RockLP)
local rockList
local function rock(size, el)
	if not rockList then
		rockList = {}
		local a = ReplicatedStorage:FindFirstChild("Assets")
		local pack = a and a:FindFirstChild("Props") and a.Props:FindFirstChild("RockLP")
		for _, d in ipairs(pack and pack:GetDescendants() or {}) do
			if d:IsA("MeshPart") then
				table.insert(rockList, d)
			end
		end
	end
	local src = rockList[math.random(1, math.max(#rockList, 1))]
	local s = style(el)
	local r
	if src then
		r = src:Clone()
		r:ClearAllChildren()
		r.Size = size
	else
		r = Instance.new("Part")
		r.Size = size
	end
	r.Color = s.Debris
	r.Material = s.Mat
	if el == "Air" then
		r.Transparency = 0.15
		r.Reflectance = 0.2
	elseif el == "Water" then
		r.Transparency = 0.35
	end
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = true
	return r
end

---------------------------------------------------------------- วงเตือน (บางๆ พอให้รู้ว่าต้องหลบ)
local function circleTele(d)
	local s = style(d.Element)
	local r, t = d.Radius, d.Time
	local base = CF(d.Pos + V(0, 0.12, 0)) * ANG(0, 0, math.pi / 2)
	local edge = part({ Shape = Enum.PartType.Cylinder, Size = V(0.15, r * 2, r * 2), CFrame = base, Color = C(255, 70, 50), Transparency = 0.7 })
	local inner = part({ Shape = Enum.PartType.Cylinder, Size = V(0.17, r * 2 - 1, r * 2 - 1), CFrame = base, Color = C(10, 6, 6), Transparency = 0.7 })
	local fill = part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 0.5, 0.5), CFrame = base, Color = s.Main, Transparency = 0.55 })
	tween(fill, t, { Size = V(0.2, r * 2 - 1, r * 2 - 1) }, Enum.EasingStyle.Linear)
	tween(edge, t, { Transparency = 0.35 }, Enum.EasingStyle.Linear)
	for _, p in ipairs({ edge, inner, fill }) do
		Debris:AddItem(p, t + 0.1)
	end
end

local function lineTele(d)
	local s = style(d.Element)
	local look = CF(d.Pos, d.Pos + d.Dir)
	local mid = look * CF(0, 0.12, -d.Length / 2)
	local edge = part({ Size = V(d.Width, 0.15, d.Length), CFrame = mid, Color = C(255, 70, 50), Transparency = 0.7 })
	local fill = part({ Size = V(d.Width - 1, 0.2, 0.5), CFrame = look * CF(0, 0.15, -0.25), Color = s.Main, Transparency = 0.55 })
	tween(fill, d.Time, { Size = V(d.Width - 1, 0.2, d.Length), CFrame = mid * CF(0, 0.03, 0) }, Enum.EasingStyle.Linear)
	tween(edge, d.Time, { Transparency = 0.35 }, Enum.EasingStyle.Linear)
	Debris:AddItem(edge, d.Time + 0.1)
	Debris:AddItem(fill, d.Time + 0.1)
end

---------------------------------------------------------------- เศษหินกระเด็น (โมเดลหินจริง)
local function debris(pos, r, el, n)
	if el == "Water" then
		return
	end
	local rng = Random.new()
	for _ = 1, n do
		local sz = rng:NextNumber(1.2, 3.2) * math.clamp(r / 25, 0.6, 2)
		local c = rock(V(sz, sz * rng:NextNumber(0.6, 1), sz), el)
		c.Anchored = false
		c.CanCollide = true
		c.CFrame = CF(pos + V(rng:NextNumber(-r, r) * 0.3, 2, rng:NextNumber(-r, r) * 0.3)) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		if el == "Fire" then
			c.Material = Enum.Material.CrackedLava
			c.Color = C(255, 110, 40)
		end
		c.Parent = folder()
		local a = rng:NextNumber(0, math.pi * 2)
		c.AssemblyLinearVelocity = V(math.cos(a) * rng:NextNumber(20, 50), rng:NextNumber(45, 85), math.sin(a) * rng:NextNumber(20, 50))
		c.AssemblyAngularVelocity = V(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
		task.delay(1.8, function()
			if c.Parent then
				c.Anchored = true
				tween(c, 0.6, { Size = c.Size * 0.1, Transparency = 1 })
			end
		end)
		Debris:AddItem(c, 2.6)
	end
end

local function dust(pos, r, el, count)
	local s = style(el)
	emitAt(pos + V(0, 1.5, 0), {
		Texture = TEX.Smoke, Lifetime = NumberRange.new(1.6, 2.8), Speed = NumberRange.new(r * 0.5, r * 1.1), SpreadAngle = Vector2.new(85, 8),
		Size = NS({ NSK(0, r * 0.15), NSK(1, r * 0.45) }), Transparency = NS({ NSK(0, 0.35), NSK(1, 1) }), Color = ColorSequence.new(s.Dust),
		Drag = 3, Acceleration = V(0, 3, 0), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-30, 30),
	}, count or 24, 4)
end

---------------------------------------------------------------- กระแทก
local function impactFx(d)
	local s = style(d.Element)
	local pos, r = d.Pos, d.Radius
	local small = d.Style == "Small"
	local el = d.Element
	local at = CF(pos)
	-- ระเบิดแสงหลัก (ย้อมสีตามธาตุ) + วงลม
	if not small then
		play("Blast", at, { Scale = math.clamp(r / 16, 0.6, 3.5), Duration = 0.25, Tint = s.Tint })
		play("BlastWind", at, { Scale = math.clamp(r / 18, 0.6, 3.5), Duration = 0.3, Tint = s.Tint })
	end
	-- เอฟเฟกต์ประจำธาตุ
	if el == "Earth" then
		play("RockRing", at, { Scale = math.clamp(r / 6, 1, 8), Duration = 0.3 })
		play("Crack", at, { Scale = math.clamp(r / 4, 1, 10), Duration = 0.3, Tint = C(255, 200, 120) })
	elseif el == "Fire" then
		play("Explosion", at, { Scale = math.clamp(r / 3, 2, 14), Duration = 0.35 })
		play("Fire2", at, { Scale = math.clamp(r / 3, 2, 12), Duration = 0.6 })
	elseif el == "Air" then
		play("Ice", at, { Scale = math.clamp(r / 5, 1, 7), Duration = 0.35 })
	elseif el == "Water" then
		play("WaterBurst", at, { Scale = math.clamp(r / 6, 1.5, 9), Duration = 0.5, Burst = 1 })
		spray(at, { Scale = math.clamp(r / 7, 2, 6), Speed = 22 + r * 0.4, Life = 1.2, Gravity = 45, Spread = 55, Burst = 40 })
		play("WaterSwirl", at, { Scale = math.clamp(r / 3, 2, 12), Duration = 0.6 })
		if not small then
			local dome = meshFx("Dome", at, math.clamp(r * 0.5, 6, 24), 1.6)
			if dome then
				fadeModel(dome, 0.8, 0.5)
			end
		end
	end
	if d.Style == "Geyser" then
		-- พวยน้ำ: กรวยพายุน้ำหมุนพุ่งจากพื้น + เสาน้ำกระเซ็น + ระเบิดน้ำที่ฐาน
		local h = math.clamp(r * 5, 30, 70)
		-- กรวยบานด้านบนกว้างมาก (เมชใหญ่กว่ากล่องชิ้นส่วน) -> ย่อความสูงลง ไม่งั้นปากกรวยครอบกล้องจนจอเป็นสีฟ้าทั้งจอ
		local tor = meshFx("Tornado", at * CF(0, -h * 0.2, 0), h * 0.42, 2.4)
		if tor then
			spinModel(tor, 9, 2.2, h * 0.2)
			fadeModel(tor, 0.7, 1.4)
		end
		-- เสาน้ำพุ่งขึ้นตรง สูงราวยอดพายุ แล้วตกโปรยรอบๆ
		spray(at, { Scale = math.clamp(r / 3, 3, 7), Speed = math.sqrt(2 * 40 * h) * 0.9, Life = 1.6, Gravity = 40, Spread = 9, Rate = 90, Time = 0.9 })
		spray(at, { Scale = 3, Speed = 18, Life = 1.1, Gravity = 35, Spread = 70, Burst = 30 })
		play("WaterBurst", at, { Scale = math.clamp(r / 4, 2, 9), Duration = 0.6, Burst = 1 })
	end
	local holder = Instance.new("Attachment")
	holder.WorldPosition = pos + V(0, 4, 0)
	holder.Parent = Workspace.Terrain
	local l = Instance.new("PointLight")
	l.Color = s.Main
	l.Range = math.min(r * 1.6, 60)
	l.Brightness = 5
	l.Parent = holder
	tween(l, 0.7, { Brightness = 0 })
	Debris:AddItem(holder, 0.8)
	dust(pos, r, el, small and 10 or 26)
	if not small then
		debris(pos, r, el, 10)
	end
	shakeFor(pos, r, small and 0.35 or 1.1)
end

---------------------------------------------------------------- หนาม: หินจริงผุดจากดิน / ผลึกน้ำแข็ง / เปลวไฟ
local function spikesFx(d)
	local rng = Random.new()
	local n = d.Count or 8
	local el = d.Element
	for i = 1, n do
		local pos
		if d.Ring then
			local a = i / n * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
			pos = d.Pos + V(math.cos(a) * d.Radius, 0, math.sin(a) * d.Radius)
		else
			pos = d.Pos + V(rng:NextNumber(-d.Radius, d.Radius), 0, rng:NextNumber(-d.Radius, d.Radius))
		end
		if el == "Fire" then
			play(i % 2 == 0 and "Fire1" or "Fire3", CF(pos), { Scale = rng:NextNumber(3.5, 5), Duration = 1.2 })
			if i % 3 == 0 then
				play("RealFire", CF(pos), { Scale = 8, Duration = 1.5 })
			end
		else
			local h = rng:NextNumber(9, 18)
			local w = rng:NextNumber(3, 5.5)
			local tilt = ANG(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4))
			local sp = rock(V(w, h, w * rng:NextNumber(0.7, 1)), el)
			sp.CFrame = CF(pos - V(0, h * 0.6, 0)) * tilt
			sp.Parent = folder()
			tween(sp, 0.14, { CFrame = CF(pos + V(0, h * 0.3, 0)) * tilt }, Enum.EasingStyle.Back)
			if el == "Air" then
				local l = Instance.new("PointLight")
				l.Color = C(150, 220, 255)
				l.Range = 12
				l.Brightness = 1
				l.Parent = sp
				if i % 3 == 0 then
					play("Ice", CF(pos), { Scale = 2, Duration = 0.3 })
				end
			end
			task.delay(1.5 + rng:NextNumber(0, 0.3), function()
				if sp.Parent then
					tween(sp, 0.5, { CFrame = sp.CFrame - V(0, h, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end)
			Debris:AddItem(sp, 2.4)
		end
	end
	dust(d.Pos, math.max(d.Radius, 8), el, 12)
end

---------------------------------------------------------------- กำแพงน้ำ
local function waveFx(d)
	-- คลื่นยักษ์: กำแพงเมชน้ำกระเซ็นเรียงเต็มความกว้าง + ละอองน้ำจริงพุ่งตลอดแนว วิ่งไปข้างหน้า แล้วซัดแตกที่ปลายทาง
	local look = CF(d.Pos, d.Pos + d.Dir)
	local cols = 6
	local crest = {}
	for k = 1, cols do
		local x = (k - (cols + 1) / 2) * d.Width / cols
		local mesh = meshFx(k % 2 == 0 and "SplashMesh" or "SplashMesh2", look * CF(x, -2, 0) * ANG(0, math.pi, 0), 24 + (k % 3) * 4, d.Time + 1.6)
		-- ยอดคลื่น: น้ำพุ่งเฉียงไปข้างหน้า (แกน +Y เอียงไปทาง -Z) ม้วนตกลงหน้าคลื่น + น้ำดันขึ้นด้านหลัง
		local front = spray(look * CF(x, 1, 0) * ANG(-0.85, 0, 0), { Scale = 4, Speed = 30, Life = 1.1, Gravity = 48, Spread = 14, Rate = 70, Time = d.Time + 0.3 })
		local back = spray(look * CF(x, 0, 4) * ANG(-0.25, 0, 0), { Scale = 4.5, Speed = 20, Life = 1.0, Gravity = 40, Spread = 18, Rate = 45, Time = d.Time + 0.3 })
		table.insert(crest, { mesh, front, x, back })
	end
	local swirls = {}
	for k = -2, 2 do
		local m = play("WaterSwirl", look * CF(k * d.Width / 5, 6, 0), { Scale = 7, Duration = d.Time + 0.4 })
		if m then
			table.insert(swirls, { m, k })
		end
	end
	play("WaterBurst", look, { Scale = 5, Duration = 0.5, Burst = 1 })
	task.delay(0.25, function()
		local t0 = os.clock()
		while os.clock() - t0 < d.Time do
			local u = (os.clock() - t0) / d.Time
			local z = -d.Length * u
			local rise = math.sin(math.min(u * 3, 1) * math.pi / 2) -- ยกตัวขึ้นเร็วตอนแรก
			for i, c in ipairs(crest) do
				local bob = math.sin(os.clock() * 6 + i) * 1.2
				if c[1] and c[1].Parent then
					c[1]:PivotTo(look * CF(c[3], -2 - 10 * (1 - rise) + bob, z) * ANG(0, math.pi, 0))
				end
				if c[2] and c[2].Parent then
					c[2].WorldCFrame = look * CF(c[3], 1 + bob * 0.3, z) * ANG(-0.85, 0, 0)
				end
				if c[4] and c[4].Parent then
					c[4].WorldCFrame = look * CF(c[3], 0, z + 4) * ANG(-0.25, 0, 0)
				end
			end
			for _, sw in ipairs(swirls) do
				if sw[1].Parent then
					sw[1]:PivotTo(look * CF(sw[2] * d.Width / 5, 6, z))
				end
			end
			if math.random() < 0.35 then
				dust((look * CF(math.random(-1, 1) * d.Width * 0.4, 0, z)).Position, 14, "Water", 8)
			end
			task.wait()
		end
		-- ซัดแตกที่ปลายทาง
		local endCf = look * CF(0, 0, -d.Length)
		play("WaterBurst", endCf, { Scale = 7, Duration = 0.6, Burst = 1 })
		for k = -1, 1 do
			spray(endCf * CF(k * d.Width / 3, 1, 0) * ANG(-0.5, 0, 0), { Scale = 5, Speed = 32, Life = 1.3, Gravity = 45, Spread = 40, Burst = 35 })
		end
		for _, c in ipairs(crest) do
			if c[1] and c[1].Parent then
				fadeModel(c[1], 0.6, 0)
			end
		end
	end)
	shakeFor(d.Pos, 30, 0.9)
end

---------------------------------------------------------------- พ่นไฟ (จากปากมังกรจริง)
local function breathFx(d)
	local model = d.Model
	local skin = model and model:FindFirstChild("Skin")
	-- ปากมังกร = ปลายขากรรไกร (Bone_025 HeadEnd) · ไม่มีใช้ข้อต่อขากรรไกร (Bone_026 อยู่ลึกในหัว ไฟเคยออกจากกลางหัว)
	local head, hinge
	if skin then
		for _, b in ipairs(skin:GetDescendants()) do
			if b:IsA("Bone") and b.Name == "Bone_025" then
				head = b
			elseif b:IsA("Bone") and b.Name == "Bone_026" then
				hinge = b
			end
		end
	end
	head = head or hinge
	local target = d.To
	if head then
		for k = 0, 2 do
			play("Flamethrower", head.WorldCFrame, { Scale = 7 + k * 1.5, Duration = d.Time, Follow = head, Aim = target, Rate = 2 })
		end
	else
		play("Flamethrower", CF(d.Pos + V(0, 20, 0), target), { Scale = 8, Duration = d.Time })
	end
	-- ไฟลุกตามแนวพื้น
	for i = 1, 6 do
		local p = d.Pos + d.Dir * (d.Length * i / 7)
		task.delay(0.1 * i, function()
			play(i % 2 == 0 and "Fire1" or "Fire2", CF(p), { Scale = 4, Duration = d.Time })
			if i % 2 == 1 then
				play("RealFire", CF(p), { Scale = 10, Duration = d.Time + 0.8 })
			end
		end)
	end
	shakeFor(d.Pos, 40, 0.5)
end

---------------------------------------------------------------- พายุหิมะ
local function blizzardFx(d)
	play("Tornado", CF(d.Pos), { Scale = math.clamp(d.Radius / 12, 2, 6), Duration = d.Time, Tint = C(200, 235, 255) })
	local hold = part({ Shape = Enum.PartType.Cylinder, Size = V(60, d.Radius * 2, d.Radius * 2), CFrame = CF(d.Pos + V(0, 30, 0)) * ANG(0, 0, math.pi / 2), Transparency = 1 })
	local snow = Instance.new("ParticleEmitter")
	snow.Texture = TEX.Spark
	snow.Shape = Enum.ParticleEmitterShape.Cylinder
	snow.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	snow.Rate = 220
	snow.Lifetime = NumberRange.new(1, 1.8)
	snow.Speed = NumberRange.new(10, 22)
	snow.Size = NS({ NSK(0, 0.8), NSK(1, 0.2) })
	snow.Color = ColorSequence.new(C(235, 248, 255))
	snow.LightEmission = 0.6
	snow.Acceleration = V(0, -6, 0)
	snow.Parent = hold
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = TEX.Smoke
	mist.Shape = Enum.ParticleEmitterShape.Cylinder
	mist.Rate = 24
	mist.Lifetime = NumberRange.new(1.5, 2.5)
	mist.Speed = NumberRange.new(3, 8)
	mist.Size = NS({ NSK(0, 10), NSK(1, 22) })
	mist.Transparency = NS({ NSK(0, 0.55), NSK(1, 1) })
	mist.Color = ColorSequence.new(C(220, 238, 255))
	mist.RotSpeed = NumberRange.new(-80, 80)
	mist.Parent = hold
	tween(hold, d.Time, { CFrame = hold.CFrame * ANG(math.pi * 4, 0, 0) }, Enum.EasingStyle.Linear)
	task.delay(d.Time, function()
		snow.Enabled = false
		mist.Enabled = false
	end)
	Debris:AddItem(hold, d.Time + 3)
end

---------------------------------------------------------------- หินถล่ม / อุกกาบาต (ก้อนหินจริงจากเซิร์ฟเวอร์ + ลูกไฟ/ควันฝั่งนี้)
local function watchProjectiles()
	local fx = Workspace:WaitForChild("FX", 30)
	if not fx then
		return
	end
	fx.ChildAdded:Connect(function(p)
		local kind = p:GetAttribute("VFX")
		if not (kind and p:IsA("BasePart")) then
			return
		end
		if kind == "StaffBolt" then
			-- ลูกไฟคทาเพลิง: Store "ExplosionCharge" ย่อเล็ก ลอยตามลูกจริง (ไม่ใส่ควันดำแบบอุกกาบาตบอส)
			play("StaffExplosion", p.CFrame, { Scale = p:GetAttribute("FxScale") or 0.09, Duration = 6, Follow = p })
			return
		end
		if kind == "Meteor" then
			-- จุดไฟของแพ็กอยู่หน้าชิ้นส่วน ~4 สตัด (ทาง -Z) -> ถอยกลับให้ลูกไฟครอบลูกจริงพอดี (server หัน -Z ตามทิศพุ่ง)
			local sc = p:GetAttribute("FxScale") or math.max(p.Size.X / 2.5, 2)
			play("FireBall", p.CFrame, { Scale = sc, Duration = 6, Follow = p, FollowOffset = CF(0, 0, 4 * sc) })
		end
		local a = Instance.new("Attachment")
		a.Parent = p
		local trail = Instance.new("ParticleEmitter")
		trail.Texture = TEX.Smoke
		trail.Rate = 40
		trail.Lifetime = NumberRange.new(0.8, 1.4)
		trail.Speed = NumberRange.new(0, 2)
		trail.Size = NS({ NSK(0, p.Size.X * 0.5), NSK(1, p.Size.X * 1.4) })
		trail.Transparency = NS({ NSK(0, 0.35), NSK(1, 1) })
		trail.Color = ColorSequence.new(kind == "Meteor" and C(70, 50, 45) or C(140, 125, 105))
		trail.Parent = a
	end)
end
task.spawn(watchProjectiles)

---------------------------------------------------------------- ออร่าติดตัว
function BossFX.Aura(model, element)
	local skin = model:FindFirstChild("Skin")
	if not skin or skin:FindFirstChild("BossAura") then
		return
	end
	local s = style(element)
	local size = skin.Size
	local att = Instance.new("Attachment")
	att.Name = "BossAura"
	att.Parent = skin
	local l = Instance.new("PointLight")
	l.Color = s.Main
	l.Range = math.min(math.max(size.X, size.Y, size.Z) * 0.5, 32)
	l.Brightness = 0.45
	l.Shadows = false
	l.Parent = att
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Rate = 22
	e.Parent = att
	if element == "Fire" then
		e.Texture = TEX.Spark
		e.Lifetime = NumberRange.new(1, 2)
		e.Speed = NumberRange.new(2, 6)
		e.Size = NS({ NSK(0, 0.8), NSK(1, 0) })
		e.Color = ColorSequence.new(C(255, 200, 90), C(255, 70, 20))
		e.LightEmission = 1
		e.Acceleration = V(0, 8, 0)
	elseif element == "Air" then
		e.Texture = TEX.Spark
		e.Lifetime = NumberRange.new(2, 3)
		e.Speed = NumberRange.new(1, 3)
		e.Size = NS(0.6)
		e.Color = ColorSequence.new(C(230, 245, 255))
		e.LightEmission = 0.5
		e.Acceleration = V(0, -4, 0)
	elseif element == "Water" then
		e.Texture = TEX.Spark
		e.Lifetime = NumberRange.new(1, 1.6)
		e.Speed = NumberRange.new(0, 2)
		e.Size = NS({ NSK(0, 0.7), NSK(1, 0.2) })
		e.Color = ColorSequence.new(C(160, 225, 255))
		e.LightEmission = 0.4
		e.Acceleration = V(0, -25, 0)
	else
		e.Texture = TEX.Smoke
		e.Lifetime = NumberRange.new(2, 3.5)
		e.Speed = NumberRange.new(1, 3)
		e.Size = NS({ NSK(0, 1.5), NSK(1, 4) })
		e.Transparency = NS({ NSK(0, 0.6), NSK(1, 1) })
		e.Color = ColorSequence.new(C(150, 130, 100))
		e.Acceleration = V(0, 2, 0)
	end
	local feet = Instance.new("Attachment")
	feet.Name = "BossFeetFx"
	feet.Position = V(0, -size.Y * 0.48, 0)
	feet.Parent = skin
	local m = Instance.new("ParticleEmitter")
	m.Texture = TEX.Smoke
	m.Rate = 6
	m.Lifetime = NumberRange.new(2, 3)
	m.Speed = NumberRange.new(2, 5)
	m.SpreadAngle = Vector2.new(180, 10)
	m.Size = NS({ NSK(0, size.X * 0.15), NSK(1, size.X * 0.4) })
	m.Transparency = NS({ NSK(0, 0.75), NSK(1, 1) })
	m.Color = ColorSequence.new(s.Dust)
	m.Parent = feet
end

---------------------------------------------------------------- เท้ายักษ์เหยียบพื้น: ฝุ่นฟุ้ง + จอสั่นเบาๆ
function BossFX.Footstep(pos, scale, element)
	local s = style(element)
	emitAt(pos + V(0, 0.5, 0), {
		Texture = TEX.Smoke, Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(5 * scale, 13 * scale), SpreadAngle = Vector2.new(85, 5),
		Size = NS({ NSK(0, 1.6 * scale), NSK(1, 5 * scale) }), Transparency = NS({ NSK(0, 0.45), NSK(1, 1) }), Color = ColorSequence.new(s.Dust),
		Drag = 4, Acceleration = V(0, 2, 0), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-30, 30),
	}, 12, 3)
	shakeFor(pos, 18 * scale, 0.3)
end

---------------------------------------------------------------- ตัวรับจาก HitFx
BossFX.Handlers = {
	BossTelegraph = function(d)
		if d.Shape == "Line" then
			lineTele(d)
		else
			circleTele(d)
		end
	end,
	BossImpact = impactFx,
	BossSpikes = spikesFx,
	BossWave = waveFx,
	BossBreath = breathFx,
	BossBlizzard = blizzardFx,
}

BossFX.Play = function(name, cf, opts)
	return play(name, cf, opts)
end
BossFX.Dust = function(pos, r, el, count)
	dust(pos, r, el, count)
end
BossFX.Debris = function(pos, r, el, n)
	debris(pos, r, el, n)
end
BossFX.Emit = emitAt
BossFX.Part = part
BossFX.TweenObj = tween

-- ฉากเปิดตัวบอส: ระเบิดกระแทกประจำธาตุที่ตีนบอส (น้ำ = น้ำพุ่งเป็นเสา)
function BossFX.IntroBurst(pos, radius, element)
	impactFx({ Pos = pos, Radius = radius, Element = element, Style = element == "Water" and "Geyser" or nil })
end

function BossFX.Init(shake)
	BossFX.Shake = shake
end

return BossFX
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000071"><Properties><string name="Name">Cinematics</string><ProtectedString name="Source"><![CDATA[--[[
	Cinematics — ฉาก/ตัวอักษรใหญ่แบบภาพยนตร์
	  หน้าโหลด, NIGHT X, BLOOD MOON, เปิดตัวบอส (กล้องหมุน), BEAST VANQUISHED, YOU PERISHED, ฉากจบ
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(script.Parent.UIKit)

local Cinematics = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local gui

local TIPS = {
	"กองไฟคือชีวิต — ไฟดับเมื่อไร กวางกลวงจะเข้ามาในแคมป์",
	"อัปเกรดกองไฟเพื่อเปิดหมอก และขยายเขตปลอดภัย",
	"ถือคบเพลิงไว้ กวางกลวงจะไม่กล้าเข้าใกล้",
	"น้ำชนะไฟ · ไฟชนะลม · ลมชนะดิน · ดินชนะน้ำ",
	"ลูกสัตว์ธาตุ 4 ตัวถูกขังอยู่ในศาลเจ้า ช่วยครบเพื่อฉากจบที่แท้จริง",
	"ทุก 10 คืนจะเกิดพระจันทร์เลือด ฝูงทุกธาตุบุกพร้อมกัน",
	"เพื่อนล้มลง? ใช้ผ้าพันแผลช่วยให้ทันใน 30 วินาที — ไม่เหลือใครยืนอยู่ = แพ้ทั้งทีม",
	"ตายแล้วไม่เกิดใหม่ในรอบนั้น — ช่วยกันระวังหลังให้กัน",
	"รอดครบ 99 คืน = พิชิต! แต่เล่นต่อได้ไม่จำกัดเพื่อทำสถิติขึ้นกระดานอันดับ",
	"หน้าไม้ยักษ์ยิงเองอัตโนมัติ วางไว้รอบกองไฟ",
	"ลมพัดขึ้นในเขตวายุจะส่งคุณขึ้นสู่เกาะลอยฟ้า",
	"รังบอสอยู่ใจกลางแต่ละธาตุ — เตรียมตัวให้พร้อมก่อนเข้าไป",
}

local function bigText(parent)
	return UIKit.Text(parent, {
		Size = UDim2.new(1, 0, 0, 90), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title,
		TextSize = 72, TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), TextTransparency = 1,
	})
end

local function fadeTexts(frame, to, time)
	for _, d in ipairs(frame:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, TweenInfo.new(time), { TextTransparency = to, TextStrokeTransparency = math.max(to, 0.4) }):Play()
		elseif d:IsA("Frame") and d:GetAttribute("Line") then
			TweenService:Create(d, TweenInfo.new(time), { BackgroundTransparency = to }):Play()
		end
	end
end

-- ข้อความใหญ่กลางจอ (หายเอง)
function Cinematics.Banner(title, subtitle, color, hold, opts)
	opts = opts or {}
	local f = UIKit.Frame(gui, { Size = UDim2.new(1, 0, 0, 170), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, opts.Y or 0.28, 0), BackgroundTransparency = 1 })
	UIKit.AutoScale(f) -- มือถือ: ตัวหนังสือใหญ่กลางจอย่อตามจอ
	local t = bigText(f)
	t.Text = title
	t.TextColor3 = color or C.Gold
	t.TextSize = opts.Size or 72
	local line = UIKit.Frame(f, { Size = UDim2.new(0, 520, 0, 2), Position = UDim2.new(0.5, -260, 0, 92), BackgroundColor3 = color or C.Gold, BackgroundTransparency = 1 })
	line:SetAttribute("Line", true)
	local s = UIKit.Text(f, {
		Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 100), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Bold,
		TextSize = 24, Text = subtitle or "", TextColor3 = C.Text, TextTransparency = 1, TextStrokeTransparency = 1,
	})
	local _ = s
	fadeTexts(f, 0, 0.8)
	task.delay(hold or 3, function()
		fadeTexts(f, 1, 1.2)
		task.wait(1.3)
		f:Destroy()
	end)
	return f
end

-- แถบดำบน-ล่าง
local bars
local function letterbox(on)
	if not bars then
		bars = {
			UIKit.Frame(gui, { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromScale(0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 50 }),
			UIKit.Frame(gui, { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 50 }),
		}
	end
	for _, b in ipairs(bars) do
		UIKit.Tween(b, 0.6, { Size = UDim2.new(1, 0, on and 0.12 or 0, 0) })
	end
end

---------------------------------------------------------------- หน้าโหลด (เข้าเกม + เดินทางลงแมพ)
-- ฉากหลัง 3 มิติ: แคมป์กลางป่ายามค่ำ (โมเดลจริงในเกม) กล้องค่อยๆ หมุนรอบกองไฟ + มังกรเฝ้าอยู่หลังแนวป่า
local function asset(folder, name)
	local a = ReplicatedStorage:FindFirstChild("Assets")
	local f = a and a:FindFirstChild(folder)
	local src = f and f:FindFirstChild(name)
	if not src then
		return nil
	end
	local m = src:Clone()
	if m:IsA("BasePart") then
		local wrap = Instance.new("Model")
		m.Parent = wrap
		wrap.PrimaryPart = m
		m = wrap
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end
	return m
end

local function placeModel(world, m, height, cf)
	if not m then
		return nil
	end
	m.Parent = world
	local _, size = m:GetBoundingBox()
	if height and size.Y > 0.05 then
		pcall(function()
			m:ScaleTo(m:GetScale() * height / size.Y)
		end)
	end
	local bcf, bsize = m:GetBoundingBox()
	local pivot = m:GetPivot()
	local foot = pivot.Position.Y - (bcf.Position.Y - bsize.Y / 2)
	local off = pivot.Position - bcf.Position
	m:PivotTo(cf * CFrame.new(off.X, foot, off.Z) * (pivot - pivot.Position))
	return m
end

local function campScene(parent)
	local vpf = Instance.new("ViewportFrame")
	-- ใหญ่กว่าจอนิดหน่อย: เลื่อนกรอบภาพช้าๆ แทนการขยับกล้อง (ฉาก 3 มิติวาดครั้งเดียว ไม่ต้องวาดใหม่ทุกเฟรม = ไม่แลค)
	vpf.AnchorPoint = Vector2.new(0.5, 0.5)
	vpf.Position = UDim2.fromScale(0.5, 0.5)
	vpf.Size = UDim2.fromScale(1.12, 1.12)
	vpf.BackgroundTransparency = 1
	vpf.ZIndex = 100
	vpf.Ambient = Color3.fromRGB(70, 74, 120)
	vpf.LightColor = Color3.fromRGB(255, 150, 80)
	vpf.LightDirection = Vector3.new(0.2, -0.35, -1)
	vpf.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vpf
	local rng = Random.new(7)
	-- พื้นดิน
	local ground = Instance.new("Part")
	ground.Anchored = true
	ground.Shape = Enum.PartType.Cylinder
	ground.Size = Vector3.new(1, 220, 220)
	ground.CFrame = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, math.pi / 2)
	ground.Color = Color3.fromRGB(46, 58, 40)
	ground.Material = Enum.Material.Grass
	ground.Parent = world
	-- กองไฟ + ม้านั่ง + เต็นท์
	placeModel(world, asset("Props", "CampfireLogs"), 3, CFrame.new())
	local ember = Instance.new("Part")
	ember.Anchored = true
	ember.Shape = Enum.PartType.Ball
	ember.Size = Vector3.new(2.6, 2.6, 2.6)
	ember.CFrame = CFrame.new(0, 1.6, 0)
	ember.Material = Enum.Material.Neon
	ember.Color = Color3.fromRGB(255, 150, 50)
	ember.Transparency = 0.15
	ember.Parent = world
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2 + 0.4
		placeModel(world, asset("Props", "LogBench"), 1.6, CFrame.new(math.cos(a) * 7, 0, math.sin(a) * 7) * CFrame.Angles(0, -a + math.pi / 2, 0))
	end
	placeModel(world, asset("Props", "SleepingBagStore"), 2, CFrame.new(-11, 0, 6) * CFrame.Angles(0, 1.2, 0))
	placeModel(world, asset("Props", "LogPileStore"), 2.4, CFrame.new(9, 0, -8) * CFrame.Angles(0, 0.6, 0))
	-- ผู้รอดชีวิตรอบกองไฟ (หันหน้าเข้ากองไฟ)
	for i, cls in ipairs({ "Survivor", "Hunter", "Medic", "Lumberjack" }) do
		local a = i / 4 * math.pi * 2 + 1.1
		local okC, ClassAvatars = pcall(require, script.Parent.ClassAvatars)
		if okC then
			local okB, m = pcall(ClassAvatars.Build, cls)
			if okB and m then
				m.Parent = world
				local pos = Vector3.new(math.cos(a) * 4.6, 0, math.sin(a) * 4.6)
				m:PivotTo(CFrame.lookAt(pos, Vector3.new(0, 0, 0)))
			end
		end
	end
	-- แนวป่ารอบแคมป์ 2 ชั้น
	local trees = { "Fir1", "SnowPine", "OakPack", "Fir1", "DeadTree" }
	for ring = 1, 2 do
		local count = ring == 1 and 10 or 14
		for i = 1, count do
			local a = i / count * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
			local r = (ring == 1 and 24 or 40) + rng:NextNumber(-3, 3)
			placeModel(world, asset("Props", trees[rng:NextInteger(1, #trees)]), rng:NextNumber(14, 22) * (ring == 1 and 1 or 1.25),
				CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0))
		end
	end
	for i = 1, 6 do
		local a = rng:NextNumber(0, 6.28)
		local r = rng:NextNumber(10, 20)
		placeModel(world, asset("Props", i % 2 == 0 and "RockLP" or "BushLP"), rng:NextNumber(1.2, 2.6), CFrame.new(math.cos(a) * r, 0, math.sin(a) * r))
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 52
	cam.Parent = vpf
	vpf.CurrentCamera = cam
	-- กล้องนิ่ง (วาดฉากครั้งเดียว) · ความเคลื่อนไหวมาจาก: กรอบภาพเลื่อนช้าๆ + ประกายไฟ 2 มิติ
	cam.CFrame = CFrame.lookAt(Vector3.new(math.cos(0.3) * 21, 6.5, math.sin(0.3) * 21), Vector3.new(0, 4.5, 0))
	vpf.LightColor = Color3.fromRGB(255, 150, 70)
	local pan = TweenService:Create(vpf, TweenInfo.new(14, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromScale(0.535, 0.48) })
	pan:Play()
	vpf.Destroying:Connect(function()
		pan:Cancel()
	end)
	return vpf
end

-- โครงหน้าโหลด: ฉากแคมป์ 3 มิติ + หมอก/แสงไฟ + โลโก้สี่ธาตุ + ชื่อเกมเงาวิ่ง + แถบความคืบหน้าสี่ธาตุ + ขั้นตอน + เคล็ดลับ
-- คืน { Root, Set(p, text), Close() }
local function sceneLoadingScreen(title, subtitle)
	local f = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 6, 14), BackgroundTransparency = 0, ZIndex = 100 })
	UIKit.Gradient(f, Color3.fromRGB(30, 26, 70), Color3.fromRGB(6, 6, 14), 90)
	pcall(campScene, f)
	-- หมอกบน/ล่าง + ขอบมืด
	local fogTop = UIKit.Frame(f, { Size = UDim2.fromScale(1, 0.55), BackgroundColor3 = Color3.fromRGB(10, 10, 30), BackgroundTransparency = 0, ZIndex = 101 })
	local ft = Instance.new("UIGradient")
	ft.Rotation = 90
	ft.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.55, 0.7), NumberSequenceKeypoint.new(1, 1) })
	ft.Parent = fogTop
	local fogBottom = UIKit.Frame(f, { Size = UDim2.fromScale(1, 0.45), Position = UDim2.fromScale(0, 0.55), BackgroundColor3 = Color3.fromRGB(8, 6, 10), BackgroundTransparency = 0, ZIndex = 101 })
	local fb = Instance.new("UIGradient")
	fb.Rotation = 90
	fb.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 0) })
	fb.Parent = fogBottom
	-- แสงไฟกองไฟวูบวาบกลางจอ
	local glow = UIKit.Frame(f, { Size = UDim2.fromScale(0.9, 0.7), Position = UDim2.fromScale(0.05, 0.38), BackgroundColor3 = Color3.fromRGB(255, 120, 40), BackgroundTransparency = 0.78, ZIndex = 101 })
	UIKit.Corner(glow, 600)
	local gg = Instance.new("UIGradient")
	gg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.25), NumberSequenceKeypoint.new(1, 1) })
	gg.Parent = glow
	-- ประกายไฟลอยขึ้น
	for i = 1, 22 do
		local sz = math.random(2, 5)
		local s = UIKit.Frame(f, { Size = UDim2.fromOffset(sz, sz), Position = UDim2.fromScale(0.3 + math.random() * 0.4, 1.02), BackgroundColor3 = Color3.fromRGB(255, math.random(150, 210), 80), BackgroundTransparency = 0.1, ZIndex = 102 })
		UIKit.Corner(s, 3)
		task.spawn(function()
			task.wait(i * 0.12)
			while s.Parent do
				s.Position = UDim2.fromScale(0.3 + math.random() * 0.4, 0.75 + math.random() * 0.2)
				s.BackgroundTransparency = 0.1
				local t = 2.5 + math.random() * 3
				TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Sine), { Position = UDim2.fromScale(s.Position.X.Scale + (math.random() - 0.5) * 0.25, 0.2 + math.random() * 0.35), BackgroundTransparency = 1 }):Play()
				task.wait(t)
			end
		end)
	end
	-- โลโก้: ลูกแก้วสี่ธาตุหมุนรอบเปลวไฟ
	local emblem = UIKit.Frame(f, { Size = UDim2.fromOffset(150, 150), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.17), BackgroundTransparency = 1, ZIndex = 103 })
	local core = UIKit.IconBadge(emblem, "🔥", Color3.fromRGB(255, 150, 40), 70, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 104 })
	core:FindFirstChildOfClass("TextLabel").ZIndex = 105
	local ring = UIKit.Frame(emblem, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 103 })
	local rs = Instance.new("UIStroke")
	rs.Thickness = 3
	rs.Color = Color3.fromRGB(255, 220, 150)
	rs.Transparency = 0.5
	rs.Parent = ring
	UIKit.Corner(ring, 200)
	local orbs = {}
	for i, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		local o = UIKit.IconBadge(emblem, UIKit.ElementIcon[el], C.Element[el], 42, { AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 106 })
		o:FindFirstChildOfClass("TextLabel").ZIndex = 107
		orbs[i] = o
	end
	-- ชื่อเกม (ทองไล่สี + เงาวิ่ง) — อยู่ในกล่องเดียวกัน ย่อ/ขยายพร้อมกัน
	local titleBox = UIKit.Frame(f, { Size = UDim2.fromOffset(1100, 170), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.28), BackgroundTransparency = 1, ZIndex = 104 })
	local titleL = UIKit.Text(titleBox, {
		Size = UDim2.new(1, 0, 0, 120), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title,
		TextSize = 110, Text = title, TextColor3 = Color3.new(1, 1, 1), ZIndex = 104,
	})
	titleL:FindFirstChildOfClass("UIStroke").Thickness = 7
	local tg = Instance.new("UIGradient")
	tg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 50)), ColorSequenceKeypoint.new(0.42, Color3.fromRGB(255, 236, 150)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.58, Color3.fromRGB(255, 236, 150)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 40)),
	})
	tg.Parent = titleL
	local sub = UIKit.Text(titleBox, {
		Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 118), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title,
		TextSize = 32, Text = subtitle, TextColor3 = Color3.fromRGB(236, 220, 190), ZIndex = 104,
	})
	local line = UIKit.Frame(titleBox, { Size = UDim2.new(0, 420, 0, 3), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 164), BackgroundColor3 = C.Gold, BackgroundTransparency = 0, ZIndex = 104 })
	local lg = Instance.new("UIGradient")
	lg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
	lg.Parent = line
	-- แถบความคืบหน้า (สี่ธาตุ + หัวเรืองแสง + แสงวิ่ง)
	local barW = 680
	local barBox = UIKit.Frame(f, { Size = UDim2.fromOffset(barW, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.8), BackgroundTransparency = 1, ZIndex = 104 })
	local track = UIKit.Frame(barBox, { Size = UDim2.new(0, barW, 0, 26), Position = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.fromRGB(14, 14, 30), BackgroundTransparency = 0.1, ZIndex = 104, ClipsDescendants = true })
	UIKit.Corner(track, 11)
	local trackStroke = Instance.new("UIStroke")
	trackStroke.Thickness = 3
	trackStroke.Color = Color3.fromRGB(255, 214, 120)
	trackStroke.Transparency = 0.35
	trackStroke.Parent = track
	local fill = UIKit.Frame(track, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 105 })
	UIKit.Corner(fill, 11)
	local fc = Instance.new("UIGradient")
	fc.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, C.Element.Earth), ColorSequenceKeypoint.new(0.33, C.Element.Water),
		ColorSequenceKeypoint.new(0.66, C.Element.Air), ColorSequenceKeypoint.new(1, C.Element.Fire),
	})
	fc.Parent = fill
	local sheen = UIKit.Frame(fill, { Size = UDim2.fromScale(1, 0.45), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7, ZIndex = 106 })
	UIKit.Corner(sheen, 8)
	local runner = UIKit.Frame(fill, { Size = UDim2.new(0, 90, 1, 0), Position = UDim2.fromScale(-0.2, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 107 })
	local rg = Instance.new("UIGradient")
	rg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) })
	rg.Parent = runner
	local head = UIKit.Frame(barBox, { Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 13), BackgroundColor3 = Color3.fromRGB(255, 230, 160), BackgroundTransparency = 0.3, ZIndex = 108 })
	UIKit.Corner(head, 20)
	local pct = UIKit.Text(barBox, { Size = UDim2.new(0, barW, 0, 30), Position = UDim2.fromOffset(0, -36), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 28, Font = UIKit.Fonts.Title, ZIndex = 104, TextColor3 = C.Gold, Text = "0%" })
	local status = UIKit.Text(barBox, { Size = UDim2.new(0, barW - 100, 0, 30), Position = UDim2.fromOffset(0, -36), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 19, Font = UIKit.Fonts.Black, ZIndex = 104, TextColor3 = Color3.fromRGB(230, 216, 194), Text = "" })
	-- ขั้นตอน (ติ๊กถูกเมื่อผ่าน)
	local steps = { { 0.4, "🌍 สร้างโลกสี่ธาตุ" }, { 0.9, "🎨 โหลดโมเดลและพื้นผิว" }, { 1, "🔥 จุดไฟในค่าย" } }
	local stepRow = UIKit.Frame(barBox, { Size = UDim2.new(0, barW, 0, 26), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, ZIndex = 104 })
	local sl = Instance.new("UIListLayout")
	sl.FillDirection = Enum.FillDirection.Horizontal
	sl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	sl.Padding = UDim.new(0, 26)
	sl.Parent = stepRow
	local stepLabels = {}
	for i, st in ipairs(steps) do
		stepLabels[i] = UIKit.Text(stepRow, { Size = UDim2.fromOffset(200, 26), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = UIKit.Fonts.Black, ZIndex = 104, TextColor3 = Color3.fromRGB(150, 146, 170), Text = "○ " .. st[2], LayoutOrder = i })
	end
	-- การ์ดเคล็ดลับ
	local tipCard = UIKit.Frame(f, { Size = UDim2.new(0, 760, 0, 46), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.91, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 32), BackgroundTransparency = 0.25, ZIndex = 104 })
	UIKit.Corner(tipCard, 14)
	local tcs = Instance.new("UIStroke")
	tcs.Thickness = 2
	tcs.Color = Color3.fromRGB(255, 214, 120)
	tcs.Transparency = 0.6
	tcs.Parent = tipCard
	local tip = UIKit.Text(tipCard, { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(15, 0), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18, ZIndex = 105, TextColor3 = Color3.fromRGB(236, 224, 200), TextWrapped = true, Text = "💡 " .. TIPS[math.random(#TIPS)] })
	-- ย่อทั้งชุดบนจอเล็ก (มือถือ)
	for _, obj in ipairs({ emblem, titleBox, barBox, tipCard }) do
		UIKit.AutoScale(obj)
	end
	local t0 = os.clock()
	local animConn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		for i, o in ipairs(orbs) do
			local a = t * 0.9 + (i - 1) * math.pi / 2
			o.Position = UDim2.new(0.5, math.cos(a) * 75, 0.5, math.sin(a) * 75 * 0.45)
			o.ZIndex = math.sin(a) > 0 and 106 or 102
			o:FindFirstChildOfClass("TextLabel").ZIndex = o.ZIndex + 1
		end
		core.Rotation = math.sin(t * 2) * 6
		tg.Offset = Vector2.new(((t * 0.35) % 2) - 1, 0)
		runner.Position = UDim2.new(((t * 0.6) % 1.4) - 0.2, 0, 0, 0)
		glow.BackgroundTransparency = 0.76 + math.noise(t * 2.3, 1.7) * 0.08
		head.Size = UDim2.fromOffset(30 + math.sin(t * 6) * 4, 30 + math.sin(t * 6) * 4)
	end)
	task.spawn(function()
		while f.Parent do
			task.wait(5)
			if not f.Parent then
				break
			end
			UIKit.Tween(tip, 0.3, { TextTransparency = 1 })
			task.wait(0.32)
			tip.Text = "💡 " .. TIPS[math.random(#TIPS)]
			UIKit.Tween(tip, 0.3, { TextTransparency = 0 })
		end
	end)
	local shown, target = 0, 0
	-- แถบไหลไปหาเป้าหมายแบบนุ่มๆ ทุกเฟรม (ไม่กระตุกเป็นขั้นๆ)
	local smoothConn = RunService.RenderStepped:Connect(function(dt)
		if math.abs(target - shown) > 0.0005 then
			shown += (target - shown) * math.min(1, dt * 6)
			fill.Size = UDim2.fromScale(shown, 1)
			head.Position = UDim2.fromOffset(barW * shown, 13)
			pct.Text = math.floor(shown * 100 + 0.5) .. "%"
		end
	end)
	f.Destroying:Connect(function()
		smoothConn:Disconnect()
	end)
	local api = { Root = f }
	function api.Set(p, text)
		p = math.clamp(p, 0, 1)
		if p > target then
			target = p
		end
		for i, st in ipairs(steps) do
			local done = target >= st[1] - 0.001
			local active = not done and (i == 1 or target >= steps[i - 1][1] - 0.001)
			stepLabels[i].Text = (done and "✔ " or (active and "◉ " or "○ ")) .. st[2]
			stepLabels[i].TextColor3 = done and C.Good or (active and C.Gold or Color3.fromRGB(150, 146, 170))
		end
		if text then
			status.Text = text
		end
	end
	function api.Close()
		-- กันค้าง: ถ้าแอนิเมชันปิดพังกลางทาง ก็ต้องลบหน้าโหลดทิ้งเสมอ (ไม่งั้นบังจอจนกดอะไรไม่ได้)
		task.delay(4, function()
			if f.Parent then
				animConn:Disconnect()
				f:Destroy()
			end
		end)
		api.Set(1, "พร้อมแล้ว!")
		local tw = os.clock()
		while shown < 0.995 and os.clock() - tw < 1.2 do
			task.wait()
		end
		task.wait(0.25)
		local vpf = f:FindFirstChildOfClass("ViewportFrame")
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("TextLabel") then
				UIKit.Tween(d, 0.9, { TextTransparency = 1, TextStrokeTransparency = 1 })
			elseif d:IsA("Frame") then
				UIKit.Tween(d, 0.9, { BackgroundTransparency = 1 })
			elseif d:IsA("UIStroke") then
				UIKit.Tween(d, 0.9, { Transparency = 1 })
			end
		end
		if vpf then
			UIKit.Tween(vpf, 0.9, { ImageTransparency = 1 })
		end
		UIKit.Tween(f, 1, { BackgroundTransparency = 1 })
		task.wait(1.05)
		animConn:Disconnect()
		f:Destroy()
	end
	api.Set(0)
	-- เปิดหน้าโหลดแบบนุ่ม: ชื่อเกมเลื่อนลงมา + กล่องต่างๆ ค่อยๆ ขยาย
	titleBox.Position = UDim2.new(0.5, 0, 0.28, -40)
	UIKit.Tween(titleBox, 0.9, { Position = UDim2.fromScale(0.5, 0.28) }, Enum.EasingStyle.Back)
	for _, obj in ipairs({ emblem, barBox, tipCard }) do
		local sc = obj:FindFirstChild("AutoScale")
		if sc then
			local k = sc.Scale
			sc.Scale = k * 0.7
			UIKit.Tween(sc, 0.7, { Scale = k }, Enum.EasingStyle.Back)
		end
	end
	return api
end

-- หน้าโหลดแบบภาพวาด (Shared/LoadingArt: ค่ายริมกองไฟ + โลโก้) เต็มจอแบบครอป + หลอดโหลด/เคล็ดลับจริงวางทับตำแหน่งในรูป
local function artLoadingScreen(img)
	local LoadingArt = require(ReplicatedStorage.Shared.LoadingArt)
	local f = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 8, 18), BackgroundTransparency = 0, ZIndex = 100, ClipsDescendants = true })
	local canvas = Instance.new("ImageLabel")
	canvas.Name = "Art"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.BackgroundTransparency = 1
	canvas.ImageContent = Content.fromObject(img)
	canvas.ZIndex = 101
	canvas.Parent = f
	-- ฉากหลัง: รูปเดียวกันขยายเต็มจอแบบมืด (เติมขอบจอที่ไม่ใช่ 16:9)
	local backdrop = canvas:Clone()
	backdrop.Name = "Backdrop"
	backdrop.ZIndex = 100
	backdrop.ImageColor3 = Color3.fromRGB(90, 90, 110)
	backdrop.Parent = f
	-- รูปหลักเห็นครบทั้งภาพเสมอ (โลโก้บน + หลอดโหลด/เคล็ดลับล่าง ไม่โดนตัด)
	local function fit()
		local sw, sh = f.AbsoluteSize.X, f.AbsoluteSize.Y
		if sw < 2 or sh < 2 then
			return
		end
		local w, h = sw, sw / LoadingArt.Aspect
		if h > sh then
			h, w = sh, sh * LoadingArt.Aspect
		end
		canvas.Size = UDim2.fromOffset(w, h)
		local bw, bh = sw, sw / LoadingArt.Aspect
		if bh < sh then
			bh, bw = sh, sh * LoadingArt.Aspect
		end
		backdrop.Size = UDim2.fromOffset(bw * 1.08, bh * 1.08)
	end
	fit()
	f:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	local zoom = Instance.new("UIScale")
	zoom.Parent = canvas
	local breathe = TweenService:Create(zoom, TweenInfo.new(9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.035 })
	breathe:Play()
	local function rect(r, props)
		local o = UIKit.Frame(canvas, { Position = UDim2.fromScale(r[1], r[2]), Size = UDim2.fromScale(r[3] - r[1], r[4] - r[2]), BackgroundTransparency = 1, ZIndex = 103 })
		for k, v in pairs(props or {}) do
			o[k] = v
		end
		return o
	end
	-- แสงกองไฟวูบวาบ
	local glow = UIKit.Frame(canvas, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.49, 0.64), Size = UDim2.fromScale(0.3, 0.3), BackgroundColor3 = Color3.fromRGB(255, 140, 50), BackgroundTransparency = 0.85, ZIndex = 102 })
	UIKit.Corner(glow, 600)
	local gg = Instance.new("UIGradient")
	gg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) })
	gg.Parent = glow
	-- ประกายไฟลอยขึ้นจากกองไฟ
	for i = 1, 16 do
		local sz = math.random(2, 4)
		local sp = UIKit.Frame(canvas, { Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = Color3.fromRGB(255, math.random(160, 220), 90), BackgroundTransparency = 1, ZIndex = 102 })
		UIKit.Corner(sp, 3)
		task.spawn(function()
			task.wait(i * 0.2)
			while sp.Parent do
				sp.Position = UDim2.fromScale(0.47 + math.random() * 0.05, 0.66)
				sp.BackgroundTransparency = 0.1
				local t = 2 + math.random() * 2.5
				TweenService:Create(sp, TweenInfo.new(t, Enum.EasingStyle.Sine), { Position = UDim2.fromScale(0.44 + math.random() * 0.12, 0.32 + math.random() * 0.2), BackgroundTransparency = 1 }):Play()
				task.wait(t)
			end
		end)
	end
	-- หลอดโหลด (เขียวไล่สี + เงาวาว) ในรางของรูป
	local bar = rect(LoadingArt.Bar, { ClipsDescendants = true })
	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bar
	local fill = UIKit.Frame(bar, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 104 })
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill
	local fg = Instance.new("UIGradient")
	fg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 200, 60)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 240, 110)), ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 215, 70)),
	})
	fg.Parent = fill
	local sheen = UIKit.Frame(fill, { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.12), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.72, ZIndex = 105 })
	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(1, 0)
	sc.Parent = sheen
	local pct = rect(LoadingArt.Pct)
	local pctL = UIKit.Text(pct, { Size = UDim2.fromScale(1, 1), TextScaled = true, Font = UIKit.Fonts.Title, TextXAlignment = Enum.TextXAlignment.Center, Text = "0%", ZIndex = 104 })
	local tipBox = rect(LoadingArt.Tip)
	local tip = UIKit.Text(tipBox, { Size = UDim2.fromScale(1, 0.72), Position = UDim2.fromScale(0, 0.14), TextScaled = true, Font = UIKit.Fonts.Bold, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(240, 226, 200), Text = "💡 " .. TIPS[math.random(#TIPS)], ZIndex = 104 })
	local status = UIKit.Text(canvas, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, LoadingArt.Tip[4] + 0.012), Size = UDim2.fromScale(0.4, 0.024), TextScaled = true, Font = UIKit.Fonts.Bold, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(220, 206, 186), Text = "", ZIndex = 104 })
	local t0 = os.clock()
	local animConn = RunService.RenderStepped:Connect(function()
		glow.BackgroundTransparency = 0.82 + math.noise((os.clock() - t0) * 2.3, 1.7) * 0.1
	end)
	task.spawn(function()
		while f.Parent do
			task.wait(5)
			if not f.Parent then
				break
			end
			UIKit.Tween(tip, 0.3, { TextTransparency = 1 })
			task.wait(0.32)
			tip.Text = "💡 " .. TIPS[math.random(#TIPS)]
			UIKit.Tween(tip, 0.3, { TextTransparency = 0 })
		end
	end)
	local shown, target = 0, 0
	local smoothConn = RunService.RenderStepped:Connect(function(dt)
		if math.abs(target - shown) > 0.0005 then
			shown += (target - shown) * math.min(1, dt * 6)
			fill.Size = UDim2.fromScale(math.max(shown, 0.04), 1)
			pctL.Text = math.floor(shown * 100 + 0.5) .. "%"
		end
	end)
	f.Destroying:Connect(function()
		smoothConn:Disconnect()
		animConn:Disconnect()
		breathe:Cancel()
	end)
	local api = { Root = f }
	function api.Set(p, text)
		p = math.clamp(p, 0, 1)
		if p > target then
			target = p
		end
		if text then
			status.Text = text
		end
	end
	function api.Close()
		task.delay(4, function()
			if f.Parent then
				f:Destroy()
			end
		end)
		api.Set(1, "พร้อมแล้ว!")
		local tw = os.clock()
		while shown < 0.995 and os.clock() - tw < 1.2 do
			task.wait()
		end
		task.wait(0.25)
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("TextLabel") then
				UIKit.Tween(d, 0.9, { TextTransparency = 1 })
			elseif d:IsA("ImageLabel") then
				UIKit.Tween(d, 0.9, { ImageTransparency = 1 })
			elseif d:IsA("Frame") then
				UIKit.Tween(d, 0.9, { BackgroundTransparency = 1 })
			elseif d:IsA("UIStroke") then
				UIKit.Tween(d, 0.9, { Transparency = 1 })
			end
		end
		UIKit.Tween(f, 1, { BackgroundTransparency = 1 })
		task.wait(1.05)
		f:Destroy()
	end
	api.Set(0)
	canvas.ImageTransparency = 1
	UIKit.Tween(canvas, 0.5, { ImageTransparency = 0 })
	return api
end

-- ใช้ภาพวาดเป็นหลัก · วาดรูปไม่ได้ (EditableImage ใช้ไม่ได้ในเครื่องนั้น) -> หน้าโหลดฉาก 3 มิติแบบเดิม
local function loadingScreen(title, subtitle)
	local ok, img = pcall(function()
		return require(ReplicatedStorage.Shared.LoadingArt).Image()
	end)
	if ok and img then
		local ok2, api = pcall(artLoadingScreen, img)
		if ok2 and api then
			return api
		end
		warn("[AS] art loading screen failed", api)
	end
	return sceneLoadingScreen(title, subtitle)
end

-- พื้นใต้เท้าโหลดมาถึงเครื่องแล้วหรือยัง
local function groundReady()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { char }
	return Workspace:Raycast(root.Position, Vector3.new(0, -60, 0), rp) ~= nil
end

-- เข้าเกม: โหลดให้ครบก่อนค่อยเปิดจอ (ไม่เข้าไปเจอของค้าง/พื้นยังไม่มา/แมพยังสร้างไม่เสร็จ)
--   ค่าย 0-25% -> พื้นผิว/โมเดลค่าย 25-50% -> เซิร์ฟเวอร์สร้างแมพ 50-85% -> โมเดลในแมพ/บอส/เอฟเฟกต์ 85-97% -> ตัวละคร+พื้นใต้เท้า 97-100%
--   ทุกช่วงมีเวลากันค้างยาวๆ (เน็ตช้ามากก็ยังเข้าได้ในที่สุด) · หลอดเดินหน้าอย่างเดียว ไม่ถอยหลัง
function Cinematics.Loading(state)
	local ui = loadingScreen(Config.GameName, Config.Subtitle)
	Cinematics.IsLoading = true
	task.spawn(function()
		local CP = game:GetService("ContentProvider")
		local function collect(root)
			local items = {}
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA("MeshPart") or d:IsA("SurfaceAppearance") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("ParticleEmitter")
					or d:IsA("Beam") or d:IsA("SpecialMesh") or d:IsA("Sound") or d:IsA("ImageLabel") or d:IsA("ImageButton") then
					table.insert(items, d)
				end
			end
			return items
		end
		-- โหลดทรัพยากรเป็นชุด (เดินหลอดจาก a ถึง b) · เกินเวลาที่กำหนด = ไปต่อ
		local function preload(items, a, b, label, limit)
			local total = math.max(#items, 1)
			local p0 = os.clock()
			for i = 1, #items, 40 do
				if os.clock() - p0 > limit then
					break
				end
				pcall(function()
					CP:PreloadAsync(table.move(items, i, math.min(i + 39, #items), 1, {}))
				end)
				local done = math.min(i + 39, #items)
				ui.Set(a + (b - a) * done / total, string.format("%s %d/%d", label, done, total))
			end
			ui.Set(b)
		end
		-- 1) ค่ายทั้งชุดมาถึงเครื่อง 0-25%
		local w0 = os.clock()
		local lobby
		while os.clock() - w0 < 90 do
			lobby = Workspace:FindFirstChild("Lobby")
			local want = lobby and lobby:GetAttribute("Parts")
			local have = lobby and #lobby:GetDescendants() or 0
			if want and have >= want * 0.98 then
				break
			end
			local k = want and math.clamp(have / want, 0, 1) or 0
			ui.Set(0.25 * k, string.format("กำลังโหลดค่าย... %d%%", math.floor(k * 100)))
			task.wait(0.1)
		end
		-- 2) พื้นผิว/โมเดลของค่าย 25-50%
		preload(lobby and collect(lobby) or {}, 0.25, 0.5, "กำลังโหลดค่าย", 60)
		-- 3) รอเซิร์ฟเวอร์สร้างแมพเสร็จ 50-85%
		local g0 = os.clock()
		while os.clock() - g0 < 240 do
			local lp = state and state:GetAttribute("LoadProgress") or 1
			if lp >= 1 then
				break
			end
			ui.Set(0.5 + 0.35 * lp, string.format("กำลังสร้างโลก... %d%%", math.floor(lp * 100)))
			task.wait(0.2)
		end
		ui.Set(0.85, "สร้างโลกเสร็จแล้ว")
		-- 4) โมเดลในแมพ/สัตว์/บอส/อาวุธ/เอฟเฟกต์ 85-97%
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		preload(assets and collect(assets) or {}, 0.85, 0.97, "กำลังโหลดโมเดล", 90)
		-- 5) ตัวละคร + พื้นใต้เท้า 97-100%
		ui.Set(0.97, "กำลังจุดกองไฟในค่าย...")
		local t0 = os.clock()
		while not (player.Character and groundReady()) and os.clock() - t0 < 60 do
			task.wait(0.1)
		end
		task.wait(0.4) -- ให้เฟรมแรกในค่ายวาดเสร็จก่อนค่อยเปิดจอ
		ui.Close()
		Cinematics.IsLoading = false
		if Cinematics.OnLoaded then
			Cinematics.OnLoaded()
		end
	end)
end

-- เดินทางลงแมพ (ออกจากล็อบบี้): รอพื้นแมพรอบตัวโหลดเสร็จก่อนค่อยเปิดจอ
function Cinematics.Travel()
	if Cinematics.Traveling then
		return
	end
	Cinematics.Traveling = true
	local ui = loadingScreen("ออกเดินทาง", "สู่ดินแดนสี่ธาตุ")
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 25 do
			local k = math.clamp((os.clock() - t0) / 2.5, 0, 1)
			if player:GetAttribute("InRun") and groundReady() and k >= 1 then
				break
			end
			ui.Set(math.min(0.95, k * 0.7 + (groundReady() and 0.25 or 0)), groundReady() and "กำลังเข้าสู่แคมป์..." or "กำลังโหลดพื้นที่รอบแคมป์...")
			task.wait(0.1)
		end
		ui.Close()
		Cinematics.Traveling = false
	end)
end

---------------------------------------------------------------- เปิดตัวบอส
-- ฉากเปิดตัวบอส (แต่ละธาตุไม่เหมือนกัน) — เซิร์ฟเวอร์ตรึงบอสไว้ ~7 วิ เครื่องเราขยับตัวบอสเอง แล้วคืนที่เดิมตอนจบ
--   ดิน: แผ่นดินสั่น แตก -> โผล่พุ่งขึ้นจากดิน -> กระแทกลงพื้น -> คำราม
--   น้ำ: น้ำวน -> พุ่งกระโดดขึ้นจากทะเล โค้งกลางอากาศ -> ตกน้ำสาดกระจาย -> คำราม
--   น้ำแข็ง: ถูกแช่ในก้อนน้ำแข็ง -> ร้าว สั่น -> น้ำแข็งแตกกระจาย -> คำราม
--   ไฟ: ดิ่งลงมาจากฟ้า -> บินวนกระพือปีกครู่หนึ่ง -> ลงพื้นไฟระเบิด -> คำราม
local function ease(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end
local function easeOut(x)
	x = math.clamp(x, 0, 1)
	return 1 - (1 - x) * (1 - x)
end
local function easeIn(x)
	x = math.clamp(x, 0, 1)
	return x * x
end

local function bossNameCard(d, color)
	local f = UIKit.Frame(gui, { Size = UDim2.new(1, 0, 0, 200), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.6, 0), BackgroundTransparency = 1, ZIndex = 60 })
	UIKit.AutoScale(f)
	UIKit.Text(f, {
		Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, Font = UIKit.Fonts.Bold,
		Text = "— บอสประจำธาตุ —", TextColor3 = color, TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 61,
	})
	local name = UIKit.Text(f, {
		Size = UDim2.new(1, 0, 0, 78), Position = UDim2.fromOffset(0, 26), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title, TextSize = 64,
		Text = d.Name, TextColor3 = Color3.fromRGB(250, 242, 226), TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 61,
	})
	UIKit.TextStroke(name, 3, 0.1)
	local ng = Instance.new("UIGradient")
	ng.Color = ColorSequence.new(Color3.fromRGB(255, 252, 240), color:Lerp(Color3.new(1, 1, 1), 0.35))
	ng.Rotation = 90
	ng.Parent = name
	local line = UIKit.Frame(f, { Size = UDim2.new(0, 760, 0, 3), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 108), BackgroundColor3 = color, BackgroundTransparency = 1, ZIndex = 61 })
	line:SetAttribute("Line", true)
	local lg = Instance.new("UIGradient")
	lg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
	lg.Parent = line
	UIKit.Text(f, {
		Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 116), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 26,
		Text = d.Thai, TextColor3 = color, TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 61,
	})
	local sc = Instance.new("UIScale")
	sc.Scale = 1.35
	sc.Parent = f
	local api = {}
	function api.Show()
		fadeTexts(f, 0, 0.5)
		UIKit.Tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	function api.Hide()
		fadeTexts(f, 1, 1)
		task.delay(1.1, function()
			f:Destroy()
		end)
	end
	return api
end

-- ก้อนน้ำแข็งแช่บอส + แตกกระจาย
local function iceBlock(model)
	local BossFX = require(script.Parent:WaitForChild("BossFX"))
	local cf, size = model:GetBoundingBox()
	local block = BossFX.Part({ Name = "IntroIce", Size = size * Vector3.new(1.12, 1.06, 1.12), CFrame = cf, Material = Enum.Material.Glass, Color = Color3.fromRGB(170, 225, 255), Transparency = 0.35, Reflectance = 0.15 })
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(220, 245, 255)
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = block
	local api = { Part = block }
	-- รอยร้าว: เศษน้ำแข็งเล็กๆ ปลิว + ก้อนสั่น
	function api.Crack(k)
		BossFX.Emit(cf.Position + Vector3.new((math.random() - 0.5) * size.X, (math.random() - 0.3) * size.Y, (math.random() - 0.5) * size.Z), {
			Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(Color3.fromRGB(230, 248, 255)), LightEmission = 1,
			Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(8, 20), SpreadAngle = Vector2.new(180, 180),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
		}, math.floor(6 + 14 * k), 2)
		local j = 0.15 + 0.6 * k
		block.CFrame = cf * CFrame.new((math.random() - 0.5) * j, 0, (math.random() - 0.5) * j)
	end
	function api.Shatter()
		local rng = Random.new()
		for _ = 1, 26 do
			local s = Vector3.new(rng:NextNumber(0.12, 0.3) * size.X, rng:NextNumber(0.1, 0.28) * size.Y, rng:NextNumber(0.12, 0.3) * size.Z)
			local p = BossFX.Part({ Size = s, CFrame = cf * CFrame.new(rng:NextNumber(-0.45, 0.45) * size.X, rng:NextNumber(-0.45, 0.45) * size.Y, rng:NextNumber(-0.45, 0.45) * size.Z)
				* CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Material = Enum.Material.Glass, Color = Color3.fromRGB(190, 232, 255), Transparency = 0.25 })
			p.Anchored = false
			local out = (p.Position - cf.Position)
			out = Vector3.new(out.X, math.abs(out.Y) * 0.4 + size.Y * 0.2, out.Z).Unit
			p.AssemblyLinearVelocity = out * rng:NextNumber(40, 90)
			p.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-10, 10))
			task.delay(1.6, function()
				if p.Parent then
					BossFX.TweenObj(p, 0.8, { Transparency = 1, Size = p.Size * 0.3 })
				end
			end)
			game:GetService("Debris"):AddItem(p, 2.6)
		end
		block:Destroy()
	end
	return api
end

function Cinematics.BossIntro(d)
	local model = d.Model
	local cam = Workspace.CurrentCamera
	if not (model and model.Parent) then
		model = nil
	end
	local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
	local color = C.Element[d.Element] or C.Gold
	letterbox(true)
	local card = bossNameCard(d, color)
	if not root then
		card.Show()
		task.delay(4, function()
			letterbox(false)
			card.Hide()
		end)
		return
	end
	local BossFX = require(script.Parent:WaitForChild("BossFX"))
	local okA, BossAnimator = pcall(require, script.Parent:FindFirstChild("BossAnimator"))
	local el = d.Element
	local rest = model:GetPivot() -- ตำแหน่งจริงที่เซิร์ฟเวอร์ตรึงไว้
	local size = model:GetExtentsSize()
	local H = math.max(size.Y, 8)
	local Rr = math.max(size.Magnitude * 0.55, 18)
	local fwd = rest.LookVector * Vector3.new(1, 0, 1)
	fwd = fwd.Magnitude > 0.01 and fwd.Unit or Vector3.new(0, 0, -1)
	local feet = rest.Position - Vector3.new(0, H * 0.45, 0)
	local function shake(p, t)
		if BossFX.Shake then
			BossFX.Shake(p, t)
		end
	end
	local function pose(off)
		if model.Parent then
			model:PivotTo(rest * off)
		end
	end
	-- ตาราง: จบฉาก (วิ) / จังหวะคำราม (วิ) / ฟังก์ชันท่าทางตามเวลา / เหตุการณ์ (เอฟเฟกต์) ตามเวลา
	local DUR, ROAR = 5.6, 3.1
	local shapeFn, events
	local ice
	local savedFly, savedGround
	if el == "Earth" then
		-- ใต้ดิน -> แผ่นดินแตก -> พุ่งขึ้น -> ลงกระแทก
		DUR, ROAR = 5.8, 3.2
		shapeFn = function(t)
			if t < 1.6 then
				return CFrame.new(0, -H * 1.05 + math.sin(t * 30) * 0.15, 0)
			elseif t < 2.25 then
				local k = easeOut((t - 1.6) / 0.65)
				return CFrame.new(0, -H * 1.05 + (H * 1.6) * k, 0) * CFrame.Angles(-0.25 * (1 - k), 0, 0)
			elseif t < 2.75 then
				local k = easeIn((t - 2.25) / 0.5)
				return CFrame.new(0, H * 0.55 * (1 - k), 0)
			end
			return CFrame.new()
		end
		events = {
			{ 0.1, function()
				BossFX.Play("Crack", CFrame.new(feet), { Scale = math.clamp(H / 4, 2, 12), Duration = 1.4, Tint = Color3.fromRGB(255, 190, 110) })
			end },
			{ 0.3, function() shake(0.5, 1.4) BossFX.Dust(feet, H * 0.8, el, 20) end },
			{ 0.9, function() BossFX.Dust(feet, H, el, 26) BossFX.Debris(feet, H * 0.6, el, 6) end },
			{ 1.6, function() BossFX.IntroBurst(feet, math.clamp(H * 0.9, 16, 44), el) BossFX.Play("RockRing", CFrame.new(feet), { Scale = math.clamp(H / 5, 2, 10), Duration = 0.5 }) end },
			{ 2.75, function() BossFX.IntroBurst(feet, math.clamp(H, 18, 48), el) shake(1.6, 0.8) end },
		}
	elseif el == "Water" then
		-- ใต้น้ำ -> พุ่งกระโดดโค้งขึ้นจากทะเลเข้าหาผู้เล่น -> ตกน้ำสาด
		DUR, ROAR = 5.4, 3.0
		shapeFn = function(t)
			if t < 0.8 then
				return CFrame.new(0, -H * 1.6, Rr * 0.9)
			elseif t < 2.3 then
				local k = (t - 0.8) / 1.5
				local y = -H * 1.6 + H * 1.6 * k + H * 2.4 * math.sin(math.pi * k)
				local z = Rr * 0.9 * (1 - ease(k))
				local pitch = 0.9 * math.cos(math.pi * k)
				return CFrame.new(0, y, z) * CFrame.Angles(pitch, 0, math.sin(math.pi * k) * 0.2)
			end
			return CFrame.new()
		end
		local surf = rest.Position
		events = {
			{ 0.05, function() BossFX.Play("WaterSwirl", CFrame.new(surf + fwd * -Rr * 0.9), { Scale = math.clamp(H / 3, 3, 12), Duration = 1.2 }) end },
			{ 0.8, function() BossFX.IntroBurst(surf + rest.LookVector * -Rr * 0.9, math.clamp(H, 16, 44), el) shake(0.7, 0.6) end },
			{ 2.3, function() BossFX.IntroBurst(surf, math.clamp(H * 1.1, 18, 50), el) shake(1.4, 0.8) end },
		}
	elseif el == "Air" then
		-- แช่น้ำแข็ง -> ร้าวสั่น -> แตกกระจาย
		DUR, ROAR = 5.2, 2.6
		ice = iceBlock(model)
		shapeFn = function()
			return CFrame.new()
		end
		events = {
			{ 0.6, function() ice.Crack(0.2) shake(0.2, 0.3) end },
			{ 1.0, function() ice.Crack(0.4) shake(0.3, 0.3) end },
			{ 1.35, function() ice.Crack(0.6) shake(0.4, 0.3) end },
			{ 1.65, function() ice.Crack(0.8) shake(0.6, 0.3) end },
			{ 1.9, function() ice.Crack(1) shake(0.8, 0.3) end },
			{ 2.15, function()
				ice.Shatter()
				BossFX.IntroBurst(feet, math.clamp(H, 18, 48), el)
				BossFX.Play("Ice", CFrame.new(feet), { Scale = math.clamp(H / 4, 2, 10), Duration = 0.6 })
				shake(1.5, 0.8)
			end },
		}
	else
		-- ไฟ: ดิ่งจากฟ้า -> บินวนกระพือปีก -> ลงพื้น
		DUR, ROAR = 6.4, 4.2
		savedFly, savedGround = model:GetAttribute("Flying"), model:GetAttribute("Grounded")
		model:SetAttribute("Flying", true)
		model:SetAttribute("Grounded", false)
		local high = CFrame.new(0, H * 7, Rr * 3.2)
		local hover = CFrame.new(0, H * 1.4, 0)
		shapeFn = function(t)
			if t < 1.9 then
				local k = easeOut(t / 1.9)
				local p = high.Position:Lerp(hover.Position, k) + Vector3.new(math.sin(k * math.pi) * Rr * 0.8, 0, 0)
				return CFrame.new(p) * CFrame.Angles(-0.55 * (1 - k), 0, -0.35 * math.sin(k * math.pi))
			elseif t < 3.3 then
				local k = t - 1.9
				return hover * CFrame.new(math.sin(k * 2.2) * 2, math.sin(k * 3.6) * H * 0.06, 0) * CFrame.Angles(0, math.sin(k * 1.4) * 0.15, 0)
			elseif t < 3.9 then
				local k = ease((t - 3.3) / 0.6)
				return hover:Lerp(CFrame.new(), k)
			end
			return CFrame.new()
		end
		events = {
			{ 0.0, function() BossFX.Play("FireBall", CFrame.new(rest.Position + Vector3.new(0, H * 7, 0) + rest.LookVector * -Rr * 3.2), { Scale = math.clamp(H / 5, 2, 8), Duration = 0.8 }) end },
			{ 1.9, function() BossFX.Play("Fire2", CFrame.new(rest.Position + Vector3.new(0, H * 1.4, 0)), { Scale = math.clamp(H / 4, 2, 10), Duration = 1.0 }) shake(0.5, 0.5) end },
			{ 3.0, function() BossFX.Dust(feet, H * 1.2, el, 30) end },
			{ 3.85, function()
				model:SetAttribute("Grounded", true)
				BossFX.IntroBurst(feet, math.clamp(H * 1.1, 18, 50), el)
				shake(1.6, 0.8)
			end },
		}
	end
	pose(shapeFn(0))
	-- คำราม: ท่าคำราม/ทุบ + คลื่นลม + จอสั่น + ป้ายชื่อขึ้น
	local wind = 0.55
	table.insert(events, { ROAR, function()
		if okA and BossAnimator then
			pcall(BossAnimator.PlayIntro, model, wind)
		end
	end })
	table.insert(events, { ROAR + wind, function()
		BossFX.Play("BlastWind", CFrame.new(rest.Position), { Scale = math.clamp(H / 14, 1, 4), Duration = 0.5 })
		shake(1.2, 1.0)
		card.Show()
	end })
	table.sort(events, function(a, b)
		return a[1] < b[1]
	end)
	-- กล้อง: ตามตัวบอสตลอด จากด้านหน้ามุมต่ำ ค่อยๆ วนข้าง · ช่วงคำรามดันเข้าใกล้หน้า
	local prevType, prevFov = cam.CameraType, cam.FieldOfView
	cam.CameraType = Enum.CameraType.Scriptable
	local baseAng = math.atan2(fwd.Z, fwd.X)
	local camPos, camLook
	local t0 = os.clock()
	local nextEv = 1
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		if t > DUR or not model.Parent then
			conn:Disconnect()
			if model.Parent then
				model:PivotTo(rest)
				if savedFly ~= nil or el == "Fire" then
					model:SetAttribute("Flying", savedFly)
					model:SetAttribute("Grounded", savedGround)
				end
			end
			if ice and ice.Part.Parent then
				ice.Part:Destroy()
			end
			cam.CameraType = prevType
			cam.FieldOfView = prevFov
			return
		end
		while events[nextEv] and t >= events[nextEv][1] do
			pcall(events[nextEv][2])
			nextEv += 1
		end
		pose(shapeFn(t))
		local body = model:GetPivot().Position
		local roarK = ease((t - ROAR) / 0.8)
		local orbit = baseAng + math.rad(25) * ease(t / DUR) - math.rad(12)
		local dist = Rr * (1.75 - 0.45 * roarK)
		local want = rest.Position + Vector3.new(math.cos(orbit) * dist, H * (0.12 + 0.18 * (1 - roarK)), math.sin(orbit) * dist)
		local look = body + Vector3.new(0, H * 0.25, 0)
		camPos = camPos and camPos:Lerp(want, 1 - math.exp(-dt * 5)) or want
		camLook = camLook and camLook:Lerp(look, 1 - math.exp(-dt * 7)) or look
		cam.FieldOfView = 58 - 10 * roarK
		cam.CFrame = CFrame.lookAt(camPos, camLook)
	end)
	task.delay(DUR + 0.2, function()
		letterbox(false)
		card.Hide()
	end)
end

---------------------------------------------------------------- จอดำตาย
local deathFrame
local function clearDeath(time)
	if not deathFrame then
		return
	end
	local df = deathFrame
	deathFrame = nil
	for _, d in ipairs(df:GetDescendants()) do
		if d:IsA("TextLabel") then
			UIKit.Tween(d, time, { TextTransparency = 1 })
		elseif d:IsA("Frame") then
			UIKit.Tween(d, time, { BackgroundTransparency = 1 })
		end
	end
	task.delay(time + 0.1, function()
		df:Destroy()
	end)
end

-- ตายในรอบ: ไม่เกิดใหม่ -> จอ YOU PERISHED สั้นๆ แล้วไปโหมดดูเพื่อน (DeathClient)
function Cinematics.Died(d)
	if deathFrame then
		deathFrame:Destroy()
	end
	deathFrame = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 70 })
	local band = UIKit.Frame(deathFrame, { Size = UDim2.new(1, 0, 0, 170), Position = UDim2.new(0, 0, 0.5, -85), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 71 })
	UIKit.Gradient(band, Color3.new(0, 0, 0), Color3.new(0, 0, 0), 90).Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.2), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1),
	})
	local inner = UIKit.Frame(band, { Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 71 })
	UIKit.AutoScale(inner)
	local t = UIKit.Text(inner, {
		Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromOffset(0, 20), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title,
		TextSize = 96, Text = "YOU PERISHED", TextColor3 = Color3.fromRGB(150, 16, 20), TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 72,
	})
	local alive = d and d.Alive or 0
	local s = UIKit.Text(inner, {
		Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 124), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20,
		Text = alive > 0 and string.format("สิ้นชีพ... ไม่มีการเกิดใหม่ในรอบนี้ · เพื่อนยังรอดอยู่ %d คน", alive) or "สิ้นชีพ... ไม่มีการเกิดใหม่ในรอบนี้",
		TextColor3 = Color3.fromRGB(200, 170, 160), TextTransparency = 1, ZIndex = 72,
	})
	UIKit.Tween(band, 1.5, { BackgroundTransparency = 0 })
	UIKit.Tween(t, 2.2, { TextTransparency = 0, TextSize = 104 })
	task.delay(1.4, function()
		UIKit.Tween(s, 1, { TextTransparency = 0 })
	end)
	task.delay(3.4, function()
		if alive > 0 then
			clearDeath(0.8)
		end
		if Cinematics.Death then
			Cinematics.Death.StartSpectate(d)
		end
	end)
	player.CharacterAdded:Once(function()
		clearDeath(0.8)
	end)
end

---------------------------------------------------------------- จบเกม
function Cinematics.FullScreen(title, lines, color, time)
	local f = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 90 })
	UIKit.Tween(f, 2, { BackgroundTransparency = 0.15 })
	-- เนื้อหาอยู่ในกล่องกลางจอ (ย่อทั้งกล่องบนมือถือ)
	local box = UIKit.Frame(f, { Size = UDim2.new(1, 0, 0, 120 + #lines * 34), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), BackgroundTransparency = 1, ZIndex = 90 })
	UIKit.AutoScale(box)
	local t = UIKit.Text(box, {
		Size = UDim2.new(1, 0, 0, 100), Position = UDim2.new(0, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title,
		TextSize = 80, Text = title, TextColor3 = color, TextTransparency = 1, ZIndex = 91,
	})
	UIKit.Tween(t, 2.5, { TextTransparency = 0 })
	for i, line in ipairs(lines) do
		local l = UIKit.Text(box, {
			Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 76 + i * 34), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22,
			Text = line, TextColor3 = C.Text, TextTransparency = 1, ZIndex = 91,
		})
		task.delay(1.5 + i * 0.8, function()
			UIKit.Tween(l, 1, { TextTransparency = 0 })
		end)
	end
	task.delay(time or 12, function()
		UIKit.Tween(f, 1.5, { BackgroundTransparency = 1 })
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("TextLabel") then
				UIKit.Tween(d, 1.2, { TextTransparency = 1 })
			end
		end
		task.wait(1.6)
		f:Destroy()
	end)
end

---------------------------------------------------------------- ตัวจัดการ
local ELEMENT_NIGHT_TEXT = {
	Earth = "ป่าทั้งผืนตื่นขึ้น... ฝูงสัตว์แห่งปฐพีกำลังมา",
	Water = "เสียงคลื่นคำราม... สัตว์แห่งวารีขึ้นจากน้ำ",
	Air = "ลมหวีดหวิว... ผู้ล่าแห่งท้องฟ้าโฉบลงมา",
	Fire = "ภูเขาไฟปะทุ... อสูรเพลิงลุกลาม",
	All = "ทุกธาตุโกรธเกรี้ยว...",
}

-- กวางกลวงกำลังจะออกล่า (เตือนก่อน ~5 วินาที): ขอบจอแดงกะพริบ + ป้ายเตือน (เสียงเล่นจาก SoundController)
function Cinematics.StalkerWarning(d, combat)
	local holder = UIKit.Frame(gui, { Name = "StalkerVignette", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local red = Color3.fromRGB(190, 0, 14)
	local specs = {
		{ UDim2.new(1, 0, 0.24, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.24, 0), UDim2.fromScale(0, 0.76), -90 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0.84, 0), 180 },
	}
	local edges = {}
	for _, sp in ipairs(specs) do
		local e = UIKit.Frame(holder, { Size = sp[1], Position = sp[2], BackgroundColor3 = red, BackgroundTransparency = 1 })
		local g = Instance.new("UIGradient")
		g.Rotation = sp[3]
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 0.7), NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = e
		table.insert(edges, e)
	end
	Cinematics.Banner("มีบางอย่างกำลังเข้ามา...", "อยู่ใกล้แสงไฟ! 🔥", Color3.fromRGB(255, 70, 60), 3.5, { Size = 50, Y = 0.2 })
	if combat and combat.Shake then
		combat.Shake(0.12, 0.5)
	end
	task.spawn(function()
		local pulses = math.clamp(math.floor((tonumber(d.In) or 5) / 1.05 + 0.5), 2, 6)
		for _ = 1, pulses do
			for _, e in ipairs(edges) do
				UIKit.Tween(e, 0.35, { BackgroundTransparency = 0.08 })
			end
			task.wait(0.4)
			for _, e in ipairs(edges) do
				UIKit.Tween(e, 0.6, { BackgroundTransparency = 0.7 })
			end
			task.wait(0.65)
		end
		for _, e in ipairs(edges) do
			UIKit.Tween(e, 0.8, { BackgroundTransparency = 1 })
		end
		task.wait(0.9)
		holder:Destroy()
	end)
end

function Cinematics.Handle(kind, d, menus, combat)
	if kind == "NightStart" then
		local color = d.BloodMoon and Color3.fromRGB(220, 40, 40) or (C.Element[d.Element] or C.Gold)
		local title = d.BloodMoon and "BLOOD MOON" or ("NIGHT " .. d.Night)
		local sub = (d.BloodMoon and ("คืนที่ " .. d.Night .. " · ") or "") .. (d.Title or "") .. " — " .. (ELEMENT_NIGHT_TEXT[d.Element] or "")
		if type(d.Elements) == "table" and #d.Elements > 0 then
			-- พระจันทร์เลือดครั้งแรก: บอกว่าธาตุไหนบุกบ้าง
			local names = {}
			for _, e in ipairs(d.Elements) do
				table.insert(names, (UIKit.ElementIcon[e] or "") .. (UIKit.ElementThai[e] or tostring(e)))
			end
			sub = "คืนที่ " .. d.Night .. " · " .. (d.Title or "") .. " — " .. table.concat(names, " + ") .. " บุกพร้อมกัน!"
		end
		if d.Boss then
			sub = "คืนที่ " .. d.Night .. " · " .. (d.Title or "") .. " — บอสธาตุกำลังมาถึง!"
		end
		letterbox(true)
		Cinematics.Banner(title, sub, color, 4)
		task.delay(4.5, function()
			letterbox(false)
		end)
		combat.Shake(0.3, 1)
	elseif kind == "DayStart" then
		if d.Day > 1 then
			Cinematics.Banner("DAY " .. d.Day, "สำรวจ เก็บของ และเตรียมรับมือก่อนค่ำ", C.Gold, 2.5, { Size = 54, Y = 0.22 })
		else
			Cinematics.Banner("DAY 1", "จุดไฟไว้ให้ลุกโชน... ป่านี้ไม่เคยหลับใหล", C.Gold, 4, { Size = 60, Y = 0.22 })
		end
	elseif kind == "Dusk" then
		Cinematics.Banner("DUSK", "พระอาทิตย์กำลังตก — กลับไปที่กองไฟ!", C.Fire, 2.5, { Size = 50, Y = 0.22 })
	elseif kind == "Dawn" then
		Cinematics.Banner("DAWN", string.format("รอดชีวิตผ่านคืนที่ %d แล้ว", d.Night), Color3.fromRGB(255, 220, 160), 3, { Size = 60 })
	elseif kind == "WaveIncoming" then
		combat.Shake(0.15, 0.6)
	elseif kind == "BossIntro" then
		task.spawn(function()
			local t0 = os.clock()
			while not (d.Model and d.Model.Parent and (d.Model:FindFirstChild("HumanoidRootPart") or d.Model.PrimaryPart)) and os.clock() - t0 < 3 do
				local animals = Workspace:FindFirstChild("Animals")
				for _, m in ipairs(animals and animals:GetChildren() or {}) do
					if m:GetAttribute("AnimalId") == d.Id and m:GetAttribute("IsBoss") then
						d.Model = m
					end
				end
				task.wait(0.1)
			end
			Cinematics.BossIntro(d)
		end)
	elseif kind == "BossFelled" then
		Cinematics.Banner("BEAST VANQUISHED", "ปราบ " .. (d.Thai or "") .. " สำเร็จ! · ได้หัวใจอสูร", Color3.fromRGB(255, 214, 120), 4.5, { Size = 76 })
	elseif kind == "Died" then
		Cinematics.Died(d)
	elseif kind == "Downed" then
		combat.Shake(0.5, 0.4)
		Cinematics.Banner("DOWNED", "คุณล้มลง! รอเพื่อนใช้ผ้าพันแผลช่วย — ถ้าไม่เหลือใครยืนอยู่ = แพ้ทั้งทีม", Color3.fromRGB(255, 90, 80), 3, { Size = 64, Y = 0.2 })
	elseif kind == "Revived" then
		Cinematics.Banner("", "✨ ได้รับการช่วยชีวิต!", C.Good, 1.5, { Size = 10, Y = 0.5 })
	elseif kind == "GameOver" then
		clearDeath(0.3)
		if Cinematics.Death then
			Cinematics.Death.StopSpectate()
		end
		local lines = {
			string.format("ทีมล้มลงทั้งหมดในคืนที่ %d", d.Night or 1),
			string.format("รอดได้ %d คืน · สถิติสูงสุดของคุณ %d คืน", d.Survived or 0, d.Best or 0),
			"กองไฟมอดดับลง... ป่ากลืนกินทุกสิ่ง",
			"กำลังพากลับสู่ล็อบบี้...",
		}
		Cinematics.FullScreen("ALL HAVE PERISHED", lines, Color3.fromRGB(170, 20, 24), 11)
	elseif kind == "Ending" then
		local tail = d.Continue and "♾ เกมยังไม่จบ! เล่นต่อได้ไม่จำกัด — รอดให้นานที่สุดเพื่อขึ้นกระดานอันดับ" or ""
		if d.Kind == "True" then
			Cinematics.FullScreen("THE FOUR SPIRITS REUNITE", {
				"ลูกสัตว์ทั้ง 4 ธาตุกลับมาพร้อมหน้า", "คุณพิชิต 99 คืน — จบแบบสมบูรณ์", "♦️ +300 Ruby", tail,
			}, Color3.fromRGB(255, 226, 150), 12)
		else
			Cinematics.FullScreen("99 NIGHTS CONQUERED", {
				"คุณพิชิต 99 คืนแห่งผืนป่า!", string.format("ลูกสัตว์ธาตุกลับมา %d/4 ตัว — ช่วยครบเพื่อฉากจบที่แท้จริง", d.Spirits or 0),
				"♦️ +100 Ruby", tail,
			}, C.Gold, 12)
		end
	elseif kind == "Purchased" then
		if d.Kind == "Pack" then
			Cinematics.Banner("♦️ +" .. tostring(d.Diamonds or 0), "เติม " .. (d.Name or "Ruby") .. " สำเร็จ — ขอบคุณที่สนับสนุน!", Color3.fromRGB(120, 230, 255), 3, { Size = 72, Y = 0.3 })
		else
			Cinematics.Banner("🎫 " .. (d.Name or "GAME PASS"), "ปลดล็อกแล้ว! ขอบคุณที่สนับสนุน", C.Gold, 3, { Size = 64, Y = 0.3 })
		end
	elseif kind == "SpiritFreed" then
		Cinematics.Banner("SPIRIT UNSEALED", (d.Player or "") .. " ปลดปล่อย " .. (d.Name or "") .. " — พากลับกองไฟ!", C.Element[d.Element] or C.Gold, 3.5, { Size = 56 })
	elseif kind == "SpiritRescued" then
		Cinematics.Banner("SPIRIT RETURNED", string.format("%s กลับบ้านแล้ว (%d/4) · บัฟ: %s", d.Name or "", d.Count or 0, d.Buff or ""), C.Element[d.Element] or C.Gold, 4.5, { Size = 60 })
	elseif kind == "CampUpgrade" then
		Cinematics.Banner("BONFIRE LV." .. d.Level, "เขตปลอดภัยขยาย · หมอกจางลง · ทางใหม่เปิดออก", C.Fire, 3, { Size = 54, Y = 0.22 })
	elseif kind == "FireOut" then
		Cinematics.Banner("THE FIRE IS OUT", "กองไฟดับ! เติมไม้ด่วน", Color3.fromRGB(255, 80, 60), 3, { Size = 56 })
		combat.Shake(0.3, 0.5)
	elseif kind == "OpenCraft" then
		menus.OpenCraft()
	elseif kind == "OpenShop" then
		menus.OpenShop("Diamonds")
	elseif kind == "OpenClasses" then
		menus.OpenShop("Classes")
	elseif kind == "OpenTrader" then
		menus.OpenTrader()
	elseif kind == "Teleporting" then
		if d.Back then
			Cinematics.Banner("RETURNING", "กำลังพากลับสู่ค่าย WILDHEART...", C.Gold, 8, { Size = 60, Y = 0.62 })
		else
			Cinematics.Banner("DEPARTING", "กำลังพาทีมไปยังผืนป่าของพวกคุณ...", C.Gold, 6, { Size = 60 })
		end
	elseif kind == "Depart" then
		letterbox(true)
		Cinematics.Banner("INTO THE WILDS", "ลงสู่ผืนป่า... จุดไฟให้ลุกโชน แล้วเอาชีวิตรอดให้ได้ 99 คืน", C.Gold, 3.5, { Size = 64 })
		task.delay(4, function()
			letterbox(false)
		end)
	elseif kind == "Shake" then
		combat.Shake(d.Power or 0.5, d.Time or 0.5)
	elseif kind == "Flash" then
		-- วาร์ปผ่านประตูมิติ: จอขาวแวบแล้วจางออก
		local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then
			local g = Instance.new("ScreenGui")
			g.IgnoreGuiInset = true
			g.DisplayOrder = 90
			g.ResetOnSpawn = false
			local f = Instance.new("Frame")
			f.Size = UDim2.fromScale(1, 1)
			f.BorderSizePixel = 0
			f.BackgroundColor3 = d.Color or Color3.new(1, 1, 1)
			f.BackgroundTransparency = 0
			f.Parent = g
			g.Parent = pg
			TweenService:Create(f, TweenInfo.new(d.Time or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
			game:GetService("Debris"):AddItem(g, (d.Time or 0.6) + 0.2)
		end
	elseif kind == "Warp" then
		Cinematics.Warp(d)
	elseif kind == "StalkerWarning" then
		Cinematics.StalkerWarning(d, combat)
	end
end

---------------------------------------------------------------- วาร์ปผ่านประตูมิติ
-- In : ถูกดูดเข้าม่าน — มุมกล้องยืด, เส้นแสงพุ่งเข้ากลางจอ, จอค่อยๆ เป็นสีธาตุ, วงวน VFX ที่ตัว, เสียงลมหวีด
-- Out: โผล่ปลายทาง — สีจางออก, มุมกล้องเด้งกลับ, วงแสงระเบิดรอบตัว
local warpGui
function Cinematics.Warp(d)
	local col = d.Color or Color3.fromRGB(200, 230, 255)
	local cam = Workspace.CurrentCamera
	local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local okV, VFXLib = pcall(require, script.Parent:WaitForChild("VFXLib"))
	local function burst()
		if okV and root then
			pcall(VFXLib.Play, "VFXPack/Anime/Portal-Enter-01", CFrame.new(root.Position) * CFrame.Angles(0, 0, 0), { Scale = 1.4, Duration = 0.8, Tint = col })
		end
	end
	if d.Phase == "In" then
		if warpGui then
			warpGui:Destroy()
		end
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://9113077334"
		s.Volume = 0.7
		s.Parent = SoundService
		s:Play()
		game:GetService("Debris"):AddItem(s, 4)
		burst()
		Cinematics.WarpFov = Cinematics.WarpFov or cam.FieldOfView
		TweenService:Create(cam, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { FieldOfView = 115 }):Play()
		if not pg then
			return
		end
		local g = Instance.new("ScreenGui")
		g.Name = "ASWarp"
		g.IgnoreGuiInset = true
		g.DisplayOrder = 90
		g.ResetOnSpawn = false
		g.Parent = pg
		warpGui = g
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.fromScale(1, 1)
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = col:Lerp(Color3.new(1, 1, 1), 0.35)
		fill.BackgroundTransparency = 1
		fill.ZIndex = 2
		fill.Parent = g
		TweenService:Create(fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 0 }):Play()
		-- เส้นแสงพุ่งเข้าหากลางจอ (เหมือนถูกดูดเข้าอุโมงค์)
		for i = 1, 28 do
			local a = (i / 28) * 360 + math.random(-6, 6)
			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.Position = UDim2.fromScale(0.5, 0.5)
			line.Size = UDim2.fromOffset(math.random(80, 200), math.random(2, 5))
			line.Rotation = a
			line.BorderSizePixel = 0
			line.BackgroundColor3 = Color3.new(1, 1, 1):Lerp(col, 0.3)
			line.BackgroundTransparency = 0.2
			line.Parent = g
			local r = math.rad(a)
			local far = UDim2.new(0.5, math.cos(r) * 900, 0.5, math.sin(r) * 900)
			local near = UDim2.new(0.5, math.cos(r) * 60, 0.5, math.sin(r) * 60)
			line.Position = far
			TweenService:Create(line, TweenInfo.new(0.45 + math.random() * 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Position = near, BackgroundTransparency = 0.9, Size = UDim2.fromOffset(line.Size.X.Offset * 0.3, line.Size.Y.Offset) }):Play()
		end
		game:GetService("Debris"):AddItem(g, 3)
	else
		task.delay(0.08, burst)
		TweenService:Create(cam, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { FieldOfView = Cinematics.WarpFov or 70 }):Play()
		Cinematics.WarpFov = nil
		local g = warpGui
		warpGui = nil
		if g and g.Parent then
			for _, c in ipairs(g:GetChildren()) do
				if c:IsA("Frame") and c.Name ~= "Fill" then
					c:Destroy()
				end
			end
			local fill = g:FindFirstChild("Fill")
			if fill then
				fill.BackgroundTransparency = 0
				TweenService:Create(fill, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
			end
			game:GetService("Debris"):AddItem(g, 0.9)
		end
	end
end

function Cinematics.Init(state)
	gui = UIKit.Screen("Cinematics", 40, true)
	Cinematics.Gui = gui
	-- หน้าโหลดเสมอตอนเข้าเกม (ปิดเองเมื่อโหลดทุกอย่างครบ) · ลงแมพ = หน้าโหลดเดินทาง
	local testing = ReplicatedStorage:FindFirstChild("ASAutoTest") ~= nil -- เทสต์อัตโนมัติ: ไม่บังจอ
	if not testing then
		Cinematics.Loading(state)
	else
		task.defer(function()
			if Cinematics.OnLoaded then
				Cinematics.OnLoaded()
			end
		end)
	end
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		if player:GetAttribute("InRun") and not Cinematics.IsLoading and not testing then
			Cinematics.Travel()
		end
	end)
end

-- ใช้ทดสอบหน้าตาหน้าโหลด (tests/ASLobbyProbe)
Cinematics.PreviewLoading = function(title, subtitle)
	return loadingScreen(title, subtitle)
end

return Cinematics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000072"><Properties><string name="Name">ClassAvatars</string><ProtectedString name="Source"><![CDATA[--[[
	ClassAvatars — ตัวละครของแต่ละคลาส: โมเดล Import 3D (Assets.Characters) / ชุดแคตตาล็อก (ClassModels) / หุ่นบล็อกสำรอง
	ใช้ทั้งรูปโปรไฟล์วงกลมในร้านคลาส (ViewportFrame) และหุ่นโชว์บนเวทีในเต็นท์ Classes
	Build(classId) -> Model (เท้าอยู่ที่ y = 0, หันหน้า -Z)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClassAvatars = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Color3.fromRGB

local SKIN = C(206, 164, 126)

-- ชุดของแต่ละคลาส
local OUTFIT = {
	Survivor = { Shirt = C(64, 92, 140), Pants = C(52, 52, 62), Hat = "None", Extra = "Scarf", Accent = C(90, 150, 80) },
	Forager = { Shirt = C(112, 146, 72), Pants = C(96, 74, 52), Hat = "Straw", HatColor = C(222, 192, 112), Extra = "Basket", Accent = C(200, 60, 80) },
	Lumberjack = { Shirt = C(176, 42, 42), Pants = C(58, 70, 110), Hat = "Beanie", HatColor = C(40, 40, 44), Extra = "Beard", Accent = C(96, 62, 40), Plaid = true },
	Medic = { Shirt = C(236, 236, 240), Pants = C(196, 200, 212), Hat = "Cap", HatColor = C(240, 240, 244), Extra = "Cross", Accent = C(220, 40, 40) },
	Hunter = { Shirt = C(86, 108, 58), Pants = C(70, 60, 42), Hat = "Hood", HatColor = C(70, 92, 48), Extra = "Quiver", Accent = C(120, 84, 50) },
	Builder = { Shirt = C(242, 140, 40), Pants = C(58, 70, 110), Hat = "HardHat", HatColor = C(250, 210, 40), Extra = "Belt", Accent = C(90, 70, 40) },
	Scout = { Shirt = C(182, 162, 112), Pants = C(92, 82, 60), Hat = "Ranger", HatColor = C(120, 86, 52), Extra = "Bag", Accent = C(70, 110, 70) },
	Elementalist = { Shirt = C(86, 50, 140), Pants = C(70, 40, 116), Hat = "Wizard", HatColor = C(96, 56, 156), Extra = "Orbs", Accent = C(120, 230, 255) },
}

local function part(m, props)
	local p = Instance.new(props.ClassName or "Part")
	props.ClassName = nil
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = m
	return p
end

local function cylY(m, h, d, cf, color, mat)
	return part(m, { Shape = Enum.PartType.Cylinder, Size = V(h, d, d), CFrame = cf * ANG(0, 0, math.pi / 2), Color = color, Material = mat or Enum.Material.SmoothPlastic })
end

local function hat(m, kind, color, head)
	local top = head * CF(0, 0.62, 0)
	if kind == "Straw" then
		cylY(m, 0.15, 3.4, top * CF(0, -0.05, 0), color, Enum.Material.Fabric)
		cylY(m, 0.7, 1.7, top * CF(0, 0.3, 0), color, Enum.Material.Fabric)
		cylY(m, 0.2, 1.75, top * CF(0, 0.05, 0), C(170, 50, 60))
	elseif kind == "Beanie" then
		part(m, { Shape = Enum.PartType.Ball, Size = V(1.75, 1.3, 1.75), CFrame = top * CF(0, 0.05, 0), Color = color, Material = Enum.Material.Fabric })
		cylY(m, 0.35, 1.8, top * CF(0, -0.15, 0), color:Lerp(C(0, 0, 0), 0.2), Enum.Material.Fabric)
	elseif kind == "Cap" then
		cylY(m, 0.55, 1.65, top * CF(0, 0.05, 0), color)
		part(m, { Size = V(1.4, 0.12, 0.9), CFrame = top * CF(0, -0.15, -0.95), Color = color })
		part(m, { Size = V(0.5, 0.15, 0.06), CFrame = top * CF(0, 0.1, -0.84), Color = C(220, 40, 40) })
		part(m, { Size = V(0.15, 0.5, 0.06), CFrame = top * CF(0, 0.1, -0.84), Color = C(220, 40, 40) })
	elseif kind == "Hood" then
		part(m, { Size = V(1.9, 1.5, 1.6), CFrame = head * CF(0, 0.25, 0.25), Color = color, Material = Enum.Material.Fabric })
		part(m, { ClassName = "WedgePart", Size = V(1.9, 0.8, 0.9), CFrame = head * CF(0, 1.15, 0.45) * ANG(0, math.pi, 0), Color = color, Material = Enum.Material.Fabric })
		part(m, { Size = V(1.95, 0.3, 0.3), CFrame = head * CF(0, 0.85, -0.5), Color = color:Lerp(C(0, 0, 0), 0.25), Material = Enum.Material.Fabric })
	elseif kind == "HardHat" then
		part(m, { Shape = Enum.PartType.Ball, Size = V(1.8, 1.2, 1.8), CFrame = top * CF(0, 0.1, 0), Color = color })
		cylY(m, 0.12, 2.3, top * CF(0, -0.15, 0), color)
	elseif kind == "Ranger" then
		cylY(m, 0.12, 3, top * CF(0, -0.05, 0), color, Enum.Material.Fabric)
		cylY(m, 0.75, 1.6, top * CF(0, 0.35, 0), color, Enum.Material.Fabric)
		part(m, { Size = V(1.65, 0.2, 1.65), CFrame = top * CF(0, 0.1, 0), Color = C(60, 44, 30), Material = Enum.Material.Fabric })
	elseif kind == "Wizard" then
		cylY(m, 0.15, 3, top * CF(0, -0.05, 0), color, Enum.Material.Fabric)
		for i, d in ipairs({ 1.7, 1.35, 1.0, 0.68, 0.38 }) do
			cylY(m, 0.55, d, top * CF(0, 0.2 + i * 0.5, 0.06 * i * i) * ANG(-0.06 * i, 0, 0), color, Enum.Material.Fabric)
		end
		part(m, { Shape = Enum.PartType.Ball, Size = V(0.4, 0.4, 0.4), CFrame = top * CF(0, 3.05, 1.6), Color = C(120, 230, 255), Material = Enum.Material.Neon })
		cylY(m, 0.22, 1.75, top * CF(0, 0.12, 0), C(120, 230, 255), Enum.Material.Neon)
	elseif kind == "Wolf" then
		part(m, { Size = V(1.95, 1.4, 1.7), CFrame = head * CF(0, 0.35, 0.2), Color = color, Material = Enum.Material.Fabric })
		part(m, { Size = V(1.2, 0.6, 1.1), CFrame = head * CF(0, 0.95, -0.75) * ANG(-0.15, 0, 0), Color = color, Material = Enum.Material.Fabric })
		part(m, { Size = V(0.5, 0.25, 0.3), CFrame = head * CF(0, 0.85, -1.35), Color = C(30, 30, 34) })
		for _, x in ipairs({ -0.6, 0.6 }) do
			part(m, { ClassName = "WedgePart", Size = V(0.3, 0.6, 0.5), CFrame = head * CF(x, 1.35, 0.1), Color = color, Material = Enum.Material.Fabric })
		end
		part(m, { Size = V(2.2, 0.5, 1.4), CFrame = head * CF(0, -0.75, 0.2), Color = C(220, 220, 228), Material = Enum.Material.Fabric })
	end
end

-- เอฟเฟกต์ประจำคลาสบนเวที (จอมเวท: ประกายเวท 4 ธาตุวนรอบตัว)
function ClassAvatars.PlayIdle(model, classId)
	if classId ~= "Elementalist" or not model then
		return
	end
	local host = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not host then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = host
	for _, col in ipairs({ Color3.fromRGB(120, 230, 255), Color3.fromRGB(255, 140, 60), Color3.fromRGB(140, 240, 110), Color3.fromRGB(235, 240, 255) }) do
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.LightEmission, e.LightInfluence = 1, 0
		e.Rate = 6
		e.Lifetime = NumberRange.new(1.2, 2)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
		e.Color = ColorSequence.new(col)
		e.Shape = Enum.ParticleEmitterShape.Sphere
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		e.Parent = att
	end
end

-- โมเดลประจำคลาส (Import 3D -> ReplicatedStorage.Assets.Characters/<Class>)
local function storeCharacter(classId)
	local a = ReplicatedStorage:FindFirstChild("Assets")
	local folder = a and a:FindFirstChild("Characters")
	local src = folder and folder:FindFirstChild(classId)
	if not src then
		return nil
	end
	local m = src:Clone()
	if not m then
		return nil
	end
	local list = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
			table.insert(list, d)
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
	end
	-- หาเท้าต่ำสุด + ทิศหน้า (หน้าหัวของ Roblox = LookVector ของ Head/HumanoidRootPart)
	local mn, mx = Vector3.new(math.huge, math.huge, math.huge), -Vector3.new(math.huge, math.huge, math.huge)
	for _, p in ipairs(list) do
		if p.Transparency < 1 and p.Name ~= "HumanoidRootPart" then
			mn = mn:Min(p.Position - p.Size / 2)
			mx = mx:Max(p.Position + p.Size / 2)
		end
	end
	local face = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or list[1]
	local look = face and face.CFrame.LookVector or Vector3.new(0, 0, -1)
	look = Vector3.new(look.X, 0, look.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local base = Vector3.new((mn.X + mx.X) / 2, mn.Y, (mn.Z + mx.Z) / 2)
	local pivot = CFrame.lookAt(base, base + look)
	local primary = m.PrimaryPart or face
	m.PrimaryPart = primary
	primary.PivotOffset = primary.CFrame:ToObjectSpace(pivot)
	-- ย่อ/ขยายให้สูงเท่ากันทุกคลาส (5.6 studs)
	local h = mx.Y - mn.Y
	if h > 0.1 then
		m:ScaleTo(m:GetScale() * 5.6 / h)
	end
	m:PivotTo(CF(0, 0, 0))
	return m
end

function ClassAvatars.Build(classId, _waitSec)
	local store = storeCharacter(classId)
	if store then
		return store, true
	end
	local o = OUTFIT[classId] or OUTFIT.Survivor
	local m = Instance.new("Model")
	m.Name = "ClassAvatar_" .. tostring(classId)
	local root = CF(0, 0, 0)
	-- ขา
	for _, x in ipairs({ -0.5, 0.5 }) do
		part(m, { Size = V(1, 2, 1), CFrame = root * CF(x, 1, 0), Color = o.Pants })
		part(m, { Size = V(1.02, 0.4, 1.06), CFrame = root * CF(x, 0.2, -0.02), Color = C(52, 40, 32) })
	end
	-- ลำตัว
	local torso = part(m, { Name = "Torso", Size = V(2, 2, 1), CFrame = root * CF(0, 3, 0), Color = o.Shirt })
	if o.Plaid then
		for i = -1, 1 do
			part(m, { Size = V(2.02, 0.18, 1.02), CFrame = torso.CFrame * CF(0, i * 0.6, 0), Color = C(40, 30, 30) })
			part(m, { Size = V(0.18, 2.02, 1.02), CFrame = torso.CFrame * CF(i * 0.6, 0, 0), Color = C(40, 30, 30) })
		end
	end
	-- แขน
	for _, x in ipairs({ -1.5, 1.5 }) do
		part(m, { Size = V(1, 2, 1), CFrame = root * CF(x, 3, 0), Color = o.Shirt })
		part(m, { Size = V(1.02, 0.5, 1.02), CFrame = root * CF(x, 2.2, 0), Color = SKIN })
	end
	-- หัว + หน้า
	local headCf = root * CF(0, 4.6, 0)
	local head = part(m, { Name = "Head", Size = V(2, 1, 1), CFrame = headCf, Color = SKIN })
	local hm = Instance.new("SpecialMesh")
	hm.MeshType = Enum.MeshType.Head
	hm.Scale = V(1.25, 1.25, 1.25)
	hm.Parent = head
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	hat(m, o.Hat, o.HatColor or o.Shirt, headCf)
	-- ของประกอบ
	local e = o.Extra
	if e == "Scarf" then
		part(m, { Size = V(2.1, 0.45, 1.15), CFrame = root * CF(0, 3.85, 0), Color = o.Accent, Material = Enum.Material.Fabric })
		part(m, { Size = V(0.5, 1.1, 0.2), CFrame = root * CF(0.5, 3.2, -0.6), Color = o.Accent, Material = Enum.Material.Fabric })
	elseif e == "Beard" then
		part(m, { Size = V(1.4, 0.8, 0.4), CFrame = headCf * CF(0, -0.45, -0.5), Color = o.Accent })
	elseif e == "Cross" then
		part(m, { Size = V(0.9, 0.28, 0.06), CFrame = torso.CFrame * CF(0, 0.3, -0.52), Color = o.Accent })
		part(m, { Size = V(0.28, 0.9, 0.06), CFrame = torso.CFrame * CF(0, 0.3, -0.52), Color = o.Accent })
	elseif e == "Quiver" then
		part(m, { Size = V(0.6, 2, 0.6), CFrame = torso.CFrame * CF(0.4, 0.3, 0.75) * ANG(0, 0, 0.35), Color = o.Accent })
		for i = -1, 1 do
			part(m, { Size = V(0.1, 0.6, 0.1), CFrame = torso.CFrame * CF(0.75 + i * 0.12, 1.5, 0.75) * ANG(0, 0, 0.35), Color = C(230, 230, 230) })
		end
		part(m, { Size = V(2.05, 0.2, 1.05), CFrame = torso.CFrame * ANG(0, 0, -0.7), Color = o.Accent })
	elseif e == "Belt" then
		part(m, { Size = V(2.05, 0.4, 1.05), CFrame = torso.CFrame * CF(0, -0.8, 0), Color = o.Accent })
		part(m, { Size = V(0.3, 0.9, 0.3), CFrame = torso.CFrame * CF(0.7, -1.1, -0.55), Color = C(150, 150, 156), Material = Enum.Material.Metal })
		part(m, { Size = V(2.05, 1.4, 1.05), CFrame = torso.CFrame * CF(0, 0.2, 0), Color = C(250, 220, 60), Transparency = 0.6 })
	elseif e == "Bag" then
		part(m, { Size = V(1.6, 1.6, 0.8), CFrame = torso.CFrame * CF(0, 0, 0.9), Color = o.Accent, Material = Enum.Material.Fabric })
		part(m, { Size = V(2.05, 0.2, 1.05), CFrame = torso.CFrame * ANG(0, 0, 0.7), Color = C(80, 60, 40) })
	elseif e == "Basket" then
		part(m, { Size = V(1.2, 0.8, 1), CFrame = root * CF(-1.6, 2, -0.4), Color = C(170, 120, 60), Material = Enum.Material.Fabric })
		part(m, { Shape = Enum.PartType.Ball, Size = V(0.5, 0.5, 0.5), CFrame = root * CF(-1.5, 2.5, -0.5), Color = o.Accent })
	elseif e == "Ember" then
		local fire = part(m, { Shape = Enum.PartType.Ball, Size = V(0.7, 0.7, 0.7), CFrame = root * CF(1.5, 1.7, -0.6), Color = o.Accent, Material = Enum.Material.Neon })
		local l = Instance.new("PointLight")
		l.Color = o.Accent
		l.Range = 8
		l.Brightness = 2
		l.Parent = fire
		part(m, { Size = V(2.05, 0.3, 1.05), CFrame = torso.CFrame * CF(0, -0.85, 0), Color = o.Accent, Material = Enum.Material.Neon })
	elseif e == "Orbs" then
		for i = 0, 2 do
			local a = i / 3 * math.pi * 2
			local cols = { C(120, 230, 255), C(255, 120, 40), C(130, 240, 100) }
			part(m, { Shape = Enum.PartType.Ball, Size = V(0.55, 0.55, 0.55), CFrame = root * CF(math.cos(a) * 2.2, 3.4 + i * 0.3, math.sin(a) * 1.4), Color = cols[i + 1], Material = Enum.Material.Neon })
		end
		part(m, { Size = V(2.1, 2.6, 1.1), CFrame = root * CF(0, 1.9, 0.02), Color = o.Shirt, Material = Enum.Material.Fabric })
	elseif e == "Fur" then
		part(m, { Size = V(2.6, 0.7, 1.4), CFrame = root * CF(0, 3.85, 0), Color = o.Accent, Material = Enum.Material.Fabric })
	end
	torso.PivotOffset = CF(0, -3, 0) -- จุดหมุนอยู่ที่เท้า
	m.PrimaryPart = torso
	return m
end

-- ใส่หุ่นใน ViewportFrame แบบรูปครึ่งตัว (portrait) หรือเต็มตัว
function ClassAvatars.Viewport(frame, classId, portrait, waitSec)
	local model = ClassAvatars.Build(classId, waitSec)
	if not frame.Parent then
		return nil
	end
	frame:ClearAllChildren()
	local world = Instance.new("WorldModel")
	world.Parent = frame
	model.Parent = world
	model:PivotTo(CF(0, 0, 0) * ANG(0, math.pi + 0.35, 0))
	local cam = Instance.new("Camera")
	cam.FieldOfView = portrait and 28 or 35
	-- เล็งที่หัวจริงของโมเดล (ตัวแต่ละแบบสูงไม่เท่ากัน — เดิมเล็งความสูงตายตัวแล้วเห็นแต่หน้าอก)
	local head = model:FindFirstChild("Head")
	local headY = head and head:IsA("BasePart") and head.Position.Y or 4.6
	if portrait then
		cam.CFrame = CFrame.lookAt(V(0.9, headY + 0.4, 8.6), V(0, headY - 0.35, 0))
	else
		cam.CFrame = CFrame.lookAt(V(1.5, headY * 0.78, 13 * headY / 4.6), V(0, headY * 0.63, 0))
	end
	cam.Parent = frame
	frame.CurrentCamera = cam
	frame.Ambient = C(232, 228, 224)
	frame.LightColor = C(255, 252, 245)
	frame.LightDirection = V(-0.4, -1, -0.6)
	return model
end

return ClassAvatars
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000073"><Properties><string name="Name">ClassShop</string><ProtectedString name="Source"><![CDATA[--[[
	ClassShop — ร้านคลาส (แบบ 99 Nights) เวอร์ชันออกแบบใหม่
	  ซ้าย  : รายการคลาส — รูปตัวละครวงกลม (กรอบสีตามดาว) ชื่อ ดาว สายของคลาส ราคา/สต็อก/เลเวล
	          + Ruby ของเรา + เวลารีสต็อก + รีโรลสต็อค + อัตราต่อรอง
	  กลาง  : ตัวละครคลาสจริง (R15 + ของในแคตตาล็อก) ยืนบนเวทีในเต็นท์ Classes + แถบความคืบหน้าเลเวลถัดไป + ปุ่ม
	  ขวา   : เครื่องมือเริ่มต้น + การ์ดทักษะ 3 ขั้น (ชื่อทักษะ + คำอธิบาย / ล็อก = ข้ามด้วย Ruby)
	ทุกอย่างอยู่ในกรอบ 16:9 กลางจอ (UIAspectRatioConstraint) จะได้ไม่เพี้ยนตามขนาดจอ
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared.Classes)
local Items = require(Shared.Items)
local MeshProps = require(Shared.MeshProps)
local Remotes = require(Shared.Remotes)
local ClassAvatars = require(script.Parent.ClassAvatars)
local UIKit = require(script.Parent.UIKit)

local ClassShop = {}

local player = Players.LocalPlayer
local C = Color3.fromRGB
local profile
local selected = "Survivor"
local shownTools -- คลาสที่วาดไอคอนเครื่องมือไว้แล้ว (กันวาดซ้ำทุกครั้งที่รีเฟรช)
local ui = {}
local stage = {}

local GOLD_A, GOLD_B = C(255, 240, 140), C(244, 170, 36)
local GREEN, RED, BLUE, GRAY = C(76, 200, 64), C(222, 64, 64), C(58, 160, 240), C(96, 96, 104)
local LEVEL_COLOR = { C(90, 200, 90), C(70, 150, 245), C(180, 90, 245) }
-- ป้ายสถิติขึ้นเลเวล (สั้น อ่านง่ายบนมือถือ)
local STAT_LABEL = { Kills = "⚔ ฆ่า", Nights = "🌙 รอด" }
local STAT_SHORT = { Kills = "ฆ่า %d/%d", Nights = "รอด %d/%d คืน" }
local BAR_COLOR = { Kills = C(255, 120, 90), Nights = C(120, 170, 255) }
local ITEM_EMOJI = {
	Torch = "🔥", Bandage = "🩹", Medkit = "⛑", Berries = "🍇", Coal = "⚫", LogWall = "🧱", Bow = "🏹",
	OldAxe = "🪓", StoneAxe = "🪓", IronAxe = "🪓", Spear = "🔱", Wood = "🪵", Stone = "🪨",
}

-- โมเดลของไอคอน: เมชในเกม (MeshProps) ก่อน ไม่มีก็ใช้โมเดลจริงจาก Store (Assets.Weapons / Assets.Items) เช่น คทาเพลิง
local function iconModel(itemId)
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
	-- อาวุธ/เครื่องมือ: โมเดลเดียวกับที่ถือในมือจริง (Assets.Weapons) ก่อน -> เมชในเกม -> โมเดลไอเทม
	local function store(folder)
		local src = assets and assets:FindFirstChild(folder) and assets[folder]:FindFirstChild(itemId)
		if not src then
			return nil
		end
		local m = Instance.new("Model")
		for _, c in ipairs(src:GetChildren()) do
			c:Clone().Parent = m
		end
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Fire") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		return m
	end
	local w = store("Weapons")
	if w then
		return w
	end
	if MeshProps.Has(itemId) then
		local ok, model = pcall(MeshProps.Build, itemId)
		if ok and model then
			return model
		end
	end
	for _, folder in ipairs({ "Items" }) do
		local src = assets and assets:FindFirstChild(folder) and assets[folder]:FindFirstChild(itemId)
		if src then
			local m = Instance.new("Model")
			for _, c in ipairs(src:GetChildren()) do
				c:Clone().Parent = m
			end
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Fire") then
					d:Destroy()
				elseif d:IsA("BasePart") then
					d.Anchored = true
				end
			end
			return m
		end
	end
	return nil
end

---------------------------------------------------------------- ตัวช่วย UI
local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 10)
	c.Parent = obj
	return c
end

local function border(obj, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color or C(0, 0, 0)
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.Parent = obj
	return s
end

local function gradient(obj, a, b, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rot or 90
	g.Parent = obj
	return g
end

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = C(28, 30, 52)
	f.BackgroundTransparency = 0.08
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

-- ตัวหนังสือหนา ขอบดำ ปรับขนาดอัตโนมัติ
local function text(parent, props, maxSize, strokeThickness)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = C(255, 255, 255)
	t.TextScaled = true
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	t.Parent = parent
	local lim = Instance.new("UITextSizeConstraint")
	lim.MaxTextSize = maxSize or 32
	lim.MinTextSize = 7
	lim.Parent = t
	if (strokeThickness or 2) > 0 then
		local s = Instance.new("UIStroke")
		s.Thickness = strokeThickness or 2
		s.Color = C(0, 0, 0)
		s.Parent = t
	end
	return t
end

local function button(parent, props, color, onClick, maxSize)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BorderSizePixel = 0
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = C(255, 255, 255)
	b.TextScaled = true
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	b.Parent = parent
	corner(b, 10)
	gradient(b, C(255, 255, 255), C(175, 175, 175), 90)
	border(b, C(0, 0, 0), 2.5, 0.1)
	local ts = Instance.new("UIStroke")
	ts.Thickness = 2
	ts.Color = C(0, 0, 0)
	ts.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	ts.Parent = b
	local lim = Instance.new("UITextSizeConstraint")
	lim.MaxTextSize = maxSize or 30
	lim.MinTextSize = 7
	lim.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0.06, 0), UDim.new(0.06, 0)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0.16, 0), UDim.new(0.16, 0)
	pad.Parent = b
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

local function setButton(b, txt, color, enabled)
	b.Text = txt
	b.BackgroundColor3 = color
	b.AutoButtonColor = enabled ~= false
end

-- แผงหลัก: พื้นเข้ม ขอบดำหนา ไล่แสงด้านบน + เส้นขอบในบางๆ
local function panel(parent, pos, size)
	local p = frame(parent, { Position = pos, Size = size, BackgroundColor3 = C(34, 38, 66), BackgroundTransparency = 0.06 })
	corner(p, 18)
	border(p, C(0, 0, 0), 3, 0.15)
	gradient(p, C(255, 255, 255), C(185, 185, 195), 90)
	local inner = frame(p, { Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(1, -8, 1, -8), BackgroundTransparency = 1 })
	corner(inner, 15)
	border(inner, C(255, 255, 255), 1.5, 0.88)
	return p
end

local function stars(n)
	return string.rep("★", n)
end

---------------------------------------------------------------- ข้อมูล
local function data()
	return profile or { Diamonds = player:GetAttribute("Diamonds") or 0, Owned = { Survivor = true }, ClassLevel = {}, ClassStats = {}, StockDay = 0, StockRoll = 0 }
end

local function now()
	return Workspace:GetServerTimeNow()
end

local function stock()
	local d = data()
	local day = Classes.Day(now())
	local roll = (d.StockDay == day) and (d.StockRoll or 0) or 0
	return Classes.Stock(day, roll, player.UserId)
end

local function levelOf(id)
	local d = data()
	return (d.ClassLevel and d.ClassLevel[id]) or 1
end

local function gems()
	return player:GetAttribute("Diamonds") or data().Diamonds or 0
end

-- ความคืบหน้าสู่เลเวลถัดไป: (req, stats, สัดส่วนเฉลี่ย 0..1) หรือ nil ถ้าเลเวลสูงสุดแล้ว
local function progressOf(id)
	local d = data()
	local req = Classes.Requirement(id, levelOf(id) + 1)
	if not req then
		return nil
	end
	local stats = (d.ClassStats and d.ClassStats[id]) or {}
	local sum, n = 0, 0
	for _, k in ipairs(Classes.StatOrder) do
		if req[k] then
			sum += math.clamp((stats[k] or 0) / math.max(req[k], 1), 0, 1)
			n += 1
		end
	end
	return req, stats, n > 0 and sum / n or 1
end

---------------------------------------------------------------- เวทีโชว์ตัวละคร (กล้องในเต็นท์)
local function findStage()
	local lobby = Workspace:FindFirstChild("Lobby")
	return lobby and lobby:FindFirstChild("ClassStage", true)
end

local function sparkle(cf, color)
	local fx = Instance.new("Part")
	fx.Anchored, fx.CanCollide, fx.CanQuery, fx.CanTouch, fx.Transparency = true, false, false, false, 1
	fx.Size = Vector3.new(1, 1, 1)
	fx.CFrame = cf
	fx.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(4, 10)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.6, 0)
	e.Color = ColorSequence.new(color)
	e.Parent = fx
	e:Emit(45)
	task.delay(2, function()
		fx:Destroy()
	end)
end

function ClassShop.IsOpen()
	return ui.Root ~= nil and ui.Root.Visible
end

local function showOnStage(id)
	local token = {}
	stage.Token = token
	task.spawn(function()
		local st = findStage()
		local model = ClassAvatars.Build(id, 6)
		if stage.Token ~= token or not ClassShop.IsOpen() then
			model:Destroy()
			return
		end
		if stage.Model then
			stage.Model:Destroy()
			stage.Model = nil
		end
		if not st then
			model:Destroy()
			ui.CenterView.Visible = true
			ClassAvatars.Viewport(ui.CenterView, id, false)
			return
		end
		ui.CenterView.Visible = false
		stage.Model = model
		stage.Base = st.CFrame * CFrame.new(0, st.Size.Y / 2, 0)
		model:PivotTo(stage.Base)
		model.Parent = Workspace
		stage.Class = id
		ClassAvatars.PlayIdle(model, id)
		sparkle(stage.Base * CFrame.new(0, 3, 0), Classes.StarColor[Classes.Data[id].Stars])
	end)
end

local function cameraToStage()
	local st = findStage()
	if not st then
		return
	end
	local cam = Workspace.CurrentCamera
	stage.PrevFov = cam.FieldOfView
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 40
	local base = st.CFrame * CFrame.new(0, st.Size.Y / 2, 0)
	cam.CFrame = CFrame.lookAt((base * CFrame.new(0, 3.2, -16)).Position, (base * CFrame.new(0, 1.75, 0)).Position)
	if stage.Conn then
		stage.Conn:Disconnect()
	end
	-- ตัวละครยืนนิ่งบนเวที (ไม่ขยับ)
end

local function restoreCamera()
	stage.Token = nil
	if stage.Conn then
		stage.Conn:Disconnect()
		stage.Conn = nil
	end
	if stage.Model then
		stage.Model:Destroy()
		stage.Model = nil
	end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = stage.PrevFov or 70
end

---------------------------------------------------------------- การ์ดคลาส (ซ้าย)
local function cardHeight()
	return math.clamp(math.floor(Workspace.CurrentCamera.ViewportSize.Y * 0.105), 72, 132)
end

function ClassShop.MakeCard(id, order)
	local c = Classes.Data[id]
	local rare = Classes.StarColor[c.Stars]
	local card = Instance.new("TextButton")
	card.Text = ""
	card.AutoButtonColor = false
	card.BackgroundColor3 = C(52, 58, 98)
	card.Size = UDim2.new(1, -10, 0, cardHeight())
	card.LayoutOrder = order
	card.Parent = ui.List
	corner(card, 12)
	local stroke = border(card, C(0, 0, 0), 2, 0.2)
	gradient(card, C(255, 255, 255), C(200, 200, 210), 90)
	local accent = frame(card, { Size = UDim2.new(0, 6, 1, -16), Position = UDim2.new(0, 6, 0, 8), BackgroundColor3 = rare, BackgroundTransparency = 0 })
	corner(accent, 3)
	-- รูปวงกลม (CanvasGroup ตัดขอบให้กลมจริง)
	local holder = Instance.new("CanvasGroup")
	holder.BackgroundColor3 = C(236, 240, 252)
	holder.Size = UDim2.fromScale(0.84, 0.84)
	holder.Position = UDim2.new(0, 18, 0.08, 0)
	holder.Parent = card
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 1
	ar.Parent = holder
	corner(holder, UDim.new(0.5, 0))
	border(holder, rare, 3, 0)
	-- พื้นหลังสว่าง (ตัวละครใส่ชุดโทนเข้ม -> ไม่กลืนกับพื้น) ไล่จากขาวอมสีดาวลงมาเป็นสีดาวอ่อน
	gradient(holder, rare:Lerp(C(255, 255, 255), 0.85), rare:Lerp(C(255, 255, 255), 0.45), 90)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Parent = holder
	task.spawn(ClassAvatars.Viewport, vp, id, true, 20)
	-- ตัวหนังสือ
	text(card, { Position = UDim2.new(0.31, 0, 0.07, 0), Size = UDim2.new(0.66, 0, 0.32, 0), Text = c.Thai, TextXAlignment = Enum.TextXAlignment.Left }, 30)
	text(card, { Position = UDim2.new(0.31, 0, 0.42, 0), Size = UDim2.new(0.3, 0, 0.22, 0), Text = stars(c.Stars), TextColor3 = C(255, 205, 50), TextXAlignment = Enum.TextXAlignment.Left }, 24)
	text(card, { Position = UDim2.new(0.31, 0, 0.68, 0), Size = UDim2.new(0.3, 0, 0.22, 0), Text = c.Role, TextColor3 = rare:Lerp(C(255, 255, 255), 0.35), TextXAlignment = Enum.TextXAlignment.Left }, 20)
	local tag = text(card, { Position = UDim2.new(0.62, 0, 0.4, 0), Size = UDim2.new(0.35, 0, 0.2, 0), Text = "", TextXAlignment = Enum.TextXAlignment.Right }, 20)
	local btn = button(card, { Position = UDim2.new(0.62, 0, 0.62, 0), Size = UDim2.new(0.35, 0, 0.3, 0), Text = "" }, BLUE, nil, 22)
	local function pick()
		if selected ~= id then
			selected = id
			ClassShop.Refresh()
			showOnStage(id)
		end
	end
	card.Activated:Connect(pick)
	btn.Activated:Connect(pick)
	ui.Cards[id] = { Card = card, Stroke = stroke, Tag = tag, Button = btn }
end

---------------------------------------------------------------- สร้าง UI ทั้งหมด
function ClassShop.Build(gui)
	local root = frame(gui, { Name = "ClassShop", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })
	ui.Root = root
	-- กรอบ 16:9 กลางจอ
	local canvas = frame(root, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 16 / 9
	ar.Parent = canvas

	-------------------------------------------------- ซ้าย
	local left = panel(canvas, UDim2.fromScale(0.012, 0.03), UDim2.fromScale(0.285, 0.94))
	local title = text(left, { Position = UDim2.fromScale(0.06, 0.018), Size = UDim2.fromScale(0.45, 0.085), Text = "คลาส", TextXAlignment = Enum.TextXAlignment.Left }, 72, 3)
	gradient(title, GOLD_A, GOLD_B, 90)
	local gemPill = frame(left, { Position = UDim2.fromScale(0.55, 0.03), Size = UDim2.fromScale(0.4, 0.062), BackgroundColor3 = C(22, 24, 44), BackgroundTransparency = 0.15 })
	corner(gemPill, UDim.new(0.5, 0))
	border(gemPill, C(255, 120, 120), 2, 0.2)
	ui.Gems = text(gemPill, { Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1), Text = "♦️ 0" }, 28)
	local restock = frame(left, { Position = UDim2.fromScale(0.06, 0.108), Size = UDim2.fromScale(0.88, 0.045), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.55 })
	corner(restock, UDim.new(0.5, 0))
	ui.Restock = text(restock, { Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1), Text = "", TextColor3 = C(210, 214, 225) }, 20, 1.5)
	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromScale(0.04, 0.168)
	list.Size = UDim2.fromScale(0.94, 0.7)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = C(150, 150, 160)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = left
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 7)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = list
	local lpad = Instance.new("UIPadding")
	lpad.PaddingTop = UDim.new(0, 4)
	lpad.PaddingBottom = UDim.new(0, 4)
	lpad.Parent = list
	ui.List = list
	ui.Cards = {}
	for i, id in ipairs(Classes.Order) do
		ClassShop.MakeCard(id, i)
	end
	button(left, { Position = UDim2.fromScale(0.05, 0.887), Size = UDim2.fromScale(0.58, 0.08), Text = "🎲 รีโรลสต็อค  ♦️" .. Classes.RerollPrice }, GREEN, function()
		Remotes.Get("RerollStock"):FireServer()
	end, 28)
	button(left, { Position = UDim2.fromScale(0.66, 0.887), Size = UDim2.fromScale(0.29, 0.08), Text = "อัตราต่อรอง" }, GRAY, function()
		ui.Odds.Visible = not ui.Odds.Visible
	end, 20)
	local odds = panel(canvas, UDim2.fromScale(0.305, 0.6), UDim2.fromScale(0.16, 0.32))
	odds.Visible = false
	odds.ZIndex = 5
	text(odds, { Position = UDim2.fromScale(0.06, 0.04), Size = UDim2.fromScale(0.88, 0.14), Text = "โอกาสติดสต็อคต่อวัน" }, 22)
	for s = 1, 5 do
		text(odds, {
			Position = UDim2.fromScale(0.1, 0.06 + s * 0.15), Size = UDim2.fromScale(0.8, 0.12), TextXAlignment = Enum.TextXAlignment.Left,
			Text = string.format("%s  %d%%", stars(s), math.floor(Classes.StockOdds[s] * 100)), TextColor3 = Classes.StarColor[s],
		}, 22)
	end
	ui.Odds = odds

	-------------------------------------------------- กลาง
	ui.Name = text(canvas, { Position = UDim2.fromScale(0.32, 0.03), Size = UDim2.fromScale(0.36, 0.085), Text = "" }, 80, 3)
	gradient(ui.Name, C(170, 255, 245), C(40, 200, 225), 90)
	ui.Sub = text(canvas, { Position = UDim2.fromScale(0.34, 0.118), Size = UDim2.fromScale(0.32, 0.045), Text = "", RichText = true }, 30)
	ui.CenterView = Instance.new("ViewportFrame")
	ui.CenterView.Position = UDim2.fromScale(0.39, 0.18)
	ui.CenterView.Size = UDim2.fromScale(0.22, 0.46)
	ui.CenterView.BackgroundTransparency = 1
	ui.CenterView.Visible = false
	ui.CenterView.Parent = canvas
	local prog = panel(canvas, UDim2.fromScale(0.345, 0.665), UDim2.fromScale(0.31, 0.165))
	ui.ProgTitle = text(prog, { Position = UDim2.fromScale(0.05, 0.06), Size = UDim2.fromScale(0.9, 0.24), Text = "", TextColor3 = C(130, 225, 255) }, 26)
	ui.Bars = {}
	for i = 1, 2 do
		local y = 0.36 + (i - 1) * 0.3
		local lbl = text(prog, { Position = UDim2.fromScale(0.05, y), Size = UDim2.fromScale(0.3, 0.24), Text = "", TextXAlignment = Enum.TextXAlignment.Left }, 22)
		local track = frame(prog, { Position = UDim2.fromScale(0.36, y + 0.03), Size = UDim2.fromScale(0.59, 0.18), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.35 })
		corner(track, UDim.new(0.5, 0))
		border(track, C(0, 0, 0), 1.5, 0)
		local fill = frame(track, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(110, 225, 90), BackgroundTransparency = 0 })
		corner(fill, UDim.new(0.5, 0))
		gradient(fill, C(255, 255, 255), C(170, 170, 170), 90)
		local num = text(track, { Size = UDim2.fromScale(1, 1), Text = "" }, 18, 1.5)
		ui.Bars[i] = { Label = lbl, Track = track, Fill = fill, Num = num }
	end
	ui.Info = text(prog, { Position = UDim2.fromScale(0.05, 0.36), Size = UDim2.fromScale(0.9, 0.56), Text = "", TextWrapped = true, Visible = false }, 24)
	ui.Main = button(canvas, { Position = UDim2.fromScale(0.345, 0.845), Size = UDim2.fromScale(0.215, 0.095), Text = "" }, GREEN, function()
		ClassShop.MainAction()
	end, 40)
	button(canvas, { Position = UDim2.fromScale(0.57, 0.845), Size = UDim2.fromScale(0.085, 0.095), Text = "ปิด" }, RED, function()
		ClassShop.Close()
	end, 32)

	-------------------------------------------------- ขวา
	local right = panel(canvas, UDim2.fromScale(0.703, 0.03), UDim2.fromScale(0.285, 0.94))
	local toolsTitle = text(right, { Position = UDim2.fromScale(0.06, 0.02), Size = UDim2.fromScale(0.88, 0.06), Text = "เครื่องมือเริ่มต้น" }, 40, 3)
	gradient(toolsTitle, GOLD_A, GOLD_B, 90)
	ui.Tools = frame(right, { Position = UDim2.fromScale(0.05, 0.09), Size = UDim2.fromScale(0.9, 0.17), BackgroundTransparency = 1 })
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	tl.Padding = UDim.new(0.04, 0)
	tl.Parent = ui.Tools
	local skillTitle = text(right, { Position = UDim2.fromScale(0.06, 0.285), Size = UDim2.fromScale(0.88, 0.06), Text = "ทักษะ" }, 40, 3)
	gradient(skillTitle, C(220, 245, 255), C(110, 185, 255), 90)
	ui.Skills = {}
	for lv = 1, 3 do
		local box = frame(right, { Position = UDim2.fromScale(0.05, 0.36 + (lv - 1) * 0.205), Size = UDim2.fromScale(0.9, 0.19), BackgroundColor3 = C(52, 58, 98), BackgroundTransparency = 0 })
		corner(box, 12)
		local bstroke = border(box, LEVEL_COLOR[lv], 2, 0.3)
		gradient(box, C(255, 255, 255), C(195, 195, 205), 90)
		local chip = frame(box, { Position = UDim2.fromScale(0.03, 0.08), Size = UDim2.fromScale(0.2, 0.28), BackgroundColor3 = LEVEL_COLOR[lv], BackgroundTransparency = 0 })
		corner(chip, UDim.new(0.5, 0))
		border(chip, C(0, 0, 0), 1.5, 0)
		text(chip, { Size = UDim2.fromScale(0.9, 0.86), Position = UDim2.fromScale(0.05, 0.07), Text = "Lv." .. lv }, 22, 1.5)
		local name = text(box, { Position = UDim2.fromScale(0.26, 0.06), Size = UDim2.fromScale(0.62, 0.32), Text = "", TextColor3 = C(255, 214, 90), TextXAlignment = Enum.TextXAlignment.Left }, 28)
		local lock = text(box, { Position = UDim2.fromScale(0.88, 0.06), Size = UDim2.fromScale(0.1, 0.32), Text = "🔒", Visible = false }, 26, 0)
		local desc = text(box, { Position = UDim2.fromScale(0.04, 0.42), Size = UDim2.fromScale(0.92, 0.28), Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Font = Enum.Font.GothamBold }, 22, 1.5)
		local foot = text(box, { Position = UDim2.fromScale(0.04, 0.74), Size = UDim2.fromScale(0.52, 0.2), Text = "", TextColor3 = C(255, 120, 120), TextXAlignment = Enum.TextXAlignment.Left, Visible = false }, 18, 1.5)
		local skip = button(box, { Position = UDim2.fromScale(0.6, 0.71), Size = UDim2.fromScale(0.37, 0.25), Text = "", Visible = false }, GREEN, function()
			Remotes.Get("SkipClassLevel"):FireServer(selected)
		end, 20)
		ui.Skills[lv] = { Box = box, Stroke = bstroke, Name = name, Lock = lock, Desc = desc, Foot = foot, Skip = skip }
	end
end

---------------------------------------------------------------- เติมข้อมูล
local function drawTools(c)
	for _, ch in ipairs(ui.Tools:GetChildren()) do
		if ch:IsA("Frame") then
			ch:Destroy()
		end
	end
	local order = 0
	for itemId, n in pairs(c.StartItems) do
		order += 1
		local tile = frame(ui.Tools, { Size = UDim2.fromScale(0.3, 1), BackgroundColor3 = C(56, 62, 104), BackgroundTransparency = 0, LayoutOrder = order })
		corner(tile, 12)
		border(tile, C(0, 0, 0), 2, 0.2)
		gradient(tile, C(255, 255, 255), C(185, 185, 195), 90)
		local icon = Instance.new("ViewportFrame")
		icon.Size = UDim2.fromScale(0.8, 0.6)
		icon.Position = UDim2.fromScale(0.1, 0.05)
		icon.BackgroundTransparency = 1
		icon.Parent = tile
		-- ไอคอน = โมเดลจริงของของชิ้นนั้น · อีโมจิใช้เฉพาะตอนหาโมเดลไม่เจอจริงๆ เท่านั้น
		local emoji = text(tile, { Size = UDim2.fromScale(0.8, 0.6), Position = UDim2.fromScale(0.1, 0.05), Text = ITEM_EMOJI[itemId] or "📦", Visible = false }, 54, 0)
		text(tile, { Position = UDim2.fromScale(0.55, 0.02), Size = UDim2.fromScale(0.42, 0.26), Text = "x" .. n, TextXAlignment = Enum.TextXAlignment.Right }, 24)
		text(tile, { Position = UDim2.fromScale(0.04, 0.68), Size = UDim2.fromScale(0.92, 0.26), Text = Items.DisplayName(itemId) }, 18, 1.5)
		do
			task.spawn(function()
				local model = iconModel(itemId)
				if not model then
					emoji.Visible = true
				end
				if model and icon.Parent then
					local wm = Instance.new("WorldModel")
					wm.Parent = icon
					model.Parent = wm
					local cf, size = model:GetBoundingBox()
					local cam = Instance.new("Camera")
					cam.FieldOfView = 30
					local long = math.max(size.X, size.Y, size.Z)
					local thin = long > 2.2 * (size.X + size.Y + size.Z - long) / 2
					if thin then
						-- ของยาวผอม (คทา/ขวาน/คบเพลิง/ธนู): ตั้งแกนยาวเอียง 50° ให้เต็มช่องไอคอน (ช่องกว้างกว่าสูง)
						-- แกนยาว -> ขึ้น (Y) · แกนกลาง -> ข้าง (X) · แกนบางสุด -> หันเข้ากล้อง (Z) = เห็นด้านแบน (หัวขวาน/หัวคทา) เต็มๆ
						local axes = { { Vector3.xAxis, size.X }, { Vector3.yAxis, size.Y }, { Vector3.zAxis, size.Z } }
						table.sort(axes, function(p, q)
							return p[2] > q[2]
						end)
						local wl, wm, ws = cf:VectorToWorldSpace(axes[1][1]), cf:VectorToWorldSpace(axes[2][1]), cf:VectorToWorldSpace(axes[3][1])
						if wm:Cross(wl):Dot(ws) < 0 then
							ws = -ws
						end
						local center = CFrame.new(cf.Position)
						local rot = CFrame.Angles(0, 0, math.rad(-50)) * CFrame.fromMatrix(Vector3.zero, wm, wl, ws):Inverse()
						model:PivotTo(center * rot * center:ToObjectSpace(model:GetPivot()))
						cf, size = model:GetBoundingBox()
						local dist = math.max(size.X / 1.33, size.Y) * 0.5 / math.tan(math.rad(15)) * 1.12 + size.Z / 2
						cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 0, dist), cf.Position)
					else
						local dist = size.Magnitude * 1.7
						cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.6, dist * 0.35, dist * 0.7), cf.Position)
					end
					cam.Parent = icon
					icon.CurrentCamera = cam
					emoji.Visible = false
				end
			end)
		end
	end
end

function ClassShop.Refresh()
	if not ui.Root then
		return
	end
	local d = data()
	local st = stock()
	local current = player:GetAttribute("Class") or "Survivor"
	ui.Gems.Text = "♦️ " .. tostring(gems())
	local s = Classes.SecondsToRestock(now())
	ui.Restock.Text = string.format("สต็อกใหม่ใน %d ชม. %d นาที", s // 3600, (s % 3600) // 60)
	local h = cardHeight()
	for id, cd in pairs(ui.Cards) do
		local c = Classes.Data[id]
		local owned = d.Owned and d.Owned[id]
		cd.Card.Size = UDim2.new(1, -10, 0, h)
		cd.Stroke.Color = (id == selected) and C(255, 214, 60) or C(0, 0, 0)
		cd.Stroke.Thickness = (id == selected) and 3.5 or 2
		cd.Stroke.Transparency = (id == selected) and 0 or 0.2
		if id == current then
			cd.Tag.Text, cd.Tag.TextColor3 = "✔ สวมใส่อยู่", C(255, 220, 60)
		elseif owned then
			cd.Tag.Text, cd.Tag.TextColor3 = "มีแล้ว", C(140, 240, 100)
		else
			cd.Tag.Text, cd.Tag.TextColor3 = "♦️ " .. c.Price, C(150, 225, 255)
		end
		if owned then
			local _, _, frac = progressOf(id)
			setButton(cd.Button, frac and string.format("Lv.%d · %d%%", levelOf(id), math.floor(frac * 100)) or ("Lv.%d ⭐MAX"):format(levelOf(id)), BLUE)
		elseif st[id] then
			setButton(cd.Button, "มีในสต็อค", GREEN)
		else
			setButton(cd.Button, "ไม่มีสต๊อค", RED)
		end
	end
	-- กลาง
	local c = Classes.Data[selected]
	local owned = d.Owned and d.Owned[selected]
	local lv = levelOf(selected)
	ui.Name.Text = c.Thai
	ui.Sub.Text = string.format('<font color="#FFCD32">%s</font>  ·  %s  ·  %s', stars(c.Stars), c.Role, owned and ("เลเวล " .. lv .. "/" .. Classes.MaxLevel) or "ยังไม่ปลดล็อก")
	local stats = (d.ClassStats and d.ClassStats[selected]) or {}
	local req = Classes.Requirement(selected, lv + 1)
	local showBars = owned and req ~= nil
	for _, b in ipairs(ui.Bars) do
		b.Label.Visible, b.Track.Visible = showBars, showBars
	end
	ui.Info.Visible = not showBars
	if not owned then
		ui.ProgTitle.Text = "ปลดล็อกคลาสนี้"
		ui.Info.Text = st[selected] and string.format("ราคา ♦️%d — มีในสต็อควันนี้", c.Price) or "ไม่มีสต๊อควันนี้ — รอรีสต็อกหรือกดรีโรล"
		ui.Info.TextColor3 = st[selected] and C(140, 240, 100) or C(255, 130, 120)
	elseif req then
		-- สรุปบรรทัดเดียว: "Lv2: ฆ่า 12/60 · รอด 2/4 คืน" + แถบแยกของแต่ละเงื่อนไข (ครบแล้ว = เขียว ✔)
		local parts = {}
		for i, k in ipairs(Classes.StatOrder) do
			local b = ui.Bars[i]
			local have, need = stats[k] or 0, req[k] or 1
			local done = have >= need
			table.insert(parts, string.format(STAT_SHORT[k] or (k .. " %d/%d"), math.min(have, need), need))
			b.Label.Text = (STAT_LABEL[k] or Classes.StatNames[k] or k) .. (done and " ✔" or "")
			b.Fill.Size = UDim2.fromScale(math.clamp(have / math.max(need, 1), 0, 1), 1)
			b.Fill.BackgroundColor3 = done and C(110, 225, 90) or (BAR_COLOR[k] or C(110, 225, 90))
			b.Num.Text = string.format("%d / %d", math.min(have, need), need)
		end
		ui.ProgTitle.Text = string.format("Lv%d: %s", lv + 1, table.concat(parts, " · "))
	else
		ui.ProgTitle.Text = "⭐ เลเวลสูงสุดแล้ว"
		ui.Info.Text = string.format("ล่าสัตว์ %d ตัว · รอด %d คืน กับคลาสนี้", stats.Kills or 0, stats.Nights or 0)
		ui.Info.TextColor3 = C(255, 220, 120)
	end
	if selected == current then
		if selected == "Survivor" then
			setButton(ui.Main, "สวมใส่อยู่", GRAY, false)
		else
			setButton(ui.Main, "ถอดออก", RED)
		end
	elseif owned then
		setButton(ui.Main, "สวมใส่", GREEN)
	elseif not st[selected] then
		setButton(ui.Main, "ไม่มีสต๊อค", GRAY, false)
	elseif gems() < c.Price then
		setButton(ui.Main, "♦️ ไม่พอ (" .. c.Price .. ")", GRAY, false)
	else
		setButton(ui.Main, "ซื้อ  ♦️" .. c.Price, GREEN)
	end
	-- ขวา
	if shownTools ~= selected then
		shownTools = selected
		drawTools(c)
	end
	for i, sk in ipairs(ui.Skills) do
		local skill = c.Skills[i]
		local unlocked = owned and lv >= i
		sk.Name.Text = skill.Name
		sk.Desc.Text = skill.Text
		sk.Name.TextTransparency = unlocked and 0 or 0.35
		sk.Desc.TextTransparency = unlocked and 0 or 0.4
		sk.Box.BackgroundColor3 = unlocked and C(52, 58, 98) or C(30, 32, 54)
		sk.Stroke.Transparency = unlocked and 0.1 or 0.6
		sk.Lock.Visible = not unlocked
		local canSkip = owned and i == lv + 1
		sk.Foot.Visible = not unlocked
		sk.Foot.Text = owned and ("ปลดที่เลเวล " .. i) or "ซื้อคลาสก่อน"
		sk.Skip.Visible = canSkip
		if canSkip then
			sk.Skip.Text = "ข้าม ♦️" .. Classes.SkipPrice(selected, i)
		end
	end
end

-- เลือกคลาสจากภายนอก (เทสต์/ทางลัด)
function ClassShop.Select(id)
	if Classes.Data[id] and ClassShop.IsOpen() then
		selected = id
		ClassShop.Refresh()
		showOnStage(id)
	end
end

function ClassShop.MainAction()
	local d = data()
	local current = player:GetAttribute("Class") or "Survivor"
	local owned = d.Owned and d.Owned[selected]
	if selected == current then
		if selected ~= "Survivor" then
			Remotes.Get("ChooseClass"):FireServer("Survivor") -- ถอด = กลับเป็นผู้รอดชีวิต
		end
	elseif owned then
		Remotes.Get("ChooseClass"):FireServer(selected)
	elseif stock()[selected] and gems() >= Classes.Data[selected].Price then
		Remotes.Get("BuyClass"):FireServer(selected)
	end
end

function ClassShop.SetProfile(p)
	profile = p
	if ClassShop.IsOpen() then
		ClassShop.Refresh()
	end
end

function ClassShop.Open()
	if not ui.Root then
		return
	end
	selected = player:GetAttribute("Class") or "Survivor"
	ui.Root.Visible = true
	ui.Odds.Visible = false
	cameraToStage()
	showOnStage(selected)
	ClassShop.Refresh()
	-- ดึงสถิติล่าสุด (ฆ่า/รอดคืน นับระหว่างรอบโดยไม่ได้ส่งโปรไฟล์ทุกครั้ง)
	task.spawn(function()
		local ok, p = pcall(function()
			return Remotes.Get("GetProfile"):InvokeServer()
		end)
		if ok and type(p) == "table" then
			profile = p
			if ClassShop.IsOpen() then
				ClassShop.Refresh()
			end
		end
	end)
	if ClassShop.OnVisibility then
		ClassShop.OnVisibility(true)
	end
end

function ClassShop.Close()
	if not ClassShop.IsOpen() then
		return
	end
	ui.Root.Visible = false
	restoreCamera()
	if ClassShop.OnVisibility then
		ClassShop.OnVisibility(false)
	end
end

function ClassShop.Init(gui)
	ClassShop.Build(gui)
	-- Esc = ปิด (หน้าเต็มจอ ไม่มี "นอกหน้าต่าง" ให้แตะ)
	UIKit.RegisterWindow(ui.Root, ClassShop.Close, { Backdrop = false })
	local function refreshIfOpen()
		if ClassShop.IsOpen() then
			ClassShop.Refresh()
		end
	end
	player:GetAttributeChangedSignal("Diamonds"):Connect(refreshIfOpen)
	player:GetAttributeChangedSignal("Class"):Connect(refreshIfOpen)
	player:GetAttributeChangedSignal("ClassLevel"):Connect(refreshIfOpen)
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		if player:GetAttribute("InRun") then
			ClassShop.Close()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			refreshIfOpen()
		end
	end)
end

return ClassShop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000074"><Properties><string name="Name">ClientSettings</string><ProtectedString name="Source"><![CDATA[--[[
	ClientSettings — ค่าตั้งค่าของผู้เล่น (เซฟในเซิร์ฟเวอร์ผ่าน Remotes.SaveSettings ติดตัวข้ามเครื่อง)
	  ClientSettings.Get(key) / Set(key, value) / OnChanged(fn(key, value))
	  ApplyGraphics(): คุณภาพกราฟิก ต่ำ/กลาง/สูง (เงา, เอฟเฟกต์ภาพ, อนุภาคลอย)
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local ClientSettings = {}

local isPhone = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

ClientSettings.Defaults = {
	MusicVol = 0.6,
	AmbientVol = 0.7,
	SfxVol = 0.8,
	Quality = isPhone and "Low" or "High", -- Low / Medium / High
	Shake = true,
	Hints = not isPhone, -- มือถือ: ปิดแถบคำแนะนำไว้ก่อน (จอเล็ก รก) เปิดเองได้
	ShowFPS = false,
	UIScale = 1, -- 0.7 - 1.3 (คูณกับสเกลอัตโนมัติตามขนาดจอ)
	TouchSize = 1, -- ขนาดปุ่มมือถือ 0.8 - 1.4
	AutoTool = true, -- ตีต้นไม้/หิน/สัตว์ -> หยิบเครื่องมือที่เหมาะที่สุดขึ้นมือเอง
	PinRecipe = "", -- สูตรที่ปักหมุดไว้ (แถบติดตามวัตถุดิบ)
}

local values = table.clone(ClientSettings.Defaults)
local listeners = {}
local saveQueued = false

function ClientSettings.Get(key)
	return values[key]
end

function ClientSettings.OnChanged(fn)
	table.insert(listeners, fn)
end

local function fire(key, value)
	for _, fn in ipairs(listeners) do
		task.spawn(fn, key, value)
	end
end

local function queueSave()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(2, function()
		saveQueued = false
		Remotes.Get("SaveSettings"):FireServer(values)
	end)
end

function ClientSettings.Set(key, value, noSave)
	if values[key] == value then
		return
	end
	values[key] = value
	if key == "Quality" then
		ClientSettings.ApplyGraphics()
	end
	fire(key, value)
	if not noSave then
		queueSave()
	end
end

-- โหลดจากเซฟ (profile.Settings)
function ClientSettings.Load(saved)
	if type(saved) ~= "table" then
		return
	end
	for k, def in pairs(ClientSettings.Defaults) do
		local v = saved[k]
		if v ~= nil and type(v) == type(def) and values[k] ~= v then
			values[k] = v
			fire(k, v)
		end
	end
	ClientSettings.ApplyGraphics()
end

local QUALITY = {
	Low = { Shadows = false, Post = false, Particles = 0.25, DOF = false },
	Medium = { Shadows = true, Post = true, Particles = 0.6, DOF = false },
	High = { Shadows = true, Post = true, Particles = 1, DOF = true },
}

function ClientSettings.ApplyGraphics()
	local q = QUALITY[values.Quality] or QUALITY.High
	pcall(function()
		Lighting.GlobalShadows = q.Shadows
	end)
	for _, name in ipairs({ "ASBloom", "ASSunRays" }) do
		local e = Lighting:FindFirstChild(name)
		if e then
			e.Enabled = q.Post
		end
	end
	local dof = Lighting:FindFirstChild("ASDepth")
	if dof then
		dof.Enabled = q.DOF
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Enabled = values.Quality ~= "Low"
	end
	ClientSettings.ParticleMult = q.Particles
	fire("Graphics", values.Quality)
end

return ClientSettings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000075"><Properties><string name="Name">ClipAnimator</string><ProtectedString name="Source"><![CDATA[--[[
	ClipAnimator — เล่นท่าที่ดึงจากไฟล์ GLB (Shared/AnimalClips/<Id>) ให้สัตว์ผิว+กระดูก (SkinRig = "Clip")
	ตั้ง Bone.Transform ทุกเฟรม ผสมระหว่างเฟรม (ตำแหน่ง lerp + การหมุน slerp) · ความเร็วท่าตามความเร็วเดินจริง
	ท่าที่ได้จาก Meshy เป็นท่าเดิน: ยืนนิ่ง = เล่นช้ามาก (หายใจ) · วิ่ง = เล่นเร็วขึ้น
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VFXLib = require(script.Parent:WaitForChild("VFXLib"))

local ClipAnimator = {}

---------------------------------------------------------------- ท่าโจมตี (ซ้อนบนท่าเดิน)
-- หมุนกระดูกรอบแกนของตัวสัตว์ (X = ขวา, Y = ขึ้น, หน้า = -Z) · บวกที่ X = เงยขึ้น · Hips = เลื่อนทั้งตัว (หน่วยโมเดล 2 = ทั้งตัว)
-- เซิร์ฟเวอร์ลดเลือดหลังเริ่มท่า 0.3 วินาที -> จังหวะกระแทก (Hit) อยู่ที่ ~0.3
local function ease(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end
local R = CFrame.Angles
local ATTACK_LEN = 0.85
local DUST = "rbxasset://textures/particles/smoke_main.dds"
local DUST_COLOR = {
	Earth = { Color3.fromRGB(196, 176, 138), Color3.fromRGB(150, 132, 104) },
	Snow = { Color3.fromRGB(240, 248, 255), Color3.fromRGB(196, 220, 240) },
	Ash = { Color3.fromRGB(150, 120, 104), Color3.fromRGB(90, 70, 64) },
	Sand = { Color3.fromRGB(236, 218, 170), Color3.fromRGB(200, 182, 140) },
}
local function dustEmitter(parent, size, kind)
	local c = DUST_COLOR[kind or "Earth"] or DUST_COLOR.Earth
	local e = Instance.new("ParticleEmitter")
	e.Texture = DUST
	e.Color = ColorSequence.new(c[1], c[2])
	e.LightInfluence = 0.6
	e.Lifetime = NumberRange.new(0.5, 1.1)
	e.Speed = NumberRange.new(4 * size, 9 * size)
	e.SpreadAngle = Vector2.new(25, 35)
	e.Acceleration = Vector3.new(0, 3, 0)
	e.Drag = 3
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * size), NumberSequenceKeypoint.new(1, 2.4 * size) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	e.Rate = 0
	e.Parent = parent
	return e
end
-- ฝุ่นฟุ้งรอบจุดกระแทก (แทนเอฟเฟกต์สีดำ/เลือด)
local function dustBurst(pos, size, kind)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	local e = dustEmitter(p, size, kind)
	e.Shape = Enum.ParticleEmitterShape.Disc
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.EmissionDirection = Enum.NormalId.Top
	e.SpreadAngle = Vector2.new(80, 80)
	e:Emit(26)
	game:GetService("Debris"):AddItem(p, 2)
end
-- w = ง้าง (0->1 ใน 0.25s) · k = กระแทก (0.25-0.38) · ค่อยกลับท่าเดิม
-- กระแทกแบบเด้งเกินนิดหน่อย (back-ease) แล้วค่อยคืนท่า = ดูมีน้ำหนัก ไม่แข็ง
local function backOut(x)
	x = math.clamp(x, 0, 1) - 1
	return 1 + x * x * (2.4 * x + 1.4)
end
local function phases(t)
	local w = t < 0.25 and ease(t / 0.25) or (t < 0.36 and 1 - ease((t - 0.25) / 0.11) or 0)
	local k = t < 0.25 and 0 or (t < 0.36 and backOut((t - 0.25) / 0.11) or 1 - ease((t - 0.36) / (ATTACK_LEN - 0.36)))
	return w, k
end
local ATTACKS = {
	-- กวางผลึก: ยืนสองขาหลังเงยเขา แล้วพุ่งขวิดด้วยเขาผลึกไปข้างหน้า
	MossWolf = {
		Pose = function(t)
			local w, k = phases(t)
			return {
				Hips = R(0.35 * w - 0.12 * k, 0, 0), chest = R(0.2 * w - 0.25 * k, 0, 0), head = R(0.35 * w - 0.75 * k, 0, 0),
				frontleg = R(0.6 * w - 0.3 * k, 0, 0), R_frontleg = R(0.6 * w - 0.3 * k, 0, 0),
			}, Vector3.new(0, 0.05 * w, 0.18 * w - 0.4 * k)
		end,
		Fx = { { "VFXPack/Anime/Shiny-01", 1.8, 0.25 }, { "VFXPack/Anime/Shield-Break-01", 1.4, 0.2 } }, FxAt = 1.0,
	},
	-- จระเข้ศิลา: อ้าปากเงยหัว แล้วงับพุ่ง + สะบัดหัวซ้ายขวา หางฟาดสวน
	Thornboar = {
		Pose = function(t)
			local w, k = phases(t)
			local shake = math.sin(t * 38) * k * 0.45
			return {
				chest = R(0.25 * w - 0.1 * k, shake * 0.5, 0), head = R(0.8 * w - 0.4 * k, shake, 0),
				tail = R(0, -shake * 0.8 - 0.3 * w, 0), tailstart = R(0, -shake * 0.6, 0),
			}, Vector3.new(0, 0.04 * w, 0.12 * w - 0.35 * k)
		end,
		Fx = {}, Dust = 1.1, FxAt = 1.05, Ground = true, -- ไม่มีเลือด: ฝุ่นดินฟุ้งตอนงับ
		-- ตั้งท่าพุ่ง (Windup 0.8s): ย่อตัวต่ำ หัวก้ม หางส่าย · พุ่ง (Charge): โน้มตัวไปหน้า หัวยื่น ฝุ่นกระเด็นออกสองข้าง
		States = {
			Windup = function(t)
				local wag = math.sin(t * 14)
				return { Hips = R(-0.05, 0, 0), chest = R(-0.12, wag * 0.06, 0), head = R(-0.15, -wag * 0.08, 0), tail = R(0, wag * 0.45, 0), tailstart = R(0, wag * 0.3, 0) },
					Vector3.new(0, -0.05, 0.06)
			end,
			Charge = function(t)
				local sway = math.sin(t * 18)
				return { chest = R(-0.1, sway * 0.08, 0), head = R(0.12, -sway * 0.1, 0), tail = R(0, -sway * 0.35, 0), tailstart = R(0, -sway * 0.2, 0) },
					Vector3.new(0, -0.02, -0.04)
			end,
		},
		ChargeDust = true,
	},
	-- เต่าหินภูผา: ยกตัวหน้าขึ้นสูง แล้วกระแทกลงพื้นจนพื้นแตก
	StoneBear = {
		Pose = function(t)
			local w, k = phases(t)
			return {
				Hips = R(0.3 * w - 0.06 * k, 0, 0), chest = R(0.3 * w - 0.12 * k, 0, 0), head = R(0.25 * w - 0.2 * k, 0, 0),
				frontleg = R(0.7 * w, 0, 0), R_frontleg = R(0.7 * w, 0, 0),
			}, Vector3.new(0, 0.06 * w - 0.05 * k, 0)
		end,
		Fx = {}, Dust = 2.2, FxAt = 0.7, Ground = true, -- ฝุ่นดินฟุ้งรอบตัว (เอฟเฟกต์วงหินมีรอยแตกดำบนพื้น เอาออก)
	},
}

-- เอียงตัวตามพื้น: ยิงหาพื้นใต้หัว/ท้าย/ซ้าย/ขวา -> หมุนสะโพกให้ตัวขนานพื้น + ยกขึ้นถ้าพื้นใต้ตัวสูงกว่า (ไม่จมเนินดิน)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.FilterDescendantsInstances = { workspace.Terrain }
local function groundY(pos)
	local hit = workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -24, 0), groundParams)
	return hit and hit.Position.Y
end
local function updateSlope(rig, C, dt)
	C.SlopeTick = (C.SlopeTick or 0) - dt
	if C.SlopeTick <= 0 then
		C.SlopeTick = 0.08
		local root = rig.Root
		local cf = root.CFrame
		local size = C.Extent or rig.Model:GetExtentsSize()
		C.Extent = size
		local half = math.max(size.Z, size.X) * 0.4
		local side = math.min(size.X, size.Z) * 0.4
		local hum = rig.Model:FindFirstChildOfClass("Humanoid")
		local feet = root.Position.Y - root.Size.Y / 2 - (hum and hum.HipHeight or 0)
		local fy, by = groundY(cf.Position + cf.LookVector * half), groundY(cf.Position - cf.LookVector * half)
		local ly, ry = groundY(cf.Position - cf.RightVector * side), groundY(cf.Position + cf.RightVector * side)
		local cy = groundY(cf.Position)
		local pitch, roll, lift = 0, 0, 0
		if fy and by then
			pitch = math.clamp(math.atan2(fy - by, half * 2), -0.6, 0.6)
		end
		if ly and ry then
			roll = math.clamp(math.atan2(ry - ly, side * 2), -0.4, 0.4)
		end
		-- ยกให้พ้นพื้นที่สูงสุดใต้ตัว (ค่าเฉลี่ยกลาง/หัว/ท้าย) ไม่ให้ส่วนใดจม
		local top = math.max(cy or feet, ((fy or feet) + (by or feet)) / 2)
		lift = math.clamp(top - feet, 0, 3)
		C.SlopeTarget = { pitch, roll, lift }
	end
	local t = C.SlopeTarget or { 0, 0, 0 }
	local k = math.min(1, dt * 8)
	C.Pitch = (C.Pitch or 0) + (t[1] - (C.Pitch or 0)) * k
	C.Roll = (C.Roll or 0) + (t[2] - (C.Roll or 0)) * k
	C.Lift = (C.Lift or 0) + (t[3] - (C.Lift or 0)) * k
end

-- ท่าแบบใช้ซ้ำ ----------------------------------------------------------------
-- ตะครุบกัด: ย่อตัว ยกขาหน้า แล้วพุ่งงับ
local function pounce(t)
	local w, k = phases(t)
	return {
		Hips = R(0.25 * w - 0.1 * k, 0, 0), chest = R(0.15 * w - 0.2 * k, 0, 0), head = R(0.3 * w - 0.55 * k, 0, 0),
		frontleg = R(0.55 * w - 0.25 * k, 0, 0), R_frontleg = R(0.55 * w - 0.25 * k, 0, 0), tail = R(0.3 * w, 0, 0),
	}, Vector3.new(0, 0.06 * w, 0.15 * w - 0.38 * k)
end
-- ขวิด/โขกหัว: เงยหัว แล้วโขกลงแรงๆ
local function headbutt(t)
	local w, k = phases(t)
	return {
		chest = R(0.2 * w - 0.15 * k, 0, 0), head = R(0.45 * w - 0.6 * k, 0, 0),
		frontleg = R(0.35 * w, 0, 0), R_frontleg = R(0.15 * w, 0, 0),
	}, Vector3.new(0, 0.05 * w, 0.12 * w - 0.32 * k)
end
-- ยืนสองขาแล้วตบลงพื้น
local function slam(t)
	local w, k = phases(t)
	return {
		Hips = R(0.4 * w - 0.08 * k, 0, 0), chest = R(0.3 * w - 0.15 * k, 0, 0), head = R(0.2 * w - 0.25 * k, 0, 0),
		frontleg = R(0.9 * w - 0.1 * k, 0, 0), R_frontleg = R(0.9 * w - 0.1 * k, 0, 0),
	}, Vector3.new(0, 0.08 * w - 0.05 * k, 0)
end
-- แมงป่อง: งอหางขึ้นแล้วตวัดแทงไปข้างหน้า ก้ามยกขึ้น
local function tailStrike(t)
	local w, k = phases(t)
	return {
		tail = R(0.35 * w - 0.25 * k, 0, 0), tailstart = R(0.3 * w - 0.35 * k, 0, 0), tail1 = R(0.25 * w - 0.4 * k, 0, 0),
		tail2 = R(0.2 * w - 0.35 * k, 0, 0), frontleg = R(0.4 * w, 0, 0), R_frontleg = R(0.4 * w, 0, 0), chest = R(0.1 * w - 0.1 * k, 0, 0),
	}, Vector3.new(0, 0.03 * w, 0.05 * w - 0.12 * k)
end
-- สายพุ่งชน: ตั้งท่า (ก้มหัว ตะกุยพื้น) -> พุ่ง (โน้มตัว ฝุ่นกระเด็นสองข้าง)
local CHARGE_STATES = {
	Windup = function(t)
		local paw = math.max(0, math.sin(t * 12))
		return { Hips = R(-0.04, 0, 0), chest = R(-0.12, 0, 0), head = R(-0.3, 0, 0), frontleg = R(0.5 * paw, 0, 0), tail = R(0, math.sin(t * 10) * 0.3, 0) },
			Vector3.new(0, -0.04, 0.05)
	end,
	Charge = function(t)
		local sway = math.sin(t * 16)
		return { chest = R(-0.12, sway * 0.06, 0), head = R(-0.25, -sway * 0.06, 0), tail = R(0.2, -sway * 0.3, 0) }, Vector3.new(0, -0.02, -0.04)
	end,
}
ATTACKS.EmberFox = { Pose = pounce, Fx = { { "VFXPack/Anime/Fire-01", 0.9, 0.2 } }, Dust = 0.8, DustKind = "Ash", FxAt = 1.0 }
ATTACKS.MagmaRhino = { Pose = headbutt, Fx = { { "VFXPack/Anime/Fire-02", 1.0, 0.25 } }, Dust = 1.4, DustKind = "Ash", FxAt = 1.0, Ground = true,
	States = CHARGE_STATES, ChargeDust = true }
ATTACKS.LavaSalamander = { Pose = tailStrike, Fx = { { "VFXPack/Anime/Fire-01", 0.8, 0.2 } }, FxAt = 0.9 }
ATTACKS.GaleHawk = { Pose = slam, Fx = { { "IceStomp", 1.6, 0.3 } }, Dust = 1.8, DustKind = "Snow", FxAt = 0.75, Ground = true }
ATTACKS.SkyLynx = { Pose = pounce, Fx = { { "VFXPack/Anime/Shiny-01", 1.4, 0.2 } }, Dust = 0.9, DustKind = "Snow", FxAt = 1.0 }
-- ปู: ท่าโจมตีมาจากไฟล์ (Clips) · ตอนก้ามกระแทก = น้ำแตกกระจาย + ทรายฟุ้ง
ATTACKS.ReefCrab = { Fx = { { "WaterSplash", 1.1, 0.3 }, { "VFXPack/Anime/Shiny-01", 0.9, 0.2 } }, Dust = 1.3, DustKind = "Sand", FxAt = 0.85, Ground = true, HitAt = 0.42 }
ATTACKS.StormRam = { Pose = headbutt, Fx = { { "IceStomp", 1.1, 0.25 } }, Dust = 1.4, DustKind = "Snow", FxAt = 1.0, Ground = true,
	States = CHARGE_STATES, ChargeDust = true }

local clips = {}
local function clipFor(id)
	if clips[id] == nil then
		clips[id] = false
		local folder = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("AnimalClips")
		local mod = folder and folder:FindFirstChild(id)
		if mod then
			local ok, data = pcall(require, mod)
			if ok and data and data.Clips then
				-- หลายท่า (เดิน/ยืน/โจมตี/ตาย) -> Walk เป็นท่าหลัก
				local set = {}
				for name, c in pairs(data.Clips) do
					local bones = {}
					for bname, frames in pairs(c.Bones) do
						local list = {}
						for i, f in ipairs(frames) do
							list[i] = CFrame.new(f[1], f[2], f[3], f[4], f[5], f[6], f[7])
						end
						bones[bname] = list
					end
					set[name] = { Frames = c.Frames, Bones = bones }
				end
				local walk = set.Walk
				clips[id] = { Fps = data.Fps, Frames = walk.Frames, Bones = walk.Bones, Set = set, RootBone = data.RootBone }
			elseif ok and data and data.Bones then
				-- แปลงเป็น CFrame ล่วงหน้า (ไม่ต้องสร้างใหม่ทุกเฟรม)
				local bones = {}
				for name, frames in pairs(data.Bones) do
					local list = {}
					for i, f in ipairs(frames) do
						list[i] = CFrame.new(f[1], f[2], f[3], f[4], f[5], f[6], f[7])
					end
					bones[name] = list
				end
				clips[id] = { Fps = data.Fps, Frames = data.Frames, Bones = bones }
			end
		end
	end
	return clips[id] or nil
end

function ClipAnimator.Has(model)
	return model:GetAttribute("SkinRig") == "Clip" and clipFor(model:GetAttribute("AnimalId") or "") ~= nil
end

function ClipAnimator.Attach(rig)
	local clip = clipFor(rig.Id or "")
	local mesh = rig.Model:FindFirstChild("Skin")
	if not (clip and mesh) then
		return false
	end
	local scale = rig.Model:GetAttribute("SkinScale") or 1
	local tracks = {}
	for _, b in ipairs(mesh:GetDescendants()) do
		if b:IsA("Bone") then
			if clip.Set then
				local any = false
				for _, c in pairs(clip.Set) do
					any = any or c.Bones[b.Name] ~= nil
				end
				if any then
					table.insert(tracks, { Bone = b, Frames = clip.Bones[b.Name] })
				end
			elseif clip.Bones[b.Name] then
				table.insert(tracks, { Bone = b, Frames = clip.Bones[b.Name] })
			end
		end
	end
	-- ทิศท่ายืนของกระดูก (เทียบตัวสัตว์) ไว้แปลงท่าโจมตีจากแกนตัวสัตว์ -> แกนกระดูก
	local root = rig.Root
	local rest = {}
	for _, b in ipairs(mesh:GetDescendants()) do
		if b:IsA("Bone") then
			b.Transform = CFrame.identity
		end
	end
	for _, b in ipairs(mesh:GetDescendants()) do
		if b:IsA("Bone") then
			local q = root.CFrame:ToObjectSpace(b.WorldCFrame).Rotation
			rest[b.Name] = { Q = q, Qi = q:Inverse() }
		end
	end
	for _, tr in ipairs(tracks) do
		tr.Rest = rest[tr.Bone.Name]
	end
	rig.Clip = { Data = clip, Tracks = tracks, T = math.random() * 2, Scale = scale, Rate = 0, Attack = ATTACKS[rig.Id], LastAttack = rig.AttackT, StateW = 0 }
	local A = ATTACKS[rig.Id]
	if A and A.ChargeDust then
		-- ฝุ่นพุ่งออกด้านซ้าย/ขวาจากเท้าตอนวิ่งพุ่ง
		local size = rig.Model:GetExtentsSize()
		local low = -(root.Size.Y / 2) - (rig.Model:FindFirstChildOfClass("Humanoid") and rig.Model:FindFirstChildOfClass("Humanoid").HipHeight or 0) + 0.3
		rig.Clip.Dust = {}
		for _, side in ipairs({ -1, 1 }) do
			local att = Instance.new("Attachment")
			att.CFrame = CFrame.new(side * size.X * 0.45, low, 0) * CFrame.Angles(0, 0, -side * math.rad(70)) -- เอียงพ่นออกด้านข้าง + ขึ้นนิดหน่อย
			att.Parent = root
			local e = dustEmitter(att, math.max(size.X, 2) / 4, A.DustKind)
			e.EmissionDirection = Enum.NormalId.Top
			table.insert(rig.Clip.Dust, e)
		end
	end
	return true
end

-- ---------------------------------------------------------------- หลายท่าจากไฟล์ (ปู: Clips)
local function sample(c, bone, t, fps, loop)
	local list = c and c.Bones[bone]
	if not list then
		return CFrame.identity
	end
	local n = c.Frames
	local f = t * fps
	f = loop and f % math.max(n - 1, 1) or math.min(f, n - 1)
	local i0 = math.floor(f)
	local a = list[i0 + 1] or list[n]
	local b = list[i0 + 2] or (loop and list[1] or list[n])
	return a:Lerp(b, f - i0)
end
local ATTACK_CLIPS = { "AttackL", "AttackR", "AttackL", "AttackR", "Heavy" }
local function animateSet(rig, C, dt, speed)
	local set, fps = C.Data.Set, C.Data.Fps
	local now = os.clock()
	local A = C.Attack
	-- เดิน/ยืน: ผสมตามความเร็วจริง (ขาไม่ไถลพื้น)
	local rate = speed < 0.6 and 0 or math.clamp(speed / 8, 0.6, 2.2)
	C.WalkT = (C.WalkT or 0) + dt * rate
	C.IdleT = (C.IdleT or 0) + dt
	C.WalkW = (C.WalkW or 0) + (math.clamp((speed - 0.6) / 4, 0, 1) - (C.WalkW or 0)) * math.min(1, dt * 6)
	-- โจมตี: สลับก้ามซ้าย/ขวา ทุกครั้งที่ 5 = ทุบหนัก · คำราม = ท่าคำราม
	if rig.AttackT and rig.AttackT > 0 and rig.AttackT ~= C.LastAttack then
		C.LastAttack = rig.AttackT
		local name, sp
		if rig.AttackKind == "Roar" and set.Roar then
			name, sp = "Roar", 1.3
		else
			C.AtkN = (C.AtkN or 0) + 1
			name = ATTACK_CLIPS[(C.AtkN - 1) % #ATTACK_CLIPS + 1]
			sp = name == "Heavy" and 1.7 or 1.45
		end
		if set[name] then
			C.Atk = { Name = name, Start = now, Speed = sp }
			if A and A.Fx then
				task.delay(A.HitAt or 0.3, function()
					local root = rig.Root
					if not (root and root.Parent) then
						return
					end
					local size = rig.Model:GetExtentsSize()
					local pos = root.Position + root.CFrame.LookVector * (math.max(size.X, size.Z) * 0.5 * (A.FxAt or 1))
					if A.Ground then
						local hum = rig.Model:FindFirstChildOfClass("Humanoid")
						pos -= Vector3.new(0, root.Size.Y / 2 + (hum and hum.HipHeight or 0), 0)
					end
					local k = name == "Heavy" and 1.5 or 1
					for _, fx in ipairs(A.Fx) do
						pcall(VFXLib.Play, fx[1], CFrame.new(pos), { Scale = fx[2] * k * math.max(size.X, size.Z) / 9, Duration = fx[3] })
					end
					if A.Dust then
						dustBurst(pos, A.Dust * k * math.max(size.X, size.Z) / 9, A.DustKind)
					end
				end)
			end
		end
	end
	local atk, atkT, atkW = nil, 0, 0
	if C.Atk then
		local c = set[C.Atk.Name]
		atkT = (now - C.Atk.Start) * C.Atk.Speed
		local dur = (c.Frames - 1) / fps
		if atkT >= dur then
			C.Atk = nil
		else
			atk = c
			atkW = math.clamp(math.min(atkT / 0.1, (dur - atkT) / 0.25), 0, 1)
		end
	end
	local dead = rig.DeadT and set.Dead
	local deadT = rig.DeadT and (now - rig.DeadT) or 0
	updateSlope(rig, C, dt)
	local look = rig.Root.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	C.VisYaw = C.VisYaw or yaw
	local diff = (yaw - C.VisYaw + math.pi) % (2 * math.pi) - math.pi
	C.VisYaw += diff * math.min(1, dt * 10)
	local lag = math.clamp(((C.VisYaw - yaw + math.pi) % (2 * math.pi)) - math.pi, -0.8, 0.8)
	C.VisYaw = yaw + lag
	local slopeRot = R(0, lag, 0) * R(C.Pitch, 0, C.Roll)
	local slopeLift = Vector3.new(0, C.Lift, 0)
	local rootBone = C.Data.RootBone or "Hips"
	for _, tr in ipairs(C.Tracks) do
		local name = tr.Bone.Name
		local cf
		if dead then
			cf = sample(dead, name, deadT, fps, false)
		else
			cf = sample(set.Idle, name, C.IdleT, fps, true):Lerp(sample(set.Walk, name, C.WalkT, fps, true), C.WalkW)
			if atk then
				cf = cf:Lerp(sample(atk, name, atkT, fps, false), atkW)
			end
		end
		local tf = cf.Rotation + cf.Position * C.Scale
		local rs = tr.Rest
		if rs and name == rootBone then
			tf = CFrame.new(rs.Qi:VectorToWorldSpace(slopeLift)) * (rs.Qi * slopeRot * rs.Q) * tf
		end
		tr.Bone.Transform = tf
	end
end

function ClipAnimator.HasDeath(rig)
	return rig.Clip ~= nil and rig.Clip.Data.Set ~= nil and rig.Clip.Data.Set.Dead ~= nil
end

-- เรียกทุกเฟรม: speed = ความเร็วเดินแนวราบ (studs/วินาที)
function ClipAnimator.Animate(rig, dt, speed)
	local C = rig.Clip
	if not C then
		return
	end
	if C.Data.Set then
		animateSet(rig, C, dt, speed)
		return
	end
	local data = C.Data
	-- ยืน = 0.15 เท่า (ขยับเบาๆ ไม่แข็ง) · เดิน/วิ่ง = ตามความเร็ว (ขาไม่ไถลพื้น)
	local target = speed < 0.6 and 0.15 or math.clamp(speed / (5 * C.Scale), 0.5, 2.2)
	C.Rate += (target - C.Rate) * math.min(1, dt * 6)
	C.T = (C.T + dt * C.Rate) % ((data.Frames - 1) / data.Fps)
	local f = C.T * data.Fps
	local i0 = math.floor(f)
	local u = f - i0
	local n = data.Frames
	-- ท่าโจมตี: เริ่มเมื่อเซิร์ฟเวอร์ส่ง AttackAt (rig.AttackT) · ซ้อนบนท่าเดิน
	local pose, shift
	local A = C.Attack
	local state = rig.Model:GetAttribute("State")
	local statePose = A and A.States and A.States[state]
	if A and rig.AttackT and rig.AttackT > 0 and not (statePose and rig.AttackKind == "Roar") then
		if rig.AttackT ~= C.LastAttack then
			C.LastAttack = rig.AttackT
			task.delay(0.28, function()
				local root = rig.Root
				if not (root and root.Parent) then
					return
				end
				local size = rig.Model:GetExtentsSize()
				local reach = root.CFrame.LookVector * (math.max(size.X, size.Z) * 0.5 * (A.FxAt or 1))
				local pos = root.Position + reach
				if A.Ground then
					pos -= Vector3.new(0, root.Size.Y / 2 + (rig.Model:FindFirstChildOfClass("Humanoid") and rig.Model:FindFirstChildOfClass("Humanoid").HipHeight or 0), 0)
				end
				for _, fx in ipairs(A.Fx) do
					pcall(VFXLib.Play, fx[1], CFrame.new(pos), { Scale = fx[2] * C.Scale / 3, Duration = fx[3] })
				end
				if A.Dust then
					dustBurst(pos, A.Dust * C.Scale / 3, A.DustKind)
				end
			end)
		end
		local at = os.clock() - rig.AttackT
		if at < ATTACK_LEN then
			pose, shift = A.Pose(at)
		end
	end
	-- ท่าตามสถานะ (ตั้งท่า/พุ่ง) ผสมเข้า-ออกนุ่มๆ
	C.StateW += ((statePose and 1 or 0) - C.StateW) * math.min(1, dt * 8)
	if statePose then
		C.StateT = (C.StateName == state) and (C.StateT + dt) or 0
		C.StateName = state
	end
	if C.StateW > 0.01 and not pose and C.StateName then
		local f2 = A.States[C.StateName]
		local sp, ss = f2(C.StateT or 0)
		local wgt = C.StateW
		pose = {}
		for k, v in pairs(sp) do
			pose[k] = CFrame.identity:Lerp(v, wgt)
		end
		shift = ss * wgt
	end
	if C.Dust then
		local on = state == "Charge" and speed > 4
		for _, e in ipairs(C.Dust) do
			e.Rate = on and 45 or 0
		end
	end
	updateSlope(rig, C, dt)
	-- หันตัวนุ่ม: ตัวจริงหันขวับได้ แต่ภาพค่อยๆ หมุนตาม (หน่วงไม่เกิน ~45°)
	local look = rig.Root.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	C.VisYaw = C.VisYaw or yaw
	local diff = (yaw - C.VisYaw + math.pi) % (2 * math.pi) - math.pi
	C.VisYaw += diff * math.min(1, dt * 10)
	local lag = math.clamp(((C.VisYaw - yaw + math.pi) % (2 * math.pi)) - math.pi, -0.8, 0.8)
	C.VisYaw = yaw + lag
	local slopeRot = R(0, lag, 0) * R(C.Pitch, 0, C.Roll)
	local slopeLift = Vector3.new(0, C.Lift, 0)
	for _, tr in ipairs(C.Tracks) do
		local a = tr.Frames[i0 + 1] or tr.Frames[n]
		local b = tr.Frames[i0 + 2] or tr.Frames[1]
		local cf = a:Lerp(b, u)
		-- ตำแหน่งในท่าเป็นค่าที่ขนาดตอน Import -> คูณตามที่เกมขยายโมเดล
		local tf = cf.Rotation + cf.Position * C.Scale
		local rs = tr.Rest
		if pose and rs then
			local extra = pose[tr.Bone.Name]
			if extra then
				tf = rs.Qi * extra * rs.Q * tf
			end
			if shift and tr.Bone.Name == "Hips" then
				tf = CFrame.new(rs.Qi:VectorToWorldSpace(shift * C.Scale)) * tf
			end
		end
		if rs and tr.Bone.Name == "Hips" then
			-- เอียงทั้งตัวตามพื้น + ยกพ้นเนิน (ซ้อนทับท่าเดิน/โจมตี)
			tf = CFrame.new(rs.Qi:VectorToWorldSpace(slopeLift)) * (rs.Qi * slopeRot * rs.Q) * tf
		end
		tr.Bone.Transform = tf
	end
end

return ClipAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000076"><Properties><string name="Name">CombatClient</string><ProtectedString name="Source"><![CDATA[--[[
	CombatClient — กดตี/ยิง, วิ่ง (สตามิน่า), และเอฟเฟกต์การต่อสู้ทั้งหมดบนจอ
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Classes = require(Shared.Classes)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)

local CombatClient = {}
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- เสียงในโลก (ProSoundEffects ใช้ได้ทุกเกม) · หลายไฟล์ = สุ่มทีละครั้ง
local function ids(...)
	local t = {}
	for _, n in ipairs({ ... }) do
		table.insert(t, "rbxassetid://" .. n)
	end
	return t
end
local SOUND = {
	Boom = ids(9125404320),
	Splash = ids(9120584388),
	Hurt = ids(9113502506, 9113568548),
	Land = ids(9113225735),
	GetUp = ids(17208327798),
	Slash = ids(9120972444, 9120972457, 9120972323), -- ฟันลม
	Flesh = ids(9113502506, 9113568548), -- โดนตัวสัตว์
	Chop = ids(9120806888, 9120807060, 9120807255), -- ขวานเข้าเนื้อไม้
	Mine = ids(9114084950, 9118597103, 9118598240), -- ทุบหิน/แร่
	Crystal = ids(9116394545, 9116395089),
	Bush = ids(17208405682),
	TreeFall = ids(9113225734, 9113225979),
	Build = ids(9114753310, 9114753327),
	Craft = ids(9114753327),
	Refuel = ids(9114439997, 9114439868),
	Break = ids(9113974103),
	WoodHit = ids(9113225985),
}

function CombatClient.Sound(name, at, volume, pitch)
	local list = SOUND[name]
	if not list then
		return
	end
	local id = list[math.random(1, #list)]
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	s.RollOffMaxDistance = 300
	if typeof(at) == "Vector3" then
		local att = Instance.new("Attachment")
		att.WorldPosition = at
		att.Parent = Workspace.Terrain
		s.Parent = att
		Debris:AddItem(att, 6)
	else
		s.Parent = Workspace.CurrentCamera
		Debris:AddItem(s, 6)
	end
	s:Play()
end

---------------------------------------------------------------- จอสั่น
local shake = 0
CombatClient.ShakeEnabled = true -- ตั้งค่า: ปิดจอสั่นได้
function CombatClient.Shake(power, time)
	if not CombatClient.ShakeEnabled then
		return
	end
	shake = math.max(shake, power)
	task.delay(time or 0.3, function()
		shake = math.max(0, shake - power)
	end)
end

---------------------------------------------------------------- ตัวช่วย FX
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = Workspace.CurrentCamera

local function fxPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = fxFolder
	return p
end

local function ring(pos, radius, color, time, thickness)
	local r = fxPart({
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(thickness or 0.6, 2, 2), Color = color, Transparency = 0.1,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2),
	})
	TweenService:Create(r, TweenInfo.new(time or 0.5, Enum.EasingStyle.Quad), { Size = Vector3.new(thickness or 0.6, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(r, (time or 0.5) + 0.1)
end

local function burst(pos, color, count, speed, size, texture)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture or "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1.1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new(size or 0.6, 0)
	e.Color = ColorSequence.new(color)
	e.Drag = 3
	e.Acceleration = Vector3.new(0, -12, 0)
	e.Parent = a
	e:Emit(count)
	Debris:AddItem(a, 2)
end

local function smoke(pos, color, count, size)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = 0
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(4, 10)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.4), NumberSequenceKeypoint.new(1, size) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(color)
	e.Drag = 2
	e.Parent = a
	e:Emit(count)
	Debris:AddItem(a, 3)
end

local function flashLight(pos, color, range, time)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Workspace.Terrain
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = 4
	l.Parent = a
	TweenService:Create(l, TweenInfo.new(time or 0.4), { Brightness = 0 }):Play()
	Debris:AddItem(a, (time or 0.4) + 0.1)
end

local function tracer(from, to, color, width, time)
	local dist = (to - from).Magnitude
	local p = fxPart({ Size = Vector3.new(width or 0.25, width or 0.25, dist), Color = color, CFrame = CFrame.lookAt((from + to) / 2, to) })
	TweenService:Create(p, TweenInfo.new(time or 0.25), { Transparency = 1, Size = Vector3.new(0.05, 0.05, dist) }):Play()
	Debris:AddItem(p, (time or 0.25) + 0.05)
end

local function floatText(pos, text, color, size, rise)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 220
	bb.Parent = a
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color
	t.Font = Enum.Font.GothamBlack
	t.TextSize = size or 24
	t.TextStrokeTransparency = 0.2
	t.Parent = bb
	TweenService:Create(bb, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { StudsOffsetWorldSpace = Vector3.new(math.random(-10, 10) / 10, rise or 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(a, 1.1)
end
CombatClient.FloatText = floatText

local function hitFlash(model)
	if not (model and model.Parent) then
		return
	end
	local h = model:FindFirstChild("HitFlash")
	if not h then
		h = Instance.new("Highlight")
		h.Name = "HitFlash"
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.OutlineTransparency = 1
		h.FillColor = Color3.new(1, 1, 1)
		h.Parent = model
	end
	h.Enabled = true
	h.FillTransparency = 0.2
	TweenService:Create(h, TweenInfo.new(0.18), { FillTransparency = 1 }):Play()
end

-- ขอบจอแดงตอนเจ็บ
local vignette
local function hurtVignette(power)
	if not vignette then
		local gui = UIKit.Screen("HurtFX", 30, true)
		vignette = Instance.new("CanvasGroup")
		vignette.Size = UDim2.fromScale(1, 1)
		vignette.BackgroundTransparency = 1
		vignette.GroupTransparency = 1
		vignette.Parent = gui
		-- ขอบแดง 2 ชั้น (แนวนอน + แนวตั้ง)
		for _, rot in ipairs({ 0, 90 }) do
			local f = Instance.new("Frame")
			f.Size = UDim2.fromScale(1, 1)
			f.BorderSizePixel = 0
			f.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
			f.Parent = vignette
			local grad = Instance.new("UIGradient")
			grad.Rotation = rot
			grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.22, 1), NumberSequenceKeypoint.new(0.78, 1), NumberSequenceKeypoint.new(1, 0.1) })
			grad.Parent = f
		end
	end
	vignette.GroupTransparency = math.clamp(1 - power, 0.25, 0.9)
	TweenService:Create(vignette, TweenInfo.new(0.7), { GroupTransparency = 1 }):Play()
end

-- เลือดต่ำจริง (< 25%): ขอบจอแดงเต้นช้าๆ ค้างไว้จนเลือดกลับมา (ไม่ขึ้นตอนเลือดยังเยอะ)
local lowVignette
RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local frac = hum and hum.Health > 0 and hum.Health / math.max(hum.MaxHealth, 1) or 1
	local low = frac < 0.25 and player:GetAttribute("InRun") == true and not player:GetAttribute("Dead")
	if not low then
		if lowVignette then
			lowVignette.GroupTransparency = 1
		end
		return
	end
	if not lowVignette then
		local gui = UIKit.Screen("LowHealthFX", 29, true)
		lowVignette = Instance.new("CanvasGroup")
		lowVignette.Size = UDim2.fromScale(1, 1)
		lowVignette.BackgroundTransparency = 1
		lowVignette.Parent = gui
		for _, rot in ipairs({ 0, 90 }) do
			local f = Instance.new("Frame")
			f.Size = UDim2.fromScale(1, 1)
			f.BorderSizePixel = 0
			f.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
			f.Parent = lowVignette
			local grad = Instance.new("UIGradient")
			grad.Rotation = rot
			grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.18, 1), NumberSequenceKeypoint.new(0.82, 1), NumberSequenceKeypoint.new(1, 0.2) })
			grad.Parent = f
		end
	end
	-- ยิ่งเลือดน้อยยิ่งเข้ม · เต้นตามจังหวะหัวใจ
	local depth = 1 - frac / 0.25
	local beat = 0.5 + 0.5 * math.sin(os.clock() * (4 + depth * 4))
	lowVignette.GroupTransparency = 0.88 - depth * 0.3 - beat * 0.12
end)

---------------------------------------------------------------- ตี / ยิง
local lastSwing = 0
local spearThrust
local function aimDirection()
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { char }
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 400, params)
	local target = res and res.Position or (ray.Origin + ray.Direction * 400)
	if head then
		return (target - head.Position).Unit
	end
	return ray.Direction
end

-- แทงหอก: ดันไหล่ขวาไปข้างหน้าแล้วดึงกลับ (ปรับ C0 ของข้อไหล่ ทับบนท่าถือของ)
local thrusting = false
spearThrust = function(char)
	local m = char and (char:FindFirstChild("RightShoulder", true) or char:FindFirstChild("Right Shoulder", true))
	if not m or not m:IsA("Motor6D") or thrusting then
		return
	end
	thrusting = true
	local base = m.C0
	local back = base * CFrame.new(0, 0.1, 0.5) * CFrame.Angles(math.rad(10), 0, 0)
	local out = base * CFrame.new(0, -0.1, -1.6) * CFrame.Angles(math.rad(-8), 0, 0)
	local t1 = TweenService:Create(m, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = back })
	local t2 = TweenService:Create(m, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = out })
	local t3 = TweenService:Create(m, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { C0 = base })
	t1:Play()
	t1.Completed:Wait()
	t2:Play()
	t2.Completed:Wait()
	task.wait(0.06)
	t3:Play()
	t3.Completed:Wait()
	m.C0 = base
	thrusting = false
end

local function onActivate(tool, noAuto)
	local id = tool:GetAttribute("ItemId")
	local spec = Items.Tools[id]
	if not spec then
		return
	end
	-- สลับเครื่องมืออัตโนมัติ (AutoTool): เล็งต้นไม้/หิน/สัตว์แต่ถือของไม่เหมาะ -> หยิบของที่ดีกว่าแล้วตีด้วยอันนั้น
	if not noAuto and CombatClient.AutoTool and CombatClient.AutoTool.Before(tool, function(t)
		onActivate(t, true)
	end) then
		return
	end
	local now = os.clock()
	if now - lastSwing < spec.Cooldown then
		return
	end
	lastSwing = now
	Remotes.Get("Attack"):FireServer(aimDirection())
	if spec.Kind == "Spear" then
		-- หอก/ตรีศูล: แทงไปข้างหน้า (ท่า Lunge ของ Roblox ยกขา ไม่เหมือนแทง)
		task.spawn(spearThrust, player.Character)
	elseif spec.Kind ~= "Bow" then
		-- ท่าฟันของ Roblox (Animate อ่าน toolanim) · ธนูยิงอย่างเดียว ไม่ต้องเหวี่ยง
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
	end
	CombatClient.Sound("Slash", nil, 0.35, 0.9 + math.random() * 0.2)
end

-- กดค้าง = ตีต่อเนื่อง (ตามคูลดาวน์ของอาวุธ) จนกว่าจะปล่อยปุ่ม/นิ้ว หรือเก็บของออกจากมือ
local heldTool = nil
local RELEASE = { [Enum.UserInputType.MouseButton1] = true, [Enum.UserInputType.Touch] = true }
UserInputService.InputEnded:Connect(function(input)
	if RELEASE[input.UserInputType] or input.KeyCode == Enum.KeyCode.ButtonR2 then
		heldTool = nil
	end
end)

-- ตีด้วยเครื่องมือนี้ทันที (ไม่ผ่าน AutoTool) — ใช้ตอนสลับให้อัตโนมัติ
function CombatClient.Swing(tool)
	onActivate(tool, true)
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		heldTool = tool
	end
end

local function hookTool(c)
	c:SetAttribute("Hooked", true)
	c.Activated:Connect(function()
		heldTool = c
		onActivate(c)
	end)
	c.Deactivated:Connect(function()
		if heldTool == c then
			heldTool = nil
		end
	end)
	c.Unequipped:Connect(function()
		if heldTool == c then
			heldTool = nil
		end
	end)
end

local function hookCharacter(char)
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") and not c:GetAttribute("Hooked") then
			hookTool(c)
		end
	end)
end

---------------------------------------------------------------- วิ่ง / สตามิน่า
local stamina = 100
local sprinting = false
function CombatClient.SetSprint(on)
	sprinting = on == true
end
function CombatClient.IsSprinting()
	return sprinting
end
local function sprintAction(_, inputState)
	sprinting = inputState == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Pass
end

---------------------------------------------------------------- FX จาก server
local Handlers = {}

Handlers.Hit = function(d)
	hitFlash(d.Model)
	local color = d.Crit and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(255, 255, 255)
	local text = tostring(d.Amount)
	if d.Crit then
		text = text .. "!"
	end
	floatText(d.Position + Vector3.new(0, 3, 0), text, color, d.Crit and 30 or 22)
	if d.Mult and d.Mult > 1.1 then
		floatText(d.Position + Vector3.new(0, 5, 0), "แพ้ทางธาตุ!", Color3.fromRGB(120, 255, 140), 18, 6)
	elseif d.Mult and d.Mult < 0.9 then
		floatText(d.Position + Vector3.new(0, 5, 0), "ต้านทาน", Color3.fromRGB(170, 170, 180), 16, 6)
	end
	burst(d.Position, Color3.fromRGB(255, 230, 200), 8, 18, 0.4)
	CombatClient.Sound("Flesh", d.Position, 0.5, 0.9 + math.random() * 0.2)
	local char = player.Character
	if char and (char:GetPivot().Position - d.Position).Magnitude < 30 then
		CombatClient.Shake(0.15, 0.12)
	end
end

-- ดาเมจต่อเนื่อง (หิว/ไฟไหม้/ลาวา) มาทีละนิดทุกเฟรม -> ห้ามจอแดง/สั่นทุกครั้ง (เคยกะพริบแดงทั้งที่เลือดแทบไม่ลด)
--   สะสมไว้ ลดจริงครบ 8 ค่อยกะพริบเบาๆ ทีเดียว · ดาเมจโดนตีจริง (ก้อนเดียว >= 3) = จอแดงตามแรง
local TICK_SOURCES = { Hunger = true, Burn = true, Lava = true }
local tickDamage, lastTickFlash = 0, 0
Handlers.Hurt = function(d)
	local amount = tonumber(d.Amount) or 0
	if TICK_SOURCES[d.Source] or amount < 3 then
		tickDamage += amount
		if tickDamage >= 8 and os.clock() - lastTickFlash > 1.5 then
			tickDamage = 0
			lastTickFlash = os.clock()
			hurtVignette(0.22)
		end
		return
	end
	hurtVignette(math.clamp(amount / 40, 0.2, 0.7))
	CombatClient.Shake(math.clamp(d.Amount / 60, 0.15, 0.8), 0.25)
	if d.Amount >= 8 then
		CombatClient.Sound("Hurt", nil, 0.4)
	end
end

Handlers.Knockback = function(d)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = d.Velocity
	end
end
Handlers.Launch = Handlers.Knockback

Handlers.Pull = function(d)
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or os.clock() - t0 > (d.Time or 2) then
			conn:Disconnect()
			return
		end
		local dir = (d.Center - root.Position) * Vector3.new(1, 0, 1)
		-- หยุดดูดที่ขอบตัวบอส (เดิมดูดเข้ากลางตัว -> ชนกล่องชนยักษ์ของเยติแล้วฟิสิกส์ดีดผู้เล่นกระเด็นไกลเป็นพันสตั๊ด)
		local stop = d.Stop or 3
		if dir.Magnitude > stop then
			local v = root.AssemblyLinearVelocity
			local k = math.clamp((dir.Magnitude - stop) / 10, 0.2, 1)
			root.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 30), 0) + dir.Unit * 34 * k + dir.Unit:Cross(Vector3.new(0, 1, 0)) * 22 * k
		end
	end)
end

Handlers.Arrow = function(d)
	local color = d.Element == "Air" and Color3.fromRGB(200, 230, 255) or Color3.fromRGB(255, 236, 190)
	tracer(d.From, d.To, color, d.Element and 0.4 or 0.18, 0.35)
	burst(d.To, color, 6, 10, 0.3)
end

Handlers.Bolt = function(d)
	tracer(d.From, d.To, Color3.fromRGB(230, 220, 200), 0.35, 0.3)
end

Handlers.Slam = function(d)
	local color = UIKit.Colors.Element[d.Element] or Color3.fromRGB(255, 255, 255)
	ring(d.Position - Vector3.new(0, 2, 0), d.Radius or 10, color, 0.45, 1)
	smoke(d.Position, Color3.fromRGB(150, 140, 120), 12, 6)
	CombatClient.Shake(0.4, 0.2)
end

local function bigImpact(d, smokeColor)
	local color = d.Color or Color3.fromRGB(255, 140, 50)
	local r = d.Radius or 8
	ring(d.Position, r, color, 0.55, 1.4)
	burst(d.Position + Vector3.new(0, 2, 0), color, 30, 40, 1.2)
	smoke(d.Position, smokeColor or Color3.fromRGB(70, 60, 60), 14, r * 0.8)
	flashLight(d.Position + Vector3.new(0, 4, 0), color, r * 4, 0.5)
	local char = player.Character
	local dist = char and (char:GetPivot().Position - d.Position).Magnitude or 999
	if dist < 120 then
		CombatClient.Shake(math.clamp((120 - dist) / 120, 0.1, 1) * 0.9, 0.35)
	end
end

Handlers.Explosion = function(d)
	bigImpact(d)
	CombatClient.Sound("Boom", d.Position, 0.7)
end
Handlers.Shockwave = function(d)
	bigImpact(d, Color3.fromRGB(110, 100, 90))
	ring(d.Position, (d.Radius or 10) * 1.3, Color3.fromRGB(255, 255, 255), 0.8, 0.4)
	CombatClient.Sound("Boom", d.Position, 0.9, 0.7)
end
Handlers.Splash = function(d)
	bigImpact(d, Color3.fromRGB(200, 230, 255))
	CombatClient.Sound("Splash", d.Position, 0.9)
end
Handlers.Geyser = function(d)
	local col = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 8, 8), Color = Color3.fromRGB(120, 220, 255), Transparency = 0.3, Material = Enum.Material.Glass, CFrame = CFrame.new(d.Position) * CFrame.Angles(0, 0, math.pi / 2) })
	TweenService:Create(col, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = Vector3.new(50, 12, 12), CFrame = CFrame.new(d.Position + Vector3.new(0, 25, 0)) * CFrame.Angles(0, 0, math.pi / 2), Transparency = 1 }):Play()
	Debris:AddItem(col, 0.6)
	Handlers.Splash(d)
end
Handlers.Lightning = function(d)
	local from = d.Position + Vector3.new(math.random(-10, 10), 160, math.random(-10, 10))
	local prev = from
	for i = 1, 8 do
		local t = i / 8
		local p = from:Lerp(d.Position, t) + (i < 8 and Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)) or Vector3.zero)
		tracer(prev, p, Color3.fromRGB(200, 225, 255), 1.2, 0.35)
		prev = p
	end
	flashLight(d.Position + Vector3.new(0, 10, 0), Color3.fromRGB(190, 220, 255), 120, 0.4)
	local cc = Lighting:FindFirstChild("ASGrade")
	if cc then
		local b = cc.Brightness
		cc.Brightness = b + 0.4
		task.delay(0.08, function()
			cc.Brightness = b
		end)
	end
	bigImpact(d, Color3.fromRGB(120, 130, 160))
	CombatClient.Sound("Boom", d.Position, 1, 1.3)
end
Handlers.Cyclone = function(d)
	for i = 1, 4 do
		task.delay(i * 0.25, function()
			ring(d.Position, (d.Radius or 40) * (1 - i * 0.18), Color3.fromRGB(220, 235, 255), 0.6, 0.5)
		end)
	end
	smoke(d.Position, Color3.fromRGB(220, 230, 240), 30, 14)
end
Handlers.Gust = function(d)
	ring(d.Position, d.Radius or 40, Color3.fromRGB(220, 235, 255), 0.6, 0.6)
end

Handlers.Death = function(d)
	local color = UIKit.Colors.Element[d.Element] or Color3.fromRGB(230, 220, 200)
	burst(d.Position, color, d.Boss and 80 or 20, d.Boss and 60 or 20, d.Boss and 2 or 0.7)
	if d.Boss then
		smoke(d.Position, Color3.fromRGB(40, 36, 40), 40, 30)
		CombatClient.Shake(1, 0.8)
		CombatClient.Sound("Boom", d.Position, 1, 0.5)
	end
end
Handlers.Vanish = function(d)
	smoke(d.Position, Color3.fromRGB(30, 30, 36), 14, 6)
end
Handlers.Immune = function(d)
	floatText(d.Position, "ฆ่าไม่ตาย... ใช้แสงไฟไล่!", Color3.fromRGB(200, 200, 220), 20, 5)
end
Handlers.StalkerStare = function(d)
	hurtVignette(0.45)
	CombatClient.Shake(0.2, 2)
	local hb = Instance.new("Sound")
	hb.SoundId = SOUND.Land
	hb.Volume = 1
	hb.PlaybackSpeed = 0.4
	hb.Parent = Workspace.CurrentCamera
	for i = 0, 3 do
		task.delay(i * 0.55, function()
			hb:Play()
		end)
	end
	Debris:AddItem(hb, 3)
end
Handlers.BossCast = function(d)
	local model = d.Model
	local root = model and model:FindFirstChild("HumanoidRootPart")
	if root then
		floatText(root.Position + Vector3.new(0, model:GetExtentsSize().Y * 0.6, 0), d.Text, Color3.fromRGB(255, 120, 100), 34, 6)
	end
end
Handlers.NodeHit = function(d)
	local colors = { Tree = Color3.fromRGB(150, 110, 70), Rock = Color3.fromRGB(170, 170, 170), Crystal = Color3.fromRGB(200, 240, 255), Bush = Color3.fromRGB(110, 200, 90) }
	burst(d.Position + Vector3.new(0, 3, 0), colors[d.Kind] or Color3.new(1, 1, 1), 8, 14, 0.5, "rbxasset://textures/particles/smoke_main.dds")
	local snd = ({ Tree = "Chop", Rock = "Mine", Crystal = "Crystal", Bush = "Bush" })[d.Kind]
	if snd then
		CombatClient.Sound(snd, d.Position, 0.55, 0.92 + math.random() * 0.16)
	end
	local node = d.Node
	if node and node.Parent then
		local cf = node:GetPivot()
		node:PivotTo(cf * CFrame.Angles(0, 0, math.rad(2)))
		task.delay(0.06, function()
			if node.Parent then
				node:PivotTo(cf)
			end
		end)
	end
end
Handlers.TreeFall = function(d)
	task.delay(1.3, function()
		smoke(d.Position, Color3.fromRGB(160, 140, 110), 20, 10)
		CombatClient.Shake(0.25, 0.25)
		CombatClient.Sound("TreeFall", d.Position, 0.8, 0.7)
	end)
end
Handlers.Shatter = function(d)
	burst(d.Position + Vector3.new(0, 2, 0), Color3.fromRGB(200, 200, 200), 18, 24, 0.7, "rbxasset://textures/particles/smoke_main.dds")
	CombatClient.Sound("Break", d.Position, 0.7)
end
Handlers.Build = function(d)
	smoke(d.Position, Color3.fromRGB(180, 160, 130), 12, 5)
	ring(d.Position, 8, Color3.fromRGB(255, 220, 140), 0.4, 0.4)
	CombatClient.Sound("Build", d.Position, 0.6)
end
Handlers.Craft = function(d)
	burst(d.Position + Vector3.new(0, 4, 0), Color3.fromRGB(255, 220, 140), 16, 12, 0.4)
	CombatClient.Sound("Craft", d.Position, 0.55)
end
Handlers.Refuel = function(d)
	burst(d.Position + Vector3.new(0, 4, 0), Color3.fromRGB(255, 160, 60), 30, 22, 0.6)
	flashLight(d.Position + Vector3.new(0, 4, 0), Color3.fromRGB(255, 170, 80), 50, 0.8)
	CombatClient.Sound("Refuel", d.Position, 0.6)
end
Handlers.FireHit = function(d)
	burst(d.Position + Vector3.new(0, 3, 0), Color3.fromRGB(255, 120, 40), 6, 10, 0.4)
end
Handlers.StructureHit = function(d)
	local s = d.Structure
	if not (s and s.Parent) then
		return
	end
	local bb = s:FindFirstChild("HPBar")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "HPBar"
		bb.Size = UDim2.fromOffset(90, 8)
		bb.StudsOffsetWorldSpace = Vector3.new(0, s:GetExtentsSize().Y + 2, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 140
		bb.Adornee = s.PrimaryPart or s:FindFirstChildWhichIsA("BasePart")
		bb.Parent = s
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		back.BorderSizePixel = 0
		back.Parent = bb
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(230, 170, 60)
		fill.BorderSizePixel = 0
		fill.Parent = back
	end
	local frac = math.clamp((s:GetAttribute("Health") or 0) / math.max(s:GetAttribute("MaxHealth") or 1, 1), 0, 1)
	bb.Frame.Fill.Size = UDim2.fromScale(frac, 1)
	bb.Enabled = true
	task.delay(4, function()
		if bb.Parent then
			bb.Enabled = false
		end
	end)
end

-- เครื่องย่อย: ลูกกลิ้งหมุน เครื่องสั่น ขี้เลื่อย/ประกายไฟ/ฝุ่นหินพุ่ง + ตัวเลขของที่ได้
local grindState = {}
Handlers.Grind = function(d)
	local bench = d.Bench
	local hopper = bench and bench:FindFirstChild("Hopper")
	if not hopper then
		return
	end
	local st = grindState[bench]
	if not st then
		st = { Until = 0 }
		grindState[bench] = st
	end
	local already = os.clock() < st.Until
	st.Until = os.clock() + 1.6
	-- อนุภาคตามชนิดของ
	local hasWood, hasHard = false, false
	local lines = {}
	for id, n in pairs(d.Items or {}) do
		if id == "Wood" or id == "Fiber" then
			hasWood = true
		else
			hasHard = true
		end
		table.insert(lines, "+" .. n .. " " .. Items.DisplayName(id))
	end
	local outPart = bench:FindFirstChild("GrindOut")
	local top = outPart and outPart.Position or (hopper.Position + Vector3.new(0, hopper.Size.Y * 0.4, 0))
	if hasWood then
		burst(top, Color3.fromRGB(214, 170, 110), 30, 18, 0.5, "rbxasset://textures/particles/smoke_main.dds")
		burst(top, Color3.fromRGB(170, 120, 70), 20, 22, 0.35)
	end
	if hasHard then
		burst(top, Color3.fromRGB(255, 200, 110), 28, 26, 0.3)
		smoke(top, Color3.fromRGB(150, 145, 140), 10, 4)
	end
	-- ป้ายตัวเลขลอยขึ้น
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(220, 60)
	bb.StudsOffsetWorldSpace = Vector3.new(0, hopper.Size.Y * 0.9, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = hopper
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(150, 255, 160)
	t.TextStrokeTransparency = 0.3
	t.Text = "📦 " .. table.concat(lines, "  ")
	t.Parent = bb
	bb.Parent = hopper
	TweenService:Create(bb, TweenInfo.new(1.6), { StudsOffsetWorldSpace = Vector3.new(0, hopper.Size.Y + 6, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(bb, 1.7)
	if already then
		return
	end
	-- ลูกกลิ้งหมุน + เครื่องสั่น (ฝั่งนี้เท่านั้น)
	local rollers = {}
	for _, r in ipairs(bench:GetChildren()) do
		if r:IsA("BasePart") and r:GetAttribute("Spin") then
			table.insert(rollers, { r, r.CFrame, r:GetAttribute("Spin") })
		end
	end
	local model = bench:FindFirstChild("CrafterModel")
	local base = model and model:GetPivot()
	task.spawn(function()
		local a = 0
		while os.clock() < st.Until and bench.Parent do
			local dt = RunService.RenderStepped:Wait()
			a += dt * 14
			for _, e in ipairs(rollers) do
				e[1].CFrame = e[2] * CFrame.Angles(a * e[3], 0, 0)
			end
			if model and base then
				model:PivotTo(base * CFrame.new(math.sin(a * 3.1) * 0.06, math.abs(math.sin(a * 2.3)) * 0.05, math.cos(a * 2.7) * 0.06))
			end
		end
		for _, e in ipairs(rollers) do
			e[1].CFrame = e[2]
		end
		if model and base then
			model:PivotTo(base)
		end
	end)
	CombatClient.Sound("Land", hopper.Position, 0.6, 0.8)
end

-- เอฟเฟกต์จากคลัง VFX (แพ็ก Creator Store) สำหรับตี/ตัด/ทุบ/คราฟต์
local VFXLib = require(script.Parent:WaitForChild("VFXLib"))
local function vfx(name, pos, opts)
	pcall(VFXLib.Play, name, CFrame.new(pos), opts or {})
end
local VFX_NAMES = {
	RockRing = "VFXPack/vfx pack/f", Crack = "VFXPack/Anime/Crack-01", Shiny = "VFXPack/Anime/Shiny-01", Charge = "VFXPack/Anime/Charge-01",
	ShieldBreak = "VFXPack/Anime/Shield-Break-01", Fire = "VFXPack/Anime/Fire-02", Punch = "VFXPack/Anime/Blood-Punch-01", Ice = "IceStomp",
}

-- ระเบิดของกระสุนที่มีเอฟเฟกต์เฉพาะ (คทาเพลิง: Store "ExplosionCharge") แทนลูกระเบิดพื้นฐาน
local baseExplosion = Handlers.Explosion
Handlers.Explosion = function(d)
	if d.Fx then
		vfx(d.Fx, d.Position, { Scale = d.FxScale or 0.3, Duration = 0.35, Burst = 1 })
		CombatClient.Sound("Boom", d.Position, 0.6, 1.15)
		return
	end
	baseExplosion(d)
end

-- เอฟเฟกต์สกิลบอส (BossFX)
local BossFX = require(script.Parent:WaitForChild("BossFX"))
BossFX.Init(function(power, time)
	CombatClient.Shake(power, time)
end)
for k, fn in pairs(BossFX.Handlers) do
	Handlers[k] = fn
end
local function wrap(name, extra)
	local base = Handlers[name]
	Handlers[name] = function(d)
		if base then
			base(d)
		end
		pcall(extra, d)
	end
end
wrap("Hit", function(d)
	vfx(VFX_NAMES.Punch, d.Position, { Scale = d.Crit and 1.6 or 1, Duration = 0.15 })
end)
wrap("NodeHit", function(d)
	local p = d.Position + Vector3.new(0, 3, 0)
	if d.Kind == "Rock" then
		vfx(VFX_NAMES.Crack, p, { Scale = 1.2, Duration = 0.15 })
	elseif d.Kind == "Crystal" then
		vfx(VFX_NAMES.Shiny, p, { Scale = 1.4, Duration = 0.2 })
	elseif d.Kind == "Tree" then
		burst(p + Vector3.new(0, 3, 0), Color3.fromRGB(90, 150, 70), 10, 12, 0.5)
	end
end)
wrap("TreeFall", function(d)
	task.delay(1.3, function()
		vfx(VFX_NAMES.RockRing, d.Position, { Scale = 2.2, Duration = 0.3 })
	end)
end)
wrap("Shatter", function(d)
	if d.Kind == "Crystal" then
		vfx(VFX_NAMES.ShieldBreak, d.Position + Vector3.new(0, 3, 0), { Scale = 2.4, Duration = 0.2 })
	else
		vfx(VFX_NAMES.RockRing, d.Position, { Scale = 1.6, Duration = 0.3 })
		vfx(VFX_NAMES.Crack, d.Position + Vector3.new(0, 1, 0), { Scale = 1.8, Duration = 0.2 })
	end
end)
wrap("Craft", function(d)
	vfx(VFX_NAMES.Shiny, d.Position + Vector3.new(0, 4, 0), { Scale = 2, Duration = 0.25 })
end)
wrap("Build", function(d)
	vfx(VFX_NAMES.RockRing, d.Position, { Scale = 1.2, Duration = 0.25 })
	vfx(VFX_NAMES.Shiny, d.Position + Vector3.new(0, 3, 0), { Scale = 1.6, Duration = 0.2 })
end)
wrap("Refuel", function(d)
	vfx(VFX_NAMES.Fire, d.Position + Vector3.new(0, 2, 0), { Scale = 3.5, Duration = 0.4 })
end)

function CombatClient.HandleFx(kind, data, hud)
	if kind == "Pickup" then
		hud.Pickup(data.Item, data.Count)
		return
	elseif kind == "Loot" then
		for id, n in pairs(data.Items or {}) do
			hud.Pickup(id, n)
		end
		return
	elseif kind == "Eat" or kind == "Heal" then
		local char = player.Character
		if char then
			burst(char:GetPivot().Position, kind == "Heal" and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 200, 120), 12, 8, 0.4)
		end
		return
	end
	local h = Handlers[kind]
	if h then
		local ok, err = pcall(h, data)
		if not ok then
			warn("[AS] fx", kind, err)
		end
	end
end

---------------------------------------------------------------- Init
function CombatClient.Init(state, hud)
	if player.Character then
		hookCharacter(player.Character)
		for _, c in ipairs(player.Character:GetChildren()) do
			if c:IsA("Tool") and not c:GetAttribute("Hooked") then
				hookTool(c)
			end
		end
	end
	player.CharacterAdded:Connect(hookCharacter)
	-- กดค้าง: ตีซ้ำทุกครั้งที่คูลดาวน์หมด (onActivate กันตีถี่เอง)
	RunService.Heartbeat:Connect(function()
		local t = heldTool
		if not t then
			return
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if t.Parent ~= char or not hum or hum.Health <= 0 or player:GetAttribute("Downed") then
			heldTool = nil
			return
		end
		onActivate(t, true)
	end)
	-- มือถือใช้ปุ่ม "วิ่ง" ของ MobileControls (จัดวางรอบปุ่มกระโดด ไม่ซ้อนกัน) แทนปุ่มอัตโนมัติของ ContextActionService
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	ContextActionService:BindAction("ASSprint", sprintAction, not touchOnly, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	if not touchOnly then
		ContextActionService:SetTitle("ASSprint", "วิ่ง")
		ContextActionService:SetPosition("ASSprint", UDim2.new(1, -170, 1, -170))
	end

	RunService.RenderStepped:Connect(function(dt)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and not player:GetAttribute("Downed") then
			local perks = Classes.PerksFor(player:GetAttribute("Class") or "Survivor", player:GetAttribute("ClassLevel") or 1)
			local speedMult = (perks.SpeedMult or 1) * (state:GetAttribute("SpiritAir") and 1.1 or 1) * (player:GetAttribute("DevSpeed") or 1)
			local staminaMult = perks.StaminaMult or 1
			local moving = hum.MoveDirection.Magnitude > 0.1
			if sprinting and moving and stamina > 0 then
				stamina = math.max(0, stamina - 20 / staminaMult * dt)
				hum.WalkSpeed = Config.SprintSpeed * speedMult
				if stamina <= 0 then
					sprinting = false
				end
			else
				stamina = math.min(100, stamina + 14 * dt)
				hum.WalkSpeed = Config.BaseWalkSpeed * speedMult
			end
		end
		hud.Stamina = stamina
		-- จอสั่น
		if shake > 0 then
			local s = shake * 0.35
			camera.CFrame = camera.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * s * 4), math.rad((math.random() - 0.5) * s * 4), 0)
		end
	end)
end

return CombatClient
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000077"><Properties><string name="Name">DeathClient</string><ProtectedString name="Source"><![CDATA[--[[
	DeathClient — ฝั่งผู้เล่น: ล้ม / ตาย / ดูเพื่อน
	  ล้ม  : นอนราบ (เซิร์ฟเวอร์ตรึงตัว) ซ่อนแถบไอเทม + ปิดปุ่ม E ทั้งหมด จนกว่าจะมีคนช่วย
	  ตาย  : ไม่เกิดใหม่ในรอบนี้ — กล้องตามเพื่อนที่ยังรอด (◀ ▶ สลับคน) + ปุ่ม "กลับล็อบบี้"
	  ทีมล้ม/ตายหมด = เซิร์ฟเวอร์จบเกมเอง (ALL HAVE PERISHED -> กลับล็อบบี้หลัก)
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)

local DeathClient = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local ui = {}
local target -- ผู้เล่นที่กำลังดูอยู่

local function setBackpack(on)
	-- แถบเครื่องมือของเกม (Backpack.lua) แทนของ Roblox ที่ปิดไว้
	require(script.Parent.Backpack).SetVisible(on)
end

-- คนที่ยังอยู่ในรอบและยังไม่ตาย (ล้มอยู่ก็ดูได้)
local function candidates()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p:GetAttribute("InRun") and not p:GetAttribute("Dead") then
			local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				table.insert(list, p)
			end
		end
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

local function watch(p)
	target = p
	local cam = Workspace.CurrentCamera
	local hum = p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = hum
		ui.Name.Text = "👁 กำลังดู: " .. p.DisplayName .. (p:GetAttribute("Downed") and "  (ล้มอยู่!)" or "")
	else
		ui.Name.Text = "ไม่มีเพื่อนเหลือรอด... รอผลรอบนี้"
	end
end

local function cycle(dir)
	local list = candidates()
	if #list == 0 then
		watch(nil)
		return
	end
	local i = table.find(list, target) or 0
	i = (i - 1 + dir) % #list + 1
	watch(list[i])
end

function DeathClient.StartSpectate(d)
	ui.Spectate.Visible = true
	UIKit.Pop(ui.Spectate)
	ui.Sub.Text = string.format("คุณสิ้นชีพในคืนที่ %d — รอดูเพื่อนเอาชีวิตรอดต่อ หรือกลับล็อบบี้", d and d.Night or 1)
	setBackpack(false)
	ProximityPromptService.Enabled = false
	task.delay(3.5, function()
		if ui.Spectate.Visible then
			cycle(1)
		end
	end)
end

function DeathClient.StopSpectate()
	if not ui.Spectate then
		return
	end
	ui.Spectate.Visible = false
	target = nil
	local cam = Workspace.CurrentCamera
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	cam.CameraType = Enum.CameraType.Custom
	setBackpack(true)
	ProximityPromptService.Enabled = true
end

local function onDowned()
	local downed = player:GetAttribute("Downed") == true
	if downed then
		setBackpack(false)
		ProximityPromptService.Enabled = false
	elseif not player:GetAttribute("Dead") then
		setBackpack(true)
		ProximityPromptService.Enabled = true
	end
end

function DeathClient.Init()
	local gui = UIKit.Screen("Spectate", 35)
	local bar = UIKit.Card(gui, {
		Size = UDim2.fromOffset(620, 128), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), BackgroundTransparency = 0.08, Visible = false,
	})
	ui.Spectate = bar
	UIKit.Header(bar, "☠ คุณเสียชีวิต", C.Blood)
	ui.Name = UIKit.Text(bar, { Size = UDim2.new(1, -150, 0, 30), Position = UDim2.new(0, 75, 0, 32), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title, TextSize = 24, Text = "" })
	ui.Sub = UIKit.Text(bar, { Size = UDim2.new(1, -40, 0, 20), Position = UDim2.new(0, 20, 0, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, TextColor3 = C.TextDim, Text = "" })
	local prev = UIKit.ColorButton(bar, C.Blue, { Size = UDim2.fromOffset(56, 48), Position = UDim2.fromOffset(14, 26), Text = "◀", TextSize = 26 }, function()
		cycle(-1)
	end)
	local nextB = UIKit.ColorButton(bar, C.Blue, { Size = UDim2.fromOffset(56, 48), Position = UDim2.new(1, -70, 0, 26), Text = "▶", TextSize = 26 }, function()
		cycle(1)
	end)
	local leave = UIKit.ColorButton(bar, C.Orange, { Size = UDim2.fromOffset(220, 34), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 88), Text = "🏠 กลับล็อบบี้", TextSize = 18 }, function()
		Remotes.Get("LeaveRun"):FireServer()
	end)
	-- มือถือ: พื้นที่แตะอย่างน้อย 44px
	UIKit.EnsureTouchSize(prev, 44, function()
		cycle(-1)
	end)
	UIKit.EnsureTouchSize(nextB, 44, function()
		cycle(1)
	end)
	UIKit.EnsureTouchSize(leave, 44, function()
		Remotes.Get("LeaveRun"):FireServer()
	end)

	player:GetAttributeChangedSignal("Downed"):Connect(onDowned)
	-- เกิดใหม่ (กลับล็อบบี้/เริ่มรอบใหม่) = เลิกดูเพื่อน
	player:GetAttributeChangedSignal("Dead"):Connect(function()
		if not player:GetAttribute("Dead") then
			DeathClient.StopSpectate()
		end
	end)
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		if not player:GetAttribute("InRun") then
			DeathClient.StopSpectate()
		end
	end)
	player.CharacterAdded:Connect(function()
		if not player:GetAttribute("Dead") then
			DeathClient.StopSpectate()
		end
	end)
	-- คนที่ดูอยู่ตาย/ออก -> สลับไปคนถัดไปเอง
	task.spawn(function()
		while true do
			task.wait(1)
			if ui.Spectate.Visible then
				if not target or not target.Parent or target:GetAttribute("Dead") or not target:GetAttribute("InRun") then
					cycle(1)
				elseif target then
					ui.Name.Text = "👁 กำลังดู: " .. target.DisplayName .. (target:GetAttribute("Downed") and "  (ล้มอยู่!)" or "")
				end
			end
		end
	end)
end

return DeathClient
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000078"><Properties><string name="Name">DevPanel</string><ProtectedString name="Source"><![CDATA[--[[
	DevPanel — หน้าต่างเครื่องมือนักพัฒนา  [F8] หรือปุ่ม DEV มุมขวาบน (เฉพาะคนที่ server บอกว่า IsDev)
	แท็บ: ผู้เล่น · ไอเทม · บอส · เวลา · แคมป์ · วาร์ป · โปรไฟล์
	บินได้/ทะลุกำแพง ทำฝั่ง client (ตัวละครเป็นของเครื่องเราอยู่แล้ว) — คำสั่งอื่นส่งไป DevService
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Animals = require(Shared.Animals)
local Items = require(Shared.Items)
local Remotes = require(Shared.Remotes)

local DevPanel = {}

local player = Players.LocalPlayer
local C = Color3.fromRGB
local ui = {}
local fly = { On = false }
local noclip = false

---------------------------------------------------------------- ตัวช่วย UI
local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = o
end

local function stroke(o, color, t)
	local s = Instance.new("UIStroke")
	s.Color = color or C(0, 0, 0)
	s.Thickness = t or 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
	return s
end

local function label(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextColor3 = C(235, 235, 240)
	t.TextSize = 14
	t.TextXAlignment = Enum.TextXAlignment.Left
	for k, v in pairs(props) do
		t[k] = v
	end
	t.Parent = parent
	return t
end

local function btn(parent, text, color, onClick, order)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextWrapped = true
	b.TextColor3 = C(255, 255, 255)
	b.BackgroundColor3 = color or C(52, 56, 70)
	b.AutoButtonColor = true
	b.LayoutOrder = order or 0
	b.Parent = parent
	corner(b, 6)
	stroke(b, C(0, 0, 0), 1)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

local function status(text, bad)
	if ui.Status then
		ui.Status.Text = text or ""
		ui.Status.TextColor3 = bad and C(255, 120, 110) or C(150, 240, 150)
	end
end

local function run(action, a, b)
	status("…")
	task.spawn(function()
		local ok, res = pcall(function()
			return Remotes.Get("DevCmd"):InvokeServer(action, a, b)
		end)
		status(ok and tostring(res) or ("❌ " .. tostring(res)), not ok or (type(res) == "string" and (res:find("⛔") or res:find("❌"))))
	end)
end

---------------------------------------------------------------- บิน / ทะลุกำแพง (ฝั่ง client)
local function charParts()
	local c = player.Character
	return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function setFly(on)
	fly.On = on
	local _, root, hum = charParts()
	if fly.BV then
		fly.BV:Destroy()
		fly.BV = nil
	end
	if fly.BG then
		fly.BG:Destroy()
		fly.BG = nil
	end
	if hum then
		hum.PlatformStand = on
	end
	if on and root then
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
		bv.Velocity = Vector3.zero
		bv.Parent = root
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
		bg.P = 2e4
		bg.CFrame = root.CFrame
		bg.Parent = root
		fly.BV, fly.BG = bv, bg
	end
	status(on and "🕊 บิน: WASD + Space ขึ้น / Ctrl ลง · Shift เร็ว" or "บิน: ปิด")
end

RunService.RenderStepped:Connect(function()
	if fly.On then
		local _, root = charParts()
		if not (root and fly.BV) then
			fly.On = false
			return
		end
		local cam = Workspace.CurrentCamera.CFrame
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			dir += cam.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			dir -= cam.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			dir += cam.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			dir -= cam.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			dir += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			dir -= Vector3.yAxis
		end
		local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 260 or 90
		fly.BV.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
		fly.BG.CFrame = CFrame.lookAt(Vector3.zero, cam.LookVector * Vector3.new(1, 0, 1) + Vector3.new(0, 0, 0.0001))
	end
end)

RunService.Stepped:Connect(function()
	if noclip then
		local c = player.Character
		if c then
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
				end
			end
		end
	end
end)

player.CharacterAdded:Connect(function()
	fly.On = false
end)

---------------------------------------------------------------- เนื้อหาแต่ละแท็บ
local ELEMENT_TH = { Earth = "ปฐพี", Water = "วารี", Air = "วายุ", Fire = "อัคคี" }
local CAT = { { "Resource", "วัตถุดิบ", 100 }, { "Food", "อาหาร", 20 }, { "Essence", "แก่นธาตุ", 20 }, { "Medical", "ยา", 10 },
	{ "Relic", "ของหายาก", 3 }, { "Tool", "เครื่องมือ", 1 }, { "Structure", "สิ่งก่อสร้าง", 10 } }

local TABS = {
	{ "ผู้เล่น", function(page)
		btn(page, "🛡 อมตะ (เปิด/ปิด)", C(60, 110, 70), function() run("god") end)
		btn(page, "❤ เติมเลือด+อิ่ม", C(150, 60, 70), function() run("heal") end)
		btn(page, "🕊 บิน (เปิด/ปิด)", C(60, 90, 150), function() setFly(not fly.On) end)
		btn(page, "👻 ทะลุกำแพง", C(90, 70, 140), function()
			noclip = not noclip
			if not noclip then
				local c = player.Character
				for _, d in ipairs(c and c:GetDescendants() or {}) do
					if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
						d.CanCollide = true
					end
				end
			end
			status(noclip and "👻 ทะลุกำแพง: เปิด" or "ทะลุกำแพง: ปิด")
		end)
		btn(page, "🏃 เร็ว x1", nil, function() run("speed", 1) end)
		btn(page, "🏃 เร็ว x2", nil, function() run("speed", 2) end)
		btn(page, "🏃 เร็ว x4", nil, function() run("speed", 4) end)
		btn(page, "🔄 เกิดใหม่", nil, function() run("respawn") end)
		btn(page, "🧭 ลงแมพ (จากล็อบบี้)", C(70, 130, 70), function() run("depart") end)
		btn(page, "🏕 กลับล็อบบี้", nil, function() run("lobby") end)
		btn(page, "🖥 ซ่อน/แสดง HUD", nil, function()
			local hud = player.PlayerGui:FindFirstChild("HUD")
			if hud then
				hud.Enabled = not hud.Enabled
			end
		end)
		btn(page, "ℹ สถานะเกม", nil, function() run("info") end)
	end },
	{ "ไอเทม", function(page)
		for _, c in ipairs(CAT) do
			btn(page, string.format("🎁 %s ทั้งหมด x%d", c[2], c[3]), C(70, 100, 60), function() run("giveCategory", c[1], c[3]) end)
		end
		btn(page, "🗑 ล้างกระเป๋า", C(140, 60, 60), function() run("clearInv") end)
		local ids = {}
		for id in pairs(Items.Data) do
			table.insert(ids, id)
		end
		table.sort(ids, function(a, b)
			local ca, cb = Items.Data[a].Category, Items.Data[b].Category
			if ca ~= cb then
				return ca < cb
			end
			return a < b
		end)
		for _, id in ipairs(ids) do
			local d = Items.Data[id]
			local n = d.Category == "Tool" and 1 or (d.Category == "Resource" and 50 or 5)
			btn(page, Items.DisplayName(id) .. " x" .. n, nil, function() run("give", id, n) end)
		end
	end },
	{ "บอส", function(page)
		-- เฉพาะตัวที่มีโมเดลแล้ว (ReplicatedStorage.Assets.Animals)
		local folder = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Animals")
		for _, m in ipairs(folder and folder:GetChildren() or {}) do
			local info = Animals.Data[m.Name]
			if info then
				btn(page, "👑 " .. info.Thai, C(150, 50, 90), function() run("spawnBoss", m.Name) end)
			end
		end
		btn(page, "🧹 ลบบอส/สัตว์ทั้งหมด", C(100, 60, 60), function() run("clearAnimals") end)
	end },
	{ "เวลา", function(page)
		btn(page, "⏭ ข้ามช่วงเวลา", C(70, 100, 150), function() run("skip") end)
		btn(page, "🌙 ไปกลางคืนเลย", C(50, 50, 120), function() run("nightNow") end)
		btn(page, "⏸ หยุด/เดินเวลา", nil, function() run("pause") end)
		btn(page, "🔴 จันทร์เลือด", C(130, 40, 40), function() run("bloodMoon") end)
		for _, n in ipairs({ 1, 5, 10, 24, 25, 49, 50, 74, 75, 98, 99 }) do
			btn(page, "ตั้งคืนที่ " .. n .. (({ [25] = " 👑ดิน", [50] = " 👑น้ำ", [75] = " 👑ฟ้า", [99] = " 👑ไฟ" })[n] or ""), nil, function() run("setNight", n) end)
		end
	end },
	{ "แคมป์", function(page)
		btn(page, "🔥 เติมเชื้อเพลิงเต็ม", C(150, 90, 40), function() run("fuel") end)
		btn(page, "💨 ดับกองไฟ", C(80, 80, 90), function() run("extinguish") end)
		btn(page, "🔥 กองไฟ +1 เลเวล", C(150, 90, 40), function() run("fireLevel", 1) end)
		btn(page, "🔥 กองไฟ -1 เลเวล", nil, function() run("fireLevel", -1) end)
		btn(page, "🌫 ทะลุกำแพงหมอก เปิด/ปิด", nil, function() run("fogPass") end)
		btn(page, "🔨 โต๊ะคราฟต์ +1", C(110, 80, 50), function() run("benchLevel", 1) end)
		btn(page, "🔨 โต๊ะคราฟต์ -1", nil, function() run("benchLevel", -1) end)
	end },
	{ "วาร์ป", function(page)
		btn(page, "🏕 แคมป์", C(150, 90, 40), function() run("tp", "camp") end)
		btn(page, "➡ ไปข้างหน้า 120", nil, function() run("tp", "front") end)
		for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
			btn(page, "🗺 ไบโอม" .. ELEMENT_TH[el], nil, function() run("tp", "Site_" .. el) end)
			btn(page, "⛩ ศาลเจ้า" .. ELEMENT_TH[el], nil, function() run("tp", "Shrine_" .. el) end)
			btn(page, "👑 รังบอส" .. ELEMENT_TH[el], C(130, 50, 80), function() run("tp", "Lair_" .. el) end)
			btn(page, "🏚 ซากปรักหักพัง" .. ELEMENT_TH[el], nil, function() run("tp", "Ruins_" .. el) end)
			btn(page, "🏛 วิหาร" .. ELEMENT_TH[el], C(110, 90, 50), function() run("tp", "Sanctum_" .. el) end)
		end
	end },
	{ "โปรไฟล์", function(page)
		btn(page, "♦️ +1000 Ruby", C(50, 110, 160), function() run("diamonds", 1000) end)
		btn(page, "🔓 ปลดล็อกทุกคลาส", C(70, 120, 70), function() run("unlockAll") end)
		btn(page, "⭐ คลาสปัจจุบันเลเวล 3", C(150, 120, 40), function() run("maxClass") end)
		btn(page, "🔄 รีเซ็ตรางวัลรายวัน+สต็อก", nil, function() run("resetDaily") end)
		btn(page, "♻ รีเซ็ตโปรไฟล์", C(140, 60, 60), function() run("resetProfile") end)
	end },
}

---------------------------------------------------------------- สร้างหน้าต่าง
function DevPanel.Build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DevPanel"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 100
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	ui.Gui = gui
	local toggle = btn(gui, "DEV", C(200, 60, 60), function()
		ui.Panel.Visible = not ui.Panel.Visible
	end)
	toggle.Size = UDim2.fromOffset(52, 30)
	toggle.Position = UDim2.new(0, 14, 1, -46)
	toggle.TextSize = 15

	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromOffset(560, 520)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.new(0.5, 0, 0.5, 18)
	-- จอเล็ก (มือถือ): ย่อทั้งหน้าต่างให้พอดีจอ ไม่ล้นใต้แถบบนของ Roblox
	local fit = Instance.new("UIScale")
	fit.Parent = panel
	local function refit()
		local vp = workspace.CurrentCamera.ViewportSize
		fit.Scale = math.clamp(math.min((vp.Y - 90) / 520, (vp.X - 24) / 560), 0.45, 1)
	end
	refit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	panel.BackgroundColor3 = C(20, 22, 28)
	panel.BackgroundTransparency = 0.05
	panel.Visible = false
	panel.Active = true
	panel.Parent = gui
	corner(panel, 12)
	stroke(panel, C(200, 60, 60), 2)
	ui.Panel = panel
	local title = label(panel, { Text = "🛠 DEV TOOLS   [F8]  · ลากตรงนี้เพื่อย้าย", Size = UDim2.new(1, -60, 0, 32), Position = UDim2.fromOffset(14, 6), TextSize = 18, TextColor3 = C(255, 140, 120) })
	-- ลากหน้าต่าง
	local dragging, dragStart, startPos
	title.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging, dragStart, startPos = true, i.Position, panel.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - dragStart
			panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	title.Active = true
	local close = btn(panel, "X", C(150, 50, 50), function()
		panel.Visible = false
	end)
	close.Size = UDim2.fromOffset(30, 26)
	close.Position = UDim2.new(1, -40, 0, 8)

	-- แท็บ
	local tabBar = Instance.new("Frame")
	tabBar.BackgroundTransparency = 1
	tabBar.Size = UDim2.new(1, -20, 0, 30)
	tabBar.Position = UDim2.fromOffset(10, 42)
	tabBar.Parent = panel
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, 4)
	tl.Parent = tabBar
	local pages, tabButtons = {}, {}
	local function show(i)
		for k, pg in ipairs(pages) do
			pg.Visible = k == i
			tabButtons[k].BackgroundColor3 = k == i and C(200, 70, 60) or C(52, 56, 70)
		end
	end
	for i, t in ipairs(TABS) do
		local tb = btn(tabBar, t[1], nil, function()
			show(i)
		end, i)
		tb.Size = UDim2.fromOffset(74, 28)
		tabButtons[i] = tb
		local page = Instance.new("ScrollingFrame")
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Size = UDim2.new(1, -20, 1, -118)
		page.Position = UDim2.fromOffset(10, 78)
		page.ScrollBarThickness = 6
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.CanvasSize = UDim2.new()
		page.Visible = false
		page.Parent = panel
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromOffset(170, 36)
		grid.CellPadding = UDim2.fromOffset(6, 6)
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.Parent = page
		t[2](page)
		pages[i] = page
	end
	show(1)
	ui.Status = label(panel, { Text = "พร้อมใช้งาน", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 1, -36), TextColor3 = C(150, 240, 150), TextWrapped = true, TextSize = 13 })
end

function DevPanel.Init()
	local function setup()
		if ui.Gui or not player:GetAttribute("IsDev") then
			return
		end
		DevPanel.Build()
	end
	player:GetAttributeChangedSignal("IsDev"):Connect(setup)
	setup()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.F8 and ui.Panel then
			ui.Panel.Visible = not ui.Panel.Visible
		end
		local _ = processed
	end)
end

return DevPanel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000079"><Properties><string name="Name">FogWall</string><ProtectedString name="Source"><![CDATA[--[[
	FogWall — กำแพงหมอกรอบแคมป์ตามเลเวลกองไฟ (State.CampReveal = รัศมีจากกลางแมพ)
	  · เดินเลยหมอกไม่ได้ (ดันตัวกลับนุ่มๆ ฝั่งเครื่องผู้เล่น · เซิร์ฟเวอร์กันซ้ำใน CampService)
	  · หมอกเป็นผนังไล่สีสูงลิบ 2 ชั้น + ควันลอยต่ำ วางเฉพาะช่วงโค้งใกล้ผู้เล่น (ประหยัด)
	  · อัปเกรดกองไฟ -> หมอกค่อยๆ ถอยออกไป
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local FogWall = {}

local player = Players.LocalPlayer
local N = 44 -- แผ่นต่อชั้น
local SEG = 48 -- ความกว้างแผ่น (สตัด)
local HEIGHT = 1000
local SHOW = 700 -- เห็นกำแพงเมื่ออยู่ใกล้กว่านี้
local DAY = Color3.fromRGB(206, 210, 220)
local NIGHT = Color3.fromRGB(38, 42, 56)

local function panel(parent, transparency)
	local p = Instance.new("Part")
	p.Name = "Fog"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(SEG, HEIGHT, 0.5)
	local frames = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 1
		sg.LightInfluence = 0
		sg.MaxDistance = 3000
		sg.Parent = p
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = DAY
		f.Parent = sg
		local g = Instance.new("UIGradient")
		g.Rotation = 90 -- บน -> ล่าง
		g.Transparency = transparency
		g.Parent = f
		table.insert(frames, f)
	end
	p.Parent = parent
	return p, frames
end

function FogWall.Init(state)
	if ReplicatedStorage:FindFirstChild("ASAutoTest") and not ReplicatedStorage:FindFirstChild("ASFogProbe") then
		return -- เทสต์อัตโนมัติวาร์ปไปทั่วแมพ
	end
	local folder = Instance.new("Folder")
	folder.Name = "ASFogWall"
	folder.Parent = nil
	-- ชั้นใน: ฐานทึบ ปลายบนจางหาย · ชั้นนอก (ลึกเข้าไป 70): ทึบกว่า = ดูหนาเป็นกำแพง
	local inner = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.4, 0.62),
		NumberSequenceKeypoint.new(0.64, 0.22),
		NumberSequenceKeypoint.new(1, 0.08),
	})
	local outer = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(0.45, 0.18),
		NumberSequenceKeypoint.new(1, 0),
	})
	local layers = {}
	local allFrames = {}
	local mists = {}
	for li, spec in ipairs({ { 0, inner }, { 70, outer } }) do
		local parts = {}
		for i = 1, N do
			local p, frames = panel(folder, spec[2])
			parts[i] = p
			for _, f in ipairs(frames) do
				table.insert(allFrames, f)
			end
			if li == 1 and i % 2 == 0 then
				-- ควันลอยเรี่ยพื้นหน้ากำแพง
				local a = Instance.new("Attachment")
				a.Position = Vector3.new(0, -HEIGHT / 2 + 205, 6)
				a.Parent = p
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/smoke_main.dds"
				e.Rate = 3
				e.Lifetime = NumberRange.new(8, 12)
				e.Speed = NumberRange.new(1, 3)
				e.SpreadAngle = Vector2.new(180, 30)
				e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 40), NumberSequenceKeypoint.new(1, 80) })
				e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.55), NumberSequenceKeypoint.new(1, 1) })
				e.RotSpeed = NumberRange.new(-10, 10)
				e.Rotation = NumberRange.new(0, 360)
				e.LightInfluence = 0.6
				e.Parent = a
				table.insert(mists, e)
			end
		end
		layers[li] = { Off = spec[1], Parts = parts }
	end

	-- ป้ายเตือนเมื่อเข้าใกล้กำแพง
	local gui = Instance.new("ScreenGui")
	gui.Name = "ASFogHint"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local hint = Instance.new("TextLabel")
	hint.AnchorPoint = Vector2.new(0.5, 0.5)
	hint.Position = UDim2.fromScale(0.5, 0.7)
	hint.Size = UDim2.new(0.9, 0, 0, 34)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.GothamBold
	hint.TextScaled = true
	hint.TextColor3 = Color3.fromRGB(235, 238, 245)
	hint.TextStrokeColor3 = Color3.fromRGB(20, 22, 30)
	hint.TextTransparency = 1
	hint.TextStrokeTransparency = 1
	hint.Parent = gui
	local sizeC = Instance.new("UITextSizeConstraint")
	sizeC.MaxTextSize = 24
	sizeC.Parent = hint

	local cur -- รัศมีที่แสดงอยู่ (ไล่ตามค่าจริงตอนอัปเกรด)
	local shown = false
	local lastColor = 0
	RunService.Heartbeat:Connect(function(dt)
		local target = state:GetAttribute("CampReveal")
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local active = target and target < 50000 and root and player:GetAttribute("InRun") and not player:GetAttribute("FogPass")
		if not active then
			if shown then
				folder.Parent = nil
				shown = false
			end
			hint.TextTransparency = 1
			hint.TextStrokeTransparency = 1
			cur = target and math.min(target, 50000) or cur
			return
		end
		cur = cur and (cur + (target - cur) * (1 - math.exp(-dt * 0.8))) or target
		if math.abs(cur - target) < 1 then
			cur = target
		end
		local pos = root.Position
		local flat = Vector3.new(pos.X, 0, pos.Z)
		local d = flat.Magnitude
		-- กันเดินทะลุ: ดันกลับ + ตัดความเร็วขาออก
		local lim = cur - 4
		if d > lim and d > 1 then
			local dir = flat.Unit
			root.CFrame = root.CFrame + dir * (lim - d)
			local v = root.AssemblyLinearVelocity
			local out = v:Dot(dir)
			if out > 0 then
				root.AssemblyLinearVelocity = v - dir * out
			end
			d = lim
		end
		-- ป้ายเตือน
		local near = math.clamp((d - (cur - 70)) / 50, 0, 1)
		if near > 0 then
			local lv = state:GetAttribute("CampLevel") or 1
			hint.Text = string.format("หมอกหนาเกินกว่าจะผ่านได้ — อัปเกรดกองไฟ (Lv.%d → %d) เพื่อสำรวจต่อ", lv, lv + 1)
		end
		hint.TextTransparency = 1 - near
		hint.TextStrokeTransparency = 1 - near * 0.6
		-- กำแพง: แสดงเฉพาะตอนใกล้
		local visible = d > cur - SHOW
		if visible ~= shown then
			shown = visible
			folder.Parent = visible and Workspace.CurrentCamera or nil
		end
		if not visible then
			return
		end
		if os.clock() - lastColor > 0.5 then
			lastColor = os.clock()
			local c = Lighting.ClockTime
			local dayK = math.clamp(math.min(c - 5.5, 19 - c) / 1.5, 0, 1)
			local col = NIGHT:Lerp(DAY, dayK)
			if state:GetAttribute("BloodMoon") then
				col = col:Lerp(Color3.fromRGB(90, 20, 24), 0.6)
			end
			for _, f in ipairs(allFrames) do
				f.BackgroundColor3 = col
			end
			for _, e in ipairs(mists) do
				e.Color = ColorSequence.new(col)
			end
		end
		local cy = pos.Y + HEIGHT / 2 - 205 -- ระดับสายตาอยู่ช่วงทึบของไล่สี
		local a0 = math.atan2(pos.Z, pos.X)
		for _, layer in ipairs(layers) do
			local R = cur + layer.Off
			local step = math.min(SEG / R, 2 * math.pi / N)
			local base = math.floor(a0 / step + 0.5) * step -- ล็อกช่อง = แผ่นไม่ไหลตามผู้เล่น
			local w = math.floor(2 * R * math.sin(step / 2) + 1)
			local resize = layer.W ~= w
			layer.W = w
			for i, p in ipairs(layer.Parts) do
				local ang = base + (i - (N + 1) / 2) * step
				local at = Vector3.new(math.cos(ang) * R, cy, math.sin(ang) * R)
				if resize then
					p.Size = Vector3.new(w, HEIGHT, 0.5)
				end
				p.CFrame = CFrame.lookAt(at, Vector3.new(0, cy, 0))
			end
		end
	end)
end

return FogWall
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007A"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--[[
	HUD — หน้าจอหลักระหว่างเล่น
	  ซ้ายบน: เลือด / ความหิว / สตามิน่า
	  กลางบน: คืนที่ X + เวลา + ธาตุประจำคืน + เข็มทิศ
	  ซ้าย (ใต้แถบค่า): เพื่อนร่วมทีม — ชื่อ + เลือด + สถานะล้ม/ตาย (เพื่อนบนเข็มทิศพร้อมระยะ)
	  ขวาบน: กองไฟ (วงแหวนเชื้อเพลิง เขียว→เหลือง→แดง + เวลาที่เหลือ) + ลูกสัตว์ธาตุ 4 ดวง + Ruby
	  ล่าง: ทรัพยากรในกระเป๋า + ปุ่มลัด / แถบเลือดบอส
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Items)
local Animals = require(Shared.Animals)
local Config = require(Shared.Config)
local UIKit = require(script.Parent.UIKit)
local SoundController = require(script.Parent.SoundController)

local HUD = {}
local player = Players.LocalPlayer
local C = UIKit.Colors

local STRIP = { "Wood", "Stone", "Fiber", "Iron", "Coal", "Pelt", "Bone", "Berries", "RawMeat", "CookedMeat", "TerraCore", "TidePearl", "GaleFeather", "EmberShard", "Bandage" }
local ICON = {
	Wood = "🌲", Stone = "🗻", Fiber = "🌾", Iron = "⛓", Coal = "⚫", Pelt = "🟫", Bone = "🦴", Berries = "🍒", RawMeat = "🥩",
	CookedMeat = "🍖", Stew = "🍲", TerraCore = "🟢", TidePearl = "🔵", GaleFeather = "🪶", EmberShard = "🔶", Bandage = "🩹",
	Medkit = "⛑", BeastHeart = "❤‍🔥",
}
HUD.Icon = ICON
HUD.ExtraPOI = {}

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", sec // 60, sec % 60)
end

function HUD.Init(state)
	HUD.State = state
	HUD.Touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local gui = UIKit.Screen("HUD", 5)
	HUD.Gui = gui

	---------------------------------------------------------------- ซ้ายบน: แถบค่า
	-- การ์ดกระจกมุมซ้ายบน: หัวการ์ด = คลาส · 3 แถว เลือด / หิว / สตามิน่า (ไอคอนช่องเหลี่ยมมน + แถบยาวเท่ากัน ตัวเลขชิดขวา)
	local stats = UIKit.Frame(gui, { Size = UDim2.fromOffset(310, 160), Position = UDim2.fromOffset(16, 74), BackgroundTransparency = 1 })
	UIKit.AutoScale(stats)
	local card = UIKit.Frame(stats, { Size = UDim2.fromOffset(294, 150), BackgroundColor3 = Color3.fromRGB(16, 14, 26), BackgroundTransparency = 0.22 })
	UIKit.Corner(card, 12)
	local cs = UIKit.Stroke(card, C.Gold, 1, 0.2)
	cs.Thickness = 1.2
	cs.Transparency = 0.45
	UIKit.Gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 170), 90)
	-- หัวการ์ด: โล่ + ชื่อคลาส + เส้นทองบางๆ
	pcall(UIKit.Icon, card, "Shield", 20, { Position = UDim2.fromOffset(14, 10) })
	HUD.ClassLabel = UIKit.Text(card, { Size = UDim2.fromOffset(240, 20), Position = UDim2.fromOffset(42, 10), TextSize = 16, Font = UIKit.Fonts.Black, TextColor3 = C.Gold, Text = "" })
	local line = UIKit.Frame(card, { Size = UDim2.new(1, -28, 0, 1), Position = UDim2.fromOffset(14, 38), BackgroundColor3 = C.Gold, BackgroundTransparency = 0.3 })
	local lg = Instance.new("UIGradient")
	lg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.4), NumberSequenceKeypoint.new(1, 1) })
	lg.Parent = line
	local function row(y, icon, color, h)
		local badge = UIKit.Frame(card, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(14, y), BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.55), ZIndex = 4 })
		UIKit.Corner(badge, 7)
		local bs = UIKit.Stroke(badge, color, 1, 0.1)
		bs.Thickness = 1.5
		UIKit.Text(badge, { Size = UDim2.fromScale(1, 1), Text = icon, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
		local bar = UIKit.Bar(card, { Size = UDim2.fromOffset(222, h), Position = UDim2.fromOffset(54, y + (28 - h) / 2), Color = color, Label = "" })
		local st = bar.Holder:FindFirstChildOfClass("UIStroke")
		if st then
			st.Thickness = 1.5
			st.Transparency = 0.15
		end
		bar.Label.TextXAlignment = Enum.TextXAlignment.Right
		bar.Label.Size = UDim2.new(1, -16, 1, 0)
		bar.Label.Position = UDim2.fromOffset(8, 0)
		bar.Badge, bar.BadgeStroke = badge, bs
		return bar
	end
	HUD.HealthBar = row(48, "❤", C.Health, 22)
	HUD.HungerBar = row(82, "🍖", C.Hunger, 18)
	HUD.StaminaBar = row(114, "⚡", C.Stamina, 14)
	-- เพื่อนร่วมทีม (อยู่ในกรอบเดียวกับแถบค่า ย่อ/ขยายไปด้วยกัน)
	local team = UIKit.Frame(stats, { Name = "Team", Size = UDim2.fromOffset(240, 0), Position = UDim2.fromOffset(4, 158), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Visible = false })
	local tl = Instance.new("UIListLayout")
	tl.Padding = UDim.new(0, 4)
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Parent = team
	HUD.TeamFrame = team
	HUD.TeamRows = {}
	HUD.TeamMarks = {}

	---------------------------------------------------------------- กลางบน: คืน
	local top = UIKit.Frame(gui, { Size = UDim2.fromOffset(440, 84), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), BackgroundTransparency = 1 })
	UIKit.AutoScale(top) -- เข็มทิศ + แถบเลือดบอสอยู่ในกรอบนี้ (ย่อ/ขยายไปด้วยกัน)
	HUD.NightLabel = UIKit.Text(top, {
		Size = UDim2.new(1, 0, 0, 44), Font = UIKit.Fonts.Title, TextSize = 44, TextXAlignment = Enum.TextXAlignment.Center,
		Text = "DAY 1", TextColor3 = C.Gold,
	})
	HUD.NightLabel:FindFirstChildOfClass("UIStroke").Thickness = 4
	HUD.PhaseLabel = UIKit.Text(top, {
		Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 44), TextSize = 17, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center,
		Text = "", TextColor3 = C.Text,
	})
	-- เส้นเวลา (หลอดหนา + ไอคอนดวงอาทิตย์/จันทร์วิ่งตาม)
	local track = UIKit.Frame(top, { Size = UDim2.new(1, -90, 0, 10), Position = UDim2.new(0, 45, 0, 70), BackgroundColor3 = Color3.fromRGB(14, 14, 26), BackgroundTransparency = 0.05 })
	UIKit.Corner(track, 3)
	UIKit.Stroke(track, C.Outline, 2, 0)
	HUD.TimeFill = UIKit.Frame(track, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold, BackgroundTransparency = 0 })
	UIKit.Corner(HUD.TimeFill, 3)
	HUD.TimeIcon = UIKit.Text(track, { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0, -13, 0.5, -13), Text = "☀", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })

	-- เข็มทิศ
	local compass = UIKit.Frame(top, { Size = UDim2.fromOffset(520, 28), Position = UDim2.new(0.5, -260, 0, 90), BackgroundColor3 = Color3.fromRGB(20, 22, 40), BackgroundTransparency = 0.35, ClipsDescendants = true })
	UIKit.Corner(compass, 12)
	UIKit.Stroke(compass, C.Outline, 2, 0.2)
	HUD.Compass = compass
	HUD.CompassMarks = {}
	for _, d in ipairs({ { "N", 0 }, { "E", 90 }, { "S", 180 }, { "W", 270 } }) do
		local t = UIKit.Text(compass, { Size = UDim2.fromOffset(20, 28), Text = d[1], Font = UIKit.Fonts.Title, TextSize = 18, TextColor3 = d[1] == "N" and C.Red or C.Text, TextXAlignment = Enum.TextXAlignment.Center })
		table.insert(HUD.CompassMarks, { Label = t, Angle = math.rad(d[2]) })
	end
	HUD.CompassPOI = {}

	---------------------------------------------------------------- ขวาบน: กองไฟ / วิญญาณ / Ruby
	-- ใต้แถวปุ่มบนสุด (ปุ่มกระเป๋ามุมขวาบนอยู่แถวเดียวกับเมนู Roblox) -> ไม่ซ้อนกัน
	local right = UIKit.Card(gui, { Size = UDim2.fromOffset(270, 116), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 66), BackgroundTransparency = 0.12 })
	UIKit.AutoScale(right)
	HUD.RightCard = right
	-- วงแหวนเชื้อเพลิงรอบไอคอนกองไฟ (ขีดเรียงเป็นวง: เต็ม = เขียว · ครึ่ง = เหลือง · ใกล้หมด = แดงกะพริบ)
	local ring = UIKit.Frame(right, { Name = "FuelRing", Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(6, 4), BackgroundTransparency = 1, ZIndex = 3 })
	HUD.FuelSegs = {}
	local SEGS, R = 24, 30
	for i = 1, SEGS do
		local a = (i - 0.5) / SEGS * math.pi * 2 -- เริ่มที่ 12 นาฬิกา วนตามเข็ม
		local seg = UIKit.Frame(ring, {
			Size = UDim2.fromOffset(5, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(35 + math.sin(a) * R, 35 - math.cos(a) * R),
			Rotation = math.deg(a), BackgroundColor3 = Color3.fromRGB(60, 60, 70), BackgroundTransparency = 0, ZIndex = 3,
		})
		UIKit.Corner(seg, 1)
		HUD.FuelSegs[i] = seg
	end
	HUD.FireIcon = UIKit.IconBadge(right, "🔥", C.Fire, 40, { Position = UDim2.fromOffset(21, 19) })
	HUD.FireIconScale = Instance.new("UIScale")
	HUD.FireIconScale.Parent = HUD.FireIcon
	HUD.FireLabel = UIKit.Text(right, { Size = UDim2.new(1, -90, 0, 20), Position = UDim2.fromOffset(82, 6), Text = "กองไฟ Lv.1", Font = UIKit.Fonts.Black, TextColor3 = C.Text, TextSize = 15 })
	HUD.FuelText = UIKit.Text(right, { Size = UDim2.new(1, -90, 0, 26), Position = UDim2.fromOffset(82, 26), Text = "", Font = UIKit.Fonts.Title, TextColor3 = C.Good, TextSize = 22 })
	HUD.SafeLabel = UIKit.Text(right, { Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(82, 54), Text = "", TextSize = 13, TextColor3 = C.TextDim })
	HUD.FuelLowArmed = true
	HUD.SpiritOrbs = {}
	for i, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		local orb = UIKit.Frame(right, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(12 + (i - 1) * 34, 80), BackgroundColor3 = Color3.fromRGB(50, 50, 56), BackgroundTransparency = 0 })
		local oc = Instance.new("UICorner")
		oc.CornerRadius = UDim.new(1, 0)
		oc.Parent = orb
		UIKit.Stroke(orb, C.Outline, 2, 0)
		local t = UIKit.Text(orb, { Size = UDim2.fromScale(1, 1), Text = UIKit.ElementIcon[el], TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.6 })
		HUD.SpiritOrbs[el] = { Frame = orb, Icon = t }
	end
	HUD.DiamondLabel = UIKit.Text(right, { Size = UDim2.fromOffset(100, 28), Position = UDim2.new(1, -144, 0, 80), Text = "0", Font = UIKit.Fonts.Title, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(255, 190, 190) })
	UIKit.Icon(right, "Ruby", 32, { Position = UDim2.new(1, -42, 0, 76) })
	-- คลังแคมป์ (ของที่ย่อยแล้ว ใช้ร่วมกันทั้งทีม): รูปไอเทม + จำนวน ใต้การ์ดกองไฟ
	local ItemIcon = require(script.Parent.ItemIcon)
	local stock = UIKit.Frame(right, { Name = "CampStock", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 124), BackgroundColor3 = Color3.fromRGB(16, 14, 26), BackgroundTransparency = 0.22 })
	UIKit.Corner(stock, 10)
	local ss = UIKit.Stroke(stock, C.Gold, 1, 0.2)
	ss.Thickness = 1.2
	ss.Transparency = 0.45
	UIKit.Text(stock, { Size = UDim2.fromOffset(60, 44), Position = UDim2.fromOffset(12, 0), Text = "คลังแคมป์", TextSize = 13, Font = UIKit.Fonts.Black, TextColor3 = C.Gold })
	HUD.StockLabels = {}
	for i, id in ipairs({ "Wood", "Stone", "Iron" }) do
		local x = 78 + (i - 1) * 62
		ItemIcon.Make(stock, id, { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(x, 7), ZIndex = 3 })
		HUD.StockLabels[id] = UIKit.Text(stock, { Size = UDim2.fromOffset(30, 44), Position = UDim2.fromOffset(x + 31, 0), Text = "0", TextSize = 17, Font = UIKit.Fonts.Black, TextColor3 = C.Text })
	end

	---------------------------------------------------------------- ล่าง: ทรัพยากร
	local strip = UIKit.Frame(gui, { Size = UDim2.new(0, 760, 0, 40), Position = UDim2.new(0.5, -380, 1, -172), BackgroundTransparency = 0.45 })
	UIKit.Corner(strip, 10)
	UIKit.Stroke(strip, C.GoldDim, 1, 0.6)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = strip
	HUD.Strip = strip
	local sackSlot = UIKit.Frame(strip, { Size = UDim2.fromOffset(84, 32), BackgroundColor3 = Color3.fromRGB(50, 40, 30), BackgroundTransparency = 0.2, LayoutOrder = -1 })
	UIKit.Corner(sackSlot, 6)
	HUD.SackLabel = UIKit.Text(sackSlot, { Size = UDim2.fromScale(1, 1), Text = "🎒 0/0", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center })
	HUD.Slots = {}
	for i, id in ipairs(STRIP) do
		local slot = UIKit.Frame(strip, { Size = UDim2.fromOffset(44, 32), BackgroundColor3 = Color3.fromRGB(30, 28, 32), BackgroundTransparency = 0.3, LayoutOrder = i })
		UIKit.Corner(slot, 6)
		UIKit.Text(slot, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 0), Text = ICON[id] or "?", TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center })
		local count = UIKit.Text(slot, { Size = UDim2.new(1, -4, 0, 14), Position = UDim2.fromOffset(0, 17), Text = "0", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.TextDim })
		slot.Visible = false
		HUD.Slots[id] = { Frame = slot, Count = count }
	end
	HUD.Hint = UIKit.Text(gui, {
		Size = UDim2.new(0, 900, 0, 20), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, TextColor3 = C.Text,
		Text = "[คลิก] ตี/ตัด   [Shift] วิ่ง   [Ctrl] ล็อกกล้อง   [C] คราฟต์   [B] สร้าง   [E] เก็บของ (ถือกระสอบ)   [F] เอาของออก   [M] แผนที่   [1-9] เลือกของ",
		TextStrokeTransparency = 0.7,
	})

	---------------------------------------------------------------- แถบเลือดบอส (สไตล์ Souls)
	local boss = UIKit.Frame(top, { Size = UDim2.new(0, 720, 0, 62), Position = UDim2.new(0.5, -360, 0, 128), BackgroundTransparency = 1, Visible = false })
	HUD.BossName = UIKit.Text(boss, { Size = UDim2.new(1, 0, 0, 30), Font = UIKit.Fonts.Title, TextSize = 30, Text = "", TextColor3 = Color3.fromRGB(255, 120, 110), TextXAlignment = Enum.TextXAlignment.Center })
	HUD.BossBar = UIKit.Bar(boss, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 34), Color = Color3.fromRGB(230, 40, 56), Label = "" })
	HUD.BossFrame = boss

	---------------------------------------------------------------- แจ้งเตือน
	-- มือถือ: กล่องแจ้งเตือนเตี้ยลง/ขึ้นใกล้การ์ดกองไฟ ไม่ลงไปทับปุ่มมือถือมุมขวาล่าง
	local feed = UIKit.Frame(gui, {
		Size = UDim2.new(0, 680, 0, HUD.Touch and 150 or 220), AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, HUD.Touch and 150 or 198), BackgroundTransparency = 1, -- ใต้แถบวัน/เข็มทิศ/แถบเลือดบอส
	})
	UIKit.AutoScale(feed)
	local fl = Instance.new("UIListLayout")
	fl.Padding = UDim.new(0, 4)
	fl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	fl.SortOrder = Enum.SortOrder.LayoutOrder
	fl.Parent = feed
	HUD.Feed = feed
	HUD.FeedOrder = 0

	-- ป๊อปอัปเก็บของ
	local touch = HUD.Touch
	local pick = UIKit.Frame(gui, {
		Size = UDim2.new(0, 220, 0, 200), AnchorPoint = touch and Vector2.new(0.5, 1) or Vector2.new(1, 1),
		Position = touch and UDim2.new(0.5, 0, 1, -110) or UDim2.new(1, -16, 1, -130), BackgroundTransparency = 1,
	})
	UIKit.AutoScale(pick)
	local pl = Instance.new("UIListLayout")
	pl.Padding = UDim.new(0, 4)
	pl.VerticalAlignment = Enum.VerticalAlignment.Bottom
	pl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	pl.Parent = pick
	HUD.PickFeed = pick

	-- ล้ม
	HUD.DownedFrame = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(80, 0, 0), BackgroundTransparency = 0.7, Visible = false, ZIndex = 20 })
	HUD.DownedText = UIKit.Text(HUD.DownedFrame, {
		Size = UDim2.new(1, 0, 0, 90), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.62, 0), TextXAlignment = Enum.TextXAlignment.Center,
		Font = UIKit.Fonts.Title, TextSize = 32, Text = "", TextColor3 = Color3.fromRGB(255, 200, 190), ZIndex = 21,
	})
	UIKit.AutoScale(HUD.DownedText)

	-- อัปเดต HUD 30 ครั้ง/วินาที พอ (ไม่ต้องทุกเฟรม ลดภาระเครื่องอ่อน/มือถือ)
	local hudAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		hudAcc += dt
		if hudAcc >= 1 / 30 then
			hudAcc = 0
			HUD.Update()
		end
	end)
	state:GetAttributeChangedSignal("Phase"):Connect(HUD.UpdateNightLabel)
	state:GetAttributeChangedSignal("Night"):Connect(HUD.UpdateNightLabel)
	HUD.UpdateNightLabel()
end

function HUD.UpdateNightLabel()
	if not player:GetAttribute("InRun") then
		return
	end
	local s = HUD.State
	local night = s:GetAttribute("Night") or 1
	local phase = s:GetAttribute("Phase") or "Day"
	if phase == "Night" then
		HUD.NightLabel.Text = string.format("NIGHT %d", night)
		HUD.NightLabel.TextColor3 = s:GetAttribute("BloodMoon") and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(170, 190, 255)
	else
		HUD.NightLabel.Text = string.format("DAY %d", night)
		HUD.NightLabel.TextColor3 = C.Gold
	end
end

local lastPOI = 0
function HUD.Update()
	local s = HUD.State
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		local hf = hum.Health / math.max(hum.MaxHealth, 1)
		HUD.HealthBar.Set(hf, string.format("%d / %d", math.ceil(hum.Health), math.ceil(hum.MaxHealth)))
		-- เลือดต่ำ: ไอคอนกระพริบแดง
		local pulse = hf < 0.3 and (0.5 + 0.5 * math.sin(os.clock() * 8)) or 0
		HUD.HealthBar.BadgeStroke.Thickness = 1.5 + pulse * 2
		HUD.HealthBar.Badge.BackgroundColor3 = C.Health:Lerp(Color3.new(0, 0, 0), 0.55 - pulse * 0.4)
	end
	local hunger = player:GetAttribute("Hunger") or 100
	HUD.HungerBar.Set(hunger / Config.HungerMax, hunger < 25 and "หิวมาก!" or string.format("%d%%", math.floor(hunger / Config.HungerMax * 100 + 0.5)))
	HUD.StaminaBar.Set((HUD.Stamina or 100) / 100)
	local cls = player:GetAttribute("Class")
	local lv = player:GetAttribute("ClassLevel")
	HUD.ClassLabel.Text = cls and (string.upper(cls) .. (lv and ("  ·  Lv." .. lv) or "")) or "SURVIVOR"

	-- เวลา
	local now = Workspace:GetServerTimeNow()
	local phase = s:GetAttribute("Phase") or "Day"
	local pStart, pEnd = s:GetAttribute("PhaseStart") or now, s:GetAttribute("PhaseEnd") or now
	local frac = math.clamp((now - pStart) / math.max(pEnd - pStart, 0.01), 0, 1)
	local remain = pEnd - now
	local inLobby = not player:GetAttribute("InRun")
	if HUD.FireLabel then
		HUD.FireLabel.Parent.Visible = not inLobby
	end
	-- ล็อบบี้: หน้าจอโล่ง (ซ่อนแถบเลือด/เข็มทิศ/กระเป๋า)
	HUD.HealthBar.Holder.Parent.Visible = not inLobby
	HUD.Compass.Visible = not inLobby
	HUD.TimeFill.Parent.Visible = not inLobby
	HUD.Strip.Visible = false -- ไม่มีแถบนับของ: ของทั้งหมดอยู่ในกระสอบ
	HUD.Hint.Visible = HUD.ShowHints ~= false
	HUD.Hint.Position = UDim2.new(0.5, 0, 1, inLobby and -16 or -86) -- ในแมพ: อยู่เหนือแถบไอเทมของ Roblox
	if inLobby then
		HUD.NightLabel.Text = "WILDHEART CAMP"
		HUD.NightLabel.TextColor3 = C.Gold
		local cd = s:GetAttribute("PortalCountdown") or -1
		if not s:GetAttribute("Ready") then
			HUD.PhaseLabel.Text = string.format("⏳ กำลังสร้างโลก %d%% · ระหว่างนี้แวะร้านค้าได้", math.floor((s:GetAttribute("LoadProgress") or 0) * 100))
		elseif cd >= 0 then
			HUD.PhaseLabel.Text = string.format("🧭 ทีม %d คน · ออกเดินทางใน %d วินาที", s:GetAttribute("PortalCount") or 0, cd)
		elseif phase == "Lobby" then
			HUD.PhaseLabel.Text = "🌲 เดินขึ้นแท่น \"เริ่มเกม\" ทางขวามือเพื่อออกผจญภัย"
		else
			HUD.PhaseLabel.Text = string.format("⚔ ทีมกำลังเอาชีวิตรอดคืนที่ %d — ขึ้นแท่นเริ่มเกมเพื่อร่วมทีม", s:GetAttribute("Night") or 1)
		end
		HUD.Hint.Text = HUD.Touch and "เต็นท์ Classes = ร้านคลาส · หม้อเขียว = รางวัลรายวัน · เดินขึ้นแท่นเริ่มเกมเพื่อออกผจญภัย"
			or "เต็นท์ Classes ตรงหน้า = ร้านคลาส [K]   ·   หม้อเขียวซ้ายมือ = รางวัลประจำวัน   ·   แท่นเริ่มเกม: เดินขึ้นแท่นแล้วเลือกจำนวนคน (1-8)"
		HUD.TimeFill.Size = UDim2.fromScale(0, 1)
	elseif phase == "Day" then
		HUD.PhaseLabel.Text = string.format("☀ กลางวัน · ค่ำในอีก %s", fmtTime(remain))
		HUD.TimeIcon.Text = "☀"
		HUD.TimeFill.BackgroundColor3 = C.Gold
	elseif phase == "Dusk" then
		HUD.PhaseLabel.Text = string.format("⚠ พลบค่ำ · ฝูงสัตว์จะมาในอีก %s", fmtTime(remain))
		HUD.TimeIcon.Text = "🌅"
		HUD.TimeFill.BackgroundColor3 = C.Fire
	elseif phase == "Night" then
		local el = s:GetAttribute("NightElement") or "Earth"
		HUD.PhaseLabel.Text = string.format("%s คืนแห่ง%s · รุ่งเช้าในอีก %s", UIKit.ElementIcon[el] or "", UIKit.ElementThai[el] or "", fmtTime(remain))
		HUD.TimeIcon.Text = s:GetAttribute("BloodMoon") and "🔴" or "🌙"
		HUD.TimeFill.BackgroundColor3 = UIKit.Colors.Element[el] or C.Gold
	elseif phase == "Loading" then
		HUD.PhaseLabel.Text = "กำลังสร้างโลก..."
	else
		HUD.PhaseLabel.Text = ""
	end
	if not inLobby then
		HUD.TimeFill.Size = UDim2.fromScale(frac, 1)
		HUD.Hint.Text = HUD.Touch and "แตะจอ = ตี/ตัด · โต๊ะคราฟต์ = คราฟต์ · เลือกของในแถบล่าง = สร้าง · 🎒 มุมขวาบน = กระเป๋า"
			or "[คลิก] ตี/ตัด   [Shift] วิ่ง   [Ctrl] ล็อกกล้อง   [C] คราฟต์   [B] สร้าง   [E] เก็บของ   [F] เอาของออก   [Tab] กระสอบ   [M] แผนที่   [1-9] เลือกของ"
	end
	HUD.TimeIcon.Position = UDim2.new(frac, -10, 0.5, -10)

	-- กองไฟ
	local lvl = s:GetAttribute("CampLevel") or 1
	local fuel, maxFuel = s:GetAttribute("CampFuel") or 0, s:GetAttribute("CampMaxFuel") or 1
	HUD.FireLabel.Text = string.format("กองไฟ Lv.%d  ·  โต๊ะ Lv.%d", lvl, s:GetAttribute("BenchLevel") or 1)
	HUD.UpdateFuel(fuel, maxFuel, inLobby, phase)
	for id, l in pairs(HUD.StockLabels or {}) do
		local n = s:GetAttribute("Stock" .. id) or 0
		l.Text = n >= 1000 and string.format("%.1fk", n / 1000) or tostring(n)
		l.TextColor3 = n > 0 and C.Text or C.TextDim
	end
	local campPos = s:GetAttribute("CampPos")
	local safe = s:GetAttribute("CampSafeRadius") or 0
	if campPos and char then
		local d = ((char:GetPivot().Position - campPos) * Vector3.new(1, 0, 1)).Magnitude
		if fuel <= 0 then
			HUD.SafeLabel.Text = "⚠ ไฟดับ! ไม่มีที่ปลอดภัย"
			HUD.SafeLabel.TextColor3 = C.Bad
		elseif d < safe then
			HUD.SafeLabel.Text = "🔥 อยู่ในแสงกองไฟ (ปลอดภัยจากกวางกลวง)"
			HUD.SafeLabel.TextColor3 = C.Good
		else
			HUD.SafeLabel.Text = string.format("ห่างกองไฟ %d m", math.floor(d * 0.28))
			HUD.SafeLabel.TextColor3 = C.TextDim
		end
	end
	for el, orb in pairs(HUD.SpiritOrbs) do
		local rescued = s:GetAttribute("Spirit" .. el)
		orb.Frame.BackgroundColor3 = rescued and C.Element[el] or Color3.fromRGB(50, 50, 56)
		orb.Icon.TextTransparency = rescued and 0 or 0.6
	end
	HUD.DiamondLabel.Text = tostring(player:GetAttribute("Diamonds") or 0)

	-- บอส
	local bossId = s:GetAttribute("BossId")
	local bossNear = false
	if bossId and bossId ~= "" and player:GetAttribute("InRun") then
		local animals = Workspace:FindFirstChild("Animals")
		local myPos = player.Character and player.Character:GetPivot().Position
		for _, m in ipairs(animals and animals:GetChildren() or {}) do
			if m:GetAttribute("IsBoss") and myPos and (m:GetPivot().Position - myPos).Magnitude < 350 then
				bossNear = true
				break
			end
		end
	end
	if bossNear and Animals.Data[bossId] then
		HUD.BossFrame.Visible = true
		HUD.BossName.Text = Animals.Data[bossId].Name
		HUD.BossBar.Set((s:GetAttribute("BossHP") or 0) / math.max(s:GetAttribute("BossMaxHP") or 1, 1))
	else
		HUD.BossFrame.Visible = false
	end

	-- ล้ม
	local downed = player:GetAttribute("Downed")
	HUD.DownedFrame.Visible = downed == true
	if downed then
		local left = (player:GetAttribute("DownedUntil") or now) - now
		HUD.DownedText.Text = string.format("🩸 คุณล้มลงแล้ว — รอเพื่อนช่วย %d วินาที\nไม่มีใครช่วยทัน = ตาย (ไม่เกิดใหม่ในรอบนี้)", math.max(0, math.ceil(left)))
	end

	-- เข็มทิศ
	local cam = Workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local heading = math.atan2(look.X, -look.Z)
	local width = HUD.Compass.AbsoluteSize.X
	local function place(label, angle)
		local diff = (angle - heading + math.pi) % (2 * math.pi) - math.pi
		local x = 0.5 + diff / math.rad(150)
		label.Visible = x > -0.05 and x < 1.05
		label.Position = UDim2.new(x, -label.AbsoluteSize.X / 2, 0, 0)
	end
	for _, m in ipairs(HUD.CompassMarks) do
		place(m.Label, m.Angle)
	end
	if os.clock() - lastPOI > 0.5 then
		lastPOI = os.clock()
		HUD.RefreshPOI()
	end
	if char then
		local pos = char:GetPivot().Position
		for _, poi in pairs(HUD.CompassPOI) do
			local d = poi.Position - pos
			place(poi.Label, math.atan2(d.X, -d.Z))
			local dist = (d * Vector3.new(1, 0, 1)).Magnitude
			poi.Label.Text = poi.Icon .. (dist > 60 and string.format(" %dm", math.floor(dist * 0.28)) or "")
		end
		for p, mark in pairs(HUD.TeamMarks) do
			local tp = HUD.TeammatePos(p)
			if tp and not p:GetAttribute("Dead") then
				local d = tp - pos
				place(mark.Label, math.atan2(d.X, -d.Z))
				mark.Label.Text = string.format("● %s %dm", mark.Short, math.floor((d * Vector3.new(1, 0, 1)).Magnitude * 0.28))
			else
				mark.Label.Visible = false
			end
		end
	end
	if os.clock() - (HUD.LastTeam or 0) > 0.25 then
		HUD.LastTeam = os.clock()
		HUD.UpdateTeam(inLobby, now)
	end
	local _ = width
end

---------------------------------------------------------------- กองไฟ: วงแหวนเชื้อเพลิง + เวลาที่เหลือ + เตือนเชื้อเพลิงต่ำ
local GREEN, YELLOW, RED = Color3.fromRGB(96, 230, 110), Color3.fromRGB(255, 214, 60), Color3.fromRGB(255, 70, 60)
local function fuelColor(frac)
	if frac >= 0.5 then
		return YELLOW:Lerp(GREEN, (frac - 0.5) / 0.5)
	end
	return RED:Lerp(YELLOW, math.max(frac, 0) / 0.5)
end
HUD.FuelColor = fuelColor

function HUD.UpdateFuel(fuel, maxFuel, inLobby, phase)
	local frac = math.clamp(fuel / math.max(maxFuel, 1), 0, 1)
	local col = fuelColor(frac)
	local low = frac < 0.2 and fuel > 0
	local pulse = low and (0.5 + 0.5 * math.sin(os.clock() * 7)) or 0
	local lit = math.ceil(frac * #HUD.FuelSegs - 0.001)
	for i, seg in ipairs(HUD.FuelSegs) do
		if i <= lit then
			seg.BackgroundColor3 = col
			seg.BackgroundTransparency = low and 0.35 * pulse or 0
		else
			seg.BackgroundColor3 = Color3.fromRGB(46, 46, 58)
			seg.BackgroundTransparency = 0.25
		end
	end
	HUD.FireIconScale.Scale = 1 + 0.14 * pulse
	-- เวลาที่เหลือโดยประมาณ (จากอัตรากินเชื้อเพลิงจริงที่เซิร์ฟเวอร์ส่งมา)
	local drain = HUD.State:GetAttribute("CampDrain") or 0
	local est = ""
	if fuel > 0 and drain > 0 then
		est = "  ⏱ ~" .. fmtTime(fuel / drain)
	end
	HUD.FuelText.Text = fuel <= 0 and "ไฟดับ!" or (string.format("%d%%", math.floor(frac * 100 + 0.5)) .. est)
	HUD.FuelText.TextColor3 = fuel <= 0 and C.Bad or col
	-- เตือนครั้งเดียวต่อการลดลงต่ำกว่า 20% (เติมกลับถึง 25% ค่อยเตือนใหม่ได้)
	local active = not inLobby and (phase == "Day" or phase == "Dusk" or phase == "Night")
	if low and active and HUD.FuelLowArmed then
		HUD.FuelLowArmed = false
		SoundController.Play("FireLow")
		HUD.Notify(string.format("🔥 ไฟใกล้มอด! เหลือราว %s — โยนไม้/ถ่านเข้ากองไฟด่วน", drain > 0 and fmtTime(fuel / drain) or "ไม่กี่นาที"), "Warn")
	elseif frac >= 0.25 or not active then
		HUD.FuelLowArmed = true
	end
end

---------------------------------------------------------------- เพื่อนร่วมทีม
local TEAM_COLORS = {
	Color3.fromRGB(120, 210, 255), Color3.fromRGB(255, 170, 90), Color3.fromRGB(170, 255, 120), Color3.fromRGB(255, 130, 200),
	Color3.fromRGB(200, 160, 255), Color3.fromRGB(255, 230, 110), Color3.fromRGB(120, 255, 220),
}
local MAX_TEAM_ROWS = 7

-- ตำแหน่งเพื่อน: ตัวละครที่โหลดถึงเครื่องเรา หรือพิกัดคร่าวๆ ที่เซิร์ฟเวอร์ส่งมา (เพื่อนอยู่ไกล)
function HUD.TeammatePos(p)
	local c = p.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if root then
		return root.Position
	end
	return p:GetAttribute("RunPos")
end

local function shortName(name)
	local len = utf8.len(name)
	if len and len > 10 then
		local cut = utf8.offset(name, 10)
		return cut and (name:sub(1, cut - 1) .. "…") or name
	end
	return name
end

local function makeTeamRow(p, color)
	local row = UIKit.Frame(HUD.TeamFrame, { Size = UDim2.fromOffset(236, 30), BackgroundColor3 = Color3.fromRGB(20, 22, 40), BackgroundTransparency = 0.3 })
	UIKit.Corner(row, 8)
	UIKit.Stroke(row, C.Outline, 2, 0.2)
	local icon = UIKit.Text(row, { Size = UDim2.fromOffset(24, 30), Position = UDim2.fromOffset(4, 0), Text = "❤", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center })
	local name = UIKit.Text(row, { Size = UDim2.fromOffset(104, 30), Position = UDim2.fromOffset(30, 0), Text = shortName(p.DisplayName), TextSize = 14, Font = UIKit.Fonts.Black, TextColor3 = color })
	local bar = UIKit.Bar(row, { Size = UDim2.fromOffset(92, 12), Position = UDim2.fromOffset(138, 9), Color = C.Health, Label = "" })
	local status = UIKit.Text(row, {
		Size = UDim2.fromOffset(92, 30), Position = UDim2.fromOffset(138, 0), Text = "", TextSize = 13, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 4,
	})
	local mark = UIKit.Text(HUD.Compass, { Size = UDim2.fromOffset(96, 26), TextSize = 12, Font = UIKit.Fonts.Black, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, Text = "" })
	return { Row = row, Icon = icon, Name = name, Bar = bar, Status = status, Mark = mark, Health = 1 }
end

function HUD.UpdateTeam(inLobby, now)
	local mates = {}
	if not inLobby then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p:GetAttribute("InRun") then
				table.insert(mates, p)
			end
		end
	end
	table.sort(mates, function(a, b)
		return a.DisplayName:lower() < b.DisplayName:lower()
	end)
	local keep = {}
	for i, p in ipairs(mates) do
		if i > MAX_TEAM_ROWS then
			break
		end
		keep[p] = true
		local r = HUD.TeamRows[p]
		if not r then
			r = makeTeamRow(p, TEAM_COLORS[(p.UserId % #TEAM_COLORS) + 1])
			HUD.TeamRows[p] = r
			HUD.TeamMarks[p] = { Label = r.Mark, Short = shortName(p.DisplayName) }
		end
		r.Row.LayoutOrder = i
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			r.Health = hum.Health / math.max(hum.MaxHealth, 1)
		end
		local dead, downed = p:GetAttribute("Dead") == true, p:GetAttribute("Downed") == true
		if dead then
			r.Icon.Text = "💀"
			r.Status.Text = "ตายแล้ว"
			r.Status.TextColor3 = C.TextDim
		elseif downed then
			local left = math.max(0, math.ceil((p:GetAttribute("DownedUntil") or now) - now))
			r.Icon.Text = "🩸"
			r.Status.Text = string.format("ล้ม! %ds", left)
			r.Status.TextColor3 = (math.floor(os.clock() * 3) % 2 == 0) and C.Bad or Color3.fromRGB(255, 220, 200)
		else
			r.Icon.Text = "❤"
			r.Bar.Set(r.Health)
		end
		r.Status.Visible = dead or downed
		r.Bar.Holder.Visible = not (dead or downed)
		r.Row.BackgroundColor3 = downed and Color3.fromRGB(90, 20, 26) or Color3.fromRGB(20, 22, 40)
		r.Name.TextTransparency = dead and 0.45 or 0
	end
	for p, r in pairs(HUD.TeamRows) do
		if not keep[p] then
			r.Row:Destroy()
			r.Mark:Destroy()
			HUD.TeamRows[p] = nil
			HUD.TeamMarks[p] = nil
		end
	end
	HUD.TeamFrame.Visible = next(HUD.TeamRows) ~= nil
end

-- จุดสำคัญบนเข็มทิศ
function HUD.RefreshPOI()
	local s = HUD.State
	local wanted = {}
	local camp = s:GetAttribute("CampPos")
	if camp then
		wanted.Camp = { Position = camp, Icon = "🔥", Color = C.Fire }
	end
	for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
		local shrine = s:GetAttribute("Shrine_" .. el)
		if shrine and not s:GetAttribute("Spirit" .. el) and (HUD.Discovered and HUD.Discovered["Shrine_" .. el]) then
			wanted["Shrine_" .. el] = { Position = shrine, Icon = "⛩" .. UIKit.ElementIcon[el], Color = C.Element[el] }
		end
		local lair = s:GetAttribute("Lair_" .. el)
		if lair and not s:GetAttribute("Lair" .. el .. "Cleared") and (HUD.Discovered and HUD.Discovered["Lair_" .. el]) then
			wanted["Lair_" .. el] = { Position = lair, Icon = "💀", Color = C.Element[el] }
		end
	end
	-- จุดชั่วคราวจากระบบอื่น (เช่น ปิงของเพื่อน): HUD.ExtraPOI[key] = { Position, Icon, Color, Expire = os.clock() }
	for key, w in pairs(HUD.ExtraPOI) do
		if w.Expire and w.Expire < os.clock() then
			HUD.ExtraPOI[key] = nil
		else
			wanted[key] = w
		end
	end
	for key, poi in pairs(HUD.CompassPOI) do
		if wanted[key] then
			poi.Position = wanted[key].Position
		end
		if not wanted[key] then
			poi.Label:Destroy()
			HUD.CompassPOI[key] = nil
		end
	end
	for key, w in pairs(wanted) do
		if not HUD.CompassPOI[key] then
			local label = UIKit.Text(HUD.Compass, { Size = UDim2.fromOffset(64, 26), TextSize = 13, TextColor3 = w.Color, TextXAlignment = Enum.TextXAlignment.Center, Text = w.Icon })
			HUD.CompassPOI[key] = { Label = label, Position = w.Position, Icon = w.Icon }
		end
	end
end

-- กระสอบ: ใช้ไป/ความจุ (แดงเมื่อเต็ม)
function HUD.SetSack(used, cap)
	if not HUD.SackLabel then
		return
	end
	HUD.SackLabel.Text = cap > 0 and string.format("🎒 %d/%d", used, cap) or "🎒 ไม่มีกระสอบ"
	HUD.SackLabel.TextColor3 = (cap > 0 and used >= cap) and Color3.fromRGB(255, 110, 100) or Color3.fromRGB(240, 226, 190)
end

function HUD.SetInventory(inv)
	HUD.Inventory = inv
	for id, slot in pairs(HUD.Slots) do
		local n = inv[id] or 0
		slot.Count.Text = tostring(n)
		slot.Frame.Visible = n > 0 or id == "Wood" or id == "Stone"
	end
end

local KIND_COLOR = {
	Info = Color3.fromRGB(240, 236, 224), Good = Color3.fromRGB(150, 245, 165), Reward = Color3.fromRGB(255, 220, 120),
	Warn = Color3.fromRGB(255, 190, 95), Danger = Color3.fromRGB(255, 104, 92), Error = Color3.fromRGB(255, 136, 124),
}
local KIND_GLYPH = { Info = "✦", Good = "✔", Reward = "★", Warn = "⚠", Danger = "☠", Error = "✖" }
local GOLD = Color3.fromRGB(236, 196, 112)
-- แถบจางหัวท้าย (ตรงกลางเข้ม -> ขอบใส)
local function ribbonFade(alpha)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.18, alpha), NumberSequenceKeypoint.new(0.82, alpha), NumberSequenceKeypoint.new(1, 1),
	})
end

-- แจ้งเตือนกลางจอ (สไตล์เกมเอาชีวิตรอด): ตัวหนังสือใหญ่ขอบเข้ม บนแถบสีจางตามประเภท + เส้นทองบน/ล่าง · ขึ้นแล้วค่อยจางหายขึ้นด้านบน
function HUD.Notify(text, kind)
	if not HUD.Feed then
		return
	end
	kind = KIND_COLOR[kind] and kind or "Info"
	local col = KIND_COLOR[kind]
	local big = kind == "Danger" or kind == "Reward"
	HUD.FeedOrder += 1
	local slot = UIKit.Frame(HUD.Feed, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = HUD.FeedOrder })
	local band = UIKit.Frame(slot, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = col:Lerp(Color3.new(0, 0, 0), 0.72), BackgroundTransparency = 0 })
	local bg = Instance.new("UIGradient")
	bg.Transparency = ribbonFade(0.25)
	bg.Parent = band
	for _, y in ipairs({ 0, 1 }) do
		local line = UIKit.Frame(band, { Size = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), BackgroundColor3 = kind == "Info" and GOLD or col, BackgroundTransparency = 0 })
		local lg = Instance.new("UIGradient")
		lg.Transparency = ribbonFade(0)
		lg.Parent = line
	end
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 60)
	pad.PaddingRight = UDim.new(0, 60)
	pad.Parent = band
	local g = KIND_GLYPH[kind]
	local label = UIKit.Text(band, {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = big and 25 or 21, Font = UIKit.Fonts.Black, Text = g .. "  " .. text .. "  " .. g, TextColor3 = col, TextTransparency = 1,
	})
	UIKit.TextStroke(label, 2.4, 0.05)
	local sc = Instance.new("UIScale")
	sc.Scale = 1.25
	sc.Parent = slot
	UIKit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	UIKit.Tween(label, 0.25, { TextTransparency = 0 })
	-- เก็บไว้แค่ไม่กี่อันล่าสุด
	local children = {}
	for _, c in ipairs(HUD.Feed:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(children, c)
		end
	end
	if #children > (HUD.Touch and 3 or 4) then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end
	task.delay(big and 6 or 4.5, function()
		if slot.Parent then
			UIKit.Tween(label, 0.6, { TextTransparency = 1 })
			UIKit.Tween(band, 0.6, { BackgroundTransparency = 1 })
			for _, d in ipairs(band:GetDescendants()) do
				if d:IsA("Frame") then
					UIKit.Tween(d, 0.6, { BackgroundTransparency = 1 })
				elseif d:IsA("UIStroke") then
					UIKit.Tween(d, 0.6, { Transparency = 1 })
				end
			end
			task.wait(0.65)
			slot:Destroy()
		end
	end)
end

function HUD.Pickup(id, n)
	if not HUD.PickFeed then
		return
	end
	local f = UIKit.Frame(HUD.PickFeed, { Size = UDim2.fromOffset(210, 32), BackgroundColor3 = Color3.fromRGB(26, 28, 50), BackgroundTransparency = 0.1 })
	UIKit.Corner(f, 14)
	UIKit.Stroke(f, C.Outline, 2, 0)
	local sc = Instance.new("UIScale")
	sc.Scale = 0.5
	sc.Parent = f
	UIKit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	local item = Items.Data[id]
	UIKit.Text(f, {
		Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 17, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Right,
		Text = string.format("+%d %s %s", n, item and item.Thai or id, ICON[id] or ""), TextColor3 = item and item.Color or C.Text,
	})
	task.delay(2.5, function()
		UIKit.Tween(f, 0.4, { BackgroundTransparency = 1 })
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("TextLabel") then
				UIKit.Tween(d, 0.4, { TextTransparency = 1 })
			end
		end
		task.wait(0.45)
		f:Destroy()
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007B"><Properties><string name="Name">ItemIcon</string><ProtectedString name="Source"><![CDATA[--[[
	ItemIcon — รูปไอเทมจากโมเดลจริง (Assets.Items / Assets.Weapons) ใน ViewportFrame
	Make(parent, id, props) -> ViewportFrame (ไม่มีโมเดล = ไอคอนตัวหนังสือตามหมวด)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))

local ItemIcon = {}

local GLYPH = { Resource = "🪵", Food = "🍖", Essence = "✦", Relic = "❤", Medical = "✚", Tool = "⚒", Structure = "🏠" }
local cache = {}

-- โมเดลต้นแบบ (ทำครั้งเดียวต่อไอเทม): ตัดสคริปต์/แสง/อนุภาค ตรึงทุกชิ้น
local function template(id)
	if cache[id] ~= nil then
		return cache[id] or nil
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local src
	for _, folder in ipairs({ "Items", "Weapons" }) do
		local f = assets and assets:FindFirstChild(folder)
		src = src or (f and f:FindFirstChild(id))
	end
	local m
	if src then
		m = Instance.new("Model")
		m.Name = id
		local c = src:Clone()
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Sound") or d:IsA("Trail") or d:IsA("Beam") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		if c:IsA("BasePart") then
			c.Anchored = true
		end
		c.Parent = m
	end
	cache[id] = m or false
	return m
end

function ItemIcon.Make(parent, id, props)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromOffset(40, 40)
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local t = template(id)
	if t then
		local m = t:Clone()
		m.Parent = vp
		local cf, size = m:GetBoundingBox()
		local r = math.max(size.Magnitude / 2, 0.1)
		local cam = Instance.new("Camera")
		cam.FieldOfView = 30
		local dist = r / math.tan(math.rad(15)) * 1.02
		cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.75, 0.55, -1).Unit * dist, cf.Position)
		cam.Parent = vp
		vp.CurrentCamera = cam
		vp.Ambient = Color3.fromRGB(205, 200, 195)
		vp.LightColor = Color3.fromRGB(255, 250, 240)
		vp.LightDirection = Vector3.new(-0.5, -1, 0.4)
	else
		local info = Items.Data[id]
		local t2 = Instance.new("TextLabel")
		t2.Size = UDim2.fromScale(1, 1)
		t2.BackgroundTransparency = 1
		t2.TextScaled = true
		t2.Text = GLYPH[info and info.Category or ""] or "•"
		t2.TextColor3 = info and info.Color or Color3.new(1, 1, 1)
		t2.Parent = vp
	end
	vp.Parent = parent
	return vp
end

return ItemIcon
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007C"><Properties><string name="Name">ItemTooltip</string><ProtectedString name="Source"><![CDATA[--[[
	ItemTooltip — การ์ดรายละเอียดไอเทม
	  PC: ชี้เมาส์ค้างบนไอเทม (กระสอบ/เมนูคราฟต์) -> การ์ดขึ้นข้างเมาส์
	  มือถือ: กดค้าง ~0.45 วิ -> การ์ดขึ้นด้านบนกลางจอ (ปล่อยนิ้วแล้วหายเอง)
	  แถบเครื่องมือ (Backpack ของ Roblox): หยิบเครื่องมือขึ้นมือ -> การ์ดสั้นๆ เหนือแถบ 2.5 วิ
	  ข้อมูลมาจาก Items (Desc/Tools/Structures/Fuel/Food/Heal) + Recipes
	ItemTooltip.Attach(guiObject, itemId) · ItemTooltip.Show(id) · ItemTooltip.Hide()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local UIKit = require(script.Parent.UIKit)

local ItemTooltip = {}
local player = Players.LocalPlayer
local C = UIKit.Colors

local LONG_PRESS = 0.45

---------------------------------------------------------------- ข้อความ
local function num(v)
	if math.floor(v) == v then
		return tostring(v)
	end
	return string.format("%.1f", v)
end

-- คืน { Title, Sub, Category, Desc, Stats = { "..." }, Color }
function ItemTooltip.Info(id)
	local d = Items.Data[id]
	if not d then
		return nil
	end
	local stats = {}
	local t = Items.Tools[id]
	if t then
		table.insert(stats, "⚔ ดาเมจ " .. num(t.Damage))
		table.insert(stats, string.format("⏱ ความเร็ว %.1f ครั้ง/วิ", 1 / math.max(t.Cooldown, 0.05)))
		table.insert(stats, "📏 ระยะ " .. num(t.Range))
		if (t.Chop or 0) > 0 then
			table.insert(stats, "🪓 ตัดไม้ x" .. num(t.Chop))
		end
		if (t.Mine or 0) > 0 then
			table.insert(stats, "⛏ ขุดหิน/แร่ x" .. num(t.Mine))
		end
		if t.Aoe then
			table.insert(stats, "💥 โจมตีเป็นวง " .. num(t.Aoe))
		end
		if t.Burn then
			table.insert(stats, "🔥 เผา " .. num(t.Burn) .. "/วิ")
		end
		if t.Slow then
			table.insert(stats, "🧊 ทำให้ช้าลง")
		end
		if t.Pierce then
			table.insert(stats, "➶ ทะลุ " .. num(t.Pierce) .. " ตัว")
		end
		if t.Light then
			table.insert(stats, "💡 ส่องแสงไล่กวางกลวง")
		end
	end
	local sack = Items.Sacks[id]
	if sack then
		table.insert(stats, "🎒 ความจุ " .. sack .. " ชิ้น")
	end
	if d.Food then
		table.insert(stats, "🍖 อิ่ม +" .. num(d.Food))
	end
	if d.Heal then
		table.insert(stats, (d.Heal >= 0 and "❤ ฟื้นเลือด +" or "💔 เสียเลือด ") .. num(math.abs(d.Heal)))
	end
	if d.Revive then
		table.insert(stats, "✨ ใช้ช่วยเพื่อนที่ล้มได้")
	end
	if d.CooksInto then
		table.insert(stats, "♨ ย่างที่กองไฟได้ " .. Items.DisplayName(d.CooksInto))
	end
	if d.Fuel then
		table.insert(stats, "🔥 เชื้อเพลิง +" .. num(d.Fuel))
	end
	local st = Items.Structures[id]
	if st then
		table.insert(stats, "🛡 HP " .. num(st.Health))
		if st.Damage then
			table.insert(stats, "⚔ ดาเมจ " .. num(st.Damage))
		end
		if st.Range or st.Radius then
			table.insert(stats, "📏 รัศมี " .. num(st.Range or st.Radius))
		end
		if st.Light then
			table.insert(stats, "💡 แสง " .. num(st.Light))
		end
	end
	local el = d.Element
	if el then
		table.insert(stats, (UIKit.ElementIcon[el] or "") .. " ธาตุ" .. (UIKit.ElementThai[el] or el))
	end
	local r = Recipes.ById[id]
	if r then
		table.insert(stats, "🔨 คราฟต์ได้ที่โต๊ะ Lv." .. r.Bench)
	end
	return {
		Title = d.Thai or d.Name or id,
		Sub = d.Name,
		Category = (Items.CategoryThai and Items.CategoryThai[d.Category]) or d.Category or "",
		Desc = (Items.Desc and Items.Desc[id]) or "",
		Stats = stats,
		Color = (el and C.Element[el]) or d.Color or C.Gold,
	}
end

---------------------------------------------------------------- การ์ด
local ui = {}
local current -- itemId ที่โชว์อยู่
local owner -- GuiObject ที่เมาส์ชี้อยู่ (PC)
local hideToken = 0

local function build()
	if ui.Card then
		return
	end
	local gui = UIKit.Screen("ItemTooltip", 70, true)
	ui.Gui = gui
	local card = UIKit.Frame(gui, {
		Size = UDim2.fromOffset(270, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(26, 28, 50),
		BackgroundTransparency = 0.04, Visible = false, ZIndex = 50,
	})
	UIKit.Corner(card, 12)
	ui.Stroke = UIKit.Stroke(card, C.Gold, 2, 0.1)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 12), UDim.new(0, 12), UDim.new(0, 8), UDim.new(0, 10)
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 3)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = card
	local function line(order, size, font, color)
		return UIKit.Text(card, {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = size, Font = font, TextColor3 = color,
			LayoutOrder = order, ZIndex = 51, Text = "",
		})
	end
	ui.Title = line(1, 19, UIKit.Fonts.Black, C.Gold)
	ui.Sub = line(2, 12, UIKit.Fonts.Body, C.TextDim)
	ui.Cat = line(3, 13, UIKit.Fonts.Bold, Color3.fromRGB(150, 210, 255))
	ui.Desc = line(4, 14, UIKit.Fonts.Body, C.Text)
	ui.Stats = line(5, 14, UIKit.Fonts.Bold, Color3.fromRGB(255, 226, 170))
	ui.Card = card
	UIKit.AutoScale(card)
end

local function place()
	local card = ui.Card
	if not (card and card.Visible) then
		return
	end
	local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local sc = card:FindFirstChild("AutoScale")
	local k = sc and sc.Scale or 1
	local w, h = card.AbsoluteSize.X, card.AbsoluteSize.Y
	if w < 1 then
		w, h = 270 * k, 160 * k
	end
	if ui.Mode == "Mouse" then
		local m = UserInputService:GetMouseLocation()
		local x, y = m.X + 18, m.Y + 18
		if x + w > vp.X - 8 then
			x = m.X - w - 12
		end
		if y + h > vp.Y - 8 then
			y = vp.Y - h - 8
		end
		card.Position = UDim2.fromOffset(math.max(8, x), math.max(8, y))
	elseif ui.Mode == "Hotbar" then
		card.Position = UDim2.fromOffset(math.floor((vp.X - w) / 2), math.max(8, vp.Y - h - 100))
	else
		-- มือถือ: ด้านบนกลางจอ (ไม่ทับนิ้ว)
		card.Position = UDim2.fromOffset(math.floor((vp.X - w) / 2), math.floor(vp.Y * 0.2))
	end
end

-- mode: "Mouse" | "Top" | "Hotbar"
function ItemTooltip.Show(id, mode)
	local info = ItemTooltip.Info(id)
	if not info then
		return
	end
	build()
	hideToken += 1
	current = id
	ui.Mode = mode or (UIKit.IsTouch and "Top" or "Mouse")
	ui.Title.Text = info.Title
	ui.Title.TextColor3 = info.Color
	ui.Stroke.Color = info.Color
	ui.Sub.Text = info.Sub or ""
	ui.Sub.Visible = info.Sub ~= nil and info.Sub ~= info.Title
	ui.Cat.Text = "หมวด: " .. info.Category
	ui.Desc.Text = info.Desc
	ui.Desc.Visible = info.Desc ~= ""
	ui.Stats.Text = table.concat(info.Stats, "\n")
	ui.Stats.Visible = #info.Stats > 0
	ui.Card.Visible = true
	place()
	task.defer(place)
end

function ItemTooltip.Hide(id)
	if id and id ~= current then
		return
	end
	current = nil
	owner = nil
	if ui.Card then
		ui.Card.Visible = false
	end
end

-- ซ่อนหลังเวลาผ่านไป (ถ้าไม่มีอะไรมาโชว์ทับ)
local function hideLater(delay)
	hideToken += 1
	local token = hideToken
	task.delay(delay, function()
		if token == hideToken then
			ItemTooltip.Hide()
		end
	end)
end

local function inside(obj, p)
	local a, s = obj.AbsolutePosition, obj.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- ผูกการ์ดกับปุ่ม/การ์ดไอเทม
function ItemTooltip.Attach(obj, id)
	if not (obj and Items.Data[id]) then
		return
	end
	obj.MouseEnter:Connect(function()
		if UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
			return
		end
		owner = obj
		ItemTooltip.Show(id, "Mouse")
	end)
	obj.MouseLeave:Connect(function()
		-- ยังอยู่ในกรอบ (เมาส์ไปชี้ปุ่มลูก) ไม่ต้องซ่อน — RenderStepped จะเช็กเอง
		local m = UserInputService:GetMouseLocation()
		if owner == obj and not inside(obj, m) then
			ItemTooltip.Hide(id)
		end
	end)
	-- กดค้าง (มือถือ)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local start = input.Position
		local alive = true
		local moved, ended
		moved = input.Changed:Connect(function(prop)
			if prop == "Position" and (input.Position - start).Magnitude > 14 then
				alive = false
			elseif prop == "UserInputState" and input.UserInputState ~= Enum.UserInputState.Begin and input.UserInputState ~= Enum.UserInputState.Change then
				alive = false
				if current == id and ui.Mode == "Top" then
					hideLater(1.2)
				end
			end
		end)
		ended = obj.InputEnded:Connect(function(i)
			if i == input then
				alive = false
				if current == id and ui.Mode == "Top" then
					hideLater(1.2)
				end
			end
		end)
		task.delay(LONG_PRESS, function()
			if alive and obj.Parent and obj.Visible then
				ItemTooltip.Show(id, "Top")
			end
		end)
		task.delay(6, function()
			moved:Disconnect()
			ended:Disconnect()
		end)
	end)
end

---------------------------------------------------------------- แถบเครื่องมือ: หยิบของขึ้นมือ -> การ์ดสั้นๆ
function ItemTooltip.Init()
	build()
	RunService.RenderStepped:Connect(function()
		if owner then
			if not (owner.Parent and owner.Visible and inside(owner, UserInputService:GetMouseLocation())) then
				ItemTooltip.Hide()
			else
				place()
			end
		end
	end)
	local function hook(char)
		char.ChildAdded:Connect(function(c)
			local id = c:IsA("Tool") and c:GetAttribute("ItemId")
			if id and Items.Data[id] and player:GetAttribute("InRun") and not owner then
				ItemTooltip.Show(id, "Hotbar")
				hideLater(2.5)
			end
		end)
	end
	player.CharacterAdded:Connect(hook)
	if player.Character then
		hook(player.Character)
	end
end

return ItemTooltip
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007D"><Properties><string name="Name">LobbyUI</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyUI — ปุ่มเมนูล็อบบี้ (ภาพวาดเหรียญไม้+ป้ายไม้ จาก Shared/MenuArt): คลาส / ภารกิจ / ป้าย / ร้านค้า / ตั้งค่า + แคปซูล Ruby มุมขวาบน
	ป้าย = ความสำเร็จที่คำนวณจากสถิติจริงในเซฟ (Shared/Quests.lua Achievements) — ทำครบแล้วกดรับ Ruby ได้ครั้งเดียว (หน้าต่างธีมไม้ WoodKit)
	ภารกิจ = หน้าต่าง QuestUI (LobbyUI.OnQuests) · จุดแดง = มีรางวัลให้รับ (LobbyUI.SetQuestDot)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Classes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Classes"))
local Quests = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Quests"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)
local MenuArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MenuArt"))

local LobbyUI = {}

local player = Players.LocalPlayer
local C = Color3.fromRGB
local profile
local ui = {}

-- ความสำเร็จ: Quests.Achievements { Id, Text, Stat, Need, Ruby } (server ตรวจซ้ำตอนกดรับ)
local BADGES = Quests.Achievements

-- ปุ่มเมนูซ้ายเปิดได้ทีละหน้า: กดเมนูใหม่ = ปิดหน้าอื่นก่อน
-- แต่ละหน้าลงทะเบียนตัวปิดไว้ที่ LobbyUI.Closers[ชื่อปุ่ม] (Classes / Quests / Badges / Shop / Settings)
LobbyUI.Closers = {}

function LobbyUI.CloseMenus(except)
	for name, fn in pairs(LobbyUI.Closers) do
		if name ~= except then
			local ok, err = pcall(fn)
			if not ok then
				warn("[AS] close menu", name, err)
			end
		end
	end
end

local function statOf(key)
	return Quests.StatOf(profile, key)
end

-- ปุ่มเมนู: ไม่มีกล่องครอบ · วงกลมสีนุ่มๆ ไล่เงา + ขอบขาวบาง + ไอคอนใหญ่ + ชื่อตัวขาวขอบดำใต้วง
-- ชี้แล้วขยายนิดเดียว กดแล้วยุบนิดเดียว (ไม่เด้งไปมาเอง)
local function dockButton(parent, order, icon, name, color, onClick)
	local b = Instance.new("TextButton")
	b.Name = "Dock_" .. name
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Size = UDim2.fromOffset(84, 98)
	b.LayoutOrder = order
	b.Parent = parent
	local circle = UIKit.Frame(b, { Size = UDim2.fromOffset(68, 68), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), BackgroundColor3 = color, BackgroundTransparency = 0, ZIndex = 2 })
	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(1, 0)
	cc.Parent = circle
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(C(255, 255, 255), C(150, 150, 160))
	grad.Rotation = 90
	grad.Parent = circle
	local rim = Instance.new("UIStroke")
	rim.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rim.Color = C(255, 255, 255)
	rim.Thickness = 2.5
	rim.Transparency = 0.25
	rim.Parent = circle
	-- เงาวาวครึ่งบน
	local gloss = UIKit.Frame(circle, { Size = UDim2.new(0.72, 0, 0.36, 0), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.07, 0), BackgroundColor3 = C(255, 255, 255), BackgroundTransparency = 0.82, ZIndex = 3 })
	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(1, 0)
	gc.Parent = gloss
	if icon == "Ruby" or icon == "Shield" or icon == "Trophy" or icon == "Scroll" then
		UIKit.Icon(circle, icon, 50, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 4 })
	else
		UIKit.Text(circle, { Size = UDim2.fromScale(1, 1), Text = icon, TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
	end
	local label = UIKit.Text(b, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 72), Text = name, Font = UIKit.Fonts.Title, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C(255, 255, 255), ZIndex = 3 })
	label:FindFirstChildOfClass("UIStroke").Thickness = 2.2
	local sc = Instance.new("UIScale")
	sc.Parent = circle
	b.MouseEnter:Connect(function()
		UIKit.Tween(sc, 0.15, { Scale = 1.08 })
	end)
	b.MouseLeave:Connect(function()
		UIKit.Tween(sc, 0.15, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		UIKit.Tween(sc, 0.08, { Scale = 0.94 })
	end)
	b.Activated:Connect(function()
		UIKit.Tween(sc, 0.12, { Scale = 1 })
		if onClick then
			onClick()
		end
	end)
	local dot = UIKit.Frame(circle, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -4), BackgroundColor3 = UIKit.Colors.Red, BackgroundTransparency = 0, Visible = false, ZIndex = 8 })
	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = dot
	UIKit.Stroke(dot, C(255, 255, 255), 2, 0)
	if onClick then
		UIKit.EnsureTouchSize(b, 44, onClick) -- แถบเมนูถูกย่อตามจอ: พื้นที่แตะไม่เล็กกว่า 44px
	end
	local dt = UIKit.Text(dot, { Size = UDim2.fromScale(1, 1), Text = "!", Font = UIKit.Fonts.Title, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9 })
	return b, dot, dt
end

-- ปุ่มเมนูแบบภาพวาด (เหรียญไม้ + ป้ายไม้ + ธง) จาก Shared/MenuArt — โหลดรูปไม่ได้คืน nil (ใช้ปุ่มแบบเดิมแทน)
local ART_W = 270
local function artButton(parent, order, art, onClick)
	local ok, img = pcall(MenuArt.Image, art)
	local size = MenuArt.Size[art]
	if not ok or not img or not size then
		return nil
	end
	local b = Instance.new("ImageButton")
	b.Name = "Dock_" .. art
	b.BackgroundTransparency = 1
	b.AutoButtonColor = false
	b.ImageContent = Content.fromObject(img)
	b.Size = UDim2.fromOffset(ART_W, math.floor(ART_W * size.Y / size.X))
	b.LayoutOrder = order
	b.Parent = parent
	local sc = Instance.new("UIScale")
	sc.Parent = b
	b.MouseEnter:Connect(function()
		UIKit.Tween(sc, 0.15, { Scale = 1.05 })
		UIKit.Tween(b, 0.15, { ImageColor3 = C(255, 255, 255) })
	end)
	b.MouseLeave:Connect(function()
		UIKit.Tween(sc, 0.15, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		UIKit.Tween(sc, 0.08, { Scale = 0.95 })
		b.ImageColor3 = C(225, 225, 225)
	end)
	b.Activated:Connect(function()
		UIKit.Tween(sc, 0.12, { Scale = 1 })
		b.ImageColor3 = C(255, 255, 255)
		if onClick then
			onClick()
		end
	end)
	-- จุดแจ้งเตือนบนขอบเหรียญ (มุมขวาบนของวงกลมด้านซ้าย)
	local dot = UIKit.Frame(b, { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0.3, -4, 0, 0), BackgroundColor3 = UIKit.Colors.Red, BackgroundTransparency = 0, Visible = false, ZIndex = 8 })
	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = dot
	UIKit.Stroke(dot, C(255, 255, 255), 2, 0)
	local dt = UIKit.Text(dot, { Size = UDim2.fromScale(1, 1), Text = "!", Font = UIKit.Fonts.Title, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9 })
	if onClick then
		UIKit.EnsureTouchSize(b, 44, onClick)
	end
	return b, dot, dt
end

function LobbyUI.Build(gui, handlers)
	local root = Instance.new("Frame")
	root.Name = "LobbyUI"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	ui.Root = root
	-- แถบเมนูซ้าย (แนวตั้ง กลางจอ)
	local side = Instance.new("Frame")
	side.BackgroundTransparency = 1
	side.AnchorPoint = Vector2.new(0, 0.5)
	side.Position = UDim2.new(0, 22, 0.52, 0)
	local useArt = MenuArt.Image("Classes") ~= nil
	side.Size = useArt and UDim2.fromOffset(ART_W + 10, 600) or UDim2.fromOffset(90, 510)
	side.Parent = root
	UIKit.AutoScale(side)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = side
	-- ปุ่มภาพวาดก่อน ไม่ได้ค่อยใช้ปุ่มวงกลมแบบเดิม
	local function menuButton(order, art, icon, name, color, handler)
		local function onClick()
			LobbyUI.CloseMenus(art)
			if handler then
				handler()
			end
		end
		if useArt then
			local b, d, t = artButton(side, order, art, onClick)
			if b then
				return b, d, t
			end
		end
		return dockButton(side, order, icon, name, color, onClick)
	end
	menuButton(1, "Classes", "Shield", "คลาส", C(230, 132, 64), handlers.Classes)
	local _, qdot, qdotText = menuButton(2, "Quests", "Scroll", "ภารกิจ", C(236, 178, 52), function()
		if LobbyUI.OnQuests then
			LobbyUI.OnQuests()
		end
	end)
	ui.QuestDot, ui.QuestDotText = qdot, qdotText
	local _, dot, dotText = menuButton(3, "Badges", "Trophy", "ป้าย", C(146, 104, 222), function()
		ui.Badges.Visible = not ui.Badges.Visible
		if ui.Badges.Visible then
			UIKit.Pop(ui.Badges)
		end
		LobbyUI.Refresh()
	end)
	ui.BadgeDot, ui.BadgeDotText = dot, dotText
	menuButton(4, "Shop", "Ruby", "ร้านค้า", C(64, 182, 120), handlers.Shop)
	menuButton(5, "Settings", "⚙", "ตั้งค่า", C(74, 132, 220), handlers.Settings)

	-- Ruby: แคปซูลมุมซ้ายบน + ปุ่ม + (เปิดร้านค้า)
	-- (ธีมไม้เดียวกับหน้าต่างร้านค้า: ไม้เข้มขอบทอง + ปุ่ม + แดง)
	local pill = WoodKit.Frame(root, { Size = UDim2.fromOffset(190, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 20), BackgroundColor3 = Color3.fromRGB(42, 28, 18) })
	UIKit.AutoScale(pill)
	WoodKit.Corner(pill, "round")
	WoodKit.Stroke(pill, WoodKit.Colors.GoldDark, 3, 0)
	UIKit.Icon(pill, "Ruby", 60, { Position = UDim2.fromOffset(-30, -9), ZIndex = 3 })
	ui.Gems = UIKit.Text(pill, { Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(34, 0), Text = "0", Font = UIKit.Fonts.Title, TextSize = 28 })
	local plus = WoodKit.Button(pill, "Red", { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -41, 0, 5), Text = "+", TextSize = 28 }, handlers.Shop)
	plus:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	UIKit.EnsureTouchSize(plus, 44, handlers.Shop)

	-- หน้าต่างป้ายความสำเร็จ (ธีมกรอบไม้)
	local win = WoodKit.Window(root, { Name = "BadgeWindow", Size = Vector2.new(760, 600), Title = "🏅 ป้ายความสำเร็จ", OnClose = function()
		ui.Badges.Visible = false
	end })
	local panel = win.Frame
	UIKit.RegisterWindow(panel)
	LobbyUI.Closers.Badges = function()
		panel.Visible = false
	end
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(30, 50)
	scroll.Size = UDim2.new(1, -60, 1, -78)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = WoodKit.Colors.Gold
	scroll.Parent = win.Body
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, 10)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = scroll
	local sp = Instance.new("UIPadding")
	sp.PaddingTop, sp.PaddingLeft, sp.PaddingRight, sp.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 12), UDim.new(0, 6)
	sp.Parent = scroll
	ui.BadgeRows = {}
	for i, b in ipairs(BADGES) do
		local row = WoodKit.Parchment(scroll, { Size = UDim2.new(1, 0, 0, 76), LayoutOrder = i })
		WoodKit.Medallion(row, "Trophy", 56, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 2 }, C(96, 40, 22))
		local name = WoodKit.Ink(row, { Position = UDim2.fromOffset(80, 8), Size = UDim2.new(1, -300, 0, 28), Text = b.Text, TextSize = 20 })
		local bar = UIKit.Bar(row, { Size = UDim2.new(1, -300, 0, 18), Position = UDim2.fromOffset(80, 44), Color = WoodKit.Colors.Gold, Label = "" })
		local prog = WoodKit.Ink(row, { Position = UDim2.new(1, -214, 0, 0), Size = UDim2.fromOffset(84, 76), Text = "", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center })
		local claim = WoodKit.Button(row, "Off", { Size = UDim2.fromOffset(120, 44), Position = UDim2.new(1, -130, 0.5, -22), Text = "♦️ " .. b.Ruby, TextSize = 18, ZIndex = 4 }, function()
			local r = ui.BadgeRows[i]
			if r and r.Ready then
				r.Ready = false
				Remotes.Get("ClaimAchievement"):FireServer(b.Id)
			end
		end)
		ui.BadgeRows[i] = { Row = row, Name = name, Prog = prog, Bar = bar, Claim = claim }
	end
	ui.Badges = panel
end

function LobbyUI.Refresh()
	if not ui.Root then
		return
	end
	ui.Gems.Text = tostring(player:GetAttribute("Diamonds") or (profile and profile.Diamonds) or 0)
	local ready = 0
	local claimed = (profile and profile.AchClaimed) or {}
	for i, b in ipairs(BADGES) do
		local need = Quests.NeedOf(b, #Classes.Order)
		local v = statOf(b.Stat)
		local done = v >= need
		local got = claimed[b.Id] == true
		local canClaim = done and not got and profile ~= nil
		ready += canClaim and 1 or 0
		local r = ui.BadgeRows[i]
		r.Ready = canClaim
		-- รับได้ขึ้นบนสุด · ยังไม่ครบตรงกลาง · รับแล้วไว้ล่างสุด
		r.Row.LayoutOrder = (canClaim and 0 or (got and 2000 or 1000)) + i
		if ui.Badges.Visible then
			r.Prog.Text = done and "✅ สำเร็จ" or string.format("%d/%d", math.min(v, need), need)
			r.Prog.TextColor3 = done and WoodKit.Colors.Good or WoodKit.Colors.Ink
			r.Name.TextTransparency = done and 0 or 0.2
			r.Bar.Set(math.min(v / need, 1))
			r.Bar.Fill.BackgroundColor3 = done and C(110, 200, 80) or WoodKit.Colors.Gold
			-- กระดาษ: รับได้ = ทองสว่าง · สำเร็จแล้ว = เขียวอ่อน · ยังไม่ครบ = กระดาษปกติ
			r.Row.BackgroundColor3 = canClaim and C(255, 228, 150) or (done and C(206, 216, 168) or WoodKit.Colors.Parch)
			if got then
				r.Claim.Text = "✔ รับแล้ว"
				WoodKit.Style(r.Claim, "Green")
			elseif canClaim then
				r.Claim.Text = "รับ ♦️ " .. b.Ruby
				WoodKit.Style(r.Claim, "Red")
			else
				r.Claim.Text = "♦️ " .. b.Ruby
				WoodKit.Style(r.Claim, "Off")
			end
		end
	end
	ui.BadgeDot.Visible = ready > 0
	ui.BadgeDotText.Text = tostring(ready)
end

function LobbyUI.SetProfile(p)
	profile = p
	LobbyUI.Refresh()
end

-- จุดแดงบนปุ่ม "ภารกิจ" (QuestUI นับรางวัลที่รับได้)
function LobbyUI.SetQuestDot(n)
	if ui.QuestDot then
		ui.QuestDot.Visible = (n or 0) > 0
		ui.QuestDotText.Text = tostring(math.min(n or 0, 99))
	end
end

-- ซ่อนตอนอยู่ในแมพ หรือเปิดร้านคลาสอยู่
function LobbyUI.SetVisible(v)
	if ui.Root then
		ui.Root.Visible = v
		if not v then
			ui.Badges.Visible = false
			if LobbyUI.OnHidden then
				LobbyUI.OnHidden()
			end
		end
	end
end

function LobbyUI.Init(gui, handlers)
	LobbyUI.Build(gui, handlers)
	player:GetAttributeChangedSignal("Diamonds"):Connect(LobbyUI.Refresh)
	LobbyUI.Refresh()
end

return LobbyUI
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX0000007E"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	ANIMAL SURVIVAL — client bootstrap
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- ปิดหลอดเลือด CoreGui ของ Roblox (เกมมีหลอดเลือดเอง) — ตัวนี้มีขอบจอแดงกะพริบทุกครั้งที่ Health ลด
--   วาดทับทุกหน้าจอรวมถึงหน้าโหลด และเด้งตอนเกมปรับ Health/MaxHealth ตอนเกิด (ไม่ได้โดนตีจริง)
task.spawn(function()
	local StarterGui = game:GetService("StarterGui")
	for _ = 1, 20 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Health, false) then
			break
		end
		task.wait(0.5)
	end
end)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local state = ReplicatedStorage:WaitForChild("GameState")

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local HUD = require(Client:WaitForChild("HUD"))
local Cinematics = require(Client:WaitForChild("Cinematics"))
local AtmosphereController = require(Client:WaitForChild("AtmosphereController"))
local AmbientFX = require(Client:WaitForChild("AmbientFX"))
local AnimalAnimator = require(Client:WaitForChild("AnimalAnimator"))
local CombatClient = require(Client:WaitForChild("CombatClient"))
local Menus = require(Client:WaitForChild("Menus"))
local MapUI = require(Client:WaitForChild("MapUI"))
local SkinStreamer = require(Client:WaitForChild("SkinStreamer"))
local DeathClient = require(Client:WaitForChild("DeathClient"))
local ClientSettings = require(Client:WaitForChild("ClientSettings"))
local SoundController = require(Client:WaitForChild("SoundController"))
local SettingsUI = require(Client:WaitForChild("SettingsUI"))
local Tutorial = require(Client:WaitForChild("Tutorial"))
local MobileControls = require(Client:WaitForChild("MobileControls"))
local ItemTooltip = require(Client:WaitForChild("ItemTooltip"))
local AutoTool = require(Client:WaitForChild("AutoTool"))
local TeamPing = require(Client:WaitForChild("TeamPing"))
local RejoinUI = require(Client:WaitForChild("RejoinUI"))

local function safe(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[AS] client init " .. name .. ":", err)
	end
end

-- ล็อกหน้าจอ (Shift Lock ของ Roblox) ใช้ปุ่ม Ctrl แทน Shift (Shift = วิ่ง)
-- MouseLockController อ่านปุ่มจาก StringValue "BoundKeys" ข้างในตัวมัน และฟังตอนค่าเปลี่ยน
task.spawn(function()
	local pm = Client.Parent:WaitForChild("PlayerModule", 30)
	local camMod = pm and pm:WaitForChild("CameraModule", 10)
	local mlc = camMod and camMod:WaitForChild("MouseLockController", 10)
	if not mlc then
		warn("[AS] ไม่เจอ MouseLockController — ปุ่มล็อกหน้าจอยังเป็น Shift")
		return
	end
	local keys = mlc:FindFirstChild("BoundKeys")
	if not (keys and keys:IsA("StringValue")) then
		keys = Instance.new("StringValue")
		keys.Name = "BoundKeys"
		keys.Parent = mlc
	end
	keys.Value = "LeftControl,RightControl"
end)

safe("Cinematics", Cinematics.Init, state)
safe("HUD", HUD.Init, state)
safe("Atmosphere", AtmosphereController.Init, state)
safe("AmbientFX", AmbientFX.Init, state, AtmosphereController)
safe("Animator", AnimalAnimator.Init)
safe("MobBars", require(Client:WaitForChild("MobBars")).Init) -- หลอดเลือดบนหัวสัตว์/มอนทุกตัว
safe("Skins", SkinStreamer.Init)
safe("Combat", CombatClient.Init, state, HUD)
safe("Menus", Menus.Init, state, HUD)
safe("Map", MapUI.Init, state, HUD, AtmosphereController)
safe("FogWall", require(Client:WaitForChild("FogWall")).Init, state)
safe("WorldEvents", require(Client:WaitForChild("WorldEventsClient")).Init, state, HUD, MapUI, CombatClient)
safe("Dev", require(script.Parent:WaitForChild("DevPanel")).Init)
safe("PadUI", require(Client:WaitForChild("PadUI")).Init)
safe("Death", DeathClient.Init)
Cinematics.Death = DeathClient
safe("Sound", SoundController.Init, state)
SoundController.Biome = function()
	return AtmosphereController.Biome
end
safe("Tutorial", Tutorial.Init, UIKit.Screen("Tutorial", 60))
safe("Settings", SettingsUI.Init, UIKit.Screen("Settings", 45), { Tutorial = Tutorial.Open, GearParent = HUD.RightCard })
Menus.OnSettings = SettingsUI.Toggle
-- เมนูซ้ายในล็อบบี้เปิดได้ทีละหน้า (กดเมนูอื่น = ปิดหน้าตั้งค่า)
require(Client:WaitForChild("LobbyUI")).Closers.Settings = SettingsUI.Close
safe("Mobile", MobileControls.Init, { Menus = Menus, Map = MapUI, HUD = HUD, Combat = CombatClient })
-- ภารกิจ / ล็อกอิน 7 วัน / Season Pass / โค้ด (ปุ่ม "ภารกิจ" ในล็อบบี้)
local QuestUI = require(Client:WaitForChild("QuestUI"))
safe("Quests", QuestUI.Init, UIKit.Screen("Quests", 33))
-- ความสะดวก: การ์ดรายละเอียดไอเทม / สลับเครื่องมืออัตโนมัติ / ปิงบอกทีม / กลับเข้ารอบเดิม
safe("Tooltip", ItemTooltip.Init)
CombatClient.AutoTool = AutoTool
AutoTool.Blocked = function()
	return Menus.IsBuilding()
end
safe("AutoTool", AutoTool.Init, CombatClient.Swing)
safe("TeamPing", TeamPing.Init, state, HUD, MapUI, SoundController)
safe("Rejoin", RejoinUI.Init)

-- การตั้งค่า -> ระบบต่างๆ
local function applySetting(key, value)
	if key == "Shake" then
		CombatClient.ShakeEnabled = value ~= false
	elseif key == "Hints" then
		HUD.ShowHints = value ~= false
	elseif key == "Graphics" or key == "Quality" then
		AmbientFX.RateMult = ClientSettings.ParticleMult or 1
	end
end
ClientSettings.OnChanged(applySetting)
for _, k in ipairs({ "Shake", "Hints" }) do
	applySetting(k, ClientSettings.Get(k))
end
pcall(ClientSettings.ApplyGraphics)

-- เสียง: ปุ่ม UI / หน้าต่างเด้ง / แจ้งเตือน / เก็บของ
UIKit.OnAnyClick = function()
	SoundController.Play("UiClick")
end
UIKit.OnPop = function()
	SoundController.Play("UiOpen")
end
do
	local notify, pickup = HUD.Notify, HUD.Pickup
	HUD.Notify = function(text, kind)
		notify(text, kind)
		if kind == "Reward" then
			SoundController.Play("Reward")
		elseif kind ~= "Info" then
			SoundController.Play("Notify", (kind == "Danger" or kind == "Error") and 0.75 or 1)
		end
	end
	HUD.Pickup = function(id, n)
		pickup(id, n)
		SoundController.Play("Pickup", 0.9 + math.random() * 0.25)
	end
end

Remotes.Get("Notify").OnClientEvent:Connect(function(text, kind)
	HUD.Notify(text, kind)
end)
Remotes.Get("Inventory").OnClientEvent:Connect(function(data)
	local bag, camp = data.Bag or {}, data.Camp or {}
	local merged = {}
	for id, n in pairs(camp) do
		merged[id] = n
	end
	for id, n in pairs(bag) do
		merged[id] = (merged[id] or 0) + n
	end
	HUD.SetInventory(merged)
	HUD.SetSack(data.Used or 0, data.Cap or 0)
	Menus.SetInventory(merged, bag, camp, data.Used, data.Cap)
end)
-- กันตกทะลุโลก (ฝั่งเครื่องผู้เล่น ซึ่งรู้ว่าพื้นโหลดถึงหรือยัง):
--  ตอนเกิด/วาร์ป: ตรึงตัวจนกว่าจะมีพื้นใต้เท้า · ถ้าร่วงลงต่ำผิดปกติ: ดึงกลับแคมป์แล้วตรึงรอพื้นโหลด
do
	local Players = game:GetService("Players")
	local Workspace = game:GetService("Workspace")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
	local player = Players.LocalPlayer
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local function groundBelow(root)
		rp.FilterDescendantsInstances = { player.Character }
		return Workspace:Raycast(root.Position, Vector3.new(0, -60, 0), rp) ~= nil
	end
	local function holdUntilGround(root)
		root.Anchored = true
		local t0 = os.clock()
		while root.Parent and os.clock() - t0 < 12 and not groundBelow(root) do
			task.wait(0.2)
		end
		task.wait(0.2)
		if root.Parent then
			root.Anchored = false
		end
	end
	local function watch(char)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not root then
			return
		end
		task.wait(0.1)
		if not groundBelow(root) then
			holdUntilGround(root)
		end
		while char.Parent and root.Parent do
			task.wait(0.25)
			if player:GetAttribute("InRun") and root.Position.Y < Config.WaterLevel - 120 then
				local state = ReplicatedStorage:FindFirstChild("GameState")
				local camp = state and state:GetAttribute("CampPos")
				if camp then
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.new(camp + Vector3.new(math.random(-8, 8), 6, math.random(-8, 8)))
					pcall(function()
						player:RequestStreamAroundAsync(camp, 10)
					end)
					holdUntilGround(root)
				end
			end
		end
	end
	player.CharacterAdded:Connect(function(c)
		task.spawn(watch, c)
	end)
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		local c = player.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if root then
			task.delay(0.3, function()
				if root.Parent and not groundBelow(root) then
					holdUntilGround(root)
				end
			end)
		end
	end)
	if player.Character then
		task.spawn(watch, player.Character)
	end
end

local holdingSack
-- ถือกระสอบ: คลิกของบนพื้น/กองไฟ/เครื่องบด + E เก็บ + F ทิ้ง (แบบ 99 Nights · ไม่มีหน้ารายการของ)
do
	local Players = game:GetService("Players")
	local Workspace = game:GetService("Workspace")
	local player = Players.LocalPlayer
	local mouse = player:GetMouse()
	holdingSack = false
	-- ปุ่ม E/R บนของที่ตก: เปิดเฉพาะชิ้นที่โฟกัส (กรอบขาว) ชิ้นเดียว -> กดแล้วได้ชิ้นที่เห็นแน่ ๆ
	local focus
	local function isDropPrompt(d)
		return d:IsA("ProximityPrompt") and (d.Name == "Pickup" or d.Name == "Use")
	end
	-- ปุ่ม E เก็บ = เฉพาะตอนถือกระสอบในมือ (แบบ 99 Nights) · ปุ่มกิน/ใช้ = ได้ตลอด
	local function setPrompts(m, on)
		for _, d in ipairs(m and m:GetDescendants() or {}) do
			if isDropPrompt(d) then
				d.Enabled = on and (d.Name ~= "Pickup" or holdingSack)
			end
		end
	end
	local function hasUse(m)
		for _, d in ipairs(m and m:GetDescendants() or {}) do
			if d:IsA("ProximityPrompt") and d.Name == "Use" then
				return true
			end
		end
		return false
	end
	local function dropOf(inst)
		local drops = Workspace:FindFirstChild("Drops")
		while inst and drops and inst.Parent ~= drops do
			inst = inst.Parent
		end
		return drops and inst and inst:IsA("Model") and inst or nil
	end
	task.spawn(function()
		local drops = Workspace:WaitForChild("Drops", 60)
		if drops then
			drops.DescendantAdded:Connect(function(d)
				if isDropPrompt(d) then
					d.Enabled = focus ~= nil and d:IsDescendantOf(focus) and (d.Name ~= "Pickup" or holdingSack)
				end
			end)
			for _, d in ipairs(drops:GetDescendants()) do
				if isDropPrompt(d) then
					d.Enabled = false
				end
			end
		end
	end)
	-- กรอบขาวรอบของบนพื้นที่ "โฟกัสอยู่" (แบบเกมเอาชีวิตรอดซอมบี้) — ขึ้นตลอด ไม่ต้องถือกระสอบ
	-- เมาส์ชี้ของในระยะเก็บ > ไม่งั้นเลือกชิ้นใกล้สุดที่หันหน้ากล้องไปหา
	do
		local PICK_RANGE = 20 -- ตรงกับ DropService
		local FOCUS_RANGE = 12 -- ระยะเลือกอัตโนมัติ = ระยะปุ่ม E (PROMPT_RANGE ใน DropService)
		-- Highlight ใส่ไว้ในโมเดลของที่โฟกัสเลย (ใส่ใน Camera แล้วไม่ขึ้น) · ของโดนเก็บ/ลบ = กรอบหายตาม แล้วสร้างใหม่
		local hl
		local function makeHighlight()
			hl = Instance.new("Highlight")
			hl.Name = "PickupHighlight"
			hl.FillColor, hl.FillTransparency = Color3.new(1, 1, 1), 0.9
			hl.OutlineColor, hl.OutlineTransparency = Color3.new(1, 1, 1), 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Enabled = false
		end
		makeHighlight()
		local target, nextScan, t0 = nil, 0, os.clock()
		game:GetService("RunService").RenderStepped:Connect(function()
			local now = os.clock()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root or player:GetAttribute("Dead") or player:GetAttribute("Downed") then
				target = nil
			elseif now >= nextScan then
				nextScan = now + 0.1
				target = nil
				local m = dropOf(mouse.Target)
				if m and m.PrimaryPart and (m.PrimaryPart.Position - root.Position).Magnitude <= PICK_RANGE then
					target = m
				else
					local drops = Workspace:FindFirstChild("Drops")
					local look = Workspace.CurrentCamera.CFrame.LookVector
					look = Vector3.new(look.X, 0, look.Z).Unit
					local best = math.huge
					for _, d in ipairs(drops and drops:GetChildren() or {}) do
						local p = d:IsA("Model") and d.PrimaryPart
						if p then
							local off = p.Position - root.Position
							local flat = Vector3.new(off.X, 0, off.Z)
							local dist = flat.Magnitude
							if dist <= FOCUS_RANGE and math.abs(off.Y) < 8 then
								-- ของที่อยู่ตรงหน้าได้เปรียบ ของข้างหลังโดนลดคะแนน
								local facing = dist > 0.5 and look:Dot(flat.Unit) or 1
								local score = dist * (1.6 - facing)
								if score < best then
									best, target = score, d
								end
							end
						end
					end
				end
			end
			if target and not (target.Parent and target.PrimaryPart) then
				target = nil
			end
			if not hl.Parent and focus ~= nil then
				-- โมเดลเดิมถูกทำลาย (เก็บไปแล้ว) กรอบหายไปด้วย
				focus = nil
				makeHighlight()
			end
			if focus ~= target then
				setPrompts(focus, false)
				focus = target
				setPrompts(focus, true)
				hl.Adornee = target
				hl.Parent = target
				t0 = now
			end
			-- กรอบขาว: ถือกระสอบ หรือของชิ้นนั้นกิน/ใช้ได้
			hl.Enabled = target ~= nil and (holdingSack or hasUse(target))
			-- กระพริบขอบเบา ๆ ให้สะดุดตา
			hl.OutlineTransparency = 0.15 - 0.15 * math.cos((now - t0) * 5)
		end)
	end
	-- F = เอาของออกจากกระสอบ (ชิ้นล่าสุด) · ยืนใกล้กองไฟ = โยนเข้ากองไฟ
	game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
		if gp or input.KeyCode ~= Enum.KeyCode.F then
			return
		end
		if holdingSack and player:GetAttribute("InRun") then
			Remotes.Get("DropItem"):FireServer(nil, 1)
		end
	end)
	local function hookTool(tool)
		if not (tool:IsA("Tool") and tool:GetAttribute("Kind") == "Sack") or tool:GetAttribute("SackHooked") then
			return
		end
		tool:SetAttribute("SackHooked", true)
		tool.Equipped:Connect(function()
			holdingSack = true
			setPrompts(focus, true) -- เปิดปุ่ม E เก็บของชิ้นที่โฟกัสอยู่ทันที
		end)
		tool.Unequipped:Connect(function()
			holdingSack = false
			setPrompts(focus, true)
		end)
		tool.Activated:Connect(function()
			local target = mouse.Target
			-- คลิกกองไฟ = โยนไม้/ถ่าน/เนื้อดิบจากกระสอบเข้าไป
			local camp = Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Sites") and Workspace.World.Sites:FindFirstChild("Camp")
			local fireModel = camp and camp:FindFirstChild("Campfire")
			if target and fireModel and (target:IsDescendantOf(fireModel) or (camp:FindFirstChild("CampfireRing") and target:IsDescendantOf(camp.CampfireRing))
				or (fireModel.PrimaryPart and (mouse.Hit.Position - fireModel.PrimaryPart.Position).Magnitude < 6)) then
				Remotes.Get("ThrowFuel"):FireServer()
				return
			end
			-- คลิกเครื่องย่อย = โยนวัตถุดิบลงช่องบด
			local bench = camp and camp:FindFirstChild("Workbench")
			local hopper = bench and bench:FindFirstChild("Hopper")
			local crafterModel = bench and bench:FindFirstChild("CrafterModel")
			if target and hopper and (target == hopper or (crafterModel and target:IsDescendantOf(crafterModel) and (mouse.Hit.Position - hopper.Position).Magnitude < 12)) then
				Remotes.Get("ThrowGrind"):FireServer()
				return
			end
			-- คลิก = เก็บชิ้นที่มีกรอบขาวอยู่ (ไม่ต้องเล็งโดนเป๊ะ ๆ)
			target = focus or dropOf(target)
			if target then
				Remotes.Get("PickupDrop"):FireServer(target)
			end
		end)
	end
	local function hookContainer(c)
		for _, t in ipairs(c:GetChildren()) do
			hookTool(t)
		end
		c.ChildAdded:Connect(hookTool)
	end
	hookContainer(player:WaitForChild("Backpack"))
	player.CharacterAdded:Connect(function(char)
		hookContainer(char)
		hookContainer(player:WaitForChild("Backpack"))
	end)
	if player.Character then
		hookContainer(player.Character)
	end
end

Remotes.Get("Cinematic").OnClientEvent:Connect(function(kind, data)
	local ok, err = pcall(Cinematics.Handle, kind, data or {}, Menus, CombatClient)
	if not ok then
		warn("[AS] cinematic", kind, err)
	end
	pcall(SoundController.OnCinematic, kind, data or {})
end)
Remotes.Get("HitFx").OnClientEvent:Connect(function(kind, data)
	CombatClient.HandleFx(kind, data or {}, HUD)
	if kind == "Eat" or kind == "Heal" then
		SoundController.Play(kind)
	end
end)
Remotes.Get("Profile").OnClientEvent:Connect(function(profile)
	Menus.SetProfile(profile)
end)

-- หลังโหลดเสร็จ: เปิดหน้าเลือกคลาสครั้งแรก
Cinematics.OnLoaded = function()
	task.spawn(function()
		local ok, profile = pcall(function()
			return Remotes.Get("GetProfile"):InvokeServer()
		end)
		if ok and profile then
			Menus.SetProfile(profile)
			ClientSettings.Load(profile.Settings)
			-- ครั้งแรก: หน้าสอนเล่นแบบช่องการ์ตูน
			if not profile.TutorialSeen and not ReplicatedStorage:FindFirstChild("ASAutoTest") then
				task.wait(0.6)
				Tutorial.Open()
			end
		end

	end)
end


-- กันตกทะลุโลก: ล็อบบี้อยู่ไกลจากแมพ (StreamingEnabled) -> ตรึงตัวไว้จนพื้นใต้เท้าโหลดมาถึงเครื่องจริง
local function holdUntilGround(char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	task.wait(0.15) -- รอ server ย้ายตัวไปจุดเกิดก่อน
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local held = false
	local t0 = os.clock()
	while char.Parent and os.clock() - t0 < 15 do
		if workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params) then
			break
		end
		held = true
		root.Anchored = true
		task.wait(0.1)
	end
	if held and root.Parent then
		root.Anchored = false
	end
end
Players.LocalPlayer.CharacterAdded:Connect(function(char)
	task.spawn(holdUntilGround, char)
end)

do
	local onLoaded = Cinematics.OnLoaded
	Cinematics.OnLoaded = function()
		if onLoaded then
			onLoaded()
		end
		QuestUI.OnLoaded()
	end
end

local _ = UIKit
print("[AS] client ready")
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000007F"><Properties><string name="Name">MapUI</string><ProtectedString name="Source"><![CDATA[--[[
	MapUI — แผนที่ใหญ่ (M) + การค้นพบสถานที่ + ชื่อเขตตอนเดินเข้าไบโอม (แบบ Souls)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Biomes = require(Shared.Biomes)
local UIKit = require(script.Parent.UIKit)

local MapUI = {}
MapUI.ExtraMarkers = {} -- ระบบอื่นเพิ่มหมุดได้: fn(marker, place, discovered) (WorldEventsClient)
local player = Players.LocalPlayer
local C = UIKit.Colors
local N = 56

local BIOME_MAP_COLOR = {
	Heart = Color3.fromRGB(120, 170, 70),
	Earth = Color3.fromRGB(50, 110, 46),
	Water = Color3.fromRGB(226, 210, 160),
	Air = Color3.fromRGB(205, 214, 230),
	Fire = Color3.fromRGB(70, 50, 48),
}

function MapUI.Init(state, hud, atmosphere)
	MapUI.State = state
	local gui = UIKit.Screen("MapUI", 25)
	local panel = UIKit.Frame(gui, { Size = UDim2.fromOffset(620, 660), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0.05, Visible = false })
	UIKit.AutoScale(panel)
	UIKit.Corner(panel, 14)
	UIKit.Stroke(panel, C.Outline, 3, 0)
	UIKit.Text(panel, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title, TextSize = 30, TextColor3 = C.Gold, Text = "แผนที่ดินแดนทั้งสี่" })
	local mapFrame = UIKit.Frame(panel, { Size = UDim2.fromOffset(560, 560), Position = UDim2.fromOffset(30, 50), BackgroundColor3 = Color3.fromRGB(28, 70, 96), BackgroundTransparency = 0 })
	UIKit.Corner(mapFrame, 8)
	mapFrame.ClipsDescendants = true
	local legend = UIKit.Text(panel, {
		Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 1, -46), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 13, TextWrapped = true,
		TextColor3 = C.TextDim, Text = "🔥 แคมป์   ⛩ ศาลเจ้าลูกสัตว์ธาตุ   💀 รังบอส   🏛 วิหารโบราณ   ☄📦 เหตุการณ์   ▲ คุณ   ● เพื่อน   (สถานที่จะปรากฏเมื่อค้นพบ · หมอกเปิดเมื่ออัปเกรดกองไฟ/เดินสำรวจ)",
	})
	local _ = legend
	MapUI.Panel = panel
	MapUI.MapFrame = mapFrame

	local cells = {}
	local visited = {}
	local discovered = {}
	hud.Discovered = discovered
	local built = false
	local layout

	local function toMap(pos)
		local size = state:GetAttribute("MapSize") or 6144
		return (pos.X / size + 0.5), (pos.Z / size + 0.5)
	end

	local function buildGrid()
		layout = atmosphere.Layout
		if built or not layout then
			return
		end
		built = true
		local water = layout.WaterLevel
		local cs = 560 / N
		for i = 0, N - 1 do
			cells[i] = {}
			for k = 0, N - 1 do
				local x = ((i + 0.5) / N - 0.5) * layout.Size
				local z = ((k + 0.5) / N - 0.5) * layout.Size
				local h, biome, lava = layout:HeightAt(x, z)
				local color
				if lava then
					color = Color3.fromRGB(230, 90, 30)
				elseif h < water then
					local depth = math.clamp((water - h) / 60, 0, 1)
					color = Color3.fromRGB(70, 160, 200):Lerp(Color3.fromRGB(20, 60, 100), depth)
				else
					color = BIOME_MAP_COLOR[biome] or Color3.fromRGB(100, 100, 100)
					local shade = math.clamp((h - water) / 300, 0, 1)
					color = color:Lerp(Color3.new(1, 1, 1), shade * 0.35)
				end
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.Size = UDim2.fromOffset(math.ceil(cs), math.ceil(cs))
				f.Position = UDim2.fromOffset(i * cs, k * cs)
				f.BackgroundColor3 = color
				f.Parent = mapFrame
				local fog = Instance.new("Frame")
				fog.BorderSizePixel = 0
				fog.Size = UDim2.fromScale(1, 1)
				fog.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
				fog.BackgroundTransparency = 0.1
				fog.ZIndex = 2
				fog.Parent = f
				cells[i][k] = { Frame = f, Fog = fog, X = x, Z = z }
			end
		end
	end

	local markers = {}
	local function marker(key, text, color, size)
		local m = markers[key]
		if not m then
			m = UIKit.Text(mapFrame, { Size = UDim2.fromOffset(size or 22, size or 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = size or 18, Text = text, TextColor3 = color or C.Text, ZIndex = 5, TextStrokeTransparency = 0.3 })
			markers[key] = m
		end
		return m
	end

	local function refreshMap()
		buildGrid()
		if not built then
			return
		end
		local reveal = state:GetAttribute("CampReveal") or 900
		for i = 0, N - 1 do
			for k = 0, N - 1 do
				local c = cells[i][k]
				local d = math.sqrt(c.X * c.X + c.Z * c.Z)
				local open = d < reveal or visited[i * 1000 + k]
				c.Fog.BackgroundTransparency = open and 1 or 0.12
			end
		end
		local function place(m, pos)
			local u, v = toMap(pos)
			m.Position = UDim2.new(u, -m.AbsoluteSize.X / 2, v, -m.AbsoluteSize.Y / 2)
		end
		local camp = state:GetAttribute("CampPos")
		if camp then
			place(marker("camp", "🔥", C.Fire, 20), camp)
		end
		for _, fn in ipairs(MapUI.ExtraMarkers) do
			local ok, err = pcall(fn, marker, place, discovered)
			if not ok then
				warn("[AS] map marker", err)
			end
		end
		for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
			local shrine = state:GetAttribute("Shrine_" .. el)
			if shrine and discovered["Shrine_" .. el] then
				local done = state:GetAttribute("Spirit" .. el)
				place(marker("Shrine_" .. el, done and "✓" or "⛩", C.Element[el], 18), shrine)
			end
			local lair = state:GetAttribute("Lair_" .. el)
			if lair and discovered["Lair_" .. el] then
				local cleared = state:GetAttribute("Lair" .. el .. "Cleared")
				place(marker("Lair_" .. el, cleared and "☠" or "💀", C.Element[el], 20), lair)
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character
			if char then
				local m = marker("p_" .. p.UserId, p == player and "▲" or "●", p == player and Color3.fromRGB(255, 255, 120) or Color3.fromRGB(120, 220, 255), p == player and 20 or 14)
				place(m, char:GetPivot().Position)
				if p == player then
					local look = workspace.CurrentCamera.CFrame.LookVector
					m.Rotation = math.deg(math.atan2(look.X, -look.Z))
				end
			end
		end
	end

	local function toggle()
		panel.Visible = not panel.Visible
		if panel.Visible then
			refreshMap()
		end
	end
	MapUI.Toggle = toggle
	local function close()
		panel.Visible = false
	end
	MapUI.Close = close
	UIKit.CloseButton(panel, close)
	UIKit.RegisterWindow(panel, close)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			toggle()
		end
	end)

	-- ป้ายชื่อเขต
	local areaFrame = UIKit.Frame(gui, { Size = UDim2.new(1, 0, 0, 120), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.16, 0), BackgroundTransparency = 1 })
	UIKit.AutoScale(areaFrame)
	local areaTitle = UIKit.Text(areaFrame, { Size = UDim2.new(1, 0, 0, 60), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Title, TextSize = 52, TextTransparency = 1, TextStrokeTransparency = 1, Text = "" })
	local areaLine = UIKit.Frame(areaFrame, { Size = UDim2.new(0, 460, 0, 1), Position = UDim2.new(0.5, -230, 0, 62), BackgroundColor3 = C.Gold, BackgroundTransparency = 1 })
	local areaSub = UIKit.Text(areaFrame, { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 68), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, TextTransparency = 1, Text = "" })
	local lastBiome, lastShown = nil, {}
	local function showArea(biome)
		local b = Biomes.Data[biome]
		if not b then
			return
		end
		if lastShown[biome] and os.clock() - lastShown[biome] < 25 then
			return
		end
		lastShown[biome] = os.clock()
		areaTitle.Text = b.Name
		areaTitle.TextColor3 = b.Color
		areaSub.Text = b.Thai
		areaLine.BackgroundColor3 = b.Color
		UIKit.Tween(areaTitle, 1, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
		UIKit.Tween(areaSub, 1, { TextTransparency = 0 })
		UIKit.Tween(areaLine, 1, { BackgroundTransparency = 0.2 })
		task.delay(3.2, function()
			UIKit.Tween(areaTitle, 1.2, { TextTransparency = 1, TextStrokeTransparency = 1 })
			UIKit.Tween(areaSub, 1.2, { TextTransparency = 1 })
			UIKit.Tween(areaLine, 1.2, { BackgroundTransparency = 1 })
		end)
	end

	local SITE_NAMES = {
		Shrine = "ศาลเจ้าผนึก", Lair = "รังอสูร",
	}
	task.spawn(function()
		while true do
			task.wait(1)
			local char = player.Character
			if char and state:GetAttribute("Ready") then
				local pos = char:GetPivot().Position
				-- บันทึกจุดที่เคยไป
				local size = state:GetAttribute("MapSize") or 6144
				local ci = math.floor((pos.X / size + 0.5) * N)
				local ck = math.floor((pos.Z / size + 0.5) * N)
				for di = -2, 2 do
					for dk = -2, 2 do
						visited[(ci + di) * 1000 + (ck + dk)] = true
					end
				end
				-- ค้นพบสถานที่
				for _, kind in ipairs({ "Shrine", "Lair" }) do
					for _, el in ipairs({ "Earth", "Water", "Air", "Fire" }) do
						local key = kind .. "_" .. el
						local p = state:GetAttribute(key)
						if p and not discovered[key] and ((p - pos) * Vector3.new(1, 0, 1)).Magnitude < 280 then
							discovered[key] = true
							hud.Notify(string.format("🗺 ค้นพบ: %s%s", SITE_NAMES[kind], UIKit.ElementThai[el]), "Reward")
						end
					end
				end
				-- ชื่อเขต
				local biome = atmosphere.Biome
				if biome and biome ~= lastBiome then
					lastBiome = biome
					showArea(biome)
				end
				if panel.Visible then
					refreshMap()
				end
			end
		end
	end)
end

return MapUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000080"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	Menus — เมนูคราฟต์ (C), โหมดสร้าง (B), กระเป๋า (Tab), เลือกคลาส
	โต๊ะคราฟต์ + พ่อค้าเร่ ใช้หน้าต่างธีมไม้ (WoodKit) แบบเดียวกับหน้าภารกิจ/ร้านค้า
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local Classes = require(Shared.Classes)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local StructureModels = require(Shared.StructureModels)
local Shop = require(Shared.Shop)
local Limits = require(Shared.Limits)
local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)
local ClassShop = require(script.Parent.ClassShop)
local LobbyUI = require(script.Parent.LobbyUI)
local StoreUI = require(script.Parent.StoreUI)
local ItemTooltip = require(script.Parent.ItemTooltip)
local PinTracker = require(script.Parent.PinTracker)
local ItemIcon = require(script.Parent.ItemIcon)
local Backpack = require(script.Parent.Backpack)
local ClientSettings = require(script.Parent.ClientSettings)

local Menus = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local inventory = {} -- กระสอบ + คลังแคมป์ (ใช้เช็กคราฟต์)
local sack = {} -- เฉพาะในกระสอบ
local campStock = {}
local sackUsed, sackCap = 0, 0
local profile = nil

-- Art = ไอคอนภาพวาดบนแท็บ (Shared/PanelArt) · โหลดไม่ได้ใช้อีโมจิใน Thai แทน
local CATS = {
	{ Id = "Tool", Thai = "⚔ อาวุธ/เครื่องมือ", Label = "อาวุธ/เครื่องมือ", Art = "TabTool" },
	{ Id = "Structure", Thai = "🏗 สิ่งก่อสร้าง", Label = "สิ่งก่อสร้าง", Art = "TabStructure" },
	{ Id = "Medical", Thai = "🩹 ยา", Label = "ยา", Art = "TabMedical" },
}

local function itemDesc(id)
	local t = Items.Tools[id]
	if t then
		local s = string.format("ดาเมจ %d · ระยะ %d", t.Damage, t.Range)
		if t.Chop and t.Chop > 0 then
			s ..= " · ตัดไม้ " .. t.Chop
		end
		if t.Mine and t.Mine > 0 then
			s ..= " · ขุด " .. t.Mine
		end
		if t.Element then
			s ..= " · ธาตุ" .. (UIKit.ElementThai[t.Element] or t.Element)
		end
		if t.Light then
			s ..= " · ส่องแสงไล่กวางกลวง"
		end
		return s
	end
	local st = Items.Structures[id]
	if st then
		local extra = {
			LogWall = "ขวางฝูงสัตว์", StoneWall = "กำแพงถึกมาก", SpikeTrap = "แทงสัตว์ที่เหยียบ", Lantern = "แสงไล่กวางกลวง",
			Ballista = "ยิงสัตว์อัตโนมัติ", Bed = "จุดเกิดของเพื่อนที่มาสมทบ", FarmPlot = "ปลูกเบอร์รี่", CookPot = "ทำสตูว์",
			TerraTotem = "ซ่อมกำแพงรอบๆ", TideTotem = "สัตว์ในรัศมีช้าลง", GaleTotem = "ผลักสัตว์กระเด็น", EmberTotem = "เผาสัตว์รอบๆ",
			SunBeacon = "แสงสว่างมหาศาล",
		}
		return string.format("HP %d · %s", st.Health, extra[id] or "")
	end
	local it = Items.Data[id]
	if it and it.Heal then
		return "ฟื้นเลือด " .. it.Heal .. (it.Revive and " · ใช้ช่วยเพื่อนที่ล้ม" or "")
	end
	return ""
end

---------------------------------------------------------------- เมนูคราฟต์
local craft = {}

local CRAFT_CAP = 20 -- ต้องตรงกับ CampService.CraftCap (server จำกัดซ้ำอีกที)
local GOOD_C, BAD_C = Color3.fromRGB(140, 235, 150), Color3.fromRGB(255, 128, 112)

-- ของที่ใช้คราฟต์ได้ = กระสอบ + คลังแคมป์ (คราฟต์ได้เฉพาะในแคมป์ ซึ่งใช้ทั้งสองที่)
local function have(id)
	return inventory[id] or 0
end

-- ส่วนลดสิ่งก่อสร้างจากทักษะคลาส (server คิดแบบเดียวกัน)
local function craftMult(r)
	local item = Items.Data[r.Id]
	if item and item.Category == "Structure" then
		local perks = Classes.PerksFor(player:GetAttribute("Class") or "Survivor", player:GetAttribute("ClassLevel") or 1)
		return 1 - (perks.BuildDiscount or 0)
	end
	return 1
end

local function needOf(r, n)
	return math.max(1, math.ceil(n * craftMult(r)))
end

-- คราฟต์ได้สูงสุดกี่ชิ้นตอนนี้
local function maxCraft(r)
	local m = CRAFT_CAP
	for id, n in pairs(r.Cost) do
		m = math.min(m, math.floor(have(id) / needOf(r, n)))
	end
	local item = Items.Data[r.Id]
	if item and item.Category == "Tool" then
		m = math.min(m, (have(r.Id) > 0) and 0 or 1)
	elseif m > 1 and Items.Bulk(r.Id) then
		m = math.max(1, math.min(m, math.floor(math.max(sackCap - sackUsed, 0) / (r.Amount or 1))))
	end
	return math.max(0, m)
end
Menus.MaxCraft = maxCraft

local function inCampNow()
	local char = player.Character
	local state = Menus.State
	local camp = state and state:GetAttribute("CampPos")
	if not (char and camp) then
		return false
	end
	local radius = state:GetAttribute("CampRadius") or 60
	return ((char:GetPivot().Position - camp) * Vector3.new(1, 0, 1)).Magnitude <= radius
end

local function updatePin()
	PinTracker.Update(have, function(recipeId, n)
		local r = Recipes.ById[recipeId]
		return r and needOf(r, n) or n
	end)
end

local function matches(r, q)
	if q == "" then
		return true
	end
	local item = Items.Data[r.Id]
	local lq = string.lower(q)
	return string.find(item.Thai or "", q, 1, true) ~= nil
		or string.find(string.lower(item.Name or ""), lq, 1, true) ~= nil
		or string.find(string.lower(r.Id), lq, 1, true) ~= nil
end

function craft.Build(gui)
	-- หน้าต่างธีมไม้ (WoodKit): ป้ายชื่อ + หมาป่า/อินทรี + ธง + โคม
	local win = WoodKit.Window(gui, { Name = "CraftWindow", Size = Vector2.new(1000, 640), Title = "🔨 โต๊ะคราฟต์ Lv.1", TitleWidth = 380, OnClose = function()
		Menus.CloseCraft()
	end })
	local panel = win.Frame
	panel.Position = UDim2.fromScale(0.5, 0.52)
	UIKit.AutoScale(panel)
	local body = win.Body
	craft.Title = win.Title
	local tabs = UIKit.Frame(body, { Size = UDim2.new(0, 560, 0, 46), Position = UDim2.fromOffset(32, 42), BackgroundTransparency = 1 })
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, 10)
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Parent = tabs
	craft.Tab = "Tool"
	craft.TabButtons = {}
	for i, cat in ipairs(CATS) do
		local b = WoodKit.Tab(tabs, cat.Thai, i, 180, function()
			craft.Tab = cat.Id
			if craft.Search then
				craft.Search.Text = ""
			end
			craft.Refresh()
		end)
		-- ไอคอนภาพวาด (ดาบไขว้ / ป้ายสิ่งก่อสร้าง / ขวดยา) ชิดซ้าย + ชื่อเว้นที่ให้ไอคอน
		local icon = WoodKit.Art(b, cat.Art, 34, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 2 })
		if icon then
			icon.Size = UDim2.fromOffset(36, 36)
			icon.ScaleType = Enum.ScaleType.Fit
			-- ชื่อแท็บเป็นป้ายแยกในกรอบหลังไอคอน (ข้อความบนปุ่ม + UIPadding ยังวางภาษาไทยเหลื่อมไปทับไอคอน)
			b.Text = ""
			local pad = b:FindFirstChildOfClass("UIPadding")
			if pad then
				pad:Destroy()
			end
			local label = UIKit.Text(b, { Name = "Label", Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(50, 0), Text = cat.Label,
				TextSize = 18, Font = b.Font, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = b.TextColor3, ZIndex = 2 })
			label.TextScaled = true
			local fit = label:FindFirstChildOfClass("UITextSizeConstraint") or Instance.new("UITextSizeConstraint")
			fit.MaxTextSize, fit.MinTextSize = 18, 10
			fit.Parent = label
			b:GetPropertyChangedSignal("TextColor3"):Connect(function()
				label.TextColor3 = b.TextColor3
			end)
		end
		craft.TabButtons[cat.Id] = b
	end
	-- ช่องค้นหา (ชื่อไทย/อังกฤษ) — พิมพ์แล้วค้นทุกหมวด
	local search = Instance.new("TextBox")
	search.Name = "Search"
	search.Size = UDim2.fromOffset(330, 44)
	search.Position = UDim2.new(1, -362, 0, 43)
	search.BackgroundColor3 = Color3.fromRGB(32, 22, 16)
	search.BorderSizePixel = 0
	search.ClearTextOnFocus = false
	search.Text = ""
	search.PlaceholderText = "🔍 ค้นหา (ไทย/English)"
	search.PlaceholderColor3 = Color3.fromRGB(170, 150, 126)
	search.TextColor3 = Color3.fromRGB(255, 244, 224)
	search.Font = UIKit.Fonts.Bold
	search.TextSize = 18
	search.TextXAlignment = Enum.TextXAlignment.Left
	search.Parent = body
	WoodKit.Corner(search, 8)
	WoodKit.Stroke(search, WoodKit.Colors.GoldDark, 2.5, 0)
	local sp = Instance.new("UIPadding")
	sp.PaddingLeft, sp.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
	sp.Parent = search
	search:GetPropertyChangedSignal("Text"):Connect(function()
		craft.Refresh()
	end)
	craft.Search = search
	craft.Status = UIKit.Text(body, { Size = UDim2.new(1, -64, 0, 24), Position = UDim2.fromOffset(32, 96), Text = "", TextSize = 16, Font = UIKit.Fonts.Bold })
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -56, 1, -150)
	scroll.Position = UDim2.fromOffset(28, 128)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = WoodKit.Colors.Gold
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = body
	local pad = Instance.new("UIPadding")
	pad.PaddingTop, pad.PaddingLeft, pad.PaddingRight, pad.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 14), UDim.new(0, 8)
	pad.Parent = scroll
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -8, 0, 172)
	grid.CellPadding = UDim2.fromOffset(14, 14)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll
	craft.Panel = panel
	craft.Scroll = scroll
end

function craft.UpdateStatus()
	if not craft.Status then
		return
	end
	if inCampNow() then
		craft.Status.Text = "📦 อยู่ในแคมป์: ใช้ของในกระสอบก่อน แล้วค่อยหยิบจากคลังแคมป์"
		craft.Status.TextColor3 = GOOD_C
	else
		craft.Status.Text = "⚠ อยู่นอกแคมป์: กลับไปที่แคมป์ก่อนถึงจะคราฟต์ได้ (ตัวเลขนับรวมคลังแคมป์แล้ว)"
		craft.Status.TextColor3 = Color3.fromRGB(255, 196, 110)
	end
end

-- ป้ายวัตถุดิบทีละชิ้น (ป้ายไม้เข้ม · เขียว = พอ, แดง = ขาด · มี/ต้องใช้) ชี้/กดค้างดูรายละเอียดได้
local function costChips(parent, cost, r, pos, size)
	local holder = UIKit.Frame(parent, { Size = size or UDim2.new(1, -24, 0, 64), Position = pos, BackgroundTransparency = 1 })
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.Wraps = true
	l.Padding = UDim.new(0, 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = holder
	local list = {}
	for id, n in pairs(cost) do
		table.insert(list, { id, r and needOf(r, n) or n })
	end
	table.sort(list, function(a, b)
		return a[1] < b[1]
	end)
	local all = true
	for i, cn in ipairs(list) do
		local h = have(cn[1])
		local ok = h >= cn[2]
		all = all and ok
		-- ป้าย = รูปวัตถุดิบ + ชื่อ มี/ต้องใช้
		local chip = WoodKit.Frame(holder, {
			Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i,
			BackgroundColor3 = ok and Color3.fromRGB(46, 62, 34) or Color3.fromRGB(78, 36, 28),
		})
		WoodKit.Corner(chip, 6)
		WoodKit.Stroke(chip, ok and Color3.fromRGB(110, 150, 70) or Color3.fromRGB(150, 70, 50), 1.5, 0.2)
		local cp = Instance.new("UIPadding")
		cp.PaddingLeft, cp.PaddingRight = UDim.new(0, 4), UDim.new(0, 6)
		cp.Parent = chip
		local cl = Instance.new("UIListLayout")
		cl.FillDirection = Enum.FillDirection.Horizontal
		cl.VerticalAlignment = Enum.VerticalAlignment.Center
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Padding = UDim.new(0, 3)
		cl.Parent = chip
		ItemIcon.Make(chip, cn[1], { Size = UDim2.fromOffset(26, 26), LayoutOrder = 1 })
		UIKit.Text(chip, {
			Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2, TextSize = 15, Font = UIKit.Fonts.Bold,
			BackgroundTransparency = 1, TextColor3 = ok and GOOD_C or BAD_C, Text = string.format("%s %d/%d", Items.DisplayName(cn[1]), h, cn[2]),
		})
		ItemTooltip.Attach(chip, cn[1])
	end
	return all
end

-- กรอบรูปเข้ม (รูปของจริงจาก ItemIcon หรืออีโมจิ)
local function picBox(parent, id, glyph, size, pos)
	local pic = WoodKit.Board(parent, { Size = UDim2.fromOffset(size, size), Position = pos, ZIndex = 2 }, Color3.fromRGB(34, 24, 18), WoodKit.Colors.GoldDark)
	if id then
		ItemIcon.Make(pic, id, { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ZIndex = 3 })
	else
		UIKit.Text(pic, { Size = UDim2.fromScale(1, 1), Text = glyph or "", TextSize = math.floor(size * 0.55), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	end
	return pic
end

function craft.Refresh()
	if not craft.Panel then
		return
	end
	updatePin()
	if not craft.Panel.Visible then
		return
	end
	local state = Menus.State
	local bench = state:GetAttribute("BenchLevel") or 1
	craft.Title.Text = string.format("🔨 โต๊ะคราฟต์ Lv.%d", bench)
	craft.UpdateStatus()
	local query = craft.Search and craft.Search.Text or ""
	query = string.match(query, "^%s*(.-)%s*$") or ""
	local searching = query ~= ""
	for id, b in pairs(craft.TabButtons) do
		WoodKit.SetTab(b, id == craft.Tab and not searching)
	end
	for _, c in ipairs(craft.Scroll:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	-- อัปเกรดกองไฟ / โต๊ะ (อยู่บนสุดทุกแท็บ แทนปุ่มกดที่กองไฟ) — ซ่อนตอนค้นหา
	local fireLv = state:GetAttribute("CampLevel") or 1
	local upgrades = {}
	if not searching then
		upgrades = {
			{ Id = "UpgradeFire", Glyph = "🔥", Art = "Campfire", Title = "🔥 อัปเกรดกองไฟ", Lv = fireLv, Next = Recipes.Campfire[fireLv + 1], Desc = "ไฟใหญ่ขึ้น เขตปลอดภัยกว้างขึ้น หมอกถอยออกไป สำรวจได้ไกลขึ้น" },
			{ Id = "UpgradeBench", Glyph = "🔨", Art = "Bench", Title = "⚒ อัปเกรดโต๊ะคราฟต์", Lv = bench, Next = Recipes.BenchUpgrade[bench + 1] and { Cost = Recipes.BenchUpgrade[bench + 1] }, Desc = "ปลดล็อกของที่คราฟต์ได้มากขึ้น" },
		}
	end
	for i, up in ipairs(upgrades) do
		-- การ์ดม่วงเข้มขอบทอง (แบบป้ายอัปเกรดในภาพอ้างอิง)
		local card = WoodKit.Board(craft.Scroll, { LayoutOrder = -10 + i }, Color3.fromRGB(64, 46, 92), WoodKit.Colors.Gold)
		-- ภาพวาดกองไฟ/โต๊ะคราฟต์วางบนการ์ดตรงๆ (แบบภาพอ้างอิง) · โหลดภาพไม่ได้ = กรอบอีโมจิ
		local art = WoodKit.Art(card, up.Art, 104, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(62, 86), ZIndex = 3 })
		if art then
			art.Size = UDim2.fromOffset(112, 140)
			art.ScaleType = Enum.ScaleType.Fit
		else
			picBox(card, nil, up.Glyph, 100, UDim2.fromOffset(12, 14))
		end
		UIKit.Text(card, { Size = UDim2.new(1, -132, 0, 28), Position = UDim2.fromOffset(122, 10), Text = string.format("%s  Lv.%d → %s", up.Title, up.Lv, up.Next and tostring(up.Lv + 1) or "MAX"), TextSize = 20, Font = UIKit.Fonts.Title })
		UIKit.Text(card, { Size = UDim2.new(1, -132, 0, 18), Position = UDim2.fromOffset(122, 40), Text = up.Desc, TextSize = 13, TextColor3 = Color3.fromRGB(226, 214, 236), Font = UIKit.Fonts.Body })
		local can = up.Next ~= nil
		if up.Next then
			can = costChips(card, up.Next.Cost, nil, UDim2.fromOffset(122, 66), UDim2.new(1, -134, 0, 66)) and can
		end
		WoodKit.Button(card, can and "Night" or "Off", { Size = UDim2.fromOffset(150, 44), Position = UDim2.new(1, -162, 1, -54), Text = up.Next and "⚒ อัปเกรด" or "สูงสุด", TextSize = 18, ZIndex = 4 }, function()
			if up.Next then
				Remotes.Get("Craft"):FireServer(up.Id)
			end
		end)
	end
	local pinned = PinTracker.Get()
	local shown = 0
	for order, r in ipairs(Recipes.List) do
		local item = Items.Data[r.Id]
		if item and ((searching and matches(r, query)) or (not searching and item.Category == craft.Tab)) then
			shown += 1
			local locked = r.Bench > bench
			local isTool = item.Category == "Tool"
			local owned = isTool and have(r.Id) > 0
			local maxN = locked and 0 or maxCraft(r)
			-- จำนวนสูงสุด (Limits): ถือ + วางอยู่ / สูงสุด
			local lim = Limits.Structures[r.Id]
			local limN = lim and (player:GetAttribute(Limits.AttrName(r.Id)) or 0) or 0
			local full = lim ~= nil and limN >= lim.Max
			if lim then
				maxN = math.min(maxN, math.floor(math.max(0, lim.Max - limN) / (r.Amount or 1)))
			end
			local can = not locked and not owned and maxN > 0
			-- การ์ดกระดาษ: คราฟต์ได้ = กระดาษทองสว่าง · ล็อก = กระดาษหม่น
			local tint = can and Color3.fromRGB(255, 232, 160) or (locked and Color3.fromRGB(200, 186, 160) or nil)
			local card = WoodKit.Parchment(craft.Scroll, { LayoutOrder = order + (can and 0 or 100) }, tint)
			ItemTooltip.Attach(card, r.Id)
			-- รูปของที่จะคราฟต์ (โมเดลจริง)
			picBox(card, r.Id, nil, 100, UDim2.fromOffset(12, 14))
			WoodKit.Ink(card, { Size = UDim2.new(1, -192, 0, 26), Position = UDim2.fromOffset(122, 10), Text = item.Thai .. (lim and string.format("  (%d/%d%s)", limN, lim.Max, lim.Scope == "Server" and " ทั้งเซิร์ฟ" or "") or "") .. (can and "  ✔" or ""), TextSize = 21, TextColor3 = locked and WoodKit.Colors.InkDim or (can and WoodKit.Colors.Good or WoodKit.Colors.Ink) })
			WoodKit.Ink(card, { Size = UDim2.new(1, -192, 0, 18), Position = UDim2.fromOffset(122, 36), Text = item.Name, TextSize = 14, Font = UIKit.Fonts.Bold, TextColor3 = WoodKit.Colors.InkDim })
			WoodKit.Ink(card, { Size = UDim2.new(1, -134, 0, 18), Position = UDim2.fromOffset(122, 56), Text = itemDesc(r.Id), TextSize = 14, Font = UIKit.Fonts.Bold, TextColor3 = Color3.fromRGB(96, 66, 40), TextTruncate = Enum.TextTruncate.AtEnd })
			-- 📌 ปักหมุดสูตร (แถบติดตามบนจอ)
			WoodKit.Button(card, pinned == r.Id and "Red" or "Parch", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(1, -58, 0, 10), Text = "📌", TextSize = 22, ZIndex = 4 }, function()
				PinTracker.Toggle(r.Id)
				craft.Refresh()
			end)
			-- วัตถุดิบ
			costChips(card, r.Cost, r, UDim2.fromOffset(122, 80), UDim2.new(1, -134, 0, 36))
			-- ปุ่มคราฟต์: x1 / x5 / สูงสุด
			local row = UIKit.Frame(card, { Size = UDim2.new(1, -134, 0, 44), Position = UDim2.new(0, 122, 1, -54), BackgroundTransparency = 1 })
			local rl = Instance.new("UIListLayout")
			rl.FillDirection = Enum.FillDirection.Horizontal
			rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
			rl.Padding = UDim.new(0, 6)
			rl.SortOrder = Enum.SortOrder.LayoutOrder
			rl.Parent = row
			local function craftButton(i, text, width, enabled, count)
				return WoodKit.Button(row, enabled and "Green" or "Off", { Size = UDim2.fromOffset(width, 44), Text = text, TextSize = 17, LayoutOrder = i, ZIndex = 4 }, function()
					if enabled then
						Remotes.Get("Craft"):FireServer(r.Id, count)
					end
				end)
			end
			if locked then
				craftButton(1, "🔒 ต้องโต๊ะ Lv." .. r.Bench, 160, false, 1)
			elseif isTool then
				craftButton(1, owned and "✔ มีแล้ว" or "⚒ คราฟต์", 140, can, 1)
			elseif full then
				craftButton(1, string.format("✔ ครบ %d/%d", limN, lim.Max), 160, false, 1)
			else
				craftButton(1, "⚒ คราฟต์ x1", 120, can, 1)
				craftButton(2, "x5", 56, maxN >= 5, 5)
				craftButton(3, maxN > 1 and ("สูงสุด x" .. maxN) or "สูงสุด", 110, maxN > 1, CRAFT_CAP)
			end
		end
	end
	if searching and shown == 0 then
		local f = UIKit.Frame(craft.Scroll, { BackgroundTransparency = 1, LayoutOrder = 1 })
		UIKit.Text(f, { Size = UDim2.fromScale(1, 1), Text = "ไม่พบสูตรที่ค้นหา", TextSize = 18, TextColor3 = Color3.fromRGB(226, 206, 176), TextXAlignment = Enum.TextXAlignment.Center })
	end
end

function Menus.OpenCraft()
	craft.Panel.Visible = true
	craft.Refresh()
end

function Menus.CloseCraft()
	craft.Panel.Visible = false
	if craft.Search then
		craft.Search:ReleaseFocus()
	end
	ItemTooltip.Hide()
end

---------------------------------------------------------------- กระเป๋า
local bag = {}

function bag.Build(gui)
	local panel = UIKit.Frame(gui, { Size = UDim2.fromOffset(520, 440), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0.08, Visible = false })
	UIKit.AutoScale(panel)
	UIKit.Corner(panel, 14)
	UIKit.Stroke(panel, C.Outline, 3, 0)
	UIKit.Gradient(panel, Color3.fromRGB(52, 58, 100), Color3.fromRGB(26, 28, 50), 90)
	UIKit.Text(panel, { Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 8), Font = UIKit.Fonts.Title, TextSize = 28, TextColor3 = C.Gold, Text = "🎒 กระสอบ" })
	bag.Title = panel:FindFirstChildWhichIsA("TextLabel")
	UIKit.CloseButton(panel, function()
		panel.Visible = false
		ItemTooltip.Hide()
	end)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -40, 1, -70)
	scroll.Position = UDim2.fromOffset(20, 56)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(150, 64)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll
	bag.Panel = panel
	bag.Scroll = scroll
end

local CAT_ORDER = { Food = 1, Medical = 2, Resource = 3, Essence = 4, Relic = 5, Structure = 6, Tool = 7 }
function bag.Refresh()
	if not (bag.Panel and bag.Panel.Visible) then
		return
	end
	for _, c in ipairs(bag.Scroll:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	if bag.Title then
		bag.Title.Text = string.format("🎒 กระสอบ  %d/%d", sackUsed, sackCap)
	end
	local ids = {}
	for id, n in pairs(sack) do
		if n > 0 and Items.Data[id] and Items.Data[id].Category ~= "Tool" then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		local ca, cb = CAT_ORDER[Items.Data[a].Category] or 9, CAT_ORDER[Items.Data[b].Category] or 9
		if ca ~= cb then
			return ca < cb
		end
		return a < b
	end)
	for i, id in ipairs(ids) do
		local item = Items.Data[id]
		local card = UIKit.Frame(bag.Scroll, { BackgroundColor3 = Color3.fromRGB(50, 56, 94), BackgroundTransparency = 0.1, LayoutOrder = i })
		UIKit.Corner(card, 8)
		ItemTooltip.Attach(card, id)
		UIKit.Stroke(card, item.Color or C.GoldDim, 1, 0.5)
		UIKit.Text(card, { Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 6), Text = item.Thai, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd })
		UIKit.Text(card, { Size = UDim2.new(0, 60, 0, 18), Position = UDim2.fromOffset(8, 36), Text = "x" .. sack[id], TextSize = 14, TextColor3 = C.Gold })
		if Items.Bulk(id) then
			UIKit.Button(card, { Size = UDim2.fromOffset(36, 22), Position = UDim2.new(1, -42, 0, 4), Text = "ทิ้ง", TextSize = 11 }, function()
				Remotes.Get("DropItem"):FireServer(id, 1)
			end)
		end
		if item.Category == "Food" or item.Category == "Medical" then
			UIKit.Button(card, { Size = UDim2.fromOffset(64, 26), Position = UDim2.new(1, -70, 1, -32), Text = item.Category == "Food" and "กิน" or "ใช้", TextSize = 13 }, function()
				Remotes.Get("UseItem"):FireServer(id)
			end)
		elseif item.Category == "Structure" then
			UIKit.Button(card, { Size = UDim2.fromOffset(64, 26), Position = UDim2.new(1, -70, 1, -32), Text = "วาง", TextSize = 13 }, function()
				bag.Panel.Visible = false
				Menus.StartBuild(id)
			end)
		end
	end

	-- คลังแคมป์ (ของที่เทไว้ ทุกคนใช้คราฟต์ร่วมกัน)
	local campIds = {}
	for id, n in pairs(campStock) do
		if n > 0 and Items.Data[id] then
			table.insert(campIds, id)
		end
	end
	table.sort(campIds)
	for i, id in ipairs(campIds) do
		local item = Items.Data[id]
		local card = UIKit.Frame(bag.Scroll, { BackgroundColor3 = Color3.fromRGB(36, 92, 76), BackgroundTransparency = 0.1, LayoutOrder = 1000 + i })
		UIKit.Corner(card, 8)
		ItemTooltip.Attach(card, id)
		UIKit.Stroke(card, Color3.fromRGB(120, 200, 140), 1, 0.6)
		UIKit.Text(card, { Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 6), Text = "📦 " .. item.Thai, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd })
		UIKit.Text(card, { Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(8, 36), Text = "คลังแคมป์ x" .. campStock[id], TextSize = 13, TextColor3 = Color3.fromRGB(150, 230, 170) })
	end
end

function Menus.ToggleBag(force)
	if force == nil then
		bag.Panel.Visible = not bag.Panel.Visible
	else
		bag.Panel.Visible = force
	end
	bag.Refresh()
end

---------------------------------------------------------------- โหมดสร้าง
local build = { Active = false, Yaw = 0 }

function Menus.StartBuild(kind)
	Menus.StopBuild()
	if (inventory[kind] or 0) <= 0 then
		return
	end
	build.Kind = kind
	build.Active = true
	local ghost = StructureModels.Build(kind)
	for _, d in ipairs(ghost:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = math.max(d.Transparency, 0.45)
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		elseif d:IsA("Light") or d:IsA("Fire") then
			d:Destroy()
		end
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0.1
	hl.Parent = ghost
	ghost.Parent = Workspace.CurrentCamera
	build.Ghost = ghost
	build.Highlight = hl
	Menus.BuildHint.Text = Menus.TouchMode and string.format("🏗 วาง %s (เหลือ %d) — เล็งกลางจอแล้วกด ✔", Items.DisplayName(kind), inventory[kind] or 0)
		or string.format("🏗 วาง %s (เหลือ %d)  ·  คลิก = วาง  ·  R = หมุน  ·  B/Esc = ยกเลิก", Items.DisplayName(kind), inventory[kind] or 0)
	Menus.BuildHint.Visible = true
end

function Menus.StopBuild()
	build.Active = false
	if build.Ghost then
		build.Ghost:Destroy()
		build.Ghost = nil
	end
	if Menus.BuildHint then
		Menus.BuildHint.Visible = false
	end
end

-- มือถือ (Menus.TouchMode): เล็งด้วยกลางจอ (มีปุ่มวาง/หมุน/เปลี่ยน/ยกเลิก ใน MobileControls)
Menus.TouchMode = false
local function buildTarget()
	local cam = Workspace.CurrentCamera
	local mouse = Menus.TouchMode and (cam.ViewportSize / 2) or UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Workspace.Terrain }
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	return res
end

function Menus.ToggleBuildPicker()
	if build.Active then
		Menus.StopBuild()
		return
	end
	-- เลือกชุดสิ่งก่อสร้างที่มี
	for _, r in ipairs(Recipes.List) do
		if Items.Data[r.Id].Category == "Structure" and (inventory[r.Id] or 0) > 0 then
			Menus.StartBuild(r.Id)
			return
		end
	end
	if inventory.LogWall and inventory.LogWall > 0 then
		Menus.StartBuild("LogWall")
		return
	end
	Menus.Hud.Notify("ยังไม่มีสิ่งก่อสร้างในกระเป๋า — ไปคราฟต์ที่โต๊ะคราฟต์ก่อน", "Error")
end

-- เลื่อนชนิดถัดไป
function Menus.CycleBuild()
	local kinds = {}
	for _, r in ipairs(Recipes.List) do
		if Items.Data[r.Id].Category == "Structure" and (inventory[r.Id] or 0) > 0 then
			table.insert(kinds, r.Id)
		end
	end
	if #kinds == 0 then
		return
	end
	local idx = table.find(kinds, build.Kind) or 0
	Menus.StartBuild(kinds[idx % #kinds + 1])
end

function Menus.IsBuilding()
	return build.Active
end

function Menus.BuildKind()
	return build.Active and build.Kind or nil
end

function Menus.RotateBuild()
	if build.Active then
		build.Yaw += math.rad(45)
	end
end

function Menus.PlaceBuild()
	if not build.Active then
		return
	end
	local res = buildTarget()
	if res and build.Valid then
		Remotes.Get("PlaceStructure"):FireServer(build.Kind, CFrame.new(res.Position) * CFrame.Angles(0, build.Yaw, 0))
	end
end

function Menus.ToggleCraft()
	if craft.Panel.Visible then
		Menus.CloseCraft()
	else
		Menus.OpenCraft()
	end
end

---------------------------------------------------------------- ร้านค้า (ล็อบบี้)
-- ร้านคลาส = ClassShop · ร้านค้า (เติม Ruby) = StoreUI
function Menus.OpenShop(tab)
	if tab == nil or tab == "Classes" then
		StoreUI.Close()
		ClassShop.Open()
		return
	end
	ClassShop.Close()
	StoreUI.Open(tab == "Shop" and "Diamonds" or tab)
end

function Menus.OpenClasses()
	Menus.OpenShop("Classes")
end

---------------------------------------------------------------- พ่อค้าเร่ (ในแมพ)
local trader = {}

function trader.Build(gui)
	-- หน้าต่างธีมไม้เดียวกับโต๊ะคราฟต์
	local panel
	local win = WoodKit.Window(gui, { Name = "TraderWindow", Size = Vector2.new(960, 600), Title = "🐾 พ่อค้าเร่", TitleWidth = 320, OnClose = function()
		panel.Visible = false
	end })
	panel = win.Frame
	panel.Position = UDim2.fromScale(0.5, 0.52)
	UIKit.AutoScale(panel)
	local quote = WoodKit.Parchment(win.Body, { Size = UDim2.new(1, -64, 0, 44), Position = UDim2.fromOffset(32, 44) })
	WoodKit.Ink(quote, { Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 17, Font = UIKit.Fonts.Bold, TextColor3 = WoodKit.Colors.InkDim, TextXAlignment = Enum.TextXAlignment.Center, Text = "\"หนังสัตว์ดีๆ แลกของจำเป็นได้นะสหาย... รีบหน่อย ข้าจะไปก่อนพระอาทิตย์ตก\"" })
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -56, 1, -128)
	scroll.Position = UDim2.fromOffset(28, 104)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = WoodKit.Colors.Gold
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = win.Body
	local pad = Instance.new("UIPadding")
	pad.PaddingTop, pad.PaddingLeft, pad.PaddingRight, pad.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 14), UDim.new(0, 8)
	pad.Parent = scroll
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -8, 0, 132)
	grid.CellPadding = UDim2.fromOffset(14, 14)
	grid.Parent = scroll
	trader.Panel = panel
	trader.Scroll = scroll
end

local function listText(t, have)
	local parts = {}
	for id, n in pairs(t) do
		if have then
			local ok = (inventory[id] or 0) >= n
			table.insert(parts, string.format('<font color="#%s">%s %d/%d</font>', ok and "8CEB96" or "FF8070", Items.DisplayName(id), inventory[id] or 0, n))
		else
			table.insert(parts, Items.DisplayName(id) .. " x" .. n)
		end
	end
	table.sort(parts)
	return table.concat(parts, "  ")
end

function trader.Refresh()
	if not (trader.Panel and trader.Panel.Visible) then
		return
	end
	for _, c in ipairs(trader.Scroll:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, o in ipairs(Shop.Trader) do
		local okAll = true
		for id, n in pairs(o.Cost) do
			okAll = okAll and (inventory[id] or 0) >= n
		end
		local left = Limits.TradesPerVisit - (player:GetAttribute("Trade_" .. o.Id) or 0)
		okAll = okAll and left > 0
		-- การ์ดกระดาษ (แลกได้ = กระดาษทองสว่าง)
		local f = WoodKit.Parchment(trader.Scroll, { LayoutOrder = i }, okAll and Color3.fromRGB(255, 232, 160) or nil)
		-- รูปของที่ได้ (ชิ้นแรก) + ชื่อ
		local giveId = next(o.Give)
		picBox(f, giveId, "🎁", 100, UDim2.fromOffset(12, 16))
		WoodKit.Ink(f, { Size = UDim2.new(1, -134, 0, 26), Position = UDim2.fromOffset(122, 12), Text = "ได้: " .. listText(o.Give), TextSize = 19, TextTruncate = Enum.TextTruncate.AtEnd })
		WoodKit.Ink(f, { Size = UDim2.new(1, -134, 0, 16), Position = UDim2.fromOffset(122, 40), Text = "จ่าย:", TextSize = 14, Font = UIKit.Fonts.Bold, TextColor3 = WoodKit.Colors.InkDim })
		-- ป้ายของที่ต้องจ่าย (รูป + มี/ต้องใช้ จากกระสอบ)
		costChips(f, o.Cost, nil, UDim2.fromOffset(122, 58), UDim2.new(1, -262, 0, 66))
		WoodKit.Ink(f, { Size = UDim2.fromOffset(116, 18), Position = UDim2.new(1, -128, 1, -82), Text = left > 0 and string.format("แลกได้อีก %d/%d", left, Limits.TradesPerVisit) or "ครบแล้ว", TextSize = 14, Font = UIKit.Fonts.Bold, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = left > 0 and WoodKit.Colors.InkDim or Color3.fromRGB(170, 50, 40) })
		WoodKit.Button(f, okAll and "Red" or "Off", { Size = UDim2.fromOffset(116, 48), Position = UDim2.new(1, -128, 1, -60), Text = "🤝 แลก", TextSize = 20, ZIndex = 4 }, function()
			Remotes.Get("Trade"):FireServer(o.Id)
		end)
	end
end

function Menus.OpenTrader()
	trader.Panel.Visible = true
	trader.Refresh()
end

---------------------------------------------------------------- Init
function Menus.SetInventory(inv, bagOnly, camp, used, cap)
	inventory = inv
	sack = bagOnly or inv
	campStock = camp or {}
	sackUsed, sackCap = used or 0, cap or 0
	-- craft.Refresh อัปเดตแถบติดตามสูตรที่ปักหมุดด้วย (แม้เมนูปิดอยู่)
	craft.Refresh()
	bag.Refresh()
	trader.Refresh()
	if build.Active and (inventory[build.Kind] or 0) <= 0 then
		Menus.StopBuild()
	elseif build.Active then
		Menus.BuildHint.Text = Menus.TouchMode and string.format("🏗 วาง %s (เหลือ %d) — เล็งกลางจอแล้วกด ✔", Items.DisplayName(build.Kind), inventory[build.Kind] or 0)
			or string.format("🏗 วาง %s (เหลือ %d)  ·  คลิก = วาง  ·  R = หมุน  ·  Q = เปลี่ยนชนิด  ·  B = ยกเลิก", Items.DisplayName(build.Kind), inventory[build.Kind] or 0)
	end
end

function Menus.SetProfile(p)
	profile = p
	StoreUI.SetProfile(p)
	ClassShop.SetProfile(p)
	LobbyUI.SetProfile(p)
end

local function updateLobbyUI()
	LobbyUI.SetVisible(not player:GetAttribute("InRun") and not ClassShop.IsOpen())
end

function Menus.Init(state, hud)
	Menus.State = state
	Menus.Hud = hud
	local gui = UIKit.Screen("Menus", 20)
	task.spawn(Backpack.Build) -- แถบเครื่องมือ + กระเป๋า (แบบ Roblox ปุ่มกระเป๋าโชว์ตลอด จัดลำดับได้)
	craft.Build(gui)
	bag.Build(gui)
	trader.Build(gui)
	-- Esc = ปิด (หน้าต่างระหว่างเล่น: ไม่ใส่พื้นหลังรับแตะ เพื่อให้ยังเดิน/โจมตี/ใช้จอยมือถือได้ตอนเปิดอยู่)
	UIKit.RegisterWindow(craft.Panel, Menus.CloseCraft, { Backdrop = false })
	UIKit.RegisterWindow(bag.Panel, function()
		Menus.ToggleBag(false)
	end, { Backdrop = false })
	UIKit.RegisterWindow(trader.Panel, nil, { Backdrop = false })
	StoreUI.Init(UIKit.Screen("Store", 32))
	-- ร้านคลาส (เต็มจอ) + ปุ่มล็อบบี้ด้านซ้าย
	local shopGui = UIKit.Screen("ClassShop", 30)
	ClassShop.Init(shopGui)
	local lobbyGui = UIKit.Screen("LobbyUI", 15)
	LobbyUI.Init(lobbyGui, {
		Classes = function()
			Menus.OpenShop("Classes")
		end,
		Shop = function()
			Menus.OpenShop("Diamonds")
		end,
		Settings = function()
			if Menus.OnSettings then
				Menus.OnSettings()
			end
		end,
	})
	LobbyUI.Closers.Classes = ClassShop.Close
	LobbyUI.Closers.Shop = StoreUI.Close
	ClassShop.OnVisibility = function(open)
		if hud and hud.Gui then
			hud.Gui.Enabled = not open
		end
		updateLobbyUI()
	end
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		updateLobbyUI()
		if player:GetAttribute("InRun") then
			StoreUI.Close()
		end
	end)
	updateLobbyUI()
	Menus.BuildHint = UIKit.Text(gui, {
		Size = UDim2.new(0, 700, 0, 30), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -120), TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 16, TextColor3 = C.Gold, Visible = false, BackgroundTransparency = 0.4, BackgroundColor3 = C.Panel,
	})
	-- ปุ่มหมุนสิ่งก่อสร้าง (คอม: นอกจากปุ่ม R) — มือถือมีปุ่มหมุนในแถบโหมดสร้างอยู่แล้ว
	local rot = UIKit.Button(Menus.BuildHint, { Size = UDim2.fromOffset(120, 36), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6), Text = "⟳ หมุน (R)", TextSize = 16, BackgroundColor3 = Color3.fromRGB(72, 120, 200) }, function()
		Menus.RotateBuild()
	end)
	rot.Visible = not UIKit.IsTouch
	UIKit.Corner(Menus.BuildHint, 8)
	state:GetAttributeChangedSignal("CampLevel"):Connect(function()
		if craft.Panel and craft.Panel.Visible then
			craft.Refresh()
		end
	end)
	state:GetAttributeChangedSignal("BenchLevel"):Connect(function()
		if craft.Panel.Visible then
			craft.Refresh()
		end
	end)
	-- สถานะ "อยู่ในแคมป์ไหม" บนเมนูคราฟต์ + แถบปักหมุดตามคลาส (ส่วนลดสิ่งก่อสร้าง)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if craft.Panel.Visible then
				craft.UpdateStatus()
			end
		end
	end)
	player:GetAttributeChangedSignal("ClassLevel"):Connect(craft.Refresh)
	player:GetAttributeChangedSignal("Class"):Connect(craft.Refresh)
	ClientSettings.OnChanged(function(key)
		if key == "PinRecipe" and craft.Panel.Visible then
			craft.Refresh()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local k = input.KeyCode
		if k == Enum.KeyCode.C then
			if craft.Panel.Visible then
				Menus.CloseCraft()
			else
				Menus.OpenCraft()
			end
		elseif false then
		elseif k == Enum.KeyCode.B then
			Menus.ToggleBuildPicker()
		elseif k == Enum.KeyCode.R and build.Active then
			build.Yaw += math.rad(45)
		elseif k == Enum.KeyCode.Q and build.Active then
			Menus.CycleBuild()
		elseif k == Enum.KeyCode.Escape then
			Menus.StopBuild()
			Menus.CloseCraft()
			bag.Panel.Visible = false
			ItemTooltip.Hide()
			ClassShop.Close()
			StoreUI.Close()
		elseif k == Enum.KeyCode.K then
			if not player:GetAttribute("InRun") then
				if ClassShop.IsOpen() then
					ClassShop.Close()
				else
					Menus.OpenShop("Classes")
				end
			end
		elseif k == Enum.KeyCode.Tab and player:GetAttribute("InRun") then
			Menus.ToggleBag()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and build.Active and not Menus.TouchMode then
			Menus.PlaceBuild()
		end
	end)

	-- Tool สิ่งก่อสร้างในแถบเครื่องมือ Roblox: ถือ = เข้าโหมดวาง, คลิก/แตะ = วาง, เก็บ = ออก
	local function hookChar(char)
		char.ChildAdded:Connect(function(t)
			local kind = t:IsA("Tool") and t:GetAttribute("StructureKind")
			if kind then
				Menus.StartBuild(kind)
				if not t:GetAttribute("BuildHooked") then
					t:SetAttribute("BuildHooked", true)
					t.Activated:Connect(function()
						Menus.PlaceBuild()
					end)
				end
			end
		end)
		char.ChildRemoved:Connect(function(t)
			local kind = t:IsA("Tool") and t:GetAttribute("StructureKind")
			if kind and build.Active and build.Kind == kind then
				-- เปลี่ยนชื่อ (จำนวนลด) ไม่นับ: ยังถืออยู่ = ยังไม่ออก
				task.defer(function()
					if t.Parent ~= char then
						Menus.StopBuild()
					end
				end)
			end
		end)
	end
	if player.Character then
		hookChar(player.Character)
	end
	player.CharacterAdded:Connect(hookChar)
	RunService.RenderStepped:Connect(function()
		if not build.Active or not build.Ghost then
			return
		end
		local res = buildTarget()
		local char = player.Character
		if res and char then
			local d = (res.Position - char:GetPivot().Position).Magnitude
			local camp = state:GetAttribute("CampPos") or Vector3.zero
			local ok = d <= Config.BuildRange and res.Material ~= Enum.Material.Water and res.Material ~= Enum.Material.CrackedLava and (res.Position - camp).Magnitude > 9
			build.Valid = ok
			build.Ghost:PivotTo(CFrame.new(res.Position) * CFrame.Angles(0, build.Yaw, 0))
			build.Highlight.FillColor = ok and Color3.fromRGB(90, 255, 120) or Color3.fromRGB(255, 70, 70)
			build.Highlight.OutlineColor = build.Highlight.FillColor
		end
	end)
end

return Menus
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000081"><Properties><string name="Name">MobBars</string><ProtectedString name="Source"><![CDATA[--[[
	MobBars — หลอดเลือดลอยบนหัวสัตว์/มอนทุกตัว (แบบเกมเอาชีวิตรอดทั่วไป)
	  ชื่อสัตว์ (ไทย) + หลอดเลือด + ตัวเลข · โดนตีแล้วหลอดหดทันที มีแถบขาวหดตามช้าๆ
	  สีชื่อ: สัตว์ไม่ดุ = ขาว · สัตว์ดุ = แดงอ่อน · บอส/ผู้พิทักษ์ = ทอง
	อ่านจากแท็ก "Animal" + attribute Health / MaxHealth / AnimalId ที่ AnimalService ตั้งไว้ (สัตว์โชว์ในล็อบบี้ไม่มี MaxHealth = ไม่มีหลอด)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Animals = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animals"))

local MobBars = {}
local bars = {} -- [model] = { Gui, Fill, Lag, Num, Conns }
local holder

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = o
end

local function remove(model)
	local b = bars[model]
	if not b then
		return
	end
	bars[model] = nil
	for _, c in ipairs(b.Conns) do
		c:Disconnect()
	end
	b.Gui:Destroy()
end

local function update(model, instant)
	local b = bars[model]
	if not b then
		return
	end
	local maxHp = model:GetAttribute("MaxHealth") or 1
	local hp = math.max(model:GetAttribute("Health") or maxHp, 0)
	local frac = math.clamp(hp / math.max(maxHp, 1), 0, 1)
	b.Gui.Enabled = hp > 0
	b.Num.Text = maxHp >= 1e8 and "∞" or string.format("%d / %d", math.ceil(hp), math.ceil(maxHp))
	-- เขียว -> เหลือง -> แดง ตามเลือดที่เหลือ
	b.Fill.BackgroundColor3 = frac > 0.5 and rgb(90, 220, 90):Lerp(rgb(240, 210, 60), (1 - frac) * 2) or rgb(240, 210, 60):Lerp(rgb(230, 50, 50), (0.5 - frac) * 2)
	if instant then
		b.Fill.Size = UDim2.fromScale(frac, 1)
		b.Lag.Size = UDim2.fromScale(frac, 1)
		return
	end
	TweenService:Create(b.Fill, TweenInfo.new(0.12), { Size = UDim2.fromScale(frac, 1) }):Play()
	if frac < b.Lag.Size.X.Scale then
		TweenService:Create(b.Lag, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.3), { Size = UDim2.fromScale(frac, 1) }):Play()
	else
		b.Lag.Size = UDim2.fromScale(frac, 1)
	end
end

local function add(model)
	if bars[model] or not model:IsA("Model") or model:GetAttribute("MaxHealth") == nil then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end
	local info = Animals.Data[model:GetAttribute("AnimalId") or ""]
	if info and info.Behaviour == "Spirit" then
		return -- ลูกสัตว์วิญญาณ (ฝ่ายเรา ตายไม่ได้) ไม่ต้องมีหลอด
	end
	local boss = model:GetAttribute("IsBoss") == true or model:GetAttribute("Kind") == "Guardian"
	-- ตายไม่ได้ (เช่น กวางกลวง): โชว์แค่ชื่อ + คำเตือน ไม่มีหลอด
	local immortal = (model:GetAttribute("MaxHealth") or 0) >= 1e8
	-- ความสูงหัว: วัดจากกล่องรอบตัวเทียบจุดกึ่งกลาง root
	local cf, size = model:GetBoundingBox()
	local top = (cf.Position.Y + size.Y / 2) - root.Position.Y
	local w = boss and 190 or 120

	local gui = Instance.new("BillboardGui")
	gui.Name = "MobBar"
	gui.Adornee = root
	gui.Size = UDim2.fromOffset(w, boss and 44 or 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, top + (boss and 3 or 1.6), 0)
	gui.MaxDistance = boss and 260 or 110
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = holder

	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0.5, 0)
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.Text = info and (info.Thai or info.Name) or (model:GetAttribute("AnimalId") or model.Name)
	name.TextColor3 = boss and rgb(255, 214, 90) or ((info and info.Behaviour == "Passive") and rgb(255, 255, 255) or rgb(255, 150, 140))
	name.TextStrokeTransparency = 0.3
	name.Parent = gui
	local nc = Instance.new("UITextSizeConstraint")
	nc.MaxTextSize = boss and 18 or 14
	nc.Parent = name

	local back = Instance.new("Frame")
	back.BorderSizePixel = 0
	back.BackgroundColor3 = rgb(20, 14, 12)
	back.Position = UDim2.fromScale(0, 0.52)
	back.Size = UDim2.fromScale(1, 0.44)
	back.ClipsDescendants = true
	back.Parent = gui
	corner(back, 4)
	local st = Instance.new("UIStroke")
	st.Color = rgb(0, 0, 0)
	st.Thickness = 1.5
	st.Parent = back
	local lag = Instance.new("Frame")
	lag.BorderSizePixel = 0
	lag.BackgroundColor3 = rgb(255, 240, 220)
	lag.BackgroundTransparency = 0.2
	lag.Size = UDim2.fromScale(1, 1)
	lag.Parent = back
	corner(lag, 4)
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = back
	corner(fill, 4)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(rgb(255, 255, 255), rgb(170, 170, 170))
	g.Rotation = 90
	g.Parent = fill
	local num = Instance.new("TextLabel")
	num.BackgroundTransparency = 1
	num.Size = UDim2.fromScale(1, 1)
	num.Font = Enum.Font.GothamBlack
	num.TextScaled = true
	num.TextColor3 = rgb(255, 255, 255)
	num.TextStrokeTransparency = 0.2
	num.ZIndex = 3
	num.Parent = back
	local tc = Instance.new("UITextSizeConstraint")
	tc.MaxTextSize = boss and 14 or 11
	tc.Parent = num

	if immortal then
		back.Visible = false
		local warnL = Instance.new("TextLabel")
		warnL.BackgroundTransparency = 1
		warnL.Position = UDim2.fromScale(0, 0.5)
		warnL.Size = UDim2.fromScale(1, 0.45)
		warnL.Font = Enum.Font.GothamBold
		warnL.TextScaled = true
		warnL.Text = "ฆ่าไม่ได้ — หนี!"
		warnL.TextColor3 = rgb(255, 120, 110)
		warnL.TextStrokeTransparency = 0.3
		warnL.Parent = gui
	end

	local b = { Gui = gui, Fill = fill, Lag = lag, Num = num, Conns = {} }
	bars[model] = b
	table.insert(b.Conns, model:GetAttributeChangedSignal("Health"):Connect(function()
		update(model)
	end))
	table.insert(b.Conns, model:GetAttributeChangedSignal("MaxHealth"):Connect(function()
		update(model, true)
	end))
	table.insert(b.Conns, model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			remove(model)
		end
	end))
	update(model, true)
end

function MobBars.Init()
	holder = Instance.new("Folder")
	holder.Name = "MobBars"
	holder.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	for _, m in ipairs(CollectionService:GetTagged("Animal")) do
		task.spawn(add, m)
	end
	CollectionService:GetInstanceAddedSignal("Animal"):Connect(function(m)
		-- รอให้ attribute/ชิ้นส่วนมาครบก่อน (สตรีมเข้ามาทีหลังได้)
		task.delay(0.2, add, m)
	end)
	CollectionService:GetInstanceRemovedSignal("Animal"):Connect(remove)
end

return MobBars
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000082"><Properties><string name="Name">MobileControls</string><ProtectedString name="Source"><![CDATA[--[[
	MobileControls — ปุ่มบนจอสำหรับมือถือ/แท็บเล็ต (แทนปุ่มคีย์บอร์ดทั้งหมด)
	  วางเป็นวงรอบปุ่มกระโดดของ Roblox (มุมขวาล่าง) แบบเกมมือถือทั่วไป — ไม่ลอยทับกลางจอ ไม่ทับกันเอง
	    🏃 วิ่ง (แตะ = เปิด/ปิด) · 📤 เอาของออก (เฉพาะตอนถือกระสอบ)
	    🗺 แผนที่ = ปุ่มเล็กข้างปุ่ม ⚙ ใต้การ์ดกองไฟ (มุมขวาบน)
	  โหมดสร้าง: ↻ หมุน · ⇄ เปลี่ยน · ✔ วาง · ✕ ยกเลิก (แถวล่างกลางจอ) — เล็งด้วยเป้ากลางจอ
	  ตี/ตัด = แตะจอตอนถือเครื่องมือ (ระบบ Tool ของ Roblox) · เก็บของ = แตะปุ่ม E บนของ
	ขนาดปุ่มปรับได้ในหน้าตั้งค่า (TouchSize) — ทุกปุ่มบนจอจริงไม่เล็กกว่า MIN_TOUCH (44px) เสมอ
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)
local ClientSettings = require(script.Parent.ClientSettings)

local MobileControls = {}
local MIN_TOUCH = 44 -- ขนาดปุ่มเล็กสุดที่นิ้วกดได้สบาย (px บนจอจริง)
local player = Players.LocalPlayer
local C = UIKit.Colors

function MobileControls.IsTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- ปุ่มกลม: ไอคอนใหญ่ + ชื่อเล็กใต้ไอคอน (ตัวหนังสือย่อเองตามขนาดปุ่ม)
local function roundButton(parent, icon, label, color, onClick)
	local b = UIKit.ColorButton(parent, color, { Size = UDim2.fromOffset(52, 52), Text = "", AnchorPoint = Vector2.new(0.5, 0.5) }, onClick)
	b:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	local ic = UIKit.Text(b, { Size = UDim2.fromScale(1, 0.58), Position = UDim2.fromScale(0, 0.06), Text = icon, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center })
	local lb = UIKit.Text(b, { Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.62), Text = label, TextScaled = true, Font = UIKit.Fonts.Title, TextXAlignment = Enum.TextXAlignment.Center })
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0.1, 0), UDim.new(0.1, 0)
	pad.Parent = b
	return b, ic, lb
end

function MobileControls.Init(deps)
	local menus, map, hud, combat = deps.Menus, deps.Map, deps.HUD, deps.Combat
	if not MobileControls.IsTouch() then
		return
	end
	menus.TouchMode = true
	local gui = UIKit.Screen("MobileControls", 18)

	-- ปุ่มรอบปุ่มกระโดด (ตำแหน่งคำนวณใหม่ทุกครั้งที่จอเปลี่ยนขนาด)
	local ring = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local sprint, _, sprintLabel = roundButton(ring, "🏃", "วิ่ง", C.Cyan, function()
		if combat then
			combat.SetSprint(not combat.IsSprinting())
		end
	end)
	-- คราฟต์ = กด E ที่โต๊ะ · สร้าง = เลือกของในแถบไอเทม · กระสอบ = ปุ่มกระเป๋ามุมขวาบน -> ไม่ต้องมีปุ่มซ้ำ
	local dropB = roundButton(ring, "📤", "เอาออก", C.Pink, function()
		Remotes.Get("DropItem"):FireServer(nil, 1)
	end)
	-- φ = 0 (ซ้ายของปุ่มกระโดด) .. 90 (เหนือปุ่มกระโดด)
	local slots = {
		{ sprint, 1, 0 }, { dropB, 1, 60 },
	}

	-- แผนที่: ปุ่มเล็กใต้ปุ่ม ⚙ ข้างการ์ดกองไฟ (มุมขวาบน ไม่กินพื้นที่ปุ่มหลัก)
	local mapB
	if hud and hud.RightCard then
		local function toggleMap()
			if map and map.Toggle then
				map.Toggle()
			end
		end
		mapB = UIKit.ColorButton(hud.RightCard, C.Purple, { Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0, -12, 0, 60), Text = "🗺", TextSize = 26 }, toggleMap)
		mapB:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
		-- การ์ดกองไฟถูกย่อตามจอ -> ขยายพื้นที่แตะให้ยังกดได้ ≥ 44px
		UIKit.EnsureTouchSize(mapB, MIN_TOUCH, toggleMap)
	end

	-- โหมดสร้าง: เป้าเล็งกลางจอ + แถบปุ่มล่างกลางจอ
	local cross = UIKit.Text(gui, { Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Text = "⊕", TextSize = 38, TextXAlignment = Enum.TextXAlignment.Center, Visible = false })
	local buildBar = UIKit.Frame(gui, { Size = UDim2.fromOffset(300, 66), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -96), BackgroundTransparency = 1, Visible = false }) -- เหนือแถบไอเทม 10 ช่อง
	local bl = Instance.new("UIListLayout")
	bl.FillDirection = Enum.FillDirection.Horizontal
	bl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bl.VerticalAlignment = Enum.VerticalAlignment.Center
	bl.Padding = UDim.new(0, 10)
	bl.Parent = buildBar
	local bscale = Instance.new("UIScale")
	bscale.Parent = buildBar
	for i, spec in ipairs({ { "↻", "หมุน", C.Blue, menus.RotateBuild }, { "⇄", "เปลี่ยน", C.Purple, menus.CycleBuild }, { "✔", "วาง", C.Green, menus.PlaceBuild }, { "✕", "ยกเลิก", C.Red, menus.StopBuild } }) do
		local b = roundButton(buildBar, spec[1], spec[2], spec[3], spec[4])
		b.AnchorPoint = Vector2.new(0, 0)
		b.Size = UDim2.fromOffset(i == 3 and 64 or 56, i == 3 and 64 or 56)
		b.LayoutOrder = i
	end

	local function layout()
		local vp = Workspace.CurrentCamera.ViewportSize
		local k = ClientSettings.Get("TouchSize") or 1
		local small = math.min(vp.X, vp.Y) <= 500
		-- ตำแหน่ง/ขนาดปุ่มกระโดดของ Roblox (TouchJump) นับจากมุมขวาล่าง
		local jx, jy, jr = 60, 55, 35
		if not small then
			jx, jy, jr = 110, 150, 60
		end
		local size = math.max(MIN_TOUCH, (small and 50 or 64) * k)
		local r1 = jr + size * 0.5 + 18 * k
		local r2 = r1 + size + 12 * k
		for _, sl in ipairs(slots) do
			local b, ringNo, phi = sl[1], sl[2], math.rad(sl[3])
			local r = ringNo == 1 and r1 or r2
			b.Size = UDim2.fromOffset(size, size)
			b.Position = UDim2.new(1, -(jx + r * math.cos(phi)), 1, -(jy + r * math.sin(phi)))
		end
		-- ปุ่มโหมดสร้างเล็กสุด 56px x สเกล -> ไม่ให้ต่ำกว่า 44px
		bscale.Scale = math.max(math.clamp(vp.Y / 420, 0.75, 1.15) * k, MIN_TOUCH / 56)
	end
	layout()
	ClientSettings.OnChanged(function(key)
		if key == "TouchSize" then
			layout()
		end
	end)
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)

	-- โชว์/ซ่อนตามสถานะ (ในแมพ / ล้ม / ตาย / กำลังสร้าง / ถือกระสอบ)
	local holding = false
	local function refresh()
		local inRun = player:GetAttribute("InRun") == true
		local out = player:GetAttribute("Downed") or player:GetAttribute("Dead")
		local building = menus.IsBuilding()
		ring.Visible = inRun and not out and not building
		dropB.Visible = holding
		buildBar.Visible = inRun and not out and building
		cross.Visible = buildBar.Visible
		if mapB then
			mapB.Visible = inRun and not out
		end
		local on = combat and combat.IsSprinting()
		sprint.BackgroundColor3 = on and C.Gold or C.Cyan
		sprintLabel.Text = on and "วิ่งอยู่" or "วิ่ง"
	end
	local function watchTools(container)
		container.ChildAdded:Connect(function(t)
			if t:IsA("Tool") and t:GetAttribute("Kind") == "Sack" then
				holding = true
				refresh()
			end
		end)
		container.ChildRemoved:Connect(function(t)
			if t:IsA("Tool") and t:GetAttribute("Kind") == "Sack" then
				holding = false
				refresh()
			end
		end)
	end
	player.CharacterAdded:Connect(function(c)
		holding = false
		watchTools(c)
		refresh()
	end)
	if player.Character then
		watchTools(player.Character)
	end
	for _, a in ipairs({ "InRun", "Downed", "Dead" }) do
		player:GetAttributeChangedSignal(a):Connect(refresh)
	end
	task.spawn(function()
		while gui.Parent do
			task.wait(0.25)
			refresh()
		end
	end)
	refresh()
end

return MobileControls
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000083"><Properties><string name="Name">PadUI</string><ProtectedString name="Source"><![CDATA[--[[
	PadUI — ยืนบนแท่นเริ่มเกมในล็อบบี้ · ธีมกรอบไม้ (WoodKit)
	  หัวหน้าแท่น (คนแรกที่ขึ้น): หน้าต่างกลางจอให้เลือกจำนวนผู้เล่น 1-8 → กดแล้วปิดเองทันที
	  ทุกคนบนแท่น: แถบสถานะเล็กๆ ด้านบนจอ (จำนวนคน + นับถอยหลัง) · หัวหน้ากด "เปลี่ยน" เพื่อเลือกใหม่ได้
	อ่านสถานะจาก attribute ของ Lobby/MatchBox<i> (Size, Count, Countdown, Host) · เลือกจำนวน -> Remotes.PadSize
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)

local PadUI = {}
local player = Players.LocalPlayer

function PadUI.Init()
	local gui = UIKit.Screen("PadUI", 30)

	-------------------------------------------------- หน้าต่างเลือกจำนวน (กลางจอ) · ธีมกรอบไม้
	local current = { Zone = nil, Picked = {} }
	local function close()
		current.PickerFrame.Visible = false
	end
	local win = WoodKit.Window(gui, { Name = "PadPicker", Size = Vector2.new(780, 330), Title = "👥 เลือกจำนวนผู้เล่น", TitleWidth = 470, BannerHeight = 120, OnClose = close })
	local picker = win.Frame
	current.PickerFrame = picker
	picker.Position = UDim2.fromScale(0.5, 0.52)
	UIKit.AutoScale(picker)
	local pickTitle = win.Title
	UIKit.Text(win.Body, { Size = UDim2.new(1, -60, 0, 24), Position = UDim2.fromOffset(30, 46), TextSize = 18, TextColor3 = WoodKit.Colors.Gold, TextXAlignment = Enum.TextXAlignment.Center, Text = "—  ทีมจะออกเดินทางเมื่อคนครบ หรือเมื่อหมดเวลา  —" })
	local grid = UIKit.Frame(win.Body, { Size = UDim2.new(1, -60, 0, 190), Position = UDim2.fromOffset(30, 86), BackgroundTransparency = 1 })
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(164, 84)
	gl.CellPadding = UDim2.fromOffset(16, 18)
	gl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	UIKit.RegisterWindow(picker, close) -- Esc / แตะนอกหน้าต่าง = ปิด (กด "เปลี่ยน" เพื่อเปิดใหม่)
	local pickButtons = {}
	for n = 1, 8 do
		local icon = n == 1 and "👤" or "👥"
		local b = WoodKit.Button(grid, "Parch", { Text = icon .. "  " .. (n == 1 and "1 (เดี่ยว)" or (n .. " คน")), TextSize = 26, LayoutOrder = n }, function()
			if current.Zone then
				Remotes.Get("PadSize"):FireServer(current.Zone:GetAttribute("PadIndex"), n)
				current.Picked[current.Zone] = true
			end
			close() -- เลือกแล้วปิดทันที ไปรอคน/รอเวลาที่แถบด้านบน
		end)
		-- หมุดทองกลางขอบบน (แบบป้ายไม้ในภาพอ้างอิง)
		local stud = WoodKit.Frame(b, { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Rotation = 45, BackgroundColor3 = WoodKit.Colors.Gold, ZIndex = 3 })
		WoodKit.Stroke(stud, WoodKit.Colors.WoodDark, 1.5, 0)
		pickButtons[n] = b
	end

	-------------------------------------------------- ปุ่มออกจากกลุ่ม (ขึ้นแท่นแล้วเดินออกเองไม่ได้ ต้องกดปุ่มนี้)
	local leave -- สร้างหลังแถบสถานะ (เป็นลูกของแถบ โชว์/ซ่อนตามกัน)

	-------------------------------------------------- แถบสถานะ (ด้านบนจอ ใต้ชื่อค่าย) · ป้ายไม้ + หมาป่า/อินทรี + ตราอุ้งเท้า
	local barWin = WoodKit.Window(gui, { Name = "PadBar", Size = Vector2.new(640, 104), Plaque = false, Lanterns = false, TitleWidth = 436, BannerHeight = 72 })
	local bar = barWin.Frame
	bar.AnchorPoint = Vector2.new(0.5, 0)
	bar.Position = UDim2.new(0.5, 0, 0, 104)
	UIKit.AutoScale(bar)
	WoodKit.Medallion(bar, "🐾", 52, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), ZIndex = 12 }, Color3.fromRGB(110, 70, 34))
	local info = WoodKit.Board(barWin.Body, { Size = UDim2.new(1, -206, 1, -30), Position = UDim2.fromOffset(18, 15), ZIndex = 2 }, Color3.fromRGB(96, 30, 22), WoodKit.Colors.GoldDark)
	local status = UIKit.Text(info, { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(12, 4), Font = UIKit.Fonts.Title, TextSize = 28, Text = "", TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	local sub = UIKit.Text(info, { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(12, 40), TextSize = 16, TextColor3 = Color3.fromRGB(245, 226, 196), Text = "", TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	local change = WoodKit.Button(barWin.Body, "Green", { Size = UDim2.fromOffset(160, 64), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Text = "เปลี่ยน", TextSize = 28, ZIndex = 3 }, function()
		if current.Zone then
			picker.Visible = true
			UIKit.Pop(picker)
		end
	end)

	leave = WoodKit.Button(bar, "Red", { Size = UDim2.fromOffset(230, 56), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 10), Text = "ออกจากกลุ่ม", TextSize = 26, ZIndex = 3 }, function()
		Remotes.Get("LeavePad"):FireServer()
	end)

	-- อยู่ในกลุ่มแท่น (เซิร์ฟเวอร์ตั้ง attribute Pad) = คุมตัวละครไว้ในวง เดินชนขอบวงแล้วออกไม่ได้
	local PAD_R = 8.6
	RunService.PreSimulation:Connect(function()
		local pad = player:GetAttribute("Pad")
		local root = pad and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local lobby = root and Workspace:FindFirstChild("Lobby")
		local z = lobby and lobby:FindFirstChild("MatchBox" .. pad, true)
		if not z then
			return
		end
		local c = z.Position
		local off = (root.Position - c) * Vector3.new(1, 0, 1)
		local d = off.Magnitude
		if d > PAD_R then
			local dir = off / d
			local p = c + dir * PAD_R
			root.CFrame = CFrame.new(p.X, root.Position.Y, p.Z) * root.CFrame.Rotation
			local v = root.AssemblyLinearVelocity
			local out = v:Dot(dir)
			if out > 0 then
				root.AssemblyLinearVelocity = v - dir * out
			end
		end
	end)

	RunService.Heartbeat:Connect(function()
		local lobby = Workspace:FindFirstChild("Lobby")
		local pad = not player:GetAttribute("InRun") and player:GetAttribute("Pad")
		local zone = pad and lobby and lobby:FindFirstChild("MatchBox" .. pad, true) or nil
		if zone ~= current.Zone then
			current.Zone = zone
			bar.Visible = zone ~= nil
			picker.Visible = false
			if zone then
				UIKit.Pop(bar)
				-- หัวหน้าแท่นที่ยังไม่เคยเลือก: เปิดหน้าต่างเลือกให้เลย
				task.delay(0.25, function()
					if current.Zone == zone and zone:GetAttribute("Host") == player.UserId and not current.Picked[zone] then
						picker.Visible = true
						UIKit.Pop(picker)
					end
				end)
			end
		end
		if not zone then
			return
		end
		local size, count, cd = zone:GetAttribute("Size") or 4, zone:GetAttribute("Count") or 0, zone:GetAttribute("Countdown") or -1
		local host = zone:GetAttribute("Host") == player.UserId
		pickTitle.Text = "👥 แท่น " .. (zone:GetAttribute("PadIndex") or "") .. " · เลือกจำนวนผู้เล่น"
		status.Text = cd >= 0 and string.format("%d/%d คน   •   ⏳ %d วิ", count, size, cd) or string.format("%d/%d คน", count, size)
		sub.Text = count >= size and "ทีมครบแล้ว! กำลังออกเดินทาง" or (host and "คุณเป็นหัวหน้าแท่น · รอเพื่อนหรือรอหมดเวลา" or "รอหัวหน้าแท่น / รอเพื่อน")
		change.Visible = host
		for n, b in ipairs(pickButtons) do
			local style = n == size and "Green" or "Parch"
			if b:GetAttribute("Style") ~= style then
				WoodKit.Style(b, style)
			end
		end
	end)
end

return PadUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000084"><Properties><string name="Name">PinTracker</string><ProtectedString name="Source"><![CDATA[--[[
	PinTracker — แถบติดตามสูตรที่ปักหมุด 📌 (มุมซ้าย ใต้แถบเลือด)
	  แสดงวัตถุดิบ มี/ต้องใช้ ของสูตรที่ปักไว้ · ครบแล้วการ์ดเป็นสีเขียว "คราฟต์ได้!"
	  ปักหมุด/ถอนหมุดจากเมนูคราฟต์ (Menus) · จำสูตรไว้ในการตั้งค่า (PinRecipe)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Items)
local Recipes = require(Shared.Recipes)
local UIKit = require(script.Parent.UIKit)
local ClientSettings = require(script.Parent.ClientSettings)
local ItemTooltip = require(script.Parent.ItemTooltip)

local PinTracker = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local ui = {}
local lastHave, lastNeed

local GOOD = Color3.fromRGB(140, 235, 150)
local BAD = Color3.fromRGB(255, 128, 112)

function PinTracker.Get()
	local id = ClientSettings.Get("PinRecipe")
	if type(id) == "string" and Recipes.ById[id] then
		return id
	end
	return nil
end

function PinTracker.Set(recipeId)
	ClientSettings.Set("PinRecipe", (recipeId and Recipes.ById[recipeId]) and recipeId or "")
	PinTracker.Refresh()
end

function PinTracker.Toggle(recipeId)
	if PinTracker.Get() == recipeId then
		PinTracker.Set(nil)
	else
		PinTracker.Set(recipeId)
	end
end

local function build()
	if ui.Card then
		return
	end
	local gui = UIKit.Screen("PinTracker", 6)
	local card = UIKit.Frame(gui, {
		Size = UDim2.fromOffset(240, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(20, 200),
		BackgroundColor3 = Color3.fromRGB(26, 28, 50), BackgroundTransparency = 0.15, Visible = false,
	})
	UIKit.Corner(card, 10)
	ui.Stroke = UIKit.Stroke(card, C.GoldDim, 2, 0.2)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 6), UDim.new(0, 8)
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 2)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = card
	local head = UIKit.Frame(card, { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 0 })
	ui.Title = UIKit.Text(head, { Size = UDim2.new(1, -48, 0, 22), Position = UDim2.fromOffset(0, 2), Text = "", TextSize = 16, Font = UIKit.Fonts.Black, TextColor3 = C.Gold })
	ui.Status = UIKit.Text(head, { Size = UDim2.new(1, -48, 0, 16), Position = UDim2.fromOffset(0, 25), Text = "", TextSize = 13, Font = UIKit.Fonts.Bold, TextColor3 = C.TextDim })
	-- ถอนหมุด (44px ให้นิ้วกดง่าย)
	local close = UIKit.Button(head, { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -44, 0, 0), Text = "✕", TextSize = 18, BackgroundColor3 = Color3.fromRGB(90, 60, 70) }, function()
		PinTracker.Set(nil)
	end)
	close:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	ui.Rows = UIKit.Frame(card, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 })
	local rl = Instance.new("UIListLayout")
	rl.Padding = UDim.new(0, 1)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = ui.Rows
	ui.Card = card
	UIKit.AutoScale(card)
	-- ในแมพเท่านั้น
	player:GetAttributeChangedSignal("InRun"):Connect(PinTracker.Refresh)
	ClientSettings.OnChanged(function(key)
		if key == "PinRecipe" then
			PinTracker.Refresh()
		end
	end)
end

-- have(id) -> จำนวนที่มี · need(id, n) -> จำนวนที่ต้องใช้จริง (หลังส่วนลดทักษะ)
function PinTracker.Update(have, need)
	lastHave, lastNeed = have, need
	PinTracker.Refresh()
end

function PinTracker.Refresh()
	build()
	local id = PinTracker.Get()
	local r = id and Recipes.ById[id]
	local show = r ~= nil and player:GetAttribute("InRun") == true and lastHave ~= nil
	ui.Card.Visible = show
	if not show then
		return
	end
	for _, c in ipairs(ui.Rows:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local costs = {}
	for cid, n in pairs(r.Cost) do
		table.insert(costs, { cid, lastNeed and lastNeed(r.Id, n) or n })
	end
	table.sort(costs, function(a, b)
		return a[1] < b[1]
	end)
	local can = true
	for i, cn in ipairs(costs) do
		local have = lastHave(cn[1])
		local ok = have >= cn[2]
		can = can and ok
		local row = UIKit.Text(ui.Rows, {
			Size = UDim2.new(1, 0, 0, 20), LayoutOrder = i, TextSize = 14, Font = UIKit.Fonts.Bold, TextColor3 = ok and GOOD or BAD,
			Text = string.format("%s %s  %d/%d", ok and "✔" or "•", Items.DisplayName(cn[1]), have, cn[2]),
		})
		ItemTooltip.Attach(row, cn[1])
	end
	ui.Title.Text = "📌 " .. Items.DisplayName(r.Id)
	ui.Title.TextColor3 = can and GOOD or C.Gold
	ui.Status.Text = can and "คราฟต์ได้แล้ว! (ไปที่แคมป์ กด C)" or "ยังขาดวัตถุดิบ"
	ui.Status.TextColor3 = can and GOOD or C.TextDim
	ui.Stroke.Color = can and GOOD or C.GoldDim
	ui.Card.BackgroundColor3 = can and Color3.fromRGB(30, 70, 46) or Color3.fromRGB(26, 28, 50)
end

return PinTracker
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000085"><Properties><string name="Name">QuestUI</string><ProtectedString name="Source"><![CDATA[--[[
	QuestUI — หน้าต่าง "ภารกิจ & รางวัล" ในล็อบบี้ (ปุ่ม 📜 ภารกิจ ที่แถบซ้าย) · ธีมกรอบไม้ (WoodKit)
	  แท็บ 📜 ภารกิจ      : รายวัน 3 + รายสัปดาห์ 3 (ความคืบหน้านับฝั่ง server) กดรับ Ruby + Season XP
	  แท็บ 📅 ล็อกอิน 7 วัน : รับวันละครั้ง (ใช้ร่วมกับหม้อรางวัลประจำวัน) ขาดวันเดียวเริ่มใหม่ · เด้งขึ้นเองตอนเข้าเกมถ้ายังไม่รับ
	  แท็บ ✨ Season Pass  : 30 ขั้น สายฟรี + สายพรีเมียม (Game Pass "SeasonPass") + เลือกใส่ฉายา/สีฉายา
	  แท็บ 🎁 โค้ด          : กรอกโค้ดแลกรางวัล (server ตรวจ)
	จุดแดงบนปุ่มแถบซ้าย/แท็บ = มีรางวัลให้กดรับ
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Quests = require(Shared.Quests)
local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)
local LobbyUI = require(script.Parent.LobbyUI)
local Tutorial = require(script.Parent.Tutorial)

local QuestUI = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local W = WoodKit.Colors
local RS = utf8.char(0xE002) -- ไอคอน Robux ในฟอนต์ของ Roblox
local ui = { Tab = "Quests", Pages = {}, TabButtons = {}, TabDots = {}, Timers = {} }
local profile
local loginShown = false

local TABS = {
	{ Id = "Quests", Text = "📜 ภารกิจ" },
	{ Id = "Login", Text = "📅 ล็อกอิน 7 วัน" },
	{ Id = "Season", Text = "✨ Season Pass" },
	{ Id = "Codes", Text = "🎁 โค้ด" },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function now()
	return Workspace:GetServerTimeNow()
end

local function clear(frame)
	for _, c in ipairs(frame:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

-- ปุ่มธีมไม้: กดไม่ได้ = สไตล์ "Off" (ไม่ทำอะไร)
local function button(parent, style, enabled, props, onClick)
	return WoodKit.Button(parent, enabled and style or "Off", props, function()
		if enabled and onClick then
			onClick()
		end
	end)
end

---------------------------------------------------------------- สถานะจากโปรไฟล์
local function seasonPass()
	for _, p in ipairs(Config.GamePasses) do
		if p.Id == Quests.SeasonPassKey then
			return p
		end
	end
	return nil
end

local function hasPremium()
	return player:GetAttribute("Pass_" .. Quests.SeasonPassKey) == true
end

local function questLists()
	local q = profile and profile.Quests
	if type(q) ~= "table" then
		return {}, {}
	end
	local t = now()
	local daily = (q.Day == Quests.Day(t) and type(q.Daily) == "table") and q.Daily or {}
	local weekly = (q.Week == Quests.Week(t) and type(q.Weekly) == "table") and q.Weekly or {}
	return daily, weekly
end

-- Count = วันที่รับไปแล้วในรอบนี้ · Today = วันที่ (1-7) ของวันนี้
local function loginState()
	local today = Quests.Day(now())
	local last = profile and tonumber(profile.LastDaily) or -1
	local streak = profile and tonumber(profile.LoginStreak) or 0
	if last == today then
		return { Claimed = true, Count = streak, Today = streak, Streak = streak }
	end
	local alive = last == today - 1
	local nextDay = alive and (streak % #Quests.LoginRewards) + 1 or 1
	return { Claimed = false, Count = nextDay - 1, Today = nextDay, Streak = alive and streak or 0 }
end

local function seasonState()
	local s = profile and profile.Season
	if type(s) ~= "table" or s.Id ~= Quests.Season(now()) then
		return { XP = 0, Free = {}, Prem = {}, Tier = 0 }
	end
	return { XP = tonumber(s.XP) or 0, Free = s.Free or {}, Prem = s.Prem or {}, Tier = Quests.TierOf(s.XP) }
end

local function counts()
	local n = { Quests = 0, Login = 0, Season = 0, Codes = 0 }
	if not profile then
		return n
	end
	local d, w = questLists()
	for _, list in ipairs({ d, w }) do
		for _, e in ipairs(list) do
			if not e.Claimed and (e.Prog or 0) >= (e.Need or 1) then
				n.Quests += 1
			end
		end
	end
	if not loginState().Claimed then
		n.Login = 1
	end
	local s = seasonState()
	local prem = hasPremium()
	for t = 1, s.Tier do
		if not s.Free["T" .. t] then
			n.Season += 1
		end
		if prem and not s.Prem["T" .. t] then
			n.Season += 1
		end
	end
	return n
end

local function updateDots()
	local n = counts()
	local total = n.Quests + n.Login + n.Season
	LobbyUI.SetQuestDot(total)
	for id, dot in pairs(ui.TabDots) do
		dot.Frame.Visible = (n[id] or 0) > 0
		dot.Label.Text = tostring(n[id] or 0)
	end
	return n
end

local function dotOn(parent)
	local dot = UIKit.Frame(parent, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -14, 0, -8), BackgroundColor3 = C.Red, BackgroundTransparency = 0, Visible = false, ZIndex = 12 })
	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = dot
	UIKit.Stroke(dot, rgb(255, 255, 255), 2, 0)
	local label = UIKit.Text(dot, { Size = UDim2.fromScale(1, 1), Text = "!", Font = UIKit.Fonts.Title, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 13 })
	return { Frame = dot, Label = label }
end

---------------------------------------------------------------- แท็บ: ภารกิจ
local function questCard(parent, order, e, scope, index)
	local prog, need = e.Prog or 0, math.max(1, e.Need or 1)
	local done = prog >= need
	local claimed = e.Claimed == true
	local tint = claimed and rgb(206, 216, 168) or (done and rgb(255, 228, 150) or nil)
	local f = WoodKit.Parchment(parent, { Size = UDim2.new(1, 0, 0, 132), LayoutOrder = order }, tint)
	local icon, text = Quests.Describe(e)
	WoodKit.Medallion(f, icon, 74, { Position = UDim2.fromOffset(12, 14), ZIndex = 2 }, scope == "Daily" and rgb(96, 40, 22) or W.Night)
	WoodKit.Ink(f, { Position = UDim2.fromOffset(98, 10), Size = UDim2.new(1, -110, 0, 30), Text = text, TextSize = 21 })
	local bar = UIKit.Bar(f, { Size = UDim2.new(1, -112, 0, 22), Position = UDim2.fromOffset(98, 46), Color = done and rgb(110, 200, 80) or W.Gold, Label = string.format("%d / %d", math.min(prog, need), need) })
	bar.Set(math.min(prog / need, 1))
	UIKit.Icon(f, "Ruby", 36, { Position = UDim2.fromOffset(92, 84), ZIndex = 3 })
	local xp = scope == "Daily" and Quests.DailyXP or Quests.WeeklyXP
	WoodKit.Ink(f, { Position = UDim2.fromOffset(128, 88), Size = UDim2.fromOffset(84, 28), Text = (e.Ruby or 0) .. " Ruby", TextSize = 18, TextColor3 = W.Bad })
	WoodKit.Ink(f, { Position = UDim2.fromOffset(214, 88), Size = UDim2.fromOffset(100, 28), Text = "⭐ " .. xp .. " XP", TextSize = 18, TextColor3 = rgb(150, 96, 20) })
	local label = claimed and "✔ รับแล้ว" or (done and "🎁 รับรางวัล" or "กำลังทำ...")
	local style = claimed and "Green" or (done and "Red" or "Wood")
	WoodKit.Button(f, style, { Size = UDim2.fromOffset(134, 40), Position = UDim2.new(1, -146, 1, -52), Text = label, TextSize = 18, ZIndex = 4 }, function()
		if done and not claimed then
			Remotes.Get("ClaimQuest"):FireServer(scope, index)
		end
	end)
	if done and not claimed then
		WoodKit.Shine(f, order * 0.3)
	end
end

local function buildQuests(page)
	clear(page)
	local d, w = questLists()
	local cols = {
		{ "Daily", "☀️ ภารกิจรายวัน", d, W.Red },
		{ "Weekly", "📅 ภารกิจรายสัปดาห์", w, W.Night },
	}
	for i, info in ipairs(cols) do
		local col = UIKit.Frame(page, { BackgroundTransparency = 1, Size = UDim2.new(0.5, -8, 1, 0), Position = UDim2.new((i - 1) * 0.5, (i - 1) * 8, 0, 0) })
		local head = WoodKit.Ribbon(col, { Size = UDim2.new(1, 0, 0, 44) }, info[4], info[2], 22)
		ui.Timers[info[1]] = UIKit.Text(head, { Position = UDim2.new(0.45, 0, 0, 0), Size = UDim2.new(0.55, -14, 1, 0), Text = "", Font = UIKit.Fonts.Bold, TextSize = 16, TextColor3 = rgb(255, 230, 190), TextXAlignment = Enum.TextXAlignment.Right })
		local list = UIKit.Frame(col, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 1, -54) })
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 10)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = list
		for k, e in ipairs(info[3]) do
			questCard(list, k, e, info[1], k)
		end
		if #info[3] == 0 then
			UIKit.Text(list, { Size = UDim2.new(1, 0, 0, 60), Text = "กำลังโหลดภารกิจ...", TextSize = 20, TextColor3 = rgb(226, 206, 176), TextXAlignment = Enum.TextXAlignment.Center })
		end
	end
end

---------------------------------------------------------------- แท็บ: ล็อกอิน 7 วัน
local function buildLogin(page)
	clear(page)
	local st = loginState()
	local total = #Quests.LoginRewards
	local head = WoodKit.Parchment(page, { Size = UDim2.new(1, 0, 0, 74) })
	WoodKit.Ink(head, { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 6), Text = "ล็อกอินทุกวัน รับ Ruby เพิ่มขึ้นเรื่อยๆ — วันที่ 7 รับรางวัลใหญ่!", TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center })
	WoodKit.Ink(head, {
		Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 44), TextSize = 15, Font = UIKit.Fonts.Bold, TextColor3 = W.InkDim, TextXAlignment = Enum.TextXAlignment.Center,
		Text = "ขาดวันเดียวเริ่มนับวันที่ 1 ใหม่ · รับที่นี่หรือที่หม้อรางวัลประจำวันในล็อบบี้ก็ได้ (วันละครั้ง)",
	})
	local row = UIKit.Frame(page, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 258) })
	local rl = Instance.new("UIListLayout")
	rl.FillDirection = Enum.FillDirection.Horizontal
	rl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rl.VerticalAlignment = Enum.VerticalAlignment.Center
	rl.Padding = UDim.new(0, 12)
	rl.SortOrder = Enum.SortOrder.LayoutOrder
	rl.Parent = row
	for i, ruby in ipairs(Quests.LoginRewards) do
		local big = i == total
		local claimed = i <= st.Count
		local isToday = i == st.Today and not st.Claimed
		local status, scol = "🔒", W.InkDim
		if claimed then
			status, scol = "✔ รับแล้ว", W.Good
		elseif isToday then
			status, scol = "วันนี้!", W.Bad
		elseif st.Claimed and i == st.Today + 1 then
			status, scol = "พรุ่งนี้", W.InkDim
		end
		local f
		if big then
			-- วันที่ 7: ป้ายไม้แดงเข้มขอบทอง + หีบสมบัติ
			f = WoodKit.Board(row, { Size = UDim2.fromOffset(180, 256), LayoutOrder = i }, claimed and rgb(52, 92, 50) or rgb(92, 22, 36), W.Gold)
			UIKit.Text(f, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 8), Text = "วันที่ " .. i, Font = UIKit.Fonts.Title, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = W.Gold })
			if not WoodKit.Art(f, "Pack3", 150, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 112), ZIndex = 3 }) then
				UIKit.Icon(f, "Ruby", 80, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 112), ZIndex = 3 })
			end
			UIKit.Text(f, { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -84), Text = ruby .. " Ruby", Font = UIKit.Fonts.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
			UIKit.Text(f, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -44), Text = status, Font = UIKit.Fonts.Title, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = isToday and rgb(255, 236, 140) or rgb(240, 224, 200), ZIndex = 5 })
		else
			local tint = claimed and rgb(200, 220, 160) or (isToday and rgb(255, 226, 140) or nil)
			f = WoodKit.Parchment(row, { Size = UDim2.fromOffset(118, 220), LayoutOrder = i }, tint)
			WoodKit.Ink(f, { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 10), Text = "วันที่ " .. i, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center })
			UIKit.Icon(f, "Ruby", 70, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 90), ZIndex = 3 })
			WoodKit.Ink(f, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -80), Text = ruby .. " Ruby", TextSize = 21, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
			WoodKit.Ink(f, { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -44), Text = status, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = scol, ZIndex = 5 })
		end
		if isToday then
			WoodKit.Shine(f, 0.2)
		end
	end
	local foot = WoodKit.Parchment(page, { Size = UDim2.fromOffset(620, 128), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 356) })
	local streakText = string.format("🔥 ต่อเนื่อง %d วัน   ·   สถิติสูงสุด %d วัน", st.Streak, profile and tonumber(profile.BestStreak) or 0)
	WoodKit.Ink(foot, { Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 10), Text = streakText, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center })
	local text
	if st.Claimed then
		text = "✔ รับแล้ว — มาใหม่ใน " .. Quests.FormatTime(Quests.SecondsToDayReset(now()))
	else
		text = string.format("🎁 รับรางวัลวันที่ %d  (%d Ruby)", st.Today, Quests.LoginRewards[st.Today] or 0)
	end
	local b = button(foot, "Red", not st.Claimed, {
		Size = UDim2.fromOffset(460, 56), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 52), Text = text, TextSize = 22,
	}, function()
		Remotes.Get("ClaimDaily"):FireServer()
	end)
	if st.Claimed then
		WoodKit.Style(b, "Green")
	end
	ui.LoginButton = st.Claimed and b or nil
end

---------------------------------------------------------------- แท็บ: Season Pass
local TIER_W = 98

local function rewardVisual(cell, reward)
	if reward.Title and Quests.Titles[reward.Title] then
		local t = Quests.Titles[reward.Title]
		UIKit.Text(cell, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), Text = t.Icon, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 48), Text = "ฉายา", TextSize = 13, TextColor3 = rgb(226, 210, 186), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 64), Text = t.Text, Font = UIKit.Fonts.Title, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
	elseif reward.Color and Quests.Colors[reward.Color] then
		local col = Quests.Colors[reward.Color]
		local sw = UIKit.Frame(cell, { Size = UDim2.fromOffset(36, 36), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), BackgroundColor3 = col.Color, BackgroundTransparency = 0, ZIndex = 4 })
		WoodKit.Corner(sw, "round")
		WoodKit.Stroke(sw, W.WoodDark, 2, 0)
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 48), Text = "สีฉายา", TextSize = 13, TextColor3 = rgb(226, 210, 186), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 64), Text = col.Text, Font = UIKit.Fonts.Title, TextSize = 15, TextColor3 = col.Color, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
	else
		UIKit.Icon(cell, "Ruby", 48, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), ZIndex = 4 })
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 24), Position = UDim2.fromOffset(4, 58), Text = (reward.Ruby or 0) .. " Ruby", Font = UIKit.Fonts.Title, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
	end
	if reward.Ruby and (reward.Title or reward.Color) then
		UIKit.Text(cell, { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 86), Text = "+ " .. reward.Ruby .. " Ruby", TextSize = 13, TextColor3 = rgb(255, 200, 200), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
	end
end

local function promptPremium()
	local pass = seasonPass()
	if pass and (pass.PassId or 0) > 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
	end
end

local function tierCell(parent, y, track, t, reward, s, prem)
	local key = "T" .. t
	local claimed = s[track][key] == true
	local reached = t <= s.Tier
	local locked = track == "Prem" and not prem
	local ready = reached and not claimed and not locked
	local base = track == "Prem" and rgb(120, 76, 30) or rgb(40, 44, 78)
	if claimed then
		base = rgb(46, 96, 52)
	elseif ready then
		base = rgb(186, 136, 40)
	end
	local cell = Instance.new("TextButton")
	cell.Text = ""
	cell.AutoButtonColor = false
	cell.BorderSizePixel = 0
	cell.BackgroundColor3 = base
	cell.Size = UDim2.fromOffset(TIER_W - 8, 108)
	cell.Position = UDim2.fromOffset(0, y)
	cell.Parent = parent
	WoodKit.Corner(cell, 8)
	local st = WoodKit.Stroke(cell, ready and rgb(255, 236, 140) or (track == "Prem" and W.Gold or rgb(120, 110, 160)), ready and 3 or 2, 0)
	UIKit.Gradient(cell, Color3.new(1, 1, 1), rgb(160, 150, 150), 90)
	rewardVisual(cell, reward)
	if claimed or locked or not reached then
		local veil = UIKit.Frame(cell, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(14, 8, 6), BackgroundTransparency = claimed and 0.45 or 0.55, ZIndex = 6 })
		WoodKit.Corner(veil, 8)
		local mark = claimed and "✔" or (locked and "🔒" or "")
		if mark ~= "" then
			UIKit.Text(veil, { Size = UDim2.fromScale(1, 1), Text = mark, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7, TextColor3 = claimed and rgb(150, 255, 150) or rgb(255, 230, 160) })
		end
	end
	if ready then
		UIKit.Text(cell, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -4), Text = "กดรับ!", Font = UIKit.Fonts.Title, TextSize = 16, TextColor3 = rgb(255, 240, 150), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8 })
		task.spawn(function()
			while cell.Parent do
				TweenService:Create(st, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { Transparency = 0.6 }):Play()
				task.wait(0.6)
				TweenService:Create(st, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { Transparency = 0 }):Play()
				task.wait(0.6)
			end
		end)
	end
	cell.Activated:Connect(function()
		if UIKit.OnAnyClick then
			UIKit.OnAnyClick()
		end
		if ready then
			Remotes.Get("ClaimSeason"):FireServer(track, t)
		elseif locked then
			promptPremium()
		end
	end)
end

-- ตัวเลือกฉายา/สี: [◀ ก่อนหน้า] ชื่อ [ถัดไป ▶] วนเฉพาะที่มี (+ "ไม่ใส่")
local function selector(parent, x, label, kind, order, defs, owned, equipped)
	local list = { "" }
	for _, id in ipairs(order) do
		if owned[id] then
			table.insert(list, id)
		end
	end
	local idx = table.find(list, equipped) or 1
	local box = WoodKit.Board(parent, { Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(x, x > 0 and 6 or 0, 0, 0) }, rgb(40, 28, 20))
	UIKit.Text(box, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0, 96, 1, 0), Text = label, Font = UIKit.Fonts.Title, TextSize = 18, TextColor3 = W.Gold })
	local id = list[idx]
	local def = id ~= "" and defs[id] or nil
	local name = def and ((def.Icon and (def.Icon .. " ") or "") .. def.Text) or (#list > 1 and "ไม่ใส่" or "ยังไม่ปลดล็อก — ได้จาก Season Pass/โค้ด")
	local nameL = UIKit.Text(box, { Position = UDim2.new(0, 160, 0, 0), Size = UDim2.new(1, -218, 1, 0), Text = name, Font = UIKit.Fonts.Title, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center })
	if kind == "Color" and def then
		nameL.TextColor3 = def.Color
	elseif kind == "Title" and def then
		local col = profile and Quests.Colors[profile.EquipColor]
		nameL.TextColor3 = col and col.Color or rgb(255, 236, 170)
	end
	local function go(step)
		if #list <= 1 then
			return
		end
		local n = ((idx - 1 + step) % #list) + 1
		Remotes.Get("EquipCosmetic"):FireServer(kind, list[n])
	end
	button(box, "Wood", #list > 1, { Size = UDim2.fromOffset(48, 42), Position = UDim2.new(0, 106, 0.5, -21), Text = "◀", TextSize = 20 }, function()
		go(-1)
	end)
	button(box, "Wood", #list > 1, { Size = UDim2.fromOffset(48, 42), Position = UDim2.new(1, -56, 0.5, -21), Text = "▶", TextSize = 20 }, function()
		go(1)
	end)
end

local function buildSeason(page)
	local oldScroll = ui.SeasonScroll and ui.SeasonScroll.CanvasPosition
	clear(page)
	local s = seasonState()
	local prem = hasPremium()
	local season = Quests.Season(now())
	-- ธงซีซั่นด้านซ้าย: ผ้าแดงขอบทอง + หัวหมาป่า
	local flag = WoodKit.Board(page, { Size = UDim2.new(0, 180, 1, -20) }, rgb(120, 24, 28), W.Gold)
	local sname = UIKit.Text(flag, { Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 44), Text = "ซีซั่น " .. season, Font = UIKit.Fonts.Title, TextSize = 36, TextXAlignment = Enum.TextXAlignment.Center })
	UIKit.Gradient(sname, rgb(255, 250, 210), rgb(240, 180, 70), 90)
	if not WoodKit.Art(flag, "Wolf", 168, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 3 }) then
		UIKit.Text(flag, { Size = UDim2.new(1, 0, 0, 90), Position = UDim2.fromScale(0, 0.32), Text = "🐺", TextSize = 72, TextXAlignment = Enum.TextXAlignment.Center })
	end
	ui.Timers.Season = UIKit.Text(flag, { Position = UDim2.new(0, 8, 1, -64), Size = UDim2.new(1, -16, 0, 50), Text = "", TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rgb(255, 226, 190) })
	local right = UIKit.Frame(page, { BackgroundTransparency = 1, Position = UDim2.fromOffset(194, 0), Size = UDim2.new(1, -194, 1, 0) })
	-- แถบบน: ขั้น + XP / พรีเมียม / รับทั้งหมด
	local top = WoodKit.Board(right, { Size = UDim2.new(1, 0, 0, 80) }, rgb(46, 36, 70), rgb(150, 130, 210))
	UIKit.Text(top, {
		Position = UDim2.fromOffset(16, 6), Size = UDim2.fromOffset(330, 32), Font = UIKit.Fonts.Title, TextSize = 26,
		Text = s.Tier >= Quests.SeasonTiers and ("ขั้น " .. s.Tier .. " / " .. Quests.SeasonTiers .. "  ·  ครบแล้ว! 🎉") or ("ขั้น " .. s.Tier .. " / " .. Quests.SeasonTiers),
	})
	local within = s.Tier >= Quests.SeasonTiers and Quests.XPPerTier or (s.XP % Quests.XPPerTier)
	local bar = UIKit.Bar(top, { Size = UDim2.fromOffset(330, 24), Position = UDim2.fromOffset(16, 44), Color = W.Gold, Label = string.format("⭐ %d / %d XP", within, Quests.XPPerTier) })
	bar.Set(within / Quests.XPPerTier)
	local pass = seasonPass()
	if prem then
		UIKit.Text(top, { Position = UDim2.new(1, -404, 0, 0), Size = UDim2.fromOffset(210, 80), Text = "👑 พรีเมียม ✔", Font = UIKit.Fonts.Title, TextSize = 24, TextColor3 = rgb(255, 214, 90), TextXAlignment = Enum.TextXAlignment.Center })
	else
		local ready = pass ~= nil and (pass.PassId or 0) > 0
		WoodKit.Button(top, "Wood", {
			Size = UDim2.fromOffset(200, 52), Position = UDim2.new(1, -400, 0.5, -26), TextSize = 18,
			Text = ready and ("👑 พรีเมียม  " .. RS .. " " .. pass.Robux) or "👑 พรีเมียม (เร็วๆ นี้)",
		}, promptPremium)
	end
	local claimable = counts().Season
	button(top, "Red", claimable > 0, {
		Size = UDim2.fromOffset(180, 52), Position = UDim2.new(1, -192, 0.5, -26), TextSize = 19,
		Text = claimable > 0 and ("🎁 รับทั้งหมด (" .. claimable .. ")") or "🎁 รับทั้งหมด",
	}, function()
		Remotes.Get("ClaimSeason"):FireServer("All")
	end)
	-- ป้ายแถว
	for i, info in ipairs({ { "🎟\nฟรี", rgb(40, 44, 78), rgb(120, 110, 160) }, { "👑\nพรีเมียม", rgb(120, 76, 30), W.Gold } }) do
		local l = WoodKit.Board(right, { Size = UDim2.fromOffset(84, 108), Position = UDim2.fromOffset(0, 132 + (i - 1) * 116) }, info[2], info[3])
		UIKit.Text(l, { Size = UDim2.fromScale(1, 1), Text = info[1], Font = UIKit.Fonts.Title, TextSize = 17, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center })
	end
	-- รางวัล 30 ขั้น (เลื่อนแนวนอน)
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(92, 90)
	scroll.Size = UDim2.new(1, -92, 0, 286)
	scroll.ScrollingDirection = Enum.ScrollingDirection.X
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.X
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = W.Gold
	scroll.Parent = right
	ui.SeasonScroll = scroll
	local hl = Instance.new("UIListLayout")
	hl.FillDirection = Enum.FillDirection.Horizontal
	hl.SortOrder = Enum.SortOrder.LayoutOrder
	hl.Padding = UDim.new(0, 0)
	hl.Parent = scroll
	for t = 1, Quests.SeasonTiers do
		local col = UIKit.Frame(scroll, { BackgroundTransparency = 1, Size = UDim2.fromOffset(TIER_W, 274), LayoutOrder = t })
		local reached = t <= s.Tier
		local num = WoodKit.Frame(col, { Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, -4, 0, 2), BackgroundColor3 = reached and W.Gold or rgb(70, 50, 34) })
		WoodKit.Corner(num, "round")
		WoodKit.Stroke(num, W.WoodDark, 2, 0)
		UIKit.Text(num, { Size = UDim2.fromScale(1, 1), Text = tostring(t), Font = UIKit.Fonts.Title, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center })
		tierCell(col, 42, "Free", t, Quests.Track.Free[t], s, prem)
		tierCell(col, 158, "Prem", t, Quests.Track.Prem[t], s, prem)
	end
	task.defer(function()
		if scroll.Parent then
			scroll.CanvasPosition = oldScroll or Vector2.new(math.max(0, (s.Tier - 2) * TIER_W), 0)
		end
	end)
	-- ฉายา / สีฉายา ที่ใส่อยู่ (โชว์บนหัวในล็อบบี้)
	local strip = UIKit.Frame(right, { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -64), Size = UDim2.new(1, 0, 0, 60) })
	selector(strip, 0, "🏷 ฉายา", "Title", Quests.TitleOrder, Quests.Titles, (profile and profile.Titles) or {}, profile and profile.EquipTitle or "")
	selector(strip, 0.5, "🎨 สีฉายา", "Color", Quests.ColorOrder, Quests.Colors, (profile and profile.NameColors) or {}, profile and profile.EquipColor or "")
end

---------------------------------------------------------------- แท็บ: โค้ด (สร้างครั้งเดียว ไม่ล้างข้อความที่พิมพ์ค้างไว้)
local function buildCodes(page)
	-- ของประดับสองข้าง (หีบ Ruby / ถุง Ruby)
	WoodKit.Art(page, "Pack3", 170, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -40), ZIndex = 1 })
	WoodKit.Art(page, "Pack1", 140, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, -40), ZIndex = 1 })
	local f = WoodKit.Parchment(page, { Size = UDim2.fromOffset(640, 380), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), ZIndex = 2 })
	WoodKit.Ink(f, { Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 22), Text = "🎁 แลกโค้ดรับของรางวัล", TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	WoodKit.Ink(f, { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 70), Text = "ใส่โค้ดแล้วกด \"แลกโค้ด\" · แต่ละโค้ดใช้ได้คนละครั้ง", TextSize = 17, Font = UIKit.Fonts.Bold, TextColor3 = W.InkDim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -80, 0, 66)
	box.Position = UDim2.fromOffset(40, 110)
	box.BackgroundColor3 = rgb(32, 24, 20)
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.Text = ""
	box.PlaceholderText = "พิมพ์โค้ดที่นี่..."
	box.PlaceholderColor3 = rgb(150, 134, 116)
	box.TextColor3 = rgb(255, 244, 224)
	box.Font = UIKit.Fonts.Title
	box.TextSize = 30
	box.ZIndex = 3
	box.Parent = f
	WoodKit.Corner(box, 8)
	WoodKit.Stroke(box, W.GoldDark, 3, 0)
	local result = WoodKit.Ink(f, { Size = UDim2.new(1, -40, 0, 28), Position = UDim2.fromOffset(20, 272), Text = "", TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	local busy = false
	local function redeem()
		local code = box.Text
		if busy or code:gsub("%s", "") == "" then
			return
		end
		busy = true
		result.Text = "⏳ กำลังตรวจสอบ..."
		result.TextColor3 = W.InkDim
		task.spawn(function()
			local ok, res = pcall(function()
				return Remotes.Get("RedeemCode"):InvokeServer(code)
			end)
			busy = false
			if ok and type(res) == "table" then
				result.Text = tostring(res.Text or "")
				result.TextColor3 = res.Ok and W.Good or W.Bad
				if res.Ok then
					box.Text = ""
				end
			else
				result.Text = "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ลองใหม่อีกครั้ง"
				result.TextColor3 = W.Bad
			end
		end)
	end
	WoodKit.Button(f, "Red", { Size = UDim2.fromOffset(300, 60), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 196), Text = "🐾 แลกโค้ด", TextSize = 26, ZIndex = 4 }, redeem)
	box.FocusLost:Connect(function(enter)
		if enter then
			redeem()
		end
	end)
	ui.CodesUsed = WoodKit.Ink(f, { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.new(0, 20, 1, -40), Text = "", TextSize = 16, Font = UIKit.Fonts.Bold, TextColor3 = W.InkDim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	UIKit.Text(page, {
		Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 408), TextSize = 16, TextColor3 = rgb(226, 206, 176), TextXAlignment = Enum.TextXAlignment.Center,
		Text = "ติดตามโค้ดใหม่ๆ ได้จากหน้าเกมและกลุ่มของเกม · ลองโค้ด WELCOME ดูสิ!",
	})
end

local function refreshStatic()
	if ui.CodesUsed then
		local n = 0
		for _ in pairs((profile and profile.CodesUsed) or {}) do
			n += 1
		end
		ui.CodesUsed.Text = n > 0 and string.format("ใช้โค้ดไปแล้ว %d โค้ด", n) or ""
	end
end

local function updateTimers()
	local t = now()
	if ui.Timers.Daily and ui.Timers.Daily.Parent then
		ui.Timers.Daily.Text = "⏳ รีเซ็ตใน " .. Quests.FormatTime(Quests.SecondsToDayReset(t))
	end
	if ui.Timers.Weekly and ui.Timers.Weekly.Parent then
		ui.Timers.Weekly.Text = "⏳ รีเซ็ตใน " .. Quests.FormatTime(Quests.SecondsToWeekReset(t))
	end
	if ui.Timers.Season and ui.Timers.Season.Parent then
		ui.Timers.Season.Text = "⏳ จบซีซั่นใน " .. Quests.FormatTime(Quests.SecondsToSeasonEnd(t))
	end
	if ui.LoginButton and ui.LoginButton.Parent then
		ui.LoginButton.Text = "✔ รับแล้ว — มาใหม่ใน " .. Quests.FormatTime(Quests.SecondsToDayReset(t))
	end
end

---------------------------------------------------------------- เปิด/ปิด/รีเฟรช
local BUILDERS = { Quests = buildQuests, Login = buildLogin, Season = buildSeason }

function QuestUI.Refresh()
	if not ui.Panel then
		return
	end
	updateDots()
	refreshStatic()
	if not ui.Panel.Visible then
		return
	end
	ui.Gems.Text = tostring(player:GetAttribute("Diamonds") or (profile and profile.Diamonds) or 0)
	for id, b in pairs(ui.TabButtons) do
		local on = id == ui.Tab
		WoodKit.SetTab(b, on)
		ui.Pages[id].Visible = on
	end
	local build = BUILDERS[ui.Tab]
	if build then
		local ok, err = pcall(build, ui.Pages[ui.Tab])
		if not ok then
			warn("[AS] QuestUI", ui.Tab, err)
		end
	end
	updateTimers()
end

function QuestUI.Open(tab)
	if not ui.Panel or player:GetAttribute("InRun") then
		return
	end
	if tab and ui.Pages[tab] then
		ui.Tab = tab
	end
	ui.Panel.Visible = true
	UIKit.Pop(ui.Panel)
	QuestUI.Refresh()
end

function QuestUI.Close()
	if ui.Panel then
		ui.Panel.Visible = false
	end
end

function QuestUI.IsOpen()
	return ui.Panel ~= nil and ui.Panel.Visible
end

function QuestUI.Toggle()
	if QuestUI.IsOpen() then
		QuestUI.Close()
	else
		QuestUI.Open()
	end
end

function QuestUI.SetProfile(p)
	if type(p) ~= "table" then
		return
	end
	profile = p
	QuestUI.Refresh()
end

-- หลังโหลดเสร็จ: ดึงโปรไฟล์ แล้วเด้งหน้าล็อกอิน 7 วันถ้าวันนี้ยังไม่ได้รับ (รอหน้าสอนเล่นปิดก่อน)
function QuestUI.OnLoaded()
	task.spawn(function()
		if not profile then
			local ok, p = pcall(function()
				return Remotes.Get("GetProfile"):InvokeServer()
			end)
			if ok and type(p) == "table" then
				QuestUI.SetProfile(p)
			end
		end
		if loginShown then
			return
		end
		task.wait(2.5)
		local t0 = os.clock()
		while Tutorial.IsOpen() and os.clock() - t0 < 600 do
			task.wait(0.5)
		end
		task.wait(0.6)
		if profile and not loginState().Claimed and not player:GetAttribute("InRun") and not QuestUI.IsOpen() then
			loginShown = true
			QuestUI.Open("Login")
		end
	end)
end

function QuestUI.Init(gui)
	local win = WoodKit.Window(gui, { Name = "QuestWindow", Size = Vector2.new(1080, 620), Title = "ภารกิจ & รางวัล", OnClose = QuestUI.Close })
	ui.Panel = win.Frame
	local body = win.Body
	-- Ruby ของเรา
	ui.Gems = WoodKit.RubyPill(body, { Position = UDim2.new(1, -206, 0, 42) })
	-- แท็บ
	local tabs = UIKit.Frame(body, { Size = UDim2.new(1, -260, 0, 52), Position = UDim2.fromOffset(32, 40), BackgroundTransparency = 1 })
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.VerticalAlignment = Enum.VerticalAlignment.Center
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Padding = UDim.new(0, 10)
	tl.Parent = tabs
	local content = UIKit.Frame(body, { BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 104), Size = UDim2.new(1, -64, 1, -126) })
	for i, t in ipairs(TABS) do
		local b = WoodKit.Tab(tabs, t.Text, i, 180, function()
			ui.Tab = t.Id
			QuestUI.Refresh()
		end)
		ui.TabButtons[t.Id] = b
		ui.TabDots[t.Id] = dotOn(b)
		local page = UIKit.Frame(content, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false })
		ui.Pages[t.Id] = page
	end
	buildCodes(ui.Pages.Codes)

	LobbyUI.OnQuests = QuestUI.Toggle
	LobbyUI.Closers.Quests = QuestUI.Close
	LobbyUI.OnHidden = QuestUI.Close
	Remotes.Get("Profile").OnClientEvent:Connect(QuestUI.SetProfile)
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		if player:GetAttribute("InRun") then
			QuestUI.Close()
		end
	end)
	player:GetAttributeChangedSignal("Pass_" .. Quests.SeasonPassKey):Connect(QuestUI.Refresh)
	player:GetAttributeChangedSignal("Diamonds"):Connect(function()
		if QuestUI.IsOpen() then
			ui.Gems.Text = tostring(player:GetAttribute("Diamonds") or 0)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape then
			QuestUI.Close()
		end
	end)
	-- นาฬิกานับถอยหลัง + เช็กจุดแดงตอนข้ามวัน
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks += 1
			if QuestUI.IsOpen() then
				updateTimers()
			end
			if ticks % 10 == 0 then
				updateDots()
			end
		end
	end)
	updateDots()
	refreshStatic()
end

return QuestUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000086"><Properties><string name="Name">RejoinUI</string><ProtectedString name="Source"><![CDATA[--[[
	RejoinUI — หน้าต่าง "กลับเข้ารอบเดิม?" ในล็อบบี้ (หลุด/ออกเกมกลางรอบ ภายใน 1 ชม.)
	  server ส่ง RejoinOffer { Left = วินาที } -> โชว์เวลาที่เหลือนับถอยหลัง
	  ปุ่ม "กลับเข้ารอบ" / "ไม่ล่ะ" -> RejoinAnswer(true/false) (ปุ่มใหญ่ กดด้วยนิ้วได้)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)

local RejoinUI = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local ui = {}
local deadline = 0
local token = 0

local function fmt(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", sec // 60, sec % 60)
end

local function close()
	token += 1
	if ui.Panel then
		ui.Panel.Visible = false
	end
end

local function build()
	if ui.Panel then
		return
	end
	local gui = UIKit.Screen("Rejoin", 55)
	local panel = UIKit.Card(gui, { Size = UDim2.fromOffset(480, 250), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Visible = false })
	UIKit.Header(panel, "↩ กลับเข้ารอบเดิม?", C.Purple)
	UIKit.Text(panel, {
		Size = UDim2.new(1, -40, 0, 56), Position = UDim2.fromOffset(20, 36), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18,
		Text = "คุณหลุดออกจากรอบที่ทีมยังเล่นอยู่ — กลับไปเล่นต่อพร้อมของเดิมได้",
	})
	ui.Time = UIKit.Text(panel, { Size = UDim2.new(1, -40, 0, 30), Position = UDim2.fromOffset(20, 96), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22, Font = UIKit.Fonts.Title, TextColor3 = C.Gold, Text = "" })
	local row = UIKit.Frame(panel, { Size = UDim2.new(1, -40, 0, 56), Position = UDim2.new(0, 20, 1, -76), BackgroundTransparency = 1 })
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.Padding = UDim.new(0, 16)
	l.Parent = row
	ui.Yes = UIKit.ColorButton(row, C.Green, { Size = UDim2.fromOffset(200, 54), Text = "✔ กลับเข้ารอบ", TextSize = 20, Font = UIKit.Fonts.Title }, function()
		close()
		Remotes.Get("RejoinAnswer"):FireServer(true)
	end)
	UIKit.ColorButton(row, C.Red, { Size = UDim2.fromOffset(160, 54), Text = "✕ ไม่ล่ะ", TextSize = 20, Font = UIKit.Fonts.Title }, function()
		close()
		Remotes.Get("RejoinAnswer"):FireServer(false)
	end)
	ui.Panel = panel
end

local function open(data)
	if type(data) ~= "table" or player:GetAttribute("InRun") then
		return
	end
	build()
	deadline = os.clock() + math.max(0, tonumber(data.Left) or 0)
	ui.Panel.Visible = true
	UIKit.Pop(ui.Panel)
	token += 1
	local my = token
	task.spawn(function()
		while my == token and ui.Panel.Visible do
			local left = deadline - os.clock()
			if left <= 0 then
				close()
				break
			end
			ui.Time.Text = "⏳ เหลือเวลา " .. fmt(left)
			task.wait(0.5)
		end
	end)
end

function RejoinUI.Init()
	Remotes.Get("RejoinOffer").OnClientEvent:Connect(open)
	player:GetAttributeChangedSignal("InRun"):Connect(function()
		if player:GetAttribute("InRun") then
			close()
		end
	end)
end

return RejoinUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000087"><Properties><string name="Name">SettingsUI</string><ProtectedString name="Source"><![CDATA[--[[
	SettingsUI — หน้าต่างตั้งค่า (ปุ่ม ⚙ ในล็อบบี้ / ระหว่างเล่น) · ธีมกรอบไม้ (WoodKit)
	  🔊 เสียง   : เพลง / บรรยากาศ / เอฟเฟกต์
	  🎨 กราฟิก  : ต่ำ / กลาง / สูง (มือถือ-เครื่องช้าแนะนำ "ต่ำ")
	  🎮 การเล่น : จอสั่น, คำแนะนำปุ่ม, ตัวนับ FPS, สลับเครื่องมืออัตโนมัติ
	  📱 หน้าจอ  : ขนาด UI, ขนาดปุ่มมือถือ
	ใช้ได้ทั้งเมาส์และนิ้ว (ลากแถบเลื่อน/แตะปุ่ม)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)
local ClientSettings = require(script.Parent.ClientSettings)
local Audio = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Audio"))

local SettingsUI = {}
local C = UIKit.Colors
local W = WoodKit.Colors
local ui = {}
local controls = {} -- [key] = refresh()

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- หัวข้อหมวด: ป้ายกระดาษ + เส้นไม้ยาว
local function section(order, icon, text)
	local f = UIKit.Frame(ui.List, { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = order })
	WoodKit.Frame(f, { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, 2), BackgroundColor3 = W.WoodDark, BackgroundTransparency = 0.3 })
	local tag = WoodKit.Parchment(f, { Size = UDim2.fromOffset(170, 38), Position = UDim2.fromOffset(0, 1), ZIndex = 2 })
	WoodKit.Ink(tag, { Size = UDim2.new(1, -14, 1, 0), Position = UDim2.fromOffset(12, 0), Text = icon .. "  " .. text, TextSize = 22, ZIndex = 3 })
	return f
end

-- แถวกระดาษ: เหรียญไอคอน + ชื่อ (+ คำอธิบาย)
local function row(order, icon, label, sub)
	local f = WoodKit.Parchment(ui.List, { Size = UDim2.new(1, 0, 0, sub and 68 or 58), LayoutOrder = order })
	local m = sub and 52 or 44
	WoodKit.Medallion(f, icon, m, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 2 }, rgb(44, 40, 70))
	WoodKit.Ink(f, { Size = UDim2.new(0.44, -40, 0, 28), Position = UDim2.fromOffset(m + 22, sub and 8 or 15), Text = label, TextSize = 21 })
	if sub then
		WoodKit.Ink(f, { Size = UDim2.new(0.44, -40, 0, 20), Position = UDim2.fromOffset(m + 22, 38), Text = sub, TextSize = 14, Font = UIKit.Fonts.Bold, TextColor3 = W.InkDim })
	end
	return f
end

-- แถบเลื่อน (ลากด้วยเมาส์หรือนิ้ว): ร่องไม้เข้ม + แถบแดง + ปุ่มทองกลม + กล่องตัวเลข
local function slider(order, key, icon, label, minV, maxV, fmt, sub)
	local f = row(order, icon, label, sub)
	local track = WoodKit.Frame(f, { Size = UDim2.new(0.4, 0, 0, 16), Position = UDim2.new(0.46, 0, 0.5, -8), BackgroundColor3 = rgb(40, 26, 18), Active = true })
	WoodKit.Corner(track, "round")
	WoodKit.Stroke(track, W.WoodDark, 2, 0)
	local fill = WoodKit.Frame(track, { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = rgb(196, 42, 40) })
	WoodKit.Corner(fill, "round")
	UIKit.Gradient(fill, rgb(255, 255, 255), rgb(170, 150, 150), 90)
	local knob = WoodKit.Frame(track, { Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = W.Gold, ZIndex = 3 })
	WoodKit.Corner(knob, "round")
	WoodKit.Stroke(knob, rgb(110, 70, 24), 2.5, 0)
	UIKit.Gradient(knob, rgb(255, 255, 255), rgb(180, 150, 110), 90)
	local box = WoodKit.Board(f, { Size = UDim2.fromOffset(76, 36), Position = UDim2.new(1, -88, 0.5, -18) }, rgb(36, 24, 16))
	local val = UIKit.Text(box, { Size = UDim2.fromScale(1, 1), Text = "", Font = UIKit.Fonts.Title, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center })
	local function show(v)
		local k = math.clamp((v - minV) / (maxV - minV), 0, 1)
		fill.Size = UDim2.fromScale(k, 1)
		knob.Position = UDim2.fromScale(k, 0.5)
		val.Text = fmt(v)
	end
	local dragging = false
	local function setFromX(x, save)
		local k = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = minV + (maxV - minV) * k
		v = math.floor(v * 100 + 0.5) / 100
		show(v)
		ClientSettings.Set(key, v, not save)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X, false)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X, false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			setFromX(input.Position.X, true)
		end
	end)
	controls[key] = function()
		show(ClientSettings.Get(key))
	end
end

-- สวิตช์: เปิด = แดงขอบทอง ปุ่มทองชิดขวา · ปิด = ไม้เข้ม ปุ่มทองชิดซ้าย
local function toggle(order, key, icon, label, sub)
	local f = row(order, icon, label, sub)
	local sw = WoodKit.Button(f, "Red", { Size = UDim2.fromOffset(112, 40), Position = UDim2.new(1, -124, 0.5, -20), Text = "", TextSize = 18 }, function()
		ClientSettings.Set(key, not ClientSettings.Get(key))
		controls[key]()
	end)
	sw:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	local word = UIKit.Text(sw, { Size = UDim2.new(1, -44, 1, 0), Text = "", Font = UIKit.Fonts.Title, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center })
	local knob = WoodKit.Frame(sw, { Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = W.Gold })
	WoodKit.Corner(knob, "round")
	WoodKit.Stroke(knob, rgb(110, 70, 24), 2.5, 0)
	UIKit.Gradient(knob, rgb(255, 255, 255), rgb(180, 150, 110), 90)
	controls[key] = function()
		local on = ClientSettings.Get(key)
		WoodKit.Style(sw, on and "Red" or "Dark")
		word.Text = on and "เปิด" or "ปิด"
		word.Position = on and UDim2.fromOffset(4, 0) or UDim2.fromOffset(40, 0)
		knob.Position = on and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 22, 0.5, 0)
	end
end

local function segmented(order, key, icon, label, options, sub)
	local f = row(order, icon, label, sub)
	local holder = UIKit.Frame(f, { Size = UDim2.new(0.55, 0, 0, 42), Position = UDim2.new(0.45, -14, 0.5, -21), BackgroundTransparency = 1 })
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	l.Padding = UDim.new(0, 8)
	l.Parent = holder
	local buttons = {}
	for i, o in ipairs(options) do
		buttons[o[1]] = WoodKit.Button(holder, "Dark", { Size = UDim2.fromOffset(100, 42), Text = o[2], TextSize = 19, LayoutOrder = i }, function()
			ClientSettings.Set(key, o[1])
			controls[key]()
		end)
	end
	controls[key] = function()
		for id, b in pairs(buttons) do
			WoodKit.Style(b, ClientSettings.Get(key) == id and "Red" or "Dark")
		end
	end
end

function SettingsUI.Refresh()
	for _, fn in pairs(controls) do
		fn()
	end
end

function SettingsUI.Open()
	SettingsUI.Refresh()
	ui.Panel.Visible = true
	UIKit.Pop(ui.Panel)
end

function SettingsUI.Close()
	ui.Panel.Visible = false
end

function SettingsUI.Toggle()
	if ui.Panel.Visible then
		SettingsUI.Close()
	else
		SettingsUI.Open()
	end
end

function SettingsUI.IsOpen()
	return ui.Panel ~= nil and ui.Panel.Visible
end

-- ปุ่มเฟือง ⚙ ระหว่างเล่น (ในล็อบบี้มีปุ่มในแถบเมนูซ้ายอยู่แล้ว)
-- parent = การ์ดกองไฟมุมขวาบนของ HUD (โชว์เฉพาะในแมพ) -> ปุ่มติดอยู่ซ้ายการ์ด ย่อ/ขยายไปด้วยกัน
local function gearButton(gui, parent)
	local b = UIKit.ColorButton(parent or gui, rgb(70, 76, 120), {
		Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = parent and UDim2.new(0, -12, 0, 4) or UDim2.new(1, -310, 0, 22), Text = "⚙", TextSize = 28,
	}, SettingsUI.Toggle)
	b:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	UIKit.EnsureTouchSize(b, 44, SettingsUI.Toggle)
	if not parent then
		UIKit.AutoScale(b)
		local function upd()
			b.Visible = Players.LocalPlayer:GetAttribute("InRun") == true
		end
		Players.LocalPlayer:GetAttributeChangedSignal("InRun"):Connect(upd)
		upd()
	end
end

function SettingsUI.Init(gui, handlers)
	handlers = handlers or {}
	local win = WoodKit.Window(gui, { Name = "SettingsWindow", Size = Vector2.new(860, 680), Title = "⚙ ตั้งค่า", TitleWidth = 290, OnClose = SettingsUI.Close })
	ui.Panel = win.Frame
	local body = win.Body
	UIKit.RegisterWindow(ui.Panel, SettingsUI.Close, { Dim = 0.55 })
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -60, 1, -150)
	list.Position = UDim2.fromOffset(30, 50)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = W.Gold
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = body
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, 8)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingRight, pad.PaddingTop, pad.PaddingLeft = UDim.new(0, 12), UDim.new(0, 4), UDim.new(0, 2)
	pad.Parent = list
	ui.List = list

	local pct = function(v)
		return math.floor(v * 100 + 0.5) .. "%"
	end
	section(1, "🔊", "เสียง")
	local hasMusic = false
	for _, def in pairs(Audio.Music) do
		if def.Id ~= "" then
			hasMusic = true
		end
	end
	slider(2, "MusicVol", "🎵", "เพลง", 0, 1, pct, not hasMusic and "ยังไม่ได้ใส่เพลง (ใส่ ID ใน Audio.lua)" or nil)
	slider(3, "AmbientVol", "🌲", "เสียงบรรยากาศ", 0, 1, pct)
	slider(4, "SfxVol", "💥", "เอฟเฟกต์", 0, 1, pct)
	section(10, "🎨", "กราฟิก")
	segmented(11, "Quality", "🖥", "คุณภาพภาพ", { { "Low", "ต่ำ" }, { "Medium", "กลาง" }, { "High", "สูง" } }, "มือถือ/เครื่องช้า แนะนำ \"ต่ำ\"")
	section(20, "🎮", "การเล่น")
	toggle(21, "Shake", "⚔", "จอสั่น", "ตอนโดนตี / บอสกระแทก")
	toggle(22, "Hints", "🏃", "คำแนะนำปุ่ม", "แถบบอกปุ่มด้านล่างจอ")
	toggle(23, "ShowFPS", "📈", "แสดง FPS", "ดูความลื่นของเกม")
	toggle(24, "AutoTool", "🪓", "สลับเครื่องมืออัตโนมัติ", "ตีต้นไม้/หิน/สัตว์ = หยิบขวาน/อีเต้อ/อาวุธที่ดีที่สุดเอง")
	section(30, "📱", "หน้าจอ")
	slider(31, "UIScale", "🔍", "ขนาด UI", 0.7, 1.3, pct, "ย่อ/ขยายหน้าต่างทั้งหมด")
	slider(32, "TouchSize", "👆", "ขนาดปุ่มมือถือ", 0.8, 1.4, pct, "ปุ่มบนจอสำหรับนิ้ว")

	local bottom = UIKit.Frame(body, { Size = UDim2.new(1, -40, 0, 54), Position = UDim2.new(0, 20, 1, -84), BackgroundTransparency = 1 })
	local bl = Instance.new("UIListLayout")
	bl.FillDirection = Enum.FillDirection.Horizontal
	bl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	bl.Padding = UDim.new(0, 16)
	bl.Parent = bottom
	WoodKit.Button(bottom, "Red", { Size = UDim2.fromOffset(240, 52), Text = "📖 ดูวิธีเล่น", TextSize = 21 }, function()
		SettingsUI.Close()
		if handlers.Tutorial then
			handlers.Tutorial()
		end
	end)
	WoodKit.Button(bottom, "Dark", { Size = UDim2.fromOffset(240, 52), Text = "🔄 ค่าเริ่มต้น", TextSize = 21 }, function()
		for k, v in pairs(ClientSettings.Defaults) do
			ClientSettings.Set(k, v)
		end
		SettingsUI.Refresh()
	end)

	gearButton(gui, handlers.GearParent)

	-- ตัวนับ FPS
	local fps = UIKit.Text(gui, { Size = UDim2.fromOffset(120, 22), Position = UDim2.new(0, 12, 1, -28), Text = "", TextSize = 16, Font = UIKit.Fonts.Title, TextColor3 = C.Good, Visible = false })
	local frames, acc = 0, 0
	RunService.RenderStepped:Connect(function(dt)
		if not fps.Visible then
			return
		end
		frames += 1
		acc += dt
		if acc >= 0.5 then
			local v = math.floor(frames / acc + 0.5)
			fps.Text = "FPS " .. v
			fps.TextColor3 = v >= 50 and C.Good or (v >= 30 and C.Gold or C.Bad)
			frames, acc = 0, 0
		end
	end)
	local function apply(key, v)
		if key == "ShowFPS" then
			fps.Visible = v == true
		elseif key == "UIScale" then
			UIKit.UserScale = v
			UIKit.RefreshScale()
		end
		if controls[key] and ui.Panel.Visible then
			controls[key]()
		end
	end
	ClientSettings.OnChanged(apply)
	apply("ShowFPS", ClientSettings.Get("ShowFPS"))
	apply("UIScale", ClientSettings.Get("UIScale"))
end

return SettingsUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000088"><Properties><string name="Name">SkinStreamer</string><ProtectedString name="Source"><![CDATA[--[[
	SkinStreamer — สวมโมเดลจริง (EditableMesh) ให้ของที่มีแท็ก MeshSkin เมื่อโหลดเข้ามาในระยะ (streaming)
	ทำทีละไม่กี่ชิ้นต่อเฟรม กันเกมกระตุก
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnimalSkins = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AnimalSkins"))

local SkinStreamer = {}
local queue = {}
local queued = {}

local function push(inst)
	if queued[inst] or inst:GetAttribute("Skinned") then
		return
	end
	queued[inst] = true
	table.insert(queue, inst)
end

function SkinStreamer.Init()
	for _, inst in ipairs(CollectionService:GetTagged("MeshSkin")) do
		push(inst)
	end
	CollectionService:GetInstanceAddedSignal("MeshSkin"):Connect(push)
	RunService.Heartbeat:Connect(function()
		local budget = os.clock() + 0.004
		while #queue > 0 and os.clock() < budget do
			local inst = table.remove(queue, 1)
			queued[inst] = nil
			if inst.Parent then
				-- รอชิ้นส่วนโหลดครบ (streaming อาจมาไม่พร้อมกัน)
				if not inst:FindFirstChildWhichIsA("BasePart", true) then
					task.delay(0.5, push, inst)
				else
					local ok, err = pcall(AnimalSkins.Skin, inst)
					if not ok then
						warn("[AS] skin", inst:GetFullName(), err)
					end
				end
			end
		end
	end)
end

return SkinStreamer
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000089"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[--[[
	SoundController — ระบบเสียงทั้งเกม (ฝั่งผู้เล่น)
	  เพลง     : เปลี่ยนตามสถานการณ์อัตโนมัติ (ล็อบบี้ / กลางวัน / พลบค่ำ / กลางคืน / พระจันทร์เลือด / บอส / ชนะ / แพ้) + ครอสเฟด
	  บรรยากาศ : ป่ากลางวัน-กลางคืน, กองไฟ (ดังขึ้นเมื่อเข้าใกล้), ลม (เขตวายุ)
	  เอฟเฟกต์ : SoundController.Play("Reward") — รายชื่อใน Shared/Audio.lua
	  ระดับเสียงแยก 3 กลุ่ม (เพลง/บรรยากาศ/เอฟเฟกต์) ปรับในหน้าตั้งค่า
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientSettings = require(script.Parent.ClientSettings)

local SoundController = {}
local player = Players.LocalPlayer
local groups = {}
local music = {} -- [name] = Sound
local ambient = {} -- [name] = Sound
local currentMusic
local oneShot -- เพลงชนะ/แพ้ (เล่นทับเพลงปกติชั่วคราว)

local function group(name, vol)
	local g = SoundService:FindFirstChild(name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = name
		g.Parent = SoundService
	end
	g.Volume = vol
	return g
end

local function makeLoop(def, g, name)
	if not def or def.Id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.Id
	s.Looped = not def.NoLoop
	s.Volume = 0
	s.SoundGroup = g
	s:SetAttribute("Base", def.Volume or 0.5)
	s.Parent = SoundService
	return s
end

local function fadeTo(s, vol, time)
	if not s then
		return
	end
	if vol > 0 and not s.IsPlaying then
		s:Play()
	end
	local t = TweenService:Create(s, TweenInfo.new(time or 2), { Volume = vol })
	t:Play()
	if vol <= 0 then
		t.Completed:Once(function()
			if s.Volume <= 0.001 then
				s:Pause()
			end
		end)
	end
end

-- เอฟเฟกต์สั้นๆ (2D)
function SoundController.Play(name, pitch)
	local def = Audio.Sfx[name]
	if not def or def.Id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def.Id
	s.Volume = def.Volume or 0.5
	s.PlaybackSpeed = (def.Pitch or 1) * (pitch or 1)
	s.SoundGroup = groups.Sfx
	s.Parent = SoundService
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(10, function()
		if s.Parent then
			s:Destroy()
		end
	end)
	s:Play()
end

-- เพลงชนะ/แพ้: หรี่เพลงปกติ เล่นจบแล้วคืน
function SoundController.Sting(name)
	local s = music[name]
	if not s then
		return
	end
	oneShot = s
	s.TimePosition = 0
	fadeTo(currentMusic and music[currentMusic], 0, 0.8)
	s.Volume = s:GetAttribute("Base")
	s:Play()
	task.delay(math.max(s.TimeLength, 8), function()
		if oneShot == s then
			oneShot = nil
			fadeTo(s, 0, 2)
			currentMusic = nil -- ให้ลูปเลือกเพลงใหม่
		end
	end)
end

local function wantedMusic(state)
	if not player:GetAttribute("InRun") then
		return "Lobby"
	end
	local boss = state:GetAttribute("BossId")
	if boss and boss ~= "" then
		return "Boss"
	end
	local phase = state:GetAttribute("Phase")
	if phase == "Night" then
		return state:GetAttribute("BloodMoon") and "BloodMoon" or "Night"
	elseif phase == "Dusk" then
		return "Dusk"
	elseif phase == "Ended" then
		return nil
	end
	return "Day"
end

local function applyVolumes()
	groups.Music.Volume = ClientSettings.Get("MusicVol")
	groups.Ambient.Volume = ClientSettings.Get("AmbientVol")
	groups.Sfx.Volume = ClientSettings.Get("SfxVol")
end

function SoundController.Init(state)
	groups.Music = group("ASMusic", 0.6)
	groups.Ambient = group("ASAmbient", 0.7)
	groups.Sfx = group("ASSfx", 0.8)
	applyVolumes()
	ClientSettings.OnChanged(function(key)
		if key == "MusicVol" or key == "AmbientVol" or key == "SfxVol" then
			applyVolumes()
		end
	end)
	-- เสียงอื่นๆ ทั้งเกม (ตี/เดิน/กองไฟ/เอฟเฟกต์ในโลก/ของ Roblox) ที่ยังไม่มีกลุ่ม -> เข้ากลุ่มให้แถบปรับเสียงคุมได้จริง
	local function adopt(d)
		if d:IsA("Sound") and d.SoundGroup == nil then
			d.SoundGroup = d.Looped and groups.Ambient or groups.Sfx
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		adopt(d)
	end
	workspace.DescendantAdded:Connect(adopt)
	SoundService.DescendantAdded:Connect(adopt)
	for name, def in pairs(Audio.Music) do
		music[name] = makeLoop(def, groups.Music, "Music_" .. name)
	end
	for name, def in pairs(Audio.Ambient) do
		ambient[name] = makeLoop(def, groups.Ambient, "Amb_" .. name)
	end

	-- เลือกเพลง/บรรยากาศทุกครึ่งวินาที
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		if not oneShot then
			local want = wantedMusic(state)
			if want ~= currentMusic then
				if currentMusic then
					fadeTo(music[currentMusic], 0, 2.5)
				end
				currentMusic = want
				local s = want and music[want]
				if s then
					fadeTo(s, s:GetAttribute("Base"), 2.5)
				end
			end
		end
		-- บรรยากาศ
		local inRun = player:GetAttribute("InRun")
		local phase = state:GetAttribute("Phase")
		local night = phase == "Night" or phase == "Dusk"
		local char = player.Character
		local pos = char and char:GetPivot().Position
		local camp = state:GetAttribute("CampPos")
		local campK = 0
		if inRun and pos and camp then
			campK = math.clamp(1 - ((pos - camp) * Vector3.new(1, 0, 1)).Magnitude / 90, 0, 1)
		end
		local function set(name, k)
			local s = ambient[name]
			if s then
				local target = s:GetAttribute("Base") * k
				if math.abs(s.Volume - target) > 0.02 then
					fadeTo(s, target, 1.2)
				end
			end
		end
		set("ForestDay", inRun and not night and 1 or 0)
		set("ForestNight", (inRun and night or not inRun) and 1 or 0)
		set("Campfire", campK)
		local biome = SoundController.Biome and SoundController.Biome() or ""
		set("Wind", inRun and biome == "Air" and 1 or 0)
	end)
end

-- เสียงตามเหตุการณ์ (เรียกจาก Main ตอนได้ Cinematic)
local EVENT_SFX = {
	NightStart = "NightStart", Dusk = "Dusk", Dawn = "Dawn", WaveIncoming = "WaveIncoming", BossIntro = "BossIntro",
	BossFelled = "BossFelled", Downed = "Downed", Revived = "Revive", Died = "Death", FireOut = "FireOut",
	CampUpgrade = "CampUpgrade", SpiritFreed = "Spirit", SpiritRescued = "Spirit", Purchased = "Purchase", GameOver = "GameOver",
	StalkerWarning = "StalkerWarn",
}
function SoundController.OnCinematic(kind, d)
	local sfx = EVENT_SFX[kind]
	if sfx then
		SoundController.Play(sfx)
	end
	if kind == "GameOver" then
		SoundController.Sting("Defeat")
	elseif kind == "Ending" or kind == "BossFelled" then
		SoundController.Sting("Victory")
	end
	local _ = d
end

return SoundController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008A"><Properties><string name="Name">StoreUI</string><ProtectedString name="Source"><![CDATA[--[[
	StoreUI — ร้านค้าในล็อบบี้ (ปุ่ม ♦️ ร้านค้า / ปุ่ม + ข้าง Ruby) · ธีมกรอบไม้ (WoodKit)
	  เติม Ruby : Developer Product (Robux -> Ruby) — Config.DiamondPacks (ภาพถุง/หีบจาก Shared/PanelArt)
	  ID ที่ยังเป็น 0 = ยังไม่ได้สร้างใน Creator Hub -> ปุ่มเป็น "เร็วๆ นี้" (กดแล้วไม่พัง)
	  (Game Pass ไม่ขายในหน้านี้แล้ว · พรีเมียม Season Pass ซื้อได้ที่หน้า ภารกิจ > Season Pass)
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(script.Parent.UIKit)
local WoodKit = require(script.Parent.WoodKit)

local StoreUI = {}
local player = Players.LocalPlayer
local W = WoodKit.Colors
local RS = utf8.char(0xE002) -- ไอคอน Robux ในฟอนต์ของ Roblox
local ui = {}
local profile

local CARD_W, CARD_H, GAP = 236, 248, 24
-- ภาพของแต่ละแพ็ก: { ชื่อภาพ, ความกว้าง, x, y } (แพ็กสุดท้าย = หีบใหญ่ + ถุงข้างหน้า)
local PACK_ART = {
	{ { "Pack1", 120, 0, 0 } },
	{ { "Pack2", 166, 0, 0 } },
	{ { "Pack3", 132, 0, 0 } },
	{ { "Pack4", 178, 0, 0 } },
	{ { "Pack4", 182, 10, -6 }, { "Pack1", 76, -62, 16 } },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function packArt(card, i)
	local shown = false
	for k, a in ipairs(PACK_ART[i] or PACK_ART[#PACK_ART]) do
		if WoodKit.Art(card, a[1], a[2], { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, a[3], 0, 96 + a[4]), ZIndex = 3 + k }) then
			shown = true
		end
	end
	if not shown then
		-- โหลดภาพไม่ได้: กองทับทิมวาดจาก Frame แทน
		local heaps = ({ { { 0, 0, 84 } }, { { -26, 6, 70 }, { 22, -2, 78 } } })[i] or { { -34, 10, 64 }, { 34, 10, 64 }, { 0, -6, 84 } }
		for k, h in ipairs(heaps) do
			UIKit.Icon(card, "Ruby", h[3], { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, h[1], 0, 102 + h[2]), ZIndex = 3 + k })
		end
	end
end

local function tag(card, text)
	local r = WoodKit.Board(card, { Size = UDim2.fromOffset(96, 28), Position = UDim2.new(1, -78, 0, -12), Rotation = 10, ZIndex = 12 }, rgb(150, 22, 46), W.Gold)
	UIKit.Text(r, { Size = UDim2.fromScale(1, 1), Text = text, Font = UIKit.Fonts.Title, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 13 })
end

local function packCard(i, pack)
	local col, row = (i - 1) % 4, (i - 1) // 4
	local card = WoodKit.Board(ui.List, { Size = UDim2.fromOffset(CARD_W, CARD_H), Position = UDim2.fromOffset(col * (CARD_W + GAP), row * (CARD_H + 18)) }, rgb(74, 46, 28))
	-- ป้ายชื่อกระดาษ
	local title = WoodKit.Parchment(card, { Size = UDim2.new(1, -28, 0, 38), Position = UDim2.fromOffset(14, 10), ZIndex = 2 })
	WoodKit.Ink(title, { Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), Text = pack.Name, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	packArt(card, i)
	-- ริบบิ้นแดงจำนวน Ruby
	local ribbon = WoodKit.Board(card, { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 138), ZIndex = 8 }, W.Red, W.Gold)
	UIKit.Text(ribbon, { Size = UDim2.fromScale(1, 1), Text = pack.Diamonds .. " Ruby", Font = UIKit.Fonts.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9 })
	if (pack.Bonus or 0) > 0 then
		UIKit.Text(card, {
			Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 180), Text = "+" .. pack.Bonus .. " โบนัส!", Font = UIKit.Fonts.Title, TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = W.Gold, ZIndex = 9,
		})
	end
	if pack.Tag then
		tag(card, pack.Tag)
	end
	local ready = (pack.ProductId or 0) > 0
	WoodKit.Button(card, ready and "Wood" or "Dark", {
		Size = UDim2.new(1, -40, 0, 34), Position = UDim2.new(0, 20, 1, -40), Text = ready and (RS .. " " .. pack.Robux) or "เร็วๆ นี้", TextSize = 19, ZIndex = 10,
	}, function()
		if ready then
			MarketplaceService:PromptProductPurchase(player, pack.ProductId)
		end
	end)
	if ready then
		WoodKit.Shine(card, i * 0.35)
	end
end

function StoreUI.Refresh()
	if not ui.Panel then
		return
	end
	ui.Gems.Text = tostring(player:GetAttribute("Diamonds") or (profile and profile.Diamonds) or 0)
	for _, c in ipairs(ui.List:GetChildren()) do
		if c:IsA("GuiObject") and c ~= ui.Hint then
			c:Destroy()
		end
	end
	for i, pack in ipairs(Config.DiamondPacks) do
		packCard(i, pack)
	end
end

function StoreUI.Open()
	ui.Panel.Visible = true
	UIKit.Pop(ui.Panel)
	StoreUI.Refresh()
end

function StoreUI.Close()
	if ui.Panel then
		ui.Panel.Visible = false
	end
end

function StoreUI.IsOpen()
	return ui.Panel ~= nil and ui.Panel.Visible
end

function StoreUI.SetProfile(p)
	profile = p
	if StoreUI.IsOpen() then
		StoreUI.Refresh()
	end
end

function StoreUI.Init(gui)
	local win = WoodKit.Window(gui, { Name = "StoreWindow", Size = Vector2.new(1080, 640), Title = "🛒 ร้านค้า", TitleWidth = 320, OnClose = StoreUI.Close })
	ui.Panel = win.Frame
	UIKit.RegisterWindow(ui.Panel, StoreUI.Close, { Dim = 0.55 })
	local body = win.Body
	ui.Gems = WoodKit.RubyPill(body, { Position = UDim2.new(1, -206, 0, 42) })
	-- แท็บเดียว (เติม Ruby) — ไว้บอกว่าอยู่หน้าไหน
	local tab = WoodKit.Tab(body, "      เติม Ruby", 1, 190)
	tab.Position = UDim2.fromOffset(32, 44)
	WoodKit.SetTab(tab, true)
	UIKit.Icon(tab, "Ruby", 38, { Position = UDim2.fromOffset(22, 3), ZIndex = 2 })
	-- รายการแพ็ก (วางเอง 4 ต่อแถว) + กระดาษคำอธิบายมุมขวาล่าง
	local list = UIKit.Frame(body, { BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 104), Size = UDim2.new(1, -64, 1, -124) })
	ui.List = list
	local hint = WoodKit.Parchment(list, { Size = UDim2.new(1, -(CARD_W + GAP), 0, 84), Position = UDim2.new(0, CARD_W + GAP, 0, 2 * CARD_H + 18 - 84) })
	WoodKit.Ink(hint, {
		Size = UDim2.new(1, -40, 1, -12), Position = UDim2.fromOffset(20, 6), TextSize = 18, Font = UIKit.Fonts.Bold, TextColor3 = W.InkDim, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center, Text = "Ruby ใช้ซื้อคลาส ข้ามเลเวลคลาส รีโรลสต็อค และชุดเริ่มต้น — ได้ฟรีจากการเล่น/หม้อรางวัลรายวันด้วยนะ!",
	})
	ui.Hint = hint
	player:GetAttributeChangedSignal("Diamonds"):Connect(function()
		if StoreUI.IsOpen() then
			ui.Gems.Text = tostring(player:GetAttribute("Diamonds") or 0)
		end
	end)
end

return StoreUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008B"><Properties><string name="Name">TeamPing</string><ProtectedString name="Source"><![CDATA[--[[
	TeamPing — ปิงบอกเพื่อน
	  PC: กด G = ปิงจุดที่เมาส์เล็ง (ยกเว้นตอนยืนหน้าเครื่องย่อยที่ใช้ G อยู่แล้ว) · มือถือ: ปุ่ม 📍 ข้างการ์ดกองไฟ (ปิงจุดกลางจอ)
	  ชนิด (server ตัดสิน): Enemy แดง = เล็งสัตว์ · Item เหลือง = ของบนพื้น/หีบ · Go ฟ้า = "มาที่นี่"
	  ทุกคนในทีมเห็น ~8 วิ: ป้ายลอย (ไอคอน + ชื่อคนปิง + ระยะ), จุดบนเข็มทิศ, จุดบนแผนที่ใหญ่ + เสียงเบาๆ
	  จำกัด 1 ครั้ง / 1.5 วิ (server ตรวจซ้ำ)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)

local TeamPing = {}
local player = Players.LocalPlayer
local C = UIKit.Colors

local DURATION = 8
local COOLDOWN = 1.5
local KINDS = {
	Enemy = { Color = Color3.fromRGB(255, 80, 80), Icon = "⚠", Text = "ศัตรู!" },
	Item = { Color = Color3.fromRGB(255, 214, 70), Icon = "💰", Text = "ของตรงนี้" },
	Go = { Color = Color3.fromRGB(80, 170, 255), Icon = "📍", Text = "มาที่นี่" },
}

local active = {} -- [fromUserId] = { Billboard, Attachment, MapMarker, Target, Position, Expire, Label }
local lastSend = 0
local deps = {}

local function out()
	return not player:GetAttribute("InRun") or player:GetAttribute("Dead")
end

-- เล็ง: เมาส์ (PC) หรือกลางจอ (มือถือ)
local function aim(useCenter)
	local cam = Workspace.CurrentCamera
	local p = useCenter and (cam.ViewportSize / 2) or UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(p.X, p.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, cam }
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
	if res then
		return res.Position, res.Instance
	end
	return nil
end

function TeamPing.Send(useCenter)
	if out() then
		return
	end
	local now = os.clock()
	if now - lastSend < COOLDOWN then
		return
	end
	local pos, inst = aim(useCenter)
	if not pos then
		return
	end
	lastSend = now
	Remotes.Get("TeamPing"):FireServer(pos, inst)
end

local function clear(uid)
	local p = active[uid]
	if not p then
		return
	end
	active[uid] = nil
	if p.Attachment then
		p.Attachment:Destroy()
	end
	if p.Billboard then
		p.Billboard:Destroy()
	end
	if p.MapMarker then
		p.MapMarker:Destroy()
	end
	if deps.HUD and deps.HUD.ExtraPOI then
		deps.HUD.ExtraPOI["ping_" .. uid] = nil
	end
end

local function targetPos(p)
	local t = p.Target
	if t and t.Parent then
		local ok, cf = pcall(t.GetPivot, t)
		if ok and cf then
			return cf.Position
		end
	end
	return p.Position
end

local function show(data)
	if type(data) ~= "table" or typeof(data.Position) ~= "Vector3" then
		return
	end
	local spec = KINDS[data.Kind] or KINDS.Go
	local uid = tonumber(data.From) or 0
	clear(uid)
	local target = typeof(data.Target) == "Instance" and data.Target:IsA("PVInstance") and data.Target or nil
	local att = Instance.new("Attachment")
	att.Name = "Ping"
	att.WorldPosition = data.Position
	att.Parent = Workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(150, 64)
	bb.StudsOffsetWorldSpace = Vector3.new(0, target and 4 or 2.5, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 3000
	bb.Adornee = att
	bb.Parent = att
	local icon = UIKit.Text(bb, { Size = UDim2.new(1, 0, 0, 34), Text = spec.Icon, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = spec.Color })
	local label = UIKit.Text(bb, {
		Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 34), TextSize = 15, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = spec.Color, Text = "",
	})
	-- เด้งตอนขึ้น
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = icon
	UIKit.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	local entry = {
		Attachment = att, Billboard = bb, Label = label, Target = target, Position = data.Position, Expire = os.clock() + DURATION,
		Name = tostring(data.Name or "?"), Spec = spec,
	}
	-- แผนที่ใหญ่
	local map = deps.Map and deps.Map.MapFrame
	if map then
		entry.MapMarker = UIKit.Text(map, {
			Size = UDim2.fromOffset(24, 24), Text = spec.Icon, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = spec.Color, ZIndex = 6,
		})
	end
	active[uid] = entry
	-- เข็มทิศ
	if deps.HUD and deps.HUD.ExtraPOI then
		deps.HUD.ExtraPOI["ping_" .. uid] = { Position = data.Position, Icon = spec.Icon, Color = spec.Color, Expire = entry.Expire }
	end
	if deps.Sound then
		pcall(deps.Sound.Play, "Notify", data.Kind == "Enemy" and 0.9 or 1.35)
	end
	if uid ~= player.UserId and deps.HUD and deps.HUD.Notify then
		deps.HUD.Notify(string.format("%s %s: %s", spec.Icon, entry.Name, spec.Text), "Info")
	end
end

local function tick()
	local now = os.clock()
	local char = player.Character
	local me = char and char:GetPivot().Position
	local state = deps.State
	local size = state and state:GetAttribute("MapSize") or 6144
	for uid, p in pairs(active) do
		if now > p.Expire or not player:GetAttribute("InRun") then
			clear(uid)
		else
			local pos = targetPos(p)
			p.Attachment.WorldPosition = pos
			if deps.HUD and deps.HUD.ExtraPOI and deps.HUD.ExtraPOI["ping_" .. uid] then
				deps.HUD.ExtraPOI["ping_" .. uid].Position = pos
			end
			local dist = me and math.floor((pos - me).Magnitude * 0.28) or 0
			p.Label.Text = string.format("%s · %s %dm", p.Name, p.Spec.Text, dist)
			-- จางหายช่วง 1.5 วิสุดท้าย
			local left = p.Expire - now
			if left < 1.5 then
				for _, d in ipairs(p.Billboard:GetDescendants()) do
					if d:IsA("TextLabel") then
						d.TextTransparency = 1 - left / 1.5
					end
				end
			end
			if p.MapMarker then
				p.MapMarker.Position = UDim2.new(pos.X / size + 0.5, -12, pos.Z / size + 0.5, -12)
			end
		end
	end
end

function TeamPing.Init(state, hud, map, sound)
	deps.State, deps.HUD, deps.Map, deps.Sound = state, hud, map, sound
	Remotes.Get("TeamPing").OnClientEvent:Connect(show)
	-- ปุ่ม G ชนกับปุ่ม "โยนวัตถุดิบลงเครื่องย่อย" (ProximityPrompt) -> ตอนปุ่มนั้นขึ้นอยู่ ไม่ปิง
	local gPrompts = {}
	local PPS = game:GetService("ProximityPromptService")
	PPS.PromptShown:Connect(function(prompt)
		if prompt.KeyboardKeyCode == Enum.KeyCode.G then
			gPrompts[prompt] = true
		end
	end)
	PPS.PromptHidden:Connect(function(prompt)
		gPrompts[prompt] = nil
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.G then
			return
		end
		for prompt in pairs(gPrompts) do
			if not (prompt.Parent and prompt.Enabled) then
				gPrompts[prompt] = nil
			end
		end
		if next(gPrompts) == nil then
			TeamPing.Send(false)
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.1 then
			acc = 0
			tick()
		end
	end)
	-- มือถือ: ปุ่ม 📍 ใต้ปุ่มแผนที่ ข้างการ์ดกองไฟ (ปิงจุดกลางจอ)
	if UIKit.IsTouch and hud and hud.RightCard then
		local b = UIKit.ColorButton(hud.RightCard, C.Blue, { Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0, -12, 0, 116), Text = "📍", TextSize = 26 }, function()
			TeamPing.Send(true)
		end)
		b:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
		local function upd()
			b.Visible = not out() and not player:GetAttribute("Downed")
		end
		for _, a in ipairs({ "InRun", "Downed", "Dead" }) do
			player:GetAttributeChangedSignal(a):Connect(upd)
		end
		upd()
	end
end

return TeamPing
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008C"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--[[
	Tutorial — หน้าสอนเล่นแบบช่องการ์ตูน (โชว์ครั้งแรกหลังโหลดเข้าล็อบบี้ / เปิดซ้ำได้จากหน้าตั้งค่า "ดูวิธีเล่น")
	  2 หน้า × 4 ช่อง: ภาพในช่องเป็นโมเดลจริงในเกม (ViewportFrame) + คำบรรยายตัวโต
	  หน้าสุดท้ายมีปุ่ม "เล่น" สีเขียว · ดูจบแล้วเซิร์ฟเวอร์จำไว้ (TutorialSeen) ไม่โชว์ซ้ำ
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local StructureModels = require(Shared.StructureModels)
local UIKit = require(script.Parent.UIKit)
local ClassAvatars = require(script.Parent.ClassAvatars)

local Tutorial = {}
local C = UIKit.Colors
local ui = {}
local page = 1
local currentWorld -- WorldModel ของช่องที่กำลังสร้าง (ของในฉากถูกใส่ที่นี่)

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

---------------------------------------------------------------- ฉากในช่อง (โมเดลจริง)
local function asset(folder, name)
	local a = ReplicatedStorage:FindFirstChild("Assets")
	local f = a and a:FindFirstChild(folder)
	local src = f and f:FindFirstChild(name)
	if not src then
		return nil
	end
	local m = src:Clone()
	if m:IsA("BasePart") then
		local wrap = Instance.new("Model")
		m.Parent = wrap
		wrap.PrimaryPart = m
		m = wrap
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	return m
end

-- ย่อ/ขยายให้สูงตามต้องการ แล้ววางเท้าที่ cf
local function place(m, height, cf)
	if not m then
		return nil
	end
	m.Parent = currentWorld
	local _, size = m:GetBoundingBox()
	if size.Y > 0.05 and height then
		pcall(function()
			m:ScaleTo(m:GetScale() * height / size.Y)
		end)
	end
	local bcf, bsize = m:GetBoundingBox()
	local pivot = m:GetPivot()
	local footOffset = pivot.Position.Y - (bcf.Position.Y - bsize.Y / 2)
	local centerOffset = pivot.Position - bcf.Position
	m:PivotTo(cf * CF(centerOffset.X, footOffset, centerOffset.Z) * (pivot - pivot.Position))
	return m
end

local function character(classId, cf)
	local ok, m = pcall(ClassAvatars.Build, classId)
	if ok and m then
		m.Parent = currentWorld
		m:PivotTo(cf)
		return m
	end
	return nil
end

local function structure(kind, cf)
	local ok, m = pcall(StructureModels.Build, kind)
	if ok and m then
		m.Parent = currentWorld
		m:PivotTo(cf)
		return m
	end
	return nil
end

-- กล้องมองทั้งฉากจากมุมที่กำหนด
local function frameCamera(vpf, world, yaw, pitch, zoom)
	local cf, size = world:GetBoundingBox()
	local radius = size.Magnitude / 2
	local dist = radius / math.tan(math.rad(18)) * (zoom or 1)
	local dir = (ANG(0, yaw or 0.6, 0) * ANG(-(pitch or 0.25), 0, 0)).LookVector
	local cam = Instance.new("Camera")
	cam.FieldOfView = 36
	cam.CFrame = CFrame.lookAt(cf.Position - dir * dist, cf.Position)
	cam.Parent = vpf
	vpf.CurrentCamera = cam
end

local SCENES = {
	function(world) -- ป่าสี่ธาตุ
		place(asset("Props", "Fir1"), 16, CF(-7, 0, -4))
		place(asset("Props", "OakPack"), 13, CF(7, 0, -6))
		place(asset("Props", "SnowPine"), 12, CF(0, 0, -12))
		character("Survivor", CF(0, 0, 3) * ANG(0, math.pi + 0.3, 0))
		return { Yaw = 0, Pitch = 0.12, Zoom = 0.75, Sky = { rgb(20, 24, 60), rgb(70, 40, 90) } }
	end,
	function(world) -- กองไฟ
		place(asset("Props", "CampfireLogs"), 4, CF(0, 0, 0))
		place(asset("Props", "LogPileStore"), 3, CF(6, 0, -3))
		character("Survivor", CF(-4.5, 0, 2) * ANG(0, -math.pi / 2 - 0.8, 0))
		return { Yaw = 0.4, Pitch = 0.3, Zoom = 0.85, Sky = { rgb(60, 26, 14), rgb(20, 10, 10) }, Light = rgb(255, 170, 90) }
	end,
	function(world) -- เก็บของ
		place(asset("Props", "Fir1"), 15, CF(4, 0, -3))
		place(asset("Props", "RockLP"), 3.5, CF(-5, 0, -2))
		character("Lumberjack", CF(0, 0, 2) * ANG(0, math.pi / 2 + 0.6, 0))
		return { Yaw = -0.3, Pitch = 0.18, Zoom = 0.78, Sky = { rgb(40, 90, 60), rgb(16, 36, 26) } }
	end,
	function(world) -- คราฟต์ & สร้าง
		place(asset("Props", "Crafter"), 6, CF(-4, 0, -2))
		structure("LogWall", CF(5, 0, -1) * ANG(0, 0.4, 0))
		structure("SpikeTrap", CF(3, 0, 4))
		character("Builder", CF(0.5, 0, 2) * ANG(0, math.pi + 0.5, 0))
		return { Yaw = 0.2, Pitch = 0.25, Zoom = 0.8, Sky = { rgb(70, 60, 30), rgb(26, 22, 14) } }
	end,
	function(world) -- กลางคืนฝูงบุก
		place(asset("Props", "CampfireLogs"), 3.5, CF(-6, 0, 2))
		structure("LogWall", CF(0, 0, 0) * ANG(0, math.pi / 2, 0))
		structure("Ballista", CF(-3, 0, -4))
		character("Hunter", CF(-3, 0, 4) * ANG(0, -math.pi / 2, 0))
		return { Yaw = -0.9, Pitch = 0.22, Zoom = 0.8, Sky = { rgb(12, 14, 40), rgb(6, 6, 14) }, Light = rgb(150, 170, 255) }
	end,
	function(world) -- บอส
		place(asset("Animals", "Terragon"), 14, CF(0, 0, -2) * ANG(0, math.pi + 0.5, 0))
		character("Survivor", CF(4, 0, 8) * ANG(0, 0.4, 0))
		return { Yaw = 0.5, Pitch = 0.1, Zoom = 0.7, Sky = { rgb(90, 20, 20), rgb(20, 6, 6) }, Light = rgb(255, 140, 120) }
	end,
	function(world) -- ช่วยเพื่อน
		local downed = character("Survivor", CF(2, 1, 0) * ANG(0, 0.3, 0) * ANG(math.rad(-90), 0, 0))
		local _ = downed
		character("Medic", CF(-2, 0, 0.5) * ANG(0, -math.pi / 2, 0))
		return { Yaw = 0.25, Pitch = 0.35, Zoom = 0.9, Sky = { rgb(70, 20, 30), rgb(20, 8, 12) } }
	end,
	function(world) -- 99 คืน
		place(asset("Props", "CampfireLogs"), 3.5, CF(0, 0, 0))
		character("Elementalist", CF(-3.5, 0, 1) * ANG(0, math.pi + 0.6, 0))
		character("Hunter", CF(3.5, 0, 1) * ANG(0, math.pi - 0.6, 0))
		character("Scout", CF(0, 0, -3.5) * ANG(0, 0, 0))
		return { Yaw = 0, Pitch = 0.3, Zoom = 0.85, Sky = { rgb(90, 70, 20), rgb(30, 16, 6) }, Light = rgb(255, 210, 140) }
	end,
}

local PANELS = {
	{ Title = "ผืนป่าสี่ธาตุตื่นขึ้นแล้ว", Text = "เอาชีวิตรอดในป่าแห่ง ดิน น้ำ ลม ไฟ ให้ได้ 99 คืน" },
	{ Title = "กองไฟคือชีวิต", Text = "โยนไม้/ถ่านเข้ากองไฟ — ไฟดับ = เขตปลอดภัยหาย!" },
	{ Title = "ออกหาของตอนกลางวัน", Text = "ตัดไม้ ทุบหิน ล่าสัตว์ ถือกระสอบแล้วเก็บของ" },
	{ Title = "คราฟต์ & สร้างฐาน", Text = "โยนวัตถุดิบลงเครื่องคราฟต์ แล้วสร้างกำแพง กับดัก หน้าไม้" },
	{ Title = "กลางคืน ฝูงสัตว์บุก!", Text = "ฝูงธาตุบุกกองไฟทุกคืน — ป้องกันให้ถึงเช้า" },
	{ Title = "บอสธาตุ", Text = "คืน 25 · 50 · 75 · 99 บอสบุก — หลบวงเตือนบนพื้น!" },
	{ Title = "ช่วยเพื่อนที่ล้ม", Text = "ใช้ผ้าพันแผลช่วยเพื่อน — ไม่เหลือใครยืนอยู่ = แพ้ทั้งทีม" },
	{ Title = "99 คืน... และไกลกว่านั้น", Text = "รอดครบ 99 คืน = พิชิต! เล่นต่อเพื่อขึ้นกระดานอันดับ" },
}

---------------------------------------------------------------- ช่องการ์ตูน
local function comicPanel(parent, index)
	local info = PANELS[index]
	local holder = UIKit.Frame(parent, { BackgroundTransparency = 1, LayoutOrder = index })
	local frame = UIKit.Frame(holder, { Size = UDim2.new(1, 0, 0.62, 0), BackgroundColor3 = rgb(14, 14, 20), BackgroundTransparency = 0, Rotation = (index % 2 == 0) and 1.2 or -1.2 })
	UIKit.Corner(frame, 6)
	local st = Instance.new("UIStroke")
	st.Thickness = 5
	st.Color = rgb(240, 236, 226)
	st.Parent = frame
	-- ฉากหลังไล่สี (อยู่ใต้ ViewportFrame — ถ้าใส่ UIGradient ที่ ViewportFrame โมเดลจะมืดตาม)
	local skyBg = UIKit.Frame(frame, { Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0 })
	UIKit.Corner(skyBg, 4)
	local vpf = Instance.new("ViewportFrame")
	vpf.Size = UDim2.new(1, -10, 1, -10)
	vpf.Position = UDim2.fromOffset(5, 5)
	vpf.BackgroundTransparency = 1
	vpf.BorderSizePixel = 0
	vpf.Parent = frame
	local world = Instance.new("WorldModel")
	world.Parent = vpf
	currentWorld = world
	local ok, opts = pcall(SCENES[index], world)
	currentWorld = nil
	opts = ok and opts or {}
	if not ok then
		warn("[AS] tutorial scene", index, opts)
	end
	local sky = opts.Sky or { rgb(30, 30, 50), rgb(10, 10, 20) }
	UIKit.Gradient(skyBg, sky[1], sky[2], 90)
	vpf.Ambient = rgb(150, 150, 165)
	vpf.LightColor = opts.Light or rgb(255, 245, 230)
	vpf.LightDirection = V(-0.5, -1, -0.4)
	-- เลขช่อง
	local num = UIKit.IconBadge(frame, tostring(index), C.Gold, 40, { Position = UDim2.fromOffset(-12, -12), ZIndex = 6 })
	local _ = num
	-- คำบรรยาย
	UIKit.Text(holder, {
		Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.64, 4), Text = info.Title, Font = UIKit.Fonts.Title, TextSize = 26, TextScaled = false,
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Gold, TextWrapped = true,
	})
	UIKit.Text(holder, {
		Size = UDim2.new(1, 0, 0.3, -40), Position = UDim2.new(0, 0, 0.64, 40), Text = info.Text, Font = UIKit.Fonts.Black, TextSize = 21,
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
	})
	return holder, vpf, world, opts
end

local function buildPage(p)
	for _, c in ipairs(ui.Row:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i = 1, 4 do
		local index = (p - 1) * 4 + i
		local holder, vpf, world, opts = comicPanel(ui.Row, index)
		pcall(frameCamera, vpf, world, opts.Yaw, opts.Pitch, opts.Zoom)
		-- เด้งเข้าทีละช่อง
		local sc = Instance.new("UIScale")
		sc.Scale = 0.6
		sc.Parent = holder
		TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, (i - 1) * 0.12), { Scale = 1 }):Play()
	end
	ui.PageLabel.Text = string.format("หน้า %d / %d", p, #PANELS // 4)
	ui.Prev.Visible = p > 1
	ui.Next.Text = p < #PANELS // 4 and "ถัดไป ▶" or "เล่น!"
	ui.Next.BackgroundColor3 = p < #PANELS // 4 and C.Blue or C.Green
end

function Tutorial.Open()
	page = 1
	ui.Root.Visible = true
	UIKit.Pop(ui.Card)
	local ok, err = pcall(buildPage, page)
	if not ok then
		-- สร้างหน้าไม่สำเร็จ: ปิดไปเลย ไม่ปล่อยให้พื้นหลังมืดบังจอ
		warn("[AS] tutorial", err)
		ui.Root.Visible = false
	end
end

function Tutorial.Close()
	ui.Root.Visible = false
	Remotes.Get("TutorialDone"):FireServer()
	if Tutorial.OnClosed then
		Tutorial.OnClosed()
	end
end

function Tutorial.IsOpen()
	return ui.Root ~= nil and ui.Root.Visible
end

function Tutorial.Init(gui)
	local root = UIKit.Frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Visible = false, Active = true })
	ui.Root = root
	local card = UIKit.Card(root, {
		Size = UDim2.fromOffset(1220, 560), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = rgb(26, 26, 34),
	})
	ui.Card = card
	UIKit.Header(card, "📖 วิธีเอาชีวิตรอด", C.Orange)
	local row = UIKit.Frame(card, { Size = UDim2.new(1, -60, 1, -150), Position = UDim2.fromOffset(30, 44), BackgroundTransparency = 1 })
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.25, -18, 1, 0)
	grid.CellPadding = UDim2.fromOffset(24, 0)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = row
	ui.Row = row
	ui.PageLabel = UIKit.Text(card, { Size = UDim2.fromOffset(200, 24), Position = UDim2.new(0, 30, 1, -66), Text = "", TextSize = 18, TextColor3 = C.TextDim })
	ui.Prev = UIKit.ColorButton(card, rgb(90, 96, 140), { Size = UDim2.fromOffset(180, 56), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, -200, 1, -84), Text = "◀ ก่อนหน้า", TextSize = 24, Font = UIKit.Fonts.Title }, function()
		page = math.max(1, page - 1)
		buildPage(page)
	end)
	ui.Next = UIKit.ColorButton(card, C.Green, { Size = UDim2.fromOffset(340, 64), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 80, 1, -90), Text = "ถัดไป ▶", TextSize = 34, Font = UIKit.Fonts.Title }, function()
		if page < #PANELS // 4 then
			page += 1
			buildPage(page)
		else
			Tutorial.Close()
		end
	end)
	local skip = UIKit.Button(card, { Size = UDim2.fromOffset(120, 34), Position = UDim2.new(1, -150, 1, -62), Text = "ข้าม", TextSize = 16 }, Tutorial.Close)
	UIKit.EnsureTouchSize(skip, 44, Tutorial.Close)
	-- Esc = ข้าม (ไม่ปิดเมื่อแตะนอกการ์ด กันกดพลาดตอนอ่าน)
	UIKit.RegisterWindow(root, Tutorial.Close, { Backdrop = false })
end

return Tutorial
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008D"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--[[
	UIKit — ตัวช่วยสร้าง UI ใช้ทั้งเกม
	ธีม: เกม Roblox ยุคใหม่ — ปุ่มนูน 3D สีสด + ขอบเข้มหนา, ตัวหนังสือขาวขอบดำ, ฟอนต์ Fredoka, การ์ดกรมท่าเข้ม
	มีแอนิเมชันเด้งตอนชี้/กด/เปิดหน้าต่าง (UIKit.Pop)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local UIKit = {}

---------------------------------------------------------------- สเกลอัตโนมัติตามขนาดจอ (มือถือจอเล็ก = ย่อ UI ลง)
-- UIKit.AutoScale(frame): ใส่ UIScale ที่ปรับเองเมื่อจอเปลี่ยนขนาด · UIKit.UserScale = ตัวคูณจากหน้าตั้งค่า
--   หน้าต่างกลางจอ (AnchorPoint 0.5,0.5 + ขนาดเป็นพิกเซล) จะถูกย่อเพิ่มจน "พอดีจอเสมอ" (ปุ่มปิด/หัวหน้าต่างไม่หลุดขอบ)
UIKit.UserScale = 1
UIKit.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local scaled = setmetatable({}, { __mode = "k" })
local function viewport()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 50 or vp.Y < 50 then
		vp = Vector2.new(1280, 720)
	end
	return vp
end
function UIKit.GetScale(frame)
	local vp = viewport()
	-- มือถือ: อ้างอิงจอเล็กกว่า (UI ใหญ่ขึ้นนิด ปุ่มกดง่าย) — หน้าต่างใหญ่ยังถูกบีบให้พอดีจอด้านล่าง
	local refX, refY = 1280, 720
	if UIKit.IsTouch then
		refX, refY = 1100, 620
	end
	local base = math.clamp(math.min(vp.X / refX, vp.Y / refY), 0.4, 1) * UIKit.UserScale
	if frame and frame:IsA("GuiObject") and frame.AnchorPoint == Vector2.new(0.5, 0.5) and frame.Size.X.Scale == 0 and frame.Size.Y.Scale == 0 then
		-- เผื่อขอบ: แถบหัวหน้าต่าง (ยื่นขึ้น ~24) + ปุ่มปิด (ยื่นออก ~30) + ระยะห่างจากขอบจอ
		local w, h = frame.Size.X.Offset + 70, frame.Size.Y.Offset + 70
		base = math.min(base, (vp.X - 16) / w, (vp.Y - 16) / h)
	end
	return math.max(base, 0.3)
end
local function scaler(frame)
	local sc = frame:FindFirstChild("AutoScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Name = "AutoScale"
		sc.Parent = frame
	end
	return sc
end
function UIKit.AutoScale(frame)
	scaler(frame).Scale = UIKit.GetScale(frame)
	scaled[frame] = true
	return frame
end
function UIKit.RefreshScale()
	for f in pairs(scaled) do
		if f.Parent then
			scaler(f).Scale = UIKit.GetScale(f)
		end
	end
end
task.defer(function()
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(UIKit.RefreshScale)
	end
end)

UIKit.Colors = {
	Panel = Color3.fromRGB(22, 24, 40),
	Panel2 = Color3.fromRGB(58, 66, 104),
	Outline = Color3.fromRGB(10, 10, 22),
	Gold = Color3.fromRGB(255, 208, 70),
	GoldDim = Color3.fromRGB(176, 150, 96),
	Text = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(176, 184, 214),
	Red = Color3.fromRGB(236, 64, 72),
	Blood = Color3.fromRGB(170, 24, 36),
	Health = Color3.fromRGB(255, 72, 96),
	Hunger = Color3.fromRGB(255, 166, 48),
	Stamina = Color3.fromRGB(64, 224, 150),
	Fire = Color3.fromRGB(255, 138, 40),
	Good = Color3.fromRGB(96, 230, 120),
	Bad = Color3.fromRGB(255, 86, 80),
	-- สีปุ่ม (สดแบบเกมยุคใหม่)
	Green = Color3.fromRGB(72, 214, 96),
	Blue = Color3.fromRGB(56, 156, 255),
	Purple = Color3.fromRGB(150, 96, 255),
	Orange = Color3.fromRGB(255, 150, 40),
	Pink = Color3.fromRGB(255, 92, 168),
	Cyan = Color3.fromRGB(40, 210, 230),
	Element = {
		Earth = Color3.fromRGB(130, 230, 90),
		Water = Color3.fromRGB(80, 200, 255),
		Air = Color3.fromRGB(220, 232, 255),
		Fire = Color3.fromRGB(255, 110, 40),
		All = Color3.fromRGB(255, 70, 90),
	},
}
UIKit.ElementThai = { Earth = "ปฐพี", Water = "วารี", Air = "วายุ", Fire = "อัคคี", All = "ทุกธาตุ" }
UIKit.ElementIcon = { Earth = "🌿", Water = "🌊", Air = "🌪", Fire = "🔥", All = "🩸" }

UIKit.Fonts = {
	Title = Enum.Font.FredokaOne,
	Black = Enum.Font.FredokaOne,
	Bold = Enum.Font.BuilderSansBold,
	Body = Enum.Font.BuilderSansMedium,
}

local function darker(c, k)
	return Color3.new(c.R * k, c.G * k, c.B * k)
end
UIKit.Darker = darker

-- fullScreen = true: เต็มจอจริง (ฉากโหลด/ข้อความภาพยนตร์) · อื่นๆ หลบติ่งกล้อง/ขอบโค้งของมือถือ (DeviceSafeInsets)
function UIKit.Screen(name, order, fullScreen)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	if not fullScreen then
		pcall(function()
			gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
		end)
	end
	gui.DisplayOrder = order or 1
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function UIKit.Frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = UIKit.Colors.Panel
	f.BackgroundTransparency = 0.06
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

function UIKit.Corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, (r or 12) + 2)
	c.Parent = parent
	return c
end

-- ขอบ: ขอบขาวจางๆ (สไตล์กระจกเดิม) -> แปลงเป็นขอบเข้มหนาแบบการ์ตูน, ขอบสีอื่นใช้สีนั้นแต่หนาขึ้น
function UIKit.Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	color = color or Color3.new(1, 1, 1)
	transparency = transparency or 0.2
	local whiteish = color.R > 0.9 and color.G > 0.9 and color.B > 0.9
	if whiteish and transparency >= 0.6 then
		s.Color = UIKit.Colors.Outline
		s.Transparency = 0.1
		s.Thickness = 3
	else
		s.Color = color
		s.Transparency = math.min(transparency, 0.25)
		s.Thickness = math.clamp((thickness or 1) * 1.5, 2, 3.5)
	end
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UIKit.Gradient(parent, c0, c1, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

-- ขอบดำรอบตัวอักษร (ตัวหนังสือขาวขอบดำแบบเกมยุคใหม่)
function UIKit.TextStroke(obj, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Color = UIKit.Colors.Outline
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0.15
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = obj
	-- ขอบต้องจางตามตัวหนังสือ (ไม่งั้นข้อความที่ค่อยๆ โผล่/หาย เหลือเงาดำค้างกลางจอ)
	local base = s.Transparency
	local function sync()
		s.Transparency = base + (1 - base) * obj.TextTransparency
	end
	sync()
	obj:GetPropertyChangedSignal("TextTransparency"):Connect(sync)
	return s
end

-- ข้อความบรรทัดเดียวยาวเกินกรอบ (ภาษาไทยยาวกว่าอังกฤษ) -> ย่อตัวอักษรลงเองให้พอดีกรอบ ไม่ล้นออกนอกปุ่ม/การ์ด
-- (ขนาดปกติไม่เปลี่ยน: ใช้ TextScaled + จำกัดไม่ให้ใหญ่กว่า TextSize เดิม)
function UIKit.FitText(obj)
	if obj.TextScaled or obj.TextWrapped or obj.AutomaticSize ~= Enum.AutomaticSize.None or obj:FindFirstChildOfClass("UITextSizeConstraint") then
		return
	end
	local size = obj.TextSize
	local h = obj.Size.Y
	if h.Scale == 0 and h.Offset < size * 0.85 then
		return -- กรอบเตี้ยกว่าตัวอักษร (ตั้งใจให้ล้นขึ้นลง) ไม่ยุ่ง
	end
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = size
	c.MinTextSize = math.max(8, math.floor(size * 0.5))
	c.Parent = obj
	obj.TextScaled = true
	-- โค้ดที่ตั้ง/ทวีน TextSize ทีหลัง (เช่น ป้ายใหญ่กลางจอ) ยังได้ขนาดตามที่ตั้ง
	obj:GetPropertyChangedSignal("TextSize"):Connect(function()
		c.MaxTextSize = math.max(1, obj.TextSize)
		c.MinTextSize = math.min(c.MaxTextSize, math.max(8, math.floor(obj.TextSize * 0.5)))
	end)
end

function UIKit.Text(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextColor3 = UIKit.Colors.Text
	t.Font = UIKit.Fonts.Bold
	t.TextSize = 16
	t.TextXAlignment = Enum.TextXAlignment.Left
	local customStroke = props and props.TextStrokeTransparency ~= nil
	for k, v in pairs(props or {}) do
		if k ~= "TextStrokeTransparency" then
			t[k] = v
		end
	end
	t.Parent = parent
	-- ตัวหนังสือขนาดกลางขึ้นไปมีขอบดำเสมอ (อ่านง่ายบนฉากทุกแบบ)
	if t.TextSize >= 14 or t.TextScaled or customStroke then
		UIKit.TextStroke(t, t.TextScaled and 2 or math.clamp(t.TextSize / 11, 1.2, 3.5), 0.2)
	end
	UIKit.FitText(t)
	return t
end

-- ปุ่มนูน 3D: ไล่สีสว่างด้านบน + ขอบล่างเข้ม (ปาก) + ขอบรอบเข้ม + ตัวหนังสือขาวขอบดำ + เด้งตอนชี้/กด
function UIKit.Button(parent, props, onClick)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundColor3 = UIKit.Colors.Panel2
	b.TextColor3 = UIKit.Colors.Text
	b.Font = UIKit.Fonts.Black
	b.TextSize = 16
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	b.Parent = parent
	UIKit.Corner(b, 12)
	local border = Instance.new("UIStroke")
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Thickness = 2.5
	border.LineJoinMode = Enum.LineJoinMode.Round
	border.Color = darker(b.BackgroundColor3, 0.4)
	border.Parent = b
	b:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		border.Color = darker(b.BackgroundColor3, 0.4)
	end)
	UIKit.TextStroke(b, math.clamp(b.TextSize / 10, 1.5, 3), 0.1)
	if b.Text ~= "" then
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
		pad.Parent = b
		UIKit.FitText(b)
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(236, 236, 236)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(205, 205, 205)),
		ColorSequenceKeypoint.new(0.81, Color3.fromRGB(150, 150, 150)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 140, 140)),
	})
	g.Rotation = 90
	g.Parent = b
	local scale = Instance.new("UIScale")
	scale.Parent = b
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1.06 }):Play()
		TweenService:Create(border, TweenInfo.new(0.12), { Thickness = 3.2 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1 }):Play()
		TweenService:Create(border, TweenInfo.new(0.12), { Thickness = 2.5 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.07), { Scale = 0.93 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1.06 }):Play()
	end)
	b.Activated:Connect(function()
		if UIKit.OnAnyClick then
			UIKit.OnAnyClick()
		end
	end)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- ปุ่มสีสด (เขียว/น้ำเงิน/ม่วง...) — ทางลัดของ Button
function UIKit.ColorButton(parent, color, props, onClick)
	props = props or {}
	props.BackgroundColor3 = color
	return UIKit.Button(parent, props, onClick)
end

-- ปุ่มปิด X วงกลมแดงมุมขวาบน
function UIKit.CloseButton(panel, onClose)
	local b = UIKit.Button(panel, {
		Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -30, 0, -14), BackgroundColor3 = UIKit.Colors.Red, Text = "✕", TextSize = 24, ZIndex = 10,
	}, onClose)
	b:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	UIKit.EnsureTouchSize(b, 44, onClose)
	return b
end

---------------------------------------------------------------- ปุ่มนิ้วกดง่าย (มือถือ)
-- ปุ่มที่อยู่ในกรอบที่ถูกย่อ (AutoScale) อาจเล็กกว่า 44px บนจอจริง -> ใส่พื้นที่แตะล่องหนรอบปุ่มให้ได้อย่างน้อย minPx บนจอเสมอ
-- (เฉพาะเครื่องจอสัมผัส · onActivate = ฟังก์ชันเดียวกับที่ปุ่มทำ)
function UIKit.EnsureTouchSize(button, minPx, onActivate)
	if not (UIKit.IsTouch and button and onActivate) or button:FindFirstChild("TouchHit") then
		return
	end
	minPx = minPx or 44
	local hit = Instance.new("TextButton")
	hit.Name = "TouchHit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.BorderSizePixel = 0
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = button.ZIndex + 1
	hit.Parent = button
	local function fit()
		local abs, off = button.AbsoluteSize, button.Size
		if abs.X <= 0 or abs.Y <= 0 or off.X.Offset <= 0 or off.Y.Offset <= 0 then
			return
		end
		-- ตัวคูณสเกลจริงบนจอ (รวม UIScale ของกรอบแม่ทุกชั้น)
		local k = math.max(abs.X / off.X.Offset, 0.05)
		local need = minPx / k
		hit.Size = UDim2.fromOffset(math.max(off.X.Offset, need), math.max(off.Y.Offset, need))
	end
	button:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	hit.Activated:Connect(function()
		if not button.Visible then
			return
		end
		if UIKit.OnAnyClick then
			UIKit.OnAnyClick()
		end
		onActivate()
	end)
	return hit
end

---------------------------------------------------------------- หน้าต่าง: ปิดด้วย Esc / แตะนอกหน้าต่าง
-- UIKit.RegisterWindow(frame, closeFn, opts)
--   frame   = กรอบหน้าต่างที่สลับ Visible เปิด/ปิด
--   closeFn = ฟังก์ชันปิด (ไม่ใส่ = frame.Visible = false)
--   opts.Backdrop = false : ไม่ต้องปิดเมื่อแตะนอกหน้าต่าง (หน้าต่างเต็มจอ / หน้าสอนเล่น)
--   opts.Dim = 0..1       : ความมืดของพื้นหลังด้านหลังหน้าต่าง (ค่าเริ่ม 1 = ใส)
-- Esc ปิดหน้าต่างที่เปิดล่าสุดทีละบาน
local windows = {}
local escBound = false
local lastEscClose = 0

local function shownOnScreen(obj)
	local o = obj
	while o do
		if o:IsA("GuiObject") then
			if not o.Visible then
				return false
			end
		elseif o:IsA("LayerCollector") then
			return o.Enabled
		end
		o = o.Parent
	end
	return false
end

function UIKit.TopWindow()
	local best
	for _, w in ipairs(windows) do
		if w.Frame.Parent and shownOnScreen(w.Frame) and (not best or w.Opened > best.Opened) then
			best = w
		end
	end
	return best
end

function UIKit.AnyWindowOpen()
	return UIKit.TopWindow() ~= nil
end

function UIKit.CloseTopWindow()
	local w = UIKit.TopWindow()
	if not w then
		return false
	end
	lastEscClose = os.clock()
	local ok, err = pcall(w.Close)
	if not ok then
		warn("[AS] close window", err)
		w.Frame.Visible = false
	end
	return true
end

local function bindEsc()
	if escBound then
		return
	end
	escBound = true
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if os.clock() - lastEscClose > 0.15 then
				UIKit.CloseTopWindow()
			end
		end
	end)
end

function UIKit.RegisterWindow(frame, closeFn, opts)
	if not frame then
		return
	end
	opts = opts or {}
	local w = {
		Frame = frame,
		Close = closeFn or function()
			frame.Visible = false
		end,
		Opened = frame.Visible and os.clock() or 0,
	}
	table.insert(windows, w)
	bindEsc()
	local backdrop
	if opts.Backdrop ~= false and frame.Parent then
		backdrop = Instance.new("TextButton")
		backdrop.Name = frame.Name .. "_Backdrop"
		backdrop.Text = ""
		backdrop.AutoButtonColor = false
		backdrop.BorderSizePixel = 0
		backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
		backdrop.BackgroundTransparency = opts.Dim or 1
		backdrop.Size = UDim2.fromScale(1, 1)
		backdrop.AnchorPoint = Vector2.new(0, 0)
		backdrop.Position = UDim2.fromScale(0, 0)
		backdrop.ZIndex = frame.ZIndex - 1
		backdrop.Visible = frame.Visible
		backdrop.Parent = frame.Parent
		-- ปิดเฉพาะตอนแตะ "นอก" หน้าต่างจริง ๆ: ชิ้นในหน้าต่างที่ไม่ Active (ปุ่มแถบเลื่อน/แผ่นพื้นหลัง) ปล่อยคลิกทะลุลงมาถึงฉากหลัง
		-- -> เช็กตำแหน่งทั้งตอนกดและตอนปล่อย (ลากแถบเสียงแล้วปล่อยนอกหน้าต่างก็ไม่ปิด)
		local function outside(input)
			local p, a, s = input.Position, frame.AbsolutePosition, frame.AbsoluteSize
			return p.X < a.X or p.Y < a.Y or p.X > a.X + s.X or p.Y > a.Y + s.Y
		end
		local pressedOutside = false
		backdrop.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				pressedOutside = outside(input)
			end
		end)
		backdrop.Activated:Connect(function(input)
			local ok = pressedOutside and (not input or outside(input))
			pressedOutside = false
			if ok and frame.Visible then
				w.Close()
			end
		end)
		w.Backdrop = backdrop
	end
	frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if frame.Visible then
			w.Opened = os.clock()
		end
		if backdrop then
			backdrop.Visible = frame.Visible
		end
	end)
	frame.Destroying:Connect(function()
		if backdrop then
			backdrop:Destroy()
		end
		local i = table.find(windows, w)
		if i then
			table.remove(windows, i)
		end
	end)
	return w
end

-- แถบหัวหน้าต่างสีสด (ริบบิ้น) วางทับขอบบนของการ์ด
function UIKit.Header(panel, text, color)
	color = color or UIKit.Colors.Blue
	local h = UIKit.Frame(panel, {
		Size = UDim2.new(0.6, 0, 0, 46), Position = UDim2.new(0.2, 0, 0, -22), BackgroundColor3 = color, BackgroundTransparency = 0, ZIndex = 5,
	})
	UIKit.Corner(h, 14)
	local s = Instance.new("UIStroke")
	s.Thickness = 3
	s.Color = darker(color, 0.4)
	s.Parent = h
	UIKit.Gradient(h, Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180), 90)
	local t = UIKit.Text(h, {
		Size = UDim2.fromScale(1, 1), Text = text, Font = UIKit.Fonts.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6,
	})
	return h, t
end

-- การ์ดหน้าต่างหลัก (พื้นกรมท่าไล่สี + ขอบเข้มหนา + ขอบในสว่าง)
function UIKit.Card(parent, props)
	local f = UIKit.Frame(parent, props)
	f.BackgroundColor3 = props and props.BackgroundColor3 or Color3.fromRGB(34, 38, 64)
	f.BackgroundTransparency = props and props.BackgroundTransparency or 0
	UIKit.Corner(f, 18)
	local s = Instance.new("UIStroke")
	s.Thickness = 4
	s.Color = UIKit.Colors.Outline
	s.Parent = f
	UIKit.Gradient(f, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 156, 180), 90)
	return f
end

-- เปิดหน้าต่างแบบเด้ง
function UIKit.Pop(frame)
	local target = UIKit.GetScale(frame)
	local sc = scaler(frame)
	scaled[frame] = true
	sc.Scale = target * 0.82
	TweenService:Create(sc, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
	if UIKit.OnPop then
		UIKit.OnPop()
	end
end

-- แถบค่า (เลือด/หิว/สตามิน่า): ร่องเข้ม + ขอบดำ + ไฮไลต์มันวาวด้านบน
function UIKit.Bar(parent, props)
	local holder = UIKit.Frame(parent, {
		Size = props.Size, Position = props.Position, BackgroundColor3 = Color3.fromRGB(14, 14, 26), BackgroundTransparency = 0.05, ClipsDescendants = true,
	})
	local h = props.Size and props.Size.Y.Offset or 12
	local function round(o)
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, math.max(3, h / 2))
		c.Parent = o
	end
	round(holder)
	local st = Instance.new("UIStroke")
	st.Thickness = h >= 12 and 2.5 or 2
	st.Color = UIKit.Colors.Outline
	st.Parent = holder
	local lag = UIKit.Frame(holder, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.35 })
	round(lag)
	local fill = UIKit.Frame(holder, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = props.Color, BackgroundTransparency = 0 })
	round(fill)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.36, Color3.fromRGB(215, 215, 215)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(165, 165, 165)),
	})
	g.Rotation = 90
	g.Parent = fill
	local label = UIKit.Text(holder, {
		Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = math.clamp(h - 6, 11, 16), Font = UIKit.Fonts.Black,
		Text = props.Label or "", TextColor3 = Color3.new(1, 1, 1), ZIndex = 3, TextStrokeTransparency = 0,
	})
	local api = { Holder = holder, Fill = fill, Label = label, Value = 1 }
	function api.Set(frac, text)
		frac = math.clamp(frac, 0, 1)
		if math.abs(frac - api.Value) > 0.001 then
			TweenService:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromScale(frac, 1) }):Play()
			if frac < api.Value then
				TweenService:Create(lag, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.25), { Size = UDim2.fromScale(frac, 1) }):Play()
			else
				lag.Size = UDim2.fromScale(frac, 1)
			end
			api.Value = frac
		end
		if text then
			label.Text = text
		end
	end
	return api
end

-- ไอคอนวงกลมสีสด (ใช้หน้าแถบค่า / ปุ่มเมนู)
function UIKit.IconBadge(parent, icon, color, size, props)
	local f = UIKit.Frame(parent, { Size = UDim2.fromOffset(size, size), BackgroundColor3 = color, BackgroundTransparency = 0, ZIndex = 4 })
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Thickness = 2.5
	s.Color = UIKit.Colors.Outline
	s.Parent = f
	UIKit.Gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
	UIKit.Text(f, { Size = UDim2.fromScale(1, 1), Text = icon, TextSize = math.floor(size * 0.55), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
	return f
end

-- ไอคอนวาดจาก Frame (ไม่ต้องอัปโหลดรูป): "Ruby" ทับทิม (สกุลเงิน) · "Ruby" แร่ · "Shield" โล่ดาบ (คลาส) · "Trophy" ถ้วยรางวัล (ป้าย)
-- ทุกชิ้น = สี่เหลี่ยมหมุนได้ + มุมมน + ไล่สีแบบแบ่งหน้าเหลี่ยม + ขอบเข้มด้านหลัง (สไตล์การ์ตูน)
local SQ2 = math.sqrt(2)
local function facet(light, dark, darker)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, light),
		ColorSequenceKeypoint.new(0.499, light),
		ColorSequenceKeypoint.new(0.5, dark),
		ColorSequenceKeypoint.new(1, darker or dark),
	})
end
function UIKit.Icon(parent, kind, size, props)
	local root = Instance.new("Frame")
	root.Name = "Icon" .. kind
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromOffset(size, size)
	for k, v in pairs(props or {}) do
		root[k] = v
	end
	root.Parent = parent
	local s, z0 = size, root.ZIndex
	local function piece(z, cx, cy, w, h, rot, fill, opt)
		opt = opt or {}
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(cx, cy)
		f.Size = UDim2.fromOffset(w, h)
		f.Rotation = rot
		f.ZIndex = z0 + z
		f.BackgroundTransparency = opt.tr or 0
		if typeof(fill) == "Color3" then
			f.BackgroundColor3 = fill
		else
			f.BackgroundColor3 = Color3.new(1, 1, 1)
			local g = Instance.new("UIGradient")
			g.Color = fill
			g.Rotation = opt.grot or 0
			g.Parent = f
		end
		if opt.corner then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, math.min(w, h) / 2 * opt.corner)
			c.Parent = f
		end
		if opt.ring then
			f.BackgroundTransparency = 1
			local st = Instance.new("UIStroke")
			st.Thickness = opt.ring
			st.Color = fill
			st.Parent = f
		end
		f.Parent = root
		return f
	end
	if kind == "Ore" then
		local o, dark = s * 0.045, Color3.fromRGB(58, 14, 22)
		local red = facet(Color3.fromRGB(255, 120, 120), Color3.fromRGB(196, 28, 46), Color3.fromRGB(150, 16, 34))
		local function shard(bx, by, W, H, rot, z)
			local bodyH = H - W / 2
			local th = math.rad(rot)
			local function tr(lx, ly)
				return bx + lx * math.cos(th) - ly * math.sin(th), by + lx * math.sin(th) + ly * math.cos(th)
			end
			local bcx, bcy = tr(0, -bodyH / 2)
			local tcx, tcy = tr(0, -bodyH)
			local side = W / SQ2
			piece(z, bcx, bcy, W + 2 * o, bodyH + 2 * o, rot, dark)
			piece(z, tcx, tcy, side + 2 * o, side + 2 * o, rot + 45, dark)
			piece(z + 1, tcx, tcy, side, side, rot + 45, red, { grot = -45 })
			piece(z + 2, bcx, bcy, W, bodyH, rot, red)
			local hx, hy = tr(-W * 0.22, -bodyH * 0.62)
			piece(z + 3, hx, hy, W * 0.11, bodyH * 0.5, rot, Color3.fromRGB(255, 220, 220), { tr = 0.25, corner = 1 })
		end
		shard(s * 0.32, s * 0.74, s * 0.2, s * 0.44, -24, 1)
		shard(s * 0.69, s * 0.75, s * 0.19, s * 0.4, 22, 5)
		shard(s * 0.5, s * 0.72, s * 0.27, s * 0.64, 0, 9)
		local rock = ColorSequence.new(Color3.fromRGB(150, 138, 150), Color3.fromRGB(84, 74, 88))
		local blobs = { { 0.34, 0.79, 0.4, 0.3 }, { 0.62, 0.8, 0.5, 0.26 }, { 0.5, 0.85, 0.74, 0.16 } }
		for _, b in ipairs(blobs) do
			piece(20, s * b[1], s * b[2], s * b[3] + 2 * o, s * b[4] + 2 * o, 0, Color3.fromRGB(30, 22, 30), { corner = 0.75 })
		end
		for _, b in ipairs(blobs) do
			piece(21, s * b[1], s * b[2], s * b[3], s * b[4], 0, rock, { grot = 90, corner = 0.75 })
		end
		piece(22, s * 0.38, s * 0.74, s * 0.14, s * 0.05, -8, Color3.fromRGB(200, 190, 205), { tr = 0.45, corner = 1 })
	elseif kind == "Ruby" then
		-- ทับทิมเจียระไน: ทรงข้าวหลามตัด ซีกซ้ายสว่าง/ขวาเข้ม + ครึ่งบนอ่อน + หน้าโต๊ะกลาง + ประกาย
		local cx, cy, side, o = s / 2, s * 0.52, s * 0.6, s * 0.05
		local hard = function(a, b)
			return ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(0.499, a), ColorSequenceKeypoint.new(0.5, b), ColorSequenceKeypoint.new(1, b) })
		end
		piece(1, cx, cy, side + 2 * o, side + 2 * o, 45, Color3.fromRGB(74, 6, 24), { corner = 0.12 })
		piece(2, cx, cy, side, side, 45, facet(Color3.fromRGB(246, 52, 86), Color3.fromRGB(188, 16, 50), Color3.fromRGB(150, 8, 40)), { grot = -45, corner = 0.12 })
		piece(3, cx, cy, side * 0.999, side * 0.999, 45, hard(Color3.new(1, 1, 1), Color3.new(0, 0, 0)), { grot = 45, tr = 0.86, corner = 0.12 })
		local t = side * 0.5
		piece(4, cx, cy - s * 0.04, t, t, 45, facet(Color3.fromRGB(255, 150, 168), Color3.fromRGB(236, 70, 100)), { grot = -45 })
		piece(5, cx, cy - s * 0.04, t * 0.55, t * 0.55, 45, facet(Color3.fromRGB(255, 205, 214), Color3.fromRGB(255, 140, 160)), { grot = -45 })
		for _, f in ipairs({ { 45, -1, -1 }, { -45, 1, -1 }, { -45, -1, 1 }, { 45, 1, 1 } }) do
			piece(6, cx + f[2] * s * 0.13, cy - s * 0.04 + f[3] * s * 0.13, s * 0.02, s * 0.21, f[1], Color3.fromRGB(255, 170, 185), { tr = 0.5 })
		end
		piece(7, cx - s * 0.16, cy - s * 0.16, s * 0.14, s * 0.028, -45, Color3.new(1, 1, 1), { tr = 0.05, corner = 1 })
		piece(7, cx - s * 0.08, cy - s * 0.22, s * 0.05, s * 0.05, 45, Color3.new(1, 1, 1), { tr = 0.05 })
		piece(7, cx + s * 0.2, cy + s * 0.12, s * 0.035, s * 0.035, 45, Color3.fromRGB(255, 225, 232), { tr = 0.2 })
	elseif kind == "Scroll" then
		-- ม้วนคัมภีร์ภารกิจ: กระดาษ + ม้วนไม้บนล่าง + เส้นตัวหนังสือ + ตราประทับแดง
		local o, dark = s * 0.045, Color3.fromRGB(70, 40, 14)
		local paper = ColorSequence.new(Color3.fromRGB(255, 244, 214), Color3.fromRGB(240, 214, 160))
		local roll = ColorSequence.new(Color3.fromRGB(236, 196, 130), Color3.fromRGB(196, 140, 74))
		piece(1, s * 0.5, s * 0.5, s * 0.56 + 2 * o, s * 0.62 + 2 * o, 0, dark, { corner = 0.08 })
		piece(2, s * 0.5, s * 0.5, s * 0.56, s * 0.62, 0, paper, { grot = 90, corner = 0.08 })
		for _, y in ipairs({ 0.2, 0.8 }) do
			piece(3, s * 0.5, s * y, s * 0.72 + 2 * o, s * 0.13 + 2 * o, 0, dark, { corner = 1 })
			piece(4, s * 0.5, s * y, s * 0.72, s * 0.13, 0, roll, { grot = 90, corner = 1 })
			for _, x in ipairs({ 0.14, 0.86 }) do
				piece(5, s * x, s * y, s * 0.07, s * 0.16, 0, Color3.fromRGB(150, 96, 46), { corner = 0.5 })
			end
		end
		for _, l in ipairs({ { 0.36, 0.36 }, { 0.45, 0.4 }, { 0.54, 0.3 }, { 0.63, 0.22 } }) do
			piece(5, s * (0.31 + l[2] / 2), s * l[1], s * l[2], s * 0.035, 0, Color3.fromRGB(150, 112, 70), { corner = 1 })
		end
		piece(6, s * 0.66, s * 0.64, s * 0.17 + 2 * o, s * 0.17 + 2 * o, 0, Color3.fromRGB(90, 10, 20), { corner = 1 })
		piece(7, s * 0.66, s * 0.64, s * 0.17, s * 0.17, 0, ColorSequence.new(Color3.fromRGB(255, 90, 100), Color3.fromRGB(196, 24, 44)), { grot = 90, corner = 1 })
		piece(8, s * 0.66, s * 0.64, s * 0.06, s * 0.06, 45, Color3.fromRGB(255, 210, 210), { tr = 0.2 })
	elseif kind == "Shield" then
		local o, dark = s * 0.05, Color3.fromRGB(26, 26, 44)
		local W, bodyH, top = s * 0.62, s * 0.34, s * 0.12
		local side = W / SQ2
		local blue = facet(Color3.fromRGB(110, 160, 255), Color3.fromRGB(62, 100, 210), Color3.fromRGB(44, 76, 176))
		piece(1, s / 2, top + bodyH / 2, W + 2 * o, bodyH + 2 * o, 0, dark, { corner = 0.22 })
		piece(1, s / 2, top + bodyH, side + 2 * o, side + 2 * o, 45, dark, { corner = 0.16 })
		piece(2, s / 2, top + bodyH, side, side, 45, blue, { grot = -45, corner = 0.16 })
		piece(3, s / 2, top + bodyH / 2, W, bodyH, 0, blue, { corner = 0.22 })
		local steel = facet(Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 204, 222))
		local gold = ColorSequence.new(Color3.fromRGB(255, 230, 130), Color3.fromRGB(222, 150, 40))
		local bw, bh, bcy, oo = s * 0.11, s * 0.4, s * 0.44, o * 0.7
		local ts = bw / SQ2
		piece(4, s / 2, bcy, bw + 2 * oo, bh + 2 * oo, 0, dark)
		piece(4, s / 2, bcy - bh / 2, ts + 2 * oo, ts + 2 * oo, 45, dark)
		piece(5, s / 2, bcy - bh / 2, ts, ts, 45, steel, { grot = -45 })
		piece(6, s / 2, bcy, bw, bh, 0, steel)
		local hilt = { { 0.66, 0.36, 0.08, 0.4 }, { 0.74, 0.08, 0.12, 0.2 }, { 0.82, 0.13, 0.08, 1 } }
		for _, h in ipairs(hilt) do
			piece(7, s / 2, s * h[1], s * h[2] + 2 * oo, s * h[3] + 2 * oo, 0, dark, { corner = h[4] })
		end
		for _, h in ipairs(hilt) do
			piece(8, s / 2, s * h[1], s * h[2], s * h[3], 0, gold, { grot = 90, corner = h[4] })
		end
	elseif kind == "Trophy" then
		local o, dark = s * 0.045, Color3.fromRGB(70, 40, 8)
		local gold = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 236, 140)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(246, 184, 50)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(214, 138, 28)),
		})
		local ring, d = s * 0.06, s * 0.18
		for _, x in ipairs({ 0.25, 0.75 }) do
			piece(1, s * x, s * 0.36, d - 2 * o, d - 2 * o, 0, dark, { corner = 1, ring = ring + 2 * o })
			piece(2, s * x, s * 0.36, d, d, 0, Color3.fromRGB(240, 176, 46), { corner = 1, ring = ring })
		end
		local parts = { { 0.5, 0.42, 0.5, 0.5, 1 }, { 0.5, 0.27, 0.5, 0.2, 0.06 }, { 0.5, 0.71, 0.11, 0.14, 0 }, { 0.5, 0.8, 0.3, 0.07, 0.3 }, { 0.5, 0.87, 0.46, 0.1, 0.3 } }
		for _, q in ipairs(parts) do
			piece(3, s * q[1], s * q[2], s * q[3] + 2 * o, s * q[4] + 2 * o, 0, dark, { corner = q[5] })
		end
		for _, q in ipairs(parts) do
			piece(4, s * q[1], s * q[2], s * q[3], s * q[4], 0, gold, { grot = 90, corner = q[5] })
		end
		piece(5, s * 0.4, s * 0.36, s * 0.07, s * 0.2, 0, Color3.fromRGB(255, 250, 220), { tr = 0.3, corner = 1 })
		piece(5, s * 0.5, s * 0.17, s * 0.5, s * 0.04, 0, Color3.fromRGB(255, 246, 200), { tr = 0.2, corner = 1 })
	end
	return root
end

function UIKit.Tween(obj, time, props, style)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

return UIKit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008E"><Properties><string name="Name">VFXLib</string><ProtectedString name="Source"><![CDATA[--[[
	VFXLib — เล่นเอฟเฟกต์อนุภาคจากคลัง ReplicatedStorage.Assets.VFX (แพ็ก VFX จาก Creator Store)
	  VFXLib.Play(path, cframe, opts) -> model
	    path  = "VFXPack/Big/Explosion-01" (ไล่ชื่อลูกทีละชั้น)
	    opts  = { Scale = 1, Duration = 1.5, Tint = Color3?, Follow = BasePart?/Attachment? }
	  VFXLib.List() -> รายชื่อเอฟเฟกต์ทั้งหมด (ใช้ในโหมดเทสต์โชว์ VFX)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VFXLib = {}

local function root()
	local a = ReplicatedStorage:FindFirstChild("Assets")
	return a and a:FindFirstChild("VFX")
end

function VFXLib.Find(path)
	local node = root()
	for seg in string.gmatch(path, "[^/]+") do
		node = node and node:FindFirstChild(seg)
	end
	return node
end

local function folder()
	local f = Workspace:FindFirstChild("VFXPlay")
	if not f then
		f = Instance.new("Folder")
		f.Name = "VFXPlay"
		f.Parent = Workspace
	end
	return f
end

local function tintSeq(seq, color)
	local ks = {}
	for _, k in ipairs(seq.Keypoints) do
		local h, s, v = k.Value:ToHSV()
		local th, ts = color:ToHSV()
		table.insert(ks, ColorSequenceKeypoint.new(k.Time, Color3.fromHSV(th, math.max(ts, s * 0.5), v)))
	end
	return ColorSequence.new(ks)
end

function VFXLib.Play(path, cf, opts)
	opts = opts or {}
	local tpl = VFXLib.Find(path)
	if not tpl then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = "VFX_" .. tpl.Name
	local inst = tpl:Clone()
	inst.Parent = m
	local maxLife = 0
	local emitters = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.Transparency = 1
		elseif d:IsA("ParticleEmitter") then
			maxLife = math.max(maxLife, d.Lifetime.Max)
			if opts.Tint then
				d.Color = tintSeq(d.Color, opts.Tint)
			end
			if opts.Rate then
				d.Rate *= opts.Rate
			end
			d.Enabled = false
			table.insert(emitters, d)
		elseif d:IsA("Beam") or d:IsA("Trail") then
			if opts.Tint then
				d.Color = tintSeq(d.Color, opts.Tint)
			end
			d.Enabled = false
			table.insert(emitters, d)
		elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("SurfaceGui")
			or d:IsA("BillboardGui") or d:IsA("Humanoid") or d:IsA("Sound") then
			-- แพ็กเดโมบางตัวมีหัว/หน้ายิ้ม/ป้ายติดมา -> เอาเฉพาะอนุภาค
			d:Destroy()
		end
	end
	local cf0 = m:GetBoundingBox()
	m.WorldPivot = cf0
	if (opts.Scale or 1) ~= 1 then
		pcall(function()
			m:ScaleTo(opts.Scale)
		end)
	end
	m:PivotTo(cf)
	m.Parent = folder()
	for _, e in ipairs(emitters) do
		e.Enabled = true
		if e:IsA("ParticleEmitter") and opts.Burst then
			e:Emit(math.max(1, math.floor(e.Rate * opts.Burst)))
		end
	end
	-- ติดตามชิ้นส่วน (เช่น ปากมังกร)
	local conn
	if opts.Follow then
		local offset = opts.FollowOffset or CFrame.new()
		conn = RunService.RenderStepped:Connect(function()
			if not (m.Parent and opts.Follow.Parent) then
				conn:Disconnect()
				return
			end
			local base = opts.Follow:IsA("Attachment") and opts.Follow.WorldCFrame or opts.Follow.CFrame
			if opts.Aim then
				base = CFrame.lookAt(base.Position, opts.Aim)
			end
			m:PivotTo(base * offset)
		end)
	end
	local dur = opts.Duration or 1.2
	task.delay(dur, function()
		for _, e in ipairs(emitters) do
			if e.Parent then
				e.Enabled = false
			end
		end
	end)
	task.delay(dur + maxLife * (opts.Scale or 1) + 0.5, function()
		if conn then
			conn:Disconnect()
		end
		m:Destroy()
	end)
	return m
end

-- รายชื่อเอฟเฟกต์ทั้งหมด: ลูกของหมวด (Big/Anime/Beams/...) หรือทั้งแพ็กถ้าไม่มีหมวด
function VFXLib.List()
	local out = {}
	local r = root()
	for _, pack in ipairs(r and r:GetChildren() or {}) do
		local cats = {}
		for _, c in ipairs(pack:GetChildren()) do
			if c:IsA("Model") or c:IsA("Folder") then
				table.insert(cats, c)
			end
		end
		if #cats == 0 then
			table.insert(out, pack.Name)
		else
			for _, c in ipairs(cats) do
				local fx = 0
				for _, e in ipairs(c:GetChildren()) do
					if e:FindFirstChildWhichIsA("ParticleEmitter", true) or e:FindFirstChildWhichIsA("Beam", true) then
						table.insert(out, pack.Name .. "/" .. c.Name .. "/" .. e.Name)
						fx += 1
					end
				end
				if fx == 0 and (c:FindFirstChildWhichIsA("ParticleEmitter", true)) then
					table.insert(out, pack.Name .. "/" .. c.Name)
				end
			end
		end
	end
	table.sort(out)
	return out
end

return VFXLib
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000008F"><Properties><string name="Name">WoodKit</string><ProtectedString name="Source"><![CDATA[--[[
	WoodKit — ธีมหน้าต่าง "แคมป์ไม้กลางป่า" (กรอบไม้เข้ม + ป้ายชื่อกระดาษ + ธงแดง + โคมไฟ + หัวหมาป่า/อินทรีบนกรอบ)
	ใช้กับ ภารกิจ & รางวัล / ป้ายความสำเร็จ / ร้านค้า / ตั้งค่า
	ภาพวาดประดับมาจาก Shared/PanelArt (EditableImage) — โหลดไม่ได้ = ไม่มีภาพ หน้าต่างยังใช้ได้ปกติ

	WoodKit.Window(parent, { Size = Vector2, Title, OnClose }) -> { Frame, Body }
	  Frame = กรอบนอกล่องหน (ใช้สลับ Visible / UIKit.Pop) · Body = แผ่นไม้ที่ใส่เนื้อหา
	  ธงแดงอยู่ "หลัง" แผ่นไม้ (โผล่แค่ส่วนที่ยื่นออกนอกกรอบ) ส่วนป้ายชื่อ/หัวสัตว์/โคม/ปุ่มปิดอยู่ "หน้า"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIKit = require(script.Parent.UIKit)
local PanelArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PanelArt"))

local WoodKit = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

WoodKit.Colors = {
	WoodDark = rgb(34, 22, 14),
	Wood = rgb(92, 58, 34),
	Inner = rgb(56, 36, 24),
	Parch = rgb(238, 218, 176),
	ParchEdge = rgb(110, 70, 36),
	Ink = rgb(58, 34, 18),
	InkDim = rgb(116, 84, 56),
	Red = rgb(170, 36, 34),
	RedDark = rgb(96, 18, 20),
	Gold = rgb(236, 192, 104),
	GoldDark = rgb(150, 104, 46),
	Night = rgb(44, 38, 76),
	Good = rgb(36, 118, 44),
	Bad = rgb(176, 34, 30),
}
local W = WoodKit.Colors
local WHITE = Color3.new(1, 1, 1)

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r == "round" and UDim.new(1, 0) or UDim.new(0, r)
	c.Parent = o
	return c
end
WoodKit.Corner = corner

-- UIStroke ตรงๆ (ไม่ผ่านการแปลงของ UIKit.Stroke)
local function stroke(o, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.Parent = o
	return s
end
WoodKit.Stroke = stroke

local function frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 0
	for k, v in pairs(props) do
		f[k] = v
	end
	f.Parent = parent
	return f
end
WoodKit.Frame = frame

local function shade(o, bottom)
	return UIKit.Gradient(o, WHITE, bottom or rgb(170, 160, 150), 90)
end

---------------------------------------------------------------- ภาพวาด (PanelArt)
function WoodKit.Art(parent, name, width, props)
	local ok, img = pcall(PanelArt.Image, name)
	local size = PanelArt.Size[name]
	if not ok or not img or not size then
		return nil
	end
	local l = Instance.new("ImageLabel")
	l.Name = "Art_" .. name
	l.BackgroundTransparency = 1
	l.ImageContent = Content.fromObject(img)
	l.Size = UDim2.fromOffset(width, math.floor(width * size.Y / size.X))
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

---------------------------------------------------------------- ตัวหนังสือหมึกบนกระดาษ (ไม่มีขอบดำ)
function WoodKit.Ink(parent, props)
	props.TextColor3 = props.TextColor3 or W.Ink
	props.Font = props.Font or UIKit.Fonts.Title
	local t = UIKit.Text(parent, props)
	local s = t:FindFirstChildOfClass("UIStroke")
	if s then
		s:Destroy()
	end
	return t
end

---------------------------------------------------------------- ปุ่ม
-- สไตล์: { พื้น, ขอบ, ตัวหนังสือ }
local STYLES = {
	Red = { rgb(176, 38, 36), W.Gold, WHITE },
	Wood = { rgb(104, 68, 42), rgb(168, 124, 66), rgb(255, 240, 214) },
	Dark = { rgb(58, 42, 30), rgb(118, 88, 58), rgb(226, 210, 188) },
	Off = { rgb(96, 88, 80), rgb(66, 58, 52), rgb(206, 198, 188) },
	Green = { rgb(66, 128, 56), W.Gold, WHITE },
	Night = { rgb(64, 54, 110), rgb(160, 140, 220), WHITE },
	Parch = { W.Parch, rgb(150, 104, 46), W.Ink }, -- ปุ่มกระดาษ ตัวหนังสือหมึก (ไม่มีขอบดำ)
}

function WoodKit.Style(b, style)
	local s = STYLES[style] or STYLES.Wood
	b.BackgroundColor3 = s[1]
	b.TextColor3 = s[3]
	local rim = b:FindFirstChild("Rim")
	if rim then
		rim.Color = s[2]
	end
	for _, st in ipairs(b:GetChildren()) do
		if st:IsA("UIStroke") and st.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
			st.Enabled = style ~= "Parch"
		end
	end
	b:SetAttribute("Style", style)
end

function WoodKit.Button(parent, style, props, onClick)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Font = UIKit.Fonts.Title
	b.TextSize = 18
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	b.Parent = parent
	corner(b, 8)
	local rim = stroke(b, W.Gold, 2.5, 0)
	rim.Name = "Rim"
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, WHITE),
		ColorSequenceKeypoint.new(0.5, rgb(225, 220, 215)),
		ColorSequenceKeypoint.new(1, rgb(165, 155, 150)),
	})
	g.Rotation = 90
	g.Parent = b
	UIKit.TextStroke(b, math.clamp(b.TextSize / 10, 1.3, 2.6), 0.25)
	if b.Text ~= "" then
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
		pad.Parent = b
		UIKit.FitText(b)
	end
	WoodKit.Style(b, style)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1.05 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1 }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.07), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	b.Activated:Connect(function()
		if UIKit.OnAnyClick then
			UIKit.OnAnyClick()
		end
		if onClick then
			onClick()
		end
	end)
	return b
end

-- แท็บด้านบน: เลือกอยู่ = แดงขอบทอง · ไม่ได้เลือก = ไม้เข้ม
function WoodKit.Tab(parent, text, order, width, onClick)
	return WoodKit.Button(parent, "Dark", { Size = UDim2.fromOffset(width or 170, 44), Text = text, TextSize = 18, LayoutOrder = order }, onClick)
end

function WoodKit.SetTab(b, on)
	WoodKit.Style(b, on and "Red" or "Dark")
end

-- ปุ่มปิด X วงกลมแดงขอบทอง
function WoodKit.CloseButton(parent, onClose, props)
	local b = WoodKit.Button(parent, "Red", { Size = UDim2.fromOffset(50, 50), Text = "", ZIndex = 20 }, onClose)
	for k, v in pairs(props or {}) do
		b[k] = v
	end
	b:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	b.Rim.Thickness = 3.5
	-- กากบาทวาดจาก Frame (ฟอนต์ Fredoka ไม่มีตัว ✕)
	for _, rot in ipairs({ 45, -45 }) do
		local bar = frame(b, { Size = UDim2.fromOffset(26, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Rotation = rot, BackgroundColor3 = WHITE, ZIndex = 21 })
		corner(bar, 3)
		stroke(bar, W.RedDark, 1.5, 0.2)
	end
	UIKit.EnsureTouchSize(b, 44, onClose)
	return b
end

---------------------------------------------------------------- การ์ดกระดาษ / ป้าย / เหรียญไอคอน
function WoodKit.Parchment(parent, props, tint)
	local f = frame(parent, props)
	f.BackgroundColor3 = tint or W.Parch
	corner(f, 6)
	stroke(f, W.ParchEdge, 2.5, 0)
	shade(f, rgb(228, 214, 196))
	-- เส้นขอบในจางๆ (ขอบกระดาษ)
	local edge = frame(f, { BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8), Active = false })
	corner(edge, 4)
	stroke(edge, W.ParchEdge, 1, 0.65)
	return f
end

-- กล่องไม้เข้ม (แถบหัวข้อ/ช่องรางวัล)
function WoodKit.Board(parent, props, color, rimColor)
	local f = frame(parent, props)
	f.BackgroundColor3 = color or W.Inner
	corner(f, 6)
	stroke(f, rimColor or W.GoldDark, 2, 0)
	shade(f)
	return f
end

-- ริบบิ้นหัวข้อ (ภารกิจรายวัน/รายสัปดาห์ ฯลฯ) — แถบสี + หางธงซ้าย
function WoodKit.Ribbon(parent, props, color, text, textSize)
	local f = WoodKit.Board(parent, props, color or W.Red, W.Gold)
	local label = UIKit.Text(f, {
		Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(14, 0), Text = text or "", Font = UIKit.Fonts.Title, TextSize = textSize or 22, ZIndex = f.ZIndex + 1,
	})
	return f, label
end

-- เหรียญไม้กลมขอบทอง + ไอคอน (อีโมจิ หรือ "Ruby"/"Trophy"/"Scroll"/"Shield" ของ UIKit.Icon)
function WoodKit.Medallion(parent, icon, size, props, color)
	local f = frame(parent, { Size = UDim2.fromOffset(size, size), BackgroundColor3 = color or rgb(74, 44, 26) })
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	corner(f, "round")
	stroke(f, W.GoldDark, 3, 0)
	shade(f, rgb(150, 140, 135))
	local ring = frame(f, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -8, 1, -8) })
	corner(ring, "round")
	stroke(ring, W.Gold, 1.5, 0.45)
	if icon == "Ruby" or icon == "Trophy" or icon == "Scroll" or icon == "Shield" then
		UIKit.Icon(f, icon, math.floor(size * 0.72), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = f.ZIndex + 1 })
	else
		UIKit.Text(f, { Size = UDim2.fromScale(1, 1), Text = icon, TextSize = math.floor(size * 0.5), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = f.ZIndex + 1 })
	end
	return f
end

-- แคปซูล Ruby ของเรา (มุมขวาบนของหน้าต่าง) -> คืน TextLabel ตัวเลข
function WoodKit.RubyPill(parent, props)
	local f = frame(parent, { Size = UDim2.fromOffset(170, 46), BackgroundColor3 = rgb(30, 20, 14) })
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	corner(f, 10)
	stroke(f, W.GoldDark, 2.5, 0)
	UIKit.Icon(f, "Ruby", 50, { Position = UDim2.fromOffset(8, -3), ZIndex = f.ZIndex + 1 })
	return UIKit.Text(f, { Size = UDim2.new(1, -72, 1, 0), Position = UDim2.fromOffset(64, 0), Text = "0", Font = UIKit.Fonts.Title, TextSize = 28, ZIndex = f.ZIndex + 1 })
end

-- แสงวิ้งวิ่งผ่าน (ของที่กดรับได้)
function WoodKit.Shine(f, delayT)
	local g = Instance.new("UIGradient")
	g.Rotation = 20
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
	})
	g.Offset = Vector2.new(-1, 0)
	-- อยู่ใต้ปุ่ม (ZIndex 4) ไม่บังการกด
	local sheen = frame(f, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(255, 250, 220), ZIndex = f.ZIndex + 2, Active = false })
	corner(sheen, 6)
	g.Parent = sheen
	task.spawn(function()
		task.wait(delayT or 0)
		while sheen.Parent do
			g.Offset = Vector2.new(-1, 0)
			TweenService:Create(g, TweenInfo.new(1.1, Enum.EasingStyle.Sine), { Offset = Vector2.new(1, 0) }):Play()
			task.wait(3)
		end
	end)
	return sheen
end

---------------------------------------------------------------- ชิ้นประดับกรอบ
-- ธงแดงห้อย (ปลายแหลม) + ตราอุ้งเท้าสีทอง · x = UDim2 (ใช้แค่แกน X)
local function banner(parent, x, y, w, h, z)
	local b = frame(parent, { Size = UDim2.fromOffset(w, h), Position = x, BackgroundColor3 = W.Red, ZIndex = z })
	b.Position = UDim2.new(x.X.Scale, x.X.Offset, 0, y)
	stroke(b, W.GoldDark, 2, 0)
	UIKit.Gradient(b, rgb(255, 255, 255), rgb(150, 120, 120), 0)
	local side = w / math.sqrt(2)
	local tip = frame(b, { Size = UDim2.fromOffset(side, side), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 1, 0), Rotation = 45, BackgroundColor3 = W.Red, ZIndex = z })
	UIKit.Gradient(tip, rgb(255, 255, 255), rgb(150, 120, 120), 45)
	local paw = UIKit.Text(b, { Size = UDim2.new(1, 0, 0, w), Position = UDim2.fromOffset(0, h * 0.35), Text = "🐾", TextSize = math.floor(w * 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = W.Gold, ZIndex = z + 1 })
	paw.TextTransparency = 0.15
	-- ไม้คานบนธง
	frame(b, { Size = UDim2.new(1, 12, 0, 8), Position = UDim2.fromOffset(-6, -4), BackgroundColor3 = rgb(70, 44, 24), ZIndex = z + 1 })
	return b
end

-- โคมไฟข้างกรอบ (ตัวโคม + แสงเรืองวูบวาบ)
local function lantern(parent, pos, z)
	local holder = frame(parent, { BackgroundTransparency = 1, Size = UDim2.fromOffset(34, 52), AnchorPoint = Vector2.new(0.5, 0), Position = pos, ZIndex = z })
	local glow = frame(holder, { Size = UDim2.fromOffset(120, 120), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 30), BackgroundColor3 = rgb(255, 170, 70), ZIndex = z })
	corner(glow, "round")
	local gg = Instance.new("UIGradient")
	gg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 1) })
	gg.Parent = glow
	-- UIGradient ใช้ไล่เป็นวงไม่ได้: ซ้อนวงเล็กอีกชั้นให้ตรงกลางสว่าง
	local core = frame(holder, { Size = UDim2.fromOffset(56, 56), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 30), BackgroundColor3 = rgb(255, 200, 110), BackgroundTransparency = 0.7, ZIndex = z })
	corner(core, "round")
	frame(holder, { Size = UDim2.fromOffset(4, 12), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = rgb(40, 30, 22), ZIndex = z + 1 })
	local cap = frame(holder, { Size = UDim2.fromOffset(30, 8), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), BackgroundColor3 = rgb(54, 40, 28), ZIndex = z + 1 })
	corner(cap, 3)
	local body = frame(holder, { Size = UDim2.fromOffset(24, 30), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 17), BackgroundColor3 = rgb(255, 196, 96), ZIndex = z + 1 })
	corner(body, 5)
	stroke(body, rgb(54, 40, 28), 3, 0)
	UIKit.Gradient(body, rgb(255, 250, 220), rgb(255, 150, 60), 90)
	local base = frame(holder, { Size = UDim2.fromOffset(28, 6), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 47), BackgroundColor3 = rgb(54, 40, 28), ZIndex = z + 1 })
	corner(base, 3)
	task.spawn(function()
		while holder.Parent do
			local k = 0.55 + math.random() * 0.12
			TweenService:Create(glow, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { BackgroundTransparency = k - 0.55 }):Play()
			task.wait(0.35 + math.random() * 0.3)
		end
	end)
	return holder
end

---------------------------------------------------------------- หน้าต่างหลัก
function WoodKit.Window(parent, opts)
	local w, h = opts.Size.X, opts.Size.Y
	local root = frame(parent, {
		Name = opts.Name or "WoodWindow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = opts.Position or UDim2.fromScale(0.5, 0.53), Size = UDim2.fromOffset(w, h), Visible = opts.Visible == true,
	})
	-- แผ่นไม้ (กรอบนอก)
	local body = frame(root, { Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundColor3 = W.Wood, ZIndex = 2 })
	corner(body, 12)
	stroke(body, W.WoodDark, 4, 0)
	shade(body, rgb(150, 136, 124))
	-- ลายไม้บนขอบ
	for _, y in ipairs({ 5, 10, -11, -6 }) do
		frame(body, { Size = UDim2.new(1, -24, 0, 2), Position = UDim2.new(0, 12, y < 0 and 1 or 0, y), BackgroundColor3 = W.WoodDark, BackgroundTransparency = 0.6 })
	end
	-- แผ่นในเข้ม + ลายแผ่นไม้แนวตั้ง
	local inner = frame(body, { Name = "Inner", Position = UDim2.fromOffset(14, 14), Size = UDim2.new(1, -28, 1, -28), BackgroundColor3 = W.Inner, ClipsDescendants = true })
	corner(inner, 8)
	stroke(inner, W.GoldDark, 2, 0.35)
	shade(inner, rgb(140, 130, 124))
	for x = 90, w - 40, 96 do
		frame(inner, { Size = UDim2.new(0, 2, 1, 0), Position = UDim2.fromOffset(x, 0), BackgroundColor3 = rgb(20, 12, 8), BackgroundTransparency = 0.7 })
	end
	-- หมุดทองที่มุม
	for _, p in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
		local stud = frame(body, { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(p[1], p[1] == 0 and 7 or -7, p[2], p[2] == 0 and 7 or -7), BackgroundColor3 = W.Gold, ZIndex = 3 })
		corner(stud, "round")
		stroke(stud, W.WoodDark, 1.5, 0)
	end
	-- ธงแดงห้อยคร่อมขอบซ้าย/ขวา + โคมไฟใต้ธง
	local bh = opts.BannerHeight or math.floor(h * 0.3)
	if opts.Banners ~= false then
		banner(root, UDim2.fromOffset(-38, 0), 40, 44, bh, 4)
		banner(root, UDim2.new(1, -6, 0, 0), 40, 44, bh, 4)
	end
	if opts.Lanterns ~= false then
		lantern(root, UDim2.new(0, -16, 0, bh + 80), 6)
		lantern(root, UDim2.new(1, 16, 0, bh + 80), 6)
	end
	-- ป้ายชื่อ: กรอบไม้ + กระดาษ + ตัวหนังสือหมึก (Plaque = false: ไม่มีป้าย แต่ TitleWidth ยังใช้กำหนดระยะหัวสัตว์)
	local pw = opts.TitleWidth or math.clamp(#(opts.Title or "") * 6 + 120, 300, 420)
	local title
	if opts.Plaque ~= false then
		local plaque = frame(root, { Size = UDim2.fromOffset(pw, 64), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -34), BackgroundColor3 = rgb(80, 50, 28), ZIndex = 10 })
		corner(plaque, 8)
		stroke(plaque, W.WoodDark, 3, 0)
		shade(plaque)
		local paper = WoodKit.Parchment(plaque, { Position = UDim2.fromOffset(7, 7), Size = UDim2.new(1, -14, 1, -14), ZIndex = 11 })
		title = WoodKit.Ink(paper, { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Text = opts.Title or "", TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
	end
	-- หัวหมาป่า (ซ้าย หันเข้ากลาง) / อินทรี (ขวา) — อยู่นอกป้ายชื่อ ซ้อนแค่ขอบนิดเดียว และวาดทับป้าย ไม่ให้ป้ายบังหัว
	if opts.Beasts ~= false then
		WoodKit.Art(root, "Wolf", 150, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.5, -pw / 2 + 8, 0, 34), ZIndex = 13 })
		WoodKit.Art(root, "Eagle", 136, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, pw / 2 - 6, 0, 36), ZIndex = 13 })
	end
	if opts.OnClose then
		WoodKit.CloseButton(root, opts.OnClose, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -16, 0, 14) })
	end
	return { Frame = root, Body = body, Inner = inner, Title = title }
end

return WoodKit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000090"><Properties><string name="Name">WorldEventsClient</string><ProtectedString name="Source"><![CDATA[--[[
	WorldEventsClient — ฝั่งผู้เล่นของ EventService / SanctumService (Remotes "WorldEvent")
	  ☄ อุกกาบาต: ลูกไฟพุ่งจากฟ้าพร้อมหางไฟ -> ระเบิด/คลื่นกระแทก/ฝุ่น/แสงวาบ/จอสั่น (วาดในเครื่องผู้เล่นเอง ลื่นทุกจอ)
	  ป้ายประกาศ (Cinematics.Banner) · หมุดบนแผนที่ (MapUI.ExtraMarkers) · หมุดลอยบอกระยะในโลก
	  วิหารโบราณ: ป้ายคำใบ้ตอนเข้าใกล้ครั้งแรก + ค้นพบบนแผนที่ + นับถอยหลังปริศนา
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.UIKit)
local Cinematics = require(script.Parent.Cinematics)

local WorldEventsClient = {}
local player = Players.LocalPlayer
local C = UIKit.Colors
local ELEMENTS = { "Earth", "Water", "Air", "Fire" }
local THAI = UIKit.ElementThai
local EVENTS = {
	{ Kind = "Meteor", Icon = "☄", Color = Color3.fromRGB(255, 170, 80), Name = "อุกกาบาต" },
	{ Kind = "Migration", Icon = "🦌", Color = Color3.fromRGB(230, 200, 140), Name = "ฝูงสัตว์อพยพ" },
	{ Kind = "Supply", Icon = "📦", Color = Color3.fromRGB(255, 90, 70), Name = "หีบเสบียง" },
}

local fxFolder
local function folder()
	if not (fxFolder and fxFolder.Parent) then
		fxFolder = Instance.new("Folder")
		fxFolder.Name = "WorldEventFX"
		fxFolder.Parent = Workspace
	end
	return fxFolder
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or folder()
	return p
end

local function sound3d(at, id, volume, speed, maxDist)
	local holder = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, Position = at })
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 1
	s.PlaybackSpeed = speed or 1
	s.RollOffMinDistance = 40
	s.RollOffMaxDistance = maxDist or 1500
	s.Parent = holder
	s:Play()
	task.delay(8, function()
		holder:Destroy()
	end)
end

local function myPos()
	local c = player.Character
	return c and c:GetPivot().Position
end

---------------------------------------------------------------- ☄ อุกกาบาต
local function impact(pos, col, combat)
	local ball = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = pos + Vector3.new(0, 3, 0), Color = col, Material = Enum.Material.SmoothPlastic })
	TweenService:Create(ball, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(70, 70, 70), Transparency = 1 }):Play()
	local core = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(24, 24, 24), Position = pos + Vector3.new(0, 3, 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic })
	TweenService:Create(core, TweenInfo.new(0.5), { Size = Vector3.new(2, 2, 2), Transparency = 1 }):Play()
	local ring = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 8, 8), CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = col, Material = Enum.Material.SmoothPlastic, Transparency = 0.15 })
	TweenService:Create(ring, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, 170, 170), Transparency = 1 }):Play()
	local l = Instance.new("PointLight")
	l.Color = col
	l.Range = 90
	l.Brightness = 12
	l.Parent = core
	TweenService:Create(l, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	-- ฝุ่น + ประกายไฟ
	local emitterHost = part({ Size = Vector3.new(6, 1, 6), Transparency = 1, Position = pos + Vector3.new(0, 2, 0) })
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Lifetime = NumberRange.new(2.5, 4)
	dust.Speed = NumberRange.new(25, 55)
	dust.SpreadAngle = Vector2.new(85, 85)
	dust.Drag = 2.5
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 26) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	dust.Color = ColorSequence.new(Color3.fromRGB(110, 96, 86))
	dust.Enabled = false
	dust.Parent = emitterHost
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Lifetime = NumberRange.new(1, 2)
	sparks.Speed = NumberRange.new(40, 90)
	sparks.SpreadAngle = Vector2.new(70, 70)
	sparks.Acceleration = Vector3.new(0, -60, 0)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	sparks.Color = ColorSequence.new(col, Color3.new(1, 1, 1))
	sparks.Enabled = false
	sparks.Parent = emitterHost
	dust:Emit(45)
	sparks:Emit(80)
	-- เศษหินกระเด็น
	for _ = 1, 10 do
		local s = math.random(10, 26) / 10
		local rock = part({ Size = Vector3.new(s, s, s), Position = pos + Vector3.new(math.random(-3, 3), 4, math.random(-3, 3)), Color = Color3.fromRGB(50, 44, 42), Material = Enum.Material.Slate })
		rock.Anchored = false
		rock.AssemblyLinearVelocity = Vector3.new(math.random(-60, 60), math.random(50, 95), math.random(-60, 60))
		rock.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
		task.delay(2.5, function()
			TweenService:Create(rock, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end)
		task.delay(3.2, function()
			rock:Destroy()
		end)
	end
	sound3d(pos, "rbxasset://sounds/impact_explosion_03.mp3", 3, 0.7, 2200)
	task.delay(5, function()
		ball:Destroy()
		core:Destroy()
		ring:Destroy()
		emitterHost:Destroy()
	end)
	local me = myPos()
	if me and combat and combat.Shake then
		local power = math.clamp(1 - (me - pos).Magnitude / 700, 0, 1)
		if power > 0.05 then
			combat.Shake(power * 1.3, 0.4 + power)
		end
	end
end

local function meteor(d, combat)
	local col = C.Element[d.Element] or Color3.fromRGB(255, 140, 60)
	local ground = d.Position
	local fall = d.Fall or 12
	local remaining = (d.ImpactAt or 0) - Workspace:GetServerTimeNow()
	if remaining < -2 then
		return
	end
	if remaining < 0.4 then
		impact(ground, col, combat)
		return
	end
	local yaw = d.Yaw or 0
	local start = ground + Vector3.new(math.cos(yaw) * 950, 1150, math.sin(yaw) * 950)
	local dir = (ground - start).Unit
	local rock = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), Position = start, Color = col, Material = Enum.Material.SmoothPlastic })
	local shell = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(11, 11, 11), Position = start, Color = Color3.fromRGB(40, 30, 28), Material = Enum.Material.Slate })
	local halo = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(30, 30, 30), Position = start, Color = col, Material = Enum.Material.SmoothPlastic, Transparency = 0.75 })
	local up = math.abs(dir.Y) < 0.99 and Vector3.yAxis or Vector3.xAxis
	local side = dir:Cross(up).Unit
	local a0 = Instance.new("Attachment")
	a0.Position = side * 7
	a0.Parent = rock
	local a1 = Instance.new("Attachment")
	a1.Position = -side * 7
	a1.Parent = rock
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 1.4
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), col)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	trail.Parent = rock
	local fire = Instance.new("Fire")
	fire.Size = 25
	fire.Heat = 25
	fire.Color = col
	fire.SecondaryColor = Color3.fromRGB(255, 220, 160)
	fire.Parent = rock
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Rate = 45
	smoke.Lifetime = NumberRange.new(2, 3.5)
	smoke.Speed = NumberRange.new(2, 5)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 9), NumberSequenceKeypoint.new(1, 30) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(Color3.fromRGB(90, 76, 70))
	smoke.Parent = rock
	local l = Instance.new("PointLight")
	l.Color = col
	l.Range = 70
	l.Brightness = 5
	l.Parent = rock
	local whoosh = Instance.new("Sound")
	whoosh.SoundId = "rbxasset://sounds/action_falling.ogg"
	whoosh.Volume = 2
	whoosh.PlaybackSpeed = 0.5
	whoosh.Looped = true
	whoosh.RollOffMinDistance = 60
	whoosh.RollOffMaxDistance = 1600
	whoosh.Parent = rock
	whoosh:Play()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local left = (d.ImpactAt or 0) - Workspace:GetServerTimeNow()
		local t = math.clamp(1 - left / fall, 0, 1)
		local p = start:Lerp(ground + Vector3.new(0, 4, 0), t ^ 1.35)
		local cf = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, 0, t * 20)
		rock.CFrame = cf
		shell.CFrame = cf * CFrame.new(0, 0, -2)
		halo.CFrame = cf
		if t >= 1 then
			conn:Disconnect()
			rock:Destroy()
			shell:Destroy()
			halo:Destroy()
			impact(ground, col, combat)
		end
	end)
	task.delay(fall + 4, function()
		if conn.Connected then
			conn:Disconnect()
		end
		for _, x in ipairs({ rock, shell, halo }) do
			if x.Parent then
				x:Destroy()
			end
		end
	end)
end

---------------------------------------------------------------- หมุดลอยในโลก (ไอคอน + ระยะ)
local pins = {}
local function updatePins(state)
	local me = myPos()
	local inRun = player:GetAttribute("InRun")
	for _, ev in ipairs(EVENTS) do
		local pos = state:GetAttribute("Event_" .. ev.Kind)
		local pin = pins[ev.Kind]
		if pos and inRun and me then
			if not pin then
				local holder = part({ Size = Vector3.new(1, 1, 1), Transparency = 1, Position = pos })
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(120, 54)
				bb.AlwaysOnTop = true
				bb.LightInfluence = 0
				bb.StudsOffsetWorldSpace = Vector3.new(0, 14, 0)
				bb.Parent = holder
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundTransparency = 1
				t.Font = Enum.Font.BuilderSansBold
				t.TextSize = 20
				t.TextStrokeTransparency = 0.3
				t.TextColor3 = ev.Color
				t.Parent = bb
				pin = { Holder = holder, Label = t }
				pins[ev.Kind] = pin
			end
			if ev.Kind == "Meteor" then
				pin.Label.TextColor3 = C.Element[state:GetAttribute("Event_MeteorElement")] or ev.Color
			end
			pin.Holder.Position = pos
			local dist = (me - pos).Magnitude
			pin.Label.Text = string.format("%s %s\n%d ม.", ev.Icon, ev.Name, math.floor(dist / 3.5))
			pin.Holder.Parent = dist > 45 and folder() or nil
		elseif pin then
			pin.Holder:Destroy()
			pins[ev.Kind] = nil
		end
	end
end

---------------------------------------------------------------- เริ่ม
function WorldEventsClient.Init(state, hud, mapUI, combat)
	local gui = UIKit.Screen("WorldEvents", 22)
	local timerFrame = UIKit.Frame(gui, { Size = UDim2.fromOffset(420, 44), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.13, 0), BackgroundTransparency = 1 })
	UIKit.AutoScale(timerFrame)
	local timer = UIKit.Text(timerFrame, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = UIKit.Fonts.Bold, TextSize = 28, TextStrokeTransparency = 0.3, Text = "", Visible = false })

	Remotes.Get("WorldEvent").OnClientEvent:Connect(function(kind, d)
		d = d or {}
		local ok, err = pcall(function()
			if kind == "Meteor" then
				local col = C.Element[d.Element] or C.Fire
				Cinematics.Banner("METEOR STRIKE", string.format("☄ อุกกาบาตธาตุ%sกำลังพุ่งลงสู่ผืนป่า — ไปขุดแกนผลึกก่อนพลบค่ำ!", THAI[d.Element] or ""), col, 3.5, { Size = 58, Y = 0.2 })
				meteor(d, combat)
			elseif kind == "MeteorClaimed" then
				local col = C.Element[d.Element] or C.Gold
				local b = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = d.Position, Color = col, Material = Enum.Material.SmoothPlastic })
				TweenService:Create(b, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(26, 26, 26), Transparency = 1 }):Play()
				task.delay(1, function()
					b:Destroy()
				end)
				sound3d(d.Position, "rbxasset://sounds/volume_slider.ogg", 1.5, 1.4, 300)
			elseif kind == "Migration" then
				Cinematics.Banner("THE GREAT MIGRATION", "🦌 ฝูงกวางและกระต่ายกำลังเดินผ่านใกล้แคมป์ — โอกาสล่าเนื้อและหนังสัตว์!", Color3.fromRGB(230, 200, 140), 3.5, { Size = 54, Y = 0.2 })
			elseif kind == "Supply" then
				Cinematics.Banner("SUPPLY DROP", "📦 หีบเสบียงร่อนลงจากฟ้า — มองหาควันสีแดง แล้วไปเปิดก่อนพลบค่ำ", Color3.fromRGB(255, 110, 80), 3.5, { Size = 58, Y = 0.2 })
			elseif kind == "SanctumOpened" then
				local col = C.Element[d.Element] or C.Gold
				Cinematics.Banner("SEAL BROKEN", string.format("🏛 ผนึกวิหาร%sคลายแล้ว — ห้องผนึกเปิดออก หีบศักดิ์สิทธิ์รออยู่ข้างใน", THAI[d.Element] or ""), col, 4, { Size = 64 })
				local me = myPos()
				if me and d.Position and (me - d.Position).Magnitude < 250 and combat and combat.Shake then
					combat.Shake(0.6, 2.5)
				end
			end
		end)
		if not ok then
			warn("[AS] world event", kind, err)
		end
	end)

	-- หมุดบนแผนที่
	if mapUI then
		mapUI.ExtraMarkers = mapUI.ExtraMarkers or {}
		table.insert(mapUI.ExtraMarkers, function(marker, place, discovered)
			for _, ev in ipairs(EVENTS) do
				local pos = state:GetAttribute("Event_" .. ev.Kind)
				local m = marker("ev_" .. ev.Kind, ev.Icon, ev.Color, 22)
				m.Visible = pos ~= nil
				if pos then
					if ev.Kind == "Meteor" then
						m.TextColor3 = C.Element[state:GetAttribute("Event_MeteorElement")] or ev.Color
					end
					place(m, pos)
				end
			end
			for _, el in ipairs(ELEMENTS) do
				local pos = state:GetAttribute("Sanctum_" .. el)
				local key = "Sanctum_" .. el
				if pos and discovered[key] then
					local m = marker(key, "🏛", C.Element[el], 20)
					m.Text = state:GetAttribute("Sanctum" .. el .. "Solved") and "✓" or "🏛"
					place(m, pos)
				end
			end
		end)
	end

	-- ค้นพบวิหาร / ป้ายคำใบ้ / นับถอยหลัง / หมุดลอย
	local hinted = {}
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		if state:GetAttribute("Phase") == "Lobby" then
			table.clear(hinted)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(function()
				updatePins(state)
				local me = myPos()
				local showTimer = false
				if me and player:GetAttribute("InRun") then
					for _, el in ipairs(ELEMENTS) do
						local pos = state:GetAttribute("Sanctum_" .. el)
						if pos then
							local dist = ((me - pos) * Vector3.new(1, 0, 1)).Magnitude
							local key = "Sanctum_" .. el
							local discovered = hud and hud.Discovered
							if discovered and not discovered[key] and dist < 320 then
								discovered[key] = true
								if hud.Notify then
									hud.Notify("🗺 ค้นพบ: วิหารโบราณแห่ง" .. (THAI[el] or ""), "Reward")
								end
							end
							if dist < 140 and not hinted[el] then
								hinted[el] = true
								local solved = state:GetAttribute("Sanctum" .. el .. "Solved")
								Cinematics.Banner("ANCIENT SANCTUM", solved and ("วิหารโบราณแห่ง" .. THAI[el] .. " · ผนึกถูกคลายไปแล้วในรอบนี้")
									or ("วิหารโบราณแห่ง" .. THAI[el] .. " · จำลำดับแสงบนเสารูน 3 ต้น แล้วปลุกให้ถูกลำดับภายใน 30 วินาที"), C.Element[el], 4.5, { Size = 60, Y = 0.2 })
							end
							local deadline = state:GetAttribute("Sanctum" .. el .. "Deadline")
							if deadline and dist < 160 then
								local left = math.max(0, deadline - Workspace:GetServerTimeNow())
								timer.Text = string.format("⏳ ปลุกเสารูนให้ครบ: %d วินาที", math.ceil(left))
								timer.TextColor3 = left < 8 and Color3.fromRGB(255, 90, 80) or (C.Element[el] or C.Gold)
								showTimer = true
							end
						end
					end
				end
				timer.Visible = showTimer
			end)
			if not ok then
				warn("[AS] world events loop", err)
			end
		end
	end)
end

return WorldEventsClient
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterCharacterScripts" referent="RBX0000009D"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX0000009C"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[--[[
	Health — แทนสคริปต์ฟื้นเลือดอัตโนมัติของ Roblox (ค่าเริ่มต้นฟื้น 1% ต่อวินาทีตลอดเวลา แม้หิว/กำลังสู้)
	เกมเอาชีวิตรอดนี้ฟื้นเลือดเองใน SurvivalService: ตอนอิ่ม (>60%) + ไม่โดนตี 8 วินาที, ทักษะคลาส (Regen), อาหาร/ยา
	(สคริปต์ชื่อ "Health" ใน StarterCharacterScripts = ปิดของเดิมของ Roblox)
]]
]]></ProtectedString></Properties></Item>
</Item>
</Item>
