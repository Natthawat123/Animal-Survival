		attach(h, feather, CF(0, i * 3.3, 1.2))
	end
	local string_ = part(tool, "String", V(0.06, 5.8, 0.06), C(200, 230, 255), Enum.Material.Neon)
	attach(h, string_, CF(0, 0, 1.4))
