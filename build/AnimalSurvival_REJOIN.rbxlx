	local head = part(tool, "Head", V(0.45, 0.5, 4), C(120, 120, 128), Enum.Material.Metal)
	attach(h, head, CF(0, 1.8, 0) * ANG(0.15, 0, 0))
end
Shapes.Spear = function(tool)
