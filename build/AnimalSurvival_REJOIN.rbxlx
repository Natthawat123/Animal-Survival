	Air = {
		Name = "Skyreach Highlands",
		Thai = "ที่ราบสูงเหนือเมฆ",
		Color = Color3.fromRGB(200, 225, 255),
		Element = "Air",
		Terrain = { Top = "Snow", Sub = "Slate", Cliff = "Slate", Shore = "Pavement", Peak = "Glacier" },
		Atmosphere = {
