<Item class="WedgePart" referent="Props1_S82162890362816_4"><Properties><string name="Name">Wedge</string><CoordinateFrame name="CFrame"><X>-13.7052</X><Y>14.4011</Y><Z>27.3</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Vector3 name="size"><X>5.5</X><Y>9</Y><Z>2</Z></Vector3><Color3uint8 name="Color3uint8">4282532684</Color3uint8><token name="Material">788</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="Massless">true</bool><bool name="CastShadow">true</bool></Properties></Item>
