			{ Kind = "GiantPine", Weight = 6 },
			{ Kind = "AncientOak", Weight = 3 },
			{ Kind = "Fern", Weight = 5 },
			{ Kind = "Bush", Weight = 2 },
			{ Kind = "MossRock", Weight = 3 },
			{ Kind = "GlowShroom", Weight = 2 },
