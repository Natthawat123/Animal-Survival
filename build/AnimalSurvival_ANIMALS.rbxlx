				CFrame = CF(math.cos(ang) * 3.6, 2.2, math.sin(ang) * 3.6) * ANG(0, -ang + math.pi / 2, 0),
				Color = C(80, 64, 50), Material = Enum.Material.Wood,
			})
			root.Parent = m
		end
