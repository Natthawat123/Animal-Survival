			<Item class="ModuleScript" referent="RBX0000001D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	Classes — คลาสตัวละคร (ซื้อด้วยเพชร 💎 เซฟข้ามรอบ)
	Perks ที่ระบบอื่นอ่าน:
		ChopMult, MineMult, DamageMult, ReviveMult, BuildDiscount, WallHealthMult,
		SpeedMult, StaminaMult, EssenceMult, FuelDrainMult, HungerMult, DamageTakenMult, ExtraDrops
	StartItems = ของเริ่มต้น
]]

local Classes = {}

Classes.Order = {
	"Survivor", "Forager", "Lumberjack", "Medic", "Hunter", "Builder", "Scout", "Firekeeper", "Elementalist", "Beastwarden",
}

Classes.Data = {
	Survivor = {
		Name = "Survivor", Thai = "ผู้รอดชีวิต", Price = 0, Icon = "🔥",
		Desc = "สมดุลทุกด้าน เริ่มด้วยขวานเก่าและคบเพลิง",
		Perks = {}, StartItems = { OldAxe = 1, Torch = 1 },
	},
	Forager = {
		Name = "Forager", Thai = "นักหาของป่า", Price = 20, Icon = "🍓",
		Desc = "เก็บเบอร์รี่/เนื้อได้เพิ่ม หิวช้าลง 25%",
		Perks = { ExtraDrops = 1, HungerMult = 0.75 }, StartItems = { OldAxe = 1, Berries = 6 },
	},
	Lumberjack = {
		Name = "Lumberjack", Thai = "คนตัดไม้", Price = 35, Icon = "🪓",
		Desc = "ตัดไม้แรง x2 เริ่มด้วยขวานหิน",
		Perks = { ChopMult = 2 }, StartItems = { StoneAxe = 1 },
	},
	Medic = {
		Name = "Medic", Thai = "หมอสนาม", Price = 40, Icon = "🩹",
		Desc = "ช่วยเพื่อนเร็ว x2 ยาฮีลแรงขึ้น เริ่มด้วยผ้าพันแผล 3",
		Perks = { ReviveMult = 2, HealMult = 1.5 }, StartItems = { OldAxe = 1, Bandage = 3 },
	},
	Hunter = {
		Name = "Hunter", Thai = "นายพราน", Price = 60, Icon = "🏹",
		Desc = "ดาเมจใส่สัตว์ +25% ได้หนังเพิ่ม เริ่มด้วยธนู",
		Perks = { DamageMult = 1.25, ExtraDrops = 1 }, StartItems = { OldAxe = 1, Bow = 1 },
	},
	Builder = {
		Name = "Builder", Thai = "ช่างสร้าง", Price = 75, Icon = "🧱",
		Desc = "สร้างของถูกลง 25% กำแพงถึก +50%",
		Perks = { BuildDiscount = 0.25, WallHealthMult = 1.5 }, StartItems = { OldAxe = 1, LogWall = 2 },
	},
	Scout = {
		Name = "Scout", Thai = "หน่วยลาดตระเวน", Price = 90, Icon = "🧭",
		Desc = "วิ่งเร็ว +15% สตามิน่า x1.5",
		Perks = { SpeedMult = 1.15, StaminaMult = 1.5 }, StartItems = { OldAxe = 1, Torch = 1 },
	},
	Firekeeper = {
		Name = "Firekeeper", Thai = "ผู้พิทักษ์เปลวไฟ", Price = 120, Icon = "🏮",
		Desc = "กองไฟกินเชื้อเพลิงช้าลง 30% (ทั้งเซิร์ฟ) เริ่มด้วยถ่าน 4",
		Perks = { FuelDrainMult = 0.7 }, StartItems = { OldAxe = 1, Coal = 4 },
	},
	Elementalist = {
		Name = "Elementalist", Thai = "จอมเวทธาตุ", Price = 180, Icon = "🔮",
		Desc = "เก็บแก่นธาตุได้ x2 อาวุธธาตุแรง +20%",
		Perks = { EssenceMult = 2, ElementDamageMult = 1.2 }, StartItems = { OldAxe = 1 },
	},
	Beastwarden = {
		Name = "Beastwarden", Thai = "ผู้คุมอสูร", Price = 300, Icon = "🐺",
		Desc = "สัตว์ทำดาเมจใส่เรา -25% สัตว์ป่าไม่โจมตีก่อน (ยกเว้นฝูงบุก)",
		Perks = { DamageTakenMult = 0.75, WildPeace = true }, StartItems = { StoneAxe = 1 },
	},
}

-- เพชรที่ได้ตอนรอดถึงคืน
Classes.NightRewards = { [5] = 5, [10] = 10, [25] = 20, [50] = 40, [75] = 60, [99] = 150 }
Classes.BossReward = 25
Classes.SpiritReward = 15

return Classes
]]></ProtectedString>
