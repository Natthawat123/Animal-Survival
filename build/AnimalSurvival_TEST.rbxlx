		local box = frame(right, { Position = UDim2.fromScale(0.05, 0.36 + (lv - 1) * 0.205), Size = UDim2.fromScale(0.9, 0.19), BackgroundColor3 = C(52, 58, 98), BackgroundTransparency = 0 })
		corner(box, 12)
